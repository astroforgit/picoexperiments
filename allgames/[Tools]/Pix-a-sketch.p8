end
-->8
--cursor

function init_cursor()
cls(6)
cx=60
cy=60
cr=1
ccol=0

end

function draw_cursor()
  circfill(cx,cy,cr,ccol)
   
 if cr>=2 then
 pset(cx,cy,7)
 end
 if cr>=2 and ccol==7 then
 pset(cx,cy,0)
 end
end


function move_cursor()
  
  if (btn(‹)) then cx-=1 end
  if (btn(‘)) then cx+=1 end
  if (btn(”)) and not ((btn(Ž)) or (btn(—))) then cy-=1 end
  if (btn(ƒ)) and not ((btn(Ž)) or (btn(—))) then cy+=1 end
  
  
  if (btn(Ž)) and (btnp(”)) then ccol+=1 end
  if (btn(Ž)) and (btnp(ƒ)) then ccol-=1 end
  if (btn(—)) and (btn(”)) then cr+=1 end
 
  if cr>=1 then
  if (btn(—)) and (btn(ƒ)) then cr-=1 end
  end
  
  
  cx=mid(12,cx,15*8-4)
  cy=mid(15,cy,14*8-5)
  
  
  
  
  
end


  
