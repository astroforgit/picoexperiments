})

tracker:add("btn_slower", button:new{
	x = 20,
	y = 9,
	w = 5,
	h = 5,
	style = 34,
	hide = true,
	_hover = function ()
		menu.caption = "slower"
	end,
	_click = function ()
		canvas.speed += 1
	end
})

tracker:add("btn_faster", button:new{
	x = 38,
	y = 9,
	w = 5,
	h = 5,
	style = 35,
	hide = true,
	_hover = function ()
		menu.caption = "faster"
	end,
	_click = function ()
		if canvas.speed > 1 then canvas.speed -= 1 end
	end
})

-->8
-- menu
menu = display:new{
	caption = ""
}

function menu:_draw ()
	rectfill(0, 0, 127, 7, 8)
	rectfill(0, 121, 127, 127, 8)
	print(self.caption, 1, 122, 2)
end

-- export popup
popup = display:new{}

function popup:_draw ()
	rectfill(0, 121, 127, 127, 8)
	print(self.text, 1, 122, 2)
end

function popup:_update ()
	if self.t >= 60 then self.complete = true end
end

-- top bar buttons
menu:add("btn_toggle_info", button:new{
	x = 120,
	style = 21,
	_hover = function ()
		menu.caption = "about"
	end,
	_click = function ()
		menu.btn_toggle_info.style = 37
		root:add("info", info)
	end
})

menu:add("btn_toggle_frame", button:new{
	style = 36,
	_hover = function ()
		menu.caption = "toggle ui"
	end,
	_click = function ()
		root.controls.hide = not root.controls.hide
		menu.btn_toggle_frame.style = root.controls.hide and 20 or 36
	end
})

menu:add("btn_export", button:new{
	x = 10,
	style = 22,
	_hover = function ()
		menu.caption = "export sprite sheet"
	end,
	_click = function ()
		canvas:export()
	end
})

-->8
-- info popup
info = button:new{
	w = 128,
	h = 128,
	_init = function ()
		info.complete = false
	end,
	_hover = function ()
		menu.caption = "click to close"
	end,
	_click = function ()
		info.complete = true
		menu.btn_toggle_info.style = 21
	end,
	_draw = function ()
		cb(12, 33, 115, 96, 5, 8, 0)
		local _l = {
			"-= sprite animator =-",
			v,
			"  by astrangefool",
			"on",
			"twitter - twitch - itch"
		}
		for i = 1, #_l do
			print(_l[i], 64-#_l[i]*2, 33+i*10, 7)
		end
	end
}
