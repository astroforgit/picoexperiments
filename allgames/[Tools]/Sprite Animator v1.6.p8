-- frame controls
tracker = display:new{
	x = 35,
	y = 102,
	width = 64,
	cur = 63,
}

function tracker:_update ()
	local _f = mid(1, (input.mx-self.sx)*#canvas.frames\(self.width-1)+1, #canvas.frames)
	local _r = {self.sx, self.sy, self.sx+self.width-1, self.sy+5}
	if hover(_r) then menu.caption = "frame " .. _f end
	if down(_r) then
		canvas.frame = _f
		self.cur = input.mx-self.sx
	end
	if canvas.playing and hover{self.sx+25, self.sy+6, self.sx+37, self.sy+14} then menu.caption = "speed: " .. canvas.speed .. ", " .. 60/canvas.speed .. " fps" end
end

function tracker:_draw ()
	local _x, _y, _w, _mf, _c = self.sx, self.sy, self.width, #canvas.frames, self.sx+self.cur
	rectfill(_x-2, _y, _x+_w+1, _y+5, 0)
	for i = 1, _mf do
		rectfill(_x+self:cnv(i-1), _y+2, _x+self:cnv(i), _y+3, i%2 == 0 and 13 or 6)
	end
	rectfill(_c-2, _y+1, _c+2, _y+4, 1)
	rectfill(_c-1, _y+1, _c+1, _y+4, 7)
	if canvas.playing then fp(canvas.speed, _x+32-2*#tostr(canvas.speed), _y+9, 7, 1) end
end

function tracker:cnv (i)
	return max(ceil(i*(self.width-1)/#canvas.frames),0)
end

tracker:add("btn_add_frame", button:new{
	x = 73,
	style = 18,
	w = 5,
	h = 5,
	_hover = function ()
