widget = display:new{
	y = 92,
	w = 20,
	h = 29
}

function widget:_update (r)
	down(r)
end

widget:add("btn_left", button:new{
	y = 14,
	style = 4,
	_hover = function ()
		menu.caption = "scroll left"
	end,
	_down = function ()
		canvas.x += 1
	end
})

widget:add("btn_right", button:new{
	x = 12,
	y = 14,
	style = 5,
	_hover = function ()
		menu.caption = "scroll right"
	end,
	_down = function ()
		canvas.x -= 1
	end
})

widget:add("btn_up", button:new{
	x = 6,
	y = 8,
	style = 6,
	_hover = function ()
		menu.caption = "scroll up"
	end,
	_down = function ()
		canvas.y += 1
	end
})

widget:add("btn_down", button:new{
	x = 6,
	y = 20,
	style = 7,
	_hover = function ()
		menu.caption = "scroll down"
	end,
	_down = function ()
		canvas.y -= 1
	end
})

widget:add("btn_zoom_in", button:new{
	x = 11,
	style = 2,
	_hover = function ()
		menu.caption = "zoom in"
	end,
	_click = function ()
		local _k = (canvas.scale+1)/canvas.scale
		canvas.x = flr(63 - _k*63 + _k*canvas.x)
		canvas.y = flr(63 - _k*63 + _k*canvas.y)
		canvas.scale += 1
	end
})

widget:add("btn_zoom_out", button:new{
	x = 1,
	style = 3,
	_hover = function ()
		menu.caption = "zoom out"
	end,
	_click = function ()
		if canvas.scale > 1 then
			local _k = (canvas.scale-1)/canvas.scale
			canvas.x = flr(63 - _k*63 + _k*canvas.x)
			canvas.y = flr(63 - _k*63 + _k*canvas.y)
			canvas.scale -= 1
		end
	end
})

