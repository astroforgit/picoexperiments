pico-8 cartridge // http://www.pico-8.com
version 30
__lua__
-- spritesheet animator
-- by @astrangefool
v = "1.6.1"

-- note: instancable objects
-- should wrap their :add()s
-- inside _new() not {}

function _init ()
	cartdata"strangefool_animator"
	menuitem(1, "set default ui", save_defaults)
	menuitem(2, "factory reset ui", function () dset(0, 0) end)
	input.init_mouse()
	root:init()
end

function _update60 ()
	input.update()
	root:update()
end

function _draw ()
	cls(5)
	root:draw()
	spr(1, input.mx-1, input.my-1)
end

function save_defaults ()
	dset(0, -1)
	dset(1, canvas.x)
	dset(2, canvas.y)
	dset(3, canvas.width)
	dset(4, canvas.height)
	dset(5, canvas.scale)
	dset(6, canvas.speed)
	dset(7, palette.col)
end

-- includes
-- time-delay commands
-- by @astrangefool
-- 1.1.0

command = {
	s = {},
	update = function ()
		for c in all(command.s) do
			c[2] -= 1
			if c[2] <= 0 then
				c[1](unpack(c[3]))
				del(command.s, c)
			end
		end
	end
}

function delay (c, t, a)
	add(command.s, {c, t, a or {}})
end

-- display objects
-- by @astrangefool
-- 4.0.0

-- properties:
--
-- x, y, sx, sy, w, h, r, t
-- c, l, p, n (link list)
-- parent, hide, complete
--
-- callbacks:
--
-- _new, _init, _update, _draw

display = {
	x = 0,
	y = 0,
	t = 0,
	w = 0,
	h = 0
}

function display:new (o)
	o = o or {}
	setmetatable(o, self)
	self.__index = self
	o.sx = o.x
	o.sy = o.y
	o.r = {o.sx, o.sy, o.sx+o.w-1, o.sy+o.h-1}
	if o._new then o:_new() end
	return o
end

function display:update (h)
	h = h or self.hide
	local _p = self.l
	while _p ~= nil do
		local _k = _p
		local _v = self[_k]
		_p = _v.p
		_v:update(h)
		if _v.complete then self:delete(_k) end
	end
	if not h then
		self.t += 1
		if self._update then self:_update(self.r) end
 end
end

function display:draw (h)
	local _p = self.parent or {sx = 0, sy = 0}
	self.sx = self.x + _p.sx
	self.sy = self.y + _p.sy
	self.r = {self.sx, self.sy, self.sx+self.w-1, self.sy+self.h-1}
	h = h or self.hide
	if not h and self._draw then self:_draw(self.r) end
	local _n = self.c
	while _n ~= nil do
		local _v = self[_n]
		_n = _v.n
		_v:draw(h)
	end
end

function display:add (k, o)
	if self[k] then
		local _k = k .. "-"
		local _s = 1
		while self[_k .. _s] ~= nil do
			_s += 1
		end
		k = _k .. _s
	end
	if not self.c then
		self.c = k
		self.l = k
	else
		o.p = self.l
		self.l = k
		self[o.p].n = k
	end
	self[k] = o
	o.parent = self
	o.sx += self.sx
	o.sy += self.sy
	o.r = {o.sx, o.sy, o.sx+o.w-1, o.sy+o.h-1}
	if o._init then o:_init() end
end

function display:delete (k)
	local _o = self[k]
	if _o.p == nil then
		self.c = _o.n
	else
		self[_o.p].n = _o.n
	end
	if _o.n == nil then
		self.l = _o.p
	else
		self[_o.n].p = _o.p
	end
	self[k] = nil
end

function display:find (s)
	local _t = split(s, "/", false)
	local _c = self
	local _out = true
	for t in all(_t) do
		local _n = _c[t == ".." and "parent" or t]
		if _n then
			_c = _n
		else
			_out = false
			break
		end
	end
	if not (s and _out) then _c = nil end
	return _c
end
-- display utilities

function fp (s, x, y, c, b)
	for dx = -1, 1 do
		for dy = -1, 1 do
			print(s, x+dx, y+dy, b or 0)
		end
	end
	print(s, x, y, c or 7)
end

function cb (x, y, x2, y2, c, c2, c3)
	c = c or 1
	c2 = c2 or 6
	c3 = c3 or c
	line(x+2, y, x2-2, y, c2)
	line(x, y+2, x, y2-2, c2)
	line(x+2, y2, x2-2, y2, c2)
	line(x2, y+2, x2, y2-2, c2)
	rectfill(x+1, y+1, x2-1, y2-1, c)
	rect(x+1, y+1, x2-1, y2-1, c3)
	pset(x+1, y+1, c2)
	pset(x2-1, y+1, c2)
	pset(x+1, y2-1, c2)
	pset(x2-1, y2-1, c2)
end

-- input object
-- by @astrangefool
-- 2.0.0

input = {
	init_mouse = function ()
		poke(0x5f2d, 1)
		input.m = true
		input.md = 0
	end,
	update = function ()
		for b = 0, 5 do
			input[tostr(b)] = true
		end
		if input.m then
			input.mx = stat(32)
			input.my = stat(33)
			input.c = false
			input.h = true
			if stat(34) & 0b1 == 1 then
				input.d = true
				input.md += 1
			else
				input.d = false
				if input.md > 0 and
							input.md < 30 then
					input.c = true
				end
				input.md = 0
			end
		end
	end,
	try = function (f, i ,b)
		if input[i] then
			input[i] = b
			return f(i)
		else
			return false
		end
	end,
	mtry = function (k, r, b)
		if input[k] and
					input.mx >= r[1] and
					input.my >= r[2] and
					input.mx <= r[3] and
					input.my <= r[4] then
			input[k] = b
			return true
		else
			return false
		end
	end
}

function key (i, b)
	return input.try(btn, i, b)
end

function keyp (i, b)
	return input.try(btnp, i, b)
end

function click (r, b)
	return input.mtry("c", r, b)
end

function down (r, b)
	return input.mtry("d", r, b)
end

function hover (r, b)
	return input.mtry("h", r, b)
end

-- button
-- by @astrangefool
-- 1.0.0

-- callbacks:
--
-- _hover, _down, _click

button = display:new{
	style = 0,
	w = 8,
	h = 8
}

function button:_update (r)
	if self._hover and hover(r) then self._hover() end
	if self._down and down(r) then self._down(r) end
	if self._click then
		if click(r) then self._click(r) end
		down(r)
	end
end

function button:_draw ()
	spr(self.style, self.sx, self.sy)
end


