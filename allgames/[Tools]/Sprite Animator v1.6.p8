-- colour picker
palette = display:new{
	x = 118,
	y = 11,
	w = 8,
	h = 98,
	col = 6
}

function palette:_update (r)
	local _c = min(15, (input.my - r[2]) \ 6)
	if down(r) then
		self.col = _c
		local _se = canvas.selection
		if _se then
			local _r = {min(_se[1], _se[3]), min(_se[2], _se[4]), max(_se[1], _se[3]), max(_se[2], _se[4])}
			for x = _r[1], _r[3] do
				for y = _r[2], _r[4] do
					canvas.frames[canvas.frame][x.."."..y] = _c
				end
			end
		end
	end
	if hover(r) then menu.caption = "colour " .. _c end
end

function palette:_draw (r)
	local _x, _y, _c = self.sx+1, self.sy+1, self.col*6
	r[5] = 0
	rect(unpack(r))
	for i = 0, 15 do
		rectfill(_x, _y+i*6, _x+5, _y+5+i*6, i)
	end
	rect(_x, _y+_c, _x+5, _y+5+_c, 0)
	rect(_x-1, _y-1+_c, _x+6, _y+6+_c, 7)
end

palette:add("btn_mode", button:new{
	y = 100,
	style = 11,
	_hover = function ()
		menu.caption = canvas.mode == "paint" and "pen mode" or "selection mode"
	end,
	_click = function ()
		if canvas.mode == "paint" then
			canvas.mode = "select"
		else
			canvas.mode = "paint"
			canvas.selection = nil
		end
		palette.btn_mode.style = canvas.mode == "paint" and 11 or 10
		palette.btn_copy.hide = not palette.btn_copy.hide
		palette.btn_paste.hide = not palette.btn_paste.hide
	end
})

palette:add("btn_copy", button:new{
	x = -20,
	y = 100,
	style = 13,
	hide = true,
	_hover = function ()
		menu.caption = "copy selection"
	end,
	_click = function ()
		canvas:copy()
	end
})

palette:add("btn_paste", button:new{
	x = -10,
	y = 100,
	style = 12,
	hide = true,
	_hover = function ()
		menu.caption = "paste into selection"
	end,
	_click = function ()
		canvas:paste()
	end
})

