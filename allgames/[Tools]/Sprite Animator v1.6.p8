-- sprite canvas
canvas = display:new{
	x = 12,
	y = 16,
	width = 8,
	height = 6,
	frame = 1,
	frames = {},
	scale = 12,
	bg = 0,
	playing = false,
	speed = 6,
	mode = "paint"
}

function canvas:_init ()
	if dget(0) == -1 then
		self.x = dget(1)
		self.y = dget(2)
		self.width = dget(3)
		self.height = dget(4)
		self.scale = dget(5)
		self.speed = dget(6)
	end
	local _f = {}
	for x = 1, self.width do
		for y = 1, self.height do
			_f[x.."."..y] = self.bg
		end
	end
	add(self.frames, _f)
end

function canvas:_update ()
	local _x, _y, _w, _s = self.sx, self.sy, self.width, self.scale
	if self.playing then
		if self.t >= self.speed then
			self.t = 0
			self.frame += 1
			if self.frame > #self.frames then self.frame = 1 end
			tracker.cur = tracker:cnv(self.frame-1)
		end
	end
	if down{_x+1, _y+1, _x+_w*_s, _y+self.height*_s} then
		_x = (input.mx-_x-1) \ _s + 1
		_y = (input.my-_y-1) \ _s + 1
		if self.mode == "paint" then
			self.frames[self.frame][_x..".".._y] = palette.col
		elseif self.mode == "select" and not self.playing then
			if self.drag_start then
				self.selection = {self.drag_start[1], self.drag_start[2], _x, _y}
			else
				self.selection = nil
				self.drag_start = {_x, _y}
			end
		end
	else
		self.drag_start = nil
	end
	if key"0" then self.x += 1 end
	if key"1" then self.x -= 1 end
	if key"2" then self.y += 1 end
	if key"3" then self.y -= 1 end
end

function canvas:_draw ()
	local _x, _y, _w, _h, _f, _s = self.sx, self.sy, self.width, self.height, self.frames[self.frame], self.scale
	rect(_x, _y, _x+1+_w*_s, _y+1+_h*_s, 0)
	for _fx = 1, _w do
		for _fy = 1, _h do
			local _dx = _x+1 + (_fx-1)*_s
			local _dy = _y+1 + (_fy-1)*_s
			rectfill(_dx, _dy, _dx+_s-1, _dy+_s-1, _f[_fx..".".._fy])
		end
	end
	local _se = self.selection
	if _se then
		local _r = {min(_se[1], _se[3]), min(_se[2], _se[4]), max(_se[1], _se[3]), max(_se[2], _se[4])}
		local _x1 = _x+1 + (_r[1]-1)*_s
		local _y1 = _y+1 + (_r[2]-1)*_s
		local _x2 = _x+ _r[3]*_s
		local _y2 = _y+ _r[4]*_s
		fillp(0xa5a5.8)
		rect(_x1, _y1, _x2, _y2, 0x7)
		fillp()
	end
end

function canvas:add_col ()
	self.width += 1
	for f in all(self.frames) do
		for y = 1, self.height do
			f[self.width.."."..y] = self.bg
		end
	end
	self.selection = nil
end

function canvas:add_row ()
	self.height += 1
	for f in all(self.frames) do
		for x = 1, self.width do
			f[x.."."..self.height] = self.bg
		end
	end
	self.selection = nil
end

function canvas:del_col ()
	if self.width > 1 then
		for f in all(self.frames) do
			for y = 1, self.height do
				f[self.width.."."..y] = nil
			end
		end
		self.width -= 1
	end
	self.selection = nil
end

function canvas:del_row ()
	if self.height > 1 then
		for f in all(self.frames) do
			for x = 1, self.width do
				deli(f, #f)
				f[x.."."..self.height] = nil
			end
		end
		self.height -= 1
	end
	self.selection = nil
end

function canvas:add_frame ()
 if not self.playing then
		local _f = {}
		for k,v in pairs(self.frames[self.frame]) do
			_f[k] = v
		end
		add(self.frames, _f)
		self.frame = #self.frames
		tracker.cur = tracker.width-1
	end
end

function canvas:del_frame ()
	if not self.playing and #self.frames > 1 then
		deli(self.frames, self.frame)
		self.frame = max(1, self.frame-1)
		tracker.cur = tracker:cnv(self.frame-1)
	end
end

function canvas:toggle_play()
	self.playing = not self.playing
	if self.playing then self.t = 0 end
	self.selection = nil
end

function canvas:export ()
	cls()
	local _w, _ox, _oy = self.width, 0, 0
	for f in all(self.frames) do
		if _ox+_w > 128 then
			_ox = 0
			_oy += self.height
		end
		for x = 1, self.width do
			for y = 1, self.height do
				pset(_ox+x-1, _oy+y-1, f[x.."."..y])
			end
		end
		_ox += _w
	end
	local _fix = dget(8)
	dset(8, _fix+1)
	_fix = tostr(_fix)
	while #_fix < 5 do
	 _fix = "0" .. _fix
	end
	local _s = "animator_" .. _fix .. ".p8"
	cstore(0, 0x6000, 0x2000, _s)
	root:add("popup", popup:new{text = "saved to: " .. _s})
end

function canvas:copy ()
	local _se = self.selection
	if _se then
		local _r = {min(_se[1], _se[3]), min(_se[2], _se[4]), max(_se[1], _se[3]), max(_se[2], _se[4])}
		buffer = {}
		for x = 1, _r[3]-_r[1]+1 do
			for y = 1, _r[4]-_r[2]+1 do
					buffer[x.."."..y] = self.frames[self.frame][x-1+_r[1].."."..y-1+_r[2]]
			end
		end
	end
end

function canvas:paste ()
	local _se = self.selection
	if _se then
		local _r = {min(_se[1], _se[3]), min(_se[2], _se[4]), max(_se[1], _se[3]), max(_se[2], _se[4])}
		for k, v in pairs(buffer) do
			local _t = split(k, ".")
			local _bx, _by = _t[1], _t[2]
			_bx += _r[1]-1
			_by += _r[2]-1
			if _bx <= _r[3] and _by <= _r[4] then
				self.frames[self.frame][_bx .. "." .. _by] = v
			end
		end
	end
end

