-- root display object
root = display:new()

function root:init ()
	self:add("canvas", canvas)
	local _c = display:new()
	_c:add("palette", palette)
	if dget(0) == -1 then palette.col = dget(7) end
	_c:add("widget", widget)
	_c:add("size", size)
	_c:add("tracker", tracker)
	self:add("controls", _c)
	self:add("menu", menu)
end

function root:_update ()
	if input.h then menu.caption = "" end
end

