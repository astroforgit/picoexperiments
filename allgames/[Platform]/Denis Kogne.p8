score=0
	cls()
 sfx(6)
 print("\14a lostcadesoft's",0,32,7)
 print("\14(qUARTER-nes)",12,54,8)
 line(16,53,110,53,8)
 line(16,61,110,61,8)
 print("\14game's style",16,80,7)
 for t=1,120 do flip() end
function _init()



hiscore=dget(0)
level=0
flevel=0
lives=0
frame=0
ikea={legs=0,top=0,screws=0,table=0}
intro_init()
end

function title_init()
timeout=time()+5
_update60=title_update
_draw=title_draw
end

function title_update()
frame+=0.05 frame=frame%2
if (time()>=timeout) intro_init()
if btnp(—) then 
lives=3
score=0
start_init() end
end

function title_draw()
cls()
map(0,16)
hud_draw()

if frame<1 then
print("\14\#0— to start",24,72,7)
end

print("\14   @2019\nlostcadesoft\nby bgelais",16,104,12)
spr(5+frame%2,24,24)
spr(40+frame%2,96,24)
end

function game_init()
frame=0
denis={}
hammers={}
enemys={}
points={}
items={}
level=level%4
lfrom=level*16
lto=(level*16)+15
for c=lfrom,lto do
 for r=0,15 do
 get=mget(c,r)
 x=c-lfrom y=r
if (get==17) create_denis(x,y)
if (get==25) create_enemy(x,y) 
if (get==48) create_item(x,y) 
if (get==56) create_girl(x,y) 
 end
end
music(0)
_update60=game_update
_draw=game_draw
end

function game_update()
frame+=1 frame=frame%120
foreach(enemys,enemys_update)
foreach(items,items_update)
denis_update()
foreach(hammers,update_hammers)

end

function game_draw()
cls()
map(level*16)
hud_draw()
girl_draw()

foreach(enemys,enemys_draw)
foreach(items,items_draw)
denis_draw()
foreach(hammers,draw_hammers)
foreach(points,points_draw)

end


function start_init()
sfx(7)
timeout=time()+4
_draw=start_draw
_update60=start_update
end

function start_update()
if (time()>=timeout) game_init()
end

function start_draw()
cls()
hud_draw()

spr(35,32,38)
spr(36,64,38)
spr(37,96,38)
spr(38,64,24)
spr(40,56,24)

print("\14"..ikea.legs,32,47,7)
print("\14"..ikea.top,64,47,7)
print("\14"..ikea.screws,96,47,7)
print("\14  player start\n   level "..level,0,64,7)
print("\14\fecan you mount\nmy table from\nikea?",8,104,14)
bonus()
end

--bonus at startscreen 
function bonus()
if ikea.top>0 then
   if ikea.screws>=4 and
   ikea.legs>=4 
   then
   sfx(9)
   ikea.top=0
   ikea.screws-=0
   ikea.legs=0
   ikea.table=1
   print("\14table bonus +50",0,12*8,11)
   wait(4)
   end
	score+=ikea.table*50
	end
ikea.table=0
end

function intro_init()
timeout=time()+5
_update60=intro_update
_draw=intro_draw	
end

function intro_update()
if (time()>=timeout or btnp(—)) title_init()	
end

function intro_draw()
cls()
map(64)
hud_draw()
print("\14"..[[


you are   denis


       eliminate
       
    get all...
    
    
  
  win     love
  for     table.
]],0,18,6)

end
-->8
--player

function lmget(_x,_y)
--check map tiles in function
--of lfrom (x+level*16) and y
return mget(_x+lfrom,_y)
end

function create_denis(_x,_y)
denis={
spr=1,
x=_x,
y=_y,
frm=0,
maxamo=1,
flp=false}
canshoot=true
end


function denis_update()
denis.x=mid(0,denis.x,15)

if lmget(denis.x,denis.y+1)==0 then 
denis.y+=0.1 
denis.spr=5
denis.frm+=0.2
else denis.y=flr(denis.y) end

if frame%8==1 then

	if btn(‹) and 
	lmget(denis.x-1,denis.y)!=48 
	then 
		sfx(0)
		denis.spr=1
		denis.x-=1 
		denis.flp=true 
		denis.frm+=1 
	end 
	
	if btn(‘)	and
 lmget(denis.x+1,denis.y)!=48
 then 
		sfx(0)
		denis.spr=1
		denis.x+=1
		denis.flp=false
		denis.frm+=1 
	end
	
	if btn(”) and 
	lmget(denis.x,denis.y)==49
	then
		sfx(1)
		denis.spr=3
		denis.y-=1
		denis.frm+=1
	end
	
	if btn(ƒ) and
	lmget(denis.x,denis.y+1)==49 
	then
		sfx(1)
		denis.spr=3
		denis.y+=1
		denis.frm+=1
	end

end

if (btnp(Ž) or btnp(—))
	and #hammers<denis.maxamo	
	then init_hammer() end
denis.frm=denis.frm%2
end

function denis_draw()
spr(denis.spr+denis.frm,
denis.x*8,denis.y*8,1,1,denis.flp)
end

function init_hammer()
denis.spr=7
sfx(4)
hammer={}
hammer.y=denis.y
hammer.frm=0
	if denis.flp then
 	hammer.x=denis.x
 	hammer.flp=true
 	hammer.xspd=-1
 else
  hammer.x=denis.x
 	hammer.flp=false
 	hammer.xspd=1
	end
add(hammers,hammer)
end

function draw_hammers(o)
spr(18+o.frm,o.x*8,
o.y*8,1,1,o.flp)
end

function update_hammers(o)
if frame%4==1 then o.x+=o.xspd end
		
		o.frm+=0.2
		if o.frm>5 then sfx(5) end
		
		o.frm=o.frm%5
	if o.x<0 or o.x>16
	or lmget(o.x,o.y)==48
	then 
	denis.spr=1
	del(hammers,o)
	end
end

function hitdenis(o)
	if collide(o,denis) then
	iprint("doh!",o.x*8,o.y*8,7)
	music(-1)
	sfx(2)
	wait(180)
	lives-=1
	if lives==0 then
	print("\14\#0game over",24,64,8)
	if (score>hiscore) hiscore=score dset(0,hiscore)
 wait(180)
	sfx(10)
	_init()
	end
	
	if (lives>0) start_init()
		
	end
end
-->8
--enemys

function collide(a,b)
	if abs(a.y-b.y)<1 and 
	abs(a.x-b.x)<2
	then return true end
end

function create_enemy(_x,_y)
enemy={
x=_x,
y=_y,
xsp=1,
frm=0,
spr=9,
flp=false
}
add(enemys,enemy)
end

function enemys_update(o)

if frame%8==1 then
o.x+=o.xsp
o.frm+=1
o.frm=o.frm%2
	if lmget(o.x+1,o.y+1)==0 or
	   lmget(o.x-1,o.y+1)==0 then
	   o.xsp=-o.xsp end 

if (o.xsp<0) o.flp=true
if (o.xsp>0) o.flp=false
end

	for i in all(hammers) do
		if collide(o,i) then
		points_init(o.x,o.y,20,9)
		del(enemys,o)
		del(hammers,i) end
	end
end


function enemys_draw(o)
spr(o.spr+o.frm,o.x*8,o.y*8
,1,1,o.flp)
hitdenis(o)
	
end
-->8
--hud & screens draw

function hud_draw()
sc="00000"..tostr(score)
sc=sub(sc,#sc-4,#sc)
hs="00000"..tostr(hiscore)
hs=sub(hs,#hs-4,#hs)

print("\14score high",0,0,8)
print("\14"..sc.." "..hs,0,8,7)
print("\14l="..flevel,96,8,12)

	for i=0,lives-1 do
  spr(1,96+i*8,0)
	end

end

function iprint(str,_x,_y)
for x=_x-1,_x+1 do
	for y=_y-1,_y+1 do
	print(str,x,y,7)
	end
end
print(str,_x,_y,0)
end

function points_init(_x,_y,_p,_c)
add(points,{
x=_x, 
y=_y,
c=_c,
frm=0,
pts=_p})
sfx(6)
end

function points_draw(o)
print(o.pts,o.x*8,o.y*8,1+rnd(15))
o.frm+=1
if o.frm==40 then
score+=o.pts 
del(points,o) end
end

function wait(_wait)
repeat
_wait-=1
flip()
until _wait<0
end


-->8
--obects

function create_item(_x,_y)

	if flr(rnd(15))==1 then
	add(items,{
	x=_x,
	y=_y-1,
	spr=35+flr(rnd(3))
	}) end

end
--35 legs
--36 top
--37 screws

function items_update(o)
 if collide(o,denis) then
 points_init(o.x,o.y,5)
 score+=5
 if (o.spr==35) ikea.legs+=1
 if (o.spr==36) ikea.top+=1
 if (o.spr==37) ikea.screws+=1
 del(items,o)
 end
end


function items_draw(o)
spr(o.spr,o.x*8,o.y*8)
end

function create_girl(_x,_y)
girl={
x=_x,
y=_y,
spr=40,
frm=0}
end


function girl_draw(o)
girl.frm+=0.05 
girl.frm=girl.frm%2
spr(girl.spr+girl.frm,
girl.x*8,girl.y*8)
if collide(denis,girl) then
win_draw() end
end

function win_draw()
enemys={}
rectfill(0,15,127,127,0)
print("\14    level "..flevel.."\n    complete",0,64,7)
spr(1,44,32)
spr(40,76,32)
spr(42,60,32)
music(-1)
sfx(8)
wait(240)
level+=1
flevel+=1
start_init()
end
