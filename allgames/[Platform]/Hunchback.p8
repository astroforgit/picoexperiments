--map
function mcol(f,x,y)
 local mx=flr(x/8)
 local my=flr(y/8)
 local msq=mget(mx,my)
 return fget(msq,f)
end
-->8
--
function irope()
 rope = {}
 rope.x=cx+60
 rope.y=cy-24
 rope.x2=cx+60
 rope.y2=cy+20 
 rope.v=-0.5
end

function urope()
 if(rope.x2<cx+40)then
  rope.v=0.5
 elseif(rope.x2>cx+80)then
  rope.v=-0.5
 end
 rope.x2+=rope.v
end

function drope()
 line(rope.x,rope.y,rope.x2,rope.y2,7)
end

function crope(s)
 local px=s.x+4
 if(s.fh)then
  px=s.x
 end
 for x=px,px+4 do
  for y=s.y+2,s.y+4 do
   if(pget(x-cx,(y+24)-cy)==7)then
    return x
   end
  end
 end
end
-->8
--helper
function printfont(s,x,y)
 for i=1,#s do
	 local l = sub(s,i,i)
	 print(l,x+((i-1)*5)+1,y-1,8)
 	print(l,x+((i-1)*5),y,9)
 end
end

function rinr(r1x,r1y,r1w,r1h,r2x,r2y,r2w,r2h)
 if(r1x+r1w>=r2x and // r1 right edge past r2 left
    r1x<=r2x+r2w and // r1 left edge past r2 right
    r1y+r1h>=r2y and // r1 top edge past r2 bottom
    r1y<=r2y+r2h)then // r1 bottom edge past r2 top
     return true
 end
end

function circle(snum,t)
 local angle=0
 while(angle<360)do
  angle+=24
  local x=58+flr(56*cos((t+angle)/360))
  local y=60+flr(56*sin((t+angle)/360))
  spr(snum,x,y)
	end
end
