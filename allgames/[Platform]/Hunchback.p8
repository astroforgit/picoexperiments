--levels
function ilvl()
 cx=(lnum-1)*128
 cy=0
 timer=3330
 es={}
 rope=nil
 bellrope=false
 arrowon={}
 arrowtick=16
 arrowspd=48
 lay[lnum]()
 ihero(cx+8,cy+16)
 state.update = ugame
 state.draw=dgame
 if(lnum==16)then
  hero.x=hero.x+16
  hero.y=cy+56
 end
	pal()
	pal(2,cols[1])
	pal(14,cols[2])
end

function ulvl()
 if(#arrowon>0)then
  if(arrowtick==0)then
   arrowtick=arrowspd
		 local i = arrowon[flr(rnd(#arrowon))+1]
 		iarrow(cx,cy,i)
  	del(arrowon,i)
  else
   arrowtick-=1
		end
	end
end

function lvl1()
 climbknight(8,48)
 cols={2,14,10}
 arrowspd=96
 arrowon={1,1}
end

function lvl2()
 climbknight(cx+8,cy+48)
 for x = 32,80,8 do
	 fire(cx+x,cy+56)
	end
 cols={2,14,10}
	irope()
end

function lvl3()
	cols={2,14,10}
 climbknight(cx+8,cy+64)
 arrowon={1,4}
 fire(cx+32,cy+24)
 fire(cx+56,cy+24)
 fire(cx+80,cy+24)
end

function lvl4()
 climbknight(cx+8,cy+64)
	holeknight(cx+32,cy+24)
 holeknight(cx+56,cy+24)
 holeknight(cx+80,cy+24)
 cols={2,14,10}
end

function lvl5()
 cols={2,14,10}
 climbknight(cx+8,cy+64)
	holeknight(cx+32,cy+24)
 holeknight(cx+56,cy+24)
 holeknight(cx+80,cy+24)
 arrowon={1}
end

function lvl6()
 cols={1,12,10}
 timer=5330
 climbknight(cx+8,cy+64)
 for x = 32,80,8 do
	 fire(cx+x,cy+56)
	end
	irope()
	arrowon={4,3}
	arrowspd=120
end

function lvl7()
 cols={1,12,10}
 climbknight(cx+8,cy+64)
 arrowon={1,2,3,4}
 timer=5330
end

