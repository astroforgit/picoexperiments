pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
bugging=false
bug=""

function _init()
 state={}
 state.pause = 0
 state.tick=0
 ititle()
 music(0)
end

function _update60()
 if(state.pause<=0)then
	 state.update()
 else
  state.pause-=1
 end
 if(btnp(5))then
  --bugging=not bugging
 end
 bug=lnum
end

function _draw()
 cls()
 state.draw()
 if(bugging)then
  print(bug,0,0,11)
  print(stat(7),0,8,11)
 end
end

function igame()
 music(-1)
 state.update=ugame
 state.draw=dgame
 state.tick=0
 state.pause=32
 scorea=0
 scoreb=0
 bells=0
 lives=2
 timer=0
 showtimer=false
 lnum = 1
 ilvl()
end

function ugame()
	uspr(hero)
 uay(es)
 ulvl()
 chero()
 if(timer>1)then
  timer-=2
 end
end

function dgame()
 camera(cx,cy-24)
 map(flr(cx/8),flr(cy/8),flr(cx/8)*8,flr(cy/8)*8,17,10)
 if(lnum==9)then
  map(0,11,1024,0,16,12)
 end
 if(rope)then
  drope()
 end
 dspr(hero)
 day(es)
 camera()
 printfont("super",70,2)
 printfont("bonus",78,9)
 printfont("score",78,106)
 local ss = ""..scorea
 if(scorea>0)then
	 if(scoreb<100)then
 	 ss=ss.."0"
 	 if(scoreb<10)then
  	 ss=ss.."0"
 	 end
		end
 end
 ss=ss..scoreb
 print(ss,90-(#ss*2),112,7)
 for i=0,4 do
  if(i<bells)then
	 	spr(13,16+i*8,2)
	 else
 		spr(10,16+i*8,2)
	 end
 end
 rect(5,105,64,124,10)
 rect(7,107,62,122,8)
 rect(9,109,60,120,10)
 for i=0,4 do
 	spr(11,11+i*8,111)
 end
  spr(12,51,111)
  print("player:",66,120)
 for i=0,lives-1 do
  spr(53,94+(i*7),118)
 end
 if(showtimer)then 
 	rectfill(3,49,31,67,0)
 	rect(8,54,26,62,10)
 	rect(6,52,28,64,8)
  rect(4,50,30,66,10)
  print(timer,10,56,7)
 end
 pset(7+(lnum*3),113,11)
end

function nextlvl()
 cx+=1
 showtimer=false
 if(cx%128==0)then
	 ilvl()
	end
end

//die
function ushake()
	if(state.tick>0)then
		hero.y+=1
		state.tick-=1
		if(state.tick%3==0)then
			pal(cols[1],cols[3])
		elseif(state.tick%2==0)then
			pal()
			pal(2,cols[1])
			pal(14,cols[2])
		end
	else
	 bells=0
	 ilvl()
	 pal()
		pal(2,cols[1])
		pal(14,cols[2])
	end
end

//lvl transition
function ulvlwin()
	if(state.tick>0)then
		state.tick-=1
	else
	 addscore(timer)
	 state.update = nextlvl
	end
end

//super bonus
function usbonus()
	if(state.tick>0)then
		state.tick-=1
		if(state.tick%24==0)then
		 sfx(3)
		 bells-=1
		end
		if(state.tick%3==0)then
			pal(8,10)
			pal(10,8)
		elseif(state.tick%2==0)then
	 	pal()
			pal(2,cols[1])
			pal(14,cols[2])
		end
	else
	 state.update = nextlvl
	 for i=0,9 do
	  addscore(10000)
	 end
	 addscore(timer)
	 lives-=1
	 pal()
		pal(2,cols[1])
		pal(14,cols[2])
	end
end

function addscore(num)
 local temp = flr(scorea/50)
 local mod = flr(num/1000)
 scorea += mod
 scoreb = num-(mod*1000)
 if(lives<5 and flr(scorea/50)>temp)then
  lives+=1
 end
end

function iwin()
 state.update=uwin
 state.draw=dwin
end

function uwin()
 if(state.over and (btnp(4) or btnp(5)))then
  _init()
 end
 if(state.tick>64)then
  state.over=true
 end
end

function dwin()
 state.tick+=1
 if(state.tick>360)then
  state.tick=0
 end
 circle(59,state.tick)
 spr(54,54,56)
 spr(64,62,56,1,1,true)
 print("my hero!‡‡‡",35,42,10)
 if(state.over and state.tick%8!=0)then
  print("press —+Ž",40,72,7)
 end
end

function ititle()
 state.update=utitle
 state.draw=dtitle
end

function utitle()
 state.tick+=1
 if(state.tick>360)then
  state.tick=0
 end
 if(state.over and (btnp(4) or btnp(5)))then
  state.over=false
  igame()
 end
 if(state.tick>64)then
  state.over=true
 end
end

function dtitle()
 sspr(48,32,74,30,24,24)
 spr(64,82,30,1,1,true)
 spr(54,42,45)
 if(state.over and state.tick%8!=0)then
  print("press —+Ž",40,72,7)
 end
end

function idie()
 state.update=udie
 state.draw=ddie
end

function udie()
 if(state.over and btnp(4))then
  state.pause=32
  scorea=0
  scoreb=0
  bells=0
  lives=2
  ilvl()
 end
 if(state.over and btnp(5))then
  _init()
 end
 if(state.tick>64)then
  state.over=true
 end
end

function ddie()
 state.tick+=1
 if(state.tick>360)then
  state.tick=0
 end
 circle(61,state.tick)
 spr(61,58,56)
 print("you died!",45,42,10)
 if(state.over and state.tick%8!=0)then
  print("press Ž to exit",30,80,7)
  print("press — to continue",24,72,7)
 end
end

function iscores()
 state.update=uscores
 state.draw=dscores
end

function uscores()
 if(btn(4) or btn(5))then
  state.update=uscores
  state.draw=dscores
 end
end

function dscores()
end
-->8
--sprites

function ispr(snum,x,y)
 local s = {}
 s.snum=snum
 s.frame=snum
 s.x=x
 s.y=y
 s.fh=false
 return s
end

function uspr(s)
 if(s.anim)then
  uanim(s)
 end
 if(s.state)then
  s.state(s)
 end
end

function dspr(s)
 spr(s.frame,s.x,s.y,1,1,s.fh)
 if(bugging and s.col)then
  rect(s.col.x,s.col.y,s.col.x+s.col.w,s.col.y+s.col.h,8)
 end
end
 
function ianim(frames,spd,once)
	local a = {}
	a.frames = frames
	a.frame = 1
	a.tick = spd
	a.spd = spd
	a.once = once
	a.dead = false
	return a
end

function sanim(s,a)
 if(a)then
  a.frame = 1
  a.tick = a.spd
  a.dead = false
 else
  s.frame = s.snum
 end
 s.anim = a
end

function uanim(s)
 if(s.anim.tick<=0)then
  s.anim.tick = s.anim.spd
  if(s.anim.frame >= #s.anim.frames)then
   if(s.anim.once)then
    s.anim.dead = true
   else
	   s.anim.frame=1
	  end 
  else
   s.anim.frame+=1
  end
 elseif(not s.anim.dead)then
  s.anim.tick-=1
 end
 s.frame=s.anim.frames[s.anim.frame]
end

function day(ay)
 for i in all(ay) do
 	dspr(i)
 end	
end

function uay(ay)
 for i in all(ay) do
 	uspr(i)
 end	
end
-->8
btn4=true
stepfx=0

function still(s)
 s.vx=0
 if(btn(0) or btn(1))then
  s.state = walk
  sanim(s,s.walk)
 elseif(btn(4) and btn4)then
  btn4=false
  sfx(1)
  s.state = jump
  sanim(s,s.jump)
 end
end

function walk(s)
 if(stepfx==0)then
  stepfx=10
	 sfx(11)
	else
	 stepfx-=1
	end
 if(not mcol(0,s.x+4,s.y+8))then
 	s.state = fall
  sanim(s,s.fall)
 elseif(btn(4) and btn4)then
  btn4=false
   sfx(1)
  s.state = jump
  sanim(s,s.jump)
 elseif(btn(0))then
 	s.fh=true
 	s.x-=0.7
 	s.vx=-0.7
 elseif(btn(1))then
  s.fh=false
  s.x+=0.7
  s.vx=0.7
 else
  s.state = still
  sanim(s,s.still)
 end
end

function jump(s)
 if(btn(0))then
 	s.vx=-0.7
 elseif(btn(1))then
  s.vx=0.7
 end
 if(s.anim.dead)then
  s.state = fall
  sanim(s,s.fall)
 else
  s.x+=s.vx
	 s.y-=0.4
	end
end

function fall(s)
 if(mcol(0,s.x+4,s.y+8))then
  s.state = still
  sanim(s,s.still)
 elseif(s.anim.dead)then
  s.state = drop
 else
	 s.x+=s.vx
	 s.y+=0.4
	end
end

function drop(s)
 if(mcol(0,s.x+4,s.y+8))then
  s.state = still
  sanim(s,s.still)
 else
	 s.y+=0.4
	end
end

function swing(s)
 if(btn(4) and btn4)then
  btn4=false
  s.state=swingjump
  sanim(s,s.jump)
 end
 s.x=rope.x2-4
 s.y=rope.y2-6
end

function swingjump(s)
 if(btn(0))then
 	s.vx=-0.6
 elseif(btn(1))then
  s.vx=0.6
 end
 if(s.anim.dead)then
  s.state = fall
  sanim(s,s.fall)
 else
  s.x+=s.vx
	 s.y-=0.5
	end
end

function bellswing(s)
 if(btn(0))then
 	s.fh=true
 elseif(btn(1))then
  s.fh=false
 elseif(btn(2) and mcol(2,s.x,s.y))then
 	s.y-=1
 elseif(btn(3) and mcol(2,s.x,s.y+4))then
  s.y+=1
 end
 if(btn(4) and btn4)then
  btn4=false
  s.state=jump
  sanim(s,s.jump)
 end
end

function bellcheck(s)
	if(mcol(1,s.x+4,s.y+4))then
	 return true
	end
end

--player
function ihero(x,y)
 hero=ispr(64,x,y)
 hero.anim = nil
 hero.walk = ianim({64,65,66,67,68},6,false)
 hero.jump = ianim({64,66},6,true)
 hero.fall = ianim({67,68},6,true)
 hero.state = still
end

function chero()
 if(not btn(4)) then btn4=true end
 if(rope)then
  urope()
  if(hero.state != swing and crope(hero))then
 		hero.state = swing
 		sfx(6)
  end
 end
 if(bellrope and hero.state != bellswing)then
  local x = crope(hero)
  if(x)then
   sfx(6)
   hero.x=x-3
   hero.y=hero.y+2
 		hero.state= bellswing
  end
 end
 if((not hero.fh) and mcol(0,hero.x+7,hero.y+7))then
  hero.x-=0.7
 elseif(hero.fh and mcol(0,hero.x,hero.y+7))then
  hero.x+=0.7
 end
 if(ecol())then
  lives-=1
  if(lives>=0)then sfx(4) end
  state.tick=64
  state.update=ushake
 elseif(bellcheck(hero))then
  sfx(2)
  showtimer=true
  bells+=1
  lnum+=1 
  if(bells==5)then
   state.tick=113
	  state.update=usbonus
	 else
   state.tick=64
	  state.update=ulvlwin
	 end
 end
 if(lives<0)then
  sfx(5)
  idie()
 end
 if(hero.x<cx)then
  hero.x=cx
 end
end

-->8
arrowdir={{-1,128,18},{1,-8,18},{-1,128,10},{1,-8,10},{1,-8,34},{-1,128,58},{1,-8,10}}

--enemies
function holeknight(x,y)
	local s = ispr(33,x,y)
	local spd = flr(rnd(32))+16
	s.anim = ianim({33,34,34,34},spd,false)
	s.dmg=true
	s.col={x=x+2,y=y+3,w=5,h=4}
	add(es,s)
	spearhead(x-1,y-8,spd)
	return s
end

function climbknight(x,y)
	local s = ispr(37,x,y)
	s.anim = ianim({37,38},24,false)
	s.state=uclimbknight
	add(es,s)
	return s
end

function fightknight(x,y)
	local s = ispr(39,x,y)
	s.anim = ianim({39,40},12,false)
	s.state= ufightknight
	s.dmg=true
	s.col={x=x+2,y=y+3,w=5,h=4}
	add(es,s)
	return s
end

function paceknight(x,y)
	local s = ispr(39,x,y)
	s.anim = ianim({39,40},12,false)
	s.state= upaceknight
	s.dmg=true
	s.vx=0.4
	s.col={x=x+2,y=y+3,w=5,h=4}
	add(es,s)
	return s
end

function spearhead(x,y,spd)
	local s = ispr(33,x,y)
	s.anim = ianim({35,36,36,36},spd,false)
	s.state = uspearhead
	s.col={x=x+1,y=y,w=2,h=8}
	add(es,s)
	return s
end

function fire(x,y)
	local s = ispr(50,x,y)
	s.anim = ianim({50,51},8,false)
	s.dmg=true
	s.col={x=x,y=y+2,w=8,h=4}
	add(es,s)
	return s
end

function iarrow(x,y,d)
 local a = arrowdir[d]
 local s = ispr(49,x+a[2],y+a[3])
	s.dmg=true
	if(a[1]<0)then
		s.fh=true
	end
	s.d=d
	s.vx=a[1]
	s.col={x=s.x+3,y=s.y+3,w=2,h=0}
	s.state=uarrow
	add(es,s)
	return s
end

function ifireball(x,y,d)
 local s = ispr(57,x,y)
	s.dmg=true
	s.vx=1
	s.anim=ianim({57,58},6)
	s.col={x=s.x+3,y=s.y+3,w=2,h=0}
	s.state=ufireball
	add(es,s)
	return s
end

function princess(x,y)
	local s = ispr(54,x,y)
	s.anim = ianim({54,55},8,false)
	s.fh=true
	s.col={x=s.x+2,y=s.y+2,w=4,h=4}
	add(es,s)
	return s
end

function hearts(x,y)
	local s = ispr(59,x,y)
	s.anim = ianim({59,60},8,false)
	s.state=uheart
	s.col={x=s.x+2,y=s.y+2,w=4,h=4}
	add(es,s)
	return s
end

function uspearhead(s)
	if(s.anim.frame==1)then
	 s.dmg=true
	else
	 s.dmg=false
	end
end

function uclimbknight(s)
 if(s.y>cy+21)then
	 s.y-=0.1
 else
  fightknight(s.x,cy+16)
  del(es,s)
 end
end

function ufightknight(s)
 if(mcol(0,s.x+8,s.y+8))then
	 s.x+=0.5
 	s.col.x=s.x+2
 else
  ifireball(s.x,s.y,2)
  s.state=nil
 end
end

function upaceknight(s)
 if(mcol(0,s.x+8,s.y+8))then
	 s.x+=s.vx
 	s.col.x=s.x+2
 else
		if(s.vx>0)then
		 s.vx=-0.4
		 s.x-=0.4
		 s.fh=true
		else
		 s.vx=0.4
		 s.x+=4
		 s.fh=false
		end
 end
end

function uarrow(s)
 if((s.vx<0 and s.x>cx-8) or (s.vx>0 and s.x<cx+128))then
  s.x+=s.vx
  s.col.x=s.x+4
 else
  add(arrowon,s.d)
  del(es,s)
 end
end

function ufireball(s)
 if((s.vx<0 and s.x>cx-8) or (s.vx>0 and s.x<cx+128))then
  s.x+=s.vx
  s.col.x=s.x+4
 else
  del(es,s)
 end
end

function uheart(s)
 if(rinr(hero.x+1,hero.y+1,6,6,s.col.x,s.col.y,s.col.w,s.col.h))then
  addscore(1000)
  del(es,s)
 end
end

function uprincess(s)
 if(rinr(hero.x+1,hero.y+1,6,6,s.col.x,s.col.y,s.col.w,s.col.h))then
		state.update=uwin
		state.draw=dwin 
 end
end

function ecol()
 for i in all(es)do
 	if(i.dmg)then
	 	if(rinr(hero.x+1,hero.y+1,6,6,i.col.x,i.col.y,i.col.w,i.col.h))then
 		 return i
 		end
 	end
 end
end


