function lvl16()
 cx=(lnum-9)*128
 cy=11*8
 cols={8,6,10}
 bellrope=true
 for x = 8,112,8 do
	 fire(cx+x,cy+72)
	end
	for x = 16,104,16 do
		hearts(cx+x,cy+32)
	end
	for x = 64,104,16 do
		hearts(cx+x,cy+56)
		hearts(cx+x,cy+8)
	end
  paceknight(cx+8,cy+32)
  arrowon={5,6,7}
 local p=princess(cx+24,cy+8)
 p.fh=false
 p.state=uprincess
end

