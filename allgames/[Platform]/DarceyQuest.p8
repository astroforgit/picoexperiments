----game!

function gameinit()

music(00)

camx=0

mode=1

grac=7
ppj=4

h = {}

h.x=-15
h.y=-15

d = {}
d.x=-15
d.y=-15

p = {}

p.x=15
p.y=100
p.dx=0
p.dy=0

end



function gameupdate()

if wo<2 then 
timer+=(1/60)
end


if btnp(4) and tc==29 then
run()
end

----player move


if camx==0 then
if grounded() and (btn(‘)) and p.dx<0.75
then p.dx+=0.05
elseif (btn(‘)) and p.dx>=0.75 
and p.dx<0.85 then p.dx=0.85
end


if grounded()and (btn(‹)) and p.dx>-0.75
then p.dx-=0.05
elseif (btn(‹)) and p.dx<=-0.75
and p.dx>-0.85 then p.dx=-0.85
end

if (not grounded()) and (btn(‘)) and p.dx<0.75
then p.dx+=0.05
elseif (btn(‘)) and p.dx>=0.75 
and p.dx<0.85 then p.dx=0.85
end


if (not grounded())and (btn(‹)) and p.dx>-0.75
then p.dx-=0.05
elseif (btn(‹)) and p.dx<=-0.75
and p.dx>-0.85 then p.dx=-0.85
end

if grounded() then
if (not btn(‹)) 
and (not btn(‘)) then  p.dx*=0.90
end
else
if (not btn(‹)) 
and (not btn(‘)) then  p.dx*=0.94
end
end
end

----gravity

-----gracejump

if camx==0 then
if grounded()==false and grac<3
then
grac+=0.5
end
end



if grounded() then 
grac=0
end


--prejump

if (not grounded()) and 
(btnp(5)) then
ppj=0
end

if ppj<4 then 
ppj+=0.5
end

if grounded() and ppj<4
then jump()
end






---jump
if camx==0 then
if grounded() then
    if (btnp(5)) then
    jump()
     
      
     elseif p.dy>=0 then
   
        p.dy = 0
        p.y+=0
        p.y = flr(flr(p.y)/8)*8
     end
     
     
     
else 

if   grac<=2
   and (btnp(5)) then
  jump()


elseif p.dy<2 then
   
    p.dy += 0.1
end
end

end


if camx==0 then
if (not grounded()) and
 blockll() and (btnp(5)) 
    then
        p.dy=-1.6
        p.dx=1.2
        sfx(00,3)
        p.a_ct=0
        p.a_st=0
     	
end
end


if camx==0 then
if (not grounded()) and blockrr()
    and (btnp(5)) then
        p.dy=-1.6
        p.dx=-1.2
        sfx(00,3)
        p.a_ct=0
        p.a_st=0   	
end


if grounded() and p.dx>0.9 
and (not btn(ƒ))
and (btn(‘))
then p.dx*=0.99
else
if p.dx>0.9 
and (not btn(ƒ))
and (btn(‘))
then p.dx*=0.995
end
end

if grounded() and p.dx<-0.9
and (not btn(ƒ))
and (btn(‹))
then p.dx*=0.99
else
if p.dx<-0.9
and (not btn(ƒ))
and (btn(‹))
then p.dx*=0.995
end 

end

end


if grounddeth() then
death()
end

if spikedeth() then
death()
end

if heart() then
hrt+=1
sfx(01,3)
h.x= flr(p.x)+(2*p.dx)
h.y= flr(p.y+1)+(2*p.dy)
h.a_ct=0
h.a_st=0
eat()
end

if note() then

mode=2
tc+=1
wo=2


mset( (flr(p.x+4)/8)+(le*16), ((flr(p.y+3)/8)+(16*wo)) , 009 )

 
end




if bounce() then
p.dy=-2.5
sfx(02,3)
p.a_ct=0
p.a_st=0
p.y = flr(flr(p.y)/8)*8
end



if p.x>123 then 
levelplus()
end


if p.x<-3 then
levelback()
end

if endwo() then
wo+=1
le=0
p.dy=0
p.dx=0
p.x=4
p.y=112
camx=-128
---hrt=0
---timer=0
end

-----wall ride

if not(grounded()) then
	
	--if ((blockr() and p.dy>1
	--and (btn(ƒ))) 
	--or (blockl() and p.dy>1
	--and (btn(ƒ)))) and p.dy<2 then
	--p.dy+=0.05

	if (blockr()and p.dy>=0
	and (btn(ƒ))) 
	or (blockl()
	and (btn(ƒ)))and p.dy>0
	 then
	p.y+=1
	p.dy=0
	
	elseif (blockr() and p.dy>0
	and not((btn(ƒ)))) 
	or( blockl() and p.dy>0 and
	not((btn(ƒ))))
	then
	p.y+=0.5
	p.dy=0
	
	end
end



if blocku() then
 if p.dy<0 then
 p.dy=0
 p.y = (flr(p.y+2)/8)*8

 end
end

if camx==0 then
p.x+=p.dx
p.y+=p.dy
else
p.a_ct=0
end


if lives<1 then gameover()
end


if blockr() then
 if p.dx>=0 then
 p.dx=0
 p.x = (flr(flr(p.x)/8)*8)
 end
end

if blockl() then
 if p.dx<=0 then
 p.dx=0
 p.x = flr(flr(p.x+7)/8)*8
 end
end

end











