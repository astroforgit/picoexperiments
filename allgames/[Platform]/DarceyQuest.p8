---- code!





function _init()
  titleinit()
spwn=0
le=0
wo=0
deth=0
hrt=0
timer=0
lives=25

music(05)

end


function _update60()
  if (mode == 0) then --title screen mode
    titleupdate()
  elseif (mode==2) then
    interupdate()
  elseif (mode==1)then
   gameupdate()  
  
  
  end
end

function _draw()
  if (mode == 0) then
    titledraw()
  elseif (mode==1) then
    gamedraw()
  elseif (mode==2) then
   interdraw()
  end
  
  

end








------functions!
function eat()
mset( (flr(p.x+4)/8)+(le*16), ((flr(p.y+3)/8)+(16*wo)) , 009 )

end

function death()
p.x=9
p.y=100
p.dy=0
p.dx=0
deth+=1
sfx(03,3)
d.x= flr(p.x)
d.y= flr(p.y)
d.a_ct=0
d.a_st=0
lives-=1
end

function jump()
    p.dy=-1.8
        sfx(00,3)
        p.a_ct=0
        p.a_st=0
        grac=4
        ppj=4
end


function co(co1,co2)
	if(not c_ct) c_ct=0

c_ct+=0.5

	 if(c_ct==300) c_ct=0

if c_ct<150 then return
co1 else return co2
end
	
end

function levelplus()


p.x=-3
le+=1
camx=-128
if wo==1 and le==6
then 
music(05)
end
end

function levelback()

p.x=123
le-=1
camx=120
if wo==1 and le==5
then 
music(00)
end
end



function anim(o,sf,nf,sp,fl)
	if(not o.a_ct) o.a_ct=0
	if(not o.a_st)	o.a_st=0

	o.a_ct+=1

	if(o.a_ct%(60/sp)==0) then
	 o.a_st+=1
	 if(o.a_st==nf) o.a_st=0
 end

	o.a_fr=sf+o.a_st
	spr(o.a_fr,o.x,o.y,1,1,fl)
end

---animation code
function animp()
if grounded() then
	
		if 
	 p.dx<=-0.30 and (btn(‘))
	  then
		anim(p,86,3,5,true)
		
		
		elseif 
	 p.dx>=0.30 and (btn(‹))
	  then
		anim(p,86,3,5)
		
	
		elseif p.dx<-0.4 and btn(ƒ) then	
		anim(p,19,3,5,true)
		p.dx=-1.1
		
	elseif p.dx>0.4 and (btn(ƒ))  then
		anim(p,19,3,5)
		p.dx=1.1
	
	elseif p.dx<-0.15 then
		anim(p,0,3,5,true)
		
	elseif p.dx>0.15  then
		anim(p,0,3,5)
		


	elseif (btn(ƒ)) then
	anim(p,51,3,5) 
	
	elseif (btn(”)) then
	anim(p,3,3,5) 
	
	
	else
	
	anim(p,16,3,5)
	
end
end
	
	
if (not grounded()) then
 if 
	 p.dx<-0.15 then
		
		anim(p,32,3,5,true)
		
	elseif p.dx>0.15  then

		anim(p,32,3,5)
  
	elseif blockl()  then

		anim(p,35,3,5)
	

elseif blockr()  then

		anim(p,35,3,5,true)
	else
	
	anim(p,48,3,5)
end

end





end



function grounded()
 v = mget(((flr(p.x)+5)/8)+(le*16), (flr(p.y)/8+1)+(16*wo))
 j = mget(((flr(p.x)+2)/8)+(le*16), (flr(p.y)/8+1)+(16*wo))
 
 if fget(v, 0) or fget(j, 0) then
 return true
 else return false
 end
end

function blockr()
 v = mget(((flr(p.x)/8)+(le*16)+1), ((p.y+3.5)/8)+(16*wo))
 j = mget(((flr(p.x)/8)+(le*16)+1), ((p.y+4.5)/8)+(16*wo))
 
  if fget(v, 1) or fget(j, 1) then
 return true
 else return false
 end
 

end

function blockl()
 v = mget(((flr(p.x+7)/8)+(le*16)-1), (flr(p.y+3)/8)+(16*wo))
 j = mget(((flr(p.x+7)/8)+(le*16)-1), (flr(p.y+4)/8)+(16*wo))
 
  if fget(v, 1) or fget(j, 1) then
 return true
 else return false
 end
 

end








function blockrr()
 v = mget(((flr(p.x+2)/8)+(le*16)+1), ((p.y+3.5)/8)+(16*wo))
 j = mget(((flr(p.x+2)/8)+(le*16)+1), ((p.y+4.5)/8)+(16*wo))
 
  if fget(v, 1) or fget(j, 1) then
 return true
 else return false
 end
 

end

function blockll()
 v = mget(((flr(p.x+5)/8)+(le*16)-1), (flr(p.y+3)/8)+(16*wo))
 j = mget(((flr(p.x+5)/8)+(le*16)-1), (flr(p.y+4)/8)+(16*wo))
 
  if fget(v, 1) or fget(j, 1) then
 return true
 else return false
 end
 

end







function blocku()
 vu = mget(((flr(p.x+2)/8)+(le*16)),(((p.y)/8)+(16*wo)))
 ju = mget(((flr(p.x+5)/8)+(le*16)),(((p.y)/8)+(16*wo)))
 
  if fget(vu, 5) or fget(ju, 5) then
 return true
 else return false
 end
end


function spikedeth()
 v = mget((flr(p.x+2)/8)+(le*16), (flr(p.y+3)/8)+(16*wo))
 j = mget((flr(p.x+5)/8)+(le*16), (flr(p.y+4)/8)+(16*wo))
 
 if fget(v, 2) or fget(j, 2) then
 return true
 else return false
 end


end

function heart()
 v = mget((flr(p.x+4)/8)+(le*16), (flr(p.y+3)/8)+(16*wo))

 
if v==58  then
 return true
 else return false
 end
end


function note()
 v = mget((flr(p.x+3)/8)+(le*16), (flr(p.y+3)/8)+(16*wo))

 
if v==118  then
 return true
 else return false
 end
end


function endwo()
 v = mget((flr(p.x+4)/8)+(le*16), (flr(p.y+2)/8)+(16*wo))
 j = mget((flr(p.x+4)/8)+(le*16), (flr(p.y+6)/8)+(16*wo))
 
if v==46 or j==46 then
 return true
 else return false
 end
end


function bounce()
 v = mget((flr(p.x+5)/8)+(le*16), (flr(p.y)/8+1)+(16*wo))
 
 j = mget(((flr(p.x+2))/8)+(le*16), (flr(p.y)/8+1)+(16*wo))
 
 if fget(v, 4) or fget(j, 4) then
 return true
 else return false
 end
 
 
end

function grounddeth()
	if p.y>135 then return true
	else return false
 end
end

function gameover()
mode=2
tc=29
timer+=0
music(05)
end






















