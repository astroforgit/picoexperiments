--
-- level layouts
--

function levels()
	--lt--
 if lvl==0 then
	 lname("template")
	end
 --l1--
 if lvl==1 then
	 tmat(0,-5,10,5,1,4,7)
	 tile(0,-5,50,5,8)
	 tmat(0,-5,60,5,5,1,7)
	 tile(50,-5,60,5,11)
	 lname("welcome!")
	end
	--l2--
	if lvl==2 then
	 tmat(-10,-5,-10,5,3,3,8)
	 tile(0,-5,30,5,7)
	 tmat(0,5,40,5,1,4,7)
	 tile(0,5,90,5,11)
	 lname("a change in height")
	end
	--l3--
	if lvl==3 then
	 tmat(-10,-5,0,5,3,2,7)
	 tmat(-10,-5,20,5,3,1,8)
	 tmat(-10,-5,30,5,3,2,7)
	 tmat(-10,-5,50,5,3,1,8)
	 tile(0,-5,60,5,11)
	 lname("short highway")
	end
	--l4--
	if lvl==4 then
	 tile(0,5,10,5,7)
	 tmat(10,15,10,5,1,4,7)
	 tmat(-10,15,40,5,2,1,8)
	 tile(-20,15,40,5,7)
	 tile(-30,15,40,5,11)
	 lname("up we go")
	end
	--l5--
	if lvl==5 then
	 tmat(0,-5,-30,5,1,3,7)
	 tile(0,-5,-40,5,8)
	 tmat(0,-5,-60,5,1,2,7)
	 tile(0,-5,-70,5,11)
	 lname("backwards")
	end
	--l6--
	if lvl==6 then
	 tmat(0,-5,10,5,1,3,7)
	 tile(0,-5,40,5,9)
	 tile(0,-5,80,5,7)
	 tile(0,-5,90,5,9)
	 tile(0,-5,130,5,7)
	 tile(0,-5,140,5,11)
	 lname("what is that?")
	end
	--l7--
	if lvl==7 then
	 tile(0,5,10,5,7)
	 tile(0,5,20,5,9)
	 tile(0,5,60,5,7)
	 tile(10,5,60,5,9)
	 tile(50,5,60,5,7)
	 tile(50,5,70,5,9)
	 tile(50,5,110,5,11)
	 lname("warp zone")
	end
	--l8--
	if lvl==8 then
	 tmat(-20,-5,-20,5,5,5,8)
	 tile(0,-5,30,5,9)
	 tile(0,-5,-30,5,9)
	 tile(30,-5,0,5,9)
	 tile(-30,-5,0,5,9)
	 tile(0,-5,-70,5,11)
	 tile(0,-5,70,5,7)
	 tile(70,-5,0,5,8)
	 tile(-70,-5,0,5,9)
	 lname("planar")
	end
	--l9--
	if lvl==9 then
	 tmat(0,-5,10,5,1,2,8)
	 tile(0,-5,30,5,7)
	 tmat(0,-5,40,5,1,2,8)
	 tile(0,-5,60,5,7)
	 tmat(-20,5,60,5,2,1,8)
	 tile(-30,5,60,5,11)
	 lname("three step hops")
	end
	--l10--
	if lvl==10 then
	 tmat(-20,-5,0,5,3,3,8)
	 tmat(-40,5,20,5,3,3,8)
	 tile(-20,5,20,5,7)
	 tile(-40,15,40,5,11)
	 lname("go diagonal")
	end
	--l11--
	if lvl==11 then
	 tile(0,-5,10,5,13)
	 tile(0,25,30,5,7)
	 tile(0,25,40,5,11)
	 lname("the highest of all")
	end
	--l12--
	if lvl==12 then
	 tile(0,-15,-10,5,13)
	 tmat(0,25,-50,5,1,4,7)
	 tile(0,25,-60,5,11)
	 lname("reverse psychology")
	end
	--l13--
	if lvl==13 then
	 tile(0,-5,10,5,9)
	 tile(0,-5,50,5,9)
	 tile(0,-5,90,5,9)
	 tile(0,-5,130,5,9)
	 tile(0,-5,170,5,9)
	 tile(0,-5,210,5,11)
	 lname("1 press to win")
	end
	--l14--
	if lvl==14 then
	 tmat(-10,-5,30,5,3,3,7)
	 tmat(-20,-5,80,5,5,5,7)
	 tmat(-30,-5,150,5,7,7,7)
	 tile(0,5,40,5,8)
	 tmat(-10,5,90,5,3,3,8)
	 tmat(-20,5,160,5,5,5,8)
	 tile(0,5,210,5,11)
	 lname("expansion")
	end
	--l15--
	if lvl==15 then
	 tmat(-20,-5,0,5,1,5,7)
	 tmat(0,-5,0,5,1,5,7)
	 tmat(20,-5,20,5,1,3,8)
	 tile(-10,-5,20,5,7)
	 tile(20,-5,0,5,11)
	 lname("interjection")
	end
	--l16--
	if lvl==16 then
	 tile(0,-15,10,5,13)
	 tile(0,-15,60,5,7)
	 tile(0,-15,70,5,13)
	 tile(0,25,80,5,7)
	 tile(0,25,90,5,11)
	 lname("2^4")
	end
	--l17--
	if lvl==17 then
	 tmat(0,-5,10,5,1,7,7)
	 tmat(0,-5,80,5,1,2,8)
	 tile(0,-5,100,5,11)
	 tile(0,15,20,5,8)
	 lname("watch your head")
	end
	--l18--
	if lvl==18 then
	 tile(0,-5,10,5,9)
	 tile(40,-5,10,5,13)
	 tile(40,25,10,5,11)
	 lname("left forward right")
	end
	--l18--
	if lvl==18 then
	 tile(0,-5,10,5,9)
	 tile(40,-5,10,5,13)
	 tile(40,25,10,5,11)
	 lname("left forward right")
	end
	--l19--
	if lvl==19 then
	 tile(20,-5,20,5,7)
	 tile(40,-5,40,5,7)
	 tile(60,-5,60,5,7)
	 tile(40,-5,80,5,7)
	 tile(20,-5,100,5,7)
	 tile(0,-5,120,5,11)
	 lname("i ‡ diagonals")
	end
	--l20--
	if lvl==20 then
	 tile(0,-5,10,5,13)
	 tile(0,25,10,5,9)
	 tile(0,25,50,5,7)
	 tile(0,25,60,5,9)
	 tile(10,25,60,5,7)
	 tile(-40,25,60,5,7)
	 tile(-50,25,60,5,11)
	 lname("countdown begin")
	end
	--l21--
	if lvl==21 then
	 tmat(-30,-5,-30,5,7,7,8)
	 tile(0,-5,40,5,7)
	 tmat(-30,-5,50,5,7,7,8)
	 tile(0,-5,80,5,7)
	 tile(0,-5,120,5,11)
	 lname("5 cents in a nickel")
	end
	--l22--
	if lvl==22 then
	 tmat(-20,-5,-20,5,5,11,13)
	 tmat(-20,25,-20,5,5,11,8)
	 tile(-20,-5,20,5,7)
	 tile(-20,-5,50,5,7)
	 tile(20,-5,50,5,7)
	 tile(30,-5,50,5,11)
	 lname("4 letters in four")
	end
	--l23--
	if lvl==23 then
	 tile(0,-5,40,5,8)
	 tile(0,-5,-40,5,11)
	 lname("3 tiles over here")
	end
	--l24--
	if lvl==24 then
	 tmat(-20,-5,20,5,1,6,7)
	 tmat(-50,-5,70,5,3,1,7)
	 tile(-60,-5,70,5,11)
	 tmat(-30,5,60,5,2,2,8)
	 tile(20,-5,20,5,9)
	 tile(20,-5,60,5,9)
	 tile(20,-5,100,5,13)
	 tile(20,25,100,5,9)
	 tile(60,25,100,5,7)
	 tile(70,25,100,5,11)
	 lname("2 routes through")
	end
	--l25--
	if lvl==25 then
	 tile(0,-5,10,5,9)
	 tile(0,-5,50,5,9)
	 tile(0,-5,90,5,7)
	 tile(10,-5,100,5,9)
	 tile(50,-5,100,5,9)
	 tile(90,-5,100,5,7)
	 tile(100,-5,100,5,11)
	 lname("1 last level")
	end
end

function lname(name)
 print(name,1,115,6)
end
