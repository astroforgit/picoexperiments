pico-8 cartridge // http://www.pico-8.com
version 32
__lua__
--
-- jumpit-8
-- a small 3d game
--

function vars3d() -- 3d vars
 vf=150
 cx=0
 cy=10
 cz=-50
 crx=-20
 cry=0
end
function varsgame() -- game vars
 sld={}
 kll={}
 gol={}
 wrp={}
 bnc={}
 rt=0 -- render tick
 px=0
 py=0
 pz=0
 pyv=0
 ld=0
 done=false
end

vars3d()
varsgame()
lvl=1
cc=1
tss=flr(time())
function _update()
 -- controls
 if lvl>25 then
  done=true
  cls()
  print("congrats!",47,14,7)
  print("you have completed",28,32,12)
  print("jumpit-8!",47,38,12)
  print("jumpit-8",48,56,13)
  print("created in",44,62,13)
  print("2 days by",46,68,13)
  print("francisco75s",40,74,13)
  spr(0,119,119)
  
  print("your time:",45,92,1)
  local totss=tostring(tss)
  local dist = 64-((#(totss.." seconds"))*2)
  print(tss.." seconds",dist,98,13)
 else
	 if btnp(0) then --left
	  px=px-10
	  ld=0
	 end
	 if btnp(1) then --right
	  px=px+10
	  ld=1
	 end
	 if btnp(2) then --forward
	  pz=pz+10
	  ld=2
	 end
	 if btnp(3) then --backward
	  pz=pz-10
	  ld=3
	 end
	 -- set camera
	 cx=px
	 cy=py*(cc*.5)+20
	 cz=pz-75
	 
	 -- collision
	 if colcheck(sld) then 
	  pyv=3
	  sfx(2)
	 elseif colcheck(bnc) then
	  pyv=5
	  sfx(4)
	 elseif colcheck(kll) then
	  sfx(0)
	  varsgame()
	 elseif colcheck(gol) then 
	  lvl=lvl+1
	  if lvl<26 then sfx(1) end
	  if lvl>25 then tss=flr(time())-tss+1 end
	  varsgame()
	 elseif colcheck(wrp) then
	  sfx(3)
	  pyv=0
	  if ld==0 then px=px-40 end
	  if ld==1 then px=px+40 end
	  if ld==2 then pz=pz+40 end
	  if ld==3 then pz=pz-40 end
	 end
		py=py+pyv
		pyv=pyv-.25
	 
	 -- col checks
	 if rt>1 then
	  if not(colcheck(sld)) then
		  if py<-20 then
			  sfx(0)
			  px=0
			  pz=0
			  py=0
			 end
			end
	 end
	end
end

function _draw() -- render
 if not(done) then
  cls()
	 trc()
	 -- levels (see tab 4)
	 levels()
	 tile(0,-5,0,5,7)
	 -- player & gui
	 shadow()
	 cube(px,py,pz,5,12)
	 rectfill(0,121,128,128,5)
	 print("jumpit-8",87,122,6)
	 print("level "..lvl,1,122,6)
	 spr(0,119,119)
	 spr(1,1,1)
	 print(flr(time())-tss,8,1,7)
	 
	 rt=rt+1
	end
end

-- custom camera
function incdec(b)
 if (b&1 > 0) cc-=1
 if (b&2 > 0) cc+=1
 if cc>2 then cc=0 end
 if cc<0 then cc=2 end
 menuitem(3,"‹ cam "..cc.." ‘",incdec)
 return true
end
menuitem(3,"‹ cam "..cc.." ‘", incdec)
-->8
--
-- essential 3d functions
--

function convp(x,y,z)
 -- converts 3d to 2d
 -- center=0,0 not 64,64
 
 -- define trigs and v-pts
 local six,cox,siy,coy=trc()
 local vx,vy,vz
 
 -- 1st round
 vx,vy,vz=x-cx,y-cy,z-cz
 -- 2nd round
 vx=(vz*siy)-(vx*coy)
 vz=(vz*coy)+(vx*siy)
 --3rd round
 vy=(vy*cox)+(vz*six)
 vz=(vy*six)-(vz*cox)
 
 -- set screen pts
 local scx=vf*(vx/vz)+64
 local scy=vf*(vy/vz)+64
 -- overflow check
 if (vz>-1*vf) and (vz<0) then
  return scx,scy
 else
  return -2,-2
 end
end
function trc()
 -- convert from deg to decimal
 local ccx=crx/360
 local ccy=cry/360
 
 -- sin,cos,return
 local sinx=sin(ccx)
 local cosx=cos(ccx)
 local siny=sin(ccy)
 local cosy=cos(ccy)
 return sinx,cosx,siny,cosy
end

function line3(x1,y1,z1,x2,y2,z2,col)
 local ax,ay=convp(x1,y1,z1)
 local bx,by=convp(x2,y2,z2)
 -- prevent weird line bug on
 -- overflow
 if not(bx==-2 and by==-2 and ax~=-2 and ay~=-2) then
  if not(bx~=-2 and by~=-2 and ax==-2 and ay==-2) then
   -- line based on screen pts
   line(ax,ay,bx,by,col)
  end
 end
end
-->8
--
-- preset shapes & collision
--

-- tile (floor plane)
function tile(x,y,z,r,c)
 line3(x-r,y,z-r,x+r,y,z-r,c)
 line3(x+r,y,z-r,x+r,y,z+r,c)
 line3(x+r,y,z+r,x-r,y,z+r,c)
 line3(x-r,y,z+r,x-r,y,z-r,c)
 
 -- game exclusive
 -- add properties by color
 if rt==1 then
	 if c==7 then -- solid
	  add(sld,x)
	  add(sld,y)
	  add(sld,z)
	 end
	 if c==8 then -- kill
	  add(kll,x)
	  add(kll,y)
	  add(kll,z)
	 end
	 if c==9 then -- warp
	  add(wrp,x)
	  add(wrp,y)
	  add(wrp,z)
	 end
	 if c==13 then -- bounce
	  add(bnc,x)
	  add(bnc,y)
	  add(bnc,z)
	 end
	 if c==11 then -- goal
	  add(gol,x)
	  add(gol,y)
	  add(gol,z)
	 end
	end
end

-- tile matrix shortcut
function tmat(sx,sy,sz,rad,row,col,c)
 for i=0,row-1 do
  for j=0,col-1 do
   tile(sx+i*rad*2,sy,sz+j*rad*2,rad,c)
  end
 end
end

-- cube
function cube(x,y,z,r,c)
 tile(x,y-r,z,r,c)
 tile(x,y+r,z,r,c)
 line3(x-r,y-r,z-r,x-r,y+r,z-r,c)
 line3(x-r,y-r,z+r,x-r,y+r,z+r,c)
 line3(x+r,y-r,z+r,x+r,y+r,z+r,c)
 line3(x+r,y-r,z-r,x+r,y+r,z-r,c)
end


-- collision

-- general collision check
local lowb=-6.5
local uppb=-3.5
function colcheck(t)
 local grp=t
 for i=1,(#grp/3) do
  local x=grp[i*3-2]
  local y=grp[i*3-1]
  local z=grp[i*3]
  if x==px and z==pz and y>py+lowb and y<py+uppb then
   return true
  end 
 end
 return false
end
-- shadows
function shadow()
 for i=1,(#sld/3) do
  local x=sld[i*3-2]
  local y=sld[i*3-1]
  local z=sld[i*3-0]
  if x==px and z==pz then
   tile(x,y,z,5,1)
  end
 end
end

