    rectfill(uix,uiy,127,127,0)
    prntcnt("checking order...",0,uiy,127,127-uiy)
  end
  if (state.alert.checkcap == 110) sfx(3)
  if state.alert.checkcap == 60 then
    level.numcorr = 0
    for i=1,#state.cap do
      local s = state.cap[i]
      if s.spr == obj.sprites[level.getgoal()[i]] then
        level.numcorr += 1
      else
      end
    end
  end
  if state.alert.checkcap == 60 then
    if level.numcorr == #level.getgoal() then
      sfx(4)
    else sfx(5) end
  end
  if state.alert.checkcap <= 60 and
    state.alert.checkcap > 0 then
    local shake = (state.alert.checkcap < 60 and
      state.alert.checkcap > 45 and
      level.numcorr < #level.getgoal())
      and sin(state.alert.checkcap/4) or 0
    for i=1,#state.cap do
      local s = state.cap[i]
