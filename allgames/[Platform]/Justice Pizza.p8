    local s = 
      (level.numcorr == #level.getgoal() or level.finished) and 70 or
      state.alert.checkcap < 0 and 66 or
      state.alert.checkcap > 60 and 68 or 
      72
    spr(s,
      7*8+3,10*8+2+(flash(1) and 1 or 0),1.5,1.5)
  end

  level.draw()

  -- print(':'..(stat(7)),0,120,7)
end
-->8
level = {}
function level.init()
  level.inittime = 0
  level.starttime = 0
  level.started = false
  level.finishtime = 0
  level.finished = false
  level.changetime = 0
  level.changing = false
  -- level.shownux = false
  level.numcorr = 0
  state.level += 1
  state.obj = {}
  state.bullets = #level.getgoal()
  state.cap = {}
  state.alert = {}
  state.alert.outofbullets = -1
  state.alert.checkcap = -1
  state.alert.releasecap = -1
  state.alert.startgame = -1
end
function level.update()
  level.inittime += 1
  if not level.started then
    if key[4].up or key[5].up then
      sfx(8)
      level.started = true
      level.starttime = level.inittime + 0
      player.init()
      if (state.level > 0) obj.init(levels[state.level][2])
      bullets.releaseall()
    end
  end

  if state.alert.startgame == 0 then
    level.init()
  end

  if state.alert.checkcap == 0 then
    if level.numcorr == #level.getgoal() then
      level.finish()
    else
      obj.releaseall()
      bullets.releaseall()
    end
  end

  if level.finished then
    if key[4].up or key[5].up then
      level.changing = true
      level.changetime = level.inittime
    end
  end
  if level.changing and
    level.inittime - level.changetime > 30 then
    if state.level + 1 > #levels then
      state.level = -1
    end
    level.init()
  end
end
function level.getgoal()
  return (state.level > 0) and levels[state.level][1] or {}
end
function level.isactive()
  return not (level.finished or level.changing) and level.started
end
function level.finish()
  level.finished = true
  level.finishtime = level.inittime
end
function level.draw()
  if not level.started or
    level.inittime-level.starttime<30 then
    if state.level == 0 and level.inittime-level.starttime == 1 then
      sfx(6)
    end
    local c = 0
    for y=0,48 do
      for x=0,127 do 
        c =
          (y==0 or y==48) and 7 or
          (y==16) and 7 or
          (y>16 and y<48) and 3
          or 8
        if (not level.started and level.inittime>((x+y)/8+cos(y/4))) or
          (level.started and (level.inittime-level.starttime)<((x+y)/8+cos(y/4))) then
          pset(x,y+38+(sin((time()/2)+x/100)*1.1),c)
        end
      end
    end
    clip(level.started and (level.inittime-level.starttime)*5 or 0,
      0,level.inittime*5,127)
    local wave = sin((time()/2)+.7)*1.1
    if state.level > 0 then
      local title = "deliver order "..state.level
      prntcnt(title,0,0,127,127,2,false,0,-16+wave)
      prntcnt(title,0,0,127,127,1,false,0,-17+wave)
      prntcnt(title,0,0,127,127,7,false,0,-18+wave)
    end
    if state.level == 0 then
      local x,y = 12,20
      pal(7,8)
      spr(114,x-1,y-1,12,9)
      spr(114,x-1,y,12,9)
      spr(114,x-1,y+1,12,9)
      spr(114,x+1,y-1,12,9)
      spr(114,x,y-1,12,9)
      pal(7,1)
      spr(114,x+2,y+2,12,9)
      spr(114,x+3,y+3,12,9)
      pal(7,8)
      spr(114,x+1,y+1,12,9)
      pal()
      spr(114,x,y,12,9)
      wave += 8
      prntcnt("'we do justice to your order!'",0,0,127,127,1,true,0,5+wave)
      prntcnt("'we do justice to your order!'",0,0,127,127,1,true,-1,5+wave)
      prntcnt("'we do justice to your order!'",0,0,127,127,1,true,1,5+wave)
      prntcnt("'we do justice to your order!'",0,0,127,127,1,true,1,4+wave)
      prntcnt("'we do justice to your order!'",0,0,127,127,1,true,-1,4+wave)
      prntcnt("'we do justice to your order!'",0,0,127,127,1,true,1,3+wave)
      prntcnt("'we do justice to your order!'",0,0,127,127,1,true,-1,3+wave)
      prntcnt("'we do justice to your order!'",0,0,127,127,1,true,0,3+wave)
      prntcnt("'we do justice to your order!'",0,0,127,127,7,true,0,4+wave)
      local st = flash(2.1) and "PRESS Z TO START"
        or "BY JULIUS TARNG"
      prntcnt(st,0,111,127,16,7,true)
    elseif state.level == 1 then
      prntcnt("SHOOT AND GET THE TOPPINGS",0,0,127,127,7,true,0,12+wave)
      prntcnt("PRESS Z TO SHOOT",0,111,127,16,7,true)
    elseif state.level > 2 then
      prntcnt("REMEMBER THE TOPPINGS",0,0,127,127,7,true,0,12+wave)
      -- prntcnt("SHOOT WITH Z",0,0,127,127,7,true,0,20)
      -- prntcnt("TOUCH TO CAPTURE",0,0,127,127,7,true,0,28)
      -- prntcnt("PRESS Z TO CONTINUE",0,111,127,16,7,true)
    elseif state.level == 2 then
      prntcnt("TIP: HOLD Z TO RETRY A LEVEL",0,0,127,127,7,true,0,12+wave)
    end
    local s = level.getgoal()
    for i=1,#s do
      level.drawgoalicon(obj.sprites[s[i]],i,62+wave,true)
      -- spr(obj.sprites[s[i]],i*12,16)
    end
    clip()
  elseif level.finished then
    local c = 0
    for y=0,20 do
      for x=0,127 do 
        c = (y==0 or y==20) and 7
          or 8
        if (not level.changing and (level.inittime-level.finishtime)>((x+y)/8+cos(y/4))) or
          (level.changing and (level.inittime-level.changetime)<((x+y)/8+cos(y/4))) then
          pset(x,y+52+(sin((time()/2)+x/100)*1.1),c)
        end
      end
    end

    clip(level.changing and (level.inittime-level.changetime)*5 or 0,
      0,(level.inittime-level.finishtime)*5,127)
    local s = "order "..state.level.." delivered"
    if state.level + 1 > #levels then
      s = "all orders finished!"
    end
    prntcnt(s,0,0,127,127,2)
    prntcnt(s,0,0,127,127,1,false,0,-1)
    prntcnt(s,0,0,127,127,7,false,0,-2)
    clip()
    -- prntcnt("PRESS Z TO CONTINUE",0,111,127,16,7,true)
    -- prntcnt("YOU GOT:",0,0,127,127,7,true,0,12)
    -- local s = levels[state.level][1]
    -- for i=1,#s do
      -- spr(obj.sprites[s[i]],i*12,16)
      -- level.drawgoalicon(obj.sprites[s[i]],i,60,true)
    -- end
    -- for i=1,#state.cap do
      -- spr(state.cap[i].spr,i*12,28)
      -- level.drawgoalicon(state.cap[i].spr,i,83)
    -- end
  end
end
function level.drawgoalicon(s,i,y,hidebg)
  local x = (((i-1)*12) + (128-(#level.getgoal()*12))/2) + 1
  if not hidebg then
    spr(5,x-1,y-3,2,3)
  end
  spr(s,x,y)
end
obj = {}
obj.sprites = {17,33,49}
function obj.init(shapes)
  for i=1,#shapes do
    add(state.obj, obj.gen(obj.sprites[shapes[i]]))
  end
end
function saferndpos()
  local o = {}
  local validcoords = {}
  for i=1,14 do
    for j=1,14 do
      -- flag 0 for spawnable
      if fget(mget(i,j),0) then
        local coord = {}
        coord.x = i * 8
        coord.y = j * 8
        add(validcoords,coord)
      end
    end
  end
  return validcoords[ceil(rnd(#validcoords))]
end
function safernddel()
  local o = {}
  local spd = 1
  o.dx = (rnd(2) - 1) * spd
  o.dy = (rnd(2) - 1) * spd
  return o
end
function obj.gen(spr,x,y,xd,yd)
  local o = {}
  o.spr = spr or 0
  o.w = 8
  o.h = 8
  local p = saferndpos()
  local d = safernddel()
  o.x = x or p.x
  o.xd = xd or d.dx
  o.y = y or p.y
  o.yd = yd or d.dy
  o.bullet = nil
  o.captured = false
  o.capturedtimer = 0
  return o
end
function obj.update()
  for i=2,#state.obj do
    local o = state.obj[i]
    o.x += o.xd
    -- check new position collision results
    local colres = col_map(o)
    if colres.left then
      o.x -= o.xd
      o.xd = -o.xd
    elseif colres.right then
      o.x -= o.xd
      o.xd = -o.xd
    end
    o.y += o.yd
    -- must do y separately from x to simplify checks
    -- check new position collision results
    local colres = col_map(o)
    if (colres.top or colres.bottom) then
      o.y -= o.yd
      o.yd = -o.yd
    end

    -- SHAPE COLLISION BULLET
    if not (o.captured or o.bullet) then
      local b = bullets.collide(o)
      if b and not b.wall then
        o.bullet = b
        b.capture = true
        sfx(8)
      end
    end

    if coll(player.get(),o) then
      if o.bullet and o.bullet.wall and
        not o.captured then
        o.captured = true
        o.capturedtimer = 30
        add(state.cap, o)
        o.capi = #state.cap
        sfx(1)
      end
    end
    if o.captured then
      -- dock captured shapes
      o.x = cvtrng(o.capturedtimer,30,0,
      o.bullet.x,((o.capi-1)*12) + (128-(#level.getgoal()*12))/2) + 1
      o.y = cvtrng(o.capturedtimer,30,0,
        o.bullet.y,116)
      o.y += sin(cvtrng(o.capturedtimer,30,0,0,.5)) * 40
      o.capturedtimer = max(o.capturedtimer-1.5,0)
    elseif o.bullet then
      o.x = o.bullet.x
      o.y = o.bullet.y
    end
  end
end
function obj.releaseall()
  for i=2,#state.obj do
    local o = state.obj[i]
    if o.bullet then
      state.obj[i] = obj.gen(o.spr)
    end
  end
  state.cap = {}
end
function obj.draw()
  for i=2,#state.obj do
    local o = state.obj[i]
    if i > 1 then
      if o.captured then
        -- circfill(o.x + 3.5, o.y + 3.5, 4, 7)
        spr(5,o.x-1,o.y-3,2,3)
      elseif o.bullet and o.bullet.wall then
        if col_map(o.bullet).right then
          spr((flash(.4) and 3 or 35)
            ,o.x-1,o.y-3,2,2)
        else
          spr((flash(.4) and 3 or 35)
            ,o.x-7,o.y-3,2,2,true)
        end
      elseif o.bullet then
        spr(5,o.x-1,o.y-3,2,3)
      end
    end
    local fl = false
    if not o.captured then
      fl = flash(cvtrng(abs(o.xd),0,2,1,.2))
    end
    spr(o.spr+(fl and 1 or 0),
      o.x,o.y)
  end
end
player = {}
function player.init()
  player.trail = {}
  local x,y = 60,
    state.level == 0 and 56 + 24 or 56
  local o = obj.gen(1,x,y,0,g.grav)
  o.yj = 0
  o.grounded = false
  o.faceright = true
  add(state.obj, o) --player
end
function player.update()
  if (not player.get() or not level.isactive()) return
  local xd = player.get('xd')
  local xd2 = xd
  local acc = .2
  local dec = .2
  local maxacc = 2
  if key[0].held then
    xd2 = max(xd-acc,-maxacc)
    player.set('faceright',false)
  elseif key[1].held then
    xd2 = min(xd+acc,maxacc)
    player.set('faceright',true)
  else
    if xd > 0 then
      xd2 = max(xd-dec,0)
    elseif xd < 0 then
      xd2 = min(xd+dec,0)
    end
  end
  local yj = player.get('yj')
  if key[2].down and player.get('grounded') then
    player.set('yj',-5)
    sfx(2)
  elseif yj < 0 then
    if key[2].held and yj > -20 then
      player.set('yj',min(yj+.2,0))
    else
      player.set('yj',0)
    end
  end
  player.set('xd',xd2)

  -- PLAYER COLLISION MAP
  local o = state.obj[1]
  o.x += o.xd
  -- check new position collision results
  local colres = col_map(o)
  if (colres.left or colres.right) o.x -= o.xd
  o.y += o.yd + o.yj
  -- must do y separately from x to simplify checks
  -- check new position collision results
  local colres = col_map(o)
  if (colres.top or colres.bottom) o.y -= o.yd + o.yj
  o.grounded = (o.yj + o.yd > 0) and colres.bottom
  -- PLAYER AT GOAL
  if colres.goal and
   (#state.cap == #level.getgoal()) and
   state.alert.checkcap < 0
   and level.isactive() then
    state.alert.checkcap = 120
  end
  -- PLAYER AT HOME FOR INITIAL LEVEL
  if colres.home and state.level == 0 and
    state.alert.startgame < 0  then
    state.alert.startgame = 15
    sfx(7)
  end

  -- PLAYER COLLISION BULLET
  local b = bullets.collide(o)
  if b and b.wall then
    del(bullets,b)
    sfx(8)
  end

  -- PLAYER ATTACK
  if key[4].down then
    if not bullets.gen() then
      state.alert.outofbullets = 30
      sfx(9)
    end
  end
  -- PLAYER RELEASE
  if key[4].held then
    state.alert.releasecap += 2
    if state.alert.releasecap > 30 then
      obj.releaseall()
      bullets.releaseall()      
    end
  elseif key[4].up then
    state.alert.releasecap = -1
  end

  player.gentrail()
end
function player.gentrail()
  if #player.trail > 10 then
    del(player.trail,player.trail[1])
  end
  add(player.trail,{player.get('x'),player.get('y')})
end
function player.draw()
  o = player.get()
  if (not o) return
  -- player
  local bounce = (flash(cvtrng(abs(o.xd),0,2,1,.2)) and 1 or 0)
  spr((player.get('yj') < 0 and 11 or o.spr) +bounce,o.x,o.y,1,1,not player.get('faceright'))
  -- no ammo
  if state.alert.outofbullets > -1 then
    spr(flash(.4) and 0 or 16,o.x,o.y - 8)
  end
end
function player.set(key,value)
  state.obj[1][key] = value
end
function player.get(key)
  if key then
    return state.obj[1][key]
  end
  return state.obj[1]
end
bullets = {}
function bullets.gen()
  if state.level == 0 or
    #bullets < state.bullets then
    local o = obj.gen(0,
      player.get('x'), player.get('y'))
    o.dx = (player.get('faceright') and 4 or -4)
    o.wall = false
    o.capture = false
    add(bullets,o)
    sfx(0)
    return true
  end
end
function bullets.releaseall()
  for i=1,#bullets do
    del(bullets,bullets[1])
  end
end
function bullets.update()
  for i=1,#bullets do
    o = bullets[i]
    o.x += o.dx
    local colres = col_map(o)
    if o.dx > 0 and colres.right then
      o.dx = 0
      o.wall = true
      sfx(7)
    elseif o.dx < 0 and colres.left then
      o.dx = 0
      o.wall = true
      sfx(7)
    end
  end
end
function bullets.draw()
  for i=1,#bullets do
    o = bullets[i]
    if not o.capture then
      -- circfill(o.x+4,o.y+4,2,7)
      if o.wall then
        spr(flash(.4) and 43 or 44,o.x,o.y)
      else
        spr(flash(.4) and 32 or 48,o.x,o.y,1,1,(o.dx < 0))
      end
    end
  end
end
function bullets.collide(o)
  for i=1,#bullets do
    b = bullets[i]
    if not b.capture and not o.captured then
      bl = b.x + 2
      br = b.x + 2 + 4
      bt = b.y + 2
      bb = b.y + 2 + 4
      if not (o.x > br or bl > (o.x + o.w) or
        o.y > bb or bt > (o.y + o.w)) then
        b.i = i
        return b
      end
    end
  end
end
-->8
function coll(a,b)
  bl = b.x
  br = b.x + b.w
  bt = b.y
  bb = b.y + b.w
  if not (a.x > br or bl > (a.x + a.w) or
    a.y > bb or bt > (a.y + a.w)) then
    return true
  end
end
function col_map(o)
  local result = {}
  local x = o.x
  local y = o.y
  local w = o.w
  local h = o.h
  local cl = flr(x/8) -- col left
  local cr = flr((x+w-1)/8) -- col right
  local rt = flr(y/8) -- row top
  local rb = flr((y+w-1)/8) -- row bot
  -- topleft, bottomleft
  result.left = fget(mget(cl,rt),1) or
    fget(mget(cl,rb),1)
  -- topright, bottomright
  result.right = fget(mget(cr,rt),1) or
    fget(mget(cr,rb),1)
  -- topleft, topright
  result.top = fget(mget(cl,rt),1) or
    fget(mget(cr,rt),1)
  -- bottomleft, bottomright
  result.bottom = fget(mget(cl,rb),1) or
    fget(mget(cr,rb),1)
  -- goal
  result.goal = fget(mget(cl,rt),2) or 
    fget(mget(cl,rb),2) or fget(mget(cr,rt),2) or
    fget(mget(cr,rb),2) 
  -- home
  result.home = fget(mget(cl,rt),3) or 
    fget(mget(cl,rb),3) or fget(mget(cr,rt),3) or
    fget(mget(cr,rb),3) 
  return result
end
function xmap(x)
  return flr(x/8)
end
function ymap(y)
  return flr(y/8)
end
function flash(speed)
  return mod(time(),speed) < speed/2
end
function mod(a,b)
  return a - flr(a/b)*b
end
function cvtrng(v,min1,max1,min2,max2)
  -- range to 0-1
  local progress = (v-min1)/(max1-min1)
  -- 0-1 to range
  return (progress*(max2-min2)) + min2
end
function animval(t,tstart,tend,vstart,vend)
  if t >= tstart and t < tend then
    return cvtrng(t,tstart,tend,vstart,vend)
  end
end
function animvalend(t,tstart,tend,vstart,vend)
  return animval(t,tstart,tend,vstart,vend) or vend
end
-->8
key={}
function key.init(self)
  local base = {}
  base.down = false -- pulse on key down
  base.held = false -- is down
  base.up = false -- pulse on key up
  self[0] = shallowcopy(base)
  self[1] = shallowcopy(base)
  self[2] = shallowcopy(base)
  self[3] = shallowcopy(base)
  self[4] = shallowcopy(base)
  self[5] = shallowcopy(base)
end
function key.update(self)
  for i=0,#self do
    if btn(i) then
      -- if wasn't held and now is
      if not self[i].held then self[i].down = true
      else self[i].down = false end
      self[i].held = true
    else
      -- -- if was held and now its not
      if self[i].held then self[i].up = true
      else self[i].up = false end
      self[i].held = false
    end
  end
end

function shallowcopy(orig)
  local orig_type = type(orig)
  local copy
  if orig_type == 'table' then
    copy = {}
    for orig_key, orig_value in pairs(orig) do
      copy[orig_key] = orig_value
    end
  else -- number, string, boolean, etc
    copy = orig
  end
  return copy
end
function prntcnt(s,x,y,w,h,clr,small,xoff,yoff)
  local cnt = cntstr(s,x,y,w,h,small)
  print(s,cnt[1]+(xoff and xoff or 0)+1,cnt[2]+(yoff and yoff or 0),clr or 7)
end
function cntstr(str,x,y,w,h,small)
  local charh = small and 4 or 5
  local newx = x+(w-(4*#str)-1)/2
  local newy = y+(h-charh)/2
  return {newx,newy}
end
