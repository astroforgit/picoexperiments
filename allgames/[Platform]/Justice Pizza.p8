    --     "3.deliver pizza\n",x+4,y+4+20,1)      
    --   prntcnt("press z to continue",0,111,127,16,1)
    -- end
  else
    mset(7,12,96)
    mset(8,12,97)
  end
  -- if not state.gamestart then
  --   local c = 0
  --   for y=0,20 do
  --     for x=0,127 do 
  --       c = (y==0 or y==20) and 7
  --         or 8
  --       if (not level.gamestart and (level.inittime-level.finishtime)>((x+y)/8+cos(y/4))) or
  --         (level.changing and (level.inittime-level.changetime)<((x+y)/8+cos(y/4))) then
  --         pset(x,y+52+(sin((time()/2)+x/100)*1.1),c)
  --       end
  --     end
  --   end

  --   clip(level.changing and (level.inittime-level.changetime)*5 or 0,
  --     0,(level.inittime-level.finishtime)*5,127)
  --   prntcnt("order "..state.level.." delivered",0,0,127,127,2)
  --   prntcnt("order "..state.level.." delivered",0,0,127,127,1,false,0,-1)
  --   prntcnt("order "..state.level.." delivered",0,0,127,127,7,false,0,-2)
  --   clip()
  --   local x,y = 40,20
  --   rectfill(x,y,119,127,7)
  --   print("justice pizza",x+4,y+4,1)

  --   print("we do justice \nto your pizza!",x+4,y+4+8,1)
  --   print("job application",x+4,y+4+24,1)
  -- end
  -- if (not state.gamestart) return
