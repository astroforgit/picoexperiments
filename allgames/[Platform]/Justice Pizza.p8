    and sin(state.alert.outofbullets/4) or 0
  for i=1,state.bullets do
    local cntoff = (127 - (#level.getgoal()*12))/2 + 6
    local bulletanimin =
      not level.started and 30 or
      (level.started and animval((level.inittime - level.starttime
        + (state.bullets-i)*5),
        0, 15, 30, 0) or 0)
    if bullets[i] == nil then
      circfill(((i-1)*12) + cntoff + ammoshake,uiy + 8 + bulletanimin, 2, 10)
