pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
cam={x=0,y=0}
score=0
actors={}
actor={}

function actor:new(o)
	o = o or {}
	o.t=o.t or "actor"
	o.x=o.x or 7*8
	o.y=o.y or 11*8
	o.vsp=0
	o.hsp=0
	o.sdir=o.sdir or 1
	o.gravity=o.gravity or 0.26
	
	setmetatable(o, self)
	self.__index=self
	return o
end


function actor:canfall()

	--get map tile below left
	local	l=mget(flr((self.x+2)/8),flr((self.y+8)/8))
	--check if it's flagged as wall
	
	--get map tile below right
	local	r=mget(flr((self.x+6)/8),flr((self.y+8)/8))
	--check if it's flagged as wall
return (not fget(l,0)) and (not fget(r,0))

end

coin={}
function coin:new(o)
 o=o or {}
	o.t="coin"
 o.alive=o.alive or true
 o.x=o.x or 7
 o.y=o.y or 11
 o.sid=o.sid or 58
 o.life=o.life or -1
 setmetatable(o, self)
	self.__index=self
	return o
end

function coin:init()
 sfx(3,1)
end

function coin:update()
 if(self.alive)then
 
  if(self.life>0)then
   self.life-=1
   if(self.life<=0)then
    self.alive=false
    score+=1
    del(actors,self)
   end
  elseif(life==-1)then
			--be alive until collected
  end
  
 end
end

function coin:draw()
 if(self.alive)then
	 spr(self.sid,self.x*8,self.y*8,1,1)
 end
end

beak={}

function beak:new(o)
 o=actor:new(o)
 o.safe={}
 o.safe.x=7
 o.safe.y=11
 o.safe.camx=0
 o.safe.camy=0
	o.t=o.t or "beak"
	o.id=o or 0
	o.walkspeed=o.walkspeed or 2
	o.airspeed=o.airspeed or 1
	o.walkaccel=o.walkaccel or 1
	o.jumpspeed=o.jumpspeed or 4
	o.flapspeed=o.flapspeed or 1.5
	o.flapx=o.flapx or 0.6
	o.flapy=o.flapy or 0.1
	o.fallspeed=o.fallspeed or 6
	--state machine
	--states
	--	0 - standing / idle
	--	1 - walking
	-- 2 - falling
	--	3 -	jumping
	--	4 -	flapping
	o.state=0
	o.states={"standing","walking","falling","jumping","flapping"}
	o.at=0
	--inventory
	o.held={}
	--sprite	
	o.sprite=0
	o.pdir=0
	o.anim={}
	o.anim.stand=0
	o.anim.splits=13
	o.anim.index=0
	o.anim.walk={1,2,3,4,5,6}
	o.anim.flap={8,9,10,11}
	o.anim.jump=7
	o.anim.fall=12
	
	--return the object and set the metatable
	setmetatable(o, self)
	self.__index=self
	return o
end

--not done
function beak:move()
 --apply the velocity to the position
 self.x+=self.hsp
 self.y+=self.vsp
 local i = 0
 for dog in all(self.held)do
  dog.x=self.x
  dog.y=self.y-8-(i*7)
  i+=1
 end
 
end

function beak:update()
 --left
	b0=btn(0)
	b0p=btnp(0)
	--right
	b1=btn(1)

	--up
	b2=btn(2)
	b2p=btnp(2)
	--down
	b3=btn(3)
	b3p=btnp(3)
	--Ž
	bz=btn(4)
	bzp=btnp(4)
	--—
	bx=btn(5)
	bxp=btnp(5)

	--update the camera position
 local pct={ 
  x=(128-abs(p.x - (cam.x+128)))/128,
 	y=(128-abs(p.y - (cam.y+128)))/128
 }
 if pct.x > .30 then cam.x = cam.x+p.hsp end
	if pct.x < .15 then 
  cam.x = cam.x-p.hsp 
	end
-- if pct.y > .65 then cam.y = cam.y-p.vsp end
-- if pct.y < .35 then cam.y = cam.y-p.vsp end 

 camera(cam.x, cam.y)

	
	--increment state clock
	self.at+=1
	
	--states

	--stand state 
	if(self.state==0)then
		self.sprite=self.anim.stand
		self.hsp=0
		self.vsp=0
		--transitions
		if b0 and b1 then
			--stay here
		elseif b0 or b1 then
			--changing to walking
			self:changestate(1)
   safem=mget(self.x+4,self.y+9)
		elseif not b0 or not b1 then
		 self.hsp=0
		end
		--up
		if b2 then
			--state changing to jumping
			self:changestate(3)
		end
		--down		

		if self:canfall() then
			--state changing to falling
			self:changestate(2)
		end
	end
	
	--walk state
	if self.state==1 then
		if b0 and b1 then
			self:changestate(0)
		elseif b0 then
		 self.pdir=-1
	 elseif b1 then 
	  self.pdir=1
		end
		if b2 then
			self:changestate(3)
		end
		
		--accel from 0 to self.speed
		if abs(self.hsp)<self.walkspeed then
			self.hsp+=self.pdir*min(self.at, self.walkaccel)
		end
		if abs(self.hsp)>self.walkspeed then
			self.hsp=self.pdir*self.walkspeed
		end
		--animate
		local	anidx=(flr(self.at+#self.anim.walk)%#self.anim.walk)+1
		if anidx==1 then	
			sfx(2,0,0)
		end
		self.sprite=self.anim.walk[anidx]
		
		--transitions
		if not(b0 or b1) then
			--state changing to standing
			self:changestate(0)
		end
		if self:canfall() then 
			--state changing to falling
			self.hsp=0.75*self.hsp
			self:changestate(2)
		end
	end
	
	--fall state
	if(self.state==2)then
		self.sprite=self.anim.fall
		--if player flaps
		if b2 and self.at>1 and self.vsp>0 then
			--change state flapping
			self:changestate(4);
		end
		
		--if beak can fall
		if self:canfall() then
			self.vsp+=self.gravity
		else
			--stop at ground, snap to tile
			self.vsp=0
			self.y=flr(self.y/8)*8
			--be walking
			--state changing to standing
		 sfx(2,0)
			self:changestate(0)
		 self.safe.x=self.x
		 self.safe.y=self.y
		 self.safe.camx=cam.x
		 self.safe.camy=cam.y
		end
	end

	--jump state
	if self.state==3 then
		self.sprite=self.anim.jump
		--state entry
		if self.at==0 then
		 self.startspeed=self.hsp
		 
			sfx(0, 1, 0)
			self.vsp-=self.jumpspeed-self.at-#self.held*0.2
		end

		if self:hitwall() then
		 self.startspeed=0
		end
		--deccelerate to airspeed over frames
  if self.startspeed!=0 then
	  self.hsp=lerp(self.startspeed,self.airspeed*self.pdir, min(self.at,10)/10)
		end
		
		self.vsp+=self.gravity

		if self.vsp<0 then
			if self:hithead() then
 			self.vsp=0
 			self.hsp=0
 		end
		end
  
		if self.vsp>0 then
			--state changing to falling
			self:changestate(2)
		end

	end
	
	--flap state
	if(self.state==4)then
		if(self.at==0)then
			sfx(1, 1, 0)
   self.vsp-=self.flapspeed
	 	if abs(self.hsp)<self.flapspeed then

 			if b0 then
	 	  self.hsp-=self.flapx
	 	 end
		 
	 	 if b1 then
	  	 self.hsp+=self.flapx
	 	 end
		
		 end
		 
		 if b2 then
		 self.vsp-=self.flapy
		 end
		end

		--if flap is not over
		if(self.at<#self.anim.flap)then
			self.sprite=self.anim.flap[(flr(self.at+1))]
		else
			self:changestate(2)
		end
		
		--if beak can fall
		if self:canfall() then
			--gravity accelleration
			self.vsp+=self.gravity
		else
			--stop at ground, snap to tile
			self.vsp=0
			self.y=flr(self.y/8)*8
			--be standing
			--st change to walk or stand
			if(abs(self.hsp>0))then
			 sfx(2,0)
				self:changestate(1)
			else
			 			 sfx(2,0)
				self:changestate(0)
			end
		end

	end	
 
	--collision	
 if abs(self.hsp)>0 and self:hitwall() then
 	self.hsp=0
	end
	
	 --any state
 if bzp then
		self:pickup()
	end
	if bxp	then
	 self:putdown()
	end	
  
	--movement
	self:move()
 --respawn
 if self.y>256 then
		self.x=self.safe.x
		self.y=self.safe.y
		cam.x=self.safe.camx
		cam.y=self.safe.camy
 end
end


function beak:draw()
	spr(self.sprite, self.x, self.y,1,1,self.pdir==-1)
end

function beak:canfall()
--do this twice

	--get map tile below left
	local	l=mget(flr((self.x+1)/8),flr((self.y+8)/8))
	--check if it's flagged as wall
	
	--get map tile below right
	local	r=mget(flr((self.x+7)/8),flr((self.y+8)/8))
	--check if it's flagged as wall
return (not fget(l,0)) and (not fget(r,0))

end

function beak:hithead()	
 --get map tile above left
 local xl=flr((self.x+1)/8)
 local xr=flr((self.x+7)/8)
 local y=flr((self.y+1-(6*#self.held)+self.vsp)/8)

 local	l=mget(xl,y)	
--get map tile above right
 local	r=mget(xr,y)	

 --? block reactions
 if(fget(l,2))then
  --change to used block
 	mset(xl,y,27)
 	--create a coin
 	local c = coin:new({life=10})
  c.x=xl
  c.y=y-1
  add(actors, c)
  c:init()
 
 elseif(fget(r,2))then
  --use block
  mset(xr,y,27)
  --create a coin
 	local c = coin:new()
  add(actors, c)
  c.x=xr
  c.y=y-1
  c.life=5
  c:init()
 end
 --check if it's flagged as wall	
 return fget(l,0) or fget(r,0)
end

function beak:hitwall()
	--get map tile side top
	local t
		--get map tile side bottom
	local b

 local xray=0

 local cols={}

 if self.hsp > 0 then
  xray=flr(self.x+7+self.hsp)/8
	elseif self.hsp < 0 then
 	xray=flr(self.x+1+self.hsp)/8
	end

	t=mget(xray,flr((self.y)/8))
	add(cols,t)
	b=mget(xray,flr((self.y+7)/8))
	add(cols,b)
--dog collision
 for i=1,#self.held do
  add(cols, mget(xray,flr((self.y+4-(7*i))/8)))
 end
	
	for col in all(cols)do
	 if(fget(col,0))then
	  return true
  end
	end	
--	return fget(t,0) or fget(b,0)
end


function beak:putdown(index)
 if #self.held>0 then
  index = index or #self.held
  if index>0 then
   self.held[index].held=false
   self.held[index].hsp=self.hsp*1.1
   self.held[index].vsp=self.vsp-self.jumpspeed*0.3
   del(self.held,self.held[index])
  end
 end
end

function beak:toss()
 
end

function beak:pickup()
 --check if there is a dog here
 for a in all(actors)do
  --if colliding with dog
  if(a.t=="dog" and not a.sleeping)then
   if((a.x+4<self.x+8 and a.x+4>self.x)
   and (not(a.y+4>self.y+8) and not(a.y<self.y)))then
	   a.held=true
	   add(self.held,a)
	   return
	  end	 
  end
 end
 
-- if #self.held>0 then
--  local index = #self.held
--  self.held[index].held=false
--  del(self.held,self.held[index])
-- end
 
end

function beak:changestate(s)
	--printh("changing state to "..self.states[s+1])
	self.state=s
	self.at=0
end

dog = {}

function dog:new(o)
 o=actor:new(o)
	o.t="dog"
	o.safex=o.x or 0
	o.safey=o.y or 0
	o.sprite=16
	o.sleeping=false
	o.sdir=o.sdir or false
	o.at=0
	o.anim={}
	o.anim.wag={16,17,18,17}
	o.anim.bed={19,20,21,22,23}
	o.canfall=actor.canfall
--	o.hitwall=actor.hitwall
	setmetatable(o, self)
	self.__index=self
	return o
end

function dog:hitwall()
	--get map tile side top
	local t
		--get map tile side bottom
	local b

 local xray=0

 local cols={}

	if self.hsp>0 then
  xray=flr(self.x+7+self.hsp)/8
	elseif self.hsp<0 then
 	xray=flr(self.x+1+self.hsp)/8
	end

	t=mget(xray,flr((self.y+3)/8))
	add(cols,t)
	b=mget(xray,flr((self.y+6)/8))
	add(cols,b)
		
	for col in all(cols)do
	 if(fget(col,0))then
	  return true
  end
	end	
--	return fget(t,0) or fget(b,0)
end

function dog:hithead()	
 --get map tile above left
 local xl=flr((self.x+1)/8)
 local xr=flr((self.x+6)/8)
 local y=flr((self.y+2+self.vsp)/8)

 local	l=mget(xl,y)	
--get map tile above right
 local	r=mget(xr,y)	

 --? block reactions
 if(fget(l,2))then
  --change to used block
 	mset(xl,y,27)
 	--create a coin
 	local c = coin:new({life=10})
  c.x=xl
  c.y=y-1
  add(actors, c)
  c:init()
 
 elseif(fget(r,2))then
  --use block
  mset(xr,y,27)
  --create a coin
 	local c = coin:new()
  add(actors, c)
  c.x=xr
  c.y=y-1
  c.life=5
  c:init()
 end
 --check if it's flagged as wall	
 return fget(l,0) or fget(r,0)
end

function dog:update()
	self.at+=1
	if not self.held then
 
 	if self:canfall() then
	  self.vsp+=self.gravity
 	elseif not self:canfall() then	
 	 self.vsp=0
	  self.hsp=0
  	self.y=flr(self.y/8)*8
  end
  if self:hitwall() then
   self.hsp=0
--  	self.x=flr((self.x+4)/8)*8
  end
		if self:hithead() then
   self.vsp=0
  	self.x=flr((self.x+4)/8)*8
		end

 end
	self.sprite=self.anim.wag[(flr(self.at+#self.anim.wag)%#self.anim.wag)+1]
 
 xl=flr((self.x+1)/8)
 xr=flr((self.x+7)/8)
	ml=mget(xl,flr((self.y)/8))
 mr=mget(xr,flr((self.y)/8))
 --if touching bed
 if fget(ml,3) then
  self:sleep()
  self.x=xl*8
  local c = coin:new({life=10})
  c.x=(self.x)/8
  c.y=(self.y-6)/8
  add(actors, c)
  c:init()
  mset(flr((self.x+1)/8),flr((self.y)/8),15)
 elseif fget(mr,3) then
  self:sleep()
  self.x=xr*8
  local c = coin:new({life=10})
  c.x=(self.x)/8
  c.y=(self.y-6)/8
  add(actors, c)
  c:init()
  mset(flr((self.x+7)/8),flr((self.y)/8),15)
 end
 
 if self.sleeping then
  self.x=flr((self.x+4)/8)*8
  self.sprite=self.anim.bed[min(self.at,#self.anim.bed)]
 end 
 
 if self.y > 256 and not self.held then
		self.vsp=0
		self.hsp=0
  self.x=self.safex
  self.y=self.safey
 end

	self.x+=self.hsp
	self.y+=self.vsp
end

function dog:sleep()
 --animate go to sleep
 if self.sleeping==false then
  self.sleeping=true
  self.at=1
 end
end

function dog:draw()
	spr(self.sprite,self.x,self.y,1,1,self.sdir)
end

lvl={
	f ={x=0,y=0},
	fm={x=32,y=16},
	bm={x=16,y=16},
	b ={x=0,y=16},
}

moon={
	x=52,
	y=28,
	at=0,
	spd=2,
	clr=13,
	phs=500
}

function moon:animate()
	self.at+=1
	local curx=self.x+(5*sin(self.at/moon.phs))
 local nxtx=self.x+(5*sin((self.at+1)/self.phs))
  
	local cury=self.y+(2*sin(self.at/500))
  
	if(curx>nxtx and(curx>self.x-2 and curx<self.x+2))then
			--don't draw, moon is behind
 else
  pset(cam.x+curx, cam.y+cury, self.clr)
 end
end

	


function lvl:draw()
	--static stuff
	--sine the moon
	camera(0,0)
	--background
	map(self.b.x, self.b.y, 0,0,16,16)
		--mid back
	map(self.bm.x,self.bm.y,0,0,16,16)

	--dynamic stuff
	camera(cam.x,cam.y)
	moon:animate()
	--mid fore
	map(self.fm.x,self.fm.y,0,0,16,16)
	--foreground
	map(flr(cam.x/8),flr(cam.y/8),flr(cam.x/8)*8,flr(cam.y)*8,17,17)
	--text	
	--title
	spr(34,6*8,5*8-3,3,1)
	
	print("by daffodil",4*8+5,6*8+1,1)
	print("by daffodil",4*8+6,6*8,13)
		
	print("” to jump", 112,  82,13)
	print("” to jump", 113,  81,7)
	
	print("flap", 24*8+4,5*8+2,13)
	print("flap", 24*8+5,5*8+1,7)
	print("” in air", 23*8+2,6*8+2,13)
	print("” in air", 23*8+3,6*8+1,7)

 print("it's past their bedtime",35*8+6,6*8+2,13)
 print("it's past their bedtime",35*8+7,6*8+1,7)

	print("Ž or z",35*8+6,8*8+2,13)
	print("Ž or z",35*8+7,8*8+1,7)

	print("pick up",35*8+6,9*8+2,13)
	print("pick up",35*8+7,9*8+1,7)

	print("— or x",43*8+6,8*8+2,13)
	print("— or x",43*8+7,8*8+1,7)
	print("let go",44*8,9*8+2,13)
	print("let go",44*8+1,9*8+1,7)
	
 
end

function lvl:update()
 self.f.x=p.x
end

function _init()
	p = beak:new({})

 add(actors,dog:new({x=37*8,y=13*8,sdir=false}))
 add(actors,dog:new({x=51*8,y=14*8,sdir=true}))

 add(actors,dog:new({x=63*8,y=12*8,sdir=true}))
 add(actors,dog:new({x=69*8,y=12*8,sdir=false}))

 add(actors,dog:new({x=73*8,y=12*8,sdir=false}))
 add(actors,dog:new({x=76*8,y=12*8,sdir=false}))

 add(actors,dog:new({x=89*8,y=13*8,sdir=false}))
 --vents
 add(actors,dog:new({x=99*8,y=13*8,sdir=true}))
 add(actors,dog:new({x=102*8,y=8*8,sdir=true}))
 add(actors,dog:new({x=110*8,y=13*8,sdir=true}))
 add(actors,dog:new({x=111*8,y=12*8,sdir=true}))
end

function _update()
	p:update()
	lvl:update()
	for a in all(actors)do
	 a:update()
 end

--	printh("hsp is "..p.hsp)
--	d:update()
end

function _draw()
	cls()
 lvl:draw()
	p:draw()
	for a in all(actors)do
 	a:draw()
 end
 local token=58
 if score>=21 then
  token=42
 end
 spr(token,cam.x+1*8, cam.y+1*8)
 print(":"..score,cam.x+2*8-1,cam.y+1*8+2,3)
	print(":"..score,cam.x+2*8,cam.y+1*8+1,11)
end


--math stuff
function lerp(from,to,by) return from+(to-from)*by end
