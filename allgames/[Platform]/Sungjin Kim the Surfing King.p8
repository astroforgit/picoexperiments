pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--sukjin kim the surfing king
--by jaemin park

tubes={}
coins={}
player={}

timer=0
score=0

function aabb(a,b)
		if a.x>b.x+b.w then
				return false
		elseif a.x+a.w<b.x then
				return false
		elseif a.y>b.y+b.h then
		  return false
		elseif a.y+a.h<b.y then
				return false
		else
				return true
		end
end

function olprint(s,x,y,c)
		for i=-1,1 do
				for j=-1,1 do
				  print(s,x+j,y+i,0)
				end
		end
		print(s,x,y,c)
end

function drawbg()
		rectfill(0,0,128,128,9)
		circfill(62.5+sin(timer*0.01)*1,80,32,10)
		circfill(66.5-sin(timer*0.01)*1,80,32,10)
		circfill(64,80,32,7)
		rectfill(0,102,128,128,9)
		
		for i=1,32 do
				w=sin(timer/i)*(200/i)
				y=98+i
				rectfill(64-w*2,y,64+w*2,y,10)
				rectfill(64-w,y,64+w,y,7)
		end
end

function drawwave()
		wavex=-((timer*0.4)%16)
		wavey=sin(timer*0.05)*1+94.5
		for i=0,17 do
				spr(4,i*8+wavex,wavey)
		end
end

function title_update()
  timer+=1
  if btn(4) then
    startgamescene()
  end
end

function title_draw()
  drawbg()
  drawwave()
  olprint("the legendary adventure of",12,35,8)
  olprint("sukjin kim the surfing king",10,45,8)
  olprint("game by jaemin park",28,10,7)
  
  olprint("arrow key to move",26,70,7)
  olprint("jump and grab coins!",26,78,7)
  olprint("don't touch sharks!",26,86,7)
  olprint("- [z] to start",26,96,8)
end

function game_update()
		timer+=1
		
		if player.y>96 and not player.gameover then
				player.vy-=3
				if player.vy<-3 then
						player.vy=-3
				end
		else
				player.vy+=0.2
		end
		
		player.y+=player.vy
		
		if not player.gameover then
		  if btn(0) and player.x>4 then
		  		player.x-=2
			  	player.f=true
	  	end
	  	if btn(1) and player.x<118 then
	  			player.x+=2
	  			player.f=false
	  	end
		else
		  player.x-=1
		end
		
		for t in all(tubes) do
				t.x+=t.sx
				if t.sx<0 and t.x<4 then
						t.sx*=-1
				elseif t.sx>0 and t.x>110 then
						t.sx*=-1
				end
				
				t.y=sin(timer*0.02+t.t)*5+101
				
				if aabb(player,t) and not player.gameover then
						if t.shark then
								player.gameover=true
								player.vy=-4
		      music(2)
						else
								sfx(0)
								player.vy=-5
						end
				end
		end
		
		for c in all(coins) do
				c.x-=3
				if c.x<-8 then
						c.x+=136
						c.y=24+rnd()*32
						c.new=true
				end
				
				if c.new and aabb(player,c) then
						if not player.gameover then
								c.new=false
								score+=1
								sfx(7)
						end
				end
		end
		
		if player.gameover and btn(4) then
				startgamescene()
		end
end

function game_draw()
  pal(14,0)
		
		drawbg()
		
		for t in all(tubes) do
				if t.shark then
						spr(5,t.x-2,t.y,2,1,t.sx<0)
				else
				  spr(2,t.x-2,t.y,2,1,t.sx<0)
				end
		end
		
		for c in all (coins) do
				if c.new then
						if timer%10<5 then
								spr(7,c.x-1,c.y-1)
						else
								spr(8,c.x-1,c.y-1)
						end
				end
		end
		
		spr(1,player.x-2,player.y-1,1,1,player.f,player.gameover)
		
		drawwave()
		
		olprint("score: "..score,2,2,8)
  
  if player.gameover then
    olprint("game over!!",42,56,8)
    olprint("press z to try again!",22,64,7)
  end
end

function starttitlescene()
		timer=0
		
		_update = title_update
		_draw = title_draw
		
		music(3)
end

function startgamescene()
		tubes = {}
		for i=1,3 do
				newtube={}
				newtube.x=rnd()*96+16
				newtube.y=97
				newtube.w=14
				newtube.h=6
				newtube.t=rnd()
				newtube.sx=rnd()*3-1.5
				newtube.shark=false
				add(tubes,newtube)
		end
		for i=1,3 do
				newtube={}
				newtube.x=rnd()*96+16
				newtube.y=97
				newtube.w=8
				newtube.h=1
				newtube.t=rnd()
				newtube.sx=rnd()*3-1.5
				newtube.shark=true
				add(tubes,newtube)
		end
		
		coins = {}
		for i=1,5 do
				newcoin={}
				newcoin.x=i*128/5
				newcoin.y=32+rnd()*48
				newcoin.new=true
				newcoin.w=8
				newcoin.h=10
				add(coins,newcoin)
		end
	 
		timer=0
		score=0
		
		player={}
		player.x=64
		player.y=32
		player.w=4
		player.h=8
		player.vy=0
		player.f=0
		player.gameover=false
		
		_update = game_update
		_draw = game_draw
		
		music(0)
end

function _init()
		starttitlescene()
end
