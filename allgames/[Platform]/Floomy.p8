pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- floomy
-- by headchant
function check(x1,y1,w1,h1, x2,y2,w2,h2)
  return x1 < x2+w2 and
         x2 < x1+w1 and
         y1 < y2+h2 and
         y2 < y1+h1
end

function sort(a)
	for i=1,#a do
		local j = i
		while j > 1 and a[j-1] < a[j] do
			a[j],a[j-1] = a[j-1],a[j]
			j = j - 1
		end
	end
	return a
end

function reverse(a)
	local rev = {}
	local len = #a
	local i = 0
	for v in all(a) do
		i+=1
		rev[len+1-i] = v
	end
	return reverse
end

cartdata("headchant_floomy")
for i=0, 63 do
	-- dset(i,nil)
end

scores = {}

globalvars = function()
	p={
		x=64,
		y=64,
	}
	platforms = {}
	items = {}
	cam = p.y
	x, y = 0, 1
	elapsedtime = 0
	jumped = false
	clouds = {}
	score = 0
	platy = 0
	particles = {}
end

endgame = function()
	music()
	sfx(1)
	p.done = true
	for k=1, 16 do
		add(particles,{
			x = p.x+4,
			y = p.y+4,
			ox = cos(k/16)*3,
			oy = sin(k/16)*3,
			update = function(self)
				self.x+=self.ox
				self.y+=self.oy
			end,
			draw = function(self)
				circfill(self.x, self.y, 2,elapsedtime%2==0 and 7 or 1)
			end
		})
	end
	local found
	for i=0,63 do
		if not dget(i) or dget(i) == 0 then
			dset(i, score)
			found = true
			break
		end
	end
	if not found then
		for i=0,63 do
			if dget(i) <= score then
				dset(i, score)
				break
			end
		end
	end

	add(particles, {
		t = 0,
		update = function(self)
			self.t+=1
			if self.t > 60 then
				switchscene(menu)
			end
		end,
		draw = function() end
	})
end


game = {
	init = function()
		music(4)
		globalvars()
		for i=3, 10 do
			local breaks = i > 3 and i%2==0 and rnd() < 0.2
			local spring = not breaks and (rnd() < 0.2)
			local moving = rnd() < 0.2
			platy = i
			add(platforms, {
				sp = 3+(breaks and 3 or 0)+(spring and 16 or 0),
				x = flr(rnd(8))*16,
				y = 128-i*16,
				breaks = breaks,
				spring = spring,
				moving = moving
			})
		end
		-- add the ground
		for i=1,8 do
			add(platforms, {
				sp = 3,
				x = p.x-64+(i-1)*16,
				y = p.y+48,
			})
		end
	end,
	update = function()
		elapsedtime+=1
		if not p.done then
			if (btn(0)) x-=0.5
			if (btn(1)) x+=0.5
			x=x*0.9
			if x > 2 then x = 2 end
			if x < -2 then x = -2 end
			p.x+=x
			if p.x < -4 then p.x = 128 end
			if p.x > 128 then p.x = 0 end
			if not jumped and btnp(4) then
				sfx(6)
				add(particles, {
					x=p.x,
					y=p.y,
					t=0,
					update = function(self)
						self.t+=0.5
						if self.t > 4 then
							del(particles, self)
						end
					end,
					draw = function(self)
						spr(41+flr(self.t),self.x,self.y)
					end
				})
				jumped = true
				y=-4
			end
			if p.item and btnp(4) then
				if p.item.sp == 51 then
					sfx(20)
					for v in all(platforms) do
						if v.spikes then
							v.spikes = nil
							for i=1, 8 do
								add(particles, {
									x = v.x+rnd(16),
									y = v.y-8+rnd(8),
									ox = -1+rnd()*2,
									oy = -1+rnd()*2,
									t = 0,
									update = function(self)
										self.t+=1
										self.x+=self.ox*2
										self.y+=self.oy*2
										if self.t > 60 then
											del(particles, self)
										end
									end,
									draw = function(self)
										rectfill(self.x, self.y, self.x, self.y, 1)
									end,
								})
							end
						end
					end
				end
				p.item = nil
			end
			p.y+=y
		end
		if p.y < cam then
			cam = p.y
				if rnd() < 0.5 	and #clouds < 128 then
					local x = rnd(128)
					local y = 0
					local y = p.y-128+rnd(8)
					local oy = p.y-128+rnd(48)
					for i=1, 32 do
						x += -3+rnd(3)
						y = oy+(-1+rnd()*2)*2
						add(clouds, {
							x=x,
							y=y,
							r=2+rnd(4)
							})
					end
				end

			if #platforms < 12 then
				local py = platy
				for i=py+1, py+2 do
					platy=i
					local breaks = i%3<2 and rnd() < 0.2
					local spring = not breaks and (rnd() < 0.1)
					local moving = rnd() < 0.1+min(0.8, score/10000)
					local spikes = py > 50 and not spring and (rnd() < 0.1+min(0.3, score/20000)) and i%3<2
					local x,y = flr(rnd(8))*16, 128-i*16
					add(platforms, {
						sp = 3+(breaks and 3 or 0)+(spring and 16 or 0),
						x=x,y=y,
						breaks = breaks,
						spring = spring,
						moving = moving,
						spikes = spikes,
						mx = flr(1+rnd(min(5, score/1500)))
					})
					if not moving and not spikes and rnd() < 0.08 then
						if rnd() < 0.5 and i > 100 then
							add(items, {
								x = x+4,
								y = y-8,
								sp = 51
								})
						else
							add(items, {
								x = x+4,
								y = y-8,
								sp = 50
								})
						end
					end
				end
			end
		end
		if y < 2 then y+=0.2 end
		if y > 0 then
			for i in all(platforms) do
				if i.spikes and check(i.x, i.y-8, 16, 8, p.x+1, p.y+3, 7, 4) and not p.done then
					endgame()
				end
				if not btn(3) and check(i.x,i.y,16,1, p.x,p.y+4,8,4) then
					y = -4
					sfx(4)
					-- add breaking particles
					if i.breaks then
						sfx(3)
						del(platforms, i)
						add(particles, {
							x = i.x,
							y = i.y,
							oy = 3+rnd()*2,
							update = function(self)
								self.y+=self.oy
								if self.y > i.y+64 then
									del(particles, self)
								end
							end,
							draw = function(self)
								spr(6, self.x, self.y)
							end
							})
						add(particles, {
							x = i.x+8,
							y = i.y,
							oy = 3+rnd()*2,
							update = function(self)
								self.y+=self.oy
								if self.y > i.y+64 then
									del(particles, self)
								end
							end,
							draw = function(self)
								spr(6, self.x, self.y)
							end
							})
						y = -3
					end
					if i.spring then
						y = -8
						sfx(5)
					end
				end
			end
		end
		for v in all(platforms) do
			if v.moving then
				if not v.ox then v.ox = rnd()<0.5 and -1 or 1 end
				if v.x > 128-16 then v.ox = -1; v.x = 128-16 end
				if v.x < 0 then v.ox = 1; v.x = 0 end
				v.x+=v.ox*(v.mx or 1)
			end
			if v.y > cam+64 then
				del(platforms, v)
			end
		end
		for v in all(items) do
			if check(v.x,v.y,8,8, p.x,p.y,8,8) then
				sfx(2)
				if v.sp == 50 then
					jumped = false
					del(items, v)
					p.item = nil
				else
					jumped = true
					p.item = v
					del(items, v)
				end
			end
			if v.y > cam+64 then
				del(items, v)
			end
		end
		if p.y+4 > cam+64 and not p.done then
			
			endgame()

		end
		for v in all(particles) do
			v:update()
		end
		score = flr(-cam+64)
	end,
	draw = function()
		cls()
		map(0,0)
		camera(0, cam*0.75)
		for i in all(clouds) do
			circfill(i.x, i.y, i.r,7)
			if i.y > cam*0.75+128 then del(clouds, i) end
		end
		camera(0, cam-64)
		for v in all(particles) do
			v:draw()
		end
		for i in all(platforms) do
			spr(i.sp, i.x, i.y, 2, 1)
			if i.spikes then
				local s = 38
				if y > 0 then s = 38 else
					s = 54
				end
				spr(s, i.x, i.y-8)
				spr(s+1, i.x+8, i.y-8)
			end
		end
		for i in all(items) do
			spr(i.sp, i.x, i.y)
		end
		if not p.done then
			if y < -4 then
				spr(49, p.x, p.y+4)
			end
			if y < 0 and y > -4 then
				spr(1+16*(flr(elapsedtime/2)%2),p.x, p.y)
			else
				spr(1,p.x, p.y)
			end
		end

		camera()
		if not jumped then
			print("z=", 112, 2,7)
			spr(50, 120,0)
		elseif p.item then
			print("z=", 112, 2,7)
			spr(p.item.sp, 120,0)
		end
		print(score.."m", 2,2,1)
		print(score.."m", 1,1,7)
	end
}
switchscene = function(scene)
	scene.init()
	_update = scene.update
	_draw = scene.draw
end
menu = {
	init = function()
		music(2)
		scores = {}
		for i=0,63 do
			if dget(i) and dget(i) ~= 0 then
				scores[#scores+1] = dget(i)
			end
		end
		sort(scores)
	end,
	update = function()
		if btn(4) and btn(5) then
			switchscene(game)
		end
	end,
	draw = function()
		cls()
		map(16,9)
		if score then
			print("last score: "..score.."m",32, 38, 7)
		else
			print("by headchant",40, 38, 7)
		end
		print("z+x to start", 40, 128-8)
		local scored = false
		for k=1, 9 do
			local i = scores[k]
			if i then
				local col = 7
				if i == score and not scored then
					col = rnd(7)
					scored = true
				end
				print(k..") "..i.." m", 45, 48+(k-1)*8, col)
			end
		end
	end,
}
switchscene(menu)
