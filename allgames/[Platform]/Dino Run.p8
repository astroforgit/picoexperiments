pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
--dino run
--by pixelcod

function outline_sspr(sx,sy,sw,sh,x,y)
 for i=0,15 do pal(i,7) end
 sspr(sx,sy,sw,sh,x-1,y)
 sspr(sx,sy,sw,sh,x+1,y)
 sspr(sx,sy,sw,sh,x,y-1)
 sspr(sx,sy,sw,sh,x,y+1)
 pal()
end

function draw_sspr(sx,sy,sw,sh,x,y)
 outline_sspr(sx,sy,sw,sh,x,y)
 sspr(sx,sy,sw,sh,x,y)
end

function get_tile(x,y,f)
 return fget(mget(x/8,y/8),f)
end

function init_player()
 px=32
 py=80
 pdy=0
 pw=16
 ph=16
 --sprite info
 psx=8
 psy=0
 psw=16
 psh=16
 pfrm=0
 pcol=colours[flr(rnd(#colours)+1)]
 --jumping
 grounded=true
 grav=0.25
 --player state
 pstate=0
end

function player_anim()
 if global_t%10==0 then
  if pfrm==0 then
   pfrm=1
  elseif pfrm==1 then
   pfrm=0
  end
 end
end

function player_run()
 if (btn(4) or btn(2)) and grounded then
  grounded=false
  pdy=-4
  sfx(1)
 end
 
 if not grounded then
  pdy+=grav
  if py+ph+pdy>=ground then
   grounded=true
  end
 elseif grounded then
  py=ground-ph
  pdy=0
  player_anim()
  if(global_t%10==0)sfx(0)
 end
 
 py+=pdy
end

function player_die()
 if(global_t>60 and (btnp(4) or btnp(2)))init_game()
 if(score>=highscore)highscore=score highscore_col=pcol
 
 pdy+=grav
 py+=pdy
 px+=pdx
end

function update_player()
 if pstate==0 then
  player_run()
 elseif pstate==1 then
  player_die()
 end
end

function draw_player()
 outline_sspr(psx,psy+(16*pfrm),psw,psh,px,py)
 pal(9,pcol)
 sspr(psx,psy+(16*pfrm),psw,psh,px,py)
 pal()
 if pstate==1 then
  pfrm=1
  pal(9,pcol)
  spr(19,px+8,py)
  pal()
  
  sspr(32,8,8,8,px,py)
  sspr(32,8,8,8,px+16,py,8,8,true)
 end
end

function create_floor(x,y,s)
 if global_t%(8/speed)==0 then
  f={
  x=x,
  y=y,
  s=s
  }
  if(flr(rnd(3))==0)f.s=3
  add(floor,f)
  return f
 end
end

function update_floor(f)
 f.x-=speed
 if(f.x+8<=0)del(floor,f)
end

function draw_floor(f)
 spr(f.s,f.x,f.y)
end

function flatten_floor()
 for f in all(floor) do del(f,floor) end
 for i=0,15 do
  create_floor(8*i,ground-8,3)
 end
end

function create_cactus()
 if global_t%(64/speed)==0 then
  if flr(rnd(3))==1 then
   c={
   sz=flr(rnd(2)),
   x=128,
   y=ground,
   passed=false
   }
   if(c.sz==0)c.y=ground-8
   if(c.sz==1)c.y=ground-16
   add(cacti,c)
   return c
  end
 end
end

function collide_player(o)
 if o.x+4>=px and
    o.x+4<=px+pw and
    o.y+4>=py and
    o.y+4<=py+ph then
  return true
 end
end

function update_cactus(c)
 c.x-=speed
 if(c.x+8<=0)del(cacti,c)
 
 if pstate==0 then
  if c.passed==false then
   if(px>=c.x+4)score+=100 c.passed=true
  end
 
  if collide_player(c) then
   pstate=1
   speed=0
   grav=0.1
   pdx=1
   pdy=-2.5
   global_t=0
   sfx(2)
  end
 end
end

function draw_cactus(c)
 draw_sspr(48+(c.sz*8),0,8,8+(c.sz*8),c.x,c.y)
end

function init_game()
 global_t=0
 debug=false
 score=0
 
 speed=2
 ground=96
 
 floor={}
 cacti={}
 flatten_floor()
 init_player()
end

function _init()
 highscore=0
 colours={5,8,9,12,13,14}
 highscore_col=0
 init_game()
end

function _update60()
 update_player()
 
 create_floor(128,ground-8,rnd(3)+3)
 foreach(floor,update_floor)
 
 create_cactus()
 foreach(cacti,update_cactus)
 
 global_t+=1
end

function draw_title()
 cls(7)
 --dino run
 sspr(0,32,32,8,14,4,96,24)
 sspr(0,40,24,8,26,32,72,24)
 --dinosaur
 pal(9,12)
 sspr(8,0,16,16,32,60,64,64)
 pal()
end

function _draw()
 cls(7)
 map()

 --background scene
 circ(96,24,8,10)

 foreach(floor,draw_floor)
 foreach(cacti,draw_cactus)
 draw_player()
 
 if(pstate==0)print("score:"..score,2,11,15)
 if pstate==1 then
  if global_t>=60 then
   print("score:"..score,46,40,15)
   print("highscore:"..highscore,38,48,15)
   
   pal(9,highscore_col)
   spr(21,28,46)
   pal()
  end
 end
 
 --debug
 if debug then
  line(0,ground,128,ground,9)
  print(#floor,16,16,5)
  print(#cacti,16,24,5)
 end
 
 rectfill(0,0,128,8,0)
 rectfill(0,120,128,128,0)
 
 --draw_title()
end
if(_update60)_update=function()_update60()_update_buttons()_update60()end
__gfx__
