--camera / tile things

function cam_sc()

	if p.x>cam_x+124 then
		cam_x+=128
		p.gone=true
		spawn_obj()
		p.gone=false
		spawn_obj()
		if g_play
		and cam_x>767
		and cam_y>383 then
			music(8)
		end
	elseif p.x<cam_x-4 then
		cam_x-=128
		p.gone=true
		spawn_obj()
		p.gone=false
		spawn_obj()
		if g_play
		and cam_x>767
		and cam_y>383 then
			music(8)
		end
	elseif p.y<cam_y-4 then
		cam_y-=128
		p.gone=true
		spawn_obj()
		p.gone=false
		spawn_obj()
		if g_play
		and cam_x>767
		and cam_y>383 then
			music(8)
		end
	elseif p.y>cam_y+124 then
		cam_y+=128
		p.gone=true
		spawn_obj()
		p.gone=false
		spawn_obj()
		if g_play
		and cam_x>767
		and cam_y>383 then
			music(8)
		end
	end
	
	camera(cam_x,cam_y)

end

-------------------------------

function get_lava()

	local gx=0
	local gy=0
	
	for i=0,64,1 do
		for i=0,128,1 do
			if fget(mget(gx,gy),2) then
				add(l.ant_x,gx)
				add(l.ant_y,gy)
			end
			gx+=1
		end
		gx=0
		gy+=1
	end

end

function lava()

	if time()-l.ant>0.1 then	
			for i=1,#l.ant_x,1 do	
				mset(l.ant_x[i],l.ant_y[i],l.sp)
			end
			l.sp+=1
			l.ant=time()
		end
		if l.sp>59 then
			l.sp=56
		end
		
		if map_col(p.x,p.y,2) then
			sfx(7)
			sfx(4)
			death()
		end
	
end

------------------------------

function get_d_block()

	local gx=0
	local gy=0
	
	for i=0,64,1 do
		for i=0,128,1 do
			if fget(mget(gx,gy),3) then
				add(d.ant_x,gx)
				add(d.ant_y,gy)
			end
			gx+=1
		end
		gx=0
		gy+=1
	end
	
	for i=1,#d.ant_x,1 do
		local thing=false
		add(d.gone,thing)
	end
	for i=1,#d.ant_x,1 do
		local thing=7
		add(d.sp,thing)
		thing=0
		add(d.ant,thing)
	end

end

function desp_block()

	for i=1,#d.ant_x,1 do	
		if flr(p.x/8)==d.ant_x[i]
		and flr(p.y/8)+1==d.ant_y[i]
		or ceil(p.x/8)==d.ant_x[i]
		and flr(p.y/8)+1==d.ant_y[i] 
		and	d.sp[i]==7 then
			d.gone[i]=true	
		end
		if d.gone[i] then
			if time()-d.ant[i]>0.2 then	
				d.sp[i]+=1
				if d.sp[i]>6 then	
					mset(d.ant_x[i],d.ant_y[i],d.sp[i])
				end
				d.ant[i]=time()
			end
			if d.sp[i]>9 then
				d.sp[i]=-18
				mset(d.ant_x[i],d.ant_y[i],0)
			end
			if d.sp[i]==7 then
				d.gone[i]=false
			end
		elseif d.gone[i] then
			if time()-d.ant[i]>0.4
			and d.sp[i]<6 then
				d.sp[i]+=1
				d.ant[i]=time()
			end
		end
		
	end	

end


-->8
--world objects

function add_object(obj,x,y)

	//objects include
	--icicle
	--tramp
	--fire ball
	--torch
	--cp
	
	t={
	
		x=x*8,
		y=y*8,
		x_vel=0,
		y_vel=0,
		sp_x=0,
		sp_y=0,
		obj=obj,
		sp=0,
		ant=0,
		fall=false,
		bounce=false,
		cp_got=false,
		f_x={},
		f_y={},
		f_col={}
		
	}
	
	if t.obj=="tramp" then
		t.sp=23
	end
	
	add(objects,t)

end

function world_objs()
	
	for i=1,#objects do
		local t=objects[i]
		
		if t.obj=="icicle" then
		
			if touch(p.x+1,p.y,8,(cam_y+128)+p.y,t.x,t.y,7,(cam_y+128)+t.y) 
			and not t.fall
			and t.y<p.y 
			and t.y>=t.sp_y
			and t.x>cam_x
			and t.x<cam_x+128
			and t.y>cam_y 
			and t.y<cam_y+128 then
				sfx(2)
				t.sp_x=t.x
				t.sp_y=t.y
				t.fall=true
			end
			
			if t.fall then
				t.y_vel-=0.07
				t.y-=t.y_vel
			end
			
			if touch(p.x,p.y,8,8,t.x-4,t.y,2.5,6) then
				sfx(4)
				death()
				return
			end
			
			if not down_col(t.x,t.y,0)
			and not down_col(t.x,t.y,1) then	
				spr(39,t.x,t.y)
			else
				sfx(3)
				add_part(t.x,t.y,1,2,12,1,30)
				add_part(t.x,t.y,-1,2,12,1,30)
				add_part(t.x,t.y,0.4,1,12,1,30)
				add_part(t.x,t.y,-0.4,1,12,1,30)
				t.x=9999
				t.y=-9999
				t.ant=time()
				t.bounce=true
			end
			if t.y>cam_y+128 then
				t.x=9999
				t.y=-9999
				t.ant=time()
				t.bounce=true
			end
			
			if t.y<t.sp_y then
				t.y+=0.2
			end
			
			if time()-t.ant>4
			and t.fall 
			and t.bounce then
				t.x=t.sp_x
				t.y=t.sp_y-8
				t.y_vel=0
				t.fall=false	
				t.bounce=false
			end
		
		elseif t.obj=="tramp" then
		
			if touch(p.x,p.y,8,8,t.x,t.y,8,4)
			and not t.bounce then
				sfx(6)
				p.y_vel=2.3
				t.bounce=true
				t.sp=26
			end
			
			if t.bounce then
				if time()-t.ant>0.1 then
					t.sp+=1
					t.ant=time()
				end
				if t.sp>28 then
					t.sp=23
					t.bounce=false
				end
			end
			spr(t.sp,t.x,t.y)
		
		elseif t.obj=="torch" then
	
			if t.x>cam_x
			and t.x<cam_x+128
			and t.y>cam_y
			and t.y<cam_y+128 then
				if time()-t.ant>0.05 then
					t.f_x={}
					t.f_y={}
					t.f_col={}
					for i=1,9,1 do
						add(t.f_x,(t.x+2)+rnd(5))
						add(t.f_y,(t.y-2)+rnd(4))
						add(t.f_col,ceil(rnd(3))+7)
					end
					t.ant=time()
				end
		
				spr(43,t.x,t.y)
				
				for i=1,#t.f_x,1 do
					circfill(t.f_x[i],t.f_y[i],1,t.f_col[i])
				end
			end
		
		elseif t.obj=="fire ball" then
			
			if not t.bounce then
				t.sp_x=t.x
				t.sp_y=t.y+16
				t.bounce=true
			end
			
			if time()-t.ant>3
			and t.y>t.sp_y then
				t.y=t.sp_y
				t.y_vel=4
				t.ant=time()
				sfx(8)
				add_part(t.x,t.y-8,-0.4,1.5,9,1,30)
				add_part(t.x,t.y-8,-0.4,0.5,9,1,30)
				add_part(t.x+8,t.y-8,0.4,1.5,9,1,30)
				add_part(t.x+8,t.y-8,0.4,0.5,9,1,30)
			end
			t.y_vel-=0.1
			
			t.y-=t.y_vel
			
			if t.y<t.sp_y then
				if t.y_vel>0 then
					spr(40,t.x,t.y)
				elseif t.y_vel<0 then
					spr(41,t.x,t.y)
				end
			end

			if down_col(t.x,t.y,2)
			and t.y_vel<0 then
				add_part(t.x,t.y+8,-0.4,1.5,9,1,30)
				add_part(t.x,t.y+8,-0.4,0.5,9,1,30)
				add_part(t.x+8,t.y+8,0.4,1.5,9,1,30)
				add_part(t.x+8,t.y+8,0.4,0.5,9,1,30)
				t.y_vel=-90
			end
			
			if touch(p.x,p.y,8,8,t.x,t.y,8,8)
			and t.y<t.sp_y then
				sfx(4)
				death()
				return
			end
		
		end
	
	end
	
	cps()

end

-------------------------------

function spawn_obj()

	local gx=cam_x/8
	local gy=cam_y/8
	
	if not p.gone	then
		for i=0,15 do	
			for i=0,15 do
				
				if mget(gx,gy)==39 then
					add_object("icicle",gx,gy)
					mset(gx,gy,0)
					add(all_x,gx)
					add(all_y,gy)
					add(all_val,39)
				elseif mget(gx,gy)==23 then
					add_object("tramp",gx,gy)
					mset(gx,gy,0)
					add(all_x,gx)
					add(all_y,gy)
					add(all_val,23)
				elseif mget(gx,gy)==43 then
					add_object("torch",gx,gy)
					mset(gx,gy,0)
					add(all_x,gx)
					add(all_y,gy)
					add(all_val,43)
				elseif mget(gx,gy)==40 then
					add_object("fire ball",gx,gy)
					mset(gx,gy,0)
					add(all_x,gx)
					add(all_y,gy)
					add(all_val,40)
				elseif mget(gx,gy)==45 then
					add_cp(gx,gy)
					mset(gx,gy,0)
				end
				gx+=1
			
			end
			gx=cam_x/8
			gy+=1
		
		end
	
		gx=cam_x
		gy=cam_y		
	
	end
	
	if p.gone then
		
		for i=1,#all_x,1 do
			mset(all_x[i],all_y[i],all_val[i])
		end
		
		objects={}
		
		all_x={}
		all_y={}
		all_val={}
	
	end

end

-------------------------------

function add_cp(x,y)

	c={
	
		x=x*8,
		y=y*8,
		cp_got=false,
		ant=0,
		f_x={},
		f_y={},
		f_col={}
		
	}
	
	add(c_points,c)

end

function cps()

	for i=1,#c_points,1 do
		local c=c_points[i]
			
		if touch(p.x-8,p.y,8,8,c.x,c.y+8,16,16) 
		and not c.cp_got then
			sfx(5)
			say("check point",100,184,0,2)
			sp_x=c.x+4
			sp_y=c.y+8
			c.cp_got=true
		end
			
		if c.cp_got then
			
			if c.x>cam_x
			and c.x<cam_x+128
			and c.y>cam_y
			and c.y<cam_y+128 then
				if time()-c.ant>0.05 then
					c.f_x={}
					c.f_y={}
					c.f_col={}
					for i=1,15,1 do
						add(c.f_x,(c.x+2)+rnd(6))
						add(c.f_y,(c.y-2)+rnd(5))
						add(c.f_col,ceil(rnd(3))+7)
					end
					c.ant=time()
				end
				
				for i=1,#c.f_x,1 do
					circfill(c.f_x[i]+3,c.f_y[i]+9,1,c.f_col[i])
				end
			
			end
		
		end
					
			spr(45,c.x,c.y,2,2)

	end

end

-------------------------------

function fire_ice()

	if touch(p.x,p.y,8,8,i.x,i.y,8,8) 
	and not i.got then
		say("you got the flaming ice!",74,184,0,2)
		sfx(10)
		i.got=true
		for i=0,6,1 do
			add_part(p.x,p.y,rnd(2)-1,rnd(2),7,2,40)
		end
	end
	
	if not i.got then	
		spr(i.sp,i.x,i.y)
	end
	
	if time()-i.ant>0.2 then
		i.sp+=1
		i.ant=time()
	end
	if i.sp>30 then
		i.sp=29
	end

end

-->8
--effects

function add_part(x,y,x_vel,y_vel,col,rad,_life)

	a={
	
		x=x,
		y=y,
		x_vel=x_vel,
		y_vel=y_vel,
		col=col,
		rad=rad,
		life=_life
	
	}
	
	add(effects,a)

end

function particles()

	for i=1,#effects do
		local a=effects[i]
		
			if a.life<0 then
				del(effects,a)
				return "del"
			end
		
		a.y_vel-=0.05
		
		a.x+=a.x_vel/2
		a.y-=a.y_vel/2
		
		a.life-=0.5
		
		circfill(a.x,a.y,a.rad,a.col)
	
	end

end

------------------------------

function add_snow()

	s={
	
		x=rnd(128),
		y=rnd(128),
		x_vel=0,
		y_vel=0
	
	}
	
	add(snow,s)

end

function the_snow()

	for i=1,#snow do
		local s=snow[i]
		
		s.x_vel=-0.1
		s.y_vel=-0.2
		
		s.x+=s.x_vel
		s.y-=s.y_vel
		
		circfill(s.x+cam_x,s.y+cam_y,1,7)
		
		if s.x<0 then
			s.x+=128
		end
		
		if s.y>128then
			s.x=rnd(128)
			s.y=0
			s.x_vel=0
			s.y_vel=0
		end
	
	end

end

-------------------------------

function say(say,x,y,x_vel,y_vel)

	s={
	
		x=x,
		y=y,
		x_vel=x_vel,
		y_vel=y_vel,
		say=say
	
	}
	
	add(text,s)

end

function the_text()

	for i=1,#text,1 do
		local s=text[i]
		
			s.y_vel-=0.03
			
			s.x+=s.x_vel
			s.y-=s.y_vel
			
			print(s.say,s.x+cam_x-56,s.y+cam_y-56,0)
			print(s.say,s.x+cam_x-56,s.y+cam_y-56+1,10)
		
			if s.y>184 then
				del(text,s)
				return
			end
	
	end

end

-------------------------------

function timer()

	if not i.got then
		if time()-k.s_ant>=1 then
			k.sec+=1
			k.s_ant=time()
		end
		if time()-k.m_ant>=60 then
			k.minute+=1
			k.sec=0
			k.m_ant=time()
		end
		if time()-k.h_ant>=3600 then
			k.hour+=1
			k.minute=0
			k.h_ant=time()
		end
	elseif i.got then
		
		if #text<=0 then	
			
			rectfill(33+cam_x,k.y-1+cam_y,96+cam_x,(k.y+41)+cam_y,7)
			rectfill(34+cam_x,k.y+cam_y,95+cam_x,(k.y+40)+cam_y,0)
			
			print("congrates!",k.x+cam_x,k.y+10+cam_y,7)
		
			if k.hour<=0 then
				if k.sec>9 then
					print("time: "..k.minute..":"
									..k.sec,k.x+cam_x-5,k.y+25+cam_y,7)
				else
					print("time: "..k.minute..":"
								.."0"..k.sec,k.x+cam_x-5,k.y+25+cam_y,7)
				end
			else
				if k.sec>9 then
					print("time: "..k.hour..":"
								..k.minute..":"
								..k.sec,k.x+cam_x,k.y+25+cam_y,7)
				else
						print("time: "..k.hour..":"
								..k.minute..":"
								.."0"..k.sec,k.x+cam_x,k.y+25+cam_y,7)
				end
			
				end
			
			print("deaths: "..k.gone_c,k.x+cam_x-5,k.y+32+cam_y,7)
		
		end
		
	end

end
