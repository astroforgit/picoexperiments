pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
--fire temple and ice mountain
--by john paul mchugh

	objects={}
	all_x={}
	all_y={}
	all_val={}
	
	c_points={}
	
	snow={}
	
	text={}
	
	l={
		ant_x={},
		ant_y={},
		sp=56,
		ant=0
	}
	
	d={
		gone={},
		ant_x={},
		ant_y={},
		sp={},
		ant={}
	}
	
	k={
	
		x=47,
		y=20,
		sec=0,
		minute=0,
		hour=0,
		s_ant=0,
		m_ant=0,
		h_ant=0,
		gone_c=0
	
	}
	
	got_tiles=false
	
	--player
	sp_x=4*8
	sp_y=12*8
	
	--start screen
	g_play=false
	g_ant=0
	start=false
	pal_ant=0
	pal_t=1

function _init()
	
	effects={}
	
	p={

		x=sp_x,
		y=sp_y,
		x_vel=0,
		y_vel=0,
		m_sp=1,
		j_ht=1.3,
		fric=4,
		grav=0.06,
		w_jp=false,
		ground=false,
		sp=1,
		ant=0,
		dir=false,
		gone=false,
		zp=false,
		
		dx=0,
		dy=0,
		dx_vel=0,
		dy_vel=0
		
	}
	
	i={
	
		x=107*8,
		y=54.7*8,
		got=false,
		sp=29,
		ant=0
	
	}
	
	if g_play then
		cam_x=flr(sp_x/128)-(flr(sp_x/128)%128)
		cam_y=flr(sp_y/128)-(flr(sp_y/128)%128)
	else
		cam_x=112*8
		cam_y=32*8
	end
	
	spawn_obj()
	
	if #l.ant_x<1 then
		get_lava()
	end
	if #d.ant_x<1 then
		get_d_block()
	end

	if #snow<1 then
		for i=0,50,1 do
			add_snow()
		end
	end
	
	if g_play then
		music(2)
	elseif not g_play then
		music(0)
	elseif g_play
	and cam_x>767
	and cam_y>383 then
		music(8)
	end
	
end

function _update60()
	
	if g_play then
		if not p.gone then	
			player()
		else
			d_player()
		end
		
		if not p.gone then
			cam_sc()
		end
		
		lava()
		desp_block()
	end
	
end

function _draw()	

	cls()
		
	if g_play then	
		world_objs()
		map(0,0,0,0,128,64)
		p_ant()
		
		fire_ice()
		
		the_snow()
		
		particles()
		if particles()=="del" then
			particles()
		end
		
		the_text()
		
		timer()
		
	else
		
		camera(112*8,32*8)
		
		rect(112*8,32*8,127.9*8,47.9*8,7)
		map(0,0,0,0,128,64)
		
		the_snow()
		
		if not start then
			print("press Ž or —",117*8,46*8)
		end
		
		if not start then
			g_ant=time()
		end
		
		if start
		and time()-pal_ant>0.1
		and pal_t==0 then
			pal(12,12)
			pal(1,1)
			pal(9,9)
			pal(4,4)
			pal_ant=time()
			pal_t=1
		elseif start
		and time()-pal_ant>0.1 
		and pal_t==1 then
			pal(12,7)
			pal(1,7)
			pal(9,7)
			pal(4,7)
			pal_ant=time()
			pal_t=0
		end
		
		if time()-g_ant>3 then
			g_play=true
			pal(12,12)
			pal(1,1)
			pal(9,9)
			pal(4,4)
			_init()
		end
		
		if btnp(Ž)
		and not g_play
		and not start
		or btnp(—) 
		and not g_play 
		and not start then
			music(8)
			sfx(11)
			start=true
		end
	
	end
	
end
-->8
--player

function player()

	if btn(‹)
	and not left_col(p.x,p.y,0) then
		p.x_vel-=p.m_sp/p.fric
	end
	if btn(‘)
	and not right_col(p.x,p.y,0) then
		p.x_vel+=p.m_sp/p.fric
	end
	
	if p.x_vel>p.m_sp then
		p.x_vel=p.m_sp
	elseif p.x_vel<p.m_sp*-1 then
		p.x_vel=p.m_sp*-1
	end
	
	if not btn(‹)
	and not btn(‘)
	and p.x_vel>0
	and not p.w_jp then
		p.x_vel-=p.m_sp/p.fric
	elseif not btn(‹)
	and not btn(‘)
	and p.x_vel<0 
	and not p.w_jp then
		p.x_vel+=p.m_sp/p.fric
	end
	
	if btn(Ž)
	and p.ground 
	and not p.zp then
		sfx(0)
		p.y_vel=p.j_ht
	end
	if not p.ground then
		p.y_vel-=p.grav
	end
	
	if down_col(p.x,p.y,0) then
		p.ground=true
	elseif not down_col(p.x,p.y,1) then
		p.ground=false
	end
	
	if down_col(p.x,p.y,0) 
	and p.y_vel<(p.j_ht*(p.j_ht*0.6)/10)*-1 then
		p.ground=true
	end
	
	p.x+=p.x_vel
	
	if left_col(p.x,p.y,0) then
		p.x=ceil(p.x/8)*8
		p.x_vel=0
	end
	if right_col(p.x,p.y,0) then
		p.x=flr(p.x/8)*8
		p.x_vel=0
	end
	
	p.y-=p.y_vel
	
	if up_col(p.x,p.y,0) 
	and p.y_vel>0 then
		p.y=ceil(p.y/8)*8
		p.y_vel=0
	end
	
	if down_col(p.x,p.y,0) 
	and p.y_vel<0 then
		p.y=flr(p.y/8)*8
		p.y_vel=0
	end
	
	if down_col(p.x,p.y,1) 
	and p.y_vel<(p.j_ht*(p.j_ht*0.6)/10)*-1 then
		p.y=flr(p.y/8)*8
		p.y_vel=0
		p.ground=true
	end
	
	if down_col(p.x,p.y,4) then
		p.y=flr(p.y/8)*8
		p.y_vel=0
		p.fric=52
	else
		p.fric=8
	end
	
	wall_j()
	
	if btn(Ž) then
		p.zp=true
	else
		p.zp=false
	end
		
end

-------------------------------

function p_ant()

	if btn(‹) 
	and not p.w_jp then
		p.dir=false
	elseif btn(‘)
	and not p.w_jp then
		p.dir=true
	end
	
	if p.ground then	
		if btn(‹)
		or btn(‘) then
			if time()-p.ant>0.1 then
				p.sp+=1
				p.ant=time()
			end
			if p.sp>3 then
				p.sp=2
			end
		elseif not btn(‹)
		and not btn(‘) then
			p.sp=1
		end
	end
	
	if p.y_vel>0 then
		p.sp=4
	elseif p.y_vel<0 then
		p.sp=5
	end
	
	if left_col(p.x,p.y,0)
	and not left_col(p.x,p.y,4)
	and p.y_vel<0
	and btn(‹) then
		p.sp=6
		p.y_vel=-0.3
		add_part(p.x,p.y+4,rnd(0.3)-0.6,rnd(1),7,1,7)
	elseif right_col(p.x,p.y,0)
	and not right_col(p.x,p.y,4)
	and p.y_vel<0
	and btn(‘) then
		p.sp=6
		p.y_vel=-0.3
		add_part(p.x+8,p.y+4,rnd(0.6),rnd(1),7,1,7)
	end
	
	if not i.got then
		if not p.w_jp then
			spr(p.sp,p.x,p.y,1,1,not p.dir)
		elseif p.w_jp then
			spr(p.sp,p.x,p.y,1,1, p.dir)
		end
	elseif i.got then
		if not p.w_jp then
			spr(p.sp+9,p.x,p.y,1,1,not p.dir)
		elseif p.w_jp then
			spr(p.sp+9,p.x,p.y,1,1, p.dir)
		end
	end
	
	if p.gone then
		spr(44,p.dx,p.dy)
	end

end

-------------------------------

function wall_j()

	if p.y_vel<p.j_ht/1.2 then
		if btn(Ž)
		and left_col(p.x-5,p.y,0)
		and not left_col(p.x-5,p.y,4)
		and not p.ground
		and not p.zp then
			sfx(1)
			p.w_jp=true
			p.y_vel=1.4
			p.dir=false
		end
		
		if btn(Ž)
		and right_col(p.x+5,p.y,0)
		and not right_col(p.x+5,p.y,4)
		and not p.ground 
		and not p.zp then
			sfx(1)
			p.w_jp=true
			p.y_vel=1.4
			p.dir=true
		end
	end
		
	if not p.dir
	and p.w_jp then
		p.x_vel=3
	elseif p.dir
	and p.w_jp then
		p.x_vel=-3
	end
	
	if p.y_vel<0
	and p.w_jp then
		p.w_jp=false
		p.dir=not p.dir
	end

end

------------------------------

function death()

	k.gone_c+=1
	
	p.gone=true

	p.dx=p.x
	p.dy=p.y
	p.dy_vel=3
	
	p.y=-8
	p.y=-8

end

function d_player()
	
	p.dy_vel-=0.2
	
	p.dy-=p.dy_vel
	
	if p.dy>cam_y+128 
	and p.gone then
		spawn_obj()
		_init()
		p.gone=false
	end

end
-->8
--collisions

function touch(x1,y1,w1,h1,x2,y2,w2,h2)

	if x1>x2-w2
	and x1<x2+w1
	and y1>y2-h2
	and y1<y2+h1 then
		return true
	else
		return false
	end

end

------------------------------

function up_col(x,y,flag)
	if fget(mget(flr(x/8),ceil(y/8)-1),flag)
	or fget(mget(ceil(x/8),ceil(y/8)-1),flag) then
		return true
	else
		return false
	end
end

function down_col(x,y,flag)
	if fget(mget(flr(x/8),flr(y/8)+1),flag)
	or fget(mget(ceil(x/8),flr(y/8)+1),flag) then
		return true
	else
		return false
	end
end

function left_col(x,y,flag)
	if fget(mget(ceil(x/8)-1,flr(y/8)),flag)
	or fget(mget(ceil(x/8)-1,ceil(y/8)),flag) then
		return true
	else
		return false
	end
end

function right_col(x,y,flag)
	if fget(mget(flr(x/8)+1,flr(y/8)),flag)
	or fget(mget(flr(x/8)+1,ceil(y/8)),flag) then
		return true
	else
		return false
	end
end

-------------------------------

function map_col(x,y,flag)
	
	if fget(mget(flr(x/8),flr(y/8)),flag)
	or fget(mget(flr(x/8),ceil(y/8)),flag)
	or fget(mget(ceil(x/8),flr(y/8)),flag)
	or fget(mget(ceil(x/8),ceil(y/8)),flag) then
		return true
	else
		return false
	end

end
