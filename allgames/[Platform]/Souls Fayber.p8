// camera
c = {}

// player
p = {}

pnj = {}

souls_max=0
souls_catch=0
stats={draw=false}

state = "menu"

function game_init()
 p.x = 4*8
 p.y = 13*8
 
 c.x = 0
 c.y = 0
 
 souls_init()
 pnj_init()
 init_stats()
 tps_init()
 music(0)
end

function _init()
 cartdata("faybers")

 // init x=2 ,y=13
 p.x = 2*8
 p.y = 13*8
 p.dx = 0
 p.dy = 0
 p.spr = 0
 p.sprn = 2
 p.spd = 5
 p.d = false
 p.para = false
 p.box = {x1=1,y1=1,x2=6,y2=6}
 
 c.x = 0
 c.y = 0
 
 //souls_init()
 //pnj_init()
 //init_stats()
 //tps_init()
 
 //init_menu()
end


function _update()

 if state == "menu" then
  u_menu()
 elseif state == "game" then
  u_game()
 elseif state == "tuto" then
  u_tuto()
 elseif state == "story" then
  u_story()
 elseif state == "glitch" then
  u_glitch()
 elseif state == "end" then
  u_end()
 end
 
 
end

function _draw()
 cls()
 pal(7,color_game)
 
 if state == "menu" then
  d_menu()
 elseif state == "game" then
  d_game()
 elseif state == "tuto" then
  d_tuto()
 elseif state == "story" then
  d_story()
 elseif state == "glitch" then
  d_glitch()
 elseif state == "end" then
  d_end()
 end
 
 
end

-- transition effect
function u_glitch()
	if glit.n==0 and glit.t>15 then
		glit.n=1
		state="tuto"
		glit.t=0
	elseif glit.n==1 and glit.t>15 then
		glit.n=2
		state="story"
		glit.t=0
	elseif glit.n==2 and glit.t>15 then
		glit.n=3
		state="game"
		glit.t=0
	end
	
end

function d_glitch()
	glitch()
end

soul_menu={}
function u_menu()
 if btnp(5) then
 	state = "glitch"
 	p.x = 9*8
  p.y = 58*8
  dialog_push("hi, this a small tutorial.\npress x for jump.",0.07)
 end
 
 get_soul_menu(60,90)
 get_soul_menu(30,55)
 get_soul_menu(90,55)
 
 foreach(soul_menu,move_souls_menu)
 
end

function get_soul_menu(x,y)
	local s = {}
	s.x=x
	s.y=y
 s.col=7
 s.width=2
 s.h=2
 s.t=0
 s.max_t = 15+rnd(10)
 s.dx = rnd(.5) - 0.25
 s.dy = -rnd(0.5)
 s.ddy = -.05
 add(soul_menu,s)
end

show_x = true
function d_menu()
	//camera(896,384)
	camera(0,0)

 if time()%0.25 == 0 then
  	show_x=not(show_x)
 end
 
 if show_x then
 	local str = "press x for play"
 	print(str,64-#str*2,110,7)
 end
 //print("souls fayber",64-20,10,7)
 
 title()
 
 foreach(soul_menu,draw_souls)
end

function title()
 local posy = 10
 local posx = 45
 spr(10,posx,posy)
 spr(11,posx+8,posy)
 spr(12,posx+16,posy)
 spr(13,posx+24,posy)
 spr(14,posx+32,posy)
 
 local posy2 = 20
 local posx2 = 41
 
 spr(25,posx2,posy2)
 spr(26,posx2+8,posy2)
 spr(27,posx2+16,posy2)
 spr(28,posx2+24,posy2)
 spr(29,posx2+32,posy2)
 spr(30,posx2+40,posy2)
end

tuto_page=0
soul_tuto_ok=true

touch_soul={}
touch_soul.x=7*8
touch_soul.y=52*8
touch_soul.box={x1=1,y1=1,x2=6,y2=6}

function u_tuto()

 update_move()
 get_anim(p)
 //collisions()
 
 text_tuto()
 
 foreach(soul_tuto,move_souls_tuto)
 if soul_tuto_ok then 
 	local s = add_soul_tuto()
  add(soul_tuto,s)
 end
  
 if check_coll(p,touch_soul) then
 	soul_tuto_ok=false
 end
 
 if p.x < 0 then
	 
	 dialog_push(" ",0.07)
		state="glitch"
	end
 
end

function add_soul_tuto()
	local soul_spawn_tuto={}
 soul_spawn_tuto.x=7*8
 soul_spawn_tuto.y=52*8
 soul_spawn_tuto.col=7
 soul_spawn_tuto.width=2
 soul_spawn_tuto.h=2
 soul_spawn_tuto.t=0
 soul_spawn_tuto.max_t = 15+rnd(10)
 soul_spawn_tuto.dx = rnd(.5) - 0.25
 soul_spawn_tuto.dy = -rnd(0.5)
	soul_spawn_tuto.ddy = -.05
 return soul_spawn_tuto
end

soul_tuto = {}
function d_tuto()
 camera(0,48*8)
 map(0,0,0,0,128,64)
 
 spr(p.anim,p.x,p.y,1,1,p.d)
 
 rectfill(0,48*8+110,128,48*8+127,7)
 print(draw_dialog_tuto(),2,48*8+112,0)
	
 if tuto_page == 3 or tuto_page == 4 then
 	foreach(soul_tuto,draw_souls)
 end

end

soul_catch=false
function text_tuto()
 if tuto_page == 0 and btnp(5) and dialog_end() then
  dialog_push("well ! now move with\nright and left arrows.",0.07)
  tuto_page = 1
 elseif tuto_page == 1 and (btnp(1) or btnp(0)) and dialog_end() then
  dialog_push("ok good ! you can plane when\nyou press x during a jump.",0.07)
 	tuto_page = 2
	elseif tuto_page == 2 and p.para and dialog_end() then
  dialog_push("great ! now catch the soul.",0.07)
 	tuto_page = 3
 elseif tuto_page == 3 and not soul_tuto_ok then
  dialog_push("the tutorial is done.\nfollow the left way.",0.07)
 	tuto_page = 4
 end
end

story_prog=0
function u_story()
	if story_prog==0 then
		dialog_push("*cough* ...",0.07)
 	story_prog=1
 elseif story_prog==1 and btnp(5) then
  dialog_push("this is a long time i haven't\nreceipt visit.",0.07)
  story_prog=2
 elseif story_prog==2 and btnp(5) then
  dialog_push("it's just like you having a \nsecond chance.",0.07)
  story_prog=3
 elseif story_prog==3 and btnp(5) then
  dialog_push("it's very rare these days.",0.07)
  story_prog=4
 elseif story_prog==4 and btnp(5) then
  dialog_push("i will have a service to \nask you.",0.07)
  story_prog=5
 elseif story_prog==5 and btnp(5) then
  dialog_push("find and recover all wandering\nsouls.",0.07)
  story_prog=6
 elseif story_prog==6 and btnp(5) then
  dialog_push("good hunt !",0.07)
  story_prog=7
 elseif story_prog==7 and btnp(5) then
 	state="glitch"
 	game_init()
 end
 
	
end

function d_story()
 camera(0,0)
 
 spr(3+2*flr(time()%2),56,56)
	spr(4+2*flr(time()%2),56+8,56)
	spr(19+2*flr(time()%2),56,56+8)
	spr(20+2*flr(time()%2),56+8,56+8)
	
 print(draw_dialog_tuto(),2,10,7)
 
end

fayber_done=false
function u_game()
	if fayber_done == false then
 	update_move()
 else
  end_game()
 end
