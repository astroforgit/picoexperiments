function camera_switch()

	if p.x+4 > c.x+128 then
		c.x += 128
	end
	
	if p.x+4 < c.x then
	 c.x -= 128
	end
	
	if p.y > 3 then
 	if p.y+3 > c.y+128 then
 	 c.y += 128
 	end
 	
 	if p.y-3 < c.y then
 	 c.y -= 128
 	end
	end

end

color_game = 7
function switch_color()
 if (btnp(4)) color_game+=1
 if (color_game%16==0) color_game+=1
end


function pnj_init()
	pnj.x = 51*8
	pnj.y = 35*8
	pnj.box = {x1=0,y1=0,x2=16,y2=16}
end

function draw_pnj(x,y)
	spr(3+2*flr(time()%2),pnj.x,pnj.y)
	spr(4+2*flr(time()%2),pnj.x+8,pnj.y)
	spr(19+2*flr(time()%2),pnj.x,pnj.y+8)
	spr(20+2*flr(time()%2),pnj.x+8,pnj.y+8)
end

dialog={}
dialog.done = false
dialog.enable = false // draw text
dialog.d = "it's still missing souls, \ni can't do anything for you."
dialog.e = "well, join the totem and \naccept your destiny."
function collision_pnj()
 dialog.done = false
 if check_coll(pnj,p) then
  if not dialog.enable then
  	dialog.enable = true
  	dialog.done = true
  	if souls_catch == 30 then
  		dialog_push(dialog.e,0.060)
  	else 
  		dialog_push(dialog.d,0.060)
  	end
  end
  if not dialog.done then
   dialog.done=true
  end
 end
 
 if not dialog.done then
  dialog.enable = false
 end

end

diagsfx=false
diagsfxsize=0
d = {d="",t=0,spd=0.1}
function dialog_push(dial,spd)
 d.d = dial
 d.t = time()
 d.spd = spd
end

function draw_dialog()
 if dialog.enable then
  nb_l = (time()-d.t)/d.spd
  
  if diagsfxsize+0.1<time()
   and dialog_end() == false then
    diagsfxsize=time()
    if sub(d.d,nb_l,nb_l) != " " then
    	sfx(2)
    end
  end
  
	 return(sub(d.d,0,nb_l))
 end
end

function draw_dialog_tuto()
 nb_l = (time()-d.t)/d.spd
 if diagsfxsize+0.1<time()
  and dialog_end() == false then
   diagsfxsize=time()
   if sub(d.d,nb_l,nb_l) != " " then
    sfx(2)
   end
 end
	return(sub(d.d,0,nb_l))
end

function dialog_end()
 nb_l = (time()-d.t)/d.spd
 local str = sub(d.d,0,nb_l)
 if (#str == #d.d) return true
 return false
end


glit = {}
glit.height=128 -- set the width of area the screen glitch will appear
glit.width=128 -- set the width of area the screen glitch will appear
glit.t=0 -- glitch timer start
glit.n=0

function glitch()
	if g_on == true then -- on boolean is mangaged by the timer
		local t={7,7,7} -- create array of three colors
		local c=rnd(3) -- generate a random number between 1 and 3, we'll use this in a bit
		c=flr(c) -- make sure our random number is an integer and not a float
		for i=0, 150, 4 do -- the outer loop generates the vertical glitch dots
			local gl_height = rnd(glit.height)
			for h=0, 100, 2 do -- the inner loop creates longer horizontal lines
				pset(rnd(glit.width), gl_height, t[c]) -- write the random pixels to the screen and randomize the colors from the previously generated random number against out color array
			end
		end
	end
	
	-- animation timeline that turns the static on and off
	if glit.t>0 and glit.t < 15 then
		g_on=true
	elseif glit.t>120 then
		glit.t = 0
	else 
		g_on=false
	end
	glit.t+=1
end



