end

function d_game()
 camera(c.x,c.y)
 //camera(p.x-64,p.y-64)
 map(0,0,0,0,128,64)
 
 // player
 spr(p.anim,p.x,p.y,1,1,p.d)
 
 // pnj
 draw_pnj()
 
 // ames
 foreach(souls,draw_souls)
 foreach(totem_souls,draw_souls)
 
 draw_tps()
 draw_tps_end()
 
 if dialog.enable then
  rectfill(c.x,c.y+115,c.x+127,c.y+127,7)
 	print(draw_dialog(),c.x+1,c.y+116,0)
 end
 
 draw_stats()
end

function u_end()
	if btnp(5) then
		-- state="menu"
	end
end

function d_end()
	local x=112*8
	local y=48*8
	local m="welcome back among us"
	local minute=flr((stats.seconde/60))
	if minute<10 then
		minute="0"..minute
	end
	local seconde=stats.seconde%60
	if seconde<10 then
		seconde="0"..seconde
	end
	
	local score="your score : "..minute..":"..seconde.." min"

	local thx="thanks for playing"
	local press="press — for restart"
	
	map(0,0,0,0,128,64)
	music(-1)
	camera(x,y)
	
	print(thx,x+64-#thx*2,y+20,7)
	print(m,x+64-#m*2,y+61,7)
	print(score,x+64-#score*2,y+108,7)
	--print(press,x+64-#press*2,y+118,7)
end

