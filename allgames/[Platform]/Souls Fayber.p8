// ensemble de particule ronde
// en pixel
souls = {}
souls_state = {}
function souls_anim()
 foreach(souls, move_souls)
 foreach(souls_state,souls_stagnancy)
 
 // genere des bullet de fumee
 // ca donne un effet
 foreach(souls_state,make_soul)
end

function souls_init()

	local id = 0
	for y=0,63 do
	 for x=0,127 do
	  if mget(x,y) == 16 then
	  	make_soul_state(id,x,y)
	  	id+=1
	  	mset(x,y,32)
	  end
	 end
	end

	souls_max=count(souls_state)
end

function make_soul(soul)

 local s = {}
 
 s.x=soul.xm
 s.y=soul.ym
 s.col=7
 s.width=2
 s.h=2
 s.t=0
 s.max_t = 8+rnd(10)
 s.dx = rnd(.5) - 0.25
 s.dy = -rnd(0.5)
 s.ddy = -.05
 
 
 add(souls,s)
 
 return s
end

function make_soul_state(id,x,y)

 // on sauvegarde si l'ame a ete prise
 if (dget(id) == 1) return false
 
 local s = {}
 
 s.id=id
 s.x=x*8
 s.y=y*8
 s.xm=x*8
 s.ym=y*8
 s.d=true
 s.box = {x1=2,y1=2,x2=5,y2=5}
 
 add(souls_state,s)
 
 return true
end


function move_souls(sp)

 if (sp.t > sp.max_t) then
  del(souls,sp)
 end
 
 if (sp.t > sp.max_t - 2) then
  sp.width = sp.width +  1
  sp.width = min(sp.width,sp.width_final)
 end
 
 sp.x = sp.x + sp.dx
 sp.y = sp.y + sp.dy
 sp.dy = sp.dy+ sp.ddy
 sp.t = sp.t + 1
 
end

function move_souls_menu(sp)

 if (sp.t > sp.max_t) then
  del(soul_menu,sp)
 end
 
 if (sp.t > sp.max_t - 2) then
  sp.width = sp.width +  1
  sp.width = min(sp.width,sp.width_final)
 end
 
 sp.x = sp.x + sp.dx
 sp.y = sp.y + sp.dy
 sp.dy = sp.dy+ sp.ddy
 sp.t = sp.t + 1
 
end

function move_souls_tuto(sp)

 if (sp.t > sp.max_t) then
  del(soul_tuto,sp)
 end
 
 if (sp.t > sp.max_t - 2) then
  sp.width = sp.width +  1
  sp.width = min(sp.width,sp.width_final)
 end
 
 sp.x = sp.x + sp.dx
 sp.y = sp.y + sp.dy
 sp.dy = sp.dy+ sp.ddy
 sp.t = sp.t + 1
 
end

function draw_souls(s)
	circfill(s.x+4, s.y+4,s.width, s.col)
end

// effet de stagnation
function souls_stagnancy(s)

	if s.xm-s.x > 3 then
	 s.d = false
		//if (s.xm<s.x) s.xm += 1
		//if (s.xm>s.x) s.xm -= 1
	elseif s.xm-s.x < -3 then
	 s.d = true
 end
 
 if s.d then
  s.xm += 0.3
 else 
  s.xm -= 0.3
		//s.xm = s.xm + (rnd(2)-1)
	end

end



-->8
function init_stats()
 stats.draw=false
 stats.down=false
 stats.y=-8
 stats.recall=false
 stats.timerec=0
 stats.start_time=time()
 stats.seconde=0
end

function update_stats()

 if btnp(3) then
	 	stats.down=true
	 	stats.timerec=time()
 end
 
 if stats.timerec + 3 < time() and stats.down then
	 stats.recall=true
	end
	
	if stats.y < 1 and stats.down and not stats.recall then
	 stats.y += 0.5
	end
	
	if stats.recall then
	 stats.y -= 0.5
	end
	
	if stats.y < -8 then
	 stats.down=false
	 stats.recall=false
	end
	
	stats.seconde=flr((time()-stats.start_time))
end

function draw_stats()
 local str = souls_catch.." / "..souls_max
	
	rectfill(c.x,c.y+stats.y-1,c.x+127,c.y+8+stats.y-1)
	
	draw_timer()
	
	if souls_catch > 9 then
	 print(str,c.x+128-28,c.y+stats.y+1,0)
	else
	 print(str,c.x+128-24,c.y+stats.y+1,0)
 end
end

function draw_timer()

	local seconde=0
	local minute=0
	
	if stats.seconde%60 < 10 then
	 seconde="0"..stats.seconde%60
	else
	 seconde=stats.seconde%60
	end
	
	if flr(stats.seconde/60) < 10 then
	 minute="0"..flr(stats.seconde/60)
	else
	 minute=flr(stats.seconde/60)
	end
	
	local text = minute..":"..seconde

	print("time "..text,c.x+1,c.y+stats.y+1,0)
	
end

function draw_souls_catch()
 local str = souls_catch.." / "..souls_max
	
	if souls_catch > 9 then
	 print(str,c.x+128-28,c.y+1,color_game)
	else
	 print(str,c.x+128-24,c.y+1,color_game)
 end
end

-->8
function check_coll(a,b)
	if (a == b) return false
	
	local box_a = get_box(a)
	local box_b = get_box(b)
	
	if (box_a.x1 > box_b.x2 or
			  box_a.y1 > box_b.y2 or
			  box_b.x1 > box_a.x2 or
			  box_b.y1 > box_a.y2) then
	 return false
	end
	
	return true
end

function get_box(a)
 local box = {}
 box.x1 = a.x + a.box.x1
 box.y1 = a.y + a.box.y1
 box.x2 = a.x + a.box.x2
 box.y2 = a.y + a.box.y2
 
 return box
end

function collisions()

	for s in all(souls_state) do
	 if (check_coll(p,s) == true) then
	 	sfx(8)
	 	souls_catch+=1
	 	stats.down=true
	 	stats.recall=false
	 	stats.timerec=time()
	 	del(souls_state,s)
	 end
	end

end

totem = {}
totem.x = 43*8
totem.y = 33*8
totem.box = {x1=0,y1=0,x2=16,y2=32}

function totem_col()

	if check_coll(p,totem) then
		if btnp(5) 
			and souls_catch == 30 then
				fayber_done=true
				state="end"
		end
	end
	
end


