tps={}
tps_end={}
function tps_init()

	for y=0,63 do
	 for x=0,127 do
	  if mget(x,y) == 117 then
	  	make_tp(x,y,117)
	  	mset(x,y,79,117)
	  end
	  if mget(x,y) == 101 then
	  	make_tp_end(x,y)
	  	mset(x,y,79)
	  end
	  
	  if mget(x,y) == 118 then
	  	make_tp(x,y,118)
	  	mset(x,y,79)
	  end
	 end
	end

end

function make_tp(x,y,n)

 tp={}
 tp.x = x*8
 tp.y = y*8
 tp.spr = 117
 tp.sprn = 8
 tp.spd = 9
 tp.box = {x1=0,y1=3,x2=7,y2=7}
 tp.n=n
 
 add(tps,tp)

end

function draw_tps()
	foreach(tps,draw_tp)
	//print(get_animation(tps[1]),c.x,c.y)
end

function draw_tp(tp)
 spr(get_animation(tp),tp.x,tp.y)
end

function check_tp()
	for tp in all(tps) do
	 if (check_coll(p,tp) == true) then
	 	if tp.n == 117 then
	 		p.x = 43*8
	 		p.y = 40*8
	 		c.x=128*flr(43/16)
	 		c.y=128*flr(40/16)
	 	end
	 	if tp.n == 118 then
	 	 p.x = 103*8+4
	 		p.y = 9*8
	 		c.x=128*flr(103/16)
	 		c.y=128*flr(9/16)
	 	end
	 end
	end
end

function make_tp_end(x,y)

 tp={}
 tp.x = x*8
 tp.y = y*8
 tp.spr = 101
 tp.sprn = 4
 tp.spd = 10
 
 add(tps_end,tp)

end

function draw_tps_end()
 foreach(tps_end,draw_tp_end)
end

function draw_tp_end(tp)
 spr(get_animation(tp),tp.x,tp.y)
end


-->8
totem_souls = {}

function totem_souls_handle()
 if souls_catch > 0 then
 	foreach(totem_souls, move_souls_totem)
 	make_soul_x(44,34,"totem")
 end
end

function totem_souls_make()

	local s = {}
 
 s.x=44*8-4
 s.y=34*8-4
 s.col=7
 if souls_catch < 10 then
 	s.width=0
 elseif souls_catch < 20 then
  s.width=1
 elseif souls_catch < 30 then
  s.width=2
 elseif souls_catch == 30 then
  s.width=3
 end
 s.h=2
 s.t=0
 s.max_t = 8+rnd(10)
 s.dx = rnd(.5) - 0.25
 s.dy = -rnd(0.5)
 s.ddy = -.05
 
 add(totem_souls,s)

end

function move_souls_totem(sp)

 if (sp.t > sp.max_t) then
  del(totem_souls,sp)
 end
 
 if (sp.t > sp.max_t - 2) then
  sp.width = sp.width +  1
  sp.width = min(sp.width,sp.width_final)
 end
 
 sp.x = sp.x + sp.dx
 sp.y = sp.y + sp.dy
 sp.dy = sp.dy+ sp.ddy
 sp.t = sp.t + 1
 
end

// creation d'ames avec un type
// qui permette d'ajouter a la
// bonne liste
function make_soul_x(x,y,types)
 
 local s = attr_soul(x,y,types)
 
 if types == "menu" then
 elseif types == "tuto" then
 elseif types == "game" then
 elseif types == "totem" then
  add(totem_souls,s)
 end
end

// creation des attributs 
// d'une ame
function attr_soul(x,y,types)
 
 local s = {}
 
 s = position_soul(s,x,y,types)
 s.width = size_soul(types)
 s.col=7
 s.h=2
 s.t=0
 s.max_t = 8+rnd(10)
 s.dx = rnd(.5) - 0.25
 s.dy = -rnd(0.5)
 s.ddy = -.05
 
 return s
end

// permet de mettre la bonne position
function position_soul(s,x,y,types)

	if types == "menu" then
  s.x = x*8
  s.y = y*8
 elseif types == "tuto" then
  s.x = x*8
  s.y = y*8
 elseif types == "game" then
  s.x = x*8
  s.y = y*8
 elseif types == "totem" then
  s.x = x*8-4
  s.y = y*8-4
 end

	return s
	
end

// permet d'init la taille de l'ame
function size_soul(types)

 local size = nil

 if types == "menu" then
  size = 2
 elseif types == "tuto" then
  size = 2
 elseif types == "game" then
  size = 2
 elseif types == "totem" then
 	if souls_catch < 10 then
 		size = 0
 	elseif souls_catch < 20 then
  	size = 1
 	elseif souls_catch < 30 then
  	size = 2
 	elseif souls_catch == 30 then
  	size = 3
 	end
 end
 
 return size

end
