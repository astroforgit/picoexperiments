function update_move()
 
 if (is_grounded()) then
  p.dy = 0
  if (btnp(5)) then
   
   p.dy = -7
   if is_roof() then
    if p.dy < 0 then
     p.dy = 0
    end
    p.dy += 0.98
   end
  	sfx(0)
  end
 elseif is_roof() then
  if p.dy < 0 then
   p.dy = 0
  end
  p.dy += 0.98
 else
  p.dy += 0.98
  if (p.dy > 4) p.dy = 4
 end
 
 
 if is_border() then
  p.x = p.x
 else
  p.dx = 0
  if (btn(0)) p.dx = -2
  if (btn(1)) p.dx = 2
  p.x += p.dx
  if (p.dx > 4) p.dx = 4
 end
 
 get_parachute()
 
 p.y += p.dy
 
 // pour ne pas passer a 
 // travers le sol
 if (is_grounded()) then
  p.y = flr(flr(p.y)/8)*8
 end
end

function is_grounded()
 bloc = mget(flr(p.x)/8,flr(p.y)/8+1)
 bloc2 = mget(flr(p.x+7)/8,flr(p.y)/8+1)
 if (fget(bloc,0)) then
  return fget(bloc,0)
 elseif (fget(bloc2,0)) then
  return fget(bloc2,0)
 else
 	return fget(bloc,0)
 end
end

function is_border()
 if p.d then
  bloc = mget(flr(p.x-1)/8,flr(p.y+4)/8)
 else
  bloc = mget(flr(p.x)/8+1,flr(p.y+4)/8)
 end
 
 return fget(bloc,0)
end


function get_animation(elem)
	
 local debut = elem.spr	
	local vitesse = time() * elem.spd
	local nb_frame = elem.sprn
	
	return debut + (vitesse % nb_frame)
	
end

function get_parachute()

	if (is_grounded()) p.para = false

	if is_grounded() == false then
	 if (btnp(5)) p.para = true
		if btn(5) and p.para then
			p.dy = 1
		end
	end

end

function get_anim()
	
	if btn(1) then
  p.d = false
  p.anim = get_animation(p)
	elseif btn(0) then
	 p.d = true
	 p.anim = get_animation(p)
	elseif p.d then
	 p.anim = get_animation(p)
	elseif p.d == false then
	 p.anim = get_animation(p)
	end
	
	if p.para and btn(5) then
	 p.anim = 2
	end
	
end

function is_roof()

 bloc = mget(flr(p.x)/8,flr(p.y-2)/8)
 bloc2 = mget(flr(p.x+7)/8,flr(p.y-2)/8)
 if (fget(bloc,0)) then
  return fget(bloc,0)
 elseif (fget(bloc2,0)) then
  return fget(bloc2,0)
 else
 	return fget(bloc,0)
 end

end
