__lua__
-- the cat's meow
-- soullix, studio zeta4m

function _init()
	-- put code to run at startup
	poke(0x5f2c,0)
	color(7)
	plr={
	frm=1,
	fl=false,
	x=59,
	y=59,
	h=16,
	w=16,
	xspd=0,
	yspd=0,
	mxspd=1,
	myspd=1,
	jsp=4,
	acl=0.5,
	grv=0.3,
	frc=0.9,
	anim=0,
	go=false,
	jump=false,
	fall=false,
	land=false,
	hp=0
	}
	chkx = 59
	chky = 59
	chksx = 0
	chksy = 0
	key = 0
	gamestop = 1
	pause = 0
	score = 0
	gameover = 0
	scrx = 0
	scry = 0
	first = 1
	scrl = 0
	scrlocean = 0
	scrl2 = 0
	scrl0 = 0
	mus = 1
	timer = -15
	globaltimer = 0
	quadrant = 1
	sines = 0
	deaths = 0
	title = 1
	sel = 0
	perfect = 0
	speedrun = 0
	miss = 0
	gamedone = 0
	rundone = 0
	resettimer = 0
	
	fram = 0
	mill = 0
	secs = 0
	mins = 0
	
	done = 0
	
	musicchk()
	end


function _update()
 -- put code to run each frame

if resettimer > 0 then
 resettimer +=1
 if resettimer == 16 then
  reload(0x1000,0x1000,0x2000)
  _init()
 end
end 

if miss == 1 and resettimer == 0 and btnp(é) then
 resettimer = 1
 sfx(15)
end

if speedrun == 1 then 
 if fram == 2 then
  fram=0
  if mill==9 then
   if secs==59 then
    mins+=1
    secs=0
    mill=0
   else
    mill=0
    secs+=1
   end
  else
   mill+=1
  end
 else
  fram+=1
 end
end
 
 if sines==31 then
  sines=0
 else
  sines+=1
 end
 if scrx/16>3 and scry/16>1 then
  plr.grv=0.05
  plr.jsp=2.2
 else
  plr.grv=0.3
  plr.jsp=4
 end
  
 if globaltimer == 15 then
  if quadrant == 11 then
   globaltimer = 0
   quadrant = 0
   rng1 = rnd(128)
   rng2 = rnd(128)
   rng3 = rnd(128)
   rng4 = rnd(128)
   rng5 = rnd(128)
   rng6 = rnd(128)
   rng7 = rnd(128)
   rng8 = rnd(128)
   rng9 = rnd(128)
   rnga = rnd(128)
   rngb = rnd(128)
   rngc = rnd(128)
   rngd = rnd(128)
   rnge = rnd(128)
   rngf = rnd(128)
  else
   quadrant+=1
   globaltimer = 0
  end
 else
  globaltimer += 1
 end
 if gamestop == 0 then
  plr_upd()
  plr_anim()
  coin()
 else
  if title==0 then
   timer+=1
   if timer==15 then
    gamestop=0
    respawn()
   end
  end
 end
 if first == 1 then
  scrl -= 0.5
  if scrl == -388 then
  scrl = 0
  end
 end
 if plr.y > 104 then
 scrdown()
 first = 0
 chkrmflg()
 elseif plr.y < -8 then
 scrup()
 first = 0
 chkrmflg()
 elseif plr.x > 120 then
 scrright()
 first = 0
 chkrmflg()
 elseif plr.x < -8 then
 scrleft()
 first = 0
 chkrmflg()
 end
 
 if title == 1 then
  if btnp(î) and sel>0 then
   sel-=1
   sfx(8)
  elseif btnp(É) and sel<2 then
   sel+=1
   sfx(8)
  elseif btnp(é) or btnp(ó) then
   first = 0
   if sel == 1 then
    perfect = 1
   elseif sel == 2 then
    speedrun = 1
   end
   title=0
   gamestop=0
   respawn()
   music(0)
   sfx(15)
  end
 end
end

function _draw()
if gamedone==0 then
 -- put code to draw each frame
 if mus == 3 then
  cls(12)
 elseif mus == 2 then
  cls()
 elseif mus == 1 then
  cls(1)
 elseif scrx/16 > 0 then
  cls(9)
 else
  cls()
  if key == 3 then
   gamedone = 1
  end
 end
 if scry/16 > 0 and scrx/16 < 3 then
	 circ(rng1,rng7,1+(globaltimer+15*quadrant),12)
	 circ(rng2,rng8,1+(globaltimer+15*quadrant),12)
 	circ(rng3,rng9,1+(globaltimer+15*quadrant),12)
	 circ(rng4,rnga,1+(globaltimer+15*quadrant),12)
		circ(rng5,rngb,1+(globaltimer+15*quadrant),12)
	 circ(rng6,rngc,1+(globaltimer+15*quadrant),12)
	 if globaltimer > 7 then
	  pal(12,140,1)
	  pal(1,0,1)
	  pal(2,5,1)
	  pal(5,0,1)
	  pal(13,5,1)
	 else
	  pal(12,12,1)
	  pal(1,1,1)
	  pal(2,5,1)
	  pal(13,0,1)
	  pal(5,5,1)
	 end
	elseif scrx/16>3 and scry/16>1 then
	 if globaltimer > 7 then
	  pal(1,3,1)
	  pal(5,3,1)
	  pal(13,11,1)
	 else
	  pal(1,3,1)
	  pal(5,11,1)
	  pal(13,3,1)
	 end
	else
	 pal(12,12,1)
	 pal(1,1,1)
	 pal(2,2,1)
	 pal(5,5,1)
	 pal(13,13,1)
	end
 if first == 1 then
 print("tHE cAT'S mEOW, 2020 sTUDIO zETA4M . . . hELP mUFFIE GATHER RARE COFFEE BEANS FOR HER CAFE . . . tHE cAT'S mEOW, 2020 sTUDIO zETA4M",scrl,113)
 end
 if mus != 3 then
  map(scrx,scry)
 else
  sine()
 end
 if scrlocean == 1 then
  handlefx1()
	end
	rectfill(0,120,128,128,1)
 color(7)
 print("beans",32,121)
 print(key,56,121)
 print("score",72,121)
 print(score,96,121)
 if score == 2000 then
  print("p!",120,121,10)
 end
 if perfect == 1 then
  rectfill(7,8,16,13,2)
  rectfill(7,7,15,8,2)
  rectfill(7,13,15,14,2)
  rectfill(7,13,10,16,2)
  spr(79,8,8,1,1)
  print("gO FOR pERFECT!",18,10,7)
 end
 if speedrun == 1 then
  print(".",13,121,7)
  print(mill,16,121,7)
  print(":",3,121,7)
  if secs>9 then
   print(secs,6,121,7)
  else
   print("0",6,121,7)
   print(secs,10,121,7)
  end
  print(mins,0,121,7)
 end
 if gamestop==0 then
	 spr(plr.frm,plr.x,plr.y,2,2,plr.fl)
 elseif title==0 then
  circ(plr.x+8,plr.y+8,(timer+5)*2,14)
 else
  rectfill(62,61,126,85,2)
  rectfill(63,62,125,84,1)
  music(-1)
  if sel == 0 then
   print("èrEGULAR\n  pERFECT rUN\n  sPEEDRUN",66,65,7)
  elseif sel == 1 then
   print("  rEGULAR\nèpERFECT rUN\n  sPEEDRUN",66,65,7)
  else
   print("  rEGULAR\n  pERFECT rUN\nèsPEEDRUN",66,65,7)
  end
 end
  if miss==1 then
   rectfill(0,0,128,128,1)
   print("yOU mISSED",12,24,7)
   print("pRESS é kEY",8,32,7)
  end
elseif done==0 then
 drawthumbnail()
 if speedrun == 1 then
  rundone = 1
  speedrun = 0
 end
 if perfect==1 and score !=2000 then
  music(26)
 elseif perfect==1 then
  music(20)
 else
  music(21)
 end
else
 if perfect==1 and score!=2000 then
  rectfill(0,0,128,128,7)
 else
  drawthumbnail()
 end
 if quadrant < 6 then
  if perfect==1 and score!=2000 then
   print("cHALLENGE FAILED",0,1,1)
  else
   print("congratulations!",1,1,1)
  end
  if rundone == 1 then
   print(".",14,7,1)
   print(mill,17,7,1)
   print(":",4,7,1)
   if secs>9 then
    print(secs,7,7,1)
   else
    print("0",7,7,1)
    print(secs,11,7,1)
   end
   print(mins,1,7,1)
  end
  if perfect==1 and score==2000 then
   print("** perfect!!! **",1,7,1)
  end
 else
  print("deaths",1,1,1)
  if deaths == 0 then
   print("none!",31,1,3)
  else
   print(deaths,31,1,1)
  end
  print("score",1,7,1)
  if score == 2000 then
   print("perfect!",31,7,3)
  else
   print(score,31,7,1)
  end
 end
end
end
