-- collision

function collide(obj,dr,flg)
	
	local x = obj.x
	local y = obj.y
	local w = obj.w
	local h = obj.h
	local x1 = 0
	local x2 = 0
	local y1 = 0
	local y2 = 0
	
	if dr=="left" then

   x1=x-1  y1=y

   x2=x+4  y2=y+h-1

   

 elseif dr=="right" then

   x1=x+w-1    y1=y

   x2=x+w-6    y2=y+h-1

   

 elseif dr=="up" then

   x1=x+4    y1=y-1

   x2=x+w-6  y2=y

   

 elseif dr=="down" then

   x1=x+4      y1=y+h

   x2=x+w-6    y2=y+h
   
 else
   x1 = x+8
   y1 = y+8
   x2 = x+8
   y2 = y+8
 end
 
 x1/=8
 y1/=8
 x2/=8
 y2/=8
 
 x1+=scrx
 y1+=scry
 x2+=scrx
 y2+=scry
 
 if fget(mget(x1,y1), flg)
 or fget(mget(x1,y2), flg)
 or fget(mget(x2,y1), flg)
 or fget(mget(x2,y2), flg) then
 	return true
 else
 	return false
 end
end
-->8
-- plr actions

function plr_upd()
	plr.yspd += plr.grv
	
	if collide(plr,"down",3) then
	 plr.yspd = 0
	 plr.jump = true
	 plr.yspd -= plr.jsp*1.5
	 sfx(18,1)
	end
	
	if plr.xspd > 0 then
	plr.xspd -= 1
	end
	if plr.xspd < 0 then
	plr.xspd += 1
	end
	
	if plr.xspd == 0 then
	 plr.go = false
	 plr.idle = true
	end
	
	if btn(ã) then
	 if btn(ó) then
		plr.xspd = -2
		else
		plr.xspd = -1
		end
		plr.go = true
		plr.idle = false
		plr.fl = true
	end
	if btn(ë) then
	 if btn(ó) then
		plr.xspd = 2
		else
		plr.xspd = 1
		end
	 plr.go = true
	 plr.idle = false
	 plr.fl = false
	end
	if plr.go
	and not btn(ã)
	and not btn(ë)
	and not plr.fall
	and not plr.jump then
		plr.go = false
		plr.xspd = 0
	end
		
	if btnp(é) and plr.land then
	 sfx(8,2)
	 plr.yspd -= plr.jsp
	 plr.land = false
	end

	if plr.yspd > 0 then
	 plr.fall = true
	 plr.land = false
	 plr.jump = true
	 if collide(plr,"down",0) then
	  if collide(plr,"down",2) then
	  loselife()
	  end
	  if collide(plr,"down",4) then
	  plr.x += 1
	   if collide(plr,"centre",2) then
    loselife()
    end
	  end
	  if collide(plr,"down",5) then
	  plr.x -= 1
	   if collide(plr,"centre",2) then
    loselife()
    end
	  end
	  plr.land = true
	  plr.fall = false
	  plr.jump = false
	  plr.yspd = 0
	  plr.y -= (plr.y+plr.h)%8	
	 end
	elseif plr.yspd < 0 then
	 plr.jump = true
	  if collide(plr,"up",1) then
	  	if collide(plr,"up",2) then
	  		loselife()
	 	 end
	  	plr.yspd = 0
	  end
	 end
	 
	 if plr.xspd < 0 then
	  if collide(plr,"left",1) then
	  	if collide(plr,"left",2) then
	  		loselife()
	  	end
	  	plr.xspd = 0
	  end
	 elseif plr.xspd > 0 then
	  if collide(plr,"right",1) then
	  	if collide(plr,"right",2) then
	    loselife()
	   end
	   plr.xspd = 0
	  end
	 end
	 plr.x += plr.xspd
	 plr.y += plr.yspd
end

function plr_anim()
	if plr.fall then
		plr.frm = 7
	elseif plr.jump then
	 plr.frm = 5
	elseif plr.go then
		if time()-plr.anim > .1 then
		 plr.anim = time()
		 plr.frm += 2
		 if plr.frm > 3 then
		 	plr.frm = 1
		 end
		end
	else
	 plr.frm = 1
	end
end


function loselife()
 if perfect==0 then
  sfx(16)
  deaths += 1
  plr.yspd = 0
  plr.hp += 1
  timer = 0
  frame = 0
  gamestop = 1
 else
  gamestop = 1
  miss = 1
  timer = 16
 -- plr.x = 59
 -- plr.y = 59
 -- scrx = 0
 -- scry = 0
  plr.x = chkx
  plr.y = chky
  scrx = chksx
  scry = chksy
  sfx(16)
  music(26)
  poke(0x5f2c,3)
 end
end

function respawn()
 plr.x = chkx
 plr.y = chky
 scrx = chksx
 scry = chksy
end

function coin()
 if collide(plr,"centre",6) then
 sfx(15,2)
 mset(scrx+plr.x/8+1,scry+plr.y/8+1,0)
 score += 10
 end
 if collide(plr,"centre",7) then
 sfx(17,2)
 mset(scrx+plr.x/8+1,scry+plr.y/8+1,0)
 key += 1
 end
 if collide(plr,"centre",3) then
 loselife()
 end
end

function scrleft()
	scrx -= 16
	plr.x = 119
	chkx = plr.x
	chky = plr.y
	chksx = scrx
	chksy = scry
end
function scrright()
	scrx += 16
	plr.x = -5
	chkx = plr.x
	chky = plr.y
	chksx = scrx
	chksy = scry
end
function scrup()
 scry -= 16
 plr.y = 103
 plr.yspd -= 3
 chkx = plr.x
	chky = plr.y
	chksx = scrx
	chksy = scry
	end
function scrdown()
 scry += 16
 plr.y = 0
 yspd = 0
 chkx = plr.x
	chky = plr.y
	chksx = scrx
	chksy = scry
end
