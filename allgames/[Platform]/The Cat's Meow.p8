-- etc

function chkrmflg()
 musicchk()
 local flag = fget(mget(15+scrx,15+scry))
 if flag == 1 then
 scrlocean = 1
 else
 scrlocean = 0
 end
end

function musicchk()
 if scrx > (6*8) and scry/16 < 2 then
  if mus != 1 then
   music(4)
   mus = 1
  end
 elseif scry/16 > 0 and scrx/16 < 3 then
  if mus != 2 then
   music(14)
   mus = 2
  end
 elseif scrx/16>3 and scry/16>1 then
  if mus !=3 then
   music(16)
   mus = 3
  end
 elseif mus != 0 then
  music(0)
  mus = 0
 end
end


function handlefx1()
 if scrl < -31 then
  scrl = 0
 end
 if scrl2 < -31 then
  scrl2 = 0
 end
 if scrl0 < -31 then
  scrl0 = 0
 end
 sspr(72,8,8,8,scrl0,57,32,8)
 sspr(72,8,8,8,scrl0+32,57,32,8)
 sspr(72,8,8,8,scrl0+64,57,32,8)
 sspr(72,8,8,8,scrl0+96,57,32,8)
 sspr(72,8,8,8,scrl0+128,57,32,8)
 sspr(72,8,8,8,scrl,58,64,8)
 sspr(72,8,8,8,scrl+64,58,64,8)
 sspr(72,8,8,8,scrl+128,58,64,8)
 sspr(72,8,8,8,scrl2,59,128,8)
 sspr(72,8,8,8,scrl2+128,59,128,8)
 scrl0 -= 0.5
 scrl -= 1
 scrl2 -= 2
end

function sine()
	for j=0,127,1 do
	 tline(sin((scry+(j-sines/2))/16),j,128,j,scrx,scry+j/8)
	end
end

