-- draw thumbnail image

imgdata = ""

function drawthumbnail()
 gamedone=1
 cls()
 penx=0
	peny=0
 for i=1,4096,1 do
	 if sub(imgdata,i,i) == "a" then
	  j=10
	 elseif sub(imgdata,i,i) == "b" then
	  j=11
	 elseif sub(imgdata,i,i) == "c" then
	  j=12
	 elseif sub(imgdata,i,i) == "d" then
	  j=13
	 elseif sub(imgdata,i,i) == "e" then
	  j=14
	 elseif sub(imgdata,i,i) == "f" then
	  j=15
	 else
	  j=sub(imgdata,i,i)
	 end
	 pset(penx,peny,j)
	 if penx==63 then
	  penx=0
	  peny+=1
	 else
	  penx+=1
	 end
 end
 poke(0x5f2c,3)
 done=1
end
