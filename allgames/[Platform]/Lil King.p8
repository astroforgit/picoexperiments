pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--lil king
--tom brinton

ladders={}
rain={}
maxladders=3
enemies={}
enemyspawn=15
fire={}
king={}
king.x=64
king.y=0
king.ys=0
king.lives=5
king.maxlives=5
king.injured=0
king.sprite=1
king.rebound=false

firepup={}
firepup.active=false
firepup.x=84
firepup.y=24
firepup.s=10

hpup={}
hpup.climbing=false
hpup.floating=false
hpup.flying=false
hpup.x=34
hpup.y=20
hpup.ys=0
hpup.s=12

clouds={}
moonx=66

score=1
level=1
shake=0
timer=0

ltimer=0
htimer=0
lightning=0
gleam=0

function _init()
 gamemode="title"
 scrollheight=0
 message=1
 for i =1,50 do
  createclouds()
 end 
	music(0)
end

function _update()
 if gamemode == "title" then
  titleupdate()
 elseif gamemode=="play" then
  gameupdate()
 elseif gamemode=="death" then
  deathupdate()
 elseif gamemode=="victory" then
  victoryupdate()
 end 
end

function _draw()
 if gamemode == "title" then
 	cls()
 	drawsky()
 	foreach(rain,drawrain)
 	drawcastle()
 	foreach(clouds,drawclouds)
 	drawscroll()
 elseif gamemode=="play" then
 	cls()
 	drawsky()
	 foreach(rain,drawrain)
	 drawcastle()
	 if (firepup.active) drawfirepup()
	 drawking()
	 foreach(ladders,drawladder)
	 foreach(enemies,drawenemy)
	 if (hpup.flying or hpup.floating or hpup.climbing) drawhpup()
	 if (lightning>0) drawlightning()
	 if (gleam>0) drawgleam()
	 foreach(clouds,drawclouds)
	 drawhud()
	 screenshake()
	elseif gamemode=="death" then
 	cls()
 	drawsky()
 	foreach(rain,drawrain)
 	drawcastle()
 	foreach(clouds,drawclouds)
 	drawscroll()
	elseif gamemode=="victory" then
 	cls()
 	drawhappysky()
 	foreach(clouds,drawhappyclouds)
 	drawcastle()
 	drawscroll()
 end
end
-->8
--update
function gameupdate()
 if (timer>30) timer=0
 timer+=1
 ltimer+=1
 htimer+=1
 if (timer%2==0 and #rain<50) createrain()
 
 foreach(ladders,updateladder)
 foreach(enemies,updateenemy)
 foreach(enemies,bonkbads)
 
 if rnd(100)>(100-maxladders) then 
 	if (#ladders < maxladders) createladder()
 end
 if (#ladders==0) createladder()
 if (timer%enemyspawn==0 and #ladders>0) createenemy() 
 
 if (ltimer>300 and rnd(100)>98 and #enemies>10 and not firepup.active) firepup.active=true
 updatefirepup()
 updatelightning()
 
 if (not hpup.flying and not hpup.climbing and not hpup.floating and htimer>300 and king.lives<4) inithpup()
 updatehpup()
 
 updateking()
 updatediff()
 
 checklose()
 checkwin()
end

function updateking()
 king.sprite=1
 if (btn(0) and king.x>8) king.x-=1;king.sprite=17
 if (btn(1) and king.x<112) king.x+=1;king.sprite=16
 if (btnp(4) and king.y==24) sfx(2);king.ys=-3.3
 
 if (king.rebound) king.ys-=2 ;king.rebound=false
 
 king.y+=king.ys
 if king.y<24 then
  king.ys+=.55
 else 
  king.y=24
  king.ys=0
 end
 
 if (firepup.active) hitfirepup()
 if (hpup.floating) hithpup()
 
 hitladder()
 
 if (king.injured==0) getowies() 
 if (king.injured>0) king.injured+=1
 if (king.injured>30) king.injured=0

 if (score<1) score=1
end


function updateladder(l)
 if (l.len <101) l.len+=l.speed
 if (l.len >101) l.len=101
 
 if l.falling then
  if l.falldir=="left" then
   l.angle-=.015
  elseif l.falldir=="right" then
   l.angle+=.015
  end
  if l.angle<.5 or l.angle>1 then
   l.falling=false
   del(ladders,l)
  end
 end
 if (l.len>95 and not l.falling) ladderhit(l)
end

function updateenemy(e)
  if (king.x+3<e.x) e.s=21
  if (king.x-3>e.x) e.s=5
 if e.climbing then
  e.y-=e.speed
  if e.y<24 then 
   e.y=24
   e.climbing=false
   e.walking = true
  end
 end
 if e.walking then
  if (king.x+3<e.x) e.x-=1
  if (king.x-3>e.x) e.x+=1
 end
 if e.flying then
  e.x+=e.fx
  e.y+=e.fy
  e.fy+=1
  if (e.y>128) del(enemies,e)
 end
end


function updatefirepup()
 if firepup.active then
  if timer<15 then 
  firepup.s=10
  firepup.y-=.5
  else
  firepup.s=11
  firepup.y+=.2
  end
  if (firepup.y<1) then
   firepup.active=false
   ltimer=0
   firepup.y=24
   firepup.x=flr(rnd(104)+12)
  end
 end
end

function updatehpup()
 if hpup.climbing then
  hpup.s=12
  hpup.y-=hpup.ys
  if hpup.y <25 then
   hpup.climbing=false
   hpup.floating=true
  end
 end
 if hpup.floating then
  if timer<15 then 
  hpup.s=13
  hpup.y-=.5
  else
  hpup.s=12
  hpup.y+=.2
  end
  if (hpup.y<1) hpup.floating=false;htimer=0
 end
 if hpup.flying then
  hpup.y+=3
  if (hpup.y>128) hpup.flying=false;htimer=0
 end
end

function updatelightning()
 if lightning==10 then
  for e in all(enemies) do
    e.walking=false
    e.flying=true
    score+=25
  end
  lightning=0
 end
 if lightning>0 and lightning<10 then
  lightning+=1
 end
end

function titleupdate()
	timer+=1
	if (timer>30) timer=0
	
	if (timer%2==0 and #rain<50) createrain()
 
 if (scrollheight<40) scrollheight+=1
 
 if btnp(4) or btnp(5) then
 	message+=1
 	if (message>4) gamemode="play";sfx(6)
  scrollheight=0
 end
end

function updatediff()
 level=ceil(score/1000)
 enemyspawn=flr(30/level)
 if (enemyspawn<5) enemyspawn=5
 maxladders=level+1
 if (maxladders>7) maxladders=7

end

function checklose()
 if king.lives<=0 then
  delay(.5)
  gamemode="death"
  scrollheight=0
  message=5
 end
end

function deathupdate()
	timer+=1
	if (timer>30) timer=0
	
	if (timer%2==0 and #rain<50) createrain()
 
 if (scrollheight<40) scrollheight+=1
 
 if scrollheight==40 and (btnp(4) or btnp(5)) then
  gamemode="play"
  sfx(6)
  resetgame()
 end
end

function checkwin()
	if score>30000 then
	 gamemode="victory"
	 music(14)
	 scrollheight=0
	 message=6
	end
end

function victoryupdate()
 timer+=1
	if (timer>30) timer=0
	
 if (scrollheight<40) scrollheight+=1
 
 if scrollheight==40 and (btnp(4) or btnp(5)) then
  gamemode="title"
  music(0)
  resetgame()
 end
end
-->8
--draw
function drawcastle()
 rectfill(0,32,128,128,0)
  spr(22,0,24)
  spr(22,120,24)
 for y =4,15 do
  spr(6,0,y*8)
  spr(6,120,y*8)
 end
 for x=1,14 do
  for y=4,15 do
   spr(3,x*8,y*8)
  end
 end
end

function drawladder(l)
 for i=0,l.len do
  c=cos(l.angle)*i
  s=sin(l.angle)*i
  --shadows
  if i<97 then
  pset((l.x+c)-1,128-s,0)
  pset(l.x+c+7,128-s,0)
  end
  --ladder
  if i%3==0 then
   line(l.x+c,128-s,l.x+c+8,128-s,4)
  end
  col=4
  if (i>l.len-2) col=7
  if (i>l.len-2 and i<l.len-.99) then
   pset((l.x+c)-1,128-s,col)
   pset((l.x+c)+1,128-s,col)
   pset(l.x+c+7,128-s,col)
   pset(l.x+c+9,128-s,col)
  end
  pset(l.x+c,128-s,col)
  pset(l.x+c+8,128-s,col)
 end
end

function drawenemy(e)
 if e.flying then
		spr(e.s,e.x,e.y,1,1,false,true)
	else 
		spr(e.s,e.x,e.y)
	end
end

function drawking()
 if king.injured>0 and timer%2==0 then
 else
  spr(king.sprite,king.x,king.y)
 end
end

function drawhud()
for i=1,king.maxlives do
  spr(9,(i-1)*8,0)
 end
 for i=1,king.lives do
  spr(8,(i-1)*8,0)
 end
 local scoret=tostr(score)
 local zerot={"0","0","0","0","0","0"}
 for i =1, #scoret do
  zerot[7-i]=sub(scoret,-i)
 end
 for i = 1,6 do
 print(zerot[i],99+(i*4),1,00)
 print(zerot[i],101+(i*4),1,00)
 print(zerot[i],100+(i*4),1,10)
 end
 
end

function screenshake()
 if shake>0 then
  shake+=1
  camera(rnd(4)-2,rnd(4)-2)
 else
  camera()
 end
 if (shake>5) shake=0
end

function drawsky()
 if lightning>0 and lightning<5 then
  rectfill(0,0,128,31,7)
  circfill(62,8,7,0)
  circfill(66,8,7,7)
 else
  rectfill(0,0,128,31,1)
  circfill(62,8,7,10)
  circfill(moonx,8,7,1)
 end
 moonx+=.01
 if (moonx>78) moonx=46
end

function drawhappysky()
  rectfill(0,0,128,31,12)
  circfill(62,8,7,10)

end


function drawrain(r)
	for i=1,r.len do
	 pset(r.x+(i*cos(r.ang)),r.y+i,r.col)
	end
	if r.y>31 then
  del(rain,r)
	 --createrain()
	end
	r.y+=4
	r.x+=4*cos(r.ang)
end

function drawfirepup()
 spr(firepup.s,firepup.x,firepup.y)
end

function drawhpup()
 spr(hpup.s,hpup.x,hpup.y)
end

function drawlightning()
local lcol={7,10,12}
 for e in all(enemies) do
  --if e.walking then
   sx=e.x+4+(rnd(8)-8)
   mx=e.x+4+(rnd(16)-16)
   my=(e.y/2)+(rnd(16)-16)
   lc=lcol[ceil(rnd(3))]
   line(sx-1,0,mx-1,my,lc)
   line(mx-1,my,e.x+3,e.y,lc)
   line(sx,0,mx,my,lc)
   line(mx,my,e.x+4,e.y,lc)
   circ(e.x+4,e.y+4,4,lc)
  --end
 end
end

function drawclouds(c)
 c.x+=c.speed
 if (c.x-c.size>128) c.x=0-c.size
 circfill(c.x,c.y,c.size,c.col)
end

function drawhappyclouds(c)
 c.x+=c.speed
 if (c.x-c.size>128) c.x=0-c.size
 circfill(c.x,c.y,c.size,7)
end

function drawgleam()
 gleam+=1
 if (gleam>10) gleam=0
 heart(king.x+4,king.y+4,gleam*6,10)
 heart(king.x+4,king.y+4,gleam*4,7)
 heart(king.x+4,king.y+4,gleam*2,10)
 heart(king.x+4,king.y+4,gleam,9)
end

function drawscroll()
 ty=56-scrollheight
 by=72+scrollheight
 lx=32
 rx=96
 rectfill(lx-8,ty,rx,by,15)
 for i = rx,lx,-1 do
 	circfill(i,ty,8,15)
 	pset(i+2,ty+8,4)
 end
 circfill(lx,ty,6,4)
 circfill(lx,ty,4,15)
 circfill(lx,ty,2,4)
 for i = rx,lx,-1 do
 	circfill(i,by,8,15)
 	pset(i+2,by-8,4)
 end
 circfill(lx,by,6,4)
 circfill(lx,by,4,15)
 circfill(lx,by,2,4)
 drawlogo(ty,by,lx,rx) 
 if scrollheight==40 then
  print("press z or x",44,110,7)
  print("press z or x",45,110,4)
 end
end

function drawlogo(ty,by,lx,rx)
 clip(lx-8,ty+8,(rx-lx)+8,(by-ty)-16)
 if message==1 then
  sspr(8, 16, 24, 8, 38, 42, 48, 16)
  sspr(32, 16, 32, 8, 32, 68, 56, 16)
 elseif message==2 then
  print("once there was\na very small\nking.\n\nhe suspected\nall his subjects\nwere mocking him\nbehind his back.\n\nhe was right.",28,32,4)
 elseif message==3 then
  print("so he banished\neveryone from\nhis kingdom.\n\nat last, he could\nlive in peace...\nor so he thought.\n\nthat very night\nthere was an\ninvasion!",28,32,4)
 elseif message==4 then
  print("‹‘ move\nŽ jump\n\npush ladders\nfrom the side\n\njump on\nknights' heads\n\ngrab powerups",28,32,4) 
 elseif message==5 then
  print("thou didst die,\nlil king.\n\nthine score\nwast:\n\n"..score,28,42,4)
 elseif message==6 then
  print("victory\nis thine,\nlil king!\n\nthine score\nwast:\n\n"..score,28,42,4) 
 end
 clip()
end

function heart(x,y,s,c)
 for t= 0,2,.01 do
 hx = (s*1.5)*sin(t)^3
 hy = s*cos(t)-5*cos(2*t)-2*cos(3*t)-cos(4*t)
 pset(x+hx,y-hy,c)
 end
end
-->8
--misc functions
function createladder()
 local l={}
 ::again::
 l.x=flr(rnd(103)+9)
 for l2 in all(ladders) do
  if (abs(l2.x-l.x) <9) goto again
 end
 l.speed=1+(rnd(level/10))
 l.len=2
 l.angle=.75
 l.falling=false
 l.falldir="none"
 score+=1
 add(ladders,l)
end

function createenemy()
 local e={}
 e.ladder=ceil(rnd(#ladders))
 if (ladders[e.ladder].falling) return
 e.x=ladders[e.ladder].x
 e.y=128
 e.s=5
 e.climbing=true
 e.walking=false
 e.flying=false
 e.fx=0
 e.fy=0
 e.speed=ladders[e.ladder].speed
 score+=1
 add(enemies,e)
end

function hitladder()
 for l in all(ladders) do
  if l.len>96 and not l.falling and king.y>18then
   if king.x+8 > l.x and king.x+4<l.x+8 then
    l.falling=true
    l.falldir="right" 
    launchguys(l.x) 
   elseif king.x < l.x+8 and king.x>l.x+4 then
    l.falling=true
    l.falldir="left"
    launchguys(l.x) 
   end
  end 
 end
end

function ladderhit(l)
 ly=128-l.len
 if king.injured==0 and abs((king.y+8)-ly)<1 and abs(king.x-l.x)<5 then
  king.ys=-2
  king.injured=1
  sfx(3)
  king.lives-=1
 end
end

function launchguys(lx)
 sfx(0)
 score+=50
 shake=1
 if hpup.climbing and hpup.x==lx then
 	hpup.climbing=false
 	hpup.flying=true   
 end
 for e in all(enemies) do
  if e.climbing and e.x==lx then
   e.climbing=false
   e.flying=true
   score+=25
   e.fx=rnd(4)-2
   e.fy=rnd(2)-4  
  end
 end
end

function bonkbads(e)
 if e.walking then
 for kx=king.x,king.x+8 do
  for ex=e.x,e.x+8 do
   if abs(ex-kx)<1 and abs((king.y+8)-e.y)<2 and king.ys>0 then
    sfx(1)
    score+=30
    e.walking=false
    e.flying=true
    king.rebound=true
    e.fx=rnd(4)-2
    e.fy=rnd(2)
    --shake=3
   end
  end
 end
 end
end
function createclouds()
 local ccol={6,13}
 local c={}
 c.col=ccol[ceil(rnd(2))]
 c.x=rnd(128)
 c.y=-2
 c.size=4+ceil(rnd(4))
 c.speed=rnd(.4)+.1
 add(clouds,c)
end

function createrain()
 local r={}
 r.x=flr(rnd(136)-8)
 r.y=-1
 r.len=flr(rnd(10)+3)
 r.ang=.15
 r.col=flr(rnd(2)+5) 
 add(rain,r)
end

function getowies()
 for e in all(enemies) do
  if e.walking then
   if abs(e.x-king.x) <4 and king.y>18 and king.injured==0 then
    sfx(3)
    king.lives-=1
    score-=100
    king.injured=1
   end
  end
 end
end

function delay(s)
 for i=1,s*30 do
  flip()
 end
end


function hitfirepup()
 kx=king.x+4
 ky=king.y+4
 fx=firepup.x+4
 fy=firepup.y+4
 if abs(kx-fx)<7 and abs(ky-fy)<7 then
  firepup.active=false
  ltimer=0
  firepup.y=24
  firepup.x=flr(rnd(104)+12)
  shake=1
  lightning=1
  score+=100
  sfx(4)
 end
end

function hithpup()
 kx=king.x+4
 ky=king.y+4
 fx=hpup.x+4
 fy=hpup.y+4
 if king.lives<king.maxlives and abs(kx-fx)<7 and abs(ky-fy)<7 then
  hpup.floating=false
  htimer=0
  gleam=1
  score+=25
  king.lives+=1
  sfx(5)
 end
end

function inithpup()
 if #ladders>0 then
  
  hpup.ladder=ceil(rnd(#ladders))
  if (ladders[hpup.ladder].falling) return
  hpup.climbing=true
  hpup.x=ladders[hpup.ladder].x
  hpup.y=128 
  hpup.ys=ladders[hpup.ladder].speed 
 else
  return
 end
end

function resetgame()
 scrollheight=0
 message=1
 king.lives=king.maxlives
 king.x=64
 king.y=0
 king.ys=0
 for e in all(enemies) do
  del(enemies,e)
 end
 for l in all(ladders) do
  del(ladders,l)
 end
 score=1
 level=1
 ltimer=0
 htimer=0
 firepup.active=false
 hpup.climbing=false
 hpup.floating=false
 hpup.flying=false
end
