pico-8 cartridge // http://www.pico-8.com
version 7
__lua__

function _init()
gamestate=0 --0 start sceen 1 game 2 game over
music(0,10,4)

init_player()
init_enemies()
init_particle()
init_powerups()
end

function init_player()

 mapsizex=664

 startx=20
 starty=92
 btm={}
 btm[true]=1
 btm[false]=0
 px=20    -- x-position
 py=92    -- y-position
 pstate=0 -- current player state
 pspr=0   -- current sprite
 pdir=1   -- current direction
 pat=0    -- player state timer
 ppat=0
 plives=4
 maxfallhght=30
 pfallhght=-1
 ppstate=0
 pjumped=false
 pgrabcount=0
 nshots=0
 nchains=0
 scoold=0
 
 tcamx=0
 camx=0
 ds=1

end
function init_enemies()
 enemies={}
 for x=0,mapsizex do 
  for y=0,16 do
   c=flr(mget(x,y)/2)
   o=mget(x,y)%2
   if (c==96) then
     local e={}
     e.x=x*8
     e.y=y*8
     e.oy=0 e.dir=o*2-1
     e.spr=192
     e.at=0 e.s=1
     e.t=1 
     add(enemies,e)
   end
   if (c==104) then
     local e={}
     e.x=x*8
     e.y=y*8
     e.spr=208
     e.at=0 e.s=1
e.t=2 
     e.tx=e.x-8
     e.ty=e.y
     e.cdir=4
     e.f=0
     add(enemies,e)
   end

  end
 end
end

function init_powerups()
 powerups={}
 for x=0,mapsizex do 
  for y=0,16 do
   c=flr(mget(x,y))
   
   o=band(fget(c),4)
   if o>0 then
     local ps={}
     ps.x=x*8
     ps.y=y*8
     ps.mx=x
     ps.my=y
     ps.c=c
     ps.at=flr(rnd()*3)
     add(powerups,ps)
     --mset(x,y,0)
   end
  end
 end
end


function init_particle()
part={}
end

function _draw()
  if(gamestate==0) _draw_title()
  if(gamestate==1) _draw_game()
  if(gamestate==2) _draw_gameover()
  if(gamestate==5) _draw_gamewon()
end

function _draw_title()
 camera()
 cls()
 map(0,16,0,20,16,7)

 map(0,23,0,0,16,2)
 map(0,24,0,110,16,1)

 print("a game by",40,74)
 print("johannes richter",50,82)

 print("press button",40,100)
 
   -- draw particle
  for p in all(part) do
    circfill(p.x,p.y,p.r,p.c)
  end   

end

function _draw_gameover()
 camera()
 for i=0,50 do
  xx=rnd(128)
  yy=rnd(128)
  c=pget(xx,yy)
  circfill(xx,yy,2,c)
 end
 print("game over!",46,60,0)
 print("game over!",44,59,0)
 print("game over!",44,61,0)

 print("game over!",45,60,7)

end

function _draw_gamewon()
 drawbg()
 camera()
 print("game won!",50,50,7)
 print("congratulations!",35,58,7)

  -- draw particle
  for p in all(part) do
    circfill(p.x,p.y,p.r,p.c)
  end   
end


function drawbg()
cls()
camera()

srand()
for i=0,100 do
x=(rnd(128)-camx/10)%128
pset(x, rnd(100),rnd(2)+5)
end

--  map(0,23,0,112,16,2)
  
for x=0,128 do
  xx=((x+camx*.25)/128)
  y=20-abs(sin(xx*2)*14+cos(xx*1.7)*21)

  xx2=((x+camx*.5)/128)
  y2=29-abs(cos(xx2*1.4)*14+cos(xx2*1.1)*12)+3
  line(x,105-y,x,120,1)
  pset(x,105-y,2)

  line(x,110-y2,x,128,1)
  line(x,110-y2,x,110-y2*.9,2)
end
camera(camx,0)

end

function _draw_game()
--  cls()
  drawbg()
  -- draw the world
  co=flr(camx/8)-1
  
  map(co,0,co*8,0,18,16,bor(16,1))
  
  apx=px
  apy=py
  for x=0, 16 do
  for y=0, 16 do
    px=x*8
    py=y*8
    if (isblocked(0,0)) then 
      --circ(px+4,py+4,4)
    end
  end
  end
  px=apx
  py=apy
  bb=pgrabcount
  e=enemies[1]
--  print(e.f.."e:"..e.x..","..e.y.." "..e.cdir.."p:"..px..","..py..","..pstate..","..ppstate..","..pdir..","..bb..","..#part,10+camx,10)
  -- draw the player
  spr(pspr,px,py,1,1,pdir==-1)
  -- draw enemies
  for e in all(enemies) do
    spr(e.spr,e.x,e.y,1,1,e.dir==-1)
  end
  
  -- draw powerups
  for p in all(powerups) do
    spr(p.c+flr(p.at/5), p.x,p.y)
  end 
  
 
  -- draw particle
  for p in all(part) do
    circfill(p.x,p.y,p.r,p.c)
  end  
  
  -- draw the hearts
  for i=0,5 do
    if (plives>i) s=8 else s=9
    spr(s, i*7+8+camx,1)
  end

  -- draw the shots
  for i=1,nshots do
    spr(10, 64+i*7+camx,1)
  end

  spr(30,110+camx,1)
  print("x",117+camx,3,5)
  print(nchains,121+camx,3,5)

end

function change_state(s)
 ppstate=pstate
 ppat=pat
 pstate=s
 pat=0
end

function canfall()
  return not isblocked(0,1)
end

function isblocked(dx,dy)
return isblockedgen(px,py,dx,dy)
end

function isblockedgen(fx,fy,dx,dy)
  local oy=4
  local ox=4
  local v
  if (dx>0) ox=4
  if (dx<0) ox=3
  if (dy>0) oy=7
  if (dy<0) oy=1
  v=mget(flr((fx+ox+dx)/8),flr((fy+oy+dy)/8))
  return fget(v,0)  
end

function trymovex(dx)
 if (dx==0) return false
 local st=dx/abs(dx)
 for s=0,dx*st do
  if (not isblocked(st,0)) px+=st else return false
 end
 return true
end

function trymovey(dy)
 if (dy==0) return false
 local st=dy/abs(dy)
 for s=0,dy*st do
  if (not isblocked(0,st)) py+=st else return false
 end
 return true
end

function update_powerup(p)
p.at=(p.at+1)%15
end

function dist(x1,y1,x2,y2)
 local ddx = x2-x1
 local ddy = y2-y1
	return sqrt(ddx*ddx+ddy*ddy)
end


function update_enemy(e)
-- check if being it by cast

hit=0
if (e.s>3) return -1

for k=1,#part do
  pp=part[k]
  if (pp.x-camx<128) and (pp.x-camx)>0 then
   if (pp.t=="i") then
    if (abs(e.x+4-pp.x)<2 and abs(e.y+4-pp.y)<2) then
     hit=1
     pp.ls=0
    end
   end
 end
end

if (hit==1) then
   e.s=3
   e.at=-1
   sfx(6)
   add_enemycollect(e.x+4,e.y+7)
end

-- check if hitting player
if (e.s<3 and abs(px-e.x)<3 and abs(py-e.y)<3) then
  if (pstate!=-1) change_state(-1)
end


-- behavior
e.at+=1

-- hoverbot
if e.t==1 then
 -- move
 if (e.s==1) then
   e.spr+=2
   if not isblockedgen(e.x,e.y,e.dir,2) or isblockedgen(e.x,e.y,e.dir,0) then
    e.s=2 e.at=0 
   else
    e.x+=e.dir*.5
   end
 end
 -- turn
 if (e.s==2 and e.at>30) then
   e.dir=-e.dir e.s=1 e.at=0
 end
 -- always hover when not dying
 if e.s<3 then 
   e.spr=192+flr(e.at/10)%2
   e.y-=e.oy
   e.oy=cos(e.at/15)
   e.y+=e.oy
 end
 --dying 
 if e.s==3 then
   if (e.at==0) e.y-=e.oy
   e.spr=196+min(flr(e.at/2),6)
   if (e.at>20) e.s=4
 end
end

-- sawbot
if e.t==2 then
  e.spr=211-flr(e.at/2)%4

  if (e.x<e.tx) e.x+=1
  if (e.x>e.tx) e.x-=1
  if (e.y<e.ty) e.y+=1
  if (e.y>e.ty) e.y-=1

  if (e.tx==e.x) and (e.ty==e.y) then
    sfx(1)
    emx=flr(e.x/8)
    emy=flr(e.y/8)
    
    ndir=e.cdir
    for i=0,4 do
    if ((e.cdir==1) and (not mapbit(emx, emy-1,128))) ndir=2 
    if ((e.cdir==2) and (not mapbit(emx+1, emy,128))) ndir=3
    if ((e.cdir==3) and (not mapbit(emx, emy+1,128))) ndir=4
    if ((e.cdir==4) and (not mapbit(emx-1, emy,128))) ndir=1  
    e.cdir=ndir
    end
    
    if (e.cdir==1) e.ty=e.y-8
    if (e.cdir==2) e.tx=e.x+8
    if (e.cdir==3) e.ty=e.y+8
    if (e.cdir==4) e.tx=e.x-8
        
  end

end  

end

function mapbit(x,y,b)
    return band(fget(mget(x,y)),b)
== b
end

function add_iceblast(x,y,d)
for i=0,10 do
p={at=0, x=x, y=y+2, vr=0.1, vx=pdir*(rnd(1)+2), vy=(rnd(2)-1)*.25,ls=rnd(20), r=.1, c=rnd()*2+6, t="i"}
add(part,p)
end 
end

function add_chaincollect(x,y)
for c=9,10 do
for i=0,12 do
p={at=0, x=x+5, y=y+5, vr=0.05, vx=(rnd(2)-1)*.5, vy=-rnd(3)*.5,ls=rnd(20), r=0, c=c,t="c"}
add(part,p)
end 
end
end

function add_blastcollect(x,y)
for c=12,13 do
for i=0,7 do
p={at=0, x=x+5, y=y+4, vr=0.05, vx=(rnd(2)+1)*.5, vy=-rnd(3)*.5,ls=rnd(20), r=0, c=c,t="p"}
add(part,p)
end 
end
end

function add_enemycollect(x,y)
for c=6,7 do
for i=0,20 do

p={at=0, x=x, y=y, vr=0.0, vx=(rnd(2)-1), vy=-rnd(1),ls=rnd(25), r=.25, c=c,t="e"}
add(part,p)
end 
end
end


function update_particle(p)
p.x+=p.vx
p.y+=p.vy
p.r+=p.vr
p.at+=1
if (p.at>p.ls) then
del(part,p)
p.vx=0
p.vy=0
end
end


function _update()
  
  if gamestate==0 then
   --add_iceblast(rnd(128),rnd(128),1)
   foreach(part, update_particle)

   if (rnd(1000)>900) add_chaincollect(rnd(128),rnd(128))

    if (btnp(4) or btnp(5)) then
      music(1,100,4)
      scoold=0
      gamestate=1
    end
  end
  
  if (gamestate==1) then
    update_game()
    if (plives<0) then
      gamestate=2
      sfx(7)
    end
  
  end

  if (gamestate==2) then
   if (btnp(4) or btnp(5)) then 
     reload()
     music(0,100,4)
     _init()
	    gamestate=0
   end
  end

  if (gamestate==5) then
   if (btnp(4) or btnp(5)) then 
     reload()
     _init()
	    gamestate=0	    
   end
   foreach(part, update_particle)

   if (rnd(1000)>900) add_chaincollect(rnd(128),rnd(128))
  
  end


function update_game()
  foreach(part, update_particle)
  foreach(enemies,update_enemy)

  -- try to keep bron in 64-192 window
  if (px-camx>100) tcamx=camx+32
  if (px-camx<28) tcamx=camx-32
  
  dcam=min(1,abs(tcamx-camx)*.2)*2
  if (camx<tcamx) camx+=dcam else camx-=dcam
  camx=max(0,min(camx,mapsizex))
  camera(camx,0)

  update_player()
  
  foreach(powerups,update_powerup)
end


function update_player()
 b0=btn(0) -- button0 state
 b1=btn(1) -- button1 state
 b2=btn(2) -- button2 state
 b3=btn(3) -- button3 state
 b4=btn(4) -- button4 state
 b5=btn(5) -- button4 state

 mpx=flr((px+4)/8)
 mpy=flr((py+4)/8)
 mg=mget(mpx,mpy)
 fg=fget(mg)
 
 -- save point
 if band(fg,16)==16 then
   startx=mpx*8
   starty=mpy*8   
   mset(mpx,mpy,40)
   if (mg==38) sfx(5)
 end
 
 -- end game point (for now)
 if mg==63 then
   sfx(10) 
   gamestate=5
 end
 
 
 if (not b2) pjumped=false
 
 --px%=128   -- no bounds
 pat+=1    -- increment timer
 scoold-=1 -- shot cooldown
 
 -- check if we are collecting smth
 for pu in all(powerups) do
   local pmx=(px/8-pu.mx)
	  local pmy=(py/8-pu.my)
	  local ddd=pmx*pmx+pmy*pmy
	  
   if (dist(px/8,py/8,pu.mx, pu.my)<1) then
     mset(pu.mx,pu.my,0)
     del(powerups,pu)
     if (pu.c==27) then
       add_chaincollect(pu.x,pu.y)
       sfx(0)
       nchains+=1
     end
     if (pu.c==11) then
	      nshots+=4
       add_blastcollect(pu.x,pu.y)
       sfx(2)
     end
     if (pu.c==43) then
	      plives+=1
       add_blastcollect(pu.x,pu.y)
       add_chaincollect(pu.x,pu.y)
       sfx(9)
     end

   end
 end
 
 -- idle state
 if pstate==0 then

   pspr=0
   py=flr(py/8)*8
   pgrabcount=0
   if (ppstate==1 and prun and ppat>3 and pat<5) then
    if (not isblocked(pdir,1)) change_state(5) else trymovex(pdir/pat)
    pspr=7 
   else 
    prun=false
   end
   if (ppstate==2 and pat==1 and pfallhght>maxfallhght) change_state(-1)
   if (b0 or b1) change_state(1)
   if (b2 and not pjumped) change_state(3)
   if (not isblocked(0,1)) change_state(2)
   if (b4 and nshots>0 and scoold<0) change_state(6)
 end
 
 -- walk state
 if pstate==1 then
   if (ppstate==2 and pat==1 and pfallhght>maxfallhght) change_state(-1)

   if (pat%4==0) sfx(1)
   if (b0) pdir=-1
   if (b1) pdir=1
   if (b2 and not pjumped) change_state(3)
   if (not isblocked(0,1)) change_state(2)
   if (b5) then
     dx=pdir*min(pat,1)*1.8
     pspr=flr(pat/1.2)%8
     prun=true
   else
     dx=pdir*min(pat,1)*.95
     pspr=flr(pat/1.75)%8
     prun=false
   end
   if (not b0 and not b1 and not isblocked(pdir,1)) change_state(5) dx=0

   trymovex(dx)
   if (not (b0 or b1)) change_state(0)
 end

 -- fall state
 if pstate==2 then
   if (pat==1) pfallhght=0
   pspr=19
   dx=0
   
   if(py>128) change_state(-1)
   
   dy=min(4,pat)

   if (b0) dx=-.8 pdir=-1
   if (b1) dx=.8 pdir=1
   if (ppstate==1 and prun) dx*=1.46
   if (dx!=0) trymovex(dx,0)
   trymovey(dy)-- change_state(0)
   pfallhght+=dy
   if (isblocked(0,1)) change_state(0) 
   if (isblocked(pdir,0) and (not isblocked(0,8)) and b5 and not pbeensliding) change_state(4)

   if (b4 and nshots>0 and scoold<0) then
     scoold=30
     add_iceblast(px,py,pdir)
     sfx(3)
     nshots-=1
   end

 end

 -- jump state
 if pstate==3 then
   pjumped=true
   pspr=min(18,16+flr(pat/2))
   dx=0
   dy=(-6+pat*.7)*.46
   if (b0) dx=-1 pdir=-1 
   if (b1) dx=1 pdir=.8
   if (ppstate==1 and prun) dx*=1+(min(5,ppat)/8) dy*=1.24
   if (ppstate==4) dy*=1.6
 
   resy=trymovey(dy)
   resx=trymovex(dx)
   
   if (ppstate==1 and ppat>1 and b5 and b2 and (not resx)) change_state(4)
   if (not resy or not b2 or pat>10) change_state(2)

   if (b4 and nshots>0 and scoold<0) then
     scoold=30
     add_iceblast(px,py,pdir)
     sfx(3)
     nshots-=1
   end

 end
 
 -- slidewall state
 if pstate==4 then
    pspr=flr(pat/3)%2+20
    dy=.005*min(5,pat*pat)*(pgrabcount+1)*1.3
    if (not b5 or isblocked(0,8) or not isblocked(pdir,0)) change_state(2)
    if (b2 and not isblocked(pdir,-1) and not isblocked(0,-1)) dy=-1
    if (pat>2 and b2 and ((pdir==1 and b0) or (pdir==-1 and b1))) pgrabcount+=1 change_state(3)

    trymovey(dy)
 end
 
 -- breakfall state
 if pstate==5 then
   prun=false
   pspr=21+flr(pat/3)
   if (pat==8) change_state(0)
 end
 -- die state
 if pstate==-1 then
    if (pat==1) then
     plives-=1 
     if (pfallhght>10) then
      sfx(4) 
     else
      sfx(8)
     end
    end

    pspr=min(37,flr(pat/2)+32)
    
    if pat>50 then
      px=startx
      py=starty
      for i=0,3 do
        add_chaincollect(px,py+4)
      end
      sfx(11)
      plives-=1
      pdir=1
      
      change_state(0)
      if (plives==-1) then
        gamestate=2
      end
    end   
  end
 end
 -- mage state
 if (pstate==6) then
    scoold=30
    if (pat==1) then
      add_iceblast(px,py,pdir)
      sfx(3)
      nshots-=1
    end
    pspr=min(51,flr(pat/2)+48)
    if (pat>8) change_state(0)   
 
 end
end
