pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
--snowball
--by nusan

time=0
totalsnow=0
totalfire=0

levels={}
function addlevel(name,px,py,epx,epy)
  add(levels, {name=name,px=px,py=py,epx=epx,epy=epy})
  return #levels
end

regionx,regiony=0,0
regionendx,regionendy=39,25

currentlevel=1

function setlevel(i)
  currentlevel=i
  regionx=levels[i].px
  regiony=levels[i].py
  regionendx=levels[i].epx
  regionendy=levels[i].epy
end

firstlevel=addlevel("hello", 112,16,127,31)
addlevel("roll in the snow", 0,0,39,25)
addlevel("fire melt you", 0,26,15,63)
addlevel("short one", 40,0,63,18)
addlevel("roll in fire", 64,0, 98,16)
addlevel("be big", 40,35,95,63)
addlevel("long short", 40,19, 80,33)
addlevel("get back up", 16,26,39,63)
finallevel=addlevel("final", 112,0, 127,15)


local charent=nil
function initent()
  srand(1234)

  time=0
  hurttime=0
  if currentlevel!=firstlevel and currentlevel!=finallevel then
    sfx(16)
  end
  initsnow()

  ent={}
  --[[
  for i=1,1 do
    add(ent, {x=i*6+70,y=15,vx=0,vy=0,s=5,g=0})
  end
  ]]

  charent={x=charx,y=chary,vx=0,vy=0,s=0,h=0,g=0,r=0}
  add(ent, charent)
  pcx,pcy = charent.x-64,charent.y-64


end

function getsnowpoints(m,snp)
  local cur={}
  for i=0,7 do
    for j=0,7 do
      local sv=sget((m%16)*8+i,flr(m/16)*8+j)
      if sv==14 then
        add(cur, {i,j})
      end
    end
  end
  snp[m]=cur
end

function initsnowpoints()
  snowpoints={}
  for m=3,127 do
    getsnowpoints(m,snowpoints)
  end
end

function initsnow()
  snow={}
  goalx=0
  goaly=0
  timedead=0
  timewin=0
  win=false
  dead=false
  snowmax=0
  firemax=0
  for i=regionx,regionendx do
    for j=regiony,regionendy do
      local m=mget(i,j)
      local sn = snowpoints[m]
      local issnow=m<63
      if sn ~= nil then
        for m=1,#sn do
          local cur=sn[m]
          add(snow, {cur[1]+(i-regionx)*8,cur[2]+(j-regiony)*8,rnd(6),issnow})
          if issnow then
            snowmax+=1
          else
            firemax+=1
          end
        end
      end
      if m>=48 and m<=56 then
        mset(i,j,48+rnd(9))
      end
      if m>=32 and m<=40 then
        mset(i,j,32+rnd(9))
      end
      if m>=13 and m<=15 then
        mset(i,j,13+rnd(3))
      end
      if m==1 then
        goalx,goaly=(i-regionx)*8+4,(j-regiony)*8+4
      end
      if m==2 then
        charx,chary=(i-regionx)*8+4,(j-regiony)*8+4
      end
    end
  end
  snowcur=snowmax
  firecur=firemax
  --[[
  snowgrid={}
  for i=1,#snow do
    local cur=snow[i]
    local sx,sy=flr(cur[1]/8),flr(cur[2]/8)
    if snowgrid[sx] == nil then
      snowgrid[sx]={}
    end
    if snowgrid[sx][sy] == nil then
      snowgrid[sx][sy]={}
    end
    add(snowgrid[sx][sy], cur)
  end
  ]]
end

function _init()

  music(0,1000)

  pcx,pcy=16,16
  charx,chary=0,0

  initsnowpoints()

  setlevel(currentlevel)
  initent()

end

function mapget(px,py)
  local m=mget(px/8+regionx,py/8+regiony)
  if not fget(m,0) then
    return 0
  end
  local sv=sget((m%16)*8+px%8,flr(m/16)*8+py%8)
  return sv,m
end

function raycast(px,py,dx,dy,md)
  local found=10000
  local foundc=0
  for i=0,md+1 do
    px+=dx
    py+=dy
    local c,cm=mapget(px,py)
    if c!=0 then
      --found=i
      local difx=dx*i
      local dify=dy*i
      found=sqrt(difx*difx+dify*dify)
      foundc=cm
      break
    end
  end
  return found, px, py,foundc
end

function getnorm(px,py)
  local sn = 2
  local normx,normy=0,0
  local total = 0
  local mindist=10000
  local minx,miny=0,0
  for i=-sn,sn do
    for j=-sn,sn do
      local c = mapget(px+i,py+j)
      if c!=0 then
        normx+=i
        normy+=j
        total+=1
        local ll = len(i,j)
        if ll<mindist then
          mindist=ll
          minx,miny=px+i,py+j
        end
        --pset(py+i,py+j,15)
      end
    end
  end
  --normx = normx * 0.1
  --normy = normy * 0.1
  local normlen=sqrt(normx*normx+normy*normy)
  if normlen>0 then
    --normx /= total
    --normy /= total
    normx /= normlen
    normy /= normlen
  end
  mindist = len(px-flr(minx),py-flr(miny))
  return normx,normy,mindist
end

function dot(x1,y1,x2,y2)
  return (x1*x2+y1*y2)
end

function cross(x1,y1,x2,y2)
  return (x1*y2-y1*x2)
end

function len(dx,dy)
  return sqrt(dot(dx*0.1,dy*0.1,dx*0.1,dy*0.1))*10
end

function norm(dx,dy)
  local leng=len(dx,dy)
  return dx/leng,dy/leng
end

function normlen(dx,dy)
  local leng=len(dx,dy)
  return dx/leng,dy/leng,leng
end

function reflect(vx,vy,nx,ny,bounce)
  local per=dot(vx,vy,nx,ny)
  return vx-per*nx*2,vy-per*ny*(1+bounce)
end

function clamp(v,a,b)
  return max(a,min(b,v))
end

function upent(e, f)
  local px = e.x
  local py = e.y
  local d = e.s

  local nvx,nvy=e.vx,e.vy
  local lv=sqrt(nvx*nvx+nvy*nvy)
  if lv>0 then
    nvx /= lv
    nvy /= lv
  end

  local mindist = 10000
  local minx = 0
  local miny = 0
  local minc = 0
  local steps=32
  for i=1,steps do
    local dx=cos(i/steps)
    local dy=sin(i/steps)
    --line(px,py,px+dx*d,py+dy*d,6)
    local tx=px+dx*d
    local ty=py+dy*d
    local cd,cx,cy,cm=raycast(tx,ty,nvx,nvy,lv*f)
    if cd<mindist then
      mindist=cd
      minx=cx
      miny=cy
      minc=cm
    end
  end

  if mindist>=10000 then
    e.x+=e.vx*f
    e.y+=e.vy*f
    e.vy += 0.2*f
    e.g=min(e.g+1,100)
  else
    if (lv>2) playhurt=true
    if fget(minc,1) and not win then
      if not dead then
        sfx(17)
      end
      dead=true
    end
    e.x+=nvx*mindist*0.95
    e.y+=nvy*mindist*0.95
    local nx,ny,nl=getnorm(minx,miny)
    e.x-=nx*nl
    e.y-=ny*nl
    e.vx,e.vy = reflect(e.vx,e.vy,nx,ny,0.2)
    if ny>0 then
      e.g=0
    end
  end
  e.ax+=e.x*f
  e.ay+=e.y*f
  e.avx+=e.vx*f
  e.avy+=e.vy*f
  e.r+=clamp(e.avx,-2,2)
end

function preupent(e)
  e.ax=0
  e.ay=0
  e.avx=0
  e.avy=0
end

function postupent(e)
  e.vx *= 0.98
  e.vy *= 0.98
end

function lerp(a,b,f)
  return a*(1-f)+b*f
end

function lerp2(a,b,c,d,f)
  return a*(1-f)+c*f,b*(1-f)+d*f
end

lastpressjump=false
lastaskjump=0
askjump=false
function _update()


  if dead or win then
    lastpressjump=false
    lastaskjump=0
    askjump=false
    if btnp(4) or btnp(5) then
      if dead then
        initent()
      elseif win then
        if (snowmax>0) totalsnow += flr(100-snowcur/snowmax*100.0)
        if (firemax>0) totalfire += flr(100-firecur/firemax*100.0)

        if currentlevel<#levels then
          setlevel(currentlevel+1)
          initent()
          return
        else
          setlevel(1)
          initent()
          return
        end
      end
    end
  elseif currentlevel==firstlevel then
    lastpressjump=false
    lastaskjump=0
    askjump=false
    if btnp(4) or btnp(5) then
      setlevel(currentlevel+1)
      initent()
      return
    end
  elseif currentlevel==finallevel then
    lastpressjump=false
    lastaskjump=0
    askjump=false
  else
    local pressjump = btn(2)
    local onground=charent.g<30
    if pressjump and not lastpressjump and lastaskjump==0 then
      lastaskjump=10
      askjump=true
    end
    lastpressjump = pressjump

    local speed = 0.2
    if onground then
      if askjump then
        askjump=false
        charent.vy = -3
        sfx(13)
      end
    else
      if(btnp(3)) charent.vy += 3
      speed = 0.1
    end
    if(btnp(4) or btnp(5)) initent()
    if(btn(0)) charent.vx -= speed
    if(btn(1)) charent.vx += speed

    if lastaskjump>0 then
      lastaskjump-=1
    else
      askjump=false
    end
  end
  playhurt=false
  if not dead then
    for i=1,#ent do
      local st=5
      local e=ent[i]
      preupent(e)
      for k=1,st do
        upent(e,1.0/st)
      end
      postupent(e)
    end
  end
  if not dead and not win then
    if playhurt and hurttime==0 then
      sfx(14+rnd(2))
      hurttime=8
    end
  end
  if hurttime>0 then
    hurttime-=1
  end
  local forw=20
  local wantx,wanty=charent.ax-64,charent.ay-64
  pcx,pcy = lerp2(pcx,pcy,wantx + charent.avx*forw,wanty + charent.avy*forw,0.1)
  pcx,pcy = clamp(pcx-wantx,-48,48)+wantx,clamp(pcy-wanty,-48,48)+wanty
  pcx = clamp(pcx,0,(regionendx-regionx)*8-120)
  pcy = clamp(pcy,0,(regionendy-regiony)*8-120)

  local todel={}
  for i=1,#snow do
    local cur=snow[i]

    local dist=len(cur[1]-charent.ax,cur[2]-charent.ay)
    if dist<(charent.s+3) then
      if cur[4] then
        charent.h += 0.05
        add(todel,cur)
        if not win then
          snowcur-=1
        end
      else
        charent.h -= 0.05
        if charent.h<0 and not win then
          if not dead then
            sfx(17)
          end
          dead=true
        end
        add(todel,cur)
        if not win then
          firecur-=1
        end
      end
      charent.s = max(0,charent.h)
    end
  end

  if len(goalx-charent.ax,goaly-charent.ay)<max(8,charent.s+3) then
    if not win then
      sfx(18)
    end
    win=true
  end

  if dead then
    timedead += 1
  end
  if win then
    timewin += 1
  end

  for i=0,#todel do
    del(snow,todel[i])
  end

  time += 0.01
end

function drawparal(posx,posy)
  local backlen = 32*8
  local offx = flr(posx/backlen+1)*backlen
  map(96,48,offx-posx,-posy,backlen/8,16)
  map(96,48,offx-posx-backlen,-posy,backlen/8,16)
end

function message(t,y,c1,c2)
  local x=30
  rectfill(x-1,y-1,x+67,y+43,c1)
  rectfill(x,y,x+66,y+42,c2)
  print(t,x+34-2*#t,y+4,c1)
  if (snowmax>0) print("snow: "..flr(100-snowcur/snowmax*100.0).."%",x+32-2*#t,y+14,c1)
  if (firemax>0) print("fire: "..flr(100-firecur/firemax*100.0).."%",x+32-2*#t,y+20,c1)
  print("press x",x+32-2*7,y+30,time%0.2>0.1 and c1 or c2)
end

poke(0x5f2e,1)
function _draw()

  pal(3,10+128,1)
  pal(11,11+128,1)
  pal(5,3+128,1)
  --pal(6,6,1)
  pal(0,13+128,1)
  pal(14,6,1)
  --pal(13,6+128,1)
  --pal(5,13+128,1)

  cls(14)

  camera()

  srand(9592)
  local bpy=32
  for i=0,127 do
    rectfill(i,bpy,i,128,12)
    bpy+=rnd(4)-2
  end
  srand(3272)
  bpy=54-pcy*0.1
  for i=0,127 do
    local cpb=(i-pcx*0.1+32)%128
    rectfill(cpb,bpy,cpb,128,11)
    bpy+=rnd(4)-2
  end

  local reg=196
  drawparal(pcx*0.2+32,(pcy-reg)*0.2)
  drawparal(pcx*0.35-24,(pcy-reg)*0.35)
  drawparal(pcx*0.5,(pcy-reg)*0.5)

  camera(pcx,pcy)

  local mapx,mapy=flr(pcx/8),flr(pcy/8)
  pal(14,13)
  pal(10,0)
  map(mapx+regionx,mapy+regiony,mapx*8,mapy*8,17,17)
  pal(14,14)
  pal(0,0)

  if currentlevel==finallevel then
    spr(75,57,61,2,2)
    spr(71,49,46,4,2)
    spr(77,57,36,2,2)
    local x=16
    local y=min(4,time*50-30)
    local t="thank you for playing"
    rectfill(x-1,y-1,x+95,y+23,2)
    rectfill(x,y,x+94,y+22,6)
    print(t,x+6,y+4,2)
    print("final score: "..(totalsnow+totalfire),x+18,y+14,2)
    print("nusan",91,115,5)
    print("ld 45",19,115,5)
    --print("snow score: "..totalsnow,x+22,y+14,2)
    --print("fire score: "..totalfire,x+22,y+20,2)
  elseif currentlevel==firstlevel then
    print("nusan",91,115,5)
    print("ld 45",19,115,5)
    local tx,ty=48,13+sin(time*1)*3
    pal(6,13)
    spr(11,tx,ty,2,2)
    spr(124,tx+16,ty,2,1)
    spr(126,tx+16,ty+8,2,1)
    pal(6,6)
    print("press x to start",32,90,time%0.2>0.1 and 1 or 3)
  else
    for i=1,#ent do
      local e=ent[i]
      if not dead then
        circfill(e.ax,e.ay,e.s+1,13)
        circfill(e.ax,e.ay,e.s,7)
      end
      if e.s>2 or dead then
        local q=e.s*5-5
        local cc=dead and 7 or 14
        if(dead) q=max(q,40-timedead*2)
        for k=0,q do
          local a=k*0.1234-e.r*0.01
          local d=e.s*sqrt(sin(k*3.1415)*0.49+0.51)+0.5
          d+=timedead
          local ca,sa=cos(a),sin(a)

          circ(e.ax+ca*d,e.ay+sa*d,1,cc)

          --pset(e.ax+cos(a)*d,e.ay+sin(a)*d,6)

          --line(e.ax,e.ay,e.ax+cos(a)*d,e.ay+sin(a)*d,6)
        end
        if not dead then
          circ(e.ax,e.ay,1,14)
        end
      end
      --line(e.ax,e.ay,e.ax+e.vx,e.ay+e.vy,7)
    end
  end

  for i=1,#snow do
    local cur=snow[i]
    if cur[4] then
      rectfill(cur[1],cur[2]-2,cur[1],cur[2]+cur[3]-1,7)
    else
      local h=sin(time*3+cur[3])+1
      rectfill(cur[1],cur[2]-h*3,cur[1],cur[2],9)
      rectfill(cur[1],cur[2]-h*2+1,cur[1],cur[2],8)
    end
    --circfill(cur[1],cur[2],cur[3],7)
    --spr(35+cur[3],cur[1]-4,cur[2]-4)
  end

  camera()

  if time<1 and currentlevel!=finallevel and currentlevel!=firstlevel then
    message(levels[currentlevel].name,max(114,80+time*30), 2, 6)
  end

  if dead then
    message("you died",max(64,120-timedead),6,2)
  elseif win then
    message("victory",max(64,120-timewin),2,6)
  end

  --print(#snow, 96,8,8)
  --if(snowmax>0) print("snow "..flr(snowcur/snowmax*100.0),96,16,8)
  --if(firemax>0) print("fire "..flr(firecur/firemax*100.0),96,24,8)
  --if(snowmax>0) print("snow "..snowcur.." "..snowmax,66,16,8)
  --if(firemax>0) print("fire "..firecur.." "..firemax,66,24,8)
  --print("cpu "..flr(stat(1)*100), 96,0,8)
end
