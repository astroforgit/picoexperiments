pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- multi marshmallow
-- by cubee ‚

--[[

=== changes ===

- up to 5 players
  (anything above 4 might get slow)
- each player has own palette
- smoke disappears over time
- [p] no high score
- [p] last player to die wins
- increased chance of odd coins
   being life-ups
- odd coins appear more often
- minor chunk changes

]]

cartdata("cubg-marshmallow-multiplayer")
function _init(m)
 reload()
 t=0
 x=4
 y=96
 yv=0
 cx=0
 spd=0
 acc=0.1
 grv=0.1
 jmp=3
 jpow=0
 jump=true
 squish=0
 die=false
 burnt=false
 mode=m or "splash"
 dx={}
 dy={}
 ds={}
 dc={}
 wait=0
 wait2=0
 for ix=0,127 do
  for iy=96,127 do
   if sget(ix,iy)==0 and sget(ix,iy+1)==7 then
    if rnd(8)<1 then
     sset(ix,iy,rnd(3))
    end
   end
  end
 end
 for i=0,1 do
  if i==1 then
   new_tiles()
  end
  new=ceil(rnd(8))-1
  for ix=0,15 do
   for iy=8,23 do
    mset(ix+16*i,iy,sget(ix+new*16,iy-8+64))
   end
  end
 end
 ps=18
 if mode=="game" then
  music(14)
  fade=0
  show=false
 end
 fade=128
 fadev=0
 hat=false
 hats={104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127}
 a={"c","u","b","e","e"," ","g","a","m","e","s"}
 ty={}
 tl={}
 title=0
 title_t=0
 life=3
 inv=0
 shake=0
 air=true
 d=1

 _init_multi()
 st=false
end

function _update60()

 if mode=="splash" then
  if (t==300 or (btnp()~=0 and not btn(6))) st=true
  if st and abs(lh)<1 then
   mode="story"
   fade=128
   show=true
   t=0
   sfx(-1)
   music(10)
  end
  if t==1 then
   sfx(22)
  end

	elseif mode=="story" then
	 if t%240==1 then
	  if text[#ty+1] then
	   add(ty,128)
	   add(tl,1)
	  else
	   if (ty[#ty] or 0)<-8 then
	    mode="game"
     music(14)
     sfx(4)
	   end
	  end
	 end
	 for i=1,#ty do
	  if ty[i] then
	   ty[i]-=0.1
	   tl[i]+=0.2
	  end
	 end
	 if btnp(4) then
	  ty={}
	  mode="game"
   music(14)
   sfx(4)
	 end

	elseif mode=="game" then
	 -- menu buttons
	 --menuitem(2,"original music",function() music(5) end)
	 --menuitem(3,"new music",function() music(14) end)

	 -- add players by pressing Ž
	 for p=0,7 do
	  if btnp(4,p) then
	   if p>=current_p then
	    current_p=p
	    init_char(p+1)
   	 -- hide title if button pressed
	    title_t=128

	   end
	  end
	 end

  -- update smoke
  max_smoke=100/instance
  for i=1,#dx do
   if dx[i] then
    dy[i]-=ds[i]*dc[i]/100
    if fget(mget(dx[i]/8,(dy[i]+3)/8),0) or dy[i]<0 or dx[i]<0 then
     if mget(dx[i]/8,(dy[i]+4)/8)~=9 then
      del_smoke(i)
     end
    elseif i<#dx-max_smoke then
     ds[i]-=0.1
     if ds[i]<1 then
      del_smoke(i)
     end
    end
   end
  end

	 -- update players
	 for i=1,instance do
	  if char[i].x then
	   id=i-1

    get_vars(i)

			 -- cooked
			 if die then
			  if t==30 then
			   sfx(2)
			  end
			  if t>30 then
			   yv+=grv
			   y+=yv
			   burnt=true
			  end
			  if y>256 then
			   die="over"
			   dead=0
					 for a=1,instance do
					  if char[a].x then
				    if char[a].die then
				     dead+=1
				    end
					  end
					 end

					 if dead>=instance then
					  mode="over"
					 end
			  end
		
			 -- alive
			 else

				 -- random hat button
				 if btnp(5,id) then
				  hat=mid(1,int(rnd(#hats)),#hats)
				  sfx(0)
				 end

			  max_spd=min(max(life/2.5,0.5),1.5)

			  -- idle animation
			  if spd==0 and yv==0 then
			   wait+=1
			   wait2+=1
			   if wait>300 then
			    if rnd(5)<4 then
			     wait=260
			    else
			     if rnd(2)<1 then
			      wait=150
			     else
			      wait=0
			     end
			    end
			   end
			   if wait2==900 then
		     music(-1,3000)
		    end
			  else
				  if wait2>=1200 then
				   music(14)
				  end
			   wait=0
			   wait2=0
			  end
			  if wait2==1200 then
			   music(20)
			  end

		   -- player movement
		   if air then
		    acc=0.06
		    frc=40
		   else
		    acc=0.1
		    frc=10
		   end

			  if btn(0,id) and jpow==0 then
			   if spd>-max_spd then
			    spd-=acc
			   end
			  elseif btn(1,id) and jpow==0 then
			   if spd<max_spd then
			    spd+=acc
			   end
			  else
			   spd-=sgn(spd)/frc
			   if abs(spd)<acc+0.1 then
			    spd=0
			   end
			  end
			
			  -- player sprite
			  ps=18+spd*2
			  ps=mid(16,ps,20)
			
			  -- smoke increases with more damage
			  if life<3 and rnd(life*10+5)<1 then
			   make_smoke(x,y)
			  end
			
			  -- move x
			  x+=spd
			  if spd>0 then
			   d=1
			  elseif spd<0 then
			   d=-1
			  end
			
			  -- move y
			  yv=min(yv,3)
			  if not roof then
				  yv+=grv
			   y+=yv
			  end

			  -- floor collision and jump charging
			  air=true
			  squish-=0.2
			  squish=max(squish)
			  if fget(mget((x-3)/8,(y+4)/8),0) or fget(mget((x+3)/8,(y+4)/8),0) then
			   air=false
			   if yv>0.5 then
			    sfx(5)
			    squish=yv
			   end
			   yv=0
			   y=flr(y/8)*8+4
			   jump=false
			
			   -- charge jump
			   if btn(4,id) then
			    jpow+=1
			    jpow=min(jpow,20)
			   end
			
			   -- die if touching hot surface
			   if mget((x-3)/8,(y+4)/8)==9 or mget((x+3)/8,(y+4)/8)==9 then
			    m_die()
			   end
			  else
			   jpow=0
			  end
			
			  -- roof collision
			  roof=false
			  if fget(mget(x/8,(y-4)/8),0) then
			   yv=0
			   y=ceil(y/8)*8-4
			   if btn(2,id) and life<2 then
			    roof=true
			    y-=1
			   end
			  end

		   -- right collision
		   if fget(mget((x+4)/8,y/8),0) then
		    spd=0
		    x=flr(x/8)*8+4
		   end
		
		   if fget(mget((x+5)/8,y/8),0) then
		    -- wall jump
		    wall=-1
		    if btnp(4,id) and life<3 and yv~=0 then
		     walljump()
		    end
		
		    -- wall climb
		    if (btn(1,id) or wjump) and life<3 and jump then
		     climb=true
		    end
		   end
		
		   -- left collision
		   if fget(mget((x-4)/8,y/8),0) then
		    spd=0
		    x=ceil(x/8)*8-4
		   end
		
		   if fget(mget((x-5)/8,y/8),0) then
		    -- wall jump
		    wall=1
		    if btnp(4,id) and life<3 and yv~=0 then
		     walljump()
		    end
		
		    -- wall climb
		    if (btn(0,id) or wjump) and life<3 and jump then
		     climb=true
		    end
		   end
		
		   if climb and not roof then
		    if yv>0 then
		     yv/=3-life
		    end
		    if btn(2,id) then
		     y-=max_spd
		     cyt=-y+64
		     ps=34
		    elseif btn(3,id) then
		     y+=max_spd
		     cyt=-y+64
		     ps=50
		    end
		    if not (fget(mget((x-4)/8,y/8),0) or fget(mget((x+4)/8,y/8),0)) then
		     climb=false
		    end
		   end
		
			  x=max(x,4)
			
			  -- save from being trapped
			  if fget(mget((x)/8,(y)/8),0) then
			   y+=8*sgn(yv)
			  end
			
			  -- die if off bottom
			  if y>128+64 then
			   m_die(true)
			  end
			
			  -- jumping
			  if not btn(4,id) and jpow>0 then
			   yv=-jmp/20*max(jpow,9)
			   if btn(0,id) then
			    spd=yv/4
			   elseif btn(1,id) then
			    spd=-yv/4
			   end
			   jump=true
			   sfx(1)
			   jpow=0
			  end

			  -- jumping sprites
			  if not climb then
			   if yv>0.5 then
			    ps+=32
			   elseif yv<-0.5 then
			    ps+=16
			   end
			  end
			
			  -- get coins
			  if mget((x)/8,(y)/8)==10 then
			   mset((x)/8,(y)/8,0)
			   score+=1
			   sfx(6)
			  end
			
			  -- get health pickups
			  if mget((x)/8,(y)/8)==11 then
			   mset((x)/8,(y)/8,0)
			   life+=1
			   sfx(7)
			  end

			  -- get odd coins
			  if mget((x)/8,(y)/8)==12 then
			   mset((x)/8,(y)/8,0)
			   if rnd(2)<1 then
			    life+=1
			    sfx(7)
			   else
			    score+=1
			    sfx(6)
			   end
			  end

			  -- die if touching fire
			  if fget(mget((x-3)/8,y/8),1) or fget(mget((x+3)/8,y/8),1) then
			   m_die()
			  end

			  -- stop at edge
			  x=max(x)

				 -- invincibility
				 inv-=1
				 inv=max(inv)

				 -- screen shake
				 shake-=1
				 shake=max(shake)

				 ps+=0.5

		  end

	   char[i].x=x
	   char[i].y=y
	   char[i].spd=spd
	   char[i].yv=yv
	   char[i].d=d
	   char[i].life=life
	   char[i].max_spd=max_spd
	   char[i].acc=acc
	   char[i].frc=frc
	   char[i].air=air
	   char[i].jump=jump
	   char[i].jpow=jpow
	   char[i].wait=wait
	   char[i].wait2=wait2
	   char[i].ps=ps
	   char[i].die=die
	   char[i].squish=squish
	   char[i].roof=roof
	   char[i].wall=wall
	   char[i].climb=climb
	   char[i].inv=inv
	   char[i].shake=shake
    char[i].burnt=burnt
    char[i].hat=hat
	   char[i].score=score
		 end

		 -- stop at edge
	  cx=max(x-64)

   -- check if all in next chunk
   yes=0
		 for i=1,instance do
		  if char[i].x then
		   if char[i].x>128+64 or char[i].die then
		    yes+=1
		   end
		  end
		 end

	  -- add new chunk if everyone
	  -- is out of first one
	  if cx>128 and yes==instance then
	
	   -- move chunk back
	   for ix=0,15 do
	    for iy=8,23 do
	     mset(ix,iy,mget(ix+16,iy))
	    end
	   end
	
	   -- place new chunk
	   new_tiles()
	   new=ceil(rnd(8))-1
	   for ix=0,15 do
	    for iy=8,23 do
	     mset(ix+16,iy,sget(ix+new*16,iy-8+64))
	    end
	   end
	
	   -- move objects back
			 for i=1,instance do
			  if char[i].x then
		    char[i].x-=128
		   end
		  end
	   for i=1,#dx do
	    if dx[i] then
	     dx[i]-=128
	    end
	   end
	   cx=0

	  else

	   -- keep players on map
			 for i=1,instance do
			  if char[i].x then
		    char[i].x=min(char[i].x,252)
		   end
		  end
	  end

	  -- animate fire and make smoke
	  if t%8/2==0 then
	   for ix=0,32 do
	    for iy=8,23 do
	
	      -- fire
	     if fget(mget(ix,iy),1) then
	      mset(ix,iy,int(rnd(3))*16+8)
	      if rnd(7)<1 then
	       make_smoke(ix*8+4,iy*8+4)
	      end
	
	      -- hot surface
	     elseif mget(ix,iy)==9 then
	      if rnd(12)<1 then
	       make_smoke(ix*8+4,iy*8+4)
	      end
	     end
	    end
	   end
	  end

	 end

	 -- roller door effect
	 fadev=(fade+10)/20
	 fade-=fadev

	 -- title screen move
	 title_v=(title+title_t)/20
	 title-=title_v
	 if title<-64 then
	  show=false
	 end

 elseif mode=="over" then
  music(-1,1000)
  top=0
  win_id=1
  for i=1,instance do
   if char[i].x then
    if char[i].score>top then
     top=char[i].score
     win_id=i
    end
   end
  end

  if btnp(4) then
   run()
  end
	end

 -- timer
 t+=1
 t=max(t)

end




function _draw()
 fillp()
	cls()

 if mode=="splash" then
	 -- reset colours
	 pal()
	 palt(10,true)
	 if st then
	  lh-=sgn(lh)
	  lw+=abs(lh/4)
	 else
	  lw=min(abs(sin(t/300)*16)+t/3,64)--96
	  lh=min(abs(cos(t/400)*16)+t/6-32,16)
	 end
	 sspr(64,32,64,16,64-lw/2,64-lh/2,lw,lh)
	 palt(10,false)

 elseif mode=="story" then
	 for i=1,#ty do
	  if ty[i] then
	   ty[i]-=0.2
	   print(sub(text[i],1,tl[i]),8,ty[i],6)
	  end
	 end

	elseif mode=="game" then

		pal(1,129,1)
	 cls()
	 -- draw each player's screen
	 for i=1,instance do
	  camera()

	  -- clip to area
	  clip(pos[instance][i*2-1],pos[instance][i*2],res[instance][i*2-1],res[instance][i*2])
	  cx2=( pos[instance][i*2-1]-char[i].x+res[instance][i*2-1]/2 )
	  cy2=( pos[instance][i*2]-char[i].y+res[instance][i*2]/2 )

	  get_vars(i)
	  cx2=-cx2
	  cy2=-cy2
	  --cx2=mid(-1,cx2,129)
	  --cy2=max(pos[instance][i*2],cy2)+pos[instance][i*2]
	  --cy2=min(cy2)

	  camera(cx2,cy2+rnd()*shake/4)

	  pal()
	  scr_x=cx2+pos[instance][i*2-1]
	  scr_y=cy2+pos[instance][i*2]

   if die=="over" then
    cprint("game over",scr_x+res[instance][i*2-1]/2,scr_y+res[instance][i*2]/2-3,7)

    -- score
			 palt(14,true)
    spr(10,scr_x+1,scr_y+1)
				print(score,scr_x+9,scr_y+2,7)

   else

			 -- draw background smoke
		  fillp(0b1010010110100101.1)
			 for a=1,#dx do
			  if dx[a] and dc[a]==5 then
			   if dx[a]>scr_x and dx[a]<scr_x+res[instance][i*2-1] then
			    circfill(dx[a],dy[a],ds[a],dc[a])
			   end
			  end
			 end

		  -- char sprites
		  for i2=1,instance do
		   get_vars(i2)
		   id=i2-1
		   pal()

					-- marshmallow when not cooked
			  set_m_pal(i2)
				 palt(0,false)
				 palt(14,false)
				 palt(15,true)
				 if spd~=0 and yv==0 then
				  yo=min(t%10/5-1,1)
				 else
				  yo=0
				 end
				 if not die then
				  if roof then
					  spr(ps+32,x-4,y-3-yo)

				  elseif inv==0 or (inv>0 and t%2==1) then

					  -- charge jump
					  if btn(4,id) and not jump then
					   if hat then
					    spr(hats[hat],x-4,y-10-yo)
					   end
					   j=20-jpow
					   spr(53+max(flr(t%j/(j/2))*4),x-8,y-4-yo,2,1)

			    -- sleep
					  elseif wait2>1200 then
					   if hat then
					    spr(hats[hat],x-4,y-10-yo+flr(wait2%120/60))
					   end
					   if spd<0 then
					    s=25
					   elseif spd>0 then
					    s=41
					   else
					    s=37
					   end
					   spr(14+flr(wait2%120/60)*32,x-8,y-4-yo,2,1)

					  -- duck
					  elseif squish>0 or (wait>260 and wait<270) or (btn(3,id) and spd==0 and yv==0) then
					   if hat then
					    spr(hats[hat],x-4,y-10-yo)
					   end
					   if spd<0 then
					    s=25
					   elseif spd>0 then
					    s=41
					   else
					    s=37
					   end
					   spr(s,x-8,y-4-yo,2,1)

					  -- look up
					  elseif (wait>280 and wait<290) or (btn(2,id) and spd==0 and yv==0) then
					   if hat then
					    spr(hats[hat],x-4,y-14-yo)
					   end
					   spr(23,x-4,y-12-yo,1,2)
					
					  -- normal
					  else
					   if hat then
					    spr(hats[hat],x-4,y-12-yo)
					   end
					   spr(ps,x-4,y-4-yo)
					  end
					 end
					end

			 end

		  get_vars(i)

			 -- draw foreground smoke
			 pal()
		  fillp(0b0101101001011010.1)
			 for a=1,#dx do
			  if dx[a] and dc[a]==6 then
			   if dx[a]>scr_x and dx[a]<scr_x+res[instance][i*2-1] then
			    circfill(dx[a],dy[a],ds[a],dc[a])
			   end
			  end
			 end
			 palt(14,true)
			 palt(0,false)

			 -- draw level
	   rectfill(-8,scr_y,-1,scr_y+res[instance][i*2],12)
	   rectfill(256,scr_y,263,scr_y+res[instance][i*2],12)
			 fillp()
			 map()

		  -- char sprites
		  for i2=1,instance do
		   get_vars(i2)

		   id=i2-1
		   pal()

			  set_m_pal(i2)
				 palt(0,false)
				 palt(14,false)
				 palt(15,true)

				 -- marshmallow when cooked
			  if die then
			   if hat then
			    spr(hats[hat],x-4,y-12)
			   end
				  if burnt then
				   spr(22,x-4,y-4)
				  else
				   spr(21,x-4,y-4)
				  end
				 end

			 end

		  get_vars(i)

    pal()

    -- score
			 palt(14,true)
    spr(10,scr_x+1,scr_y+1)
				print(score,scr_x+9,scr_y+2,7)

 		 -- life bar
			 palt(14,false)
			 palt(15,true)
    palt(0,false)
		  set_m_pal(i)
		  for a=1,life+1 do
		   if wait2>1200 then
		    spr(13,flr(scr_x)+a*7-6,flr(scr_y)+res[instance][i*2]-9)
		   else
		    spr(55,flr(scr_x)+a*7-6,flr(scr_y)+res[instance][i*2]-10+abs(sin((t+a*20)/100)-0.5))
		   end
		  end
		  pal()
		 end

	  -- screen outline
	  camera()
	  rect(pos[instance][i*2-1],pos[instance][i*2],pos[instance][i*2-1]+res[instance][i*2-1]-1,pos[instance][i*2]+res[instance][i*2]-1,0)
	 end
	
	 clip()
	 camera()

  pal()

	 -- title screen
	 if show then
	  rectfill(0,title+16,127,title+79,0)

	  rect(30,title+17,97,title+52,5)
	  spr(64,32,title+27,8,3)
	  spr(27,44,title+19,5,1)
	  cprint("„ an endless platformer „",60,title+55)
	  cprint("„     by cubee games     „",60,title+64)
	  cprint("„    now multiplayer!   „",60,title+73)
	 end

	 rectfill(0,0,127,fade,0)

 elseif mode=="over" then
  camera()
  set_m_pal(win_id or 0)
  spr(18,60,60)
  pal()
  cprint("game over",64,32)
  cprint("player "..(win_id or " ").." wins!",64,89)

 end
end

-->8
-- functions

function _init_multi()
 -- list of screen positions
 -- for each amount of players
 pos={
  {0,0},
  {0,0,0,64},
  {0,0,0,64,64,64},
  {0,0,64,0,0,64,64,64},
  {0,1,0,43,64,43,0,85,64,85},
  {0,1,64,1,0,43,64,43,0,85,64,85},
  {0,1,64,1,1,43,43,43,85,43,0,85,64,85},
  {0,1,64,1,1,43,43,43,85,43,1,85,43,85,85,85}
 }
 -- list of screen resolutions
 -- for each amount of players
 res={
  {128,128},
  {128,64,128,64},
  {128,64,64,64,64,64},
  {64,64,64,64,64,64,64,64},
  {128,42,64,42,64,42,64,42,64,42},
  {64,42,64,42,64,42,64,42,64,42,64,42},
  {64,42,64,42,42,42,42,42,42,42,64,42,64,42},
  {64,42,64,42,42,42,42,42,42,42,42,42,42,42,42,42}
 }

 -- init variables
 t=0
 a=0

 -- init player object
 char={}

 -- init game
 instance=0
 current_p=0
 --init_char(8)
end

function init_char(i)
 instance=min(i,5)
 for i=1,instance do
  if not char[i] then
   char[i]={x=4,y=96+64,spd=0,yv=0,d=0,score=0,life=3,max_spd=0,acc=0,frc=0,air=false,jump=false,jpow=0,wait=0,wait2=0,ps=0,die=false,squish=0,roof=false,wall=false,climb=false,inv=0,shake=0,burnt=false,hat=false}
  end
 end
end

function get_vars(i)
 x=char[i].x
 y=char[i].y
 spd=char[i].spd
 yv=char[i].yv
 d=char[i].d
 life=char[i].life
 max_spd=char[i].max_spd
 acc=char[i].acc
 frc=char[i].frc
 air=char[i].air
 jump=char[i].jump
 jpow=char[i].jpow
 wait=char[i].wait
 wait2=char[i].wait2
 ps=char[i].ps
 die=char[i].die
 squish=char[i].squish
 roof=char[i].roof
 wall=char[i].wall
 climb=char[i].climb
 inv=char[i].inv
 shake=char[i].shake
 burnt=char[i].burnt
 hat=char[i].hat
 score=char[i].score
end

-- integer function
function int(i)
 n=i-flr(i)
 if n<0.5 then
  return flr(i)
 else
  return ceil(i)
 end
end

-- centre print with border
function cprint(t,x,y)
 w=#t*4
 for ix=-1,1 do
  for iy=-1,1 do
   print(t,x-w/2+ix,y+iy,5)
  end
 end
 print(t,x-w/2,y,7)
end

-- make smoke
function make_smoke(x,y)
 add(dx,x+rnd(6)-3)
 add(dy,y+rnd(6)-3)
 add(ds,rnd(4)+2)
 add(dc,int(rnd())+5)
end

-- remove smoke
function del_smoke(i)
 dx[i]=""
 dy[i]=""
 ds[i]=""
 dc[i]=""
 del(dx,"")
 del(dy,"")
 del(ds,"")
 del(dc,"")
end

-- kill marshmallow
function m_die(instant)
 if inv==0 or instant then
	 sfx(3)
	 for i=1,10 do
	  make_smoke(x,y)
	 end
	 if life<1 or instant then
	  yv=-3
	  die=true
	  t=0
	  --music(-1)
	 else
	  life-=1
	  inv=60
	  yv=-2
	  spd=-d
	 end
 end
end

-- choose a tileset or keep current one
function new_tiles()
 if rnd(2)<1 then
  a=96
 elseif rnd(2)<1 then
  a=80
 else
  a=112
 end
 for ix=0,127 do
  for iy=0,15 do
   p=sget(ix,iy+a)
   sset(ix,iy+64,p)
  end
 end
end

function set_m_pal(i)
 if i==5 then
  pal(6,1)
  pal(7,12)
  if life==2 then
   pal(6,0)
  elseif life==1 then
   pal(6,0)
   pal(7,13)
  elseif life<=0 then
   pal(6,0)
   pal(7,1)
  end
 elseif i==4 then
  pal(6,9)
  pal(7,10)
  if life==2 then
   pal(6,4)
  elseif life==1 then
   pal(6,4)
   pal(7,9)
  elseif life<=0 then
   pal(6,2)
   pal(7,4)
  end
 elseif i==3 then
  pal(6,3)
  pal(7,11)
  if life==2 then
   pal(6,13)
  elseif life==1 then
   pal(6,13)
   pal(7,3)
  elseif life<=0 then
   pal(6,5)
   pal(7,13)
  end
 elseif i==2 then
  pal(6,2)
  pal(7,14)
  if life==2 then
   pal(6,5)
  elseif life==1 then
   pal(6,1)
  elseif life<=0 then
   pal(6,1)
   pal(7,13)
  end
 else
  pal(6,6)
  pal(7,7)
  if life==2 then
   pal(6,13)
  elseif life==1 then
   pal(6,13)
   pal(7,6)
  elseif life<=0 then
   pal(6,5)
   pal(7,6)
  end
 end
end

function walljump()
 if btn(0,id) or btn(1,id) or wjump then
  cyt=-y+64
  yv=-jmp/1.5
  spd=wall
  jump=true
  wjump=true
  sfx(5)
 end
end

-->8
-- story

text={
"one day in 2020...",
"a marshmallow factory caught\nfire.",
"most of the marshmallows were\ndestroyed.",
"a group of the survivors\nrealised what happened.",
"they set off to try and escape\nthe endless factory.",
"",
"cubee games ‚ presents..."
}
