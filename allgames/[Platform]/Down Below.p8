pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
state = "game"
id_cursor = 66
frame = 0

function xframe(x,range,delay)
	if not delay then delay=0 end
	if not range then
		return (flr((frame+delay)/x)%2)==0
	end
	return flr((frame+delay)/x)%range
end

function toward(v,t,s)
	if abs(v-t)<s then return t end
	if (v-t)>0 then
		return v-s
	else
		return v+s
	end
end

function rect_col(x,y,w,h, x2,y2,w2,h2)
	if x>x2+w2 then return false end
	if x+w<x2 then return false end
	if y>y2+h2 then return false end
	if y+h<y2 then return false end
	return true
end

function box_col(x,y,b, x2,y2,b2)
	return rect_col(
		x+b.x,y+b.y,b.w,b.h,
		x2+b2.x,y2+b2.y,b2.w,b2.h)
end

box_debug = false
function box_draw(x,y,b)
	if not box_debug then return end
	rectfill(x+b.x,y+b.y,x+b.x+b.w,y+b.y+b.h,11)
end


function col(x,y)
	tile = mget(x/8, y/8)
	return fget(tile, 1)
end

function move_actor(x,y,dx,dy)
	if not col(x+dx, y+dy) then
		return x+dx, y+dy, false, false
	end

	local r_cx = true
	local r_cy = true

	-- we deal with x
	if not col(x+dx, y) then
		x = x+dx
		r_cx = false
	end

	-- we deal with y
	if not col(x, y+dy) then
		y = y+dy
		r_cy = false
	end

	return x,y,r_cx, r_cy
end

function _init()
	level_init()
--	current_level = 8
--	goto_sacrifice()
end

function _update60()
	frame+= 1

	if state=="game" then game_update() end
	if state=="sacrifice" then update_sacrifice() end

end

function _draw()
	if state=="game" then game_draw() end
	if state=="sacrifice" then draw_sacrifice() end
end
-->8
--* game *--

-- tile flags
floor_hurt = 0
floor_solid = 1
floor_bounce = 2
floor_bounce_right = 3
floor_bounce_left = 4

-- player
px = 64
py = 64
pvx = 0
pvy = 0
face = false
p_invincible = 0
pbox = {
	x = -1,
	y = -5,
	w = 2,
	h = 5
	}

-- follow camera
camy = 0
camtarget = 0
camzone = {16,40,76,104}

-- elevator
in_elevator = true
ex = 0
ey = 0
eh = 0

-- hearts
p_heart = 8 -- maximum hearts
p_sacrifice = 0 -- number of sacrifices
p_health = 8 -- health

time_off_ground = 0
jump_time = -1

function player_hit()
	if p_invincible>0 then
		return
	end
	p_invincible = 60
	p_health-=1
	if p_health<=0 then
		level_init()
	end

	sfx(10)

	-- push back
	pvy = -1
	pvx = -0.6*sgn(pvx)
end

function player_col(x,y,b)
	return box_col(x,y,b,px,py,pbox)
end
function player_col2(x,y,w,h)
	return rect_col(x,y,w,h,
		px+pbox.x,py+pbox.y,pbox.w,pbox.h)
end


function player_on()
	return mget(px/8, (py+1)/8)
end

function game_update()
	update_particles()

	friction = 0.02
	control_force = 0.05--0.037
	if fget(player_on(),floor_solid) then
		friction = 0.05
		control_force = 0.1--0.05
	end

	if btn(0) and pvx>-0.6 then
		pvx-=control_force
		face = true
	end
 if btn(1) and pvx<0.6 then
 	pvx+=control_force
 	face = false
 end

	if not btn(0) and not btn(1) then
		pvx = toward(pvx,0,friction)
	end


	-- check if on ground
	if fget(player_on(),1) then
		time_off_ground = 0
	else
		time_off_ground+= 1/60
	end

	-- jump
	if btnp(5)
		-- coyote time
		and time_off_ground<0.10
		and game_state=="gameplay"
		then
			jump_time = 0
			pvy = -0.8
			sfx(0)
	end

	if jump_time>=0 then
		jump_time+= 1

		if btn(5) then
			pvy-=0.25
		else
			jump_time = -1
		end

		if jump_time>6 then
			jump_time = -1
		end
	end

	-- check if on bounce block
	if fget(player_on(),floor_bounce) then
		time_off_ground = 1
		pvy = -3
		sfx(5)
	end

	-- check if on right bounce block
	if fget(mget((px-3)/8, (py-4)/8),floor_bounce_right) then
		pvx = 1.3
		pvy = -1.7
		face = false
		sfx(5)
	end

	-- check if on left bounce block
	if fget(mget((px+3)/8, (py-4)/8),floor_bounce_left) then
		pvx = -1.3
		pvy = -1.7
		face = true
		sfx(5)
	end

	-- check if on damage floor or floor
	if fget(player_on(),floor_hurt)
		or fget(mget((px-3)/8, (py-4)/8),floor_hurt)
		or fget(mget((px+3)/8, (py-4)/8),floor_hurt)
		or fget(mget(px/8, (py-6)/8),floor_hurt)
		then
		player_hit()
	end


	-- gravity
	if pvy < 0 then
		pvy+= 0.05 + 0.2*(1-0.5^(abs(pvy)/2.5))
	else
		pvy+= 0.035 + 0.165*(1-0.5^(abs(pvy)/2.5))
	end
	if pvy>2 then
		pvy = 2
	end

	-- move player only during gameplay
	if game_state~="gameplay" then
		pvx = 0
		pvy = 0
	end

	local ch, cv
	px,py,ch, cv = move_actor(px,py,pvx,pvy)
	if ch then pvx = 0 end
	if cv then
		if pvy>0.15 then pvy = 0.15 end
		if pvy<0 then pvy = 0 end
	end

	-- invincibility
	p_invincible-=1
	if p_invincible<0 then p_invincible = 0 end

	-- intro
	if game_state=="intro" then
		eh = toward(eh,-16,0.2)
		if eh==-16 then
			game_state = "gameplay"
			in_elevator = false
 		sfx(4)
		end
	elseif game_state=="gameplay" then
		eh = toward(eh,0,0.1)
	elseif game_state=="outro" then
		if in_elevator then
			eh = toward(eh,0,0.1)
 		if eh==0 then
 			next_level()
 		end
		else
			eh = toward(eh,-16,0.2)
 		if eh==-16 then
 			in_elevator = true
				sfx(4)
 		end
		end
	end

	-- camera
	if fget(player_on(),1)
		or py<camy+camzone[1]
		or py>camy+camzone[4]
		then
 		camtarget = py - 76
	end

	camy = toward(camy,camtarget,1)
	if camy<ly*8 then camy = ly*8 end
	if camy+128>(ly+lh)*8 then camy = (ly+lh)*8-128 end

	-- level update
	level_update()

	-- enemy update
	foreach(enemies,update_enemy)
end


function game_draw()
	cls()

	-- hearts

	rectfill(0,0,128,8,1)
	for x=0, p_heart-1 do
		id = 144
		if x>=p_health then
			id = 145
		end
		if x>=p_heart-p_sacrifice then
			id = 146
		end
		spr(id,x*9+5,0)
	end

	-- draw background
	map(bgx,bgy,0,-camy/2,16,32)
	level_draw()

	-- shift camera to shop top ui
	camera(lx*8,ly*8+camy-8)
	clip(0, 9, 128, 120)

	draw_particles()

	foreach(enemies,draw_enemy)

	-- elevator
	if in_elevator then
		spr(163,ex,ey+eh,2,2)
	else
		spr(131,ex,ey+eh,2,2)
	end

	-- draw level
	-- we draw the whole map
	map(0,0,0,0,128,32)

	-- player
	if not in_elevator and (p_invincible==0 or xframe(3)) then
		id = 67
		if fget(player_on(),floor_solid) then
 		if pvx==0 then
 			id = 67+xframe(30,2)*16
 		else
 			id = 67+xframe(10,3)
 		end
		else
			id = 84
			if pvy>0 then
				id = 85
			end
		end

		spr(id, px-4,py-7, 1, 1, face, false)
		box_draw(px,py,pbox)
	end

--[[
	for zone in all(camzone) do
		line(
			lx*8,camy+zone,
			lx*8+128,camy+zone,
			11)
	end
]]--

	-- resets
	camera(0,0)
	clip(0, 0, 128, 128)
end
-->8
-- level

current_level = 1

function level_init()
	pvx = 0
	pvy = 0
	face = false
	game_state = "intro"
	p_health = p_heart - p_sacrifice
	p_invincible = 10

	enemies = {}
	particles = {}

	frame = 0

	-- background
	bgx = 112
	bgy = 0

	in_elevator = true

	lvl = level[current_level]
	if lvl.copy then
		level[lvl.copy].init()

		-- we inverse start and goal
		tmpx, tmpy = px, py
		px, py = gx, gy
		gx, gy = tmpx, tmpy

		camy = 32*8-128
	else
		camy = 0
		lvl.init()
	end

	-- position player and goals
	px = px*8+3
	py = py*8+7
	new_exit(gx,gy)

	-- we position the elevator
	ex = px-8
	ey = (flr(py/8)+1)*8
	eh = 0

	if current_level>1 then
		sfx(3)
	end
end

function level_update()
	lvl = level[current_level]
	if lvl.copy then
		fn = level[lvl.copy].update
	else
		fn = lvl.update
	end

	if fn then fn() end
end

function level_draw()
	lvl = level[current_level]
	if lvl.copy then
		fn = level[lvl.copy].draw
	else
		fn = lvl.draw
	end

	if fn then fn() end
end

function next_level()
	current_level+=1
	if current_level>#level then
		current_level = #level
	end
	level_init()
end

