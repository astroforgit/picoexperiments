--* enemies *--
enemies = {}

function update_enemy(e)
	e:update()
end

function draw_enemy(e)
	e:draw()
end

function new_fireball(x,y,direction)
	local f = {
		update = update_fireball,
		draw = draw_fireball,
		x = x*8+4,
		y = y*8+4,
		direction = direction
	}
	add(enemies,f)

	if f.y>camy and f.y<camy+128 then
		sfx(7)
	end
end

fireball_box = {
	x = -2,
	y = -2,
	w = 3,
	h = 3
	}
function update_fireball(e)
	e.x+= e.direction*0.5

	if player_col(e.x,e.y,fireball_box) then
		player_hit()
	end

	tile = mget(e.x/8, e.y/8)
	if col(e.x, e.y)
		and tile~=16
		and tile~=12
		then
		del(enemies,e)
	end

end

function draw_fireball(e)
	spr(160+xframe(10,3), e.x-4,e.y-4,1,1,sgn(e.direction)~=1,false)
	box_draw(e.x,e.y,fireball_box)
end

function new_exit(x,y)
	add(enemies,
	{
		update = update_exit,
		draw = draw_exit,
		x = x*8,
		y = y*8,
		state = "waiting"
	})
end

exit_box = {
	x = 0,
	y = 0,
	w = 8,
	h = 8
	}
function update_exit(e)

	if player_col(e.x,e.y,exit_box)
		and game_state=="gameplay"
		and fget(player_on(),floor_solid)
		then
			goto_sacrifice()
  	ex = e.x-8
  	ey = (flr(e.y/8)+1)*8
	end
end

function draw_exit(e)
	turn_head = (e.x+4)<px
	if e.state=="waiting" then
		spr(112+xframe(20,2),e.x,e.y-3,1,1,turn_head)
	end
end

function new_spike(x,y,w)
	add(enemies,
	{
		update = update_spike,
		draw = draw_spike,
		x = x,
		y = y,
		w = w,
		activate_box = {
			x = x*8-4,
			y = y*8,
			w = w*8+8,
			h = 8
		},
		attack_box = {
			x = x*8,
			y = y*8+4,
			w = w*8,
			h = 4
		},
		state = -1
	})
end


function update_spike(e)

	if e.state==30 then
		sfx(9)
	end
	-- rest
	if e.state==-1 then
		if player_col(0,0,e.activate_box)
			and fget(player_on(),floor_solid)
			then
				e.state = 0
		end
	else
		-- attack
 	if e.state>30
			and player_col(0,0,e.attack_box)
			then
			player_hit()
		end

		-- update timer
		e.state+=1
		if e.state>120 then
			e.state = -1
		end
	end
end

function draw_spike(e)
	id = 176
	shiftx = 0
	if e.state>=0 then
		if e.state>=30 then
			id = 178
		else
			id = 177
			shiftx = xframe(5,2)
		end
	end

	for i=0,e.w-1 do
		spr(id,(e.x+i)*8+shiftx, e.y*8)
		box_draw(0,0,e.attack_box)
	end
end

function new_stomp(x,y,h,wait)
	add(enemies,
	{
		update = update_stomp,
		draw = draw_stomp,
		x = x,
		y = y,
		h = h,
		height = 0,
		wait = wait,
		state = 100
	})
end

function update_stomp(e)
	e.state+=1

	if e.state==30 then
	 sfx(8)
	end

	if e.state<30 then
--		e.height = 3
	elseif e.state<120 then
		e.height = e.h*5
	elseif e.state<e.wait then
		e.height-=0.5
		if e.height<2 then
			e.height = 2
		end
	else
		e.state = 0
	end

	-- collision with player
	if player_col2(e.x*8+4,e.y*8+8+e.height-3,8,3) then
		player_hit()
		pvy = 0
		pvx = 0
	elseif player_col2(e.x*8+1,e.y*8+8,16-2,e.height) then
		pvx = 1.3*sgn(px-(e.x*8+8))
		pvy = -1.7
		face = sgn(px-(e.x*8+8))<0
		sfx(5)
	end
end

function draw_stomp(e)
	x = e.x*8
	y = e.y*8+e.height

	if e.state<20 then
		x+= xframe(5,2)
	end


	-- draw bottom
	spr(169,x,y,2,1)
	y-=8

	-- draw the leftovers
	tile_height = flr(e.height/8)
	for i=1,tile_height do
		id = 153
		if (i%2)==0 then id = 137 end
		spr(id,x,y,2,1)
		y-=8
	end
end
-->8
-- sacrifice screen

ending = -1

function goto_sacrifice()
	state = "sacrifice"
	sacrifice_timeout = -1
	if current_level==5 then
		sfx(2)
	else
		sfx(1)
	end
end

function update_sacrifice()
	if btn(5) and sacrifice_timeout==-1 and ending==-1 then
		p_sacrifice+=1
		sfx(6)

		sacrifice_timeout = 60
	end

	if ending>=0 then
		ending+=1
		return
	end

	if sacrifice_timeout>0 then
		sacrifice_timeout-= 1
	elseif sacrifice_timeout==0 then
		if current_level==8 then
			ending = 0
		else
 		state = "game"
 		game_state = "outro"
			sfx(3)
 	end
	end

end

function draw_sacrifice()
	cls()

	rectfill(0,0,128,128,1)

	shiftx = 3*cos((flr(frame/0.4)%360)/360)
	shifty = 5*sin((flr(frame/0.4)%360)/360)
	id = 72
	if xframe(1,100)>90 then
		id = 74
	end
	spr(id,56+shiftx,16+shifty,2,2)

	if current_level==1 then
 	print("      your friend is dead?", 0, 40, 6)
 	print("            shame...",0,50,6)
 	print("    come with me to save him", 0, 60, 6)
 	print("     it only cost one heart", 0, 70, 6)
 elseif current_level==2 then
 	print("         nicely done", 0, 40, 6)
 	print("                     ‡", 0, 40, 8)
 	print("   your friend is still below",0,55,6)
 	print("     one more heart, please",0,65,6)
 elseif current_level==3 then
 	print("          i like you!", 0, 50, 6)
 	print("      you are perseverant",0,60,6)
 elseif current_level==4 then
 	print("      we are nearly there", 0, 40, 6)
 	print("  are you excited to see bill?",0,50,6)
 	print("  your friend is bill, right?",0,60,6)
 elseif current_level==5 then
 	print("    oops, bill is not there", 0, 40, 6)
 	print("  he was too good to be here",0,50,6)
 	print("  i hope you can make it back",0,65,6)
 	print("           ha ha ha!",0,75+xframe(5,2),6)
 elseif current_level==6 then
 	print("     oooh... are you crying?", 0, 50, 6)
 	print("      is it because of me?",0,60,6)
 	print("   is it because of dead bill?",0,70,6)
 elseif current_level==7 then
 	print("     can you make it back?", 0, 50, 6)
 	print("       you seem to have",2,60,6)
 	print("       some difficulties",0,70,6)
 elseif current_level==8 then
 	if ending==-1 then
  	print("      you did really well", 2, 50, 6)
  	print("       but i have to take",0,60,6)
  	print("        your last heart",2,70,6)
  else
  	print("           good bye!",0,45,6)
  end
 else
 	print("       sacrifice one heart", 0, 60, 6)
 	print("     to go to the next level", 0, 70, 6)
 end



	-- hearts
	for x=0, p_heart-1 do

		shiftx = 0
		shifty = 1.9 * cos((flr((frame+x*5)/0.18)%360)/360)
		id = 144

		if x>=p_health then
			id = 145
		end
		if x>=p_heart-p_sacrifice then
			id = 146
			shifty = 0
		end

		if sacrifice_timeout>30
			and x==p_heart-p_sacrifice
			then
			shiftx = rnd(4)-2
			shifty = rnd(2)-1
		end

		spr(id,x*9+28+shiftx,90+shifty)
	end


	if sacrifice_timeout==-1 and ending==-1 then
		print("     press — to sacrifice ‡", 0, 105, 6+xframe(5,2))
	end

	if ending>1 then
		circfill(64,64,ending/3,7)
 	spr(71,60,-120+ending/2)
	end

	if ending>520 then
		for i=0,8 do
			shiftx = 18 * cos((flr((frame+i*2)/1.0)%360)/360)
			shifty = 12 * cos((flr((frame+i*2)/0.15)%360)/360)
 			print("     - thanks for playing -", shiftx, 60+shifty, 8+i)
		end
 		print(" @nicmagnier", 0, 120, 8)
	end

end
-->8
-- particles

particles = {}

function new_particle(id,x,y,vx,vy,life)
	add(particles,{
		id = id,
		x = x,
		y = y,
		vx = vx,
		vy = vy,
		life = life
	})
end

function update_particles()
	for p in all(particles) do
		p.x+=p.vx
		p.y+=p.vy
		p.life-=1
		if p.life==0 then
			del(particles,p)
		end
	end
end

function draw_particles()
	for p in all(particles) do
		spr(p.id,p.x,p.y)
	end
end
