pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--init

function _init()

 prefs()

	actors = {}

	camy = 0
	camspd = 1/60
	
	dt = 1 / 60
	
	hterm = 100
	accel = 800

	tempx=0
	tempy=0
	temph=0
	tempw=0
	
	pause = false
	flappy = false
	flippy = false
	suprise = false
	title = true
	levelselect = false
	trophy = false
	
	timestart = 0
	
	key_right = false
	key_left = true
	
	music(4)
	
end

function prefs()

  boundingbox = false
  jumppower = 120 //300
  gravity = 300
  level = 1
  
end
-->8
--update and draw

function _update60()
 
 timestart += dt
 
 if (title) then
  if(btnp(—)) then
  	title = false
  	levelselect = false
  	spawn()
 	elseif(btnp(Ž)) then
  	levelselect = true
 	end
 	
 	if(btnp(”) and levelselect) then
 	 level += 1
 	 if(level >= 5) then
 	  level = 1
 	 end
 	 sfx(1)
 	end
 	
 	if(btnp(ƒ) and levelselect) then
 	 level -= 1
 	 if(level <= 0) then
 	  level = 4
 	 end
 	 sfx(1)
 	end
 	
 elseif(pause) then
  if(btn(—)) then
   restart()
  end
 elseif(not trophy) then
 	for e in all(actors) do
  	physics(e)
  end
  
  if(btn(‘)) then
  	key_right = true
  else
   key_right = false
  end
  
  if(btn(‹)) then
  	key_left = true
  else
  	key_left = false
  end
  
  if(flappy) then
   if(btnp(”)) then
   	player.vspd = -jumppower
   	sfx(1)
   end
  elseif (flippy) then  
  	if(btnp(”) and (onground(player) or collision(player,0,-1))) then
   	gravity *= -1
   	sfx(1)
   end
  else
   if(btn(”) and onground(player)) then
   	player.vspd = -jumppower
   	sfx(1)
   end
  end
  
  
  if(player.x > 1230 and flappy == false and flippy == false and level <= 2) then
   flappy = true
   gravity = 300
 	 jumppower = 100
 	 player.spr = 49
   sfx(2)
   level = 2
  end
  
  if(player.x > 2150 and flappy == true and flippy == false and level <= 3) then
   flappy = false
   flippy = true
   gravity = -500
 	 jumppower = 150
 	 player.spr = 50
   sfx(2)
   level = 3
  end
  
  checkdeath()
  
  if(flappy) then
   if(camx < 1200) then
    player.hspd = 0
   else
 	 	player.x = camx + 30.5
 	 end
 	 camx += 0.5
  elseif(flippy) then
   if(player.x < 2960) then
    if(player.x > 2200) then
   		camx += 0.7
   	end
   elseif(player.x < 4000) then
    camx += 1.55
    if(player.x < 3000) then
     player.spr = 50
     level = 4
    end
   else
    camx += 0
   end
  else
   local d = player.x - camx
   local ch = (1/120)*timestart + 0.2
   camx += ch
   if(d > 70) then
    camx += (ch/400)*(d-70)*(d-70)
   end
  end
 
 
 if(camx > 3940 and not(suprise)) then
  for k=0,3 do
   mset(117,54+k,37)
   sfx(3)
  end
 end
 if(camx > 3950 and not(suprise)) then
  for k=0,3 do
   mset(118,54+k,38)
   sfx(3)
  end
 end
 if(camx > 3960 and not(suprise)) then
  for k=0,3 do
   mset(119,54+k,39)
   sfx(3)
  end
  suprise = true
 end
 
 if(player.x > 4055 and player.y < 4072) then
  if(player.y > 55 and player.y < 72 and trophy == false) then
   trophy = true
   sfx(5)
  end
 end
 
 end

end

function _draw()
 
 if(title) then
  cls()
  for k=0,127 do
	  for g=0,127 do
    pset(k,g,rnd(4))
	  end
	 end
	 spr(82,40,40,6,2)
	 if(levelselect) then
 	 print("”",60,70,7)
 	 print(level,62,80,7)
 	 print("ƒ",60,90,7)
	 end
	 print("press — to start",30,110,7)
	
 else
  cls()
  camera(camx,camy)
  map(0,0,0,0,128,16)
  map(0,16,1024,0,128,16)
  map(0,32,2048,0,128,16)
  map(0,48,3072,0,128,16)
  updatespr()
 	for e in all(actors) do
 	 spr(e.spr,e.x,e.y,e.g,e.l,e.hflip,e.vflip)
 	end
 	if(not(trophy)) then
 	 spr(14,4055,55,2,2)
 	end
 	
 	firewall()
 	
 	debug()
 end

end

function debug()
	
	if(boundingbox) then
		rect(tempx,tempy,tempw,temph)
	end
	
	//print("camerax: " ..camx ,10+camx,10,7)
	//print("player x: " ..player.x ,10+camx,20,7)
	
	if(pause) then
	 print("press — to continue",camx+30,120,7)
	end
	
	if(trophy) then
	 print("congrats!",player.x-10,player.y-10,7)
	end
	
end
-->8
--functions

function makeactor(s,x,y)
	a = {}
	a.x = x
	a.y = y
	a.spr = s
	a.w = 8
	a.h = 8
	a.g = 1
	a.l = 1
	
	a.vspd = 0
	a.hspd = 0
	
	a.hflip = false
	a.vflip = true
	
	add(actors,a)
	
	return a
end

function firewall()
 local x = time()
 if(x - flr(x) < 0.33) then
  for k=0,16 do
   spr(8,camx,k*8)
  end
 elseif(x - flr(x) < 0.66) then
  for k=0,16 do
   spr(9,camx,k*8)
  end
 else
  for k=0,16 do
   spr(10,camx,k*8)
  end
 end
end

function checkdeath()
	
	if(player.x <= camx) then
	 player.spr = 32
	 sfx(0)
	 pause = true
	end

end

function restart()

  local v = level
 	_init()
 	level = v
 	title = false
 	spawn()

end

function spawn()
 
 
	if(level == 1) then
	 camx = 0
	elseif(level == 2) then
	 camx = 1100 
	elseif(level == 3) then
	 camx = 2080
	 flappy = true
	 flippy = false
	elseif(level == 4) then
	 camx = 2900
	 flippy = true
	 gravity = 500
 	jumppower = 150
	else
	 camx = 0
	end
	
	
	player = makeactor(48,camx+40,55)
	player.h = 5
	player.w = 5
	player.g = 1
	player.l = 1
	player.hspd = 0
	
end

function updatespr()
 
 if(pause) then
  player.spr = 32
 else
 if(flappy) then
  if(abs(player.vspd) < 70) then
   player.spr = 51
  elseif(player.vspd < 0) then
   player.spr = 53
  else
   player.spr = 52
  end
  player.vflip = false
  player.hflip = false
 elseif(flippy) then
  if(abs(player.hspd) < 0.30) then
   player.spr = 54
   player.hflip = false
  else
   local k = time()%0.8
   if(k < 0.4) then
    player.spr = 55
   else
    player.spr = 56
   end
   if(player.hspd > 0) then
    player.hflip = false
   else
    player.hflip = true
   end
  end
  if(gravity < 0) then
  	player.vflip = true
  else
   player.vflip = false
  end
 else
  if(abs(player.hspd) < 0.3) then
   player.spr = 48
   player.hflip = false
  else
   local k = time()%0.8
   if(k < 0.4) then
    player.spr = 49
   else
    player.spr = 50
   end
   if(player.hspd > 0) then
    player.hflip = false
   else
    player.hflip = true
   end
  end
  player.vflip = false
 end
 end

end
-->8
--physics

function physics(e)
 local vspd = e.vspd
 local hspd = e.hspd
 
 if(not(flippy)) then
 	if(vspd <= 500 and not(onground(e))) then
  	vspd += gravity * dt
 	end
 else
  if(vspd <= 500) then
  	vspd += gravity * dt
 	end
 end
 
 if(not(flappy)) then
  if(key_right) then
   hspd += accel * dt
   if(hspd >= hterm) then
    hspd = hterm
   end
  elseif(key_left) then
   hspd += -accel * dt
   if(hspd <= -hterm) then
    hspd = -hterm
   end
  else
   hspd *= 0.80
  end
 end
 
 
 local dy = vspd * dt
 local dx = hspd * dt
  
	if(collision(e,0,dy)) then
	 vspd = 0
	else
	 e.y += dy
	end
	
	if(collision(e,dx,0)) then
	 hspd = 0
	else
	 e.x += dx
	end
	
	e.vspd = vspd
	e.hspd = hspd
 
end

//returns true if movement would
//result in a collision
function collision(e,dx,dy)

	local cenx = e.x + ((e.g * 8))/2
 local ceny = e.y + ((e.l * 8))/2
	
	if(solid_area(cenx+dx,ceny+dy,e.w,e.h)) then
		return true
	else
	 return false
	end
end


function onground(e)
 if(collision(e,0,1)) then
  return true
 else
  return false
 end
end

//checks if bounding box overlaps
//a solid object
function solid_area(x,y,w,h)

	local hw = w/2
 local hh = h/2
 
 tempx = x-hw
 tempy = y-hh
 tempw = x+hw
 temph = y+hh
 
 return
 	solid(x-hw,y-hh) or
  solid(x+hw,y-hh) or
  solid(x-hw,y+hh) or
  solid(x+hw,y+hh)
end


//checks if tile is solid
function solid(x,y)
	
 if(player.x < 1020) then
		val = mget((x/8),y/8)
	elseif(player.x < 2044) then
		val = mget(((x-1024)/8),(y+128)/8)
	elseif(player.x < 3068) then
	 val = mget(((x-2048)/8),(y+256)/8)
	else
		val = mget(((x-3072)/8),(y+384)/8)
	end
	
	if (fget(val,2)) then
	 pause = true
	 sfx(0)
	 player.spr = 32
	end
	
	return fget(val,1)
	
end
