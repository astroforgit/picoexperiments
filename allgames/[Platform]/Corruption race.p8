--that one block that crumbles

crumblelist={[86]=87,[87]=88,[88]=89,[89]=102,[102]=103,[103]=104,[104]=105}



--math
--------------------------------

--point to box intersection.
function intersects_point_box(px,py,x,y,w,h)
	if flr(px)>=flr(x) and flr(px)<flr(x+w) and
				flr(py)>=flr(y) and flr(py)<flr(y+h) then
		return true
	else
		return false
	end
end

--box to box intersection
function intersects_box_box(
	x1,y1,
	w1,h1,
	x2,y2,
	w2,h2)

	local xd=x1-x2
	local xs=w1*0.5+w2*0.5
	if abs(xd)>=xs then return false end

	local yd=y1-y2
	local ys=h1*0.5+h2*0.5
	if abs(yd)>=ys then return false end
	
	return true
end

--check if pushing into side tile and resolve.
--requires self.dx,self.x,self.y, and 
--assumes tile flag 0 == solid
--assumes sprite size of 8x8
function collide_side(self)

	local offset=self.w/3
	for i=-((self.w/3)),((self.w/3)),2 do
	--if self.dx>0 then
		if fget(mget((self.x+(offset))/8,(self.y+i)/8),0) then
			self.dx=0
			self.x=(flr(((self.x+(offset))/8))*8)-(offset)
			return true
		end
	--elseif self.dx<0 then
		if fget(mget((self.x-(offset))/8,(self.y+i)/8),0) or self.x<1 then
			self.dx=0
			self.x=(flr((self.x-(offset))/8)*8)+8+(offset)
			return true
		end
--	end
	end
	--didn't hit a solid tile.
	return false
end

--check if pushing into floor tile and resolve.
--requires self.dx,self.x,self.y,self.grounded,self.airtime and 
--assumes tile flag 0 or 1 == solid

function collide_floor(self)
	--only check for ground when falling.
	if self.dy<0 then
		return false
	end
	local landed=false
	--check for collision at multiple points along the bottom
	--of the sprite: left, center, and right.
	for i=-(self.w/3),(self.w/3),2 do
		local tilex,tiley = (self.x+i)/8,(self.y+(self.h/2))/8
		local tile=mget(tilex,tiley)
		if fget(tile,0) or (fget(tile,1) and self.dy>=0) then
			self.dy=0
			self.y=(flr((self.y+(self.h/2))/8)*8)-(self.h/2)
			self.grounded=true
			self.airtime=0
			landed=true
		end
		if fget(tile,4) then
			if not check_x_y_dup(crumblingtiles,flr(tilex),flr(tiley)) then
				local thisone = {x=flr(tilex),y=flr(tiley)}
				add(crumblingtiles,thisone)
				sfx(snd.crumble)
			end
		end
	end
	return landed
end

--check if pushing into roof tile and resolve.
--requires self.dy,self.x,self.y, and 
--assumes tile flag 0 == solid
function collide_roof(self)
	--check for collision at multiple points along the top
	--of the sprite: left, center, and right.
	for i=-(self.w/3),(self.w/3),2 do
		if fget(mget((self.x+i)/8,(self.y-(self.h/2))/8),0) then
			self.dy=0
			self.y=flr((self.y-(self.h/2))/8)*8+8+(self.h/2)
			self.jump_hold_time=0
		end
	end
end

--make 2d vector
function m_vec(x,y)
	local v=
	{
		x=x,
		y=y,
		
  --get the length of the vector
		get_length=function(self)
			return sqrt(self.x^2+self.y^2)
		end,
		
  --get the normal of the vector
		get_norm=function(self)
			local l = self:get_length()
			return m_vec(self.x / l, self.y / l),l;
		end,
	}
	return v
end

--square.
function sqr(a) return a*a end

--round to the nearest whole number.
function round(a) return flr(a+0.5) end


--utils
--------------------------------

--print string with outline.
function printo(str,startx,
															 starty,col,
															 col_bg)
	print(str,startx+1,starty,col_bg)
	print(str,startx-1,starty,col_bg)
	print(str,startx,starty+1,col_bg)
	print(str,startx,starty-1,col_bg)
	print(str,startx+1,starty-1,col_bg)
	print(str,startx-1,starty-1,col_bg)
	print(str,startx-1,starty+1,col_bg)
	print(str,startx+1,starty+1,col_bg)
	print(str,startx,starty,col)
end

--print string centered with 
--outline.
function printc(
	str,x,y,
	col,col_bg,
	special_chars)
	local special_chars = special_chars or 0
	local len=(#str*4)+(special_chars*3)
	local startx=x-(len/2)
	local starty=y-2
	printo(str,startx,starty,col,col_bg)
end

--objects
--------------------------------

--make the player
function m_player(x,y)

	--todo: refactor with m_vec.
	local p=
	{
		x=x,
		y=y,

		dx=0,
		dy=0,

		w=8,
		h=8,
		
		max_dx=1,--max x speed
		max_dy=2,--max y speed

		jump_speed=-1.75,--jump veloclity
		acc=0.05,--acceleration
		dcc=0.8,--decceleration
		air_dcc=0.95,--air decceleration
		grav=0.15,
		
		--helper for more complex
		--button press tracking.
		--todo: generalize button index.
		jump_button=
		{
			update=function(self)
				--start with assumption
				--that not a new press.
				self.is_pressed=false
				if btn(4) or btn(2) then
					if not self.is_down then
						self.is_pressed=true
					end
					self.is_down=true
					self.ticks_down+=1
				else
					self.is_down=false
					self.is_pressed=false
					self.ticks_down=0
				end
			end,
			--state
			is_pressed=false,--pressed this frame
			is_down=false,--currently down
			ticks_down=0,--how long down
		},

		jump_hold_time=0,--how long jump is held
		min_jump_press=5,--min time jump can be held
		max_jump_press=15,--max time jump can be held

		jump_btn_released=true,--can we jump again?
		grounded=false,--on ground

		airtime=0,--time since grounded
		
		--animation definitions.
		--use with set_anim()
		anims=
		{
			["stand"]=
			{
				ticks=1,--how long is each frame shown.
				frames={2},--what frames are shown.
			},
			["walk"]=
			{
				ticks=5,
				frames={3,4,5,6},
			},
			["jump"]=
			{
				ticks=1,
				frames={1},
			},
			["slide"]=
			{
				ticks=1,
				frames={7},
			},
			["crouch"]=
			{
				ticks=1,
				frames={8},
			},
		},

		curanim="walk",--currently playing animation
		curframe=1,--curent frame of animation.
		animtick=0,--ticks until next frame should show.
		flipx=false,--show sprite be flipped.
		
		--request new animation to play.
		set_anim=function(self,anim)
			if(anim==self.curanim)return--early out.
			local a=self.anims[anim]
			self.animtick=a.ticks--ticks count down.
			self.curanim=anim
			self.curframe=1
		end,
		
		--call once per tick.
		update=function(self)
	
			--todo: kill enemies.
			
			--track button presses
			local bl=btn(0) --left
			local br=btn(1) --right
			local bd=btn(3)
			--move left/right
			if bl==true then
				self.dx-=self.acc
				br=false--handle double press
			elseif br==true then
				self.dx+=self.acc
			end
			--also decelerate when reversing
			if (self.dx < 0 and br==true) 
						or (self.dx > 0 and bl==true) 
						or (br==false and bl==false)
						then
				if self.grounded then
					self.dx*=self.dcc
				else
					self.dx*=self.air_dcc
				end
			end

			--limit walk speed
			self.dx=mid(-self.max_dx,self.dx,self.max_dx)
			
			--move in x
			self.x+=self.dx
			
			--hit walls
			collide_side(self)

			--jump buttons
			self.jump_button:update()
			
			--jump is complex.
			--we allow jump if:
			--	on ground
			--	recently on ground
			--	pressed btn right before landing
			--also, jump velocity is
			--not instant. it applies over
			--multiple frames.
			if self.jump_button.is_down then
				--is player on ground recently.
				--allow for jump right after 
				--walking off ledge.
				local on_ground=(self.grounded or self.airtime<5)
				--was btn presses recently?
				--allow for pressing right before
				--hitting ground.
				local new_jump_btn=self.jump_button.ticks_down<10
				--is player continuing a jump
				--or starting a new one?
				if self.jump_hold_time>0 or (on_ground and new_jump_btn) then
					if(self.jump_hold_time==0)sfx(snd.jump)--new jump snd
					self.jump_hold_time+=1
					--keep applying jump velocity
					--until max jump time.
					if self.jump_hold_time<self.max_jump_press then
						self.dy=self.jump_speed--keep going up while held
					end
				end
			else
				self.jump_hold_time=0
			end
			
			--move in y
			self.dy+=self.grav
			if bd then
				self.dy+=self.grav
			end
			self.dy=mid(-self.max_dy,self.dy,self.max_dy)
			self.y+=self.dy

			--floor
			if not collide_floor(self) then
				self:set_anim("jump")
				self.grounded=false
				self.airtime+=1
			end

			--ouchies
			if	check_hurt(self) then
				oof()
			end
			
			--roof
			collide_roof(self)
			
			
			--let's call 100 the safety frames
			if ticks-invultime > 100 and invul then
				invul = false
			end
			--handle playing correct animation when
			--on the ground.
			if self.grounded then
				if br then
					if self.dx<0 then
						--pressing right but still moving left.
						self:set_anim("slide")
					else
						self:set_anim("walk")
					end
				elseif bl then
					if self.dx>0 then
						--pressing left but still moving right.
						self:set_anim("slide")
					else
						self:set_anim("walk")
					end
				elseif bd then
					self:set_anim("crouch")
				else
					self:set_anim("stand")
				end
			end

			--flip
			if br then
				self.flipx=false
			elseif bl then
				self.flipx=true
			end

			--anim tick
			self.animtick-=1
			if self.animtick<=0 then
				self.curframe+=1
				local a=self.anims[self.curanim]
				self.animtick=a.ticks--reset timer
				if self.curframe>#a.frames then
					self.curframe=1--loop
				end
			end
		end,
		--draw the player
		draw=function(self)
			local a=self.anims[self.curanim]
			local frame=a.frames[self.curframe]
			if invul and ticks % 20 < 10 then
			 frame = 016 --flash!
			end
			--new char test
			frame += 16
			spr(frame,
				self.x-(self.w/2),
				self.y-(self.h/2),
				self.w/8,self.h/8,
				self.flipx,
				false)
		end,
	}

	return p
end

--make the camera.
function m_cam(target)
	local c=
	{
		tar=target,--target to follow.
		pos=m_vec(target.x,target.y),
		state=1, --camera state, controls magic tracking
		--minx,miny,maxx,maxy
		states={{64,64,200,64,},
										{64,64,320,64},
										{328,64,320,360},
										{240,200,320,360},
										{328,64,400,360},
										{240,200,820,360}},
		--how far from center of screen target must
		--be before camera starts following.
		--allows for movement in center without camera
		--constantly moving.
		pull_threshold=16,
		--y_pull_threshold=32

		--min and max positions of camera.
		--the edges of the level.
		pos_min=m_vec(64,64),
		pos_max=m_vec(200,64),
		
		shake_remaining=0,
		shake_force=0,

		update=function(self)

			self.shake_remaining=max(0,self.shake_remaining-1)
			
			--follow target outside of
			--pull range.
			if self:pull_max_x()<self.tar.x then
				self.pos.x+=min(self.tar.x-self:pull_max_x(),4)
			end
			if self:pull_min_x()>self.tar.x then
				self.pos.x+=min((self.tar.x-self:pull_min_x()),4)
			end
			if self:pull_max_y()<self.tar.y then
				self.pos.y+=min(self.tar.y-self:pull_max_y(),4)
			end
			if self:pull_min_y()>self.tar.y then
				self.pos.y+=min((self.tar.y-self:pull_min_y()),4)
			end

			--lock to edge
			if(self.pos.x<self.pos_min.x)self.pos.x=self.pos_min.x
			if(self.pos.x>self.pos_max.x)self.pos.x=self.pos_max.x
			if(self.pos.y<self.pos_min.y)self.pos.y=self.pos_min.y
			if(self.pos.y>self.pos_max.y)self.pos.y=self.pos_max.y
		
			--update tracking state
			changed, self.state = self:change_state(self.state)
			local state = self.state
			local states = self.states
			if changed then
				self.pos_min=m_vec(states[state][1],states[state][2])
				self.pos_max=m_vec(states[state][3],states[state][4])
			end
		end,

		cam_pos=function(self)
			--calculate camera shake.
			local shk=m_vec(0,0)
			if self.shake_remaining>0 then
				shk.x=rnd(self.shake_force)-(self.shake_force/2)
				shk.y=rnd(self.shake_force)-(self.shake_force/2)
			end
			return self.pos.x-64+shk.x,self.pos.y-64+shk.y
		end,

		pull_max_x=function(self)
			return self.pos.x+self.pull_threshold
		end,

		pull_min_x=function(self)
			return self.pos.x-self.pull_threshold
		end,

		pull_max_y=function(self)
			return self.pos.y+self.pull_threshold
		end,

		pull_min_y=function(self)
			return self.pos.y-self.pull_threshold
		end,
		
		shake=function(self,ticks,force)
			self.shake_remaining=ticks
			self.shake_force=force
		end,
		
		--extremely sophisticated camera tracking
		change_state=function(self,state)
			if state==1 and p1.y < 0 and p1.x >100 then
				return true, 2 --above the ceiling
			elseif state==2 and (p1.x > 338 or p1.y >100) then
				return true, 3 --to the drop
			elseif state==3 and (p1.x>370) then
				return true, 5 --secret room
			elseif state==5 and p1.x < 320 and p1.y > 200 then
				return true,4 
			elseif state==3 and p1.y >290 then
				return true,4 --scroll back left
			elseif state==4 and p1.y >360 then
				return true,6 --uhhhhhh
			end
			return false, state
		end
	}

	return c
end

--game flow
--------------------------------

--reset the game to its initial
--state. use this instead of
--_init()
function reset()
	began=false
	win=false
	ticks=0
	p1=m_player(64,108)
	p1:set_anim("walk")
	cam=m_cam(p1)
	health = 1 --goes up when damaged
	corruption_level = 0
	invultime = 0
	
	mem_address_otd = rnd(0x1aff)+0x4300
	mem_val_otd = peek(mem_address_otd)
	--sets a random memory address. if it gets corrupted, screen warbles!

	--i'll add a title screen later ok
	crumblingtiles={}
	--heart locations
	hearts={{x=207,y=300}, {x=422,y=30}}
	--update just this once
	cam:update()
	p1:update()
end
--p8 functions
--------------------------------

function _init()
	reset()
end

function _update60()
	
	if not began then
		if btn() != 0 then
			began = true
			music(1)
		end
	else
		ticks+=1
		cam:update()
		p1:update()

		corrupt()
		crumble()
		collect_hearts()
		check_victory()
	end
end

function _draw()

	cls(0)
	
	camera(cam:cam_pos())
	
	map(0,0,0,0,128,128)
	
	p1:draw()
	foreach(hearts,draw_heart)
	
	--hud
	camera(0,0)

	printo(tostr(health),1,1,7,8)
	printo(tostr(corruption_level),110,1,7,8)
	if win then
		draw_victory()
	end
	if not began then
		printo("^                          ^",1,10,7,0)
		printo("|                          |",1,13,7,0)
		printo("corruption speed           |",1,20,7,0)
		printo("              corrupt-o-meter",1,28,7,0)
		printc("press any button to begin",64,64,7,0)
	end
	--makes the screen warble if some arbitrary bit is corrupted
	if peek(mem_address_otd) != mem_val_otd and not win then
		sine_xshift(ticks,10,128,0.5,0,127,false)
	end
end

-->8
-- horizontal distortion effect
-- by qbicfeet
--
-- t: time
-- a: amplitude (in pixels)
-- l: wavelength (in pixels)
-- s: speed
-- y1: first horizontal line
-- y2: last horizontal line
-- mode: interlaced y/n

function sine_xshift(t,a,l,s,y1,y2,mode)
  for y=y1,y2 do
    local off = a * sin((y + flr(t*s + 0.5) + 0.5) / l)

    if mode and y%2 < 1 then off *= -1 end

    local x = flr(off/2 + 0.5) % 64

    local addr = 0x6000+64*y

    memcpy(0x4300,addr,64)
    memcpy(addr+x,0x4300,64-x)
    memcpy(addr,0x4340-x,x)
  end
end  
-->8
--bespoke additions

function oof()
	if not invul then
		sfx(snd.hurt1)
		sfx(snd.hurt2)
		cam:shake(20,4)
		health +=1
		invul = true
		invultime = ticks
		--action at a distance? what's that?
	end
end

function check_hurt(self)
	if invul then
		return false
	end
	for i=-(self.w/3),(self.w/3),2 do
		local tile=mget((self.x+i)/8,(self.y+(self.h/2))/8)
		if fget(tile,2) then
			return true --landing
		end
		if fget(mget((self.x+i)/8,(self.y-(self.h/1.5))/8),3) and self.dy <0 then
			return true --bonking
		end
	end
end

function corrupt()
	local _corruption_level = 0
	if ticks%3 == 0 then --once every 3 frames
		for i=1,health do --once per damage
			if rnd(1)>0.5 then
				poke(rnd(0x8000),rnd(0x100))--random mode
			else
				local rndbit = rnd(0x8000) --tilt
				local incdec = ((ticks%2)*2)-1 --"randomly" choose between -1 and 1
				poke(rndbit,peek(rndbit)+incdec) 
			end
			_corruption_level+=1
			--this is all basically equivalent to the "randomtilt" option in rtc
		end
		corruption_level +=_corruption_level
	end	
end

function crumble()
	if ticks % 9 == 0 then
		local cronch=function(coords)
			local number = mget(coords.x,coords.y)
			if fget(number, 4) then
				local nextblock = crumblelist[number]
				if (not nextblock) and rnd(1)>0.5 then
					nextblock = 86
				elseif (not nextblock) then
					nextblock = flr(rnd(64)+64)
				end
				mset(coords.x,coords.y,nextblock)
			end
		end
		foreach(crumblingtiles,cronch)
	end
end

function check_x_y_dup(table,x,y)
	for value in all(table) do
		if value["x"] == x and value["y"]==y then
			return true
		end
		motd = value["x"]
	end
	return false
end


function draw_heart(heart)
	local off = 5 * sin((flr(ticks + 0.5) + 0.5) / 100)
	spr(009, heart.x, heart.y+off, 2,2)
	motd = off
end

function collect_hearts()
	for heart in all(hearts) do
		if intersects_box_box(
					p1.x,p1.y,
					p1.w,p1.h,
					heart.x+5,heart.y,
					16,16) then
			invul = true
			invultime = ticks+100
			sfx(snd.collect_heart)
			del(hearts,heart)
			health=flr(health/2)
		end
	end
end

function check_victory()
	local x = p1.x
	local y = p1.y
	if win == false and
				x > 760 and 
				x < 799 and 
				y > 260 and 
				y < 296 then
		win = true
		wintime = ticks
		sfx(snd.win)
		health=100
	end
end

function draw_victory()
	local timer_time = ticks-wintime
	if timer_time < 120 then
		printc("you have won!",64,64,7,0)
	else
		printc("game by @twotwos",64,40,7,0)
		if timer_time > 180 then
			printc("from starter kit by @mhughson",64,50,7,0)
		end
		if timer_time > 240 then
			printc("music by @gruber_music",64,60,7,0)
		end
		if timer_time > 300 then
			printc("wave effect by @qbicfeet",64,70,7,0)
		end
		if timer_time > 360 then
			printc("inspired by jelpi and the rtc",64,80,7,0)
		end
		if timer_time > 420 then
			printc("thank you for playing!",64,90,7,0)
		end
	end
end
