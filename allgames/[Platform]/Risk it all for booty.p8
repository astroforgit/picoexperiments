pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
-- risk it all for booty
-- palo blanco games
-- for ld44 jam

-- character

p1={}
p1.x=8
p1.y=32
p1.dx=0
p1.dy=0
p1.ground=false
p1.sprite=1
p1.spritecount=0
p1.framecount=0
p1.flipme=false
p1.plusy=0
p1.plusix=0
p1.dead=false

function p1:update()
	self.dx=0
	if (btn(0)) self.dx = -1
	if (btn(1)) self.dx = 1
	if (btn(4) or btn(2) or btn(5)) and self.ground then
	 self.dy=-2
	 self.ground=false
	 sfx(1)
	end

	self.x+=self.dx
	self.y+=self.dy
	if (not self.ground) self.dy+=0.1
	
	local s1= false
	local s2= false

	if self.dy >=0 then
		s1 = solid(self.x+5,self.y+8)	
	 s2 = solid(self.x+2,self.y+8)
	 if s1 or s2 then
	 	self.dy = 0
	 	self.ground = true
	 	self.y = 8*flr(self.y/8)
	 else
	 	self.ground = false
	 end
	 s1 = springy(self.x+5,self.y+8)	
	 s2 = springy(self.x+2,self.y+8)
	 if s1 or s2 then
	 	self.dy = -3
	 	self.ground = false
	 	sfx(5)
	 end
	end

	if self.dx >=0 then
	 s1 = solid(self.x+6,self.y+2)	
	 s2 = solid(self.x+6,self.y+6)
	 if s1 or s2 then
	 	self.dx = 0
	 	self.x = 8*flr(self.x/8)+1
	 end
	 
	end
	if self.dx <=0 then
		s1 = solid(self.x+1,self.y+2)	
	 s2 = solid(self.x+1,self.y+6)
	 if s1 or s2 then
	 	self.dx = 0
	 	self.x = 8*flr((self.x+4)/8)-1
	 end
	end
		
	if self.dy <=0 then
		s1 = solid(self.x+5,self.y+1)	
	 s2 = solid(self.x+2,self.y+1)
	 if s1 or s2 then
	 	self.dy = 0
	 	self.y = 8*flr((4+self.y)/8)
	 end
	end
	
end


function p1:draw()
	local fx = self.framecount
	fx += 1
	ix = flr(fx/3)%6
	plusy=0
	if ix==2 then
		self.plusy=-1
		self.plusix=-1
	end
	if ix==5 then 
		self.plusy=0
		self.plusix=-2
	end
	if ix==0 then
		self.plusy=0
		self.plusix=0
	end
	if (self.dx==0 or not self.ground) ix,fx,self.plusy,self.plusix=0,0,0,0
	if not self.ground then
		ix = 1
		if (self.dy>0) ix=3
	end
	if (self.dx>0) self.flipme=false
	if (self.dx<0) self.flipme=true
	self.framecount = fx
	palt(0,false)
	palt(7,true)
	spr(1+ix+self.plusix,self.x,
	self.y+self.plusy,1,1,self.flipme)
	palt()
end
-->8
-- init

function _init()
	gold = 0
	win = false
	lose = false
	timer = 0
	deadtimer=0
end
-->8
-- update

function _update60()
	if (not win) and (not lose) then
		timer+=1
		p1:update()
		water:update()
		
		if chest(p1.x+4,p1.y+4) then
			gold += 1
			resetblock(p1.x+4,p1.y+4)
			sfx(0)
		end
		
		if bigchest(p1.x+4,p1.y+4) then
			win = true
			stopsound()
			sfx(4)	
		end
		if p1.y+2 > water.level then
			lose = true
			stopsound()
			sfx(3)	
		end
	else
		deadtimer+=1
		if (deadtimer > 60 and btnp(2)) run()
	end
end
-->8
-- draw

function _draw()
	cls(9)
	camera(min(max(0,p1.x-60),127*8),0)
	palt(7,true)
	palt(0,false)
	map()
	p1:draw()
	camera()
	water:draw()
	if (gold < 3) print("booty plundered: "..gold,1,1,0)
	if (gold >= 3) print("booty plundered: all the booty",1,1,0)
	if lose then
		rectfill(0,38,128,47,0)
		print("your greed was your end!",16,40,7)
	 rectfill(0,121,128,128,1)
	 if (deadtimer > 30) print("press up to play again",20,122,7)
	end
	
	if win then
		rectfill(0,38,128,57,14)
	 print("sale away with riches!",24,40,0)
	 print("time: "..flr(timer/60).." sec",34,49,0)
	 rectfill(0,95,128,110,14)
	 print("thrown together by palo blanco",4,96,0)
	 print("for ld 44 jam",4,102,0)
	 rectfill(0,121,128,128,1)
	 if (deadtimer>30) print("press up to play again",20,122,7)
	end
	
	if timer < 120 then
		print("risk it all for booty",30,30,0)
		print("by pbg, ld44",30,40,0)
	
	end
	
end
-->8
-- convenience

function solid(x,y)
	local xx = flr(x/8)
	local yy = flr(y/8)
	return fget(mget(xx,yy),0)
end

function springy(x,y)
	local xx = flr(x/8)
	local yy = flr(y/8)
	return fget(mget(xx,yy),1)
end

function chest(x,y)
	local xx = flr(x/8)
	local yy = flr(y/8)
	return fget(mget(xx,yy),2)
end

function bigchest(x,y)
	local xx = flr(x/8)
	local yy = flr(y/8)
	return fget(mget(xx,yy),3)
end

function resetblock(x,y)
	local xx = flr(x/8)
	local yy = flr(y/8)
	mset(xx,yy,0)
end

function stopsound()
	for i=0,3,1 do
		sfx(-1,0)
	end
end
-->8
-- water

water={}
water.level=128
water.timer=120

function water:update()
	self.timer =	(self.timer+1)%240
	self.level = 128 - 20*(1+sin(self.timer/240))
	if (self.timer == 124) sfx(2)
end

function water:draw()
	rectfill(0,self.level,128,128,1)
end
