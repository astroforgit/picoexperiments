boss={}
boss.x=128
boss.y=140
boss.vx=0
boss.vy=0
boss.frame=1
boss.tick=0
boss.step=7
--this is the x,y sspr calls
--1st four arguments
boss.sprite={92,48,16,16}
boss.facing="right"
boss.phased=false
boss.dead=false
boss.id="boss"
boss.hp=0
boss.charge=false
boss.attack=false
boss.draw=false
boss.spawn=0
boss.flash=false
boss.size=15

p={}
p.x=128
p.y=140
p.vx=0
p.vy=0
p.jv=6
p.frame=1
p.tick=0
p.step=7
p.sprites={64,64,65,66}
		--run={67,68,69,70}
		--idle={64,65,66}
		--jump={71}
		--dead={71,72,73,74}
p.facing="right"
p.grounded=false
p.fall=false
p.dead=false
p.id="player"
p.lives=3
p.boss_taunt=0
p.size=7

bones={}
bats={}

g={}
g.grv=.375
g.flash=false
g.state="intro"
g.pause=false
g.p_timer=0 --pause timer
g.b_timer=0
g.b_timer_s=true
g.play_dead=false
g.c=7
g.c_timer=0
g.throw=false
g.bonehit=false
g.batpickup=false
g.pjump=false
g.b_spawn=0

camx=64
camy=64

bl=0

--stuff for prototyping
bat_timer=0

function animate(o)
	o.tick=(o.tick+1)%o.step
	if o.tick==0 then
		o.frame=o.frame%#o.sprites+1
	end
end

function _init()
	p.dead=false
	g.state="intro" --intro
	p.boss_taunt=0
	boss.hp=1000
	reset_state(3)
end

function reset_state(lives)
	srand(flr(rnd(100)+1))
	p.lives=lives
	p.sprites={71,71,71,71}
	p.x=128
	p.y=140
	p.vx=0
	p.vy=0
		for v in all(bats) do
			del(bats,v)
		end
		for v in all(bones) do
			del(bones,v)
		end
		
	g.pause=false
	boss.draw=false
	g.b_timer=0
	g.b_timer_s=true
	boss.dead=false
	boss.charge=false
	boss.attack=false
	boss.draw=false
	boss.spawn=360
	boss.flash=false
	p.boss_taunt=0
	g.b_spawn=0
	
	if p.lives<0 then
		g.state="gameover"
	end
end

function _update60()
	if g.state=="intro" then
		g.c_timer+=1
		if g.c_timer>=14 then
			g.c+=2
			g.c_timer=0
			if g.c>7 then
				g.c=5
			end
		end
		if btnp(2) then
			g.state="main"
		end
	end
	
	if g.state=="main" then


	if not g.pause then
	--for the bats and testing
	local side=rnd(flr(99)+1)
	local spawn=0
	if side<=50 then
		spawn=0
	else
		spawn=256
	end
	bat_timer+=1
	if bat_timer>=g.b_spawn then
		g.b_spawn=flr(rnd(60)+1)+60
		bat_timer=0
		
		bat_maker(spawn,flr(rnd(160)+40))
	end
	move_bats()



	--before checking buttons
	--setting vx to 0
	if p.grounded then
		p.vx=0
	end
	p.fall=false
	
	p.sprites={64,64,65,66}
	local xstart=p.x
	
	if (btnp(4) and p.grounded) then
	 p.vy=-p.jv
	 g.pjump=true
	end
	
	if(btn(0) and p.grounded) then
	 p.vx-=1.25
	 p.sprites={67,68,69,70}
	 p.facing="left"
	end
	
	if(btn(1) and p.grounded) then
	 p.vx+=1.25
	 p.sprites={67,68,69,70}
	 p.facing="right"
	end
	
 if btn(3) then
 	p.fall=true
 end
 
 if btnp(5) then
		shoot(p.x,p.y,p.vx)
		g.throw=true
	end
	
	if p.vy>=-2 and not p.grounded then
		p.sprites={71,71,71,71}
	end
	
	p.x+=p.vx
	
	if p.x<0 then p.x=0 end
	if p.x>247 then p.x=247 end
	---------------------------
	--hit side walls
 --
 
 --check for walls in the dir
 --we are moving
 local xoffset=0
 if p.vx>0 then xoffset=7 end
	
	--look for a wall
 
 local h=mget((p.x+xoffset)/8,(p.y+7)/8)
 if fget(h,0) then
 	--they hit a wall so move them
 	--back to the orig position
 	--it should really move them to
 	--the edge of the wall but this
 	--mostly works and is simpler
 	p.x=xstart
 end
	------------
	
	--accum grav
 p.vy+=g.grv
 --set y limit
 if p.vy>=8 then p.vy=8 end
 
 
 p.y+=p.vy
 
 ------------------------------
 --hit floor
 --
 
 --check bottom center of the player
 local v=mget((p.x+4)/8,(p.y+8)/8)
 
 --assume they are floating
 --until we determine otherwise
 p.grounded=false
 
 --only check for floors when
 --moving downward
 if p.vy>0 and not p.fall then
 	--look for a solid tile
 	if fget(v,0) then
 		--place p1 on top of tile
 		p.y = flr(p.y/8)*8
 		--halt velocity
 		p.vy=0
 		--allow jumping again
 		p.grounded=true
 	end
 end
 
 --bat falling to stop on solid
 --map tiles
 for v in all(bats) do
 	if v.stunned then
 		local value=mget((v.x+4)/8,(v.y+8)/8)
 	
 		
 		--look for a solid tile
 			if fget(value,0) then
 				--place p1 on top of tile
 				v.y = flr(v.y/8)*8
 				--halt velocity
 				v.vy=0
 			end
 
 	end
 end
 
 --------funciton-----boss
 ------------------related
 if g.b_timer_s then
 	g.b_timer+=1
 	if g.b_timer>=boss.spawn then
 		place_boss()
 		boss.draw=true
 		g.b_timer_s=false
 		g.b_timer=0
 		boss.spawn=flr(rnd(240)+120)
 		--call up the flash and get
 		--ready for the attack
 		boss.flash=true
 	end
 end
 
 if boss.flash then
 	g.b_timer+=1
 	if g.b_timer>=90 then
 		g.b_timer=0
 		boss.attack=true
 		boss.flash=false
 	end
 end
 
 if boss.attack then
 	g.b_timer+=1
 	if g.b_timer>=120 then
 		g.b_timer=0
 		g.b_timer_s=true
 		boss.draw=false
 		boss.x=-100
 		boss.y=-100
 		boss.attack=false
 	else	
 		if boss.facing=="right" then
 	 	boss.vx=2
 		else
 	 	boss.vx=-2
 		end
 	end
 	
 	move_boss()
 end
 --[[-----------------------
 if p.boss_taunt==10 then
 	--boss.charge=true
 	
 	--find start point
 	local x=either_or(32,204)
 	local y=either_or(94,either_or(158,126))--158
 	boss.x=x
 	boss.y=y
 	if boss.x>p.x then
 		boss.facing="left"
 	else
 		boss.facing="right"
 	end
 	boss.draw=true
 end
 
 if p.boss_taunt>10 then
 	boss.draw=true
 	if boss.facing=="right" then
 	 boss.vx=2
 	else
 	 boss.vx=-2
 	end
 	
 	move_boss(vx)
 end
 ]]---------------------------
 
 
 ---where camera used to be
 
 --[[if p.y<=64 then
 	camera(p.x-camx,0)
 end]]--
	
	--move bones
	move_bones()
	
	
	-----------collisions-------
	---------------------------
	collision_check(p.x,p.y,p.size,p.id,bats)
	if #bones>0 then
	 for v in all(bones) do
	 	collision_check(v.x,v.y,v.size,v.id,bats)
		end
	end
	
	if boss.attack then
		collision_check(boss.x,boss.y,boss.size,boss.id,bats)
		collision_check(boss.x,boss.y,boss.size,boss.id,bones)
		collision_check_bp(p.x,p.y,7,boss.x+4,boss.y+4,7)
	end
	
		if p.y>=256 then
			g.pause=true
			sfx(-1)
			g.play_dead=true
			p.lives-=1
			p.sprites={71,72,73,74}
			sfx(1)
		end
	
	
	
	--boss controls and checks
	if boss.hp>=1000 then
		boss.hp=1000
	end
	if boss.hp<=0 then
		g.state="gameover"
		boss.dead=true
	end
	
	----sounds
	if g.throw then
		sfx(4)
		g.throw=false
	end
	
	if g.bonehit then
		sfx(0)
		g.bonehit=false
	end
	
	if g.batpickup then
		sfx(5)
		g.batpickup=false
	end
	
	if g.pjump then
		sfx(6)
		g.pjump=false
	end
	
	else
		g.p_timer+=1

		if g.play_dead then
			sfx(3)
		end
		g.play_dead=false
		if g.p_timer>90 then
			reset_state(p.lives)
			g.p_timer=0
			g.pause=false
		end
	end---end of if not g.pause
	animate(p)
	
	
	
	
	
	end
	
	if g.state=="gameover" then
		sfx(-1)
		g.c_timer+=1
		if g.c_timer>=14 then
			g.c+=2
			g.c_timer=0
			if g.c>7 then
				g.c=5
			end
		end
		if btnp(2) then
			_init()
		end
	end
end

function _draw()
	if g.state=="intro" then
		cls()
		--camera(0,0)
		rectfill(0,0,255,255,0)
		print("..it had to be bats..",23,15,7)
		print("a game by bitb",36,23,5)
		print("@beetleinthebox",34,30,5)
		print("press up to start",30,43,g.c)
		print("gather stunned bats to do",18,62,7)
		print(" more damage to vlad pitt",18,70,7)
		print("z to jump",18,91,7)
		print("x to throw bone",18,98,7)
		print("left/right arrows to move",18,105,7)
		print("down arrow to jump down",18,112,7)
		sspr(0,32,8,8,106,28,16,16,-1)
		sspr(64,40,8,8,13,22,16,16,-1)
		sspr(48,40,8,8,5,7,16,16,-1)
		sspr(72,40,8,8,1,60,16,16,-1)
		sspr(56,32,8,8,90,84,16,16,-1)
	end

	if g.state=="main" then
	cls()
	map(0,0,0,0,64,32)
	
	--camera
 if p.x>=64 and p.x<=191 then
 	camera(p.x-camx,p.y-camy)
 elseif p.x<64 then
  camera(0,p.y-camy)
 elseif p.x>191 then
 	camera(128,p.y-camy)
 end
	
	--sspr(112,40,16,24,camx+(p.x/16),-32,64,96)
	
	--draw player
	--rect(p.x,p.y,p.x+7,p.y+7,15)
	if p.facing=="right" then
		spr(p.sprites[p.frame],p.x,p.y)
	else
	 spr(p.sprites[p.frame],p.x,p.y,1,1,-1)
	end
	
	--draw boss-------------------
	-----------------------------
	-----------------------------
	
	--draw bone(s)
	palt(0,false)
	draw_bones()
	draw_bats()
	if boss.draw then
		boss_draw(boss.x,boss.y)
	end
	palt(0,true)
	
	--print(stat(1),camx+p.x-123,camy+p.y-123,7)

	
	

	--draw player
	--rect(p.x,p.y,p.x+7,p.y+7,15)
	if p.facing=="right" then
		spr(p.sprites[p.frame],p.x,p.y)
	else
	 spr(p.sprites[p.frame],p.x,p.y,1,1,-1)
	end
	

	--rect(p.x-camx,p.y-camy,p.x-camx+127,p.y-camy+127,11)

	--graves in front
	--[[
	palt(12,true)
	palt(0,false)
	sspr(8,0,8,8,68-camx,272+camy-p.y,64,64)
	sspr(8,0,8,8,252-camx,272+camy-p.y,64,64,-1)
	palt(0,true)
	]]--
	
	
	--ui
	--make the ui a function call
	draw_ui(p.x,p.y,p.lives)
	
	
	--collisionflash
	collision_flash()
	
	--sspr(92,48,16,16,p.x,p.y)
	--debug
	--print(g.b_timer,p.x,p.y,8)
	--print(boss.attack,p.x,p.y+8,8)
	--rectfill(boss.x+4,boss.y+4,boss.x+12,boss.y+12,11)
	--print(boss.hp,boss.x,boss.y,11)
	
	end
	
	
	if g.state=="gameover" then
		cls()
		camera(0,0)
		rectfill(0,0,127,127,0)
		if boss.dead then
			sspr(0,48,24,16,28,24,48,32)
			sspr(24,48,16,16,28,56,32,32)
			sspr(16,56,8,8,60,56,16,16,-1,-1)
			sspr(16,48,8,8,60,68,16,16,-1,-1)
			sspr(112,48,16,16,72,60,32,32)
			sspr(56,32,8,8,86,37,16,16,-1)
			print("press up to restart",27,104,g.c)
		else
			sspr(0,48,24,16,38,8,48,32)
			sspr(40,48,8,16,33,40,16,32)
			sspr(8,48,8,16,49,40,16,32)
			sspr(48,48,16,16,64,40,32,32)
			draw_ui(0,63,p.lives)
			print("press up to restart",27,92,g.c)
		end
	end
end

function shoot(x,y,vx)
--check to see if the shot count
--is 3 or less before allowing
--the shot
 if #bones<99 then
 	b={}
 	b.x=x
 	b.y=y
 	b.vx=(vx*.8)*2
 	b.vy=0
 	b.g=-.25
 	b.jv=4
 	b.frame=flr(rnd(3)+1)
 	b.sprites={80,81,82,83}
 	b.tick=0
 	b.step=flr(rnd(3)+3)
 	b.id="bone"
 	b.timer=0
 	b.size=7
 	
 	b.vy-=b.jv
 	
 	add(bones,b)
 end
 
end

function move_bones()
	if #bones>=1 then
		for v in all(bones) do
		 v.x+=v.vx
		 v.vy-=v.g
			v.y+=v.vy
			--timer action
			v.timer+=1
			if v.timer>=60 then
				del(bones,v)
			end
		end
	end
end

function draw_bones()
	if #bones>=1 then
	 for v in all(bones) do
	 	v.tick=(v.tick+1)%v.step
			if v.tick==0 then
				v.frame=v.frame%#v.sprites+1
			end
	 	spr(v.sprites[v.frame],v.x,v.y)
	 end
	end
end

function draw_bats()
 if #bats>=1 then
	 for v in all(bats) do
	 
	 	
	 
	 	v.tick=(v.tick+1)%v.step
			if v.tick==0 then
				v.frame=v.frame%#v.sprites+1
			end
			if v.fly==1 then
	 		spr(v.sprites[v.frame],v.x,v.y)
	 	else
	 		spr(v.sprites[v.frame],v.x,v.y,1,1,-1)
	 	end--rect(v.x,v.y,v.x+7,v.y+7,11)
	 
	 	if v.stunned then
	 		v.flash+=1
	 		if v.flash>10 and v.flash<15 then
					pal(0,false)
					spr(90,v.x,v.y)
					pal(0,true)
					v.fly=1
				end
				if v.flash>=15 then
					v.flash=0
				end
			end
			
	 end
	end
end

function move_bats(o)
	
	for v in all(bats) do
		local x = v.flap_x
		--local speed = v.flap_s
		local f = sin(x+v.flap/100)*2
		--v.flap_s+=1
		if v.flap_x>=12 then v.flap_x=1 end
		if not v.stunned then
			v.flap+=2
			if v.flap>=360 then
				v.flap=0
			end
			if v.fly==1 then
				v.vx=-((rnd(1))+.25)
			else
				v.vx=((rnd(1))+.25)
			end
			v.x+=v.vx
			v.y+=f
		else
			v.vx=0
			v.vy=3
			v.x+=v.vx
			v.y+=v.vy
		end
	end
end

function bat_maker(x,y)
	local bat={}
	
	bat={
		 x=x,
		 y=y,
		 vx=0,
		 vy=0,
		 frame=1,
		 tick=1,
		 step=4,
		 sprites={84,85,86,87,88},
		 fly=0,
		 stunned=false,
		 sin_timer=0,
		 flap=0,
		 flap_x=64,
		 flap_s=1,
		 flash=0
	}
	if p.x<x then
		bat.fly=1
	else
		bat.fly=2
	end
	add(bats,bat)
end

function draw_ui(x,y,lives)
 left=x-60
 right=x+59
 top=y+52
 bottom=y+61
 if x<=64 then
 	left=4
 	right=124
 end
 if x>=192 then
 	right=252
 	left=131
 end
	rect(left,top,right,bottom,7)
	for i=1,lives do
		spr(6,(left-6)+i*8,top+1)
	end
	--was gun meter/bats
	print("bats: "..p.boss_taunt,left+34,top+2,7)
	print("vlad: "..boss.hp,left+76,top+2,7)
end

function collision_flash()
	if g.flash then
		rectfill(0,0,255,255,7)
		g.flash=false
	end
end

--janky collision from quasi
function collision_check(ax,ay,size,id,b)
			local px=ax
			local py=ay
			local pw=size
			local ph=size
	for v in all(b) do
			
	
			local bbx=v.x
			local bby=v.y
			local bbw=7
			local bbh=7
	
			if (px+size > v.x) and
		 	(px < v.x+7) and
		 	(py < v.y+7) and
		 	(py+size > v.y) then
				--sfx(1)
				if b==bats then
					if id=="bone" then
						if not v.stunned then
							g.flash=true
						end	
					end
					
					--boss picks up bat
					if id=="boss" then
						if v.stunned then
							del(bats,v)
							boss.hp+=50
						end
					end
					
					if id=="player" then
						if not v.stunned then
							g.pause=true
							sfx(-1)
							g.play_dead=true
							p.lives-=1
							del(bats,v)
							p.sprites={71,72,73,74}
							sfx(1)
						else
							--the grab the essence
							p.boss_taunt+=5
							g.batpickup=true
							del(bats,v)
						end
					end
					--rectfill(0,0,255,255,7)
					--del(bats,v)
					if id=="bone" then
						if not v.stunned then
							v.sprites={89,89,89,89,89}
							v.vx=0
							v.vy=3
							v.stunned=true
							g.bonehit=true
						end
					end
				end
				
				if b==bones then
					if id=="boss" then
						boss.hp-=50+(2*p.boss_taunt)
						g.flash=true
						sfx(0)
						del(bones,v)
					end
				end
			end
	end
end

function either_or(a,b)
	local coin=flr(rnd(9)+1)
	if coin<=5 then
		return a
	else
	 return b
	end
end

function boss_draw(x,y)
	if boss.flash then
		if (g.b_timer%7==0) then
			if boss.facing=="left" then
			sspr(76,48,16,16,x,y)
		else
			sspr(76,48,16,16,x,y,16,16,1)
		end
		end
	else
		boss.sprite=	{92,48,16,16}
		if boss.facing=="left" then
			sspr(96,48,16,16,x,y)
		else
			sspr(96,48,16,16,x,y,16,16,1)
		end
	end
end

function move_boss()
	boss.x+=boss.vx
end

function place_boss()
	sfx(2)
	local y=either_or(94,either_or(158,126))
	local x=0
		if y==126 then
		 x=either_or(8,232)
		else
		 x=either_or(32,204)
		end
 		boss.x=x
 		boss.y=y
 		if boss.x>p.x then
 			boss.facing="left"
 		else
 			boss.facing="right"
 		end
end

--extra extra janky player and
--boss collision hurriedly 
--placed here
--janky collision from quasi
function collision_check_bp(ax,ay,sizea,bx,by,sizeb)
			if (ax+sizea > bx) and
		 	(ax < bx+sizeb) and
		 	(ay < by+sizeb) and
		 	(ay+sizea > by) then
			
				g.boss_taunt=0
				g.pause=true
				sfx(-1)
				g.play_dead=true
				p.lives-=1
				p.sprites={71,72,73,74}
			end
end
