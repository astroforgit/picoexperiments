pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- lode 8
-- 2016 n.i
-- sprite num
-- 0 1:gld 2:me 3:enm 4:dig 567:di 11:fakeblk(edt) 12:fakeblk 13:extldr(edt) 14:extldr 15:ldr
-- 16:blk 17:con 18:hiddenblk(edt) 19:hiddenblk
-- me r:323334 l:353637 ldr:3839 fal:40/41 dg:42/43 clr:44/45
-- enm r:484950 l:515253 ldr:5455 fal:5657 rcv:585960
-- digblk 64656667 68 69707172
---------- variables
tm=100
t={} tx={} ty={} th={} tl={} tg={} tc={} txx={} tyy={} tsx={} tpri={}
mv={}
--angld={0,0,0,1,2,1}
mysp=2 esp=1 maxlv=8

---------- move
-- me
mv[1]=function(i)
 if mo==2 then c=61+tl[i]
  tl[i]+=1 if tl[i]==3 then t[i]=0 end return end
 ax=sx%8 ay=sy%8 vx=sx/8 vy=sy/8
 -- grab gld
 if ax==0 and ay==0 and mget(vx,vy)==1 then
  mset(vx,vy,0)
  gk=gk-1 sfx(-1) fl=0 sfx(8)
 end
 -- collide with blick
 if mget(vx,vy)==16 or (ax>0 and mget(vx+1,vy)==16) then dinit() end
 -- move
 if th[i]>0 then th[i]-=1
 elseif mget(vx,vy+1)<15 and (ax==0 or mget(vx+1,vy+1)<15) and chkt(sx,sy+8)==0 and mget(vx,vy)!=15 and (ax==0 or mget(vx+1,vy)!=15) then sy+=mysp if txx[i]==1 then c=40 else c=41 end if fl==0 then sfx(7) fl=1 end
 else if fl==1 then fl=0 sfx(-1) end 
  if btn(4) and (ax>0 or mget(vx-1,vy+1)==16 or (ay>0 and mget(vx-1,vy+2)==16)) and ks==0 then if ax>0 then sx+=txx[i]*mysp elseif ay>0 then sy+=tyy[i]*mysp elseif mget(vx-1,vy+1)==16 and (mget(vx-1,vy)==0 or mget(vx-1,vy)==14 or mget(vx-1,vy)==4) then setdig(vx-1,vy+1) th[i]=3 c=43 end
 elseif btn(5) and (ax>0 or mget(vx+1,vy+1)==16 or (ay>0 and mget(vx-1,vy+2)==16)) and ks==0 then if ax>0 then sx+=txx[i]*mysp elseif ay>0 then sy+=tyy[i]*mysp elseif mget(vx+1,vy+1)==16 and (mget(vx+1,vy)==0 or mget(vx+1,vy)==14 or mget(vx+1,vy)==4) then setdig(vx+1,vy+1) th[i]=3 c=42 end
 elseif btn(3) then if ax>0 then sx+=txx[i]*mysp elseif mget(vx,vy+1)==15 or (mget(vx,vy)==15 and mget(vx,vy+1)<15) then sy+=mysp tyy[i]=1 if c==38 then c=39 sfx(4) else c=38 sfx(5) end end
 elseif btn(2) then if ax>0 then sx+=txx[i]*mysp elseif (mget(vx,vy)==15 and (sy<=0 or mget(vx,vy-1)<16)) or (ay>0 and mget(vx,vy+1)==15) then sy-=mysp tyy[i]=-1 if c==38 then c=39 sfx(4) else c=38 sfx(5) end end
 elseif btn(0) then if ay>0 then sy+=tyy[i]*mysp elseif ax>0 or mget(vx-1,vy)<16 then sx-=mysp txx[i]=-1 if c==36 then c=37 sfx(2) else c=36 sfx(3) end end
 elseif btn(1) then if ay>0 then sy+=tyy[i]*mysp elseif ax>0 or mget(vx+1,vy)<16 then sx+=mysp txx[i]=1 if c==33 then c=34 sfx(2) else c=33 sfx(3) end end
 elseif c==33 or c==34 or c==40 then c=32
 elseif c==36 or c==37 or c==41 then c=35
 end end
 if sy==-8 and gk==0 then mo=3 t[i]=0 music(-1) sfx(10) end
end

-- dig
mv[2]=function(i)
 if mo!=1 then return end
 if th[i]<5 then c=th[i]+20 end
 th[i]=th[i]+1
 if th[i]>100 then c=th[i]-100+24 end
 if th[i]==105 then t[i]=0 mset(sx/8,sy/8,16) end
end

-- enm
mv[3]=function(i)
 if mo!=1 then return end
 ax=sx%8 ay=sy%8 vx=sx/8 vy=sy/8 eiskip1=0
 -- recovr
 if th[i]>0 then 
  th[i]+=1 if th[i]>80 then sy=0 c=th[i]-81+58 end
  if th[i]==83 then th[i]=0 tl[i]=0 end
  return
 end
 -- grab gld
 if ax==0 and ay==0 and mget(vx,vy)==1 and tg[i]==0 then
  mset(vx,vy,0) tg[i]=1 end 
 -- collide with brick
 if mget(vx,vy)==16 or (ax>0 and mget(vx+1,vy)==16) or (ay>3 and mget(vx,vy+1)==16) or (ax>0 and ay>3 and mget(vx+1,vy+1)==16)then th[i]=1 sx=tsx[i] sy=-8 
  if tg[i]==1 then tg[i]=0 gk-=1 end --lose gld
  return end
 -- move
 if sx>tx[myi] then vx2=vx-1 elseif sx<tx[myi] then vx2=vx+1 else vx2=-1 end
 if tl[i]>0 then tl[i]+=1 if tl[i]>50 then sy-=esp if c==54 then c=55 else c=54 end if sy%8==0 then 
  if sx>tx[myi] then txx[i]=-1 elseif sx<tx[myi] then txx[i]=1 end
  eiskip1=1 tl[i]=0 end end -- climbup from blick
 elseif mget(vx,vy+1)<15 and (ax==0 or (mget(vx+1,vy+1)<15 and mget(vx+1,vy+1)!=4)) and chkt(sx,sy+8)==0 and mget(vx,vy)!=15 and (ax==0 or mget(vx+1,vy)!=15) then sy+=esp if txx[i]==1 then c=56 else c=57 end
  if ax==0 and sy%8==0 and mget(vx,vy+1)==4 and tl[i]==0 then 
  -- drop gld
  if tg[i]==1 and mget(vx,vy)==0 and sy>0 then mset(vx,vy,1) tg[i]=0 end
  tl[i]=1 end
 elseif tyy[i]==-1 then if ay>0 or (sy>0 and mget(vx,vy)==15 and mget(vx,vy-1)<16 and (sy!=ty[myi] or mget(vx2,vy)>15 or vx2==-1)) then sy-=esp if c==54 then c=55 else c=54 end else tyy[i]=0 if tx[myi]>sx then txx[i]=1 elseif tx[myi]<sx then txx[i]=-1 end eiskip1=1 end
 elseif tyy[i]==1 then if mget(vx,vy+1)<16 and (sy!=ty[myi] or mget(vx2,vy)>15 or vx2==-1) then sy+=esp if c==54 then c=55 else c=54 end else tyy[i]=0 if tx[myi]>sx then txx[i]=1 elseif tx[myi]<sx then txx[i]=-1 end eiskip1=1 end
 else
  if ax==0 and mget(vx,vy)==15 and mget(vx,vy-1)<16 and ty[myi]<sy then tyy[i]=-1 sy-=esp c=54
  elseif ax==0 and mget(vx,vy+1)==15 and ty[myi]>sy then tyy[i]=1 sy+=esp c=55
  else eiskip1=1 end
 end
 if eiskip1==1 then
  if ax==0 and mget(vx+txx[i],vy)>15 then txx[i]=-txx[i]
   if mget(vx+txx[i],vy)>15 then 
    if c==49 or c==50 or c==56 then c=48 elseif c==52 or c==53 or c==57 then c=51 end
   end
  else sx+=txx[i]*esp 
   if txx[i]==1 then if c==49 then c=50 else c=49 end elseif c==52 then c=53 else c=52 end
   end
 end
 -- collide with me
 if mo==1 and abs(sx-tx[myi])<7 and abs(sy-ty[myi])<7 then dmg+=2 if dmg>2 then dinit() end end
end

-- cl
mv[4]=function(i)
 c=44+flr(th[i]/8)
 th[i]+=1 if th[i]==16 then th[i]=0 end
end

-- gld
--mv[5]=function(i)
-- th[i]+=1 if th[i]==18 then th[i]=0 end
-- c=5+angld[flr(th[i]/3)+1]
--end

---------- gfunc
function setdig(x,y)
 mset(x,y,4)
 sett(x*8,y*8,20,2,11)
 sfx(6)
end

-- colide with enm
function chkt(x,y)
 local i
 for i=1,tm do
  if t[i]==3 and abs(x-tx[i])<8 and y==ty[i] then return 1 end
 end
 return 0
end

---------- init
function _init()
 if cartdata("ni_lode8") then mlv=dget(0) else mlv=1 dset(0,1) end
 lv=mlv
 menuitem(2,"retry",function() ginit() end)
-- menuitem(2,"back to title",tinit());
 tinit() 
end

-- gm
function ginit()
 local i local j
 deleteall()
 gk=0 gky=0 myi=-1
 for i=0,15 do
  for j=0,15 do
   a=mget(((lv-1)%7+1)*16+j,i+flr((lv-1)/7)*16)
   if a==1 then gk+=1 --sett(j*8,i*8,5,5,7)
   elseif a==2 then myi=sett(j*8,i*8,32,1,10) a=0
   elseif a==3 then c=sett(j*8,i*8,48,3,9) txx[c]=-1 a=0
   elseif a==11 then a=12
   elseif a==13 then a=14
   elseif a==12 then a=16
   elseif a==18 then a=19
   elseif a!=15 and a!=16 and a!=17 then a=0
   end
   mset(j,i,a)
  end
 end
 if myi==-1 then myi=sett(8,0,32,1,10) end
 music(0)
 fl=0 dmg=0 mo=1 sta=32 ks=1
end

-- tit
function tinit()
 deleteall()
 mo=0
end

-- 
function dinit()
 mo=2 music(-1) sfx(-1) sfx(11)
end

--
function einit()
 deleteall() 
 sett(60,80,44,4,10)
 mo=4
end

---------- update
function _update()
 local i
 -- btn release
 -- if not btn(0) and not btn(1) then k1=0 end
 if not btn(4) and not btn(5) then ks=0 end

 for i=1,tm do
  if t[i]!=0 then sx=tx[i] sy=ty[i] c=tc[i]
   mv[t[i]](i)
   tx[i]=sx ty[i]=sy tc[i]=c
  end
 end
 -- exit ldr
 if gk==0 and gky<15 then
  if gky==0 then sfx(9) end
  for i=0,15 do
   if mget(i,gky)==14 then mset(i,gky,15) end
  end
  gky+=1
 end
 --
 if mo==1 then
  if dmg>0 then dmg-=1 end
 end
end 

---------- draw
function _draw()
 local i local j
 cls()
 -- map
 if mo==0 then
  map(0,16,0,0,16,16)
 elseif mo==1 or mo==2 or mo==3 then
  map(0,0,0,0,16,16)
 end
 
 -- sprite
 mpri=0
 for i=1,tm do
  if t[i]!=0 and mpri<tpri[i] then mpri=tpri[i] end
 end
 for i=1,mpri do
  for j=1,tm do
   if t[j]!=0 and tpri[j]==i then spr(tc[j],tx[j],ty[j]) end
  end
 end

 -- tit
 if mo==0 then
  if btnp(0) and lv>1 then lv-=1 end
  if btnp(1) and lv<mlv then lv+=1 end
  center("stage "..spcstr(lv,2),69)
  center("2016 n.i",112)
  if btnp(4) or btnp(5) then ginit() end
 -- gm
 elseif mo==1 then
  if sta>0 then sta-=1
   center("stage "..lv,60)
  end
 -- failed
 elseif mo==2 then
  center("failed",60);
  if btnp(4) or btnp(5) then ginit() end
 -- clr
 elseif mo==3 then
  center("clear!",60);
  if btnp(4) or btnp(5) then 
   if lv==maxlv then einit()
   else lv=lv+1 if lv>mlv then mlv=lv dset(0,mlv) end ginit() end
  end
 -- end
 elseif mo==4 then
  center("the end",60)
  if btnp(4) or btnp(5) then tinit() end
 end
end

---------- func
function center(st,y)
 print(st,(32-#st)*2,y,7)
end

function spcstr(v,l)
 local st=" "..v
 return sub(st,#st-l+1)
end

function deleteall()
 local i for i=1,tm do t[i]=0 end
end
--function rand(x) return flr(rnd(x)) end
function sett(x,y,sp,t1,pri)
 local i=1
 while i<tm and t[i]!=0 do i=i+1 end
 if i!=tm then t[i]=t1 tx[i]=x ty[i]=y th[i]=0 tl[i]=0 tg[i]=0 tc[i]=sp txx[i]=0 tyy[i]=0 tsx[i]=x tpri[i]=pri end
 return i
end
