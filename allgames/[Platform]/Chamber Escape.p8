--player

function player_update()
  --physics
  player.dy+=gravity
  player.dx*=friction

  --camera and collide
  
     --flag7:win
  if collide_map(player,"down",7) then
   cam_x+=128
   player.x=8+cam_x
   player.y=anchor 
   level+=1 
   sfx(3)
   explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
    if cam_x==1024 then
     anchor+=128
     player.y=anchor
     cam_x=0
     cam_y+=128
     player.x=8
     explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
    end
  elseif collide_map(player,"up",7) then
   cam_x+=128
   player.x=8+cam_x
   player.y=anchor 
   level+=1 
   sfx(3)
   explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
    if cam_x==1024 then
     anchor+=128
     player.y=anchor
     cam_x=0
     cam_y+=128
     player.x=8
     explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
    end
  elseif collide_map(player,"left",7) then
   cam_x+=128
   player.x=8+cam_x
   player.y=anchor 
   level+=1 
   sfx(3)
   explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
    if cam_x==1024 then
     anchor+=128
     player.y=anchor
     cam_x=0
     cam_y+=128
     player.x=8
     explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
    end
  elseif collide_map(player,"right",7) then
   cam_x+=128
   player.x=8+cam_x
   player.y=anchor 
   level+=1 
   sfx(3)
   explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
    if cam_x==1024 then
     anchor+=128
     player.y=anchor
     cam_x=0
     cam_y+=128
     player.x=8
     explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
    end
     --flag2:spikes
  elseif collide_map(player,"down",2) then
   explode(player.x+4,player.y+4,explode_size+6,explode_colors2,explode_amount+5)
   player.x=8+cam_x
   player.y=anchor
   player.deaths+=1
   sfx(4)
   explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
  elseif collide_map(player,"up",2) then
   explode(player.x+4,player.y+4,explode_size+6,explode_colors2,explode_amount+5)
   player.x=8+cam_x
   player.y=anchor
   player.deaths+=1
   sfx(4)
   explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
  elseif collide_map(player,"left",2) then
   explode(player.x,player.y+4,explode_size+6,explode_colors2,explode_amount+5)
   player.x=8+cam_x
   player.y=anchor
   player.deaths+=1
   sfx(4)
   explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
  elseif collide_map(player,"right",2) then
   explode(player.x+8,player.y+4,explode_size+6,explode_colors2,explode_amount+5)
   player.x=8+cam_x
   player.y=anchor
   player.deaths+=1
   sfx(4)
   explode(player.x+4,player.y+6,explode_size+6,explode_colors,explode_amount)
     --flag3:springs
  elseif collide_map(player,"down",3) then
			player.dy=player.max_dy
			player.dy-=player.boost+4 
			player.jumping=true
			player.landed=false
			sfx(1)
			explode(player.x+4,player.y+6,explode_size,explode_colors,explode_amount)
			  --flag4:sitcky floor
		elseif collide_map(player,"down",4) then
		  friction=0.001
		  player.max_dx=0.2
		  player.boost=1.2
		  	--flag5:ice floor
		elseif collide_map(player,"down",5) then
		  friction=0.99
		  player.max_dx=1.2
		  player.acc=1
		else
		 --standard movement
		  friction=0.425
		  player.max_dx=2
		  player.acc=0.5
		  player.boost=1.8
		  gravity=0.1
  end

  --controls
  if btn(‹) then
    player.dx-=player.acc
    player.running=true
    player.flp=true
  end
  if btn(‘) then
    player.dx+=player.acc
    player.running=true
    player.flp=false
  end

  --slide
  if player.running
  and not btn(‹)
  and not btn(‘)
  and not player.falling
  and not player.jumping then
    player.running=false
    player.sliding=true
  end

  --jump
  if btnp(—)
  and player.landed then
    player.dy-=player.boost
    player.landed=false
    player.jumps+=1
    sfx(0)
   --jump effects
    explode(player.x+4,player.y+6,explode_size,explode_colors,explode_amount)
  end
  
  --look up
  if btn(”)
  and not player.running
  and not player.sliding then
    player.sp=11
     if time()-player.anim>.05 then
      player.anim=time()
     end
  end
  
  --look down
  if btn(ƒ)
  and not player.running
  and not player.sliding then
    player.sp=12
    if time()-player.anim>.05 then
      player.anim=time()
    end
  end

  --check collision up and down
  if player.dy>0 then
    player.falling=true
    player.landed=false
    player.jumping=false

    player.dy=limit_speed(player.dy,player.max_dy)

    if collide_map(player,"down",0) then
      player.landed=true
      player.falling=false
      player.dy=0
      player.y-=((player.y+player.h+1)%8)-1
    end
  elseif player.dy<0 then
    player.jumping=true
    if collide_map(player,"up",1) then
      player.dy=0
      sfx(2)
      explode(player.x+4,player.y,explode_size-1,explode_colors,explode_amount-3)
    end
  end

  --check collision left and right
  if player.dx<0 then

    player.dx=limit_speed(player.dx,player.max_dx)

    if collide_map(player,"left",1) then
      player.dx=0
    end
  elseif player.dx>0 then

    player.dx=limit_speed(player.dx,player.max_dx)

    if collide_map(player,"right",1) then
      player.dx=0
    end
  end

  --stop sliding
  if player.sliding then
    if abs(player.dx)<.2
    or player.running then
      player.dx=0
      player.sliding=false
    end
  end

  player.x+=player.dx
  player.y+=player.dy

  --limit player to map
  if player.x<map_start then
    player.x=map_start
  end
  if player.x>map_end-player.w then
    player.x=map_end-player.w
  end
end

function player_animate()
  if player.jumping then
    player.sp=8
  elseif player.falling then
    player.sp=9
  elseif player.sliding then
    player.sp=10
  elseif player.running then
    if time()-player.anim>.05 then
      player.anim=time()
      player.sp+=1
      if player.sp>5 then
        player.sp=1
      end
    end
  else --player idle
    if time()-player.anim>.1 then
      player.anim=time()
      player.sp+=1
      if player.sp>7 then
        player.sp=2
      end
    end
  end
end

function draw_win()
  if milliseconds>=15 and milliseconds<30 then
   pal(7,8)
   pal(8,9)
   pal(9,10)
   pal(10,7)
  elseif milliseconds>=30 and milliseconds<45 then
   pal(7,9)
   pal(8,10)
   pal(9,7)
   pal(10,8)
  elseif milliseconds>=45 and milliseconds<60 then
   pal(7,10)
   pal(8,7)
   pal(9,8)
   pal(10,9)
  end
  
 --animate all 32 win portals
  --levels 1-8
  spr(127,112,24)
  spr(127,240,16)
  spr(127,376,32)
  spr(127,504,112)
  spr(127,520,32)
  spr(127,680,112)
  spr(127,888,32)
  spr(127,920,96)
  --levels 9-16
  spr(127,112,240)
  spr(127,136,160)
  spr(127,368,136)
  spr(127,408,144)
  spr(127,624,136)
  spr(127,640,192)
  spr(127,776,152)
  spr(127,1008,136)
  --levels 17-24
  spr(127,8,272)
  spr(127,152,272)
  spr(127,264,256)
  spr(127,456,368)
  spr(127,624,272)
  spr(127,760,288)
  spr(127,888,288)
  spr(127,1008,288)
  pal()
  
 --retain palette change in menu
--  poke(0x5f2e,1)
  
 --change colour palette
  pal({1,2,3,4,5,skincolour,7,8,9,10,11,12,13,14,haircolour,0},1)
  
end

function limit_speed(num,maximum)
  return mid(-maximum,num,maximum)
end

