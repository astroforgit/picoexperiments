--update and draw

function init_game()

function _update60()
  player_update()
  player_animate()
  updateplaytime()
  update_fx()
  
 --prevent overflow bug
  if player.deaths>=9999 then
   player.deaths=9999
  end
  if player.jumps>=9999 then
   player.jumps=9999
  end

  camera(cam_x,cam_y)
  
end

function _draw()
 if level<9 then
  cls(12)
 elseif level>8 and level<17 then
  cls(0)
 elseif level>16 and level<25 then
  cls(13)
 elseif level==25 then
  cls(2)
  
 end
  map(0,0,0,0,128,64)
  spr(player.sp,player.x,player.y,1,1,player.flp)
  draw_win()
  draw_fx()
  
 --hud
 if sprun==1 then
  printo("“"..hours.."h:"..minutes.."m:"..seconds.."s",camera(cam_x+0),1,10,1)
  printo("                        level:"..level,camera(cam_x+0),1,10,1)
 end
  
  --debug
--  print("cam_x:"..cam_x,camera(cam_x+0),2,14)
