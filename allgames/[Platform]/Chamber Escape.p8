   skincolour=143
 end
 if skincolour==5 then
   skincolour=15
 end
 if skincolour==16 then
   skincolour=128
 end
 if skincolour==129 then
   skincolour=130
 end
 if skincolour==131 then
   skincolour=132
 end
 if skincolour==135 then
   skincolour=141
 end
 if skincolour>=144 then
   skincolour=4
 end
 
 if hairtype<=0 then
  hairtype=32
 end
 if hairtype>=33 then
  hairtype=1
 end
 if skintype<=0 then
  skintype=10
 end
 if skintype>=11 then
  skintype=1
 end
 
--haircolour filter
 if haircolour>=128 then
   --alternate palette
    memset(0x5f7a,0xff,1)
  elseif haircolour<=127 then
   --normal palette
    memset(0x5f7a,0x00,1)
  end
 
--skincolour filter
 if skincolour>=128 then
   --alternate palette
    memset(0x5f78,0xff,1)
  elseif skincolour<=127 then
   --normal palette
    memset(0x5f78,0x00,1)
 end
 pressx()
end

