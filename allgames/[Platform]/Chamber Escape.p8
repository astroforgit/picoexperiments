--cityscape climax

  player={
    sp=1,
    x=8,
    y=112,
    w=8,
    h=8,
    flp=false,
    dx=0,
    dy=0,
    max_dx=2,
    max_dy=3,
    acc=0.5,
    boost=1.8,
    anim=0,
    running=false,
    jumping=false,
    falling=false,
    sliding=false,
    landed=false,
    jumps=0,
    deaths=0,
  }

  gravity=0.1
  friction=0.425

 --player y workaround
  anchor=112
 --level number
  level=1
 --character customizer
  haircolour=132
  skincolour=4
  hairtype=1
  skintype=1

  --simple camera
  cam_x=0
  cam_y=0

  --map limits
  map_start=0
  map_end=1024
  
  --time
  milliseconds=0
  seconds=0
  minutes=0
  hours=0
  sprun=0
  tick=0
  
  --timer
function updateplaytime()
 
 
if level!=25 then
 milliseconds+=1
 
 if milliseconds==60 then
  seconds+=1
  milliseconds=0
  if seconds==60 then
   minutes+=1
   seconds=0
   if minutes==60 then
    hours+=1
    minutes=0
    if hours==10 then
    hours=0
    end
   end
  end
 end
end
end

--restart level
menuitem(1,"restart level",
   function()
   player.x=8+cam_x
   player.y=anchor
   sfx()
   end)

--toggle jump btn in pause menu
menuitem(2,"swap —/Ž",function() —,Ž=Ž,— end)
 function btnr(b)
  return not btn(b) and f_btn[b]
 end
 
 menuitem(3,"hud on/off",
 function()
  speedrun=not speedrun
    if speedrun then
      sprun=1
    else
      sprun=0
    end
  end)

 --print outlined text
function printo(str, x, y, c0, c1)
  for xx = -1, 1 do
    for yy = -1, 1 do
      print(str, x+xx, y+yy, c1)
    end
  end
 print(str,x,y,c0)
end

function move_block(a)
 a.frame=0
 if (a.active_t>0) then
  a.active-=1
  a.frame=1
 end
end

function _init()
 init_menu()
end

