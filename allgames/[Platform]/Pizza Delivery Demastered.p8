--pizza object
function pizza_update()
	if collide_map(player,"tile",6)
	and player.pizza<99
	then
	mset(player.x/8+(levelcounter*16-16),player.y/8,0)
	sfx(3,0)
	player.pizza+=1
	end
end

function thrw_pizza(x,y,flp)
	if player.pizza>0 then
	if not pizthr.draw then
	sfx(2,0)
	pizthr.draw=true
	pizthr.x=x
	pizthr.y=y
	pizthr.flp=flp
	player.pizza-=1
	end
	end
end

function drw_pizza()
	if pizthr.draw then
	spr(pizthr.sp,pizthr.x,pizthr.y)
		if pizthr.flp then
			pizthr.x-=pizthr.speed
		else
			pizthr.x+=pizthr.speed
		end
	end
	if pizthr.x>128 then
	pizthr.x=0
	pizthr.y=0
	pizthr.draw=false
	end

	if pizthr.x<0 then
	pizthr.x=0
	pizthr.y=0
	pizthr.draw=false
	end
end
-->8
--enemy data
function enemy_update()
	if collide_map(player,"left",4)
	or collide_map(player,"right",4)
	then
	sfx(1,0)
	intensity += shake_control
	dustx=player.x
	dusty=player.y-12
	dustsize=5
	dscol=9
	dust=true
	restart_level()
	elseif 
	collide_map(player,"enemy",4) then
	sfx(1,0)
	mset((player.x+player.w/2)/8+(levelcounter*16-16),(player.y+player.h)/8,0)
	dustx=player.x
	dusty=player.y
	dustsize=5
	dscol=9
	dust=true	
	player.dy-=player.boost*2
	player.landed=false
	end
	if 	collide_map(pizthr,"tile",4) then
	sfx(1,0)
	mset(pizthr.x/8+(levelcounter*16-16),pizthr.y/8,0)
	intensity += shake_control
	dustx=pizthr.x-8
	dusty=pizthr.y-4
	dustsize=5
	dscol=10
	dust=true
	end
end

