--player

function player_update()
		if not game_end then
		--physics
		player.dy+=gravity
		player.dx*=friction
		
		--controls
		if btn(‹) then
				player.dx-=player.acc
				player.running=true
				player.flp=true
		end
		if btn(‘) then
				player.dx+=player.acc
				player.running=true
				player.flp=false
		end
		--sign reading and pizza throw
		if btnp(”) then
			if collide_map(player,"any",2) then
			signdrw=true
			else
			thrw_pizza(player.x,player.y,player.flp)
			end
		end		

		--jump
		if btnp(—)
		and player.landed then
				sfx(0,1)
				dustx=player.x
				dusty=player.y
				dustsize=3
				dscol=7
				dust=true
				player.dy-=player.boost
				player.landed=false
		end
		
		--run (added in the cheap way!!)
		if btn(Ž)
		or autorun 
		then
				player.acc=0.9
				player.max_dx=1.85
				player.landed=false
		else
		player.acc=0.5
		player.max_dx=2
		end

		
		--check col up n down
		if player.dy>0 then
				player.falling=true
				player.landed=false
				player.jumping=false
				
				--you might or might not want this
				--player.dy=limit_speed(player.dy,player.max_dy)
				
				
				if collide_map(player,"down",0) then
						player.landed=true
						player.falling=false
						player.dy=0
						player.y-=((player.y+player.h+1)%8)-1
						
				end
		elseif player.dy<0 then
				player.jumping=true
				if collide_map(player,"up",1) then
						player.dy=0
				end
		end
		
		--check col left n right
		if player.dx<0 then

				--you might or might not want this				
				--player.dx=limit_speed(player.dx,player.max_dx)
				
				if collide_map(player,"left",1) then
						player.dx=0
						
				end
		elseif player.dx>0 then

				--you might or might not want this				
				--player.dx=limit_speed(player.dx,player.max_dx)
				
				if collide_map(player,"right",1) then
				  player.dx=0
				end
		end
		
		player.x+=player.dx
		player.y+=player.dy
		
		--enemy collision
		if collide_map(player,"any",7)
		then
		sfx(1,1)
		intensity += shake_control
		dustx=player.x
		dusty=player.y-4
		dustsize=4
		dscol=9
		dust=true
		restart_level()
		end
		end
end

function player_animate()
  if player.jumping then
    player.sp=7
  elseif player.falling then
    player.sp=8
  elseif player.running then
    if time()-player.anim>.1 then
      player.anim=time()
      player.sp+=1
      if player.sp>6 then
        player.sp=3
      end
    end
  else --player idle
    if time()-player.anim>.3 then
      player.anim=time()
      player.sp+=1
      if player.sp>2 then
        player.sp=1
      end
    end
  end
end


function limit_speed(num,maximum)
		return	mid(-maximum,num,maximum)
end		
