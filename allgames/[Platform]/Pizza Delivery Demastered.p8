function _init()
	music(24)
	menuitem(1)
	menuitem(2)
	menuitem(3)
	menuitem(4)
	reload(0x2000, 0x2000, 0x1000)
	gamestate="logo"
	intro=false
	player={
			sp=1,
			x=16,
			y=104,
			w=8,
			h=8,
			flp=false,
			dx=0,
			dy=0,
			max_dx=1,
			max_dy=1.6,
			acc=0.5,
			boost=4,
			anim=0,
			running=false,
			jumping=false,
			falling=false,
			landed=false,
			sprint=true,
			pizza=0,
	}
	
	piztitle={
	x=64,
	y=128+16,
	speed=0.25,
	grow=true,
	}
	
	menucursor={
	x=24,
	y=0,
	pos=0,
	maxs=2,
	sp=83,
	dist=6,
	}
	
	gametitle={
	x=8,
	y=0,
	speed=0.5,
	grow=true,
	}	
	debug={
	x1=0,
	x2=0,
	y1=0,
	y1=0,
	}
	
	pizthr={
		speed=2,
		sp=83,
		x=0,
		y=0,
		w=8,
		h=8,
		draw=false,
		flp=false,
	}
	gravity=0.25
	friction=0.5
	
	--level stuff
	levelcounter=1
	introcounter=1
	--signs stuff
 sign_time = time()
 signdrw=false
	
	--save test
	extra=dget(0)
	--etc
	lvlmusic=1
	gameversion="1.1"
	dustsize=0
	dscol=7
	dustx=player.x
	dusty=player.y
	game_end=false
	autorun=false
	musicis="on"
	sprintis="off"
	inmenu=false
	credits=false
	
	--logo intro stuff
	logolast = time()
 lgcnt=1
 fade="in"
 palch=1
	
	--timer stuff
	timer=0
	timetime=false
	
	starttime=0
	counttime=0
	
	--shake screen stuff
 intensity = 0
 shake_control = 5
end
