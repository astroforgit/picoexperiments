--update and draw stuff tbh

function _updategame()
		countertime=time()
		if intensity > 0
   then shake()
  end
		player_update()
		player_animate()
		endflag_update()
		player_bound()
		pizza_update()
		enemy_update()
		--menuitem(1,"skip level", function() skip_level() end)
		--menuitem(2,"return level", function() return_level() end)
		menuitem(1,"restart level", function() restart_level() end)
		menuitem(2,"toggle music:"..musicis, function() ingamemusic() end)
		menuitem(3,"auto-sprint:"..sprintis, function() autosprint() end)
		--menuitem(4,"change char", function() extra_char() end)
end

function _drawgame()
		cls(1)
		map_update()
		if extra==1 then
		spr(player.sp+16,player.x,player.y,1,1,player.flp)
		else
		spr(player.sp,player.x,player.y,1,1,player.flp)
		end
		drwdust(player.x+player.w/2,player.y+player.h)
		camera()
		hud_print()
		signs_draw()
		drw_pizza()
		--rectfill(debug.x1,debug.y1,debug.x2,debug.y2,8)
		--print("pizza delivery\ndemastered v"..gameversion,2,116,8)
		--print("px"..level[levelcounter].px,2,120,2)	
		--print("py"..level[levelcounter].py,2,112,2)	
		--print("player x="..flr(player.x),2,100,2)	
		--print("player y="..flr(player.y),2,92,2)	
		draw_end()
end


