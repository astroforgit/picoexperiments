--title stuff
function _updatemenu()
menucursor.pos=menucursor.y/menucursor.dist
if grownshrink(piztitle,piztitle.y,128+24,128+16) then
	piztitle.y+=piztitle.speed
else
	piztitle.y-=piztitle.speed
end
if grownshrink(gametitle,gametitle.x,8+4,8-4) then
	gametitle.x+=gametitle.speed
else
	gametitle.x-=gametitle.speed
end

if inmenu then
if btnp(ƒ) and 
	menucursor.pos<menucursor.maxs
	and not credits
	and not nomaker
	then
	menucursor.y+=menucursor.dist
end
if btnp(”) and
	menucursor.pos>0
	and not credits
	and not nomaker
	then
	menucursor.y-=menucursor.dist
end
end
end

function grownshrink(obj,n,maxn,minn)
				--obj needs a grw value
    
    if n >=minn and obj.grow then
     if n <= maxn then
  				return true
     end
    end
    
    if n > maxn then
    	obj.grow=false
    end
    
    if obj.grow==false and n>minn then
     return false
    end
    
    if obj.grow==false and n<=minn then
    	obj.grow=true
    end
    return obj.grow
end

function scale_text(text,tlx,tly,sx,sy,col)
 print(text,0,0,col)
    for y=0,7 do
     for x=0,#text*8-1 do
      local col=pget(x,y)
      if col!=0 then
      local nx=x*sx+tlx
      local ny=y*sy+tly
      rectfill(nx,ny,nx+sx,ny+sy,col)
      end
     end
    end
    print(text,0,0,0)
end
function _drawmenu()
cls()
scale_text("pizza delivery",gametitle.x,10,2,2,2)
scale_text("pizza delivery",gametitle.x,8,2,2,8)
scale_text("demastered",gametitle.x+16,26,2,2,9)
scale_text("demastered",gametitle.x+16,24,2,2,10)
drw_titlepiz()
if btnp(—) then
	if inmenu
	and not intro then
	mnucrsmanager(menucursor.pos)
	elseif not inmenu then
	sfx(3,0)
	inmenu=true
	end
end
if inmenu then
spr(menucursor.sp,menucursor.x,(menucursor.y-2)+62)
print("play as stanley",32,62,7)
print("play as newmaker",32,68)
print("credits",32,74)
end
if not inmenu then
print("press — to start!",29,64,7)
end
drw_intro()
palch-=0.05
fadepal(palch)
drw_credits()
drw_nomaker()
end

function drw_intro()
	if intro then
		cls()
		sspr(intronumb[introcounter].x,intronumb[introcounter].y,40,24,22,20,80,48)
		print("press Ž to continue",22,8,6)
		print(intronumb[introcounter].text,0,72,7)
		if btnp(Ž) then
		sfx(3,0)
		introcounter+=1
		if introcounter>5 then
		starttime=time()
		intro=false
		extra=0
		gamestate="game"
		music(lvlmusic-1)
		end
		end
	end
end	

function drw_titlepiz()
circfill(piztitle.x,piztitle.y,64,9)
circfill(piztitle.x,piztitle.y,56,10)
circfill(piztitle.x-42,piztitle.y-6,8,8)
circfill(piztitle.x-8,piztitle.y-12,8,8)
circfill(piztitle.x-24,piztitle.y-38,8,8)
circfill(piztitle.x+12,piztitle.y-42,8,8)
circfill(piztitle.x+24,piztitle.y-4,8,8)
circfill(piztitle.x+38,piztitle.y-24,8,8)
