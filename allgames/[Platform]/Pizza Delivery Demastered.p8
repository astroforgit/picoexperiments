--screen changing
function endflag_update()
	if collide_map(player,"any",3)
	then
		if levelcounter<7 then
		sfx(3,0)
		levelcounter+=1
		player.x=level[levelcounter].px
		player.y=level[levelcounter].py
		player.sp=1
		player.dx=0
		player.dy=0
		else
		game_end=true
		end
	end
end

function map_update()
	map(levelcounter*16-16,0)
end	
