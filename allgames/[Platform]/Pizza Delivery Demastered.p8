circfill(piztitle.x+16,piztitle.y+42,8,8)
circfill(piztitle.x-16,piztitle.y+12,8,8)
circfill(piztitle.x-12,piztitle.y+42,8,8)
circfill(piztitle.x-38,piztitle.y+24,8,8)
circfill(piztitle.x+42,piztitle.y+12,8,8)
end

function	mnucrsmanager(menupos)
--very clunky but it works!
if menupos==0 then
sfx(3,0)
intro=true
music(-1,3000)
elseif menupos==1 then

if extra==1 then
music(lvlmusic-1)
gamestate="game"
starttime=time()
else
nomaker= not nomaker
end
elseif menupos==2 then
credits= not credits
else
print("error",0,0,8)
end
end

function drw_credits()
if credits then
rectfill(0,0,128,128,1)
print("original game by:\njefftastic (game base and art)\npostman (art)\ncoffee bat(music)",0,0,6)
print("playtesting team:\nalgo,sinclair,itsjacksjunk,\nmandiflor,mozark,rm05,\njefftastic,speed weed,tv guy,\ndiskkun and simontime",0,28,6)
print("special thanks:\nsinclair(for ur newmaker art)\nthe whole pico-8 discord\nsikork‡‡‡\njefftastic",0,64,6)
print("press — to go back",28,100,6)
end
end

function drw_nomaker()
if nomaker then
	rectfill(1,11,126,47,9)
	rect(0,10,127,48,4)
	print("newmaker hasnt been unlocked\nyet, try beating the game wtih\nstanley in less than 45 seconds\nmaybe!",2,12,7)
end
end
-->8
--logo intro
function _updatelogo()
	if btnp(Ž) then
	pal()
	music(16)
	gamestate="menu"
	end	
	if fade=="out" then
		palch+=0.05
	else
		palch-=0.05
	end
	if palch > 1 then
		fade="in"
		if lgcnt<2 then
		lgcnt+=1
		else
		palch=1
		music(16)
		gamestate="menu"
		end
	end
end

function _drawlogo()
  cls()
  if (time() - logolast) % 1==0  
  then
    fade="out"
  end
  print(logo[lgcnt].text,logo[lgcnt].tx,logo[lgcnt].ty,7)
  print(logo[lgcnt].text2,logo[lgcnt].t2x,logo[lgcnt].t2y,7)
  sspr(logo[lgcnt].sx,logo[lgcnt].sy,logo[lgcnt].w,logo[lgcnt].h,logo[lgcnt].x,logo[lgcnt].y,logo[lgcnt].w*2,logo[lgcnt].h*2)
		fadepal(palch)
end

function fadepal(_perc)
 -- this function sets the
 -- color palette so everything
 -- you draw afterwards will
 -- appear darker
 -- it accepts a number from
 -- 0 means normal
 -- 1 is completely black
 -- this function has been
 -- adapted from the jelpi.p8
 -- demo
 
 -- first we take our argument
 -- and turn it into a 
 -- percentage number (0-100)
 -- also making sure its not
 -- out of bounds  
 local p=flr(mid(0,_perc,1)*100)
 
 -- these are helper variables
 local kmax,col,dpal,j,k
 
 -- this is a table to do the
 -- palette shifiting. it tells
 -- what number changes into
 -- what when it gets darker
 -- so number 
 -- 15 becomes 14
 -- 14 becomes 13
 -- 13 becomes 1
 -- 12 becomes 3
 -- etc...
 dpal={0,1,1, 2,1,13,6,
          4,4,9,3, 13,1,13,14}
 
 -- now we go trough all colors
 for j=1,15 do
  --grab the current color
  col = j
  
  --now calculate how many
  --times we want to fade the
  --color.
  --this is a messy formula
  --and not exact science.
  --but basically when kmax
  --reaches 5 every color gets 
  --turns black.
  kmax=(p+(j*1.46))/22
  
  --now we send the color 
  --through our table kmax
  --times to derive the final
  --color
  for k=1,kmax do
   col=dpal[col]
  end
  
  --finally, we change the
  --palette
  pal(j,col)
 end
end
