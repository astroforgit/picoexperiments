--pause menu stuff
function ingamemusic()
	lvlmusic=-lvlmusic
	music(lvlmusic)
	if lvlmusic==1 then
	musicis="on"
	else
	musicis="off"
	end
end

function autosprint()
	autorun= not autorun
	if autorun then
	sprintis="on"
	else
	sprintis="off"
	end
end

function skip_level()
	if levelcounter<7 then
		levelcounter+=1
		player.x=level[levelcounter].px
		player.y=level[levelcounter].py
		player.sp=1
		player.dx=0
		player.dy=0
	end
end

function return_level()
	if levelcounter>1 then
		levelcounter-=1
		player.x=level[levelcounter].px
		player.y=level[levelcounter].py
		player.sp=1
		player.dx=0
		player.dy=0
	end
end

function restart_level()
		reload(0x2000, 0x2000, 0x1000)
		levelcounter+=1
		levelcounter-=1
		player.x=level[levelcounter].px
		player.y=level[levelcounter].py
		player.sp=1
		player.dx=0
		player.dy=0
end

function extra_char()
		extra= not extra
end
-->8
--boundary check test
function player_bound()
	if player.x+8>128 then
	player.x=120
	player.x-=1
	player.dx=0
	end

	if player.x<0 then
	player.x=0
	player.x+=1
	player.dx=0
	end
	
	if player.y>128 then
	sfx(1,0)
	intensity += shake_control
	dustx=player.x
	dusty=player.y-12
	dustsize=5
	dscol=9
	dust=true
	restart_level()
	end
	
end
-->8
--misc visual effects
function drwdust()
	if dust then
		dustsize-=0.25
		if dscol>6 then
			dscol-=0.25
		end
		circfill((dustx+4),dusty+7,dustsize,dscol)
		circfill((dustx+4)-dustsize*2,dusty+7,dustsize,dscol)
		circfill((dustx+4)+dustsize*2,dusty+7,dustsize,dscol)
	end
end

function shake()
    local shake_x=rnd(intensity) - (intensity /2)
    local shake_y=rnd(intensity) - (intensity /2)
    --offset the camera
    camera( shake_x, shake_y )
    --ease shake and return to normal
    intensity *= .9
    if intensity < .3 then 
        intensity = 0 
    end
end

