--state handler
function _update60()
state_handle_upt()
end
function _draw()
state_handle_drw()
end
function state_handle_upt()
if gamestate=="menu" then
		_updatemenu()
	elseif gamestate=="game" then
		_updategame()
	elseif gamestate=="logo" then
		_updatelogo()
	end
end
function state_handle_drw()
if gamestate=="menu" then
		_drawmenu()
	elseif gamestate=="game" then
		_drawgame()
	elseif gamestate=="logo" then
		_drawlogo()
	end
end


