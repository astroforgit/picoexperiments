function hud_print()
		rectfill(0,0,34,18,12)
		rectfill(0,0,128,9,8)
		print(level[levelcounter].name,2,3,5)
		print(level[levelcounter].name,2,2,7)
		print("piz:"..player.pizza,104,3,5)
		print("piz:"..player.pizza,104,2,7)
		print("time:"..flr(countertime-starttime),2,12,5)
		print("time:"..flr(countertime-starttime),2,11,7)
end

--signs
function signs_draw()
if signdrw then
	rectfill(1,11,126,47,9)
	rect(0,10,127,48,4)
	print(level[levelcounter].sign,2,12,7)
		if not timetime then
		timer=time()+5
		timetime=true
		end
		if time()>timer
		and timer>0 then
		signdrw=false
		timetime=false
		end
end
end

--ending
function draw_end()
	if game_end then 
		music(-1, 300)
		if extra==0 then
		pal(3,5)
		pal(9,6)
		pal(10,7)
		pal(1,5)
		pal(8,5)
		cls()
		sspr(3*8,40,8,8,-78,0,184,184,1)
		sspr(3*8,0*8,8,8,64,32,96,96,1)
		rectfill(13,47,116,61,0)
		rectfill(7,119,119,125,0)
		print("thank you for playing",24,48,7)
		print("pizza delivery demastered!",14,56)
		print("seeyou in pizza delivery 2..?",8,120)
		else
		cls()
		sspr(80,24,36,33,0,0,128,128)
		end
		if flr(countertime-starttime)<45 
		and extra==0	then
		print("youve unlocked newmaker!",16,8,6)
		spr(17,6,6)
		dset(0,1)
		end
		if not timetime then
		timer=time()+5
		timetime=true
		end
		if time()>timer
		and timer>0 then
		pal()
		_init()
		end
	end
end
