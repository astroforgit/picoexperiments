	{s=7,l=2},
	{s=3,l=3},
	{s=16,l=2},
	{s=19,l=1},
	{s=13,l=2},
	{s=24,l=2,bg=14},	
	{s=21,l=2,bg=0},
	{s=11,l=1},
	{s=10,l=0},
	{s=27,l=1},
	{m={7,14}},
	{m={4,15,23}},
	{m={0,22,29}},
	{m={27,2,22,12}},
	{m={3,25,6,21}},
	{m={0,3,18}},
	{l=31,m={31,29},bg=0}
}
skip=0
offset={x=0,y=0,t=0,t=0}
pald={
{01,01,03,02,01,13,06,02,04,09,03,13,01,13,14},
{00,01,01,01,01,01,13,01,01,04,01,01,01,01,13},
{00,01,01,01,01,01,01,01,01,02,01,01,01,01,01}
