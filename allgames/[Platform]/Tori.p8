--init

function _init()
	--customizable character
 load_hiscore()
	tr=0
	max_objs=24
	friction=.8
	actions={}
	
	--sets={0,1,7,12,16,20,24,28,32}
 t=0
 m={}
 if (menu) currentset = #sets
	load_set(currentset)
end

---

function co_start_game()
	loading =true
	sfx(13)
	
	for i=1,50 do
 	yield()
 end
 music(13)
 loading=false
 menu=false
 t=0
 currentset=1
	load_set(currentset)
end


------------

function load_set(set)
	--if (set==2) co(co_end_game)
	pl=nil
 loading=true
 if remix then
 	if type(remix) != "number" then
 		remix=0
 	elseif set then
 		remix+=1
 		if (remix>4) then 
 			co(co_end_game,true)
 		end
 	end
 	currentset="?"
 	if set then
  	cs={l=flr(rnd(2)+1),m={}}
  	repeat
  		local m = flr(rnd(32))
  		for n in all(cs.m) do
  			if (n==m) m=-1
  		end
  		if (m>=0)add(cs.m,m)
  	until(#cs.m>cs.l)
  	cs.s=cs.m[1]
 	end
 else
	if (not set) set = currentset
 	if (set>#sets) then
 		if (not menu) co(co_end_game)
 		set=1
 	end
 	cs = sets[set]
 	if not cs.m then
 		cs.m={}
 		if not cs.l then
 			cs.l = sets[set+1].s-cs.s-1
 		end
 		for i=0,cs.l do
 			add(cs.m,cs.s+i)
 		end
 	else
 		if (not cs.l)cs.bg=0
 		cs.s=cs.m[1]
 		cs.l=#cs.m-1
 	end
 	if (cs.s!=31 and set>#sets/2)cs.bg=0
 	sets[set]=cs
 	currentset=set
 end
 
 cs.t=0
	cmap = cs.s
	text={}
	particles={}
	if (menu) then
		cs.bg=12
		music(0)
	end
	reload(0x1000, 0x1000, 0x2000)
	for l=1,#cs.m do
		l = cs.m[l]
		m[l]={}
		m[l].actor={}
		m[l].block={}
		m[l].cloud={}
		for n=1,rnd(8) do
			c={}
			c.x=rnd(128)
			c.y=rnd(80)
			c.w=rnd(20)+4
			c.h=rnd(4)+2
			c.dx=(rnd(2)-1)/5
			add(m[l].cloud,c)
		end
		load_layer(l)
	end
	if (not pl)make_player({x=20,y=20,m=cs.s})	


	make_text("level "..currentset)
	offset.t=64
	skip=0
	
	if (set==#sets and not menu) cloud=true
	loading=false
	
end
-------

function make_player(s)
 for i=0,#m do
		--del(m[i].actor,pl)
	end
	pl=make_obj(s,"actor")
	pl.sp=2.5
	pl.kind=75
	cmap=pl.m
end

----

function load_layer(l)
	x=(l%8)*16
	y=flr(l/8)*16
	for x=x,x+15 do
		for y=y,y+15 do
			local v=mget(x,y)
			if (fget(v)==15) clear_cel(x,y)
			if fget(v)>39 then
				s={x=flr(x/16),y=flr(y/16)}
				s.kind=v
				s.m=l
				s.x=8*(x-16*s.x+.5) 
				s.y=8*(y-16*s.y+.9)
				if fget(v)==255 then
					if (pl==nil)make_player(s)
				elseif fget(v,6) then
					a=make_obj(s,"actor")
					if (v==116)a.sp*=4
					if (v==120)a.gravity/=2

				elseif fget(v,7) then
					b=make_obj(s,"block")
					if (fget(v,0))b.fruit=true
					b.sp=2.5
					b.f1=1
				end
				clear_cel(x,y)
			end
		end
	end

end

-------

function clear_cel(x,y)
 val0 = mget(x-1,y)
 val1 = mget(x+1,y)
 if (val0 == 0 or val1 == 0) then
  mset(x,y,0)
 elseif (not fget(val1,1)) then
  mset(x,y,val1)
 else
  mset(x,y,val0)
 end
end

------

function make_obj(a,db)
	a.life = 1
 a.dx=0 a.dy=0
	a.sp=3.75
	a.gravity = 1.2
	a.f0 = 0
	a.f1 = 4
 a.d=false
 a.standing = false
 a.airtime=0
 a.db=db
 a.oy =a.y
 
 for k,v in pairs(m[a.m]) do
	 if (db==k) and
	 (#v < max_objs) then
	  add(v, a)
	 end
	end

	return a
end

