--draw

function _draw()
	if loading then
		cls()		
	end
	if ending then
		draw_ending()
		return
	end
	
	if skip>0 then
		map(16*(cmap%8),16*flr(cmap/8),0,depth,16,16)
		circ(pl.x,pl.y,20,4+t%12)
		skip-=1
		return
	end
	cls()
	--transition1()
	local c=15
	if (cs.bg) c=cs.bg
	rectfill(0,0,127,127,c)
	if (not menu )draw_stars()
	
	local index = get_index(cmap)
	for l=farmap(),0,-1 do
		
		depth=l
		l+=index-1
		if (btn(4,1)) l+=1
		l%=#cs.m
		l=cs.m[l+1]
		
		rect(depth,depth,127-depth,127-depth,0)
		if depth>0 then
			for i=1,15 do
				pal(i,pald[depth][i])
			end
		else
			--black outline
			if pl.dy==0 and pl.dx==0
			--or true
			then
 			offset.t+=1
 			if offset.t>64 then
  			for i=1,15 do
  				pal(i,pald[2][i])
  			end
  			for x = 0,1 do
  				for y = -1,0 do
  					offset.x=x offset.y=y
  					map(16*(l%8),16*flr(l/8),x,depth+y,16,16,1)
  					foreach(m[l].actor,draw_obj)
  					foreach(m[l].block,draw_obj)
  					--draw_obj(pl)
  				end
  			end
  		end
			else
				offset.t=0
			end
			offset.x=0 offset.y=0
			pal()
		end
		

		draw_decorations()
		map(16*(l%8),16*flr(l/8),0,depth,16,16)
		--for y=0,128,32/(2.5*d) do
		--line(0,y+t/d%8,128,y+((t%8)*.5^d),15)
		--end
		foreach(m[l].actor,draw_obj)
		foreach(m[l].block,draw_obj)
		if (cloud)foreach(m[l].cloud,draw_cloud)
	end
		foreach(particles,draw_particles)

	if menu then
		if (not loading)draw_menu()
	else
		if debug then
  	local s =""
  	for ma in all(cs.m) do
  		color(7)
  		if (ma ==cmap) s=s..">"
  		s=s..ma
  		s=s.." "
  	end
  	print(stat(1),10,10,6)
  	print(s,10,110,6)
 	end
 	
  if (timer)print(timetext(t),10,10,7)
 	if conext then
 		bold(timetext(cs.t),64,12,7,1)
 	end
 	--print(enemycount,10,20,8)
 	draw_text()
 end



	for p in all(birdpal[birdcol]) do
	
		pal(p[1],p[2])
	end
	draw_obj(pl)
	pal()
		local s="u:"..update
	s=s.." d:"..stat(1)
	--print(s,10,10,8)
	--print(dget(3),10,10,8)
	--print(stat(7),10,20,8)

end

function draw_menu()
	local a = cmap == cs.s
 for i=1,#menui do
 	local b = i<=menui.cutoff 
 	if (a and b) or
 	(not a and not b) then
	 	local t=menui[i]
			--circfill(t.x,t.y,menui.r,1)
			circ(t.x,t.y,menui.r,1)
			bold(t.s,t.x,t.y-menui.r/2-1,7,1)
		end
	end
	if a then
	 bold("oprel 2018",108,122,2,4)
	else
		if mencol(4,true) then
			if (t>0)t=-(#hiscore+1)*64
			rectfill(44,0,128,128,13)
			local x=0
 		for i=1,#hiscore do
  		x+=hiscore[i]
  		s= "è"..i..": "
  		if (#s<5) s=s.." "
  		s=s..timetext(hiscore[i])
  		print(s,50,(8+8*i-t/8)%(#hiscore*8+16),7)
  	end
  	s="total: "..timetext(x)
  		print(s,52,(16+8*#sets-t/8)%(#hiscore*8+16),7)
  
  	
  	rectfill(0,118,128,128,13)
  	local s= "timed run: "
  	s = s..timetext(hiscore.a)
  	bold(s,64,120,7,13)
  else
		if (t<0)t=0
		end
	end

end

function draw_stars()
	if stars==nil or stars.m!=cs.s then
		stars={m=cs.s}
		for i=0,rnd(20) do
			add(stars,{x=rnd(128),y=rnd(80),t=rnd(128)})
		end
	end
	--super mario all stars
	for s in all(stars) do
		local c = 10
		s.t+=1
		if s.t>100 then
 		c=7
 		if (s.t>128)then
 			s.t=rnd(40)
			end
		end
		pset(s.x,s.y,c)
	end
end

function draw_obj(a)
	spr(a.kind+a.f0,a.x-3.5+offset.x,a.y-7+depth+offset.y,1,1,a.d)
	if (a.sleep and t%32<1) then
	if (rnd(16)<1)make_particles(a.x,a.y,a.m,true)
	end
end

function draw_cloud(c)
	local col =7
	if (cs.bg and cs.bg<2) col=6
	rectfill(c.x,c.y,c.x+c.w,c.y+2*c.h,col)
	circfill(c.x,c.y+c.h,c.h,col)
	circfill(c.x+c.w,c.y+c.h,c.h,col)
	c.x+=c.dx
	if c.x<0 or c.x>127 then
		c.dx*=-1
	end
end

function draw_particles(p)
--or p.m!=cmap
	if (p.t<0 ) then
		del(particles,p)
		return
	end
	p.t-=1
	p.x+=p.dx*p.t/20
	p.y+=p.dy*p.t/20
	if p.sleep then
		print("z",p.x,p.y,7)
	else
		circ(p.x,p.y,p.r,7)
	end
end

function draw_text()
 tu = tut[currentset]
 if tu then
 	bold(tu,60,121,7,0)
 end

	local e = true
	for i=1,#text do
		local w = text[i]
		local c = w.c + (w.t-w.y)/2
		bold(text[i].s,w.x,w.y,c,0)
		if w.y<w.t then
			text[i].y+=1
			e=false
		end
	end
	if e and text.t then
	text.t+=1
	if text.t>60 then
 
 	del(text,text[1])
 		for i=1,#text do
 			text[i].t+=1
 		end
 	end
 end
end

function draw_decorations()
 local n = cs.l-3
 local k=120-n
 for x=n,k,k-n do
 	for y=n,k,k-n do
 		spr(1,x,y)
 	end
 end
end

function make_text(string,c)
 if (c == nil) c = 7
 text={t=0}
 for i=1,#string do
 	local e={}
 	e.s = sub(string,i,i)
 	e.x = 60-#string*4+i*8
 	e.y = -i*4
 	e.t	=	8
 	e.c = c
 	text[i] = e
 end
end



function transition1()
	if tr<80 then
		clip(pl.x-tr,pl.y-tr,2*tr,2*tr)
		tr+=1
	end
end

function transition2()
	 --transition
 if tr<80 then
 	for x=-tr-pl.x,tr-pl.x,tr/3 do
	 	for y=-tr-pl.y,tr-pl.y,tr/3 do
	 		local c=pget(64+x,64+y)
	 		circfill(64+x,64+y,(64-tr)/5,c)
	 		--circfill(64+x,64+y,(64-tr)/9,0)
	 	end
	 end
	end
end

function draw_ending()
	for i =1,pingpong(5,1/8) do
		spr(rnd(64)+64,rnd(144)-8,rnd(144)-8)
	end
	if t>1024 then
		local a =sin(t/64)*10^9
		local b =cos(-t/1024)*10^9
		line(64,64,a,b,0)
	end
	rectfill(0,60,128,71,0)
	s="thanks for playing!"
	if (remix) s="remix champion"
	if (timer) then
		s=timetext(timer)
		hi="hi: "..timetext(hiscore.a)
		rectfill(0,116,128,128,0)
		bold(hi,64,120,7,1)
	end
	
	bold(s,64,64,7,1)
	

end

function pingpong(a,b)
	return abs((t*b+a)%(2*a)-a)
end
-->8
--update

function _update60()
	--if (stat(7)<60) return
	t+=1
	--coroutines
	for c in all(actions) do
   if costatus(c) then
     coresume(c)
   else
     del(actions,c)
   end
 end
 	
 if (skip>0 or ending) return
	
	if (btn(0)) pl.dx=-1
	if (btn(1)) pl.dx= 1
	if (btnp(2) or btnp(4)) 
	--jump
	and pl.standing then
		
		pl.dy=-35
		sfx(8)
		make_particles(pl.x,pl.y,cmap)
	end
	
	--flip Ö
	if btnp(3) or btnp(5) then 
		pl.y-=1.2
		val=mget(mx(pl.m,pl.x),my(pl.m,pl.y))
		if not (fget(val,1) and
		not fget(val,0)) then
		
			pmap=cmap
			cmap=next_layer(1)
			pl.m=cmap
			
			--checks flip target bugs
			--true: half platforms are solid
			--false: solid platforms are flaky
			if solid(pl,false) then
				sfx(14)
				cmap=pmap
				pl.m=cmap
			else
				sfx(17)
				skip=8
				
				
				for k,v in pairs(m[pmap]) do
					if k=="actor" or k=="block" then
						for n in all(m[pmap][k]) do
							if distance(pl,n)<30 then
								if (remix)flip_obj(n,cmap)
								if (solid(n)) del(v,n)
							end
						end
					end
				end
			end
		else
			sfx(14)
		end
	end
	
	if debug and btnp(3,1) then
		if (remix) then 
		load_set(true)
		else
		load_set(currentset+1)
		end
	end
	if debug and btnp(2,1) then
		birdcol=birdcol%#birdpal+1
	end
		
	--physics
	for l=1,farmap()+1 do
		l=cs.m[l]
		foreach(m[l].actor,move_obj)	
		foreach(m[l].block,move_obj)
		foreach(m[l].actor,actor_collision)
		
	end
	if (cs.t>=0) cs.t+=1
	--actor_collision(pl)
	--move_obj(pl)
	if (menu and not loading) menu_actions()
 update=stat(1)
end

----------

function move_obj(a)
	if (a.kind>111 and a.db=="actor") move_ai(a)
	
	if (a.dx>0) a.d=false
	if (a.dx<0) a.d=true
	if (a.y>127) then
		destroy_obj(a)
	end

	
	solid(a)

	local s=a.sp
 
 if abs(a.dx)>0.2 then
 	local dx=a.dx
 	if (abs(dx)>s) dx=s*getd(dx) 
 	dx*=friction
 	a.x+=dx
		a.dx-=dx 
 else a.dx=0
 end
 
 if abs(a.dy)>0.2 then
 	local dy=a.dy
 	if (abs(dy)>s) dy=s*getd(dy)
 	dy*=friction
 	a.y+=dy
		a.dy-=dy 
	else a.dy=0
	end
	
	local dy=a.dy
	local d = 4
	a.dy = min(abs(max(dy,.1)),d)
	a.dy *=a.gravity*d
	if (solid(a))
		then a.standing=true
		else a.standing=false
	end
	a.dy+=dy
	
if a.f1>1 then
		if (a.standing) then
		 a.f0 = (a.f0+abs(a.dx)%s*2+4) % a.f1
	 	if (a.dx==0) a.f0=0
	 else
		 a.f0 = (a.f0+abs(a.dx)/2+4) % a.f1
	 end
	end
	if (a.standing) then
		if (a.airtime>20) make_particles(a.x,a.y,a.m)
		a.airtime=0
	else
		a.airtime+=1
	end
end

-------
function actor_collision(a)
	--spikes
	local gx =mget(mx(a.m,a.x+2*a.dx),my(a.m,a.y))
	local gy =mget(mx(a.m,a.x),my(a.m,a.y+a.dy+1))
	if fget(gy,4) and not fget(gy,1)
 or fget(gx,4) and fget(gx,1) then
		--destroy_obj(a)
	end
	--pl and mon kill
	if a !=pl then
 	if (distance(a,pl)<5) 
 	and a.m == pl.m then
 		destroy_obj(pl)
 	end
 	for n in all(m[a.m].block) do
 		if n.fruit and a!=n 
 		and distance(a,n)<9.5 then 
 			
 			s={x=a.x,y=a.y,kind=a.kind-16,m=a.m,sleep=true}
				make_obj(s,"block")
 			destroy_obj(n)
 			destroy_obj(a)
 			skip=1
 		end
 	end
 end
end

--------
function solid(a,ray)
	if (a==nil)return
	local x=a.x+a.dx
	local y=a.y+a.dy
	
	--map
	local s=3
	if (abs(a.dx)>s) x=a.x+s*getd(a.dx)
	if (abs(a.dy)>s) y=a.y+s*getd(a.dy)
	local g =mget(mx(a.m,a.x),my(a.m,a.y))
	local gx=mget(mx(a.m,x),my(a.m,a.y))
	local gy=mget(mx(a.m,a.x),my(a.m,y))
	local sx=fget(gx,0)
	local sy=fget(gy,0)
	
	if not ray then
		if fget(g,0) or a.dy<=0 then
			if (sy and fget(gy,1)) sy=false
			if (sx and fget(gx,1)) sx=false
		end
	end
	
	--bounds
	local ex=x<1 or x>127
	local ey=y<-16
	b = block_solid(a,x,y)

	
	sx = sx or ex or b.x
	sy = sy or ey or b.y
	if (sx) a.dx=0
	if (sy) a.dy=0
	return sx or sy
end


--------

function block_solid(a,x,y)
	local b={x=false,y=false}
	for n in all(m[a.m].block) do
		if a!=n and not n.sleep then
			if abs(x-n.x)<6
			and abs(a.y-n.y+1)<3 then
			 local f = .7
			 if (a==pl)f=1
				if (a.standing)n.dx+=(n.x-x)*f
				if (abs(a.dx)>.5 and rnd(4)<1) then
					make_particles(x,n.y,n.m)
				end
				a.x+=(a.x-n.x)/32
				b.x=true
			end
			if abs(a.x-n.x)<3
			and abs(y-n.y+1.5)<6 then
				if a.dy<20then
					n.dy=(a.dy)*.7
				end
				if abs(a.x-n.x)<2-abs(a.dx) then
					n.dy+=(n.y-y)
 				if (not (a.db=="block"
 				and n.dy+a.dy<2))then
 					b.y=true
 				end
 			end
 			--trampoline
				if n.kind==70 and a.dy>0 then
					a.dy=-min(100,max(40,a.dy+30))
					local d = 1.5
					if (a!=pl)a.dx+=(rnd(2)-4)/10
					b.y=false
				end
				
			end
		end
	end
	return b
end

function move_ai(a)
	if t%128<1 or 
	(a.dx==0 and t%16<1) then
		a.dx=rnd(128)-64
		--fruit target
		for n in all(m[a.m].block) do
			if n.fruit then
 			local dx=n.x-a.x
 			local dy=abs(n.y-a.y)
 			if abs(dx)<30 and dy<8 then
 				a.dx=dx
 			end
			end
		end
	end
	
	
	
	--ledge reverse
	if a.standing then
		a.sp=.25
		local p=5
		if (a.d) p*=-1
		local e={x=a.x+p,y=a.y+5,
											m=a.m,dx=0,dy=0}
		if not solid(e,true) then
			a.dx*=-1
		end
	else
		a.sp=1
		a.dx=0
	end
end

function menu_actions()

	if cmap == cs.s then
 	if mencol(1) then
 	co(co_start_game)
 	elseif mencol(2) then
			co(co_changebird)
 	end
	else
		if mencol(3) then
			timer=true
			cloud=false
 		co(co_start_game)
 	end
 	if mencol(5) then
 		remix=true
 		cloud=false
 		co(co_start_game)
 	end
 end
end

function mencol(a,b)
	local m = menui[a]
	local c = distance(pl,m)<menui.r+2
 if (not b and c) then
 	local r=menui.r
  for x=-r,r,3 do
  	for y=-r,r,3 do
  		make_particles(m.x+x,m.y+y,cmap)
 		end
  end
 end
 return	c
end


function co(c)
	local c = cocreate(c)
	add(actions,c)
end

function co_death()
sfx(12)
	pl.x=-10
	pl.y=0
 for i=1,30 do
 	yield()
 end
 --music(12)
	load_set()
end

function co_next_level()
	sfx(10)
	conext = true
	if not remix then
 	local hi = hiscore[currentset]
 	if hi==0 or hi<cs.t then
 		hiscore[currentset] = cs.t
 		save_hiscore()
 	end
 end
	for i=1,50 do
 	yield()
 end
 conext = false
	if (remix) then 
		load_set(true)
		return
	end
	load_set(currentset+1)

end

function co_changebird()
	loading=true
	birdcol = birdcol%#birdpal+1
	make_particles(pl.x,pl.y-5,cmap)
	for i=1,40 do
 	yield()
 end
	loading=false
end


function co_end_game()
	cls()
	--music(6)
	music(12)
	if (timer) then
		t=abs(t)
		timer=t
	 if hiscore.a == 0
	 or hiscore.a >t then
	 	hiscore.a = abs(t)
	 	save_hiscore()
	 end
	end
	if (not (timer or remix)) t=0
	ending=true
	for i=1,1024 do
		if (i>100 and btn(4)) break
 	yield()
 end
 run()
end
-->8
--general

function get_index(l)
	for i=1,#cs.m do
		if	cmap==cs.m[i] then
			return i
		end
	end
	
end

function timetext(t)
	if (t==0) return "ê"
	local t = abs(t)
	local tt =""
	local f = stat(7)
	f=60
	tt=tt..timecode(t/(f*f))..":"
	tt=tt..timecode((t/f)%f) .." "
	tt=tt..timecode(((t%f)/f*100))
	return tt
end

function timecode(t)
	t=flr(t)
	if (t<10) return 0 ..t
	return t
end
function next_layer(d)
if (d<1) return cmap
	for i=1,#cs.m do
		if	cmap==cs.m[i] then
			return cs.m[i%#cs.m+d]
		end
	end
end
	
function distance(a,b)
	local dx=abs(a.x-b.x)	
	local dy=abs(a.y-b.y)
	return sqrt(dx^2+dy^2)
end

function getd(n)
 if (n==0) return 0
 return n/abs(n)
end
	
function mx(m,x)
	x = min(128,max(0,x))
	return flr(x/8)+16*(m%8)
end

function my(m,y)
	y = min(128,max(0,y))
	return flr(y/8)+16*flr(m/8)
end

function bold(s,x,y,cs,cb)
 local m=2*#s
 for i=0,1 do
  for j=-1,0 do
   print(s,x+i-m,y+j,cb)
  end
 end
 print(s,x-m,y,cs)
end

function lerp(tar,pos,perc)
 return (1-perc)*tar + perc*pos;
end

menuitem(1,"restart level",load_set)
