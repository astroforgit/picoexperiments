if (dget(#sets)<0) cloud=true

function flip_obj(a,dest)
	local old=a.m
	
	a.m=dest
	add(m[dest][a.db],a)
	del(m[old][a.db],a)
	
	local a = m[dest][a.db]
	local new = a[#a]
	
	if (solid(new)) destroy_obj(new)
end

function make_particles(x,y,m,sleep)
	for n=1,rnd(4)+2 do
		p={x=x,y=y,m=m}
		p.dx=rnd(1)-.5
		p.dy=rnd(1)-.5
		p.t=rnd(20)
		p.r=rnd(2)
		if sleep then
			p.dy=-rnd(1/10)-.05
			p.y-=8
			p.dx/=10
			p.t=p.t*4+20
			p.sleep=true
		end
		if #particles<256 then
			add(particles,p)
		end
		if (sleep) break
	end
end

function destroy_obj(a)
	sfx(9)
	for n=1,5 do
		make_particles(a.x,a.y-n,a.m)
	end
	if (a==pl) then
		co(co_death)
	else
		del(m[a.m][a.db],a)
 	enemycount=0
		for l=1,farmap()+1 do
			n=cs.m[l]
 		enemycount+=#m[n].actor
 	end
 	if enemycount<2 and not menu then
 		co(co_next_level)
 		cs.t*=-1
 	end
 end
end

function farmap()
	local maxdepth = 3
	return min(cs.l,maxdepth)
end

function save_hiscore()
 dset(0,hiscore.a)
 for i = 1,#sets do
		dset(i,hiscore[i])
	end
end

function load_hiscore()
	hiscore={a=dget(0)}
	for i=1,#sets do
		add(hiscore,dget(i))
	end
end

function clear_hiscore()
	for i = 0,#sets do
		dset(i,0)
	end
	load_hiscore()
end
