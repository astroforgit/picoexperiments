pico-8 cartridge // http://www.pico-8.com
version 32
__lua__
--updates

function _update()
	_upd()
end

function _draw()
	_drw()
end

function _init()
	cartdata("airport")
	_startgame()
end


-->8
--game loop

function _startgame()
	
	colour()
	
	camera(0,0)
	
	if hasdied then
		_upd=updmenu
		_drw=drwmenu
		sfx(1,3)
	else
		_upd=logo
		_drw=logo
		sfx(0)
	end
	
	--player
	loadplayer()
	
	--physics
	grav=0.25
	jumpgrav=0.1
	currentgrav=0.28
	frctn=0.8
	
	--other
	mcount=0
	cases={}
	icons={}
	enemies={}
	projs={}
	camx=0
	score=0
	bonuses=0
	hiscore=dget(0)
	xraycooldown=0
	hasdied=false
	introcount=0
end

function updgame()
	p:upd()
	updscoreicons()
	additems()
	updcases()
	updenemy()
	updproj()
	cam()
	getscore()
end

function drwgame()
	drawmap()
	p:drw()
	drwenemy()
	drwproj()
	map(0,16,(camx+128)\1024*1024,0,128,16)
	map(0,16,(camx-128)\1024*1024,0,128,16)
	drwcases()
	drwscoreicons()
	drawscreen()
end

function logo()
	poke(0x5f2c,3)
	cls(13)
	sspr(112,32,16,16,18,10,32,32)
	print("bluish-red",13,43,2)
	if mcount>=25 then
		print(sub("-PRESENTS-",1,(mcount-25)/3),13,48,2)
	end
	mcount+=1
	if mcount==90 then
		fade(1)
		cls(0)
		poke(0x5f2c,0)
		colour()
		_upd=updintro
	 _drw=drwintro
		sfx(-1,3)
		sfx(1,3)
		mcount=0
	end
end

function drwmenu()
	cls()
	sspr(0,56,88,72,-32,-8,176,144)
	sspr(75,32,36,8,10,40,108,32)
	line(10,55,117,55,0)
	outline("-zenojam-3 2021-",33,73,0,10)
	outline("HIGH SCORE:"..hiscore,43-(2*#tostr(hiscore)),81,0,10)
	outline("—",118,120+sin(time()),0,10)
end

function updmenu()
	if btnp(—) then
	 _upd=updgame
	 _drw=drwgame
	 fade(1)
	 music(8,0,4)
	end
end

function updintro()
	if btnp(—)
	and introcount==0 then
		introcount=1
	end
	if introcount!=0 then
		introcount+=1
	end
	if introcount==30 then
		_upd=updmenu
	 _drw=drwmenu
	end
end

function drwintro()
	sspr(0,56,88,72,-32,-8,176,144)
	sspr(75,32,36,8,10,10+introcount,108,32)
	line(10,25+introcount,117,25+introcount,0)
	if (introcount==0) then
		outline("you have to see your grandma\nbut you are on the no-fly\nlist (i only opened\nthe window becuase it was\nwarm on the plane...)\n\nget to your flight!",9,55,0,10)
		outline("—",118,120+sin(time()),0,10)
 end
end
-->8
--player

function loadplayer()
 p={
		x=0,
		y=112,
		dx=0,
		dy=0,
		grnd=false,
		sprt=64,
		w=1,
		h=1,
		jmp=2.5,
		mxspdx=3,
		mxspdy=5,
		acc=0.4,
		anitimer=0,
		dead=false,
		xray=false,
		canmove=true,
		deadcount=0,
  
		drw=function(this)
			spr(this.sprt,this.x,this.y,this.w,this.h,this.flp)
		end,
		
		died=function(this)
			this.sprt=71
		 this.canmove=false
		 this.deadcount-=1
		 if this.deadcount==0
		 and flr(this.dx)==0
		 and flr(this.dy)==0
		 or this.deadcount<-60 then
		 	sfx(17,3)
			 fade(0.5)
			 hasdied=true
			 _startgame()
			end
		end,
		
		check=function(this)
			
			local checkxray=xray
			
			if collision("centre",2,this.x,this.y,this.w,this.h,1) then
				xray=true
			else
				xray=false
			end
			
			if xray
			and not checkxray
			and p.dx>0
			and xraycooldown==0 then
				sfx(20,3)
				addscore(20,p.x,p.y-6)
				xraycooldown=60
			end
			
			xraycooldown-=1
			xraycooldown=max(0,xraycooldown)
			
			if xray
			and not checkxray
			and p.dx<0 then
				sfx(19,3)
				addscore(-20,p.x,p.y-6)
			end
			
			if p.grnd==false then
		 	this.mxspdx=1.5
			else
				this.mxspdx=3
			end
			
			if not getflag(this.x+3,this.y+8,0,0)
			or not getflag(this.x+3,this.y-1,0,0) then
				this.grnd=false
			end
			
			if p.x+8<camx
			and not p.dead then
				this.dead=true
				this.deadcount=60
				music(-1,800)
			end
		end,
		
		pdx=function(this)
			--stopping
			if this.dx>0 then
				if this.dx<0.1 then
					this.dx=0
				end 
				if this.dx>this.mxspdx then
					this.dx=this.mxspdx
				end
				if collision("right",0,this.x,this.y,this.w,this.h,0) then
					this.dx=0
					this.x=tilex(this.x)
				end
			elseif this.dx<0 then
				if this.dx>-0.1 then
					this.dx=0
				end
				if this.dx<-this.mxspdx then
					this.dx=-this.mxspdx
				end
				if collision("left",0,this.x,this.y,this.w,this.h,0) then
					this.dx=0
					this.x=tilex(this.x)
				end
			end
		 
			this.dx*=frctn
		
			this.x+=this.dx
			
			this.x=max(0,this.x)
		
		end,
		
		pdy=function(this)
		 if not this.grnd then
				this.dy+=currentgrav
			end
			
			this.dy=min(p.dy,this.mxspdy)
			
			if this.y<=0 then
				this.y=0
				this.dy=0
			end
			if this.dy>=0 then
			 for i=0,this.dy do
					if collision("down",0,this.x,this.y+i,this.w,this.h,0)
					or collision("down",1,this.x,this.y+i,this.w,this.h,1) then
						//this.y+=i
						this.dy=0
						this.y=tiley(this.y)
						this.grnd=true
					end
				end
			elseif this.dy<0 then
				if collision("up",0,this.x,this.y,this.w,this.h,0) then
					this.dy=0
					this.y=tiley(this.y)
				end
			end
				
			this.y+=this.dy
			
			if this.y<=8 then
				this.dy=0
			end
		end,
		
		upd=function(this)
			if this.canmove then
				if btn(‹) then
					this.dx-=this.acc
					this.flp=true
				end
				if btn(‘) then   
					this.dx+=this.acc
					this.flp=false
				end
				if btn(Ž) then
				 if this.grnd then
						this.dy-=this.jmp
						sfx(18,3)
				 elseif this.dy<0 then
				 	currentgrav=jumpgrav
				 else
				 	currentgrav=grav
				 end
				else
					currentgrav=grav
				end
				
				this:check()
			end
			
			this:pdx()
		 
			this:pdy()
			
			if not this.dead then
				this:animate()
			end
			
		 if p.dead then
				this:died()
			end
		end,
		
		animate=function(this)
			if this.dx!=0
			and this.dy==0 then
				if this.anitimer%4==0 then
					this.sprt+=1
					if this.sprt>68 then
						this.sprt=65
					end
				end
			elseif this.dx==0
			and this.dy==0 then
				this.sprt=64
			elseif this.dy<0 then
			 this.sprt=70
			elseif this.dy>0 then
				this.sprt=69
			end
			
			this.anitimer+=1
		end,
 }
end
-->8
--tools

function getflag(x,y,flag,maplvl)
	return fget(mget((x%1024)/8,(y+(maplvl*128))/8),flag)
end

function tiley(y)
 return flr((y+4)/8)*8
end

function tilex(x)
	return flr(((x+4)/8))*8
end

function fade(dur)
	dpal={0,1,1,2,1,13,6,4,4,9,3,13,1,13,14}
	for i=0,40,dur do
  for j=1,15 do
   col=j
    for k=1,((i+(j%5))/4) do
     col=dpal[col]
    end
   pal(j,col,1)
  end
  flip()
 end
 colour()
end

function colour()
	pal()
	palt(0,false)
	palt(14,true)
end

function altcolour()
	for i=0,15 do
		pal(i,i+128,1)
	end
	palt(0,false)
	palt(14,true)
end

function outline(s,x,y,c1,c2)
	for i=0,2 do
	 for j=0,2 do
	  if not(i==1 and j==1) then
	   print(s,x+i,y+j,c1)
	  end
	 end
	end
	print(s,x+1,y+1,c2)
end

function getscore()
	local savescore=score
	score=flr(p.x/10)
	if score<savescore then
		score=savescore
	end
	
 if bonuses<score*-1 then
 	bonuses=-1*score
 end

	if (score>hiscore) then
		hiscore=score+bonuses
		dset(0,hiscore)
	end
end
-->8
--collision

function collision(direction,flag,x,y,w,h,maplvl)

	local x1=0
	local y1=0
	local x2=0
	local y2=0
	
	w*=8
	h*=8

	if direction=="up" then
		x1=x
		y1=y-1
		x2=x+w-1
		y2=y-1
	elseif direction=="down" then
		x1=x+1
		y1=y+h
		x2=x+w-1
		y2=y+h
	elseif direction=="left" then
		x1=x-1
		y1=y
		x2=x-1
		y2=y+h-1
	elseif direction=="right" then
		x1=x+w
		y1=y
		x2=x+w
		y2=y+h-1
	elseif direction=="centre" then
	 x1=x+w/2
		y1=y+h/2
		x2=x+w/2
		y2=y+h/2
	end
	
	if getflag(x1,y1,flag,maplvl)
	or getflag(x2,y2,flag,maplvl) then
		return true
	else
		return false
	end
end

function checkcol(x,y,x2,y2,range)
	if x2+range>x 
	and x2<x+range
	and y2+range>y
	and y2<y+range then
		return true
	else
	 return false
	end
end
-->8
--map

function drawmap()
	cls(5)
	camera(0,0)
	spr(112,0,16,11,9)
	spr(112,88,16,11,9)
 camera(camx,0)
 map(0,0,(camx+128)\1024*1024,0,128,16)
 map(0,0,(camx-128)\1024*1024,0,128,16)
end

function drawscreen()
	ui()
end

function ui()
	rectfill(camx,0,camx+128,7,13)
	line(camx,7,camx+128,7,2)
	print("score:"..score+bonuses,camx+1,1,10)
end

function cam()
	local checkcamx=camx
	camx=p.x-60
 if checkcamx>camx then
  camx=checkcamx
 end
 camx=max(0,camx)
 
 if checkcamx==camx
 and camx!=0
 and not p.dead then
 	camx+=0.5
 end
end
-->8
--items

function additems()
	if rnd(100)>98.1
	and camx!=0
	and p.dx!=0
	and #cases<5 then
		local x=camx+128+rnd(128)
		local y=rnd(80)+20
		if not collision("centre",0,x,y,1,1,0)
		or not collision("centre",1,x,y,1,1,1) then
			addcase(x,y)
		end
	end
	if rnd(100)>99.2
	and camx!=0
	and p.dx!=0
	and #enemies<=5 then
		local x=camx+128+rnd(128)
		local y=rnd(80)+20
		if not collision("centre",0,x,y,8,8,0)
		or not collision("centre",1,x,y,8,8,1) then
			addenemy(123,"guard",x,y,1,50)
		end
	end
	if rnd(100)>99.5
	and camx!=0
	and p.dx!=0
	and #enemies<=5 then
		local x2=camx+128+rnd(128)
		local y2=rnd(80)+20
		if not collision("centre",0,x2,y2,8,8,0)
		or not collision("centre",1,x2,y2,8,8,1) then
			addenemy(125,"tazer",x2,y2,0.3,65)
		end
	end
end

function addcase(x,y)
	local case={
		spr=flr(89+rnd(4)),
		x=x,
		y=y,
	}
	add(cases,case)
end

function updcases()
	for case in all(cases) do
		case.y+=sin(time())/5
		if case.x+8<camx then
			del(cases,case)
		end
		if checkcol(case.x,case.y,p.x,p.y,5) then
			del(cases,case)
			if case.spr==91 then
				sfx(19,3)
			 addscore(-10,case.x,case.y-4)	
			else
				sfx(20,3)
				addscore(10,case.x,case.y-4)	
			end
		end
	end
end

function drwcases()
	for case in all(cases) do
		spr(case.spr,case.x,case.y)
	end
end

function addscore(amount,x,y)
	bonuses+=amount
	local colour1=11
	local colour2=3
	if amount<0 then
		colour1=8
		colour2=2
	end
	local string=tostr(amount)
	if amount>0 then
		string="+"..string
	end
	local icon={
		amount=amount,
		str=string,
		x=x,
		y=y,
		colour=colour1,
		col1=colour1,
		col2=colour2,
		life=30
	}
	add(icons,icon)
end

function updscoreicons()
	for icon in all(icons) do
		icon.y-=0.1
		icon.life-=1
		if icon.life<15 then
			icon.colour=icon.col2
		end
		if (icon.life<=0) then
			del(icons,icon)
		end
	end
end

function drwscoreicons()
	for icon in all(icons) do
		outline(icon.str,icon.x,icon.y,0,icon.colour)
	end
end
-->8
--guards

function addenemy(espr,etype,ex,ey,espd,erange)
	e={}
	e.spr=espr
	e.x=ex
	e.y=ey
	e.flp=eflp
	e.spd=espd
	e.dy=0
	e.dx=0
	e.walk=rnd(1)-0.5
	e.rng=erange
	e.ticks=0
	e.stop=false
	e.grnd=false
	e.type=etype
	
	e.draw=function(this)
		spr(this.spr,this.x,this.y,1,1,this.flp)
		if abs(this.dx)>0.05
		and this.grnd then
			this.ticks+=0.25
			if this.ticks==1 then
				this.spr+=1
			elseif this.ticks==2 then
				this.spr-=1
			end
			if this.ticks==3 then
				this.ticks=0
			end
			if this.dx==0
			and (this.spr%2)!=0 then
				this.spr-=1
			end
		end
	end
	
	
	e.upd=function(this)
		
		--attack player
		if p.x+2<=this.x
		and this.x-p.x<=this.rng
		and abs(this.y-p.y)<=this.rng then 
			this.dx-=1
			this.flp=true
			if this.type=="tazer"
			and rnd(100)>98 then
				addproj(127,this.x-2,this.y,-2)
				sfx(22,3)
			end
		elseif p.x-2>=this.x
		and p.x-this.x<=this.rng
		and abs(this.y-p.y)<=this.rng then 
			this.dx+=1
			this.flp=false
			if this.type=="tazer"
			and rnd(100)>98 then
				addproj(127,this.x+6,this.y,2)
				sfx(22,3)
			end
		else
			this.dx=0
		end
		
		if this.dx<0
		and this.grnd
		and not collision("down",1,this.x-8,this.y,1,1,1)
		and not collision("down",0,this.x-8,this.y,1,1,0) then
			ejump(this)
		elseif this.dx>0
		and this.grnd
		and not collision("down",1,this.x+8,this.y,1,1,1)
		and not collision("down",0,this.x+8,this.y,1,1,0) then
			ejump(this)
		end
		
		--idle
		if this.dx==0
		and this.dy==0
		and not (abs(p.x-this.x)<=this.rng
		and abs(this.y-p.y)<=this.rng) then	
			this.stop=true
		else
			this.stop=false
		end
		
		if this.stop then
			this.dx+=this.walk
			if this.walk<0
			and not collision("down",1,this.x-8,this.y,1,1,1)
			and not collision("down",0,this.x-8,this.y,1,1,0) then
				this.dx=0
			elseif this.walk>0
			and not collision("down",1,this.x+8,this.y,1,1,1)
			and not collision("down",0,this.x+8,this.y,1,1,0) then
				this.dx=0
			end
			if rnd(1)>0.96 then
				if rnd(1)>0.55 then				
					this.walk=0
				else
					this.walk=rnd(0.5)-0.25
				end
			end
		else
			this.walk=rnd(0.5)-0.25
		end
	
		if this.dx<0
		and this.stop then
			this.flp=true
		elseif this.dx>0
		and this.stop then
			this.flp=false
		end
		
		--dx
		
		if this.dx<0 
		and collision("left",0,this.x,this.y,1,1,0) then
			this.dx=0
			ejump(this)
		elseif this.dx>0
		and collision("right",0,this.x,this.y,1,1,0) then
			this.dx=0
			ejump(this)
		end
		
		--jumping
		
		if abs(this.x-p.x)<=this.rng
		and this.y>p.y+2 then
			ejump(this)
		end
		
		if abs(this.dx)>this.spd then
			this.dx=this.spd*sgn(this.dx)
		end
		
		this.x+=this.dx
		
		--dy
		
		if not getflag(this.x+3,this.y+8,0,0)
		or not getflag(this.x+3,this.y-1,0,0) then
			this.grnd=false
		end
		
  if this.dy>=0 then
			for i=0,this.dy do
				if collision("down",0,this.x,this.y+i,1,1,0)
				or collision("down",1,this.x,this.y+i,1,1,1) then
					this.grnd=true
					this.y=tiley(this.y)
					this.dy=0
				end
			end
		end
		
		if not this.grnd then
			this.dy+=grav
		end
				
		if collision("up",0,this.x,this.y,1,1,0)
		and this.dy<0 then
			this.dy=0
		end
		
		this.y+=this.dy
		
		if this.x+8<camx then
 		del(enemies,this)
 	end
		
		for i=0,p.dy do
			if checkcol(this.x,this.y,p.x,p.y+i,6) 
			and p.y<this.y
			and not p.dead then
				del(enemies,this)
				p.dy=-3
				sfx(21,3)
				addscore(15,this.x,this.y-4)
			end
		end
		if checkcol(this.x,this.y,p.x,p.y,4) 
		and not p.dead
		and p.y>=this.y then
			p.dead=true
			music(-1,800)
			p.deadcount=60
		end
 end
 
 add(enemies,e)
end

function updenemy()
	foreach(enemies, function(e) e:upd() end)
end

function drwenemy()
	foreach(enemies, function(e) e:draw() end)
end	

function ejump(this)
	if this.grnd
	and this.type!="tazer" then
		this.dy=-3
		this.grnd=false
	end
end
-->8
--projectiles

function addproj(spr,x,y,dx)
	local proj={
		x=x,
		y=y,
		dx=dx,
		flp=false,
		spr=spr,
		lfe=60
	}
	add(projs,proj)
end

function updproj()
	for pr in all(projs) do
		pr.x+=pr.dx
		if pr.dx<0 then
			pr.pflp=true
		else
			pr.pflp=false
		end
		if collision("centre",0,pr.x,pr.y,1,1,0)
		or collision("centre",1,pr.x,pr.y,1,1,1) then
			del(projs,pr)
		end
		pr.lfe-=1
		if pr.lfe==0 then
			del(projs,pr)
		end
		if checkcol(pr.x,pr.y,p.x,p.y,5) 
		and not p.dead then
	 	p.dead=true
	 	music(-1,800)
	 	p.deadcount=60
		end
	end
end

function drwproj()
 for pr in all(projs) do
 	spr(pr.spr,pr.x,pr.y,1,1,pflp)
	end
