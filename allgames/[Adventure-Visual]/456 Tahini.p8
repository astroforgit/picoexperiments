pico-8 cartridge // http://www.pico-8.com
version 1
__lua__
title = 1
texts = {"","","",""}
solids = {}
solids[4] = 1
solids[6] = 1
solids[7] = 1
solids[8] = 1
solids[9] = 1
solids[10] = 1
solids[11] = 1
solids[12] = 1
solids[18] = 1
solids[19] = 1
solids[20] = 1
solids[23] = 1
solids[24] = 1
solids[25] = 1
solids[26] = 1
solids[27] = 1
solids[28] = 1
solids[30] = 1
solids[33] = 1
solids[34] = 1
solids[35] = 1
solids[36] = 1
solids[37] = 1
solids[38] = 1
solids[39] = 1
solids[41] = 1
solids[42] = 1
solids[43] = 1
solids[44] = 1
solids[47] = 1
solids[48] = 1
solids[49] = 1
solids[50] = 1
solids[53] = 1
solids[58] = 1
solids[59] = 1
water = 0

function tern(f,a,b)
if f then
return a
else
return b
end
end

function init()
x = 3
y = 14
prevx = x
prevy = y
f = 0
m = 1
title = 0
tripping = 0
havetriforce = 0
linktriforce = 0
haveboat = 0
havekey = 0
havebee = 0
devtalk = 0
somethingelse = 0
somethingprev = 0
somethingtick = 0
end

function say(text)
 texts[1] = texts[2]
 texts[2] = texts[3]
 --texts[3] = texts[4]
 if somethingelse == 1 then
  if somethingtick == 0 then
   texts[3] = "something else"
  elseif somethingtick == 1 then
   texts[3] = " something else"
  elseif somethingtick == 2 then
   texts[3] = "  something else"
  end
  somethingtick = (somethingtick+1)%3
 else
  texts[3] = text
 end
end

function move(dx,dy)
 local xx = x+dx
 local yy = y+dy
 local donoise = 1
	local t = mget(xx,yy)
	if t >= 7 and t <= 10 then
	 say("me wish for cookie!")
	elseif t == 21 then -- mushroom
		tripping = 164
		sfx(12,2,0)
		say("whoa! this no is cookie!")
	elseif t == 49 then -- bottle
	 say("'we're all gamers because life")
	 say("is the ultimate game.'")
	 say("                 ~dualhammers")
	elseif t == 12 then -- oscar
		say("i am angry trash man. go away!")
	elseif t == 24 or t == 25 then -- grave
		local s = flr(rnd(3))
		if s == 0 then
			say("is there cookies when me die?")
		elseif s == 1 then
			say("what was their last cookie?")
		elseif s == 2 then
			say("great cookie jar in the sky!")
		end
	elseif t == 30 then --link
	 local somethingprev = somethingelse
		if havetriforce == 1 then
			say("... !")
			havetriforce = 0
			linktriforce = 1
			sfx(5,2,0)
			mset(102,4,17)
		elseif linktriforce == 1 then
			say("... :)")
		else
			say("...")
		end
		somethingelse = somethingprev
	elseif t == 33 then --alien
		if tripping > 0 then
		 if haveboat == 0 then
 			say("you understand! here's a boat!")
	 		haveboat = 1
	 		sfx(7,3,0)
	 	else
	 	 say("like, sail the seas...")
	 	end
		else
		 local p = flr(rnd(6))
			if p == 0 then
				say("uh huh!")
			elseif p == 1 then
			 say("radio!")
			elseif p == 2 then
			 say("mushroom!")
			else
				say("yip! yip! yip! yip!")
			end
		end
	elseif t == 31 then -- triforce
		havetriforce = 1
		sfx(4,2,0)
		mset(xx,yy,17) --set to sand
	elseif t == 40 then --key
		havekey = 1
		sfx(7,2,0)
		say("me found key!")
		mset(xx,yy,16) --set to grass
	elseif t == 38 then -- elmo
		say("omel did bad. omel stuck here.")
	elseif t == 42 then -- fish
		say("why me talking to fish?")
	elseif t == 47 then -- skull
		say("spooky!")
	elseif t == 48 then -- letter
		say("7/2/37               ")
		say("    crash landed. sos")
	 say("                  ~a.a.")
	elseif t == 3 then --cookie!
		sfx(10,2,0)
		say("c is for cookie!")
		say("because it is made of crumbs")
		say("om nom nom nom")
		mset(xx,yy,0) 
		mset(124,28,17) --sand
	elseif t == 57 then
	 havebee = 1
	 mset(xx,yy,17) --sand
	 say("bees! good thing oprah not here")
	elseif t == 58 then
	 say("no cookie no passage!")
	elseif t == 53 then
	 say("hi ho! i'm on the wrong show!")
	elseif t == 59 then
	 if havebee == 0 then
	  say("come back with a friend.")
	 else
	  local somethingprev = somethingelse
	  somethingelse = 0
	  if devtalk == 0 then
 	  say("i am the game developer.")
 	  say("i am the god of this realm.")
 	  say("thanks for playing!")
 	 else
 	  say("if you liked the game, tell me!")
 	  say("post game bonus: everyone will")
 	  say("say something else now!")
 	  somethingprev = 1
 	 end
  	devtalk = (devtalk+1)%2
  	somethingelse = somethingprev
  end
	end
	
	local canmove = false
		if solids[t] == nil then
			canmove = true
		end
		if havekey == 1 then
			if t == 37 then
				canmove = true
				mset(xx,yy,17)
				sfx(11,2,0)
			elseif t == 19 then
				canmove = true
				t = 51
				mset(xx,yy,51)
				sfx(11,2,0)
			end
		elseif t == 19 then
		 say("oh no! me lock cookie inside!")
		end
		if haveboat == 1 then
			if t == 4 then --water
				canmove = true
			end
		end
		if canmove == true then
			if t == 52 then
			 if yy > 32 then
			  xx = 124
			  yy = 45
			 else
 				xx = 3
	 			yy = 14
	 		end
			elseif t == 51 then
			 if yy > 32 then
			  xx = 116
			  yy = 46
			 else
			  xx = 123
			  yy = 6
			 end
			elseif t == 45 then
				if mget(x,y) == 45 then
				 donoise = 0
					if dx == -1 then
						sfx(9,2,1)
					else if dx == 1 then
						sfx(8,2,1)
					end
				end
			end
		end
		if t == 4 and not mget(x,y) == 4 then
		 f = 5
		end
		prevx = x
		prevy = y
		x = xx
		y = yy
		if donoise == 1 then
 		f = f+1
 		if t == 4 then
 		 sfx(13+f%6,0)
 		else
 	 	sfx(f%4,0)
 	 end
	 end
	end
end

function _update()
 if title >= 1 then
  if title == 1 then
   sfx(32,0)
  end
  title = title + 1
  if title == 160 or btn(4)
  or btn(5) then
  	sfx(-1,0)
   init()
  end
  return
 end
 
 m = m+1
 if btnp(0) then
 	move(-1,0)
 elseif btnp(1) then
  move(1,0)
 elseif btnp(2) then
  move(0,-1)
 elseif btnp(3) then
  move(0,1)
 end
end

function _draw()
 if title >= 1 then
  rectfill(0,0,128,128,12)
  spr(69,24,40,11,4)
  print("by wade mcgillis",34,100,0)
  print("for ludum dare 33",32,107,0)
  --spr(64,48,56)
  --spr(65,56,56)
  --spr(66,64,56)
  --spr(67,72,56)
  --spr(80,48,64)
  --spr(81,56,64)
  --spr(82,64,64)
  --spr(83,72,64)
 else
 	local vx = 32
 	local vy = 18
 	pal()
 	clip()
 	camera()
  --rectfill(0,0,128,62,12)
  rectfill(0,0,128,128,12)
  palt(2)
  line(0,63,128,63,0)
  palt(0)
  --rectfill(0,64,128,128,1)
  -- bridge
  spr(201,96,56,4,4)
  -- tugboat
  palt(2,0)
  pal(10,0)
  spr(208,64,80,8,3)
  palt()
  pal()
  --cloud
  spr(205,112,8,3,3)
  spr(205,120,40,3,3)
  spr(205,8,8,3,3)
  --waves
  palt(1,0)
  pal(11,1)
  spr(200,104,100,1,1)
  spr(200,24,80,1,1)
  spr(200,120,80,1,1)
  palt()
  pal()
  --waves
  rectfill(vx,vy,vx+64,vy+64,0)
  --littlelogo
  spr(64,48,1,4,2)
  --statue
  palt(12,0)
  pal(8,0)
  spr(128,0,0,4,4)
  spr(132,0,32,4,4)
  spr(136,0,64,4,4)
  --spr(140,0,96,4,4)
  palt()
  pal()
  if tripping > 0 then
  	pal()
   pal(15,1+(1+tripping/8)%15)
   pal(14,1+(15+tripping/8)%15)
   pal(13,1+(14+tripping/8)%15)
   pal(12,1+(13+tripping/8)%15)
   pal(11,1+(12+tripping/8)%15)
   pal(10,1+(11+tripping/8)%15)
   pal(9,1+(10+tripping/8)%15)
   pal(8,1+(9+tripping/8)%15)
   pal(7,1+(8+tripping/8)%15)
   pal(6,1+(7+tripping/8)%15)
   pal(5,1+(6+tripping/8)%15)
   pal(4,1+(5+tripping/8)%15)
   pal(3,1+(4+tripping/8)%15)
   pal(2,1+(3+tripping/8)%15)
   pal(1,1+(2+tripping/8)%15)
   --pal(0,(1+tripping/8)%15)
   tripping = tripping - 1
   --print("yo",8,8,0)
  end 
  map(8*flr(x/8),8*flr(y/8),vx,vy,8,8,0x01)
  
  pal()
  pal(1,tern(flr(water/16)%2==0,12,1))
  map(8*flr(x/8),8*flr(y/8),vx,vy,8,8,0x40)
  
  pal()
  pal(1,tern(flr(water/4)%5==0,12,0))
  pal(2,tern(flr(water/4)%5==1,12,0))
  pal(3,tern(flr(water/4)%5==2,12,0)) 
  pal(4,tern(flr(water/4)%5==3,12,0))
  pal(5,tern(flr(water/4)%5==4,12,0))
  map(8*flr(x/8),8*flr(y/8),vx,vy,8,8,0x80)
  water = water+1
  
  pal()
  
  palt(11,0)
  pal(9,0)
  if mget(x,y) == 4 then
  	spr(13+((m/8)%2),vx+8*(x%8),vy+8*(y%8))
  else
   spr(1+((m/8)%2),vx+8*(x%8),vy+8*(y%8))
  end
  if havebee == 1 and flr(x/8) == flr(prevx/8) and
  flr(y/8) == flr(prevy/8) then
  spr(55+((m/8)%2),vx+8*(prevx%8),vy+8*(prevy%8))
  end
  
  
  pal()
 	clip()
 	camera()
 	rectfill(0,108,128,128,0)
 	print(texts[1],2,109,5)
 	print(texts[2],2,109+6,6)
 	print(texts[3],2,109+12,7)
 end
end
