--blind date: fishy business
--by: white lotus

function _init()
	btnt=0
	gamestate=0
	mood=0
	symb=0
end

function hcenter(s)
	return 64-#s*2
end

function _update()
	if(btnt>0)then btnt-=1 end
	if(gamestate==0)then
		if(btn(—)and btnt==0)then 
			name=""
 		txt1=""
			txt2=""
			txt3=""
			txt4=""
 		aff=2
			btnt=5
			stg=0
			gamestate=1
		end
	end
	
	if(gamestate==1)then
		if(stg==0)then
			name="player thinking"
			txt1="what the hell is this?"
			txt2="they put me in a blind date"
			txt3="with a fish?!?!?!"
			if(btn(—)and btnt==0)then stg=1 btnt=5 end
		end
		if(stg==1)then
			name="player thinking"
			txt1="i guess i will try,she may"
			txt2="be a cool...fish,i will not"
			txt3="judge a book by its cover."
			txt4="i am not that kind of guy!!!"
			if(btn(—)and btnt==0)then stg=2 btnt=5 end
		end
		if(stg==2)then
			name="player"
			txt1="so,what does a cute...fish,"
			txt2="like you do for a living?"
			txt3=""
			txt4=""
			if(btn(—)and btnt==0)then stg=3 btnt=5 end
		end
		if(stg==3)then
			name="fish-san"
			txt1="glub,gluglub,glub glub glub."
			txt2=""
			txt3=""
			txt4=""
			if(btn(—)and btnt==0)then stg=4 btnt=5 end
		end
		if(stg==4)then
			name="player thinking"
			txt1="this really isnt gonna work."
			txt2="why the hell did i even sign"
			txt3="up for this stupid blind"
			txt4="date bullshit???"
			if(btn(—)and btnt==0)then stg=5 btnt=5 end
		end
  if(stg==5)then
   name="player thinking"
   txt1="calm down,this can still go"
   txt2="well,i just need to know"
   txt3="more about... her?"
   txt4="god,what am i even doing?"
   if(btn(—)and btnt==0)then stg=6 btnt=5 end
   end
   if(stg==6)then
    name="player"
    txt1="” so, you like the sea?"
    txt2="ƒ what is your fave season?"
    txt3="‘ what movies do you watch?"
    txt4="‹ say,do you like sushi?"
    if(btn(”)and btnt==0)then stg=7 btnt=5 aff+=1 end
    if(btn(ƒ)and btnt==0)then stg=9 btnt=5 end
    if(btn(‘)and btnt==0)then stg=11 btnt=5 end
    if(btn(‹)and btnt==0)then stg=13 btnt=5 aff-=1 end
   end
   if(stg==7)then
    name="fish-san"
