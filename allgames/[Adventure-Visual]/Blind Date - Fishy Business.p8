			btnt=5
		end
	end
end

function _draw()
	cls()
	if(gamestate==0)then
		map(16,0)
		spr(64,32,11)
		spr(65,40,11)
		spr(66,48,11)
		spr(67,56,11)
		spr(68,64,11)
		spr(69,72,11)
		spr(70,80,11)
		spr(71,88,11)
		spr(80,32,19)
		spr(81,40,19)
		spr(82,48,19)
		spr(83,56,19)
		spr(84,64,19)
		spr(85,72,19)
		spr(86,80,19)
		spr(87,88,19)
		spr(96,32,27)
		spr(97,40,27)
		spr(98,48,27)
		spr(99,56,27)
		spr(100,64,27)
		spr(101,72,27)
		spr(102,80,27)
		spr(103,88,27)
		print("press — to start",hcenter("press — to start"),47,7)
		print("press — to skip text",hcenter("press — to skip text"),53,7)
		print("press ”ƒ‹‘ to choose",(hcenter("press ”ƒ‹‘ to choose")-6),59,7)
		spr(43,56,67)
		spr(44,64,67)
		spr(59,56,75)
		spr(60,64,75)
		print("weekly game jam 88",hcenter("weekly game jam 88"),84,11)
		print("white lotus",hcenter("white lotus"),102,7)
		print("@white_lotuspa",hcenter("@white_lotuspa"),110,7)
	end
	
	if(gamestate==1)then
		map(0,0)
		print(name..":",9,81,10)
		print(txt1,9,87,7)
		print(txt2,9,93,7)
		print(txt3,9,99,7)
		print(txt4,9,105,7)
		if(symb==1)then--hash
			spr(16,48,21)
		end
		if(symb==2)then--exclamation
			spr(32,48,21)
		end
		if(symb==3)then--interrogation
			spr(48,48,21)
		end
		if(symb==4)then--heart
			spr(4,48,21)
		end
		if(mood==0)then--neutral
			spr(22,40,24)
			spr(38,40,32)
		end
		if(mood==1)then--angry
			spr(40,40,24)
			spr(56,40,32)
		end
		if(mood==2)then--love
			spr(41,40,24)
			spr(57,40,32)	
		end
		if(mood==3)then--bored
			spr(42,40,24)
			spr(58,40,32)
		end
		
		print("affection:",81,10,8)
		v=81
		for i=1,4 do
			spr(3,v,16)
			v+=10
		end
		v=81
		for i=1,aff do
			spr(4,v,16)
			v+=10
		end
	end
	
	if(gamestate==2)then
		map(16,0)
		print(txt5,hcenter(txt5),50,9)
		print(txt6,hcenter(txt6),56,9)
		print("press — to restart",hcenter("press — to restart"),62,7)
		print("check out more of my work at",hcenter("check out more of my work at"),96,7)
		print("gpj252.itch.io",hcenter("gpj252.itch.io"),102,9)
		print("or at my twitter",hcenter("or at my twitter"),108,7)
		print("@white_lotuspa",hcenter("@white_lotuspa"),114,9)
	end
end
