    txt2="i cant say i dont understand"
    txt3="why i am still single..."
    txt4="and why a fish is an option"
    if(btn(—)and btnt==0)then stg=27 btnt=5 end
   end
   if(stg==27)then
    name="player thinking"
    txt1="i have to give up...i am a "
    txt2="man,she is a fish..."
    txt3="how would we even..."
    txt4="where would i put it???"
    if(btn(—)and btnt==0)then stg=28 btnt=5 end
   end
   if(stg==28)then
    name="player thinking"
    txt1="what am i even thinking???"
    txt2="i cant believe i am"
    txt3="seriously considering a"
    txt4="fish as my girlfriend"
    if(btn(—)and btnt==0)then stg=29 btnt=5 end
   end
   if(stg==29)then
    name="player"
    txt1="” so, had many boyfriends?"
    txt2="ƒ do you date much?"
    txt3="‘ first time blind dating?"
    txt4="‹ so...this is a date..."
    if(btn(”)and btnt==0)then stg=30 btnt=5 end
    if(btn(ƒ)and btnt==0)then stg=32 btnt=5 end
    if(btn(‘)and btnt==0)then stg=34 btnt=5 aff+=1 end
    if(btn(‹)and btnt==0)then stg=36 btnt=5 aff-=1 end
