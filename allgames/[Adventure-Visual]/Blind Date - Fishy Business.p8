    txt3=""
    txt4=""
    if(btn(—)and btnt==0)then stg=16 btnt=5 end
   end
   if(stg==16)then
    name="player thinking"
    txt1="ok... get your cool back."
    txt2="you can do this, you need"
    txt3="to do this...if i dont i"
