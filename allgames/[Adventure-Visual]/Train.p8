pico-8 cartridge // http://www.pico-8.com
version 5
__lua__
--train by program_ix
--figure out how it works

dial_pos = {{-6,0},{-6,-1},{-5,-2},{-4,-3},{-3,-4},{-2,-4},{-1,-5},{0,-6},{1,-5},{2,-4},{3,-4},{4,-3},{5,-2},{6,-1},{6,0}}
--define switch behaviours
--1: low brake damage, more fuel hungry
--2: more speed, more fuel
--3: less fuel, less speed
function _init()
moving=false
chuff=0
brakes=true
ignition=false
start=false
engine=true
throttle=0
switches={{false,1,56,8,0,10},{false,1,72,8,0,20},{false,1,88,8,0,1}}
x=64
y=64
distance=0
coal=1000
coal_max=1000.0
heat=0
speed=0
brakes_dmg=0
noise_timer_start=300
noise_timer=noise_timer_start

train={
{64,48},
{72,48},
{80,48},
{88,48}}
end

--

function buttons()
--brakes
if(btnp(4,0))
then
brakes=not brakes
end
--ignition
if(btnp(5,0))
then
ignition=not ignition
end
--start
if(btnp(4,1))
then
if(start)
then
start=not start
else
if(ignition)
then
start=not start
end
end

end
--throttle
if(btnp(2,0))
then
if(throttle<8)
then
throttle+=1
end
end
if(btnp(3,0))
then
if(throttle>0)
then
throttle-=1
end
end
--switches
if(btnp(0,1))
then
switches[1][1] = not switches[1][1]
end
if(btnp(3,1))
then
switches[2][1] = not switches[2][1]
end
if(btnp(1,1))
then
switches[3][1] = not switches[3][1]
end
end

--

function add_chuff()
if(coal>0)
then
if(throttle>0)
then
if(chuff<100)
then	
	if(throttle>0)
	then
		chuff+=throttle/10	
	end
else
heat+=1/10
if(switches[1][1])
then
	heat+=1/20
end
end
local coal_used=throttle/10

if(switches[2][1])
then
	coal_used+=throttle/20
end
if(switches[3][1])
then
	coal_used-=throttle/20
end
coal-=coal_used
else

if(chuff>0)
then
chuff-=0.2
else
chuff=0
end
end
else
if(chuff>0)
then
chuff-=0.2
else
chuff=0
end
end
end

--

function add_distance()
	if(chuff>0)
	then
		if(brakes)
		then
			dmg_brakes()
			distance+=chuff/200
		else
			distance+=chuff/50
		end
	end
end

--

function dmg_brakes()
	if(switches[1][1])
	then
		brakes_dmg+=0.5
	else
		brakes_dmg+=1
	end
end

--

function state()
add_distance()
if(ignition)
then
	if(start)
	then
	--	if(throttle>0)
	if(1)
		then
			add_chuff()
		end
	end
else
	if(chuff>0)
	then
		chuff-=1
		if(chuff<0)
		then
			chuff=0
		end
	end
end

end


--

function dial(m,s,x,y)
	if(m>(s-0.01))
	then
		c_dial=15
	else
		if(m>0)
		then
			c_dial=flr(m/(s/15))+1
		else
			c_dial=1
		end
	end
	line(x+dial_pos[c_dial][1],y+dial_pos[c_dial][2],x,y)
end

--

function dials()
--print("chuff",8,64)
--print(chuff,64,64)
--print("speed",8,64)
--print(speed,64,64)
--print("heat",8,72)
--heat dial (horizontal)
if(heat<99)
then
h_dial=(12+(heat*(24/100)))
else
h_dial=35
end
line(h_dial,112,h_dial-1,117,5)
line(h_dial,112,h_dial+1,117,5)
--chuff dial (semi-circular)
--dial(chuff,100.0,104,115)
dial(chuff,100.0,112,11)
dial(switches[1][5],100.0,56,115)
dial(switches[2][5],100.0,72,115)
dial(switches[3][5],100.0,88,115)
dial(chuff,100.0,104,115)
dial(coal,coal_max,120,115)
--alternate heat dial(semi-circular)
--dial(heat,100.0,112,11)

--print(heat,64,72)
print("distance",8,98)
print(distance,64,98)
if(brakes_dmg>10)
then
print("brakes in danger",8,88)
end
end

--

function make_noise(spd)
	noise_timer-=spd
	if(noise_timer<=0)
	then
		--sfx(0)
		noise_timer=noise_timer_start
	end	
end

--

function move_segment(s,spd)
if(s[2]==48) --top side
then
	if(s[1]>=112) --top right
	then
		s[1]=112
		s[2]+=spd
	else
		s[1]+=spd
	end
else
if(s[1]==112) --right side
then
	if(s[2]>=80) --bottom right
	then
		s[2]=80
		s[1]-=spd
	else--
		s[2]+=spd
	end
else
if(s[2]==80) --bottom side
then
	if(s[1]<=8) --bottom left
	then
		s[1]=8
		s[2]-=spd
	else
		s[1]-=spd
	end
else
if(s[1]==8) --left side
then
	if(s[2]<=48) --top left
	then--
		s[2]=48
		s[1]+=spd
	else
		s[2]-=spd
	end
end
end
end
end
end

--

function move_train()
	speed=chuff/50
	if(switches[2][1])
	then
		speed+=chuff/100
	end
	if(switches[3][1])
	then
		speed-=chuff/100
	end

	for t in all(train)
	do
		move_segment(t,speed)
	end
	make_noise(speed)
end

--

function _update()
buttons()
state()
move_train()
end

--

function draw_segment(n,seg)
local sprite=96
--side (orient.)
if(seg[1]==112)--right (down)
then
	mod=0
else
if(seg[2]==80)--bottom (left)
then
	mod=3
else
if(seg[1]==8)--left (up)
then
	mod=6
else
if(seg[2]==48)--top (right)
then
	mod=9
end
end
end
end

if(n==1)
then            
	sprite=96
end
if(n==2)
then
	sprite=97
end
if(n==3)
then
	sprite=98
end
spr(sprite+mod,seg[1],
		seg[2])
end

--

function draw_train()
for t=1,count(train)
do
	if(t==1)
	then
		draw_segment(1,train[t])
	else
	if(t==count(train))
	then
		draw_segment(3,train[t])
	else
		draw_segment(2,train[t])
	end
	end
	
end
end

--

function _draw()
cls()
mapdraw(0,0,0,0,16,16)
--brake lever
if(not brakes)
then
spr(7,8,8)
spr(23,8,16)
spr(24,16,16)
spr(25,24,16)
spr(39,8,24)
spr(21,40,16)
else
spr(12,40,8)
spr(26,24,16)

spr(27,32,16)
spr(28,40,16)
spr(44,40,24)
spr(22,8,16)
end
--throttle knob
spr(62,56+throttle*4,24)
--ignition
if(not start)
then
spr(53,104,24)
else
spr(54,104,24)
end
if(not ignition)
then
spr(2,112,24)
else
spr(3,112,24)
end
--switches
for s in all(switches)
do
if(s[1])
then
spr(5,s[3],s[4])
if(s[5]<100)
then
s[5]+=s[6]
end
else
spr(4,s[3],s[4])
end
end
--gauge
--114,12 line start point
dials()
--sspr(0,96,8,8,28,48,72,16)
--sspr(8,96,8,8,24,64,80,16)
--sspr(16,96,8,8,16,80,96,16)
--line(16,80,28,48,4)
draw_train()
end
























