function _init()
 scrn={}
 drw={}
	scrn.update = func_main_menu
 drw.update = draw_main_menu
	
	cls()
	music(0)
	-- player vars
	pl = {}
	pl.sprite = 3
	pl.dir = 3 -- pl direction
	
	--pl.x = 32 -- pl physical loc
	--pl.y = 40 -- 8,8 is top corner
	
	pl.mx = 3 -- pl map loc 3,4
	pl.my = 4 -- 0,0 is top corner

 pl.x = (pl.mx*8)+8
 pl.y = (pl.my*8)+8
 -- map vars
 mapx = 0 
 mapy = 0  

 -- timer 
 timer = false
 tnan  = flr(time()) --init
 tsec  = flr(time() - tnan) --seconds
 tmin  = 0 -- minutes
 
 -- quest values
 bridge = false
 cross = false
 wood = false
 key = false
 shovel = false
 letter = false
 redegg = false -- is only egg?
 duckp = false
 duckm = false
 duckb = false
 ducka = false
 eggs = 0
 alleggs = false
 gameover = false
 gscore = 0
 invtot = 0 -- out of 5
 secrets = 0 -- out of 
 btnblue = false
 btnred = false
 btnyellow = false
 endtext = 0
 
 -- main menu
 anim = 0
 animx1 = 0
 animx2 = 128
end

-- draw mainmenu
function func_main_menu()
	if btnp(5) then
	 music(-1)
		drw.update = draw_starthunt
		scrn.update = func_starthunt
 end
end

function draw_main_menu()
 rectfill(0,0,128,80,12)
 rectfill(0,80,128,128,3)
	sspr(0,64,32,30,25,7,80,80)--logo

 map(24,25,0,64,16,2)
  
 map(24,27,animx1,70,16,4)
 
 map(24,27,animx2,70,16,4)

 spr(pl.sprite,30,88)
		 pl.sprite +=1
		 animx1-=1
		 animx2-=1
		 if animx1 == -128 then
		 animx1=128
		 end
		 if animx2 == -128 then
		 animx2 = 128
		 end
		 if pl.sprite > 37 or pl.sprite < 35
		 	then pl.sprite=35 end
		 --player.y +=1

rectfill (0,102,128,112,1)
	print("press x to start",32,105,7)
 
 print("2016 jason payne",8,118,10)
 spr(45,72,117)
 print("@syrupneko",80,118) 
end

-- end mainmenu

function _draw()
	cls()
 drw.update() 
end -- end draw()

function _update()
if gending != "a" then
 scrn.update()
end

if gending == "a" then
--  scrn.update = func_endscore
  drw.update = draw_endscore
  if btn(4) and btn(5) then
  run()
  end
end

	if gameover == false then 
 	player_walk()
	end

end -- end update

function player_walk()
	if pl.x == 72 then
		pl.x = 8
		mapx +=8
 end

	if pl.x == 0 then
		pl.x = 64
		mapx -=8
 end

	if pl.y == 72 then
		pl.y = 8
		mapy +=8
 end

	if pl.y == 0 then
		pl.y = 64
		mapy -=8
 end

end

function interface()

	--draw boxes

	rect(8,80,120,120,13)
	rect(80,8,120,70,13)

	-- timer
	spr(13,85,12,1,1)
 if timer == true then
 	gtimer()
 else
 print ("00:00",96,13)
 end
 
 --egg interface
 if eggs < 10 then
			print (eggs,100,23)
		else
			print (eggs,96,23)
	end	

	if redegg == false then
			spr(28,85,22,1,1)
			print (" /12",100,23)
	 else
	 	spr(12,85,22,1,1)
	end

 -- items
 if wood == true then
   spr(8,88,44,1,1)
 end
 
 if cross == true then
   spr(25,88,44,1,1)
 end
 
 if shovel == true then
   spr(9,101,44,1,1)
 end
 
 if key == true then
   spr(43,88,56,1,1)
 end

	 if letter == true then
   spr(42,101,56,1,1)
 end
 
end -- end interface

function func_starthunt()
 if (btn(4)) then
  timer = true
  tnan  = flr(time()) --init
 	tsec  = flr(time() - tnan) --seconds
 	tmin = 0
 	scrn.update = control
 	drw.update = draw_maingame
	end
end

function draw_starthunt()
	interface()
 draw_maingame()
			print ("are you ready for today's",14,86,7)
			print ("\negg hunt race to start?")
	  print ("press z to begin",50,104,12)
end

function reset_puzzle()
 btnblue = false
 btnred = false
 btnyellow = false
 
	mset(43,12,107)--blue
	mset(43,13,123)
	
	mset(59,11,110)--yellow
	mset(59,12,126)
	
	mset(60,20,111)--red
	mset(60,21,127)	
end



function btn_red()
 if btnyellow == true and btnred == false
 then
 sfx(2)
 end

 if btnyellow == true then
 	btnred = true
		mset(60,20,79)
		mset(60,21,95)
		mset(52,20,25)
	else
	reset_puzzle()
 end
end

function btn_blue()
 if btnblue == false then
  btnblue=true
  mset(43,12,79)
  mset(43,13,95)
 end
end

function btn_yellow()
 if btnblue == true then
	 btnyellow = true
		mset(59,11,79)
		mset(59,12,95)
	else
	reset_puzzle()
	end
end


function control()

-- button check  	
 		if (btn(0)) then
		joe = (mget(pl.mx-1,pl.my))
		bob = (fget(joe, 0))
		 if bob == false then
		 nm = pl.x-8
		 pl.sprite = 35
			scrn.update = walk0
			end
		end
		
		if (btn(1)) then
		joe = (mget(pl.mx+1,pl.my))
		  bob = (fget(joe, 0))
		 if bob == false then
		 nm = pl.x+8
		 pl.sprite = 35
			scrn.update = walk1
			end
		end		

  if (btn(2)) then
		joe = (mget((pl.mx),pl.my-1))
  bob = (fget(joe, 0))
		 if bob == false then
		 nm = pl.y-8
		 		 pl.sprite = 19
			scrn.update = walk2
			end
		end
   
		if (btn(3)) then
		joe = (mget((pl.mx),pl.my+1))
  bob = (fget(joe, 0))
		 if bob == false then
		 nm = pl.y+8
			scrn.update = walk3
			end
		end

-- special events

 -- found wood
 if joe == 8 then
  joe=52
  scrn.update=func_wood
  drw.update=func_woodtext
 end
 
-- found key
 if joe == 43 then
  joe=52
  scrn.update=func_key
  drw.update=func_keytext
 end
 
 -- bridge
if bridge == false and wood == true
	then
 	if pl.mx == 20 and pl.my == 20
 		then
 			scrn.update = func_bridge
 	end
end

 -- locked door
		if pl.mx==20 and pl.my==3 and key==false
				then
		  	scrn.update = func_door
	 end
 
 -- mom
	 if pl.mx==4 and pl.my==3 and letter == false
	  then scrn.update = func_mom
	 end
	 
	-- dad
	 if pl.mx==5 and pl.my==3 and letter==false
   then scrn.update = func_door
  end   

 -- eggs
 if fget(mget(pl.mx, pl.my),7) == true
 	then
 	 	if redegg==false then
 				sfx(0)
 				else
 				sfx(1)
 			end
 		redegg = false
 		eggs += 1
 		mset(pl.mx,pl.my,52)
 			if eggs == 12
 				then 
 				scrn.update = foundeggs 
 			end
 end
 
 if fget(mget(pl.mx, pl.my),6) == true
 then
 eggs += 1
 sfx(0)
  if eggs == 1 then
  	redegg = true
  end
 mset(pl.mx,pl.my,52)
 mset(11,19,27)--egg on
 mset(11,22,52)--fleurs off
 mset(10,23,52)
 mset(11,23,52)
 mset(12,23,52)
 mset(12,18,34)--fleurs on
 mset(11,17,34)
 mset(11,16,34)
 mset(12,16,34)
 mset(12,19,34)
 mset(30,5,51)-- r fleurs on
 mset(31,4,51)
 mset(34,3,8) -- wood
 mset(1,5,52) -- rabbit off
 end
 
 -- puzzle
 if pl.mx==60 and pl.my==20
 	then
  if cross == false then
 	 btn_red()
 	end
 end
 
 if pl.mx==43 and pl.my==12
 	then
 	 btn_blue()
 end
 
 if pl.mx==59 and pl.my==11
 	then
 	 btn_yellow()
 end
 
 -- found cross
 
  if joe == 25 then
  joe=52
  scrn.update=func_cross
  drw.update=func_crosstext
 	end
 
 -- found shovel
  if joe == 9 then
  joe=52
  scrn.update=func_shovel
  drw.update=func_shoveltext
 	end
 	
 -- found letter
  if pl.mx==60 and pl.my==4 and letter==false then
  scrn.update=func_dig
  drw.update=func_digtext
 	end
 
 -- found key
 if joe == 42 then
  joe=52
  scrn.update=func_letter
  drw.update=func_lettertext
 end
 
 -- cemetary entrance
 if pl.mx==52 and pl.my==8 and cross==false
 then
  drw.update=draw_cemetary
 	scrn.update=func_cemetary
 end
 
 -- grave stones

end		-- end control
 

function draw_maingame()
--draw map
 interface()
	mapdraw (mapx,mapy,8,8,8,8)

-- draw player
	if pl.dir != 0 then
 	spr(pl.sprite,pl.x,pl.y,1,1)	
  else
  spr(pl.sprite,pl.x,pl.y,1,1,true)
	end

-- draw text

-- mom
 if eggs < 12 and letter == false 
  then
   if pl.mx==4 and pl.my==3 then
   print ("mom: you have "
  	,14,86,7)
  	print ((12-eggs),70,86,(15-eggs))
  	print ("eggs", 80,86,7)
  	print ("\nremaining, dear.",34,86)
			print ("press z",70,100,12)
   end
 else
 end  
-- dad
   if pl.mx==5 and pl.my==3 and letter==false then
   print ("dad: hurry! the clock"
  	,14,86,7)
  	print ("\nis ticking! ",34,86)
			print ("press z",70,100,12)
   end

-- door
  if pl.mx==20 and pl.my==3 and key == false
	 	then
			print ("the door is locked.",24,90,7)
			print ("press z",70,100,14)
		end
		
		if pl.mx==20 and pl.my==3 and key == true
			then
			--	if redegg==false then
					--sfx(2)
					gameover = true
					scrn.update = end_door
	    drw.update = end_doortext				
			--	else
			--	end
  end
  
-- bridge
 if pl.mx==20 and pl.my==20
 	and wood==true then
   print ("the gap looks short enough",14,86,7)
			print ("\nfor your board to fit.",14,86,7)

			print ("press z to leave",14,100,12)	  
   print ("\npress x to place board",14,100,8)
	end
-- duck

	if joe == 29 and pl.my < 14
	 then
	 	if redegg==true
	 		then
	 		duckp=true
	 		mset(50,5,51)
	 		print ("duck: quack",14,86,8)
	  else
	   print ("duck: quack",14,86,7)
	 	end
 end
 
 if joe==29 and pl.my > 19 and pl.my < 23
 	then
 		if redegg==true then
 			duckm=true
 			mset(52,5,51)
	 		print ("duck: quack",14,86,8)
	  else
	   print ("duck: quack",14,86,7)
 		end

 end
 
  if joe==29 and pl.mx >52 and pl.my > 25
 	then
 		if redegg==true then
 			duckb=true
 			mset(54,5,51)
	 		print ("duck: quack",14,86,8)
	  else
	   print ("duck: quack",14,86,7)
  	end
  end
 
 if duckp == true and duckm==true
  and duckb==true then
  ducka=true
 end
-- rabbit 
 if joe == 53 then
		print ("rabbit: *sniff* *sniff*"
			,14,86,7)
 end

-- cemetary graves
 if pl.mx==50 and pl.my==04 then
 			print ("\"r.i.p. papa duck\"" ,14,86,7)
 end
 
 if pl.mx==52 and pl.my==4 then
 			print ("\"r.i.p. mama duck\"" ,14,86,7)
 end

 if pl.mx==54 and pl.my==4 then
 			print ("\"r.i.p. baby duck\"" ,14,86,7)
 end
 
 if pl.mx==52 and pl.my==1 then
 			print ("\"r.i.p. freetime\"" ,14,86,7)
 end
 
 if pl.mx==50 and pl.my==1 then
 		print ("\"r.i.p. mr tortoise" ,14,86,7)
 		print ("\nhe won by a hare\"" ,14,86,7)
 end
  

-- if pl.mx==54 and pl.my==1 then
--   text_redgrave()
-- end
 
 if joe==62 and redegg==true then
   gameover = true
   drw.update = text_gravend
 end
 
 if ducka==true and redegg==true
 	then
 		mset(54,0,62)
				if pl.mx==54 and pl.my==1 then
			 gameover = true
   	drw.update = text_gravend
   	end
 	else 
	 	mset(54,0,30)
 	 	if pl.mx==54 and pl.my==1 then
 	print ("\"r.i.p. quackers" ,14,86,7) 
 	print ("\nkeeper of the red egg\"" ,14,86,7)
   	end
 end

end -- end draw_maingame

function gtimer()

	if gameover == false then
		draw_gtimer()
		tsec = flr(time() - tnan)
			if tsec == 60 then
				tmin += 1
	 		tnan = flr(time())
			end 
 else
 	draw_gtimer()
 end
 
end -- end gtimer

function draw_gtimer()
		if tmin < 10 then
 			print (tmin,100,13)
 		else
 			print (tmin,96,13)
 	end
 
 	if tsec < 10 then  
 		print (":0",104,13)	
			print (tsec,112,13)
		else
			print (":",104,13)
		 print (tsec,108,13)
		end
end

function func_door()
  if btn(4) then
 		 nm = pl.y+8
 		 scrn.update = walk3
 	end
end

function foundeggs()
	drw.update = draw_foundeggs
	if btn(4) then
		scrn.update = control
  drw.update = draw_maingame
	end
end

function draw_foundeggs()
 draw_maingame()
 if key==false then
  print ("you found all the eggs.",14,86,7)
		print ("\nnow return to your mother",14,86,7)
  print ("to finish the egg hunt.",14,98,7)
		print ("press z",85,110,12)
 else
  print ("you found all the eggs.",14,86,7)
		print ("press z",85,98,8)
 end
end

function func_mom()
 if eggs < 12 then
 		if btn(4) then
				nm = pl.y+8
 		 scrn.update = walk3
		end
	end
	
	if eggs == 12 then
	 gameover=true
	 endtext=0
	 scrn.update = func_endrace
	end
end

function func_wood()
  if btn(5) then
  	sfx(0)
  	invtot +=1
 		wood = true
			mset(34,3,52) -- grass
			mset(12,20,51) -- r fleurs
  	mset(13,21,51)
  	mset(14,21,51)
  	mset(15,21,51)
  	mset(30,5,52)-- r fleurs off
  	mset(31,4,52)
 		 scrn.update = control
 		 drw.update = draw_maingame
 	end
 	
  if btn(4)
  	then
  		 scrn.update = control
 		 drw.update = draw_maingame	
  end		
  
end

function func_woodtext()
	mapdraw (mapx,mapy,8,8,8,8)
	draw_maingame()
			print ("it's a wooden board.",14,86,7)

			print ("press z to leave it",14,100,12)	  
   print ("\npress x to pick it up",14,100,8)
end

function func_key()
  if btn(5) then
  	sfx(0)
  	invtot +=1
 		key = true
   mset(5,3,51)
 		 scrn.update = control
 		 drw.update = draw_maingame
 	end
 	
  if btn(4)
  	then
  		 scrn.update = control
 		 drw.update = draw_maingame	
  end		
  
end

function func_keytext()
	mapdraw (mapx,mapy,8,8,8,8)
	draw_maingame()
			print ("you found a silver key.",14,86,7)

			print ("press z to leave it",14,100,12)	  
   print ("\npress x to pick it up",14,100,8)
end
--
function func_cross()
  if btn(5) then
  	sfx(0)
  	secrets +=1
  	invtot +=1
 		cross = true
   mset(52,20,78)
 		 scrn.update = control
 		 drw.update = draw_maingame
 	end
 	
  if btn(4)
  	then
  		 scrn.update = control
 		 drw.update = draw_maingame	
  end		
  
end

function func_crosstext()
	mapdraw (mapx,mapy,8,8,8,8)
	draw_maingame()
			print ("you found a gold cross.",14,86,7)

			print ("press z to leave it",14,100,12)	  
   print ("\npress x to pick it up",14,100,8)
end

function func_shovel()
  if btn(5) then
  	sfx(0)
  	invtot +=1
 		shovel = true
			mset(38,3,54) -- grass
 		 scrn.update = control
 		 drw.update = draw_maingame
 	end
 	
  if btn(4)
  	then
  		 scrn.update = control
 		 drw.update = draw_maingame	
  end		
  
end

function func_shoveltext()
	mapdraw (mapx,mapy,8,8,8,8)
	draw_maingame()
			print ("you found a shovel.",14,86,7)

			print ("press z to leave it",14,100,12)	  
   print ("\npress x to pick it up",14,100,8)
end

function func_dig()
  if btnp(5) and shovel == true and letter == false then
  	sfx(0)
  	invtot +=1
			mset(4,2,52) -- grass
			mset(4,3,52)
			mset(5,2,52)
			mset(1,5,52)  
			mset(5,3,43) -- key
			mset(60,4,42)
  	scrn.update = func_letter
   drw.update = func_lettertext
 	end
 	
  if btnp(4)
  	then
			nm = pl.x-8
  	scrn.update = walk0
 		drw.update = draw_maingame	
  end		
end

function func_digtext()
	mapdraw (mapx,mapy,8,8,8,8)
	draw_maingame()
  if letter==false then
			print ("you hear whimpering",14,86,7)
   print ("coming from beneath you.",14,92,7)   
   print ("press z to run away",14,100,12)
  end 
 if shovel == true and letter==false then
   print ("\npress x to dig",14,100,8)
 end
end

function func_found_key()
  if btn(4) then
 	nm = pl.x-8
  	scrn.update = walk0
 		drw.update = draw_maingame
  end
end

function func_letter()
  if btnp(5) and letter==false then
  	sfx(0)
 		letter = true 
 	end
 	  
  if btnp(4) and letter==true
  	then
  	scrn.update = control
 		drw.update = draw_maingame
 	end
end

function func_lettertext()
	mapdraw (mapx,mapy,8,8,8,8)
	draw_maingame()
  if letter==false then
			print ("you found a letter.",14,86,7)
   print ("it's addressed to you.",14,92,7)   
   print ("press x to read it",14,100,8)
    --print ("\npress x to read it",14,100,8)
  end
  if letter==true then
  	print ("\"please come home.\"",14,86,7)
   print ("press z",76,100,12)
  end	  
end

function draw_cemetary()
	mapdraw (mapx,mapy,8,8,8,8)
	draw_maingame()
 print ("an invisible force",14,86,7)
 print ("\nblocks your path.",14,86,7)
 print ("press z",70,98,12)
end

function func_cemetary()
		if btn(4) then
			nm = pl.y+8
  	scrn.update = walk3
 		drw.update = draw_maingame
  end
end

function func_bridge()
  if btn(5) then
    secrets += 1
 		 wood = false
 		 bridge = true
 		 mset(21,20,41)
 		 mset(21,21,57)
 		 scrn.update = control 
 	end
 	
  if wood == true and btn(4)
  	then
  	nm = pl.x-8
 		 scrn.update = walk0
  end		
end


-- endings

function func_endrace() --end 1
drw.update = draw_endrace 

	if btnp(5) then
 	endtext+=1		
	end


 if endtext == 1 then
  gending = "c"
  drw.update = draw_endscore
  scrn.update = func_endscore
 end

end


function draw_endrace()
 
	if endtext==0 then
	 interface()
  rectfill(30,30,50,70,1)
	 circfill(40,28,17,12)
	 circfill(40,28,14,1)
	 print("winner",29,26,7)


	 print ("congratulations!!!", 14,86,7)
		print ("you finished the egghunt",14,92,7)
  if tsec > 9 then
  		print ("\nin just " .. tmin .. ":" .. tsec .. "! way to go!",14,92,7)  
  	else
  		print ("\nin just " .. tmin .. ":0" .. tsec .. "! way to go!",14,92,7)  
  end
	 print ("your family is proud!",14,104,7)
	 print ("press x",85,110,8)
	end	
end

function end_door()
	if btnp(5) then
	 if endtext==0 then
	 	sfx(2)
	 end
 	endtext+=1		
	end

 if endtext == 5 then
  pl.my -=1
  gending = "b"
  drw.update = draw_endscore
  scrn.update = func_endscore
 end
end

function end_doortext()
 interface()
	if endtext == 0 then
		draw_maingame()
 	print ("the key fit perfectly.",14,86,7)
 	print ("press x",85,110,8)
	end
 
	if endtext == 1 then
		print ("mom...", 14,86,7)
		print ("press x",85,92,8)
	end

	if endtext==2 then
		print ("     dad!",14,92,7)
		print ("press x",85,102,8)
	end

 	if endtext==3 then
		print ("i'm home!",14,86,7)
		print ("press x",85,102,8)
	end
	
 if endtext==4 then
 mapdraw (0,24,8,8,8,8)
 print ("press x",85,102,8)
 end
end

function func_gravend()
 if btn(5) and endtext==0 then
  endtext+=1
  sfx(3)
 end
 
 if btnp(4) and endtext==5
 then
 endtext+=1
 end

end

function text_gravend()
 scrn.update = func_gravend
 interface()
 if endtext==0 then
   print("a supernatural energy",14,86,7)
   print("overwhelms your senses.",14,92,7)

   print("\npress x ",78,100,8)
  
   mapdraw (mapx,mapy,8,8,8,8)
   spr(pl.sprite,pl.x,pl.y)    
   
   spinplayer()   	   
   beamy=0
   beamc=0
 end
 
 if endtext==1 then
   spinplayer()
		 mapdraw (mapx,mapy,8,8,8,8)
   --spr(pl.sprite,pl.x,pl.y)
  
   if beamy < 26 then
   	rectfill(56,0,65,beamy,beamc)
   	beamy+=.5
   	beamc+=.25
   end
  
   if beamc == 14 then
   	beamc = 1 
   end
   spr(pl.sprite,pl.x,pl.y)    
   if beamy==25 then
  	 endtext+=1
   end
 end
 
 if endtext==2 then
   spinplayer()
 		mapdraw (mapx,mapy,8,8,8,8)
   if beamy > (-10) then
   rectfill(56,0,65,beamy,beamc)
   beamy-=.5
   beamc+=.25
   pl.y-=.5
   end
   if beamc == 14 then
   	beamc = 1 
   end
   spr(pl.sprite,pl.x,pl.y)
   if beamy==(-9) then
    pl.sprite=3
    pl.x=40
   	endtext+=1
   end
 end
 
 if endtext==3 then
  spinplayer()
 		--mapdraw (mapx,mapy,8,8,8,8)
   if beamy < 56 then
   rectfill(38,0,48,beamy,beamc)
   beamy+=.5
   beamc+=.25
   pl.y+=.5
   end
   if beamc == 14 then
   	beamc = 1 
   end
   spr(pl.sprite,pl.x,pl.y)
   if beamy==55 then
    pl.sprite=3
   	endtext+=1
   end  
 end
 
 if endtext==4 then
		if beamy > (-10) then
   rectfill(38,0,48,beamy,beamc)
   beamy-=.5
   beamc+=.25
  end
  
   if beamc == 14 then
   	beamc = 1 
   end
   spr(pl.sprite,pl.x,pl.y)
   if beamy==(-9) then
    music(0)
   	endtext+=1
   end
 end
 
 if endtext==5 then
  mapdraw (40,24,8,8,8,8)
  spr(29,24,36,1,1,true,false)
  spr(pl.sprite,pl.x,pl.y)
   print("it's an egghunt party",14,86,7)
   print("the end",14,92,7)
   print("\npress z",78,100,12)
 end
 
 if endtext==6 then
  music(-1)
  pl.my -=1
  secrets +=1
  gending="a"
 end
end

function spinplayer()
  pl.sprite+=1
  if pl.sprite==6 then pl.sprite=19 end
  if pl.sprite==22 then pl.sprite=35 end
    if pl.sprite==38 then pl.sprite=3 end
end

function func_endscore()

	if btn(4) and btn(5) then
	 run()
	end
 
end

function draw_endscore()
	scrn.update=func_endscore
	draw_maingame()
	rectfill(7,7,72,72,5)	
 print ("eggs: " .. eggs .. "/12",12,14,7)
 print ("items: " .. invtot .. "/5",12,22,7)
 print ("secrets:" .. secrets .. "/3",12,30)
	if tsec > 9 then
 	print ("runtime: " .. tmin .. ":" .. tsec,12,38) 
 else
 	print ("runtime: " .. tmin .. ":0" .. tsec,12,38)
 end
 print ("\nending: " .. gending,12,50)
 print ("press z+x",14,95,8)
end

--end endings

-- walking

function walk0() -- left
	if pl.x > nm then
	  pl.dir = 0
 		pl.x -= 1
		 pl.sprite +=1
		 if pl.sprite > 37
		 	then pl.sprite=35 end
		 --player.y +=1
 end

		if pl.x <= nm then
  cls()
   scrn.update = control
		 pl.mx -=1
			pl.sprite = 35
 	end

end

function walk1() -- right
	if pl.x < nm then
   pl.dir = 1
 		pl.x += 1
		 pl.sprite +=1
		 if pl.sprite > 37
		 	then pl.sprite=35 end
		 --player.y +=1
 end

		if pl.x >= nm then
  cls()
   scrn.update = control
		 pl.mx +=1
			pl.sprite = 35
 	end

end


function walk2() -- up
	if pl.y > nm then
	  pl.dir = 2
 		pl.y -= 1
		 pl.sprite +=1
		 if pl.sprite > 21
		 then pl.sprite=19 end
		 --player.y +=1
 end

		if pl.y <= nm then
  cls()
   scrn.update = control
		 pl.my -=1
			pl.sprite = 19
 	end

end

function walk3() -- down
	if pl.y < nm then
   pl.dir = 3
 		pl.y += 1
		 pl.sprite +=1
		 if pl.sprite > 5
		 	then pl.sprite=4 end
		 --player.y +=1
 end

		if pl.y >= nm then
  cls()
   scrn.update = control
		 pl.my +=1
			pl.sprite = 3
 	end
end
