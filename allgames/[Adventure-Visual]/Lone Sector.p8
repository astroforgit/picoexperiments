pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
-- lone sector
-- by ivan joukov

function _init()
 create_stars()
	create_ship()
	create_missions()
	create_text()
	titlescreen()
end


function _update()
	move_ship()
	update_cam()
	check_dial()
end


function _draw()
 cls()
 draw_stars()
 draw_map()
	draw_ship()
	logbook()
end
-->8
-- ship

function create_ship()
	ship={
  x=55,
  y=24,
	 facing=2
	 }
end

function move_ship()

 newx=ship.x
 newy=ship.y
 
	if btnp(0) then
	 newx-=1 
	 ship.facing=4
 elseif btnp(1) then
	 newx+=1 
	 ship.facing=2
 elseif btnp(2) then
	 newy-=1 
	 ship.facing=1
 elseif btnp(3) then
	 newy+=1 
	 ship.facing=3
 end
 
 -- collision with tag 0
 
 if not check_tile(0,newx,newy) 
 	then
 	ship.x=newx
  ship.y=newy
 end 
 
 -- map loop
 
 if (ship.x<0) ship.x=127
 if (ship.x>127) ship.x=0
 if (ship.y<0) ship.y=63
 if (ship.y>63) ship.y=0
end

function draw_ship()
	spr(ship.facing,
	    ship.x*8,
	    ship.y*8)
end
-->8
-- space

-- full map and cam position

function draw_map()
	map(0,0,0,0,128,64)
	camera(camx*8,camy*8)
	-- golden asteroid
	if asteromined==false then
	 mset(88,22,25)
	 else mset(88,22,58)  
 end
end

-- cam coordinates

function update_cam()
	camx=flr(ship.x/16)*16
	camy=flr(ship.y/16)*16
end

-- background stars gen

function create_stars()
 starx={}
 stary={}
	for i=1,1600 do
		add(starx,flr(rnd(128*8)))
		add(stary,flr(rnd(128*4)))
	end
end

-- background stars draw

function draw_stars()
	for i=1,800 do
		pset(starx[i],stary[i],7)
	end
	for i=801,1000 do
		pset(starx[i],stary[i],6)
	end
	for i=1001,1400 do
		pset(starx[i],stary[i],10)
	end
	for i=1401,1600 do
		pset(starx[i],stary[i],12)
	end
end
-->8
-- missions

function create_missions()
 credits=0
 sputnik=false
	heatshield=false
	hyperdrive=false
	fuel=false
	translator=false
	submarine=false
	anomaly=false
	asteromined=false
	pseudoearth=false
	stationvisit=false
	pearl=false
	subvisit=false
end

-- draw text function

function draw_text(txtnmb)
 sfx(2)
 rectfill((camx*8)+10,
          (camy*8)+80,
          (camx*8)+117,
          (camy*8)+120,
          1)
          
 	print(text[txtnmb],
	      (camx*8)+12,
	      (camy*8)+82,10)	
	      
	 print("— to close",
	       (camx*8)+74,
	       (camy*8)+115,8)     
	      
	 repeat flip() until btn(5)           	
end

-- flag checks to start texts

function check_dial()

 -- first planet 0,1,2
	if check_tile(1,newx,newy)
	and check_tile(2,newx,newy)
	 then draw_text(1)	
 end
 
 -- sputnik 0,1,3
 
 if check_tile(1,newx,newy)
 and check_tile(3,newx,newy)
	 then 
	 if sputnik==false then
	  draw_text(2)
	  sputnik=true
	  credits+=500
	  else draw_text(3) 
	 end 
 end
 
 -- sun 0,1,4
 
 if check_tile(1,newx,newy)
 and check_tile(4,newx,newy)
	 then 
	 if heatshield==false then
	  draw_text(4) 
	 end 
	 if fuel==true then
	 	draw_text(6)
  end
	 if heatshield==true 
	 and fuel==false then
	 	draw_text(5)
	 	fuel=true
	 end 
 end
 
 -- wreck 0,1,5
 
 if check_tile(1,newx,newy)
 and check_tile(5,newx,newy)
	 then 
	 if hyperdrive==false then
	  draw_text(7)
	  hyperdrive=true
	  else draw_text(8) 
	 end 
 end
 
-- gold asteroid 0,1,6

 if check_tile(1,newx,newy)
	and check_tile(6,newx,newy)
	 then draw_text(9)
	 credits+=1200
	 asteromined=true	
 end
 
-- pseudoearth 0,1,7 
 
 if check_tile(1,newx,newy)
	and check_tile(7,newx,newy)
	 then
	 if pseudoearth then	 
	 	if translator then
	 		draw_text(12)
	 	else
	 	 if credits<700 then
	 	 	draw_text(10)
	 	 else
	 	  draw_text(11)
	 	  credits-=700
	 	  translator=true
    end	
			end
		else 
		 draw_text(10)
		 pseudoearth=true	
  end
 end
 
-- endor 0,2,3

 if check_tile(2,newx,newy)
	and check_tile(3,newx,newy)
	 then draw_text(13)	
 end
 
-- big barren 0,2,4

 if check_tile(2,newx,newy)
	and check_tile(4,newx,newy)
	 then draw_text(14)	
 end
 
-- fungus planet 0,2,5

 if check_tile(2,newx,newy)
	and check_tile(5,newx,newy)
	 then draw_text(15)	
 end 
 
-- green giant 0,2,6 

 if check_tile(2,newx,newy)
	and check_tile(6,newx,newy)
	 then draw_text(16)	
 end
 
-- green giant moon 0,2,7 

 if check_tile(2,newx,newy)
	and check_tile(7,newx,newy)
	 then
	 if translator then
	  draw_text(18)
	 else draw_text(17)
	 end	
 end
 
-- small gas planet 0,3,4

 if check_tile(3,newx,newy)
	and check_tile(4,newx,newy)
	 then draw_text(19)	
 end
 
-- alien station 0,3,5

 if check_tile(3,newx,newy)
	and check_tile(5,newx,newy)
	 then
	 if translator then
	  if heatshield then
	   draw_text(22)
	  elseif stationvisit and credits>=8000
	   then draw_text(21)
	        heatshield=true
	        credits-=8000
	   else draw_text(20) 
	        stationvisit=true    
	  end 
	 else draw_text(17)
	 end	
 end
 
-- treasure planet 0,3,6 

 if check_tile(3,newx,newy)
	and check_tile(6,newx,newy)
	 then 
	 if submarine then
	  if pearl then
	   draw_text(25)
	   else draw_text(24)
	        credits+=8000
	        pearl=true 
	  end      
	  else draw_text(23)
	 end 	
 end
 
-- gas giant 0,3,7 

 if check_tile(3,newx,newy)
	and check_tile(7,newx,newy)
	 then draw_text(26)	
 end
 
-- huge ocean planet 0,4,5

 if check_tile(4,newx,newy)
	and check_tile(5,newx,newy)
	 then 
	 if submarine then draw_text(28)
	 else draw_text(27)	
	 end
 end

-- submarine station 0,4,6

 if check_tile(4,newx,newy)
	and check_tile(6,newx,newy)
	 then
	 if translator then
	  if submarine then
	   draw_text(31)
	  elseif subvisit and credits>=1000
	   then draw_text(30)
	        submarine=true
	        credits-=1000
	   else draw_text(29) 
	        subvisit=true    
	  end 
	 else draw_text(17)
	 end	
 end

-- anomaly 0,4,7

 if check_tile(4,newx,newy)
	and check_tile(7,newx,newy)
	 then 
	 if anomaly then
	  if fuel and hyperdrive then
	   endgame()
	  else draw_text(33)
	  end
	 else draw_text(32)
	      anomaly=true 
	 end
 end
 
end

-- all texts table with index

function create_text()
	text={
	-- 1 first planet 0,1,2
	"a small desert rock.\n\nnothing interesting here.",
	-- 2 sputnik before 0,1,3
	"bip... bip... bip...\n\nthis old probe is worth\n500$ of salvage.",
	-- 3 sputnik after 0,1,3
	"bip... bip... bip...\n\nnothing else to salvage.",
	-- 4 star without heatshield
	"the star is too hot.\n\ni could scoop its gas\nwith a heatshield.",
	-- 5 star with heatshield
	"heatshield on.\n\nnow i can scoop the gas\nand fill the fuel tank.",
	-- 6 star with fuel
	"i have enough fuel.",
	-- 7 wreck before
	"this is an old wreck but\nthe hyperdrive seems\nin good condition.\n\ni can install it onboard!",
	-- 8 wreck after
	"nothing else to salvage\nin this old thing.",
	-- 9 gold asteroid
	"one of those rocks is made\nof gold!\n\nyou mine 1200$.",
	-- 10 pseudoearth first time
	"humans live here. they\noffer a translator to\ncommunicate with aliens\naround for 700$.",
	-- 11 pseudoearth sell translator
	"you buy the translator\nfor 700$.",
	-- 12 pseudoearth after
	"humans here have nothing\nleft to offer.", 
	-- 13 endor like
	"a small forest planet\npopulated by little bear\nlike pacific creatures.",
	-- 14 huge barren
	"this planet is a huge\nbarren land.\n\nnothing here.", 
	-- 15 fungus planet 
	"a strange world covered\nby luminescent fungi.\n\ncertainly nothing to find\nhere.",
	-- 16 green giant
	"this green gas giant is\nempty but it seems that\nthere is life on its moon.",
	-- 17 no translator message
	"you cannot communicate\nwith aliens living here\nwithout a translator.", 
	-- 18 green satellite translator
	"creatures living here\nspeak about a treasure\ndeep in the ocean of\na small blue planet.", 
	-- 19 small gas planet
	"this is a tiny gas planet\nand you detect nothing\ninteresting on it.",
	-- 20 station before
	"aliens here can produce\na heatshield for your\nship but it would cost\n8000$.",
	-- 21 station buy
	"you buy the heatshield\nfor 8000$.",
	-- 22 station after
	"aliens have nothing left\nto offer.",
 -- 23 treasure planet without sub
 "a small ocean covered\nworld. you cannot see\nwhat's under water.",
 -- 24 treasure planet with sub
	"with your submarine tech\nyou dive deep under the\nocean and find a huge\nastral pearl worth\n7500$ !",   
	-- 25 treasure planet after
	"you detect nothing left\nunder the waves.", 
	-- 26 gas giant like jupiter
	"this gorgeous gas giant\nreminds you of your good\nold jupiter...", 
	-- 27 giant ocean without sub
	"this huge planet is\ncovered by an ocean.",
	-- 28 giant ocean with sub 
	"with your submarine tech\nyou dive under the ocean\nbut there is nothing\ninteresting...",
	-- 29 sub station before
	"aliens here can produce\na submarine for your\nship but it would cost\n1000$.",
	-- 30 sub station buy
	"you buy the submarine\nfor 1000$.",
	-- 31 sub station after
	"aliens have nothing left\nto offer.",
 -- 32 anomaly before
 "this space-time anomaly\ncould warp you back home.",
	-- 33 anomaly after
	"you need to refuel and\nrepair your hyperdrive\nto warp from here.",
	     }
	    
end

-->8
-- game engine - ui

-- collision test
-- returns flag from x,y
-- to use with newx newy

function check_tile(flag,x,y)
	tile=mget(x,y)
	return fget(tile,flag)
end

-- title screen and intro

function titlescreen()
 cls()
 music(0)
 
	print("’ lone sector ’",
	      30,10,12)
	print("a game by ivan joukov",
	      20,22,9)  
	      
	spr(64,0,40,4,4)               
	spr(2,55,60)
	spr(34,30,80,2,2)
	spr(11,111,40,2,4)
	spr(6,90,70)
	
	print("press — to start",
	       30,
	       110,9)
	
 repeat flip() until btn(5)
 
 -- intro
 
 music(-1,2000)
 sfx(0)
 warp() 
 
 -- start message
 
 cls()
 update_cam()
 draw_stars()
 draw_map()
	draw_ship()
	
	rectfill((camx*8)+10,
	          (camy*8)+10,
	          (camx*8)+117,
	          (camy*8)+117,9)
	rectfill((camx*8)+12,
	          (camy*8)+12,
	          (camx*8)+115,
	          (camy*8)+115,1)
	          
	print([[
	
hyperdrive just blew out.
you land in the middle of 
nowhere. in this sector,
alone, you will have to
find a way to repair, to
refuel and warp back home.


at any time press Ž to 
open your log and sector
map.
	]],
	       (camx*8)+13,
	       (camy*8)+13,9) 
	          
	print("press — to close",
	       (camx*8)+30,
	       (camy*8)+110,9)            
	
	repeat flip() until btn(5)
 
end

-- logbook

function logbook()

 if btn(4) then
 
  -- window
 
	 rectfill((camx*8)+10,
	          (camy*8)+10,
	          (camx*8)+117,
	          (camy*8)+117,9)
	 rectfill((camx*8)+12,
	          (camy*8)+12,
	          (camx*8)+115,
	          (camy*8)+115,1)
	          
	 print("logbook",
	       (camx*8)+14,
	       (camy*8)+14,10) 
	       
	 print(credits,
	       (camx*8)+90,
	       (camy*8)+14,9) 
	       
	 print("$",
	       (camx*8)+110,
	       (camy*8)+14,10) 
	       
	 -- log
	 
	 if hyperdrive then
	 	print("hyperdrive ok",
	 	      (camx*8)+19,
	 	      (camy*8)+24,9)
	 end
	 if translator then
	 	print("translator ok",
	 	      (camx*8)+19,
	 	      (camy*8)+31,9)	       	      
  end
  if submarine then
	 	print("submarine ok",
	 	      (camx*8)+19,
	 	      (camy*8)+38,9)	       	      
  end       
  if heatshield then
	 	print("heatshield ok",
	 	      (camx*8)+19,
	 	      (camy*8)+45,9)	       	      
  end 
  if fuel then
	 	print("fuel ok",
	 	      (camx*8)+19,
	 	      (camy*8)+52,9)	       	      
  end
  if fuel and hyperdrive then
  	print("warp",
  	      (camx*8)+90,
  	      (camy*8)+31,10)
  end
  if fuel and hyperdrive then
  	print("ready",
  	      (camx*8)+88,
  	      (camy*8)+38,10)
  end                      
	          
	 -- minimap
	 
	 print("sector map",
	       (camx*8)+44,
	       (camy*8)+68,10)
	 
	 x1minimap=(camx*8)+31
	 y1minimap=(camy*8)+75
	 x2minimap=(camx*8)+95
	 y2minimap=(camy*8)+107
	 
	 rect(x1minimap,
	      y1minimap,
	      x2minimap,
	      y2minimap,11)
	      
	      -- horizontal lines
	 
	 for i=1,3 do
	  line(x1minimap,
	       y1minimap+(8*i),
	       x2minimap,
	       y1minimap+(8*i),11)
	 end             
	      -- vertical lines
	      
	 for i=1,7 do
	  line(x1minimap+(8*i),
	       y1minimap,
	       x1minimap+(8*i),
	       y2minimap,11)
	 end 
	      
	      -- quadrant highlight
	      
	 rect(x1minimap+(camx/2),
	      y1minimap+(camy/2),
	      (x1minimap+8)+(camx/2),
	      (y1minimap+8)+(camy/2),
	      8)
	      
	 print("x",
	       3+x1minimap+(camx/2),
	       2+y1minimap+(camy/2),
	       10)                     
	          
	 print("press — to close",
	       (camx*8)+30,
	       (camy*8)+110,9)         
	          
	 repeat flip() until btn(5)
	 
	end
end

-- end anim and screen

function endgame()
	
	sfx(0)
	warp()
	music(0)
	cls(1)
	rectfill(0,0,1,127,10)
	rectfill(0,0,127,1,10)
	rectfill(0,126,126,127,10)
	rectfill(126,0,127,127,10)
	
	print(
[[
you enter the anomaly and
start your warp drive. at
the end of the tunnel you
land near the moon. your 
moon. you start to approach
the earth. but is it still
the earth you left before
visiting the lone sector ?


game by ivan joukov.
warp animation by
 princesschoochoo.
 
thanks for playing !
 
press Ž to restart
]]	
	,10,10,10)
	
	repeat flip() until btn(4)
	music(-1)
	_init()
end
-->8
-- intro hyper space
-- from @princesschoochoo

function warp()

p={}
w=1
t=0

 for i=1,2*128 do
  p[i]={x=rnd(128),
       y=rnd(128)
       }
 end

::l::

cls(0)

 for a in all(p) do
 x=a.x
 y=a.y
 a.x=(a.x-64)*w+64
 a.y=(a.y-64)*w+64
 
 line(x,y,a.x,a.y,6+rnd(2))
 
  if w>1.2 then
   pset(x,y,12)
  end
 
  if abs(a.x-64)>64 
  or abs(a.y-64)>64
  then 
  a.x=rnd(128)
  a.y=rnd(128)
  end
 
 w=min(1.3,w+0.003)
 end 
 
 flip()
 t+=1
 
 if t<90 then goto l end

end
