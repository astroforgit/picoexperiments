pico-8 cartridge // http://www.pico-8.com
version 11
__lua__
function _init()
 --console
 o = {} 
 --all grid
 g = create_grid(8,8,0)
 t = create_grid(8,8,0)
 c = create_grid(8,8,0)
 --grid position
 px = 1
 py = 1
 --the value to found
 val = 0.6+rnd(0.2)
 
 try_left = 3
 error_left = 5
 win = 0
 --particles
 particles = {}
 --place value in list 
 for x=1,8 do for y=1,8 do
  c[x][y] = 0
  t[x][y] = 1
 end end
 --
 for i=0,error_left do
  local xo=1+flr(rnd(7))
  local yo=1+flr(rnd(7))
  t[xo][yo] = val
 end
 _update60 = menu_update
 _draw = menu_draw
end


function menu_draw()
 cls()
 
 for i=0,10 do 
  print(flr(rnd(99)),i*12,76,7)
 end
 
 if (btnp(4)) then 
  reinit()
  goto_game()
 end
 
 print("@linoblondelle",1,122,7)
 print("/found it/",43,60,7)
 print("press c",50,68,7)
  --draw glitch
 for i=0,2 do
  glitch(0,rnd(128),-4+rnd(4),rnd(10))
 end
 draw_glitch()
 
end

function game_draw()
 --clear screen
 cls(0)
 --move the cursor
 if (btnp(0)and px>1) px -= 1
 if (btnp(1)and px<8) px += 1
 if (btnp(2)and py>1) py -= 1
 if (btnp(3)and py<8) py += 1
 
 print("remaining error / "..error_left,18,18,7)
 print("remaining essay / "..try_left,18,24,7)
 
 if (error_left<1) then
  win = "*complete* press c to retry"
  goto_over()
 end
 
  if (try_left<1) then
  win = "*fail* press c to retry"
  goto_over()
 end
 
 
 for x=1,8 do for y=1,8 do
  
  --the grid postion
  local xpos = 8
  local ypos = 24
  
  --draw the text
  if (c[x][y]==0) then
   print(flr(g[x][y]),xpos+x*12,ypos+y*8,7)
  else
  
   if (t[x][y]!=val) then
   
   for xx=0,6 do for yy=0,4 do
    local m=flr(rnd(5))
    if (m==1) pset(xpos+x*12+xx,ypos+y*8+yy)
   end end
   
   else
   
    spr(1,xpos+x*12,ypos+y*8-1)
   end
   
  end
  
  --increase the value
  g[x][y] += t[x][y]
  
  --set value to 0 if more than 99
  if (g[x][y]>99) g[x][y] = 0
  
  --if place meeting the cursor
  if (px==x and py==y) then
   rect(xpos+x*12-2,ypos+y*8-2,
        xpos+x*12+8,ypos+y*8+6,7)
   
   if (btnp(4)) then
    
    if (t[x][y]==val) then
     c[x][y] = 1
     error_left -= 1
     sfx(1)
    else
     c[x][y] = 2
     try_left -= 1
     sfx(0)
    end
    
   end
   
  end
  
 end end
 
 
 --draw glitch
 glitch(0,rnd(128),-4+rnd(4),rnd(10))
 draw_glitch()

end

function over_draw()
 cls()
 print(win,16,64,7)
  --draw glitch
 glitch(0,rnd(128),-4+rnd(4),rnd(10))
 draw_glitch()
 if (btnp(4)) goto_menu()
end
-->8
--function
function create_grid(w,h,val)
 local grid = {}
 
 for x=1,w do
  local d = {}
  add(grid,d)
  
  for y=1,h do
   add(d,flr(rnd(99)))
  
  end
 end
 
 return grid
end

--reinit
function reinit()
  --console
 o = {} 
 --all grid
 g = create_grid(8,8,0)
 t = create_grid(8,8,0)
 c = create_grid(8,8,0)
 --grid position
 px = 1
 py = 1
 --the value to found
 val = rnd(0.6)
 
 try_left = 3
 error_left = 5
 win = 0
 --particles
 particles = {}
 --place value in list 
 for x=1,8 do for y=1,8 do
  c[x][y] = 0
  t[x][y] = 1
 end end
 --
 for i=0,error_left do
  local xo=1+flr(rnd(7))
  local yo=1+flr(rnd(7))
  t[xo][yo] = val
 end
end


v={}

function glitch(x,y,r,d) 
 local o={}
 o.x = 0
 o.y = y
 o.r = r
 o.t = 0
 o.d = d
 o.p = {}
 for i=1,128 do
  add(o.p,pget(o.x+i,y))
 end
 add(v,o)
end

function draw_glitch()
 for n=1,#v do
  for i=1,128 do
   pset(v[n].r+v[n].x+i,v[n].y,v[n].p[i])
  end
 end

 for o in all(v) do
  o.t += 1
  if (o.t>o.d) del(v,o) 
 end
end

function goto_game()
 _update60 = game_update
 _draw = game_draw 
end

function goto_menu()
 _update60 = menu_update
 _draw = menu_draw
end

function goto_over()
 _update60 = over_update
 _draw = over_draw
end
