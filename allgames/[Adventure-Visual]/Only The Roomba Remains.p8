pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--decay

function _init()
 --init stuff
 
 initplayer() --inits the player
 rain={} --the rain list
 dust={}
 
 loc={x=0,y=0,tmr=30}
 
 mode=0 --mode
 --0 is game
 
 --music
 music(0,1)
 
end

function _update()
 --update stuff
 
 if mode==0 then
  --game update
  
  --add rain
  if btn(5,0) then
   add(rain,{x=128+rnd(128),y=0,v=1+rnd(1)})
  end
  loc.tmr-=rnd(10)
  if loc.tmr<=0 then
   add(rain,{x=128+rnd(128),y=0,v=1+rnd(1)})
   loc.tmr=30
  end
  --add dust
  loc.x=24+rnd(80)
  loc.y=40+rnd(72)
  if rnd(20)>19 and fmget(loc.x-4,loc.y-4,0)==false then
   add(dust,{x=loc.x,y=loc.y})
  end
  --update rain
  rnupdate()
  --update player
  plupdate()
  --update dust
  dstupdate()
  
 end
 
end

function _draw()
 --draw stuff
 
 --clean the screen
 cls()
 
 if mode==0 then
  --game draw
  
  --draw the map
  mpdraw()
  --draw rain
  rndraw()
  --draw dust
  dstdraw()
  --draw player
  pldraw()  
  
 end
 
end
-->8
--setup functions

function initplayer()
 --inits the player
 pl={
  
  x=48, --x coord
  y=104, --y coord
  s=1, --sprite
  chrg=100, --charge
  
 }
end
-->8
--general functions

function fmget(x,y,f)
 --this function is a simplified
 --tile checker.
 return fget(mget((x+4)/8,(y+4)/8),f)
end

function dist(x1,y1,x2,y2)
 --this gets the distance between
 --two points.
 return sqrt(((x2-x1)*(x2-x1))+((y2-y1)*(y2-y1)))
end

-->8
--map functions

function mpdraw()
 --draw the map.
 
 --first layer. (visuals)
 map(0,0,0,0,16,16)
 --second layer. (breaks)
 palt(1,true)
 pal(12,2)
 map(16,0,0,0,16,16)
 pal()
end
-->8
--rain functions

function rnupdate()
 --updates rain
 
 for i in all(rain) do
  i.y+=i.v
  if fmget(i.x-4,i.y-4,0)==true then
   mset(i.x/8,i.y/8,mget(i.x/8,i.y/8)-1)
   sfx(0,-1)
   del(rain,i)
  end
  if fmget(i.x-4,i.y-4,2)==true then
   sfx(0,-1)
   mset(i.x/8,i.y/8,0)
   mset(i.x/8-16,i.y/8,81)
   del(rain,i)
   
  end
  if i.y>=128 then
   del(rain,i)
  end
 end
end

function rndraw()
 --draws rain
 for i in all(rain) do
  pset(i.x-128,i.y,3)
 end
end

function dstupdate()
 --updates dust
 
 for i in all(dust) do
  if fmget(i.x-4,i.y-3,0)==false then
   i.y+=rnd(1)
  end
  if dist(i.x,i.y,pl.x+4,pl.y+4)<8 then
   sfx(4,-1)
   del(dust,i)
  end
 end
end

function dstdraw()
 --draws dust
 for i in all(dust) do
  pset(i.x,i.y,6)
 end
end
-->8
--player functions
function plupdate()
 pl.chrg-=.01
 if pl.chrg>0 then
  if btn(0,0) and fmget(pl.x-1,pl.y+3,0)==false then
   pl.x-=1
   pl.s=2
  end
  if btn(1,0) and fmget(pl.x+1,pl.y+3,0)==false then
   pl.x+=1
   pl.s=1
  end
  if btn(2,0) and fmget(pl.x,pl.y+3,1)==true then
   pl.y-=1
  end
  if btn(3,0) and fmget(pl.x,pl.y+4,1)==true then
   pl.y+=1
  end
 else
  pl.s=3
 end
 if flr(pl.chrg)==0 then
  sfx(5,-1)
 end
 --gravity
 if fmget(pl.x,pl.y+4,0)==false and fmget(pl.x,pl.y+4,1)==false then
  pl.y+=1
 end
 
end
 

function pldraw()
 --draws the player
 spr(pl.s,pl.x,pl.y)
end
