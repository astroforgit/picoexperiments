pico-8 cartridge // http://www.pico-8.com
version 15
__lua__
--my pet virus
--jackson allen

function _init()

	boot_init()
	_update=boot_update
	_draw=boot_draw
end

function game_init()
	poke(0x5f2d,1)
	
	start_menu=false
	
	a={}--icons

	
	e={t=0,x=0,y=0,id=0}--emotion
	
	alist={
		{96,97,98},
		{99,100,101},
		{102,103,104}
	}
	
	aemotion={}
	aemotion[96]=get_joy
	aemotion[97]=get_evil
	aemotion[98]=get_love
	aemotion[99]=get_joy
	aemotion[100]=get_evil
	aemotion[101]=get_love
	aemotion[102]=get_joy
	aemotion[103]=get_evil
	aemotion[104]=get_love
	aemotion[105]=null_function
	
	
	w={--windows
		
	}
	
	wlist={}
	wlist[192]={fn=get_joy}
	wlist[196]={fn=get_money}
	wlist[200]={fn=pet_eat}
	wlist[204]={fn=get_evil}
	wlist[208]={fn=pet_eat}
	
	
	p={--pet
		x=64, y=117,
		dx=0, dy=0,
		ddx=.01, ddy=.2,
		dxmax=.1, dymax=2,
		id=76, s=1,
		direction=sgn(rnd(2)-1),
		grabbed=false,
		busy=false,
		xp=0,
		xpmax=8,
		love=8,
		joy=4,
		evil=4,
		money=4,
		level=0,
		wait=false,
		dying=0,
		t=0,
		freeze=0,
		window=192,
		egg=true,
		newid=16,
		action=null_function
	}
	
	pets={
		{--stage 2
			{--joy -
				{19,19,20},--evil -
				{26,26,28},--evil 0
				{27,22,23} --evil +
			},
			{--joy 0
				{25,21,20},--evil -
				{26,21,28},--evil 0
				{27,22,23} --evil +
			},
			{--joy +
				{25,24,24},--evil -
				{29,29,17},--evil 0
				{18,18,17} --evil +
			}
		},
		{--stage 3
			{--joy -
				{46,40},--evil -
				{34,36} --evil +
			},
			{--joy +
				{42,44},--evil -
				{38,32} --evil +
			}
		}
	}
	
	m={}
	get_mouse()
	
	os=false
	spawn_app(96)
	spawn_app(97)
	spawn_app(98)
--	spawn_app(105)
end

function game_update()
	if p.freeze>0 then
		p.freeze-=1 
		return
	end
	get_mouse()
	update_pet()
	update_desktop()
	update_emotion()
--	if(btnp(—))evolve()
end

function game_draw()
	if p.freeze>0 then 
		return
	end
	draw_desktop()
	if not p.busy then
		draw_emotion()
		draw_pet()
	end
	spr(1,m.x,m.y)
	
	if (p.level<=2 and (p.t%16==0 or p.dying>0))
			or (p.level==3 and p.t%8==0)
			or (p.level>3) then 
		--corrupt mode by zep
		for i=1,2^(p.level-1+p.dying)-1 do
	 	poke(rnd(0x8000),rnd(0x100))
		end
		if(p.dying<=3)then
			camera()
		end
	end
	
--	print(m.x.." "..m.y,1,1,6)
	
--	print(p.joy,1,13,6)
--	print(p.evil,1,19,6)
--	print(p.love,1,25,6)
--	print(wlist[p.window].fn,1,25,6)
--	spr(0,0,0,16,16)
--	print(p.t,1,13,6)
--	print(p.dy,1,13,6)
end

function get_mouse()
	if(btnp(—))then
		poke(0x5f2d,-peek(0x5f2d)+1)
	end
	if(peek(0x5f2d)==1)then
		m.x=mid(0,stat(32),127)
		m.y=mid(0,stat(33),127)
		m.c=stat(34)>0 and not m.l
		m.l=stat(34)>0
	else
		if(btn(‹))m.x-=2
		if(btn(‘))m.x+=2
		if(btn(”))m.y-=2
		if(btn(ƒ))m.y+=2
		if(btnp(‹))m.x+=1
		if(btnp(‘))m.x-=1
		if(btnp(”))m.y+=1
		if(btnp(ƒ))m.y-=1
		m.x=mid(0,m.x,127)
		m.y=mid(0,m.y,127)
		m.c=btn(Ž) and not m.l
		m.l=btn(Ž)
	end
	
	if(m.c)sfx(5)
end

--function sgn(n)
--	if(n>0)return 1
--	if(n<0)return -1
--	return 0
--end

function null_function()

end

function shut_down()
	for i=0,32 do
		rectfill(0,0,127,4*i,5)
		flip()
	end
end
-->8
--pet functions

function update_pet()
	p.t+=1
	
	if(m.c and not m.grab and abs(m.x-p.x)<=4*p.s and
		abs(m.y-p.y)<=4*p.s)then
		p.grabbed=true
		p.dy=0
		p.mx=m.x-p.x
		p.my=m.y-p.y
		m.grab=true
		if not p.wait then
			if(p.egg) then
				crack_egg()
			else
				get_love()
			end
			p.wait=true
		end
		pet_release()
	elseif(not m.l) then 
		p.grabbed=false
		m.grab=false
		set_window()
	end
	
	if(p.grabbed) then
		drag(p)
	end
	if p.t%16==0 then
		if(p.love<1)set_emotion(-1)
		if p.t>64 then
			p.action()
			p.t=0
			p.wait=false
			if not (p.busy or p.grabbed) then
				decay_values()
			end
		end
--		if not (p.busy or p.grabbed) then
--			move_pet()
--			p.y+=4
--		else
--			p.dy=0
--		end
	end
	
	if not (p.busy or p.grabbed) then
		move_pet()
--		p.y+=4
	else
		p.dy=0
	end
	
	p.x=mid(4*p.s,p.x,128-4*p.s)
	p.y=mid(4*p.s,p.y,121-4*p.s)
	p.joy=mid(0,p.joy,11)
	p.evil=mid(0,p.evil,11)
	p.love=mid(0,p.love,11)
	
	if(p.love==0)then
		p.dying+=.5
	elseif p.level<=3 then
		p.dying=0
	end
	if p.level>3 and p.t>=0 then
		p.dying+=.5
	end
	if(p.dying>7) then
		sfx(0,0)
		sfx(1,1)
		sfx(2,2)
		sfx(3,3)
	end
	if(p.dying>70) then
		poke(0x5e00,1)--os missing
		run()
	end
	
	if(p.level==3 and p.xp>=16 and not os)then
		os=true--spawn picos
		spawn_app(105)
	end
end

function drag(actor)
	actor.x=m.x-actor.mx
	actor.y=m.y-actor.my
end

function move_pet()
	if rnd(999)<(p.x-64)^2 then
		p.direction=-sgn(p.x-64)--sgn(rnd(8)-4-(p.x-64))
	end
	p.dy+=p.ddy

	p.dx+=p.ddx*p.direction
	p.dx=mid(-p.dxmax,p.dx,p.dxmax)
	p.dy=mid(-p.dymax,p.dy,p.dymax)
	if(p.egg)p.dx=0
	
	p.x+=p.dx
	p.y+=p.dy
end

function draw_pet()
	--pal(13,0)
	spr(p.id,p.x-4*p.s+.5,p.y-4*p.s+.5,
		p.s,p.s,p.direction<0)
	pal()
end

function pet_eat()
	for i in all(a) do
		if abs(p.x-i.x)<=4*p.s+2 and
 			abs(p.y-i.y)<=4*p.s+2 then
 		p.xp+=app_value(i.id)
 		aemotion[i.id]()
 		del(a,i)
 		sfx(0)
 		p.xp=min(p.xp,p.xpmax)
 		if(p.xp==p.xpmax)make_egg()
 		return true
 	end
	end
end

function get_joy()
	p.joy+=1
	p.evil-=.3
	set_emotion(1)
	p.joy=mid(0,p.joy,11)
	p.evil=mid(0,p.evil,11)
end

function get_evil()
	p.evil+=1
	p.joy-=.1
	p.love-=.1
	set_emotion(2)
	p.joy=mid(0,p.joy,11)
	p.evil=mid(0,p.evil,11)
	p.love=mid(0,p.love,11)
end

function get_love()
	p.love+=2
	set_emotion(3)
	p.love=mid(0,p.love,11)
end

function get_money(human)
	if(human) then
		p.money+=1
	else
		p.joy-=.2
		p.love-=.3
		p.money+=flr(2^(p.level+1+p.xp/p.xpmax))
		p.joy=mid(0,p.joy,11)
		p.love=mid(0,p.love,11)
		set_emotion(0)
	end
end

function set_window()
	if(p.egg)return
	for i in all(w) do
		if abs(p.x-i.x-17)<=16-p.s*4 and
				abs(p.y-i.y-28)<=12/(1+p.s) and
				(i.id==192 or i.id==196 
					or i.id==204) then
			p.busy=true
			p.dy=0
			p.window=i.id
			p.action=wlist[p.window].fn
		end
	end
end

function decay_values()
	p.love-=.3
	p.joy-=.1
	p.evil-=.1
end

function pet_release()
	p.busy=false
	if not p.egg then
		p.action=pet_eat
	end
end

function evolve()
	p.id=p.newid
	p.action=pet_eat
	if(p.level==2)p.s+=1
	p.level+=1
	p.xp=0
	p.xpmax*=2
	get_love()
end

function make_egg()
	pet_release()
	p.egg=true
	p.action=null_function
	joy=flr(p.joy*(4-p.level)/12)+1
	evil=flr(p.evil*(4-p.level)/12)+1
	love=flr(p.love*(4-p.level)/12)+1
	if p.level<3 then
		p.newid=pets[p.level][joy][evil][love]
	end
	p.id=76
end

function crack_egg()
	if(p.id<79)then
		p.id+=1
		sfx(6)
		set_emotion(-2)
	else 
		sfx(4)
		p.egg=false
		evolve()
	end
end
-->8
--desktop funtions

function draw_desktop()
	cls(13)
	
	
	draw_apps()
	
	foreach(w,draw_window)
	
	
	rectfill(0,121,127,127,6)
	
	if(stat(93)<10)then
		hpad=0
	else hpad="" end
	if(stat(94)<10)then
		mpad=0
	else mpad="" end
	print(hpad..stat(93)..":"..mpad..stat(94),106,122,5)
	
	for i=1,6 do
		spr(1+i,7*i-7,121)
	end
	if start_menu then
		spr(8,0,121)
	end
	
end

function update_desktop()
	
	--open windows
	if m.c and	abs(m.y-124)<=4 
			and abs(m.x-24)<18
			and not m.grab then
		open_window(192+4*flr((m.x-7)/7))
		sfx(1)
	end
	--start menu
	if m.c and	abs(m.y-124)<=4 
			and m.x<=7 and start_menu
			and not m.grab then
		poke(0x5e00,2)--reboot os
		sfx(9)
		shut_down()
		run()
	elseif m.c and	abs(m.y-124)<=4 
			and m.x<=7
			and not m.grab then
		start_menu=true
	elseif m.c then
		start_menu=false
	end
	
	
	--close windows
	if m.c and not m.grab then
		for i in all(w) do
			if abs(m.x-i.x-30)<2 and
					abs(m.y-i.y-2)<2 then
				close_window(i)
			end
		end
	end
	
	--get grab
	if m.c and not m.grab then
		for j=#w,1,-1 do
			i=w[j]
			if abs(m.x-i.x-17)<=17 and
					abs(m.y-i.y-18.5)<19 then
				add(w,i)
				del(w,i)
				i.grabbed=true
				m.grab=true
				if i.id==196 then
					mine_click(i)
				elseif i.id==200 then
					store_click(i)
				end
				i.mx=m.x-i.x
				i.my=m.y-i.y
				if p.busy and p.window==i.id then
					p.grabbed=true
					p.mx=m.x-p.x
					p.my=m.y-p.y
				end
				break
			end
		end
		for j=#a,1,-1 do
			i=a[j]
			if abs(m.x-i.x)<=4 and
					abs(m.y-i.y)<=4 then
				add(a,i)
				del(a,i)
				i.grabbed=true
				m.grab=true
				i.mx=m.x-i.x
				i.my=m.y-i.y
				break
			end
		end
	else
		m.grabbed=false
	end
	
	for i in all(w) do
		i.grabbed=i.grabbed and m.grab
		if(i.grabbed)drag(i)
		i.x=mid(0,i.x,94)
		i.y=mid(0,i.y,83)
	end
	for i in all(a) do
		i.grabbed=i.grabbed and m.grab
		if(i.grabbed)drag(i)
		i.x=mid(2,i.x,123)
		i.y=mid(3,i.y,116)
	end
end

function spawn_app(id)
	add(a,{id=id,
		x=4+10*flr(#a/12),y=4+10*(#a%12),
		grabbed=false})
end

function draw_apps()
	for i in all(a) do
		spr(i.id,i.x-3,i.y-3)
	end
end

function app_value(id)
	if(id==105)then
		p.level=8
		p.id=128
		p.s=4
		p.xp=0
		p.x=mid(4*p.s,p.x,128-4*p.s)
		p.y=mid(4*p.s,p.y,121-4*p.s)
		_draw()
		p.freeze=32
		return 0
	end
	return 2^flr((id-96)/3)
end

function open_window(nid)
	for i in all(w) do
		if(i.id==nid)return
	end
	add(w,{id=nid,x=9+9*#w,y=9+9*#w,grabbed=false})
	sfx(1)
end

function draw_window(window)
	rectfill(window.x,window.y,window.x+33,window.y+37,5)
	local id=window.id
	local x=window.x
	local y=window.y
	
	if id<208 then
		spr(id,x+1,y+5,4,4)
	elseif id==208 then
		--stats
		rectfill(x+1,y+5,x+32,y+36,7)
		spr(140,x+1,y+5,4,1)
		for i=0,2 do
			spr(i+12,x+6+8*i,y+30)
		end
		line(x+4,y+28,x+28,y+28,5)
		rectfill(x+6,y+27,x+11,y+27-p.joy,10)
		rectfill(x+14,y+27,x+19,y+27-p.evil,8)
		rectfill(x+22,y+27,x+27,y+27-p.love,14)
		print("lv"..p.level,x+2,y+10,5)
		rectfill(x+15,y+10,x+15+(p.xp/p.xpmax)*16,y+14,3)
		rect(x+15,y+10,x+31,y+14,5)
	end
	if(id==200)then
		print(p.money,x+6,y+10,5)
	end
	spr(15,x+29,y)
	if p.busy and p.window==id then
		draw_emotion()
		draw_pet()
	end
--	print(wnames[window.id],window.x+1,window.y+1,5)
end

function close_window(id)
	sfx(2)
	del(w,id)
	pet_release()
end

function mine_click(j)
	
	if m.c and abs(m.x-j.x-16.5)<=16 and
			abs(m.y-j.y-20.5)<=16 then
		get_money(true)
		sfx(8)
	end
end

function store_click(k)
	for i=1,3 do
		for j=1,3 do
			if m.c and abs(m.x-k.x-4-7*(i-1))<=3 and
					abs(m.y-k.y-18-7*(j-1))<=3 then
				buy_app(i,j)
			end
		end
	end
end

function buy_app(i,j)
	if(p.money<2^(j+1))return
	spawn_app(j*3+i+92)
	p.money-=2^(j+1)
	sfx(4)
end


-->8
--emotion functions

function draw_emotion()
	if(e.t>0)spr(e.id,e.x,e.y)
end

function update_emotion()
	e.t-=1
	e.y-=1
end

function set_emotion(id)
	e.id=id+11
	e.t=8
	e.x=p.x-2.5
	e.y=p.y-3.5-4*p.s
	sfx(3)
end
-->8
--boot

function boot_init()
	t=1
	if peek(0x5e00)>3 then
		poke(0x5e00,1)
	end
	messages={
		"> my pet virus\n> by jackson allen\n> \n> booting \80\73\67os...",
		"> operating system missing...\n> restoring \80\73\67os...",
		"> rebooting \80\73\67os..."
	}
	message=messages[peek(0x5e00)+1]
--	message="> my pet virus\n> by jackson allen\n> \n"..message
	poke(0x5e00,0)
	current_message=""
	dots=""
end

function boot_update()
	t+=1
	dots="> "
	for i=0,t,12 do
		dots=dots.."."
	end
	
	
	if #current_message<#message then
		t%=3
		if t==0 then
			current_message=current_message..sub(message,#current_message+1,#current_message+2)
			sfx(5)
		end
		dots=""
	elseif(t%12==1) then
		sfx(5) 
	end
	if t>94 then
		game_init()
		_update=game_update
		_draw=game_draw
		sfx(4)
	end
end

function boot_draw()
	cls(5)
	print(current_message)
	print(dots)
end
