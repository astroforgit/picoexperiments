pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--beam runner
--by doc robs

--objects
game={}
p={} --player
enemies={}
bullets={}
dust={}

--palette
plt={{6,5},{12,1},{14,2},{15,4},{7,0}}
plt_num=1
plt_count=0

--encouragement
enc={"good","excellent","awesome","outstanding","god like"}
enc_val={500,1000,4000,10000,15000}
enc_current=0

--player
p.x=10
p.y=64
p.p=3 --position above or below
p.side=true
p.col=5
p.hit=false
p.explode=false
p.cooloff=10
p.count=0
p.ammo=100
p.lives=5
p.maxammo=100
p.maxlives=7

--game variables
startx=130
addcount=40
score=0
c=0
sc=0
sc_target=400
demo=true
difficulty=1
shake=0

--these functions are required
--by pico8
function _init()	
	--game variables
	show_splash()
end

function _update()
	game.upd()
end

function _draw()
	game.drw()
end
-->8
--objects
--these are the objects
--the code adds a new objects 
--and declares the functions
--they contains

function add_new_bullet(ps)
	add(bullets, {
		x=10,
		y=-2,
		dx=2,
		col=5,
		range=80,
		hit=false,
		side=ps,
		draw=function(self)
			pset(self.x,64-self.y,self.col)
		end,
		update=function(self)
			if self.side then
				self.y=2
			end
			self.x+=self.dx
			if self.x>self.range then
				del(bullets,self)
			end
			--collision
			for e in all(enemies) do
			 self.hit=false
				if self.side==e.side then
 				for i=0,3 do
 					if (self.x+i>e.x and self.x+i<e.x+3) then
 					 self.hit=true
 					end
 				end
 			end
			 if self.hit then
    	--destroy e
    	e.hp-=1
    	sfx(4)
    	del(bullets,self)
    end
			end
  end
	})
end

function add_new_enemy()
	add(enemies, {
 	x=startx,
 	p=3,
 	speed=rnd(3)+1, 
 	typ=flr(rnd(21)),
 	col=5,
 	hp=3,
 	hit=false,
 	n_side=rnd(1),
 	side=true,
 	dist=100,
 	draw=function(self)
 		rectfill(self.x,64-self.p,self.x+3,64,self.col)
 		if demo then
 			self.speed=1
 			draw_help(self.col,self.x)
 		end
 	end,
 	update=function(self)
 		if self.n_side<0.5 then
 			self.side=false
 			self.p=-3
 		end
 		local th=1
 		local ta=18
 		if demo then
 			ta=14
 			th=5
 		end
 		if self.typ<th then
 			--new life
 			self.col=8
 		end
 		if self.typ>ta then
 			--ammo
 			self.col=10
 		end
 		
 		--collisions and scoring
 		if not demo then
  		if self.side==p.side then
  			if self.col==5 then 
  				self.dist=flr((startx-(self.x-p.x))/50)  		
  				score+=self.dist*difficulty 
  			end
  			self.hit=false
   		for i=0,3 do
  				if not p.hit and not self.hit and (self.x+i<p.x+3 and self.x+i>p.x) then
  				 self.hit=true
  				 if self.col==8 then
  				  if p.lives<p.maxlives then p.lives+=1 end
  				  sfx(1)
  				 elseif self.col==10 then
  				  p.ammo+=20
  				  sfx(1)
  				 else
  				 	p.lives-=1
  				 	p.hit=true
  				 	score-=200
  				 	shake=0.15
  				 	sfx(2)
  				 end
  				 del(enemies,self)
  				end
  			end
  		end
  	end

 		self.x-=self.speed
 		if self.x<-8 then
 			score+=10*difficulty
 			del(enemies,self)
 		end
 		if self.hp<0 then
 			--blow up (dust)
 			for i=0,9 do
 				add_new_dust(self.x,64-self.p,self.col)
 			end
 			del(enemies,self)
 		end
 	end
 })
end

function add_new_dust(xpos,ypos,icol)
	add(dust, {
 	x=xpos,
 	y=ypos,
 	dx=rnd(4)-2,
 	dy=rnd(4)-2,
 	life=rnd(10)+10,
 	col=icol,
 	draw=function(self)
 		pset(self.x,self.y,self.col)
 	end,
 	update=function(self)
 		self.x+=self.dx
 		self.y+=self.dy
 		
 		self.life-=1
 		if self.life<0 then
 			del(dust,self)
 		end
 	end
 })
end
-->8
--game functions

function reset_game()
 --player
 p.x=10
 p.y=64
 p.p=3 --position above or below
 p.side=true
 p.col=plt[plt_num][2]
 p.hit=false
 p.ammo=100
 p.lives=5
 p.maxammo=100
 p.maxlives=7
 p.explode=false
 
 --game variables
 startx=130
 addcount=40
 score=0
 c=0
 sc=0
 sc_target=400
 difficulty=1
 plt_num=1
 enc_current=0
 shake=0
 
 --remove any enemies
 for e in all(enemies) do
  del(enemies,e)
 end
end

function scale_text(text,tlx,tly,sx,sy,col,bck_col)
 --scales some text, used for title
 print(text,0,0,col)
 for y=0,7 do
  for x=0,#text*8-1 do
   local col=pget(x,y)
   if col!=0 then
   local nx=x*sx+tlx
   local ny=y*sy+tly
   rectfill(nx,ny,nx+sx,ny+sy,col)
   end
  end
 end
 print(text,0,0,bck_col)
end

function check_praise()
	local pr=0
		for i=5,enc_current+1,-1 do
			if score > enc_val[i] then
				enc_current=i
				return i
			end
		end
	return pr	
end

function draw_help(t,x)
	x1=x
	y1=70
	if t==8 then
		x2=x1+46
		y2=y1+24
	 rectfill(x1,y1,x2,y2,7)
 	rect(x1,y1,x2,y2,8)
 	print("grab red",x1+2,y1+2,8)
 	print("blocks for",x1+2,y1+10,8)
 	print("extra lives",x1+2,y1+18,8)
	elseif t==10 then
		x2=x1+62
		y2=y1+16
	 rectfill(x1,y1,x2,y2,7)
 	rect(x1,y1,x2,y2,10)
 	print("yellow blocks",x1+2,y1+2,9)
 	print("give extra ammo",x1+2,y1+10,9)
	else
		x2=x1+80
		y2=y1+24
	 rectfill(x1,y1,x2,y2,7)
 	rect(x1,y1,x2,y2,5)
 	print("dodge these!",x1+2,y1+2,5)
 	print("the closer they get",x1+2,y1+10,5)
 	print("the more you score",x1+2,y1+18,5)
	end
end

function doshake()
 -- -16 +16
 local shakex=16-rnd(32)
 local shakey=16-rnd(32)
 
 shakex=shakex*shake
 shakey=shakey*shake
 
 camera(shakex,shakey)
 
 shake=shake*0.95
 if shake<0.05 then
  shake=0
 end
end
-->8
--splash
function show_splash()
	splash_count=90
	game.upd = splash_screen_update
	game.drw = splash_screen_draw
end

function splash_screen_update()
	splash_count-=1
	if splash_count < 0 then show_menu() end	
end

function splash_screen_draw()
	cls()
	palt()
	rectfill(24,30,104,64,9)
	print("doc robs games",38,54,0)
	palt(0,false)
	if splash_count > 60 then
		spr(65,56,40)
		spr(66,64,40)
	elseif splash_count > 30 then
		spr(81,56,40)
		spr(82,64,40)		 
	else
		spr(65,56,40)
		spr(66,64,40)
	end
end
-->8
--menu
function show_menu()
	reset_game()
	demo=true
	music(10)
	game.upd = menu_update
	game.drw = menu_draw
	add_new_enemy()
	flasher=0
	flash_col=5
end

function menu_draw()
	cls(6)
	scale_text("beam runner",20,10,2,2,5,6)
	
	print("press any button to start",5,118,flash_col)
	
	--draw enemies
	for e in all(enemies) do
  e:draw()
 end
 
 rectfill(p.x,p.y-p.p,p.x+3,p.y,p.col)
 	
	--draw instruction boxes
	rectfill(5,25,123,43,7)
	rect(5,25,123,43,5)
	print("use \148 and \131 to switch sides",7,27,5)
	print("press any button to fire",7,35,5)
	line(31,43,10,64,5)	
	
	--track
 rect(0,p.y,128,p.y,5)
	
end

function menu_update()
	--flash start message
	flasher+=1
	if flasher>15 then
		flasher=0
		if flash_col==5 then
			flash_col=8
		else
			flash_col=5
		end
	end
	--move enemies
	for e in all(enemies) do
  e:update()
  if e.x<-8 then
  	add_new_enemy()
  end
 end
 
 if btn(4) or btn(5) then
 	--next stage
 	show_game()
 end
end
-->8
--game
function show_game()
 reset_game()
 demo=false
 game.upd = game_update
	game.drw = game_draw
	--need a pause/countdown
	delay=30
	phrase_delay=30
	show_phrase=false
	phrase=""
end

function game_update()
	delay-=1
	if delay<0 then delay=0 end
 --movement
	if btnp(2) then
		p.p=3
		p.side=true
		--plt_num=flr(rnd(5))+1
		sfx(0)
	end
	if btnp(3) then
		p.p=-3
		p.side=false
		--plt_num=flr(rnd(5))+1
		sfx(0)
	end
		
	if delay<1 and (btn(4) or btn(5)) and p.ammo>0 then
		--shoot
		p.ammo-=1
		sfx(3)
		add_new_bullet(p.side)
	end
		
	--check for hit
	if p.hit then
		--blow up (dust)
		if not p.explode then
 		for i=0,9 do
 		 add_new_dust(p.x,p.y-p.p,p.col)
 		end
 		p.explode=true
 	end
		p.count+=1
		if p.count%2>0 then
			p.col=14
		else
			p.col=15
		end
		if p.count>p.cooloff then
			p.count=0
			p.hit=false
			p.explode=false
			p.col=5
		end
	end
	
	--check levels
	if p.lives>p.maxlives then p.lives=p.maxlives end
	if p.ammo>p.maxammo then p.ammo=p.maxammo end
		
	--spawn
	c+=1
	sc+=1
	if c>addcount then
		if rnd(addcount)<5 then
			add_new_enemy()			
			c=0
		end
	end
	if sc>sc_target then
		addcount-=10
		difficulty=((40-addcount)/10)+1
		sc=0
		sc_target*=1.2
		if addcount<10 then addcount=10 end
	end
	
	--move enemies
	for e in all(enemies) do
  e:update()
 end
 --move bullets
	for b in all(bullets) do
  b:update()
 end
 --move dust
	for d in all(dust) do
  d:update()
 end
 
 if p.lives<1 then
 	shake=0.25
 	show_game_over()
 end
 
 if show_phrase then
 	phrase_delay-=1
 	if phrase_delay<0 then
 		phrase_delay=30
 		show_phrase=false
 	end
 end
end

function game_draw()
	doshake()
	
 local i=0
 cls(plt[plt_num][1])
  
 --praise 
 if show_phrase then
		scale_text(enc[phrase],16,40,3,3,8)
 else
  phrase = check_praise()
  if phrase>0 then
  	show_phrase=true
  	phrase_delay=30
  end
 end
  
	--draw top banner
	rectfill(0,0,128,10,0)
	rectfill(0,118,128,128,0)
	
	rectfill(p.x,p.y-p.p,p.x+3,p.y,p.col)
	
	--draw enemies
	for e in all(enemies) do
  e:draw()
 end
 --draw bullets
	for b in all(bullets) do
  b:draw()
 end
 --draw dust
	for d in all(dust) do
  d:draw()
 end
 
 print("score: "..score,2,120,5)
 
 --track
 rect(0,p.y,128,p.y,5)
 
 --lives and ammo
 print("lives",2,2,8)
 for i=0,p.lives-1 do
 	rectfill(26+i*5,3,i*5+29,6,8)
 end
 print("ammo",80,2,10)
 for i=0,p.ammo-1,20 do
 	rectfill(99+i*5/20,3,i*5/20+102,6,10)
 end
end
-->8
function show_game_over()
 game.upd = over_update
	game.drw = over_draw
	--need a pause/countdown
	delay=30
end

function over_draw()
 doshake()
	cls(8)
	local str_score = tostr(score)
	scale_text(str_score,10,10,4,4,10,8)
	print("press any button to restart",10,118,10)
end

function over_update()
	delay-=1
	if delay<0 then delay=0 end
	
 if delay<1 and (btn(4) or btn(5)) then
 	--next stage
 	show_game()
 end
end
