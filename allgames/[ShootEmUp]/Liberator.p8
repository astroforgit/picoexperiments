pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
function checkforbeam()
  --check for beam--
  if (mget(ys-9,(spaceshipx))==51)
  and immunetimer>=100 then
    gameover=true
    sfx(1)
  end
end
function checkforslave()
  if mget(ys-9,(spaceshipx))==35

  and spaceshipz<2
  then
    mset(ys-9,spaceshipx,48)
    sfx(2)
    score+=10
  end
end
function checkforheart()
  if mget(ys-9,(spaceshipx))==36

  and spaceshipz<5
  then
    mset(ys-9,spaceshipx,49)
    lives+=1
    sfx(2)
  end
end
function checkbutton()
  if btnp(1) and spaceshipx< 5 then spaceshipx+=1 end
  if btnp(0) and spaceshipx> 0 then spaceshipx-=1 end
  if btn(3) and spaceshipz>= 0 then spaceshipz-=0.2 end
  if btn(2) and spaceshipz<= 12 then spaceshipz+=0.2 end
end
function drawenemy()
  if s==9 then --draw enemy ship--
    z=6
    spr(100,x*8+y*8-ani,64+x*4-y*4-z*4+(ani/2),2,2)


  end
end

function drawbeam()
  --doesnt work--
  ct=1
  if #beamx!=0 then
    while ct<#beamx do

      spr(70,beamx[ct]*8+(beamy[ct]-1)*8-ani,
      64+beamx[ct]*4-(beamy[ct]-1)*4-beamz[ct]*4+(ani/2),
      2,2)
      ct+=1
    end
  end
end













function _init()
		score=0
  rot=0
  x=0
  y=0
  lives=5
  ani=0
  frame=1
  ys=9
  mov=0
  spaceshipx=3
  spaceshipz=3

  gameover=false
  immunetimer=500
  gamestate="menu"
end


function _update()
  
  if gamestate=="menu" then
    if y<60	then
      x=30
      y+=1

    end
    if btnp(5) then gamestate="play" end
    rot+=0.003
  end
  --end menu updates--
  if gamestate=="play" then
    --revive--
    if gameover==true then
      lives-=1
      gameover=false

      immune=true
      immunetimer=0
    end
    immunetimer+=1

    frame+=0.1
    if frame>=4 then frame=1 end
    ani+=0.2423
    --high ani, moves scrolls faster than ship--
    --low ani, moves slower--
    --.245 is too high, makes ship go fast
    --.24 too low, makes ship go too slow
    mov+=2
    if mov >64 then
      ys+=1
      mov=0
    end
    if ys<=121 then checkbutton() end
    checkforbeam()
    checkforslave()
    checkforheart()
    --check for collision with ground--
    if spaceshipz<0
    and immunetimer>=100
    then
      gameover=true
      sfx(1)
    end
    --check for collision with pyramids--
    if mget(ys-9,(spaceshipx))==49
    and spaceshipz<2
    and immunetimer>=100
    then
      gameover=true
      sfx(1)
    end
    --check for collision with pillar
    if mget(ys-9,(spaceshipx))==37
    and immunetimer>100
    and spaceshipz>0
    and spaceshipz<9
    then
      gameover=true
      sfx(1)
    end
    --revive--
    if gameover==true then
      lives-=1
      gameover=false

      immune=true
      immunetimer=0
    end
    immunetimer+=1
    if lives==0 then gamestate="gameover" end
    
    if ys>=121 then spaceshipz+=0.1 end
    if ys>=126 then gamestat="won" end
    
  end --end play updates--
  if gamestate=="gameover" then

    if btnp(5) then 
    gamestate="menu"
    rot=0
		  x=0
		  y=0
		  lives=5
		  ani=0
		  frame=1
		  ys=9
		  mov=0
		  spaceshipx=3
		  spaceshipz=3
		  gameover=false
		  immunetimer=500
    end
			

  end
end



function _draw()
  if gamestate=="play" then
    cls(2)
    --draw terrain--
    x=0
    y=ys
    while y>0 do
      while x<6 do
        s=mget(y,x)
        if s==52 then s=45 end
        if s==37 then --draw platform-
          s=41
          z=0
          while z<10 do
            spr(39,x*8+y*8-ani,64+x*4-y*4-z*4+(ani/2),2,2)
            z+=1
          end
        end
        if s==35 then s=11 end
        if s==34 then
          add(beamx,x)
          add(beamy,y)
          add(beamz,z)
          mset(y,x,33)
        end
        if s==37 then s=41 end
        if s==36 then s=13 end
        if s==33 then s=9 end
        if s==32 then s=43 end
        if s==48 then s=1 end
        if s==49 then s=3 end
        if s==50 then
          s=5
          if flr(rnd(1)*300)==0 then
            sfx(0)
            mset(y,x,51)
          end
        end
        if s==51 then --draw laser--
          s=7
          z=flr(rnd(1)*10)
          spr(68,x*8+y*8-ani,64+x*4-y*4-z*4+(ani/2),2,2)
        end
        drawenemy()

        spr(s,x*8+y*8-ani,64+x*4-y*4+(ani/2),2,2)

        x+=1
      end
      x=0
      y-=1

    end

    --draw ship and shadow--
    if gameover==false and immunetimer >= 50 then
      if mget(ys-9,(spaceshipx))==37 then
        spr(66,spaceshipx*8,spaceshipx*4-40+64,2,2)
      else
        spr(66,spaceshipx*8,spaceshipx*4+64,2,2)
      end
      spr(64,spaceshipx*8,spaceshipx*4-spaceshipz*4+64,2,2)
    else
      if frame<2 then spr(98,spaceshipx*8,spaceshipx*4-spaceshipz*4+64,2,2)
    else spr(96,spaceshipx*8,spaceshipx*4-spaceshipz*4+64,2,2)
    end
  end

  --draw lives--
  x=1
  while x<=lives do
    spr(16,x*8,7)
    x+=1
  end
  print ("score:",0,0,0)
  print(score,24,0,0)
end
if gamestate=="menu" then

  cls()
  spr(70,x,y,9,2)
  if y==60 then
    print("press x to start",36,80)
    --draw spinning tiles--
    spr(45,cos(rot)*50+64,sin(rot)*50+64,2,2)
    spr(13,cos(rot+.2)*50+55,sin(rot+.2)*50+64,2,2)
    spr(11,cos(rot+.4)*50+55,sin(rot+.4)*50+64,2,2)
    spr(43,cos(rot+.6)*50+55,sin(rot+.6)*50+64,2,2)
    spr(39,cos(rot+.8)*50+55,sin(rot+.8)*50+64,2,2)
  end
  print("directions: fly down and save",1,100)
  print("the slaves without crashing",1,107)
  print("into pillars or pyramids.",1,114)

end

if gamestate=="gameover" then
  cls(2)
  print("g a m e   o v e r",30,60,7)
		print("press x to retry",32,74,7)
		print("score:",38,81)
		print(score,60,81)

end
if gamestate=="won" then

		cls(0)
		ct=0
		while ct<5 do
		x=flr(rnd(1)*128)
		y=flr(rnd(1)*64)
		clr=flr(rnd(1)*8)+7
		line(x,y,x-10,y+5,clr)
		
		ct+=1
		end
		
		spr(64,64,50,2,2)
		
		print("you have rescued the slaves",1,72,7)
		print("from the labor camp. you ",1,79,7)
		print("truly are, a liberator.",1,86,7)
		print("score: ",5,93,7)
		print(score,50,93,7)

end

end
