pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--super tankageddon
--gorypixels

--init

game = {}

game.fin = 3
game.col = 7
game.timercol = 0

--musica

music(0,0,3)

--jugador

player = {}
--posicion del jugador
player.x = 100
player.y = 145
player.sprite = 0
player.speed = 2
player.moving = false 
player.direction = 4
player.mirror = 0

player.turret = 6
player.turretx = 4
player.turrety = 6
player.turretmirror = false

fire = 0

b = {}

b.x = player.x-4
b.y = player.y+8
b.dx = 0
b.dy = 0
b.inix = player.x-4
b.iniy = player.y+8

--enemigo

e = {}

e.x = 0 
e.y = 0
e.random = 0
e.circle = 0
e.distance = 150
e.bx = e.x
e.by = e.y
e.bframe = 0
e.bflip = false
e.tiempo =20

e.bsmoke1 = 0
e.bsmoke2 = 0
e.bsmoke3 = 0
e.bsmoketimer1 = 0
e.bsmoketimer2 = 0
e.bsmoketimer3 = 0
e.bsx1 = 0
e.bsy1 = 0
e.bsx2 = 0
e.bsy2 = 0
e.bsx3 = 0
e.bsy3 = 0
e.bssprite1 = 25
e.bssprite2 = 25
e.bssprite3 = 25

e.bsonido = 0
e.bsonidotrigger = 0
e.bsonidotimer = 0
e.fire = 0

e.explosionx = 0
e.explosiony = 0
e.explosion = 0
e.explotimer = 0
 
function moveanim()

	player.moving = true
	player.sprite += 1
	
	if player.sprite > 2 then
		player.sprite = 0
	end
	
end


-->8
--enemigo

function _update()

if game.fin == false then

--movimiento enemigo

e.circle+=0.009

e.x =player.x+e.distance*
sin(e.circle)
e.y =player.y+e.distance*
cos(e.circle)

if e.distance>55 then
e.distance -=2
end

-- disparo enemigo


if e.distance<=55 then
			e.tiempo -=1
			if e.tiempo <=0 then
 			e.fire = 1
 		end
end

if e.fire == 1 then
sfx(4)
e.bsonido = 1
 --horizontal derecha
 if e.bx<(player.x-8) and
    e.by<(player.y+8)+3 and
    e.by>(player.y+8)-3 then
 e.bx+=1.5
 e.bframe=9
 e.bflip=false
 end
 --horizontal izquierda
 if e.bx>(player.x-8) and
    e.by<(player.y+8)+3 and
    e.by>(player.y+8)-3 then
 e.bx-=1.5
 e.bframe=9
 e.bflip=true
 end
 
 --diagonal derecha arriba
 if e.bx<(player.x-8)-2 and
    e.by>(player.y+8)+2 then
 e.bx+=1.5
 e.by-=1.5
 e.bframe=43
 e.bflip=true
 end
 
 --diagonal derecha abajo
 if e.bx<(player.x-8)-2 and
    e.by<(player.y+8)-2 then
 e.bx+=1.5
 e.by+=1.5
 e.bframe=11
 e.bflip=false
 end

 --diagonal izquierda arriba
 if e.bx>(player.x-8)+2 and
    e.by>(player.y+8)+2 then
 e.bx-=1.5
 e.by-=1.5
 e.bframe=43
 e.bflip=false
 end

 --diagonal izquierda abajo
 if e.bx>(player.x-8)+2 and
    e.by<(player.y+8)-2 then
 e.bx-=1.5
 e.by+=1.5
 e.bframe=11
 e.bflip=true
 end 
 
 --vertical abajo
 if e.by<(player.y+8) and
    e.bx<(player.x-8)+3 and
    e.bx>(player.x-8)-3 then
 e.by+=1.5
 e.bframe=10
 e.bflip=false
 end
 
 --vertical arriba
 if e.by>(player.y+8) and
    e.bx<(player.x-8)+3 and
    e.bx>(player.x-8)-3 then
 e.by-=1.5
 e.bframe=27
 e.bflip=false
 end

end

--humo1

 if e.bsmoke1 == 0 then
  e.bsx1 = e.bx
  e.bsy1 = e.by
  e.bsmoke1 = 1
 end

if e.bsmoke1 == 1 then
 e.bsmoketimer1+=1
end

if e.bsmoketimer1 > 5 then
 e.bssprite1 = 26
end

if e.bsmoketimer1 > 10 then
 e.bsmoke1 = 0
 e.bsmoketimer1 = 0
 e.bssprite1 = 25
end

--humo2

 if e.bsmoke2 == 0 then
  e.bsx2 = e.bx
  e.bsy2 = e.by
  e.bsmoke2 = 1
 end

if e.bsmoke2 == 1 then
 e.bsmoketimer2 += 1
end

if e.bsmoketimer2 > 7 then
 e.bssprite2 = 26
end

if e.bsmoketimer2 > 14 then
 e.bsmoke2 = 0
 e.bsmoketimer2 = 0
 e.bssprite2 = 25
end

--humo3

 if e.bsmoke3 == 0 then
  e.bsx3 = e.bx
  e.bsy3 = e.by
  e.bsmoke3 = 1
 end

if e.bsmoke3 == 1 then
 e.bsmoketimer3 += 1
end

if e.bsmoketimer3 > 9 then
 e.bssprite3 = 26
end

if e.bsmoketimer3 > 18 then
 e.bsmoke3 = 0
 e.bsmoketimer3 = 0
 e.bssprite3 = 25
end

--impacto al jugador

if e.by < ((player.y+8)+5) and
   e.by > ((player.y+8)-5) and
   e.bx < ((player.x-8)+5) and
   e.bx > ((player.x-8)-5) then
   
   e.fire = 0
   sfx(3)
   e.tiempo = 20
   game.fin = true

end
   
-- impacto al enemigo

if fire == 2      and
   e.distance<=55 and
		 b.y < (e.y+10) and
   b.y > (e.y-10) and
   b.x < (e.x+10) and
   b.x > (e.x-10) then
   
 e.distance=200
 sfx(0)
 
 e.explosionx = e.x
 e.explosiony = e.y
 e.explosion = 1
 
end

if e.explosion == 1 then
	e.explotimer +=1
end

if e.explotimer > 10 then
	e.explosion = 0
	e.explotimer =0
end

-- impacto al misil enemigo

if fire == 2       and
   b.y < (e.by+10) and
   b.y > (e.by-10) and
   b.x < (e.bx+10) and
   b.x > (e.bx-10) then
 e.fire = 0
 e.tiempo = 20
 sfx(2)
end

if e.bx<player.x-60 or
   e.bx>player.x+60 or
   e.by<player.y-60 or
   e.by>player.y+60 then
   
   e.fire = 0
   e.tiempo = 20
   
end

if e.fire == 0 then
	e.bx=e.x+4
	e.by=e.y-2
end

--sonido misil

if e.fire == 1 then
 e.bsonidotimer +=1
 if e.bsonidotimer == 2 then
 e.bsonidotrigger = true
 end
end

if e.fire == 0 then
 e.bsonidotimer = 0
 e.bsonidotrigger = false
end

if e.bsonidotrigger == true then
 sfx(5)
end

if e.bsonidotimer >3 then
 e.bsonidotrigger = 0
end

end
-->8
--jugador

if (game.fin == false or
    game.fin == 2 or
    game.fin == 3) then

-- movimiento jugador
													
player.moving = false
      
if (btn(0,1)) then

 player.mirror = false
	if fget
	(mget((player.x-5)/8,
								player.y/8)) <= 1
 then 
	 player.x -= player.speed
 end
 moveanim()        
 if player.sprite==0 then
	 player.direction=0
 else
  player.direction=32
 end 
end 
    
if (btn(1,1)) then
 player.mirror = false  
	if fget
	(mget((player.x+5)/8,
								player.y/8)) <= 1
 then 
	 player.x += player.speed
 end
 moveanim()  
 if player.sprite==0 then
  player.direction=0
 else
  player.direction=32
 end
end
    
if (btn(2,1)) then
 player.mirror = false  
	if fget
	(mget(player.x/8,
							(player.y-5)/8)) <= 1
 then 
	 player.y -= player.speed
 end
 moveanim()  
 if player.sprite==0 then
  player.direction=4
 else
  player.direction=36
 end 
end
    
if (btn(3,1)) then 
 player.mirror = false 
	if fget
	(mget(player.x/8,
							(player.y+5)/8)) <= 1
 then 
	 player.y += player.speed
 end
 moveanim()
 if player.sprite==0 then
  player.direction=4
 else
  player.direction=36
 end
end
    
if  (btn(0,1))
and (btn(2,1)) then 
 player.mirror = false 
 if player.sprite==0 then
  player.direction=2
 else
  player.direction=34
 end
end
        
if  (btn(1,1))
and (btn(2,1)) then 
 player.mirror = true 
 if player.sprite==0 then
  player.direction=2
 else
  player.direction=34
 end
end
        
if  (btn(0,1)) 
and (btn(3,1)) then 
 player.mirror = true 
 if player.sprite==0 then
  player.direction=2
 else
  player.direction=34
 end
end
   	
if  (btn(1,1))
and (btn(3,1)) then  
 player.mirror = false 
 if player.sprite==0 then
  player.direction=2
 else
  player.direction=34
 end
end

--apuntado

--torreta izquierda
if (btn(0,0)) then
 player.turret = 22
 player.turretx = -1
 player.turrety = 1
 player.turretmirror = false
 if fire == 0 then
  fire = 1
  sfx(1)
 end
 if fire == 1 then
 	player.turretx = 0
 end
end

--torreta derecha
if (btn(1,0)) then
 player.turret = 22
 player.turretx = 9
 player.turrety = 1
 player.turretmirror = true
 if fire == 0 then
  fire = 1
  sfx(1)
 end
 if fire == 1 then
 	player.turretx = 8
 end
end

--torreta arriba
if (btn(2,0)) then
 player.turret = 7
 player.turretx = 4
 player.turrety = -2
 player.turretmirror = false
 if fire == 0 then
  fire = 1
  sfx(1)
 end
 if fire == 1 then
 	player.turrety = -1
 end
end

--torreta abajo
if (btn(3,0)) then
 player.turret = 6
 player.turretx = 4
 player.turrety = 6
 player.turretmirror = false
 if fire == 0 then
  fire = 1
  sfx(1)
 end
 if fire == 1 then
 player.turrety =5
 end
end
--torreta derecha arriba
if  (btn(2,0))
and (btn(1,0)) then
 player.turret = 23
 player.turretx = 7
 player.turrety = -2
 player.turretmirror = false
 if fire == 0 then
  fire = 1
  sfx(1)
 end
 if fire == 1 then
 	player.turretx = 6
 	player.turrety = -1
 end
end

--torreta izquierda arriba
if  (btn(2,0))
and (btn(0,0)) then
 player.turret = 23
 player.turretx = 1
 player.turrety = -2
 player.turretmirror = true
 if fire == 0 then
  fire = 1
  sfx(1)
 end
 if fire == 1 then
 	player.turretx = 2
 	player.turrety = -1
 end
end

--torreta izquierda abajo
if  (btn(3,0)) 
and (btn(0,0)) then
 player.turret = 8
 player.turretx = 1
 player.turrety = 4
 player.turretmirror = false
 if fire == 0 then
  fire = 1
  sfx(1)
 end
 if fire == 1 then
 	player.turretx = 2
 	player.turrety = 3
 end
end

--torreta derecha abajo
if  (btn(3,0)) 
and (btn(1,0)) then
 player.turret = 8
 player.turretx = 7
 player.turrety = 4
 player.turretmirror = true
 if fire == 0 then
  fire = 1
  sfx(1)
 end
 if fire == 1 then
 	player.turretx = 6
 	player.turrety = 3
 end
end

--disparo

if fire == 0 then
b.x = player.x-4 
b.y = player.y+8
end

if fire == 1 then
	if player.turret == 6 then
  b.dx = 0	
	 b.dy = 10
	 b.inix = player.x
	 b.iniy = player.y
	end

	if player.turret == 7 then
  b.dx = 0	
	 b.dy =-10
	 b.inix = player.x
	 b.iniy = player.y
	end
	
	if player.turret == 8	and 
	player.turretmirror == false
 then
  b.dx = -10
	 b.dy = 10
	 b.inix = player.x
	 b.iniy = player.y
	end
	
	if player.turret == 8	and 
	player.turretmirror == true
 then
  b.dx = 10
	 b.dy = 10
	 b.inix = player.x
	 b.iniy = player.y
	end
	
	if player.turret == 22	and 
	player.turretmirror == false
 then
  b.dx = -10
	 b.dy = 0
	 b.inix = player.x
	 b.iniy = player.y
	end
	
	if player.turret == 22	and 
	player.turretmirror == true
 then
  b.dx = 10
	 b.dy = 0
	 b.inix = player.x
	 b.iniy = player.y
	end
	
	if player.turret == 23	and 
	player.turretmirror == false
 then
  b.dx = 10
	 b.dy = -10
	 b.inix = player.x
	 b.iniy = player.y
	end
	
	if player.turret == 23	and 
	player.turretmirror == true
 then
  b.dx = -10
	 b.dy = -10
	 b.inix = player.x
	 b.iniy = player.y
	end
	
 fire = 2
end

if fire == 2 then
 b.x += b.dx
 b.y += b.dy
end

if b.x > (b.inix+80) or
   b.x < (b.inix-80) or
   b.y > (b.iniy+80) or
   b.y < (b.iniy-80) then
   
 fire = 0
 b.x = player.x-4 
 b.y = player.y+8 
  
end


end

--victoria
	if fget
	(mget((player.x-5)/8,
								player.y/8)) == 1
 then 
 game.fin = 2
	end
	
--animacion game over

if game.fin == true then
game.timercol +=1
	if game.timercol == 2 then
		game.col = 6
	end
	if game.timercol == 4 then
		game.col = 5
	end
	if game.timercol == 6 then
		game.col = 0
	end
end


-->8
--otros

--animacion victoria

if (game.fin == 2 or
				game.fin == 3)then
game.timercol +=1
	if game.timercol <= 3 then
		game.col = 12
	end
	if game.timercol == 4 then
		game.col = 14
	end
	if game.timercol == 8 then
		game.col = 9
	end
	if game.timercol == 12 then
		game.col = 8
		game.timercol = 0
	end
end

end
-->8
--dibujado
function _draw() 

cls() 
map(0,0,0,20,124,124) 
camera(player.x-63,player.y-56)

--misil enemigo

	--sombra
 spr(40,e.bx,e.by+5)
 --humo
	spr(e.bssprite1,e.bsx1,e.bsy1)
	spr(e.bssprite2,e.bsx2,e.bsy2)
	spr(e.bssprite3,e.bsx3,e.bsy3)
	--misil
 spr(e.bframe,e.bx,e.by,
 1,1,e.bflip)
 
if game.fin == false then

--disparo jugador
spr(24,b.x,b.y,1,2)
--sombra jugador
spr(40,player.x-4,player.y+18)

--tanque
spr(player.direction, player.x-8,
player.y+8,2,2,player.mirror)

--torreta
spr(38, player.x-8, player.y+8,2,2)	     
spr(player.turret, player.x+
player.turretx-8,player.y+
player.turrety+8,1,1,
player.turretmirror)

end

--enemigo
spr(12, e.x-8, e.y-12,4,4)

--explosion enemigo

if e.explosion == 1 then
 if e.explotimer<5 then
	spr(56,e.explosionx,
	e.explosiony,1,1)
	end
	
 if e.explotimer>5 and
 			e.explotimer<7 then
	spr(41,e.explosionx,
	e.explosiony,2,2)
	end
	
 if e.explotimer>7 and
 			e.explotimer<8 then
	spr(25,e.explosionx,
	e.explosiony,1,1)
	end
	
 if e.explotimer>8 then
	spr(26,e.explosionx,
	e.explosiony,1,1)
	end
	
end

--pantalla de inicio

if game.fin == 3 then

music(-1)

rectfill(0,0,9999,9999,0)

--rectangulo superior
rectfill(player.x-100,
									player.y-60,
									player.x+100,
									player.y-49,8)

--texto superior
print("esdf to move,arrows to shoot",
player.x-55,player.y-54,2)

print("esdf to move,arrows to shoot",
player.x-54,player.y-55,15)

--rectangulo inferior
rectfill(player.x-100,
									player.y+80,
									player.x+100,
									player.y+64,8)

--texto inferior
print("find the helipad!",
player.x-32,player.y+65,2)

print("find the helipad!",
player.x-31,player.y+66,15)

--tankalien

print("super tankageddon",
player.x-59,player.y-19,3)

print("super tankageddon",
player.x-60,player.y-19,11)

--linea 1
rectfill(player.x-100,
									player.y-13,
									player.x+100,
									player.y-11,11)
									
--linea 2
rectfill(player.x-100,
									player.y-8,
									player.x+100,
									player.y-7,11)
									
--linea 3
rectfill(player.x-100,
									player.y-4,
									player.x+100,
									player.y-4,11)

--press x to start
print("press x to start",
player.x-30,player.y+40,
game.col)
print("press x to start",
player.x-30,player.y+41,
game.col+1)

--disparo jugador
spr(24,b.x,b.y,1,2)
--sombra jugador
spr(40,player.x-4,player.y+18)

--tanque
spr(player.direction, player.x-8,
player.y+8,2,2,player.mirror)

--torreta
spr(38, player.x-8, player.y+8,2,2)	     
spr(player.turret, player.x+
player.turretx-8,player.y+
player.turrety+8,1,1,
player.turretmirror)


end

--game over

if game.fin == true then

music(-1)

rectfill(0,0,9999,9999,game.col)

print("game over",
player.x-15,player.y-1,2)

print("game over",
player.x-15,player.y-2,8)

print("press x to restart",
player.x-30,player.y+51,2)

print("press x to restart",
player.x-30,player.y+52,8)

end

--victoria

if game.fin == 2 then

rectfill(0,0,9999,9999,game.col)

print("you win!",
player.x-15,player.y-15,3)

print("you win!",
player.x-15,player.y-16,11)

print("press x to replay",
player.x-30,player.y+51,3)

print("press x to replay",
player.x-30,player.y+52,11)

print("a game by gorypixels",
player.x-38,player.y-42,3)

print("a game by gorypixels",
player.x-38,player.y-43,11)

--disparo jugador
spr(24,b.x,b.y,1,2)
--sombra jugador
spr(40,player.x-4,player.y+18)

--tanque
spr(player.direction, player.x-8,
player.y+8,2,2,player.mirror)

--torreta
spr(38, player.x-8, player.y+8,2,2)	     
spr(player.turret, player.x+
player.turretx-8,player.y+
player.turrety+8,1,1,
player.turretmirror)

end

