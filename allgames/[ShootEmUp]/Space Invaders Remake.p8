pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- space inavders
-- minionsoft 2020 (taito 1978)
function _init()
 cartdata("invaders_minionsoft_2020")
 hiscore = dget(0)
	
 c0=7
 c1=7
 cls(1)
 shield={}
 shld={1,5,5,2,5,5,5,5,5,3,4,5,5,0,0,5}
 ufo_alive=0
 ufo_dir=0
 ufo_x=0
 ufo_anm=0
 
	particles={}
 missiles={}

	game_state="title"
	
	game_reset()
	
	invaders_setup(1)
	shld_setup()
	
end

function shld_setup()
	shield={}
 shld={1,7,7,2,7,4,5,7,7,0,0,7}
	add(shield,shld)
 shld={1,7,7,2,7,4,5,7,7,0,0,7}
	add(shield,shld)
 shld={1,7,7,2,7,4,5,7,7,0,0,7}
	add(shield,shld)
end

function shld_draw()
	l=0
 for shd in all(shield) do
		for m=1,12 do
			a=shd[m]
			spr(a+32,(l*40)+16+(((m-1)%4)*4),(96+(flr((m-1)/4)*4)))
		end
		l+=1
	end
end

function shld_collision()
	l=0
 for shd in all(shield) do
		for m=1,12 do
			a=shd[m]
			x=(l*40)+16+(((m-1)%4)*4)
			y=96+(flr((m-1)/4)*4)
			if a!=0 then
			 if fire!=0 then
					if collision(fire_x+3,fire_y+2,1,6,x,y,4,4) then
						fire=0
						if a==7 then 
							b=flr(4+rnd(2))
						elseif (a==4 or a==5) then
						 b=6
						else
							b=0
						end
						shd[m]=b
					end
				end
			end
		end
		l+=1
	end

	l=0
 for shd in all(shield) do
		for m=1,12 do
			a=shd[m]
			x=(l*40)+16+(((m-1)%4)*4)
			y=96+(flr((m-1)/4)*4)
			if a!=0 then
		 
		  for miss in all(missiles) do
					if miss.t>0 then
			 
						if collision(miss.x+2,miss.y,4,8,x,y,4,4) then
							miss.t=0
							if a==7 then 
								b=flr(1+rnd(2))
							elseif (a==1 or a==2) then
							 b=3
							else
								b=0
							end
							shd[m]=b
						end
							
					end		
				end
			end
		end
		l+=1
	end
	
l=0
 for shd in all(shield) do
		for m=1,12 do
			a=shd[m]
			x=(l*40)+16+(((m-1)%4)*4)
			y=96+(flr((m-1)/4)*4)
			if a!=0 then
		 	if inv_bottom_y>y then
		 		shd[m]=0
		 	end
			end
		end
		l+=1
	end




end

function ufo_setup()
	ufo_alive=1
	ufo_anim=0
	if rnd(100)>50 then
		ufo_dir=1
		ufo_x=-14
	else
		ufo_dir=-1
		ufo_x=128
	end	
	sfx(7)
end

function ufo_kill()
	ufo_alive=0
	sfx(7,-2)
end

function ufo_move()
	ufo_x+=ufo_dir
	if ufo_dir==1 and ufo_x>=128 then
		ufo_kill()
	end
	if ufo_dir==-1 and ufo_x<=-14 then
		ufo_kill()
	end
	ufo_anim-=ufo_dir
	if ufo_anim>3 then	ufo_anim=0 end
	if ufo_anim<0 then	ufo_anim=3 end
		
end
		
function ufo_draw()
	spr(8+(ufo_anim*16),ufo_x,0,2,1)
--	spr(9+(ufo_anim*16),ufo_x+8,0)
end

function draw_title()
	cls(1)
	spr(128,24,16,10,2)
	spr(64,0,32,16,3)

	spr(1,20,58)      print("....... 30 pts",48,58)
	spr(2,20,66)      print("....... 20 pts",48,66)
	spr(3,20,74)      print("....... 10 pts",48,74)
	spr(8,17,82,2,1)  print("...... 100 pts",48,82)
	print("press Ž to play",32,108,11)
	
	draw_display()
	
end

function game_reset()
 score=0
 men=3
 wave=0
 
 man_x=12
 player_start()
 
 fire=0
 fire_x=0
 fire_y=0
 
 level=1
 invaders_setup(level)
	shld_setup()

end

function game_over()
	pal(c0,c1,0)
	c1+=1
	if btn(4) or c1>120 then
		game_state="title"
		pal(7,7)
	end
end

function draw_gameover()
	for n=0,3 do
		spr(10+n,48+(n*8),44)
		spr(26+n,48+(n*8),64)
	end
end

function player_start()
 man_alive=-1
 man_flash=0
 man_timer=50
 man_x=12
 if men==0 then
 	game_state="gameover"
 	c1=0
 end
end

function _update()

	if game_state=="title" then
		if btnp(4) then
			game_state="game"
			game_reset()
		end			
	elseif game_state=="game" then
	 game()
	elseif game_state=="gameover" then 
	 game_over()
	end
end

function game()
	invaders_move()
	player_control()
	shot_move()
	miss_update()

	shot_collisions()
	miss_collision()
--	shld_collision()

	part_update()

	if ufo_alive==0 and rnd(1000)>997 then
		ufo_setup()
	end
	
	if ufo_alive==1 then
		ufo_move()
	end
	
	if man_alive==0 then
		if #missiles==0 then
		 if #particles==0 then
		  if ufo_alive==0 then
		   player_start()
		  end
	  end
	 end
	end
	
	if man_alive==2 then
		if #missiles==0 then
		 if #particles==0 then
		  if ufo_alive==0 then
		  	wave+=1
		   invaders_setup(wave)
	   	shld_setup()
		   player_start()
		  end
	  end
	 end
	end
	
end

function miss_collision()
 for miss in all(missiles) do
		if miss.t>0 then
			if man_alive==1 then
			 if collision(miss.x+2,miss.y,4,8,man_x,116,7,4) then
					man_alive=0
					part_explode2(man_x+4,119)
					sfx(6)
					men=men-1
				end
			end
		end
	end
end

function shot_collisions()
	for i=1,#inv_x do
		if fire!=0 then
			if inv_t[i]>0 then	
			 if collision(fire_x+3,fire_y+2,1,6,inv_x[i]+1,inv_y[i]+1,6,6) then
					if inv_t[i]==3 then score+=10 end
					if inv_t[i]==2 then score+=20 end
					if inv_t[i]==1 then score+=30 end
					part_explode(inv_x[i]+4,inv_y[i]+4)
			 	inv_t[i]=-1
	 			fire=0
	 			sfx(5)
	 		end
	 	end
	 end
	end

	if fire!=0 then
		if ufo_alive==1 then
		 if collision(fire_x+3,fire_y+2,1,6,ufo_x,0,14,8) then
				part_explode(ufo_x+6,8)
				score+=100
				fire=0
				sfx(5)
				ufo_kill()
			end
		end
	end
			
end 

function collision(x1,y1,w1,h1,x2,y2,w2,h2)

	--rectfill(x1,y1,x1+w1-1,y1+h1-1,12)
	--rectfill(x2,y2,x2+w2-1,y2+h2-1,12)

	if x1+w1-1<x2 then return false end
	if x1>x2+w2-1 then return false end
	if y1+h1-1<y2 then return false end
	if y1>y2+h2-1 then return false end
	return true
end 

function shot_draw()
	if fire!=0 then
		spr(20,fire_x,fire_y)
	end
end

function shot_move()
	if fire==1 then
		fire_y-=4
		if fire_y<=0 then
			fire=0
		end
	end
end
 
function player_control()
	if man_alive==0 then return end
		
	if btn(0) and man_x>12	then 
		man_x-=2
 end
	if btn(1) and man_x<108 then
	 man_x+=2
	end
	if man_alive==2 then return end
	if btnp(4) and fire==0 then 
		fire=1
		fire_x=man_x
		fire_y=112
		sfx(4)
	end
end


function player_draw()
	man_flash=1-man_flash

	if man_alive==-1 and man_flash==0 then 
 	spr(4,man_x,112)
 	man_timer-=1
 	if man_timer<=0 then
 			man_alive=1
 	end
	end

	if man_alive>=1 then
 	spr(4,man_x,112)
	end
end

function _draw()
	if game_state=="title" then
		draw_title()
	elseif game_state=="game" then
	 draw_game()
	elseif game_state=="gameover" then 
  draw_gameover()
 end
end

function draw_game()
	cls(1)
	shld_draw()
	invaders_draw()
	
	player_draw()
	shot_draw()
	miss_draw()
		
	if ufo_alive==1 then
		ufo_draw()
	end

--	shot_collisions()
	
	part_draw()
	
		shld_collision()

	draw_display()
end
function draw_display()
	if score>hiscore then
		hiscore=score
		save_hiscore()
	end
	
	line(0,119,128,119,7)
	pset(12,120)
	pset(116,120)
	rectfill(0,121,127,127,0)
	print("score:"..pad(score,5),1,122,7)
	print("men:"..men,56,122,7)
	print("high:"..pad(hiscore,5),88,122,7)
end

function invaders_move()
	local cnt=0
	if man_alive==0 or man_alive==2 then return end
	for i=1,#inv_x do
		if inv_t[i]>0 then
			cnt=cnt+1
		end
	end
	if cnt<1 then
		man_alive=2
	 return
	end
	
	inv_count+=1
	if inv_count<=(cnt/2) then
		return
	end
	inv_count=0
	if inv_drop==false then
		for i=1,#inv_x do
			if inv_t[i]>0 then
				if inv_y[i]+8>inv_bottom_y then
					inv_bottom_y=inv_y[i]+8
				end
				if inv_x[i]<=0 or inv_x[i]>=119 then
					inv_drop=true
				end
			end
		end
	else
		inv_drop=false
	end
	if inv_drop==false then
		for i=1,#inv_x do
			inv_x[i]+=(inv_dir*2)
		end
	else
		for i=1,#inv_x do
			inv_y[i]+=4
		end
		inv_dir=-inv_dir
		--inv_drop=false
	end
	inv_anim=1-inv_anim
	sfx(inv_snd)
	inv_snd+=1
	if inv_snd>3 then
		inv_snd=0
	end
	for n=1,#inv_t do
		if inv_t[n]>0 then
			if rnd(100)>97 then
				miss_add(1,inv_x[n],inv_y[n])
			end
			if inv_y[n]>=112 then
				man_alive=0
				part_explode2(man_x+4,119)
				sfx(6)
				men=0
			end
		end
	end
end

function invaders_draw()
	for i=1,#inv_x do
		spr(inv_t[i]+(inv_anim*16),inv_x[i],inv_y[i])
	end
end

function invaders_setup(h)
	inv_x={}
	inv_y={}
	inv_t={}
	inv_bottom_y=0
	inv_dir=1
	inv_drop=false
	inv_anim=0
	inv_count=0
	inv_snd=0
 if h>6 then h=6 end
 
	for n=1,9 do
		for m=1,5 do
			add(inv_x,(n-1)*12+2)
			add(inv_y,((m-1)+(h))*10-2)
			if m==1 then add(inv_t,1) end
			if m==2 or m==3 then add(inv_t,2) end
			if m==4 or m==5 then add(inv_t,3) end
		end
	end
	
end
		
function pad(a,l)
	x=""
	x=tostr(a)		
	while #x<5 do
		x="0"..x
	end
	return x
end

			
function print_centered(str,y,c)
  print(str, 64 - (#str * 2), y,c) 
end

function part_explode(x,y)
	for n=1,120 do
		part_add(1,x,y,rnd(360)/360.0,rnd(20)/20.0,10+rnd(6))
	end
end

function part_explode2(x,y)
	for n=26,75,3 do
		part_add(1,x,y,n/100.0,0.3,10)
		part_add(1,x,y,n/100.0,0.4,15)
		part_add(1,x,y,n/100.0,0.5,20)
		part_add(1,x,y,n/100.0,0.6,25)
		part_add(1,x,y,n/100.0,0.7,30)
		part_add(1,x,y,n/100.0,0.8,35)
	end
end

 
function save_hiscore()
  dset(0, hiscore)
end



-->8
function part_add(_t, _x, _y, _dr, _sp, _dur)
 local part = {
  t = _t,
  x = _x,
  y = _y,
  dr = _dr,
  sp = _sp,
  dur = _dur
 }
 add(particles, part)
end

function part_update()
 for part in all(particles) do
  -- whatever you want with particle
  -- e.g.
		if part.t>0 then
			if part.t==1 then
		  part.x+=(sin(part.dr)*part.sp)
		  part.y+=(cos(part.dr)*part.sp)
		 end
		end
		part.dur-=1
		if part.dur<=0 then
			part.t=0
		end
 end

	part_delete()
end

function part_delete()
 for part in all(particles) do
  if (part.t == 0) then
   del(particles, part)
  end
 end
end

function part_draw()
 for part in all(particles) do
		if part.t>0 then
			if part.t==1 then
				pset(part.x,part.y,8)
			end
		end
	end
end
-->8
function miss_add(_t,_x,_y)
	if man_alive==0 then return end
 local miss = {
  t = _t,
  x = _x,
  y = _y,
  sp=  2,
  anm= 0
 }
 add(missiles, miss)
end

function miss_update()
 for miss in all(missiles) do
		if miss.t>0 then
			if miss.t==1 then
		  --part.x+=(sin(part.dr)*part.sp)
		  miss.y+=2
				miss.anm=1-miss.anm
		 end
		end
		if miss.y>=112 then
			miss.t=0
		end
 end

	miss_delete()
end

function miss_delete()
 for miss in all(missiles) do
  if (miss.t == 0) then
   del(missiles, miss)
  end
 end
end

function miss_draw()
 for miss in all(missiles) do
		if miss.t>0 then
			if miss.t==1 then
				spr(5+(miss.anm*16),miss.x,miss.y)
			end
		end
	end
end
