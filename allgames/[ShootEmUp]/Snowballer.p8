pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
function _init()
menuinit()
end

function _update()
	if menu==true then
		menuupdate()
		elseif menu==false and gameover==false then
		gameupdate()
		elseif gameover==true then
		fgameover()
	end
end

function _draw()
	if menu==true then
		menudraw()
		else
		gamedraw()
		if gameover==true then
		drawgameover()
		end
	end
end

--game stuff

-- game init
function gameinit()
pl={x=60,y=110,spd=1,pickingup=false, ballcap=10, balls=10}
plspr={top=1,bot=17,topthrow=33,botthrow=49,toppick1=2,botpick1=18,toppick2=3,botpick2=19,curtspr=1,curbspr=17,anitime=0}
lives=3
heart=80
emptyheart=81
en={}
snowballs={}
esnowballs={}
ballclock=0
ballrate=10
ballamount=10
throwspeed=10
throwtimer=0
throwrload=false
level=0
background={}
enemygen()
bkgrndgen()
soundfx={
[18]={i=18,playing=false,channel=3}
}
gameclock=0
gametimer=0
gameover=false
gameoverat=0
end

-- game update
function gameupdate()
gclock()
playerstates()
	if pl.pickingup then
		playerpickingup()
		else
		playernormal()
	end
drawplayer()
moveballs()
ballcheck()
eballcheck()
enemycollision()
enemysnowgen()
emoveballs()
enemymove()
--ballcollision()
levels()
livesgone()
end

function gclock()
	gametimer+=1
	if gametimer==30 then
		gameclock+=1
		gametimer=0
	end
end

-- game draw
function gamedraw()
	cls()
	rectfill(0,0,128,128,7)
	drawbkground()
	drawballs()
	playerdraw(pl.x,pl.y,plspr.curtspr,plspr.curbspr)
	print("snowballs:"..pl.balls,5,4,0)
	print("level:"..(level+1),5,11,0)
	enemydraw()
	draweballs()
	drawlives()
	presents()
end
-->8
--player stuff

--states
function playerstates()
	if gametimer>10 or gameclock>=1 then
		if btn(Ž) then
			pl.pickingup=true
			else
			pl.pickingup=false		
		end
	end
end

function playernormal()
moveply()
throw()
plyrcollision()
playstop(false,18)
end

function playerpickingup()
pickupballs()
playstop(true,18)
end

-- movement
function moveply()
			if btn(‹) and btn(‘)
			then pl.isstill=true
			elseif btn(‹) and pl.x>0 
			then pl.x-=pl.spd 
			pl.isstill=false	
			elseif btn(‘) and pl.x<122 
			then pl.x+=pl.spd
			pl.isstill=false
			end
end

-- throwsnowball
function throw()
	if throwrload==true then
		throwtimer+=1
		if throwtimer==flr(throwspeed/2)
			then	plspr.curtspr=plspr.top
			plspr.curbspr=plspr.bot
		end
		if throwtimer==throwspeed then
			throwtimer=0
			throwrload=false
		end
		else
		if btn(—) and pl.balls>0 then
			snowballgen()
			pl.balls-=1
			throwrload=true
			plspr.curtspr=plspr.topthrow
			plspr.curbspr=plspr.botthrow
			sfx(21)
		end
	end
end

-- pickup snowballs
function pickupballs()
ballclock+=1
	if ballclock>=ballrate then
	pl.balls=limit(pl.balls,1,ballamount)
	ballclock=0
	end
end

--drawing player

function drawplayer()
	if pl.pickingup then
		animateplayer()
		elseif throwrload==false then
		plspr.curtspr=plspr.top
		plspr.curbspr=plspr.bot
	end	
end

--


--animate player
function animateplayer()
	plspr.anitime+=1
	if plspr.anitime>=5 then
		if plspr.curtspr==plspr.toppick1 then
			plspr.curtspr=plspr.toppick2
			plspr.curbspr=plspr.botpick2
			else
			plspr.curtspr=plspr.toppick1
			plspr.curbspr=plspr.botpick1
		end
		plspr.anitime=0
	end
end

--draw lives

function drawlives()
	for i=1, 3 do
		spr (emptyheart,118-((i-1)*10),4)
	end
	for i=1, lives do
		spr (heart,118-((i-1)*10),4)
	end
end

function livesgone()
	if lives<=0 then
	gameoverat=gameclock
 sfx(23)
	gameover=true
	end
end

--game over
function fgameover()
gclock()
	if btn(Ž) and gameclock>=(gameoverat+2) then
		gameover=false
		music(-1,400)
		menuinit()
		menu=true
	end
end

function drawgameover()
	cooltext("gameover",centretext("gameover",64),64,11,8)
	if gameclock>=(gameoverat+2) then
		print("press Ž to restart",centretext("press Ž to restart",64),110,0)
	end
end
-->8
--snowballs

--add snowball
function newsnow(x,y,speed,slice)
	local s={}
	s.i=#snowballs+1
	s.x=x
	s.y=y
	s.speed=speed
	return s
end	

		
--snowball generator
function snowballgen()
	local x=pl.x+3
	local y=pl.y
	local speed=rnd(0.3)+4
 s=newsnow(x,y,speed)
 add (snowballs,s)
end

-- draw snowballs
function drawballs()
	for i=1,#snowballs do
	spr (64,snowballs[i].x,snowballs[i].y)
	end
end

--snowballs movement
function moveballs()
 for i=1,#snowballs do
	snowballs[i].y-=snowballs[i].speed
	end
end

-- checksnowball didnt go to far
function ballcheck()
	if #snowballs>=1 then
		for i=1,#snowballs do
	 	if snowballs[i].y < 0 then
	 		del (snowballs,snowballs[i])
	 		break
			end
		end
	end
end

--enemy snowballs


--add snowball
function enewsnow(x,y,speed)
	local s={}
	s.i=#esnowballs+1
	s.x=x
	s.y=y
	s.speed=speed
	return s
end	

--enemy snowball gen
function enemysnowgen()
	if #esnowballs<=150 then
 for i=1,#en do
  en[i].rtime-=1
  if en[i].rtime==flr(en[i].rspeed/2)
  	then en[i].curtop=en[i].top1
  	en[i].curbot=en[i].bot1
  end
  if en[i].rtime<=0 then
  esnowballgen(en[i].x,en[i].y)
  en[i].rtime=en[i].rspeed
  en[i].curtop=en[i].top
  en[i].curbot=en[i].bot
  end
 end
 end
end
		
--snowball generator
function esnowballgen(x,y)
	local speed=rnd(1*(level/2))+1
	local x+=2
	local y+=6
 s=enewsnow(x,y,speed)
 add (esnowballs,s)
end

-- draw snowballs
function draweballs()
	for i=1,#esnowballs do
	spr (65,esnowballs[i].x,esnowballs[i].y)
	end
end

--snowballs movement
function emoveballs()
 for i=1,#esnowballs do
	esnowballs[i].y+=esnowballs[i].speed
	end
end

-- checksnowball didnt go to far
function eballcheck()
	if #esnowballs>=1 then
		for i=1,#esnowballs do
	 	if esnowballs[i].y > 127 then
	 		del (esnowballs,esnowballs[i])
	 		break
			end
		end
	end
end


-->8
--scripts

-- draw two pixel deep
function playerdraw(x,y,t,b)
	spr (t,x,y)
	spr (b,x,y+8)
end

-- limiter
function limit(target,amount,limit)
local toplimit=false
	if amount>0 then
		toplimit=true
		elseif amount<0 then
		toplimit=false
	end
target+=amount
	if toplimit==true then
						if (target>limit) target=limit
	else if (target<limit) target=limit
	end
	return target
end

--reset delete
function deleteall(target)
	while #target~=0 do
		for i=1,#target do
			del (target,target[i])
		end
	end
end

--cooltext
function cooltext(text,x,y,col1,col2)
	print(text,x-1,y,col2)
	print(text,x-1,y+1,col2)
	print(text,x,y+1,col2)
	print(text,x,y,col1)
end

-- centre text (x only)
function centretext(text,x)
	x=x-(((#text*4)/2)-1)
	return x
end


-- play and stop looped fx

function playstop(play,name)
local fx=soundfx[name]
	if play==false and fx.playing==true
		then 
		sfx(-1,fx.channel)
		fx.playing=false
	elseif play==true and fx.playing==false
		then
		sfx(fx.i,fx.channel)
		fx.playing=true
	end
end
-->8
--enemies

-- draw all the enemies
function enemydraw()
	for i=1,#en do
	local x=en[i].x
	local y=en[i].y
	local t=en[i].curtop
	local b=en[i].curbot
	playerdraw(x,y,t,b)
	end
end

--add enemy
function newenemy(x,y,speed,rspeed)
	local e={}
	e.i=#en+1
	e.x=x
	e.y=y
	e.top=4
	e.top1=5
	e.bot=20
	e.bot1=21
	e.curtop=e.top
	e.curbot=e.bot
	e.speed=speed
	e.rspeed=rspeed
	e.rtime=rspeed
	return e
end	

--enemy generator
function enemygen()
	local x=rnd(125)+1
	local y=rnd(10)+10
	local speed=rnd(level/5)+1
	local rspeed=flr(rnd(15)+10)
 e=newenemy(x,y,speed,rspeed)
 add (en,e)
end

-- enemy movement

function enemymove()
	for i=1,#en do
		en[i].x+=en[i].speed
		if en[i].x>=128 or en[i].x<=0
		then en[i].speed*=-1
		end
	end
end

--enemy levels

function levels()
	if #en==0 then
		level+=1
		deleteall(esnowballs)
		deleteall(snowballs)
		deleteall(background)
		bkgrndgen()
		sfx(17)
		for i=1, level*2 do
			enemygen()
		end
	end
end
-->8
-- collision

--check enemy collision
function enemycollision()
	if #snowballs>=1 and #en>=1 then
		for ei=1,#en do
		 local coll=false
			for si=1,#snowballs do
			coll=collision(en[ei].x,en[ei].y,snowballs[si].x,snowballs[si].y)
				if coll==true then
	 			del (snowballs,snowballs[si])
	 			if #en>1 then
	 				sfx(19)
	 			end
	 			break
				end
			end
			if coll==true then
	 		del (en,en[ei])
	 		break
	 	end
		end
	end
end

--collision
function collision(plx,ply,objx,objy)
local coll=false
objx+=1
objy+=1
	if objx>=plx-1 and objx<=plx+6 and objy>=ply and objy<=ply+11
	then
	coll=true
	end
	return coll
end

--check snowball collision

function ballcollision()
	if #snowballs>=1 and #esnowballs>=1 then
		for si=1,#snowballs do
		 local coll=false
			for ei=1,#esnowballs do
			coll=collision(snowballs[si].x,snowballs[si].y,esnowballs[ei].x,esnowballs[ei].y)
				if coll==true then
	 			del (esnowballs,esnowballs[ei])
	 			break
				end
			end
			if coll==true then
	 		del (snowballs,snowballs[si])
	 		break
	 	end
		end
	end
end

-- player ball collision
function plyrcollision()
	if #esnowballs>=1 then
			for es=1,#esnowballs do
				local coll=false
				coll=collision(pl.x,pl.y,esnowballs[es].x,esnowballs[es].y)
				if coll==true then
	 			del (esnowballs,esnowballs[es])
	 			lives-=1
	 			if lives>0 then
	 				sfx(20)
	 			end
	 			break
				end
			end
	end
end
-->8
--menu system

--menu init
function menuinit()
palt(0,false)
palt(2,true)
menu=true
txt={
"robot santas have",
"taken christmas hostage",
"use your baller skills",
"to take them all down",
"and save christmas",
}
txt2={
"use ‹ and ‘ to move",
"press — to throw snowballs",
"hold Ž to dig for snowballs...",
"...and duck for cover",
"avoid the enemies fire",
"destroy the robots",
"and good luck!"
}
clock=0
timer=0
txttimer=0
txtcount=0
txtcount2=0
snowflakes={}
end


--menu update
function menuupdate()
	clocktimer()
	startmusic()
	menusnowgen()
	snowfall()
	menuflakecheck()
	if clock<=(#txt*2)+2
		then
			txtcount=txtrevealtimer(txtcount,txt)
		else
			txtcount2=txtrevealtimer(txtcount2,txt2)
	end
	if clock>=(#txt*2)+(#txt2*2)+4 or (btnp(Ž) and clock>=1)
	then 
	gameinit()
	deleteall(snowflakes)
	menu=false
	end
end



--menu draw
function menudraw()
cls()
rectfill(0,0,128,128,7)
	for i=1, #snowflakes do
		local snow=snowflakes[i]
		spr(snow.flake,snow.x,snow.y)
	end
cooltext("snow baller",centretext("snow baller",64),30,0,12)
	if clock<=(#txt*2)+2
		then
			drawtxtreveal(txt,txtcount)
		else
			drawtxtreveal(txt2,txtcount2)
	end
	if clock>=1 then
		print("press Ž to skip intro",centretext("press Ž to skip intro",64),110,0)
	end
end


--menu text reveal
function drawtxtreveal(txttable,counter)
	for i=1, counter do
		local y=50+(7*(i-1))
		local text=txttable[i]
		print(text,centretext(text,64),y,0)
	end
end

function txtrevealtimer(count,txttable)
local c=count
	if txttimer==2 then
		c=limit(count,1,#txttable)
		txttimer=0
	end
return c
end

function clocktimer()
	timer+=1
	if timer==30 then
		clock+=1
		txttimer+=1
		timer=0
	end
end


--snowflake generator
function menusnowgen()
	if timer==1 or timer==16 and #snowflakes<=40 then
	local x=flr(rnd(121))
	local y=-7
	local flake=flr(rnd(6))+99
	local speed=rnd(1)+0.5
 s=makeflake(x,y,speed,flake)
 add (snowflakes,s)
	end
end

function makeflake(x,y,speed,flake)
	local s={}
	s.x=x
	s.y=y
	s.spd=speed
	s.flake=flake
	return s
end


--checkflakes gone too far/delete it
function menuflakecheck()
	if #snowflakes>=1 then
		for i=1,#snowflakes do
	 	if snowflakes[i].y > 127 then
				snowflakes[i].y=-7
			end
		end
	end
end

function snowfall()
	for i=1, #snowflakes do
		snowflakes[i].y+=snowflakes[i].spd
	end
end

function startmusic()
	if clock==1 and timer==0 then
	music(0,10)
	end
end
-->8
--background

function presents()
end

function bkgrndrandom()
	local b={}
	b.x=flr(rnd(128))
	b.y=flr(rnd(128))
	b.s=flr(rnd(8)+67)
	return b
end

function bkgrndgen()
	for i=1, flr(rnd(20)+10)
		do b=bkgrndrandom()
		add(background,b)
	end
end

function drawbkground()
	for i=1, #background do
		local b=background[i]
		spr(b.s,b.x,b.y)
	end
end
