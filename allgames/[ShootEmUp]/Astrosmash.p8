pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
--astrosmash!
--a pico-8 demake by tim
--v1.1 2021/01/21

--start the title screen
--0=title, 1=game, 2=end
screen=0
tt=1
-->8
function _init()

	lc={3,		  --landscape colour
	0,1,2,12,5,0}	--bg per level
	sf={}	    --starfield
	la={}	    --landscape

	px=60	    --player x pos
	pxa=0	    --player x acceleration
	pb={}	    --player bullets
	af=false		--autofire
	afd=0					--delay till next autofire

	lives=3
	scoreh=0  --score hundreds
	scoret=0  --score thousands
	peakscoreh=0
	peakscoret=0
	level=1
	speed=1.0	--speed multiplier level 6
	nextlifet=1
	die_pause=0
	playt=0
	playm=0

	ep={}	    --enemy players

	c={       --types and points
	smallrock=20,
	bigrock=10,
	smallspinner=80,
	bigspinner=40,
	smoke=0,
	missile=50,
	ufo=100,
	ufoshot=-1
	}

	ufoout=0
	missileout=0

	--starfield
	for i=1,20 do
		add(sf,{x=rnd(128),y=rnd(90)})
	end
	--landscape
	y=105
	x=0
	repeat
	 yd=rnd(20)
	 xd=5+rnd(30)
		add(la,{x1=x,y1=y,x2=x+xd,y2=y-yd})
		ny=y+(rnd(10)-5)
		add(la,{x1=x+xd,y1=y-yd,x2=x+xd*2,y2=ny})
		y=ny
		x=x+xd*2
	until x>127

end
-->8
function _update()
 --in the game screen
 if screen==1 then game_update() end
end

function game_update()
 --track the in-game time
 playt+=1
 if playt>=30*60 then
 	playm+=1
 	playt-=30*60
 end
 
	if die_pause>0 then
		die_pause-=1
		if die_pause==0 and lives==0 then
			screen=2
		end
	else
 	if btn(0) then
 	 if pxa>0 then pxa=0 end
 		px+=-2+flr(pxa)
 		pxa-=0.5
 		if px<=1 then px=1 end
 	elseif btn(1) then
 	 if pxa<0 then pxa=0 end
 		px+=2+flr(pxa)
 		pxa+=0.5
 		if px>=119 then px=119 end
 	else
 	 pxa=0
 	end
 	if pxa>6 then pxa=6 end

 	if btnp(5) or btnp(3) then
 		px=flr(1+rnd(118))
 		pxa=0
 		sfx(3)
 	end
 	
 	--for testing levels
 	--if btnp(5) then
 	-- scoret+=10
 	-- lives+=10
 	-- update_score(0)
 	--end

		if afd<=0 and (btn(4) or af) then
 		add(pb,{x=px,y=113,dy=-5})
 		sfx(0)
 		afd=14-level
 	end
 	afd-=1
 	if btnp(2) then af=not(af) end
		if (not(af) and not(btn(4))) afd=0

		--new rocks
		if rnd(1000)>(985-level) and ufoout==0 then
			add(ep,{x=rnd(120),y=-7,w=1,h=1,
				dx=(rnd(0.5)-0.25)*level,
				dy=(level/2+rnd(1))*speed,
				s=16,fc=1,fps=1,f=1,t=c.smallrock,
				c=flr(rnd(15))+1})
		end
		if rnd(1000)>(980-level) and ufoout==0 then
			add(ep,{x=rnd(120),y=-7,w=2,h=1,
				dx=(rnd(0.5)-0.25)*level,
				dy=(level/1.5+rnd(1))*speed,
				s=32,fc=1,fps=1,f=1,t=c.bigrock,
				c=flr(rnd(15))+1})
		end
		--new spinners
		if rnd(1000)>(998-level) and ufoout==0 then
			add(ep,{x=rnd(120),y=-7,w=1,h=1,
				dx=(rnd(0.25)-0.25/2)*level,
				dy=(level/4+rnd(2))*speed,
				s=2,fc=4,fps=3,f=1,t=c.smallspinner})
		end
		if rnd(1000)>(997-level) and ufoout==0 then
			add(ep,{x=rnd(120),y=-7,w=2,h=2,
				dx=(rnd(0.25)-0.25/2)*level,
				dy=(level/3+rnd(2))*speed,
				s=18,fc=4,fps=3,f=1,t=c.bigspinner})
		end
		--missile
		if missileout==0 and rnd(1000)>(999-level+2) then
			add(ep,{x=flr(rnd(128)),y=1,w=1,h=1,
				dx=0,
				dy=2+flr(level/3),
				s=55,fc=2,fps=10,f=1,t=c.missile})
			missileout=20
			sfx(6,1)
		end
		--ufo
		if level>=4 and ufoout==0 and rnd(1000)>(999-level+4) then
			add(ep,{x=-6,y=flr(rnd(50)),w=2,h=1,
				dx=level/3,
				dy=0,
				s=48,fc=3,fps=3,f=1,t=c.ufo})
			ufoout=20
			sfx(5,0,0,0)
		end

	end

	--move and animate enemies
	player_hit=false
	for e in all(ep) do
		e.x+=e.dx
		e.y+=e.dy
		e.f+=1
		if e.f>=e.fc*e.fps then
			e.f=0
			if e.die==true then del(ep,e) end
		end

		--hit player?
		--bumped over 109 for more tolerance
		if e.y+8>=109+3 and e.t!=c.smoke then
			if (px>=e.x and px<=e.x+e.w*8)
			or (px+7>=e.x and px+7<=e.x+e.w*8) then
				del(ep,e)
				player_hit=true
			end
		end

		--hit ground
		if e.y+e.h*8>=120 and e.t!=c.missile then
			if e.t==c.smallspinner
			or e.t==c.bigspinner then
				player_hit=true
			end

			if e.t>0 then
				update_score(e.t/-2)
			end

			del(ep,e)
		end

		if e.t==c.missile then
			missileout+=1
			if missileout==0 then
				sfx(0,1)
				del(ep,e)
			else
				if missileout>10 then
					e.dx=2 --level/3
				 if e.x>px+4 then e.dx=-e.dx end
					missileout=1
				end
				if e.y>109 then
					e.y=109
					e.dy=0
					e.dx=3
					if e.x>px+4 then e.dx=-e.dx end
					--survive 20-ish more frames
					missileout=-18-level*2
				end
			end
		end

		if e.t==c.ufo then
			ufoout+=1
			if ufoout>(7-level)*10 then
			 --ufo shoots
				add(ep,{x=e.x,y=e.y,w=1,h=1,
					dx=(px-e.x)/(40-level*2)*speed,
					dy=(108-e.y)/(40-level*2)*speed,
					s=54,fc=1,fps=3,f=1,t=c.ufoshot})
			 ufoout=1
			end
	 end

		--out of bounds
		--if e.x<=-7 or e.x>=128 then
		if (e.x+e.w*8)<=4 or e.x>=125 then
		 if e.t==c.missile then
		  missileout=0
		  sfx(0,1)
		 end
		 if e.t==c.ufo then
		 	ufoout=0
		 	sfx(0,0,0,0)
		 end
			del(ep,e)
		end

		if e.t==c.smallspinner
		or e.t==c.bigspinner then
			sfx(1,-1,e.y/4,1)
		end

		--next enemy
	end

		--update player bullets
	for b in all(pb) do
		b.y+=b.dy
		if b.y<-7 then del(pb,b) end

		--bullet hit something?
		for e in all(ep) do
			if b.x+5>=e.x and b.x+3<e.x+e.w*8
			and b.y>e.y and b.y<=e.y+e.h*8
			and e.t>0 then
				del(pb,b)
				update_score(e.t)

				--big rock splits into two
				if e.t==c.bigrock then
					add(ep,{x=e.x+2,y=e.y,w=1,h=1,
						dx=abs(e.dx)*1*level,
						dy=e.dy,
						s=16,fc=1,fps=1,f=1,t=c.smallrock,
						c=e.c})
					add(ep,{x=e.x-1,y=e.y,w=1,h=1,
						dx=abs(e.dx)*-1*level,
						dy=e.dy,
						s=16,fc=1,fps=1,f=1,t=c.smallrock,
						c=e.c})
				end

				--shot the missile
				if e.t==c.missile then
					missileout=0
					sfx(0,1)
				end

				--shot the ufo
				if e.t==c.ufo then
					ufoout=0
					sfx(0,0,0,0)
				end

				--replace enemy with explosion
				e.s=6
				e.x+=((e.w-1)*8/2)
				e.w=1
				e.h=1
				e.fc=4
				e.fps=3
				e.f=1
				e.dx=0
				e.dy=0
				e.t=c.smoke
				e.die=true
				sfx(4)
			end
		end
	end

	if player_hit then player_dies() end

end

function player_dies()
	if die_pause==0 then
	 sfx(2)
	 lives-=1
	 update_score(-100)
	 die_pause=40
	 ufoout=0
	 sfx(0,0)
	 missileout=0
	 sfx(0,1)
	 ep={}
 	add(ep,{x=px,y=109,w=1,h=1,dx=-2,dy=0,s=6,fc=4,fps=3,f=1,t=c.smoke,die=true})
 	add(ep,{x=px,y=109,w=1,h=1,dx=2,dy=0,s=6,fc=4,fps=3,f=1,t=c.smoke,die=true})
 	add(ep,{x=px,y=109,w=1,h=1,dx=-1,dy=-1,s=6,fc=4,fps=3,f=1,t=c.smoke,die=true})
 	add(ep,{x=px,y=109,w=1,h=1,dx=1,dy=-1,s=6,fc=4,fps=3,f=1,t=c.smoke,die=true})
 	add(ep,{x=px,y=109,w=1,h=1,dx=0,dy=-2,s=6,fc=4,fps=3,f=1,t=c.smoke,die=true})
 	px=60
 end
end

function update_score(points)
	scoreh+=points*level
	if scoreh>=1000 then
		scoret+=1
		scoreh-=1000
		if scoret>=nextlifet then
			lives+=1
			nextlifet+=1
		end
	end
	if scoreh<=-1000 then
		scoret-=1
		scoreh+=1000
	end
	if points>0 then
		peakscoreh+=points*level
		if peakscoreh>=1000 then
			peakscoret+=1
			peakscoreh-=1000
			--lives+=1
		end
	end
	
	level=1
	if scoret>0 then level=2 end
	if scoret>4 then level=3 end
	if scoret>19 then level=4 end
	if scoret>49 then level=5 end
	if scoret>99 then level=6 end
	
	speed=1.0
	if scoret>104 then
	 speed=1.0+(scoret/1000)
	end
end
-->8
function _draw()
 if screen==0 then
 	title_screen()
		--start game
 	if btn(4) or btn(5) then screen=1 end
 end

 if screen==1 then game_screen() end

 if screen==2 then
 	end_screen()
 	--another go
 	if btn(4) or btn(5) then
 		_init()
 		screen=1
 	end
 end
end


function game_screen()
	if die_pause>0 then
		cls(8)	--death animation
	else
		cls(lc[level+1])
	end
	--starfield
	for i in all(sf) do
		line(i.x,i.y,i.x,i.y,7)
	end
	--horizon
	line(0,118,127,118,lc[1])
 --landscape
	for i in all(la) do
		line(i.x1,i.y1,i.x2,i.y2,lc[1])
	end

	--player
	if die_pause==0 then
		--rect(px,0,px+7,128,1)
		spr(1,px,109)
		--player bullets
		for i in all(pb) do
			spr(17,i.x,i.y)
		end
	end

	--enemy players
	for i in all(ep) do
		--rocks have own colours
		if i.t==c.smallrock or i.t==c.bigrock then
			--leave brown if same as level background
			if i.c!=lc[level+1] then
				pal(4,i.c)
			end
		end
		spr(i.s+(flr(i.f/i.fps)*i.w),i.x,i.y,i.w,i.h)
		pal()
	end

 --hud
	pal(7,3)
	if lives<=4 then
		for i=1,lives do
			spr(1,60+i*9,120)
		end
	else
		spr(1,69,120)
		print(lives,80,122,3)
	end
	pal()
	display=display_score(scoret,scoreh)
	print(display,60-(#tostr(display)*4),122,7)
	print(level.."x",116,122,7)
end

function end_screen()
	die_pause=1
	game_screen()
	scale_text("game over",28,30,2,2,7)
	rectfill(0,0,34,4,8)
	color(0)
	print("score = "..display_score(scoret,scoreh),20,50)
	print("peak score = "..display_score(peakscoret,peakscoreh),20,60)
	print("play time = "..playm.." min",20,70)
	print("press Ž/—",20,84)
end

--make a displayable string
--from the thousands and hundreds
function display_score(t, h)
	if t!=0 then
		display="00"..abs(h)
		display=t..sub(display, #display-2, #display)
	else
		display=h
	end
 return display
end
-->8
function title_screen()

 y=1
 if tt>100 then
 	y=100-tt+1
 end
 if tt>165 then
  y=-65
 end

	cls(3)
 scale_text("mattel electronics",10,y+30,1.5,2,7)
 scale_text("presents",40,y+45,1.5,2,7)
 scale_text("  astrosmash!  ",7,y+75,2,2,7)
 print("a pico-8 demake by tim",21,y+88,6)
 scale_text("copr @ 1981 mattel",10,y+105,1.5,2,7)

	for i=1,9 do
	 rectfill(128/20*i*2-2,y+10,128/20*i*2+2,y+20,i)
 end

	print("‹‘ move turret",20,y+130)
	print("Ž   fire",20,y+138)
	print("—   hyperspace",20,y+146)
	print("”   auto-fire",20,y+154)
	print("press Ž/— to start",20,y+170)

	tt+=2

end

//adapted from
//https://www.lexaloffle.com/bbs/?tid=29612
function scale_text(text,tlx,tly,sx,sy,col)
 print(text,0,0,col)
	for y=0,7 do
 	for x=0,#text*8-1 do
  	local col=pget(x,y)
   if col!=0 then
   	local nx=x*sx+tlx
   	local ny=y*sy+tly
   	if ny>8 then
   		rectfill(nx,ny,nx+sx,ny+sy,col)
  		end
  	end
 	end
 end
 print(text,0,0,3)
end
