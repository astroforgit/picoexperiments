function _init()
	
	-- cartdata
	cartdata("kjs_spaceshoot_21")
	
	-- set btnp delays
	poke(0x5f5c,5)
	poke(0x5f5d,5)
	
	-- menu
	menuitem(1,"cycle background",function() background_state=not background_state end)
	menuitem(2,"toggle shake",function() shake_state=not shake_state end)
	menuitem(3,"toggle controls",init_controls)
	menuitem(4,"by @nerdofgamers",nil)
	
	-- debug
	test=false
	
	-- variables
	background_state=true
	controls_state=false
	shake_state=true
	p1,p2=0,1
	
	-- static vars
	killsperdrop=10
	dirs={
		{x=-1,y=0},{x=1,y=0},
		{x=0,y=-1},{x=0,y=1}
	}
	colbright1={
		[0]=1,13,8,3,
		4,5,6,7,
		8,10,7,11,
		12,13,14,15
	}
	colbright2={
		[0]=13,12,9,3,
		4,5,6,7,
		8,7,6,11,
		12,13,14,15
	}
	coldark1={
		[0]=0,0,1,2,
		2,1,13,6,
		4,8,9,3,
		13,5,4,9
	}
	
	reinit()
	
end

function init_controls()

	controls_state=not controls_state
	
	if controls_state then
		p1,p2=1,0
	else
	 p1,p2=0,1
	end
		
end

function reinit()
	
	-- start game
	restart()
	
	-- states
	stateupdate=updategamestart
	statedraw=drawgamestart
	
end

function restart()
	
	-- [1-6] s,x,y,b,w,h,
	-- [7-10] hp,bombs,speed,shotspeed,
	-- [11-13] orbs,multishot,score
	-- [14-16] kills,spec.type,weap.type
	player={48,60,82,1,1.0,1.0,3,3,2,5,{},0,0,0,0,0}
	-- s,x,y
	player2=nil
	-- highscore
	newbest=false
	-- camera
	cx,cy,shake=0,0,0
	-- anim
	frame,special,invuln,playtime=
	 0,0,0,0
	-- ui
	flashscreen,flashboss,flashsprite=
		false,false,nil
	-- endgame
	minispawned,bossspawned,boss=
	 false,false,nil
	 
	-- background
	stars,nebula,
	-- effects
	warping,explosions,particles,
	-- enemies
	ships,eshots,powerups,
	-- player
	pshots,pbombs,pbeams=
		{},{},{},{},{},{},{},{},{},{},nil
	
	local c={5,13,6,7}
	local r={0,0.25,0.5,0.75}
	while #stars<100 do
		local i=#stars+1
		local v=ceil(i/100*4)
		-- x,y,r,c,blink,variable_dy,orig_c
		local star={
			rnd(128),rnd(128),v/4,c[v],
			#stars%10,rnd(r),c[v]
		}
		add(stars,star)
	end
	
	local r=rnd({16,32,64})
	initnebula(r,10,10,2)
	initnebula(r,5,5,9)
	initnebula(r,4,2,10)
	
	-- 1 free orb
	initorb()
	
	-- test code
	if test then
		player[7]=5
		player[8]=5
		player[9]=4
		player[10]=1
		player[14]=130
		for i=1,7 do initorb() end
		player[12]=8
	end
	
end
-->8
-- update
function _update()
	
	stateupdate()
	
end

function updategamestart()
	
	frame+=0.25
	
	updatestars()
 updatenebula()
 updateeffects()
 updateorbs()
 
 if frame>5 then
	 if btnp(—,1) then
		 stateupdate=updategame
		 statedraw=drawgame
		 player2={0,60,60,1}
		elseif btnp(—,0) then
		 stateupdate=updategame
		 statedraw=drawgame
		 player2=nil
		end
	end

end

function updategameover()
	
	frame+=0.25
	
	updatestars()
 updatenebula()
 updateeffects()
 updateorbs()
 
	if btnp()!=0 and frame>5 then
	 stateupdate=updategamestart
	 statedraw=drawgamestart
		reinit()
	end

end

function updatestars()
	
	-- loop through all stars
	for star in all(stars) do
		-- update y
		star[2]+=star[3]*4+star[6]
		-- out of bounds check
		if (star[2]>130) star[1]=rnd(128) star[2]=-5
		-- update colour
		local c=pget(star[1],star[2])
		if flr(frame)%10==star[5] then
			star[4]=colbright2[c]
		elseif c!=1 then
			star[4]=colbright1[c]
		else
			star[4]=star[7]
		end
	end

end

function updatenebula()

	-- loop through all clouds
	for cloud in all(nebula) do
		if (frame%10==cloud[5]) cloud[1]+=rnd(0.4)-0.2 cloud[2]+=rnd(0.4)-0.2
	end
	
end

function updateeffects()

	-- loop through all clouds
	for cloud in all(explosions) do
		cloud[1]+=cloud[5]+rnd(0.2)-0.1
		cloud[2]+=cloud[6]+rnd(0.2)-0.1
		cloud[3]-=0.2
		if (rnd()<0.5) cloud[4]=coldark1[cloud[4]]
		if (cloud[4]==0) del(explosions,cloud)
	 if (cloud[7]) del(explosions,cloud)
	end
	
	-- loop through all exhaust
	for particle in all(particles) do
		particle[1]+=particle[5]
		particle[2]+=particle[6]
		if (rnd()<0.25) particle[3]-=0.25 
		if (rnd()<0.5) particle[4]=coldark1[particle[4]]
		if (particle[4]==0) del(particles,particle)
		if (particle[3]<0) del(particles,particle)
	end
	
end

function updateorbs()
	
	for i,orb in ipairs(player[11]) do
		local len=#player[11]
		local f=frame/4
		local v=i/len+f/4 -- angle
		local dx,dy=cos(v),sin(v)
		orb[2]=player[2]+dx*8
		orb[3]=player[3]+dy*8
		if f%6==i then
			firebomb(orb[2],orb[3],false)
		end
	end
	
end

function updategame()
 
	-- update frame
	frame+=0.25
	playtime+=1/30
	
	updatestars()
	updatenebula()
	updateeffects()
	
	-- loop through all powerups
	for powup in all(powerups) do
		powup[3]+=1
		if (powup[3]>128) del(powerups,powup)
	 if collision(powup,player) then
	 	-- s,x,y,b,w,h,health,bombs,speed,shotspeed,orbs,multifire,score,kills
	 	local r=powup[8]
	 	if r==1 then
	 		player[12]=min(8,player[12]+1)
	 	elseif r==7 then
	 		if (#player[11]<8) initorb()
			elseif r==8 then
	 		player[7]=min(5,player[7]+1)
				flashsprite={18,player[7]*12-12,114,2,2.0,1.0,8,7}
	 	elseif r==12 then
	 		player[8]=min(5,player[8]+1)
				flashsprite={16,124-player[8]*12,114,2,2.0,1.0,12,7}
	 	elseif r==10 then
	 		player[9]=min(4,player[9]+0.5)
				flashsprite={20,-2,117-flr(player[9])*10,9,1.0,1.0,10,7}
	 	elseif r==11 then
	 		player[10]=max(1,player[10]-1)
				flashsprite={21,122,117-(6-player[10])*10,3,1.0,1.0,11,7}
	 	elseif r==5 then
	 		player[15]=min(2,player[15]+1)
	 	elseif r==2 then
	 		player[16]=min(3,player[16]+1)
	 	else
	 		player[13]+=100
	 	end
	 	sfx(2)
	 	del(powerups,powup)
	 end
	end
	
	-- loop through all eshots
	for shot in all(eshots) do
		shot[2]+=shot[7]
		shot[3]+=shot[8]
		-- out of bounds check
		if (shot[3]<-8 or shot[3]>128) del(eshots,shot)
		if (shot[2]<-8 or shot[2]>128) del(eshots,shot)
		-- collision check
		if collision(shot,player) then
			playerhit(shot,1)
			player[2]+=shot[7]*2
			player[3]+=shot[8]*2
			del(eshots,shot)
		end
	end
	
	-- loop through all pshots
	for shot in all(pshots) do
		-- declare variables
		local skip=false
		-- move shot
		shot[2]+=shot[7]
		shot[3]+=shot[8]
		-- out of bounds check
		if (shot[3]<-8 or shot[3]>128) skip=true del(pshots,shot)
		if (shot[2]<-8 or shot[2]>128) skip=true del(pshots,shot)
		-- collision check
		for ship in all(ships) do
			if (skip) break
			if collision(shot,ship) then
				initexplosion(
					ship[2]+ship[5]*4,
					ship[3]+ship[6]*4
				)
				ship[9]-=1
				if ship[9]<1 then
					player[14]+=1
					flashboss=true
					initpowup(ship)
					del(ships,ship)
				end
				del(pshots,shot)
				skip=true
			end
		end
		for eshot in all(eshots) do
			if (skip) break
			if eshot[1]!=22 and collision(shot,eshot) then
				initexplosion(
					shot[2]+shot[5]*4,
					shot[3]+shot[6]*4
				)
				del(eshots,eshot)
				del(shots,shot)
				skip=true
			end
		end
	end
	
	updateorbs()
	
	-- loop through all pbombs
	for bomb in all(pbombs) do
		-- get target
		local target,dx,dy=bomb[7]
		if #target>2 then
			-- get direction
			dx,dy=target[2]-bomb[2],target[3]-bomb[3]
			-- normalise vector
			local dh=sqrt(dx^2+dy^2)
			dx,dy=dx/dh,dy/dh
		else
			dx,dy=target[1],target[2]
		end
		-- move bomb
		bomb[2]+=dx*6
		bomb[3]+=dy*6
		-- boundary check
		if (bomb[2]<-8 or bomb[2]>128) del(pbombs,bomb)
		if (bomb[3]<-8 or bomb[3]>128) del(pbombs,bomb)
		-- collision check
		if collision(bomb,target) then
			initexplosion(
				target[2]+target[5]*4,
				target[3]+target[6]*4
			)
			target[9]-=1
			if target[9]<1 then
				player[14]+=1
				flashboss=true
				initpowup(target)
				del(ships,target)
			end
			del(pbombs,bomb)
			-- redirect bombs
			for b in all(pbombs) do
				if b[7]==target then
					b[7]=rnd(ships)
					if not b[7] then
						initexplosion(
							bomb[2]+bomb[5]*4,
							bomb[3]+bomb[6]*4
						)
						del(pbombs,b)
					end
				end
			end
		end
	end
	
	-- loop through all ships
	for ship in all(ships) do
	 -- move
		ship[3]+=ship[7]
		if (ship[3]>ship[11]) ship[3]=ship[11]
		-- shoot
		ship[13]+=0.25
		if (ship[13]>ship[10]) enemyshoot(ship)
		-- collision
		if (ship[3]>128) del(ships,ship)
		if pbeams and collision(ship,pbeams) then
			initexplosion(
				ship[2]+ship[5]*4,
				ship[3]+ship[6]*4
			)
			ship[9]-=1
			if ship[9]<1 then
				player[14]+=1
				flashboss=true
				initpowup(ship)
				del(ships,ship)
			end
		end
		if collision(ship,player) then
			if invuln==0 then
				playerhit(ship,ship[9])
			end
		end
	end
	
	-- decrement invuln effect
	if invuln>0 then
		invuln-=1
	end
	
	-- update pos
	if (btn(‹,p1)) player[2]-=player[9] initexhaust( 2, rnd(0.4)-0.2)
	if (btn(‘,p1)) player[2]+=player[9] initexhaust(-2, rnd(0.4)-0.2) 
	if (btn(”,p1)) player[3]-=player[9] initexhaust( rnd(0.4)-0.2, 2)
	if (btn(ƒ,p1)) player[3]+=player[9] initexhaust( rnd(0.4)-0.2,-2)
	
	-- boundary check
	player[2]=mid(-1,player[2],121)
	player[3]=mid(-1,player[3],121)
	
	-- actions
	if (btnp(—,0)) actionwarp()
	if (btnp(Ž,0)) actionspecial()
	if (frame%player[10]==0) actionshoot()
	
	if player2 then
		-- update pos
		if (btn(‹,p2)) player2[2]-=player[9]
		if (btn(‘,p2)) player2[2]+=player[9]
		if (btn(”,p2)) player2[3]-=player[9]
		if (btn(ƒ,p2)) player2[3]+=player[9]
		-- boundary check
		player2[2]=mid(-1,player2[2],121)
		player2[3]=mid(-1,player2[3],121)
	 -- actions
	 if (frame%player[10]==0) actionshoot2()
	end
	
	-- update special weapons
	if special>0 then
		if player[15]==0 then
			special-=1
			fireshot(player[2],player[3])
		elseif player[15]==1 then
			special-=0.5
			firebeam(player[2],player[3])
		elseif player[15]==2 then
			special-=1
			pbeams=nil
			firebomb(player[2],player[3])
		end
	end
	
	if not bossspawned then
		if (frame%13==0) initenemy(1,1)
		if (frame%19==0) initenemy(2,1)
		if (frame%17==0) initenemy(1,rnd({2,2,2,3,3,4,5}))
		if (frame%23==0) initenemy(2,rnd({1,1,1,2,2,3}))
		if (frame%29==0) initenemy(3,1)
	end
	
	if not minispawned and player[14]>64 then
		initenemy(4,1)
		minispawned=true	
	end
	if not bossspawned and player[14]>128 then
		initenemy(5,1)
		bossspawned=true
	end
	
	-- camera shake
	if shake>0 then
		cx=flr(rnd(4))-2
		cy=flr(rnd(4))-2
		shake-=1
	end
	
	-- update camera
	if cy!=0 then cy-=sgn(cy)*0.25 end
	if cx!=0 then cx-=sgn(cx)*0.25 end
	
	-- game over check
	if player[7]<1 then
		won=false
		frame=0
		sethighscore()
		stateupdate=updategameover
		statedraw=drawgameover
	end
	
	if bossspawned and boss[9]<1 then
		won=true
		frame=0
		sethighscore()
		stateupdate=updategameover
		statedraw=drawgameover
	end
	
end
-->8
-- draw
function _draw()

 statedraw()

end

function drawgamestart()
	
	drawgame()
	
	rectfill(10,80,50,90,1)
	rect(10,80,50,90,8)
	line(20,90,5,105)
	prints("speed",20,83,9,2)
	
	rectfill(78,80,118,90,1)
	rect(78,80,118,90,8)
	line(108,90,123,105)
	prints("fire rate",81,83,11,3)
	
	rectfill(20,96,60,106,1)
	rect(20,96,60,106,8)
	line(20,106,15,111)
	prints("health",28,99,8,2)
	
	rectfill(68,96,108,106,1)
	rect(68,96,108,106,8)
	line(108,106,113,111)
	prints("special",75,99,12,1)
	
	rectfill(42,110,86,120,1)
	rect(42,110,86,120,8)
	prints("boss meter",45,113,6,5)
	
	cprints("enter for menu",44,11,3,0)
	if controls_state then
		cprints("sfed to move",52,11,3)
		cprints("m to warp",60,11,3)
		cprints("n for special",68,11,3)	
		if flr(frame)%20>10 then
			cprints("press m for 1 player",26,7,2)
			cprints("press q for 2 player",34,7,2)
		end
	else
		cprints("‹‘”ƒ to move",52,11,3,-8)
		cprints("x to warp",60,11,3)
		cprints("z for special",68,11,3)
		if flr(frame)%20>10 then 
			cprints("press x for 1 player",26,7,2)
			cprints("press q for 2 player",34,7,2)
		end
	end
	
	prints("\#c\^w\^tnebula fighter",9,8,7,2)
	print("v1.0.5",100,19,7)
	
end

function drawgameover()
	
	local i=0 if (player2) i=1
	local best,c=dget(i),flr(frame)
	
	drawgame()
		
	if (newbest and c%20>10) cprints("!new time!",31,7,2)
	if (best!=0) cprints("best: "..gettime(best),41,7,2)
	
	cprints("time: "..gettime(),51,7,2)
	
	if won then 
		cprints("!!game won!!",61,7,2)
	else
		cprints("game over",61,7,2)
	end
	
	if (c%20>10) cprints("press any key",71,7,2)
	
end

function drawgame()
	
	if (shake_state) camera(cx,cy)
	
	if background_state then
	
		cls(1)
	
		for cloud in all(nebula) do
			circfill(unpack(cloud))
		end
		
		for star in all(stars) do
			circfill(unpack(star))
		end
		
	else
	
		cls(0)
		
		for star in all(stars) do
			pset(star[1],star[2],star[5])
		end
	
	end
		
	for particle in all(particles) do
		circfill(unpack(particle))
	end
	
	-- player [7-10]:hp,bombs,spd,fire
	for i=1,player[7] do sprs(18,i*12-12,114,2,2.0,1.0) end
	for i=1,player[8] do sprs(16,124-i*12,114,1,2.0,1.0) end
	for i=1,player[8] do sprs(player[15]+33,128-i*12,114,1,1.0,1.0) end
	for i=1,(player[9]-2)*2+1 do sprs(20,-2,117-i*10,9,1.0,1.0) end
	for i=1,6-player[10] do sprs(21,122,117-i*10,3,1.0,1.0) end
	-- boss health
	if bossspawned then
		rectfill(0,123,boss[9],127,8)
		rect(0,123,127,127,3)
	else
		-- boss meter
		local c=11 if (flashboss) c=7
		rectfill(0,123,127-player[14],127,c)
		rect(0,123,127,127,3)
		flashboss=false
	end
	
	-- update 
	if flashsprite then
		sprsrecol(unpack(flashsprite))
		flashsprite=nil
	end
	
	for powup in all(powerups) do
		sprsrecol(unpack(powup))
	end
	
	for shot in all(eshots) do
		sprs(unpack(shot))
	end
	
	for shot in all(pshots) do
		sprs(unpack(shot))
	end
	
	for bomb in all(pbombs) do
		sprs(unpack(bomb))
	end
	
	for orb in all(player[11]) do
		sprs(unpack(orb))
	end
	
	for ship in all(ships) do
		sprs(unpack(ship))
	end
	
	if (pbeams) sprbeam(unpack(pbeams))
	
	if (invuln%2==0) sprs(unpack(player))
	
	while #warping>0 do
		local w=warping[1]
		sprs(unpack(w))
		del(warping,w)
	end
	
	for cloud in all(explosions) do
		circfill(unpack(cloud))
	end
	
	if player2 then
		sprs(unpack(player2))
	end
	
	if flashscreen then
		cls(7)
		flashscreen=false
	end
	
end
-->8
-- misc
function sethighscore()
	
	local i=0 if (player2) i=1
	local best=dget(i)
	
	if won then
		if best==0 or best>playtime then
		 dset(i,playtime)
		 newbest=true
		end
	else
		newbest=false
	end
	
end

function gettime(v)

	if (not v) v=playtime
	
	local ts=flr(v)
	local m=tostr(flr(ts/60))
	local s=tostr(flr(ts)-(flr(ts/60)*60))
	local ms=tostr(flr((v-ts)*1000))
	
	while #m<2 do m="0"..m end
	while #s<2 do s="0"..s end
	while #ms<3 do ms="0"..ms end
	
	return m..":"..s..":"..ms
	
end

function cprints(s,y,c,b,adj)
	local x=64-#s*2+(adj or 0)
	for i=0,15 do pal(i,b) end
	for i=1,4 do print(s,x+dirs[i].x,y+dirs[i].y,c) end
	pal() print(s,x,y,c) 
end

function prints(s,x,y,c,b)
	for i=0,15 do pal(i,b) end
	for i=1,4 do print(s,x+dirs[i].x,y+dirs[i].y,c) end
	pal() print(s,x,y,c) 
end

function sprs(s,x,y,b,w,h)
	for i=0,15 do pal(i,b) end
	for i=1,4 do spr(s,x+dirs[i].x,y+dirs[i].y,w or 1.0,h or 1.0) end
	pal() spr(s,x,y,w or 1.0,h or 1.0)
end

function sprbeam(s,x,y,c,w,h,b)
	rectfill(x-1,y,x+w+4,h*8,b)
	rectfill(x,y,x+w+3,h*8-1,c)
end

function sprsrecol(s,x,y,b,w,h,c1,c2)
	for i=0,15 do pal(i,b) end
	for i=1,4 do spr(s,x+dirs[i].x,y+dirs[i].y,w or 1.0,h or 1.0) end
	pal()
	pal(c1,c2)
	spr(s,x,y,w or 1.0,h or 1.0)
	pal()
end
	
function collision(a,b)

	return 
		a[2]<b[2]+8*b[5] and 
		a[2]+8*a[5]>b[2] and
		a[3]<b[3]+8*b[6] and
		a[3]+8*a[6]>b[3]
	
end

function initpowup(ship)
	
	local i=ship[8]
	
	if i==0 and player[14]%killsperdrop==0 then
		i=1
	end
	
	while i>0 do
		i-=1
		-- s,x,y,b,w,h,c,type
		local powup={
			53,ship[2]+rnd(4)-2,ship[3]+rnd(4)-2,
			1,1.0,1.0,10,
			rnd({1,2,5,7,8,10,11,12})
		}
		add(powerups,powup)
	end
	
end

function initenemy(t,num)
	
	local w,h,spd,ship=1.0,1.0,1
	
	-- correction values
	if t>4 then w=3.0 h=2.0
	elseif t>3 then w=2.0 h=2.0
	elseif t>2 then w=2.0
	elseif t>1 then spd=rnd(1)+1
	else spd=rnd(1)+0.5 end
	
	local x,y=rnd(128-w*10*num),-8*h
	
	-- [0-7] s,x,y,b,w,h,dy,
	-- [8-10] numpow,hp,shotfreq
	-- [11-13] max y,shotpat,shotseq
	for i=1,num do
		local pos=i-1
		if t==1 then -- standard
			ship={
				50,x+pos*w*10,y,3,1.0,1.0,spd,
				0,1,0,150,0,rnd(10)
			}
		elseif t==2 then -- fighter
			ship={
				54,x+pos*w*10,y,3,1.0,1.0,spd,
				0,1,10,150,1,rnd(10)
			}
		elseif t==3 then -- carrier
			ship={
				51,x+pos*w*10,y,3,2.0,1.0,spd,
				1,2,15,150,2,rnd(25)
			}
		elseif t==4 then -- mini boss
			ship={
				39,56,y,2,2.0,2.0,spd,
				2,50,20,48,3,rnd(20)
			}
		elseif t==5 then -- boss
			ship={
				41,52,y,1,3.0,2.0,spd,
				0,128,0,32,4,rnd(10)
			}
			boss=ship
		end
		-- add ship
		add(ships,ship)
	end
	
end

function initnebula(d,r,f,b)
	for i=1,128,4 do
		local v=i/4/d
		local c=rnd(cos(v)+1)*20-20
		local s=rnd(sin(v)+1)*20-20
		add(nebula,{i+c,i+s,rnd(r)+f,b,#nebula%10})
	end
end

function initexhaust(x,y)
	
	-- x,y,r,c,dx,dy
	local particle={
		player[2]+x+4,player[3]+y+4,
		1,
		rnd({7,10}),x*2,y*2
	}
	add(particles,particle)

end

function initexplosion(x,y,f)
		-- big explosion
		add(explosions,{x+rnd(2)-1,y+rnd(2)-1,10,7,0,0,true})
		-- small explosions
		for i=1,5 do
			-- x,y,r,c,dx,dy
			local cloud={
				x+rnd(2)-1,
				y+rnd(2)-1,
				rnd(2)+2,
				rnd({7,10}),
				rnd(4)-2,
				rnd(4)-2
			}
			add(explosions,cloud) 
		end
		sfx(0)
		flash=f
		shake=10
end

function initorb()
	add(player[11],{49,player[2],player[3],2,1.0,1.0})
end

function playerhit(obj,dam)

	if invuln==0 then
		
		initexplosion(
			obj[2]+obj[5]*4,
			obj[3]+obj[6]*4,
			true
		)
		
		-- remove orbs first
		while dam>0 and #player[11]>0 do
			deli(player[11],1)
			dam-=1
		end
		
		-- remove health
		while dam>0 do
			player[7]-=1
			dam-=1
		end
		
		invuln=30
		flashscreen=true
		
	end
	
end

function enemyshoot(ship)
	
	-- random shot
	if ship[12]==1 then
	
		local v=rnd()
		local dx,dy=cos(v)*4,sin(v)*4
		local shot={
			38,ship[2]+ship[5]*4-4,ship[3]+ship[6]*4-4,13,
			1.0,1.0,dx,dy
		}	add(eshots,shot)
		
	-- homing shot
	elseif ship[12]==2 then
		
		-- get direction
		local dx,dy=player[2]-ship[2],player[3]-ship[3]
		-- normalise vector
		local dh=sqrt(dx^2+dy^2)
		dx,dy=dx/dh,dy/dh
		local shot={
			22,ship[2]+ship[5]*4-4,ship[3]+ship[6]*4-4,9,
			1.0,1.0,dx*3,dy*3
		}	add(eshots,shot)
		
 -- radial shot
	elseif ship[12]==3 then
		
		for i=1,16 do
			local v=i/8+frame/7
			local dx,dy=cos(v)*3,sin(v)*3
			local shot={
				38,ship[2]+ship[5]*4-4,ship[3]+ship[6]*4-4,13,
				1.0,1.0,dx,dy
			}	add(eshots,shot)
		end
		
 -- radial shot
	elseif ship[12]==4 then
		
		if flr(frame)%4!=0 then
			local v=frame/9
			local dx,dy=cos(v)*2,sin(v)*2
			local shot={
				22,ship[2]+ship[5]*4-4,ship[3]+ship[6]*4-4,13,
				1.0,1.0,dx,dy
			}	add(eshots,shot)
		end
		
	end
	
	ship[13]=0
	
end

function actionshoot2()

	sfx(1)
		-- s,x,y,b,w,h,dx,dy
	local dx,dy=
		player2[2]-player[2],
		player2[3]-player[3]
	local dh=sqrt(dx^2+dy^2)
	dx,dy=dx/dh,dy/dh
	
	local shot={
		33,player[2],player[3]-4,12,
		1.0,1.0,dx*4,dy*4
	}
	add(pshots,shot)
end

function actionshoot()
	
	sfx(1)
	
	-- single shot
	if player[16]==0 then
		-- s,x,y,b,w,h,dx,dy
		local shot={
			5,player[2],player[3]-4,12,
			1.0,1.0,0,-6
		}
		add(pshots,shot)
	-- dual shot
	elseif player[16]==1 then
		-- s,x,y,b,w,h,dx,dy
		local shot={
			7,player[2],player[3]-4,12,
			1.0,1.0,0,-6
		}
		add(pshots,shot)
		local shot={
			8,player[2],player[3]-4,12,
			1.0,1.0,0,-6
		}
		add(pshots,shot)
	-- triple shot
	elseif player[16]==2 then
		-- s,x,y,b,w,h,dx,dy
		local shot={
			5,player[2],player[3]-4,12,
			1.0,1.0,0,-6
		}
		add(pshots,shot)
		local shot={
			4,player[2],player[3]-4,12,
			1.0,1.0,-3,-3
		}
		add(pshots,shot)
		local shot={
			6,player[2],player[3]-4,12,
			1.0,1.0,3,-3
		}
		add(pshots,shot)
	-- quad shot
	elseif player[16]==3 then
		-- s,x,y,b,w,h,dx,dy
		local shot={
			7,player[2],player[3]-4,12,
			1.0,1.0,0,-6
		}
		add(pshots,shot)
		local shot={
			8,player[2],player[3]-4,12,
			1.0,1.0,0,-6
		}
		add(pshots,shot)
		local shot={
			4,player[2],player[3]-4,12,
			1.0,1.0,-3,-3
		}
		add(pshots,shot)
		local shot={
			6,player[2],player[3]-4,12,
			1.0,1.0,3,-3
		}
		add(pshots,shot)
	end
	
	-- multishot
	for i=1,player[12] do
		local v=i/player[12]-0.25
		local dx,dy=cos(v)*6,sin(v)*6
		local shot={
			33,player[2],player[3],12,
			1.0,1.0,dx,dy
		}
		add(pshots,shot)
	end
	
end

function actionwarp()

	local tx,ty=rnd(120),rnd(120)
	local dx,dy=
		(player[2]-tx)/10,
		(player[3]-ty)/10
	
	for i=1,10 do
		local p=clone(player)
		p[2]-=dx*i
		p[3]-=dy*i
		add(warping,p)
	end
	
	player[2]=tx
	player[3]=ty
	
	sfx(3)

end

function actionspecial()
	
 if #ships>0 and player[8]>0 and special<=0 then 
 	player[8]-=1
 	special=30
 end
 
end

function firebeam(x,y)

	if special>0 then
		pbeams={35,x+2,-4,10,0.5,y/8,9}
	 sfx(5)
	else
		pbeams=nil
	end

end

function fireshot(x,y)

	if special>0 then
		-- s,x,y,b,w,h,dx,dy
		sfx(1)
		local shot={
			33,player[2],player[3]-4,12,
			1.0,1.0,cos(frame/7-0.25)*4,sin(frame/7-0.25)*4
		}
		add(pshots,shot)
	end

end

function firebomb(x,y)
	
	if #ships>0 then
		local ship=rnd(ships)
		-- s,x,y,b,w,h,target,flash
		local bomb={
			35,x,y,
			2,1.0,1.0,ship
		}
		add(pbombs,bomb)
		sfx(4)
	end
	
end

function clone(t)

	local table,k,v={}
	
	for k,v in pairs(t) do
		if type(v)=="table" then
			table[k]=clone(v)
		else
			table[k]=v
		end
	end
	
	return table

end
