__lua__
-- nebula fighter
-- by kieron scott v1.0.5

-- change log:
--  v1.0.5
--   added alternative controls
--   added toggle screen shake
--  v1.0.4
--   added background cycle
--  v1.0.3
--   fixed drawstates
--   added player 2
--  v1.0.2
--   added knockback for yellow shots
--  v1.0.1
