pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
--exterminator V1.0
--(c) mmxx glckelse

--sfx:
--0: enemies
--1: enemy die, player hit
--2: shoot
--3: special

enemy_names={"bug","donut","aerobug","swooper","superbug","crawler","robobug","???"}

t=0 

title={}
game={}
shop={}
over={}

st=0
state={}
state[1]=title
state[2]=game
state[3]=shop
state[4]=over

function _init()
 poke(0x5f5c,255)
 poke(0x5f40,8)
 poke(0x5f41,15)
 poke(0x5f42,10)
 cstate(1)
end

function _update60()
 for sy=0,3 do for sx=0,4 do
  sset(112+sx,24+sy,flr(rnd(2))*15)
   end end --super anim

 state[st]:update()
 t+=1
end

function _draw()
 state[st]:draw()
 pal(15,(t/3),1)
 pal(9,137,1)
 pal(12,140,1)
 --print(flr(stat(1)*100),0,123,8)
end

function cstate(s)
 clear_particles()
 st=s
 if state[st].init then
		state[st]:init()
	end
end
-->8
--tool

chrw="6235576244552527555555555522555575555555525557555555555755547488"

function write(str,x,y,c)
 str=tostr(str)
 pal(7,c)
 xx=x
 for w=1,#str do
  c=ord(str,w)-32
  if (c+32>95) c-=32
  spr(c+192,xx,y)
  xx+=tonum(sub(chrw,c+1,c+1))+1
 end
 pal(7,7)
end

function writec(str,y,c)
 str=tostr(str)
 w=0
 for s=1,#str do
  cc=ord(str,s)-32
  if (cc+32>95) cc-=32
  w+=tonum(sub(chrw,cc+1,cc+1))+1
 end
 write(str,(128-w+1)/2,y,c)
end

function prints(str,x,y,c)
 w=1 h=1.8
 str=tostr(str)
 print(str,x,y,c)
 for h=0,7 do
  for w=0,#str*4 do
   sset(w,88+h,pget(x+w,y+h))
  end
 end
 recf(x,y,#str*4*w,5*h,0)
 sspr(0,88,#str*4-1,7,x,y,(#str*4-1)*w,5*h)
end

function printsc(str,y,c)
 str=tostr(str)
 prints(str,(128-#str*4)/2,y,c)
end

function rec(x,y,w,h,c)
 rect(x,y,x+w-1,y+h-1,c)
end

function recf(x,y,w,h,c)
 rectfill(x,y,x+w-1,y+h-1,c)
end

function dist(x1,y1,x2,y2)
 return sqrt((x1-x2)^2+(y1-y2)^2)
end

function pad(str,len)
  if (#tostr(str)>=len) return str
  return "0"..pad(str,len-1)
end

function booln(v)
 return v and 1 or 0
end

function rnds()
 if rnd()<.5 then return 1 end
 return -1
end

--

function hit(x,y,w,h)
 collide=0
 for i=x,x+w,w do
  if is_wall(i,y) then
   collide=fget(mget(i/8,y/8)) end
  if is_wall(i,y+h) then
   collide=fget(mget(i/8,(y+h)/8))
  end
 end
 return collide
end

function is_wall(x,y)
 return fget(mget(x/8,y/8))>=1
end

-->8
--update

titlet=0

function title:update()
 if (titlet==0) music(2)
 if (titlet==800) music(1)
 
 titlet=(titlet+1)%1200
 if btnp(—) or btnp(Ž) then
  health=100
  dhealth=0
  level=1
  newmap(rnd()) 
  score=0
  bombs=0
  gamet=0
  btime=-1
  cstate(2)
 end
end

level=1

gamet=-1

waveboost=0
distort=0
dhealth=100

function game:update()
 if gamet>-1 and gamet<160 then
  gamet+=1  
  
  else gamet=-1 end

 if gamet==-1 then
 
  --things
 
  waveboost*=.97
  distort*=.8
  
  if dhealth>0 then
  dhealth*=.4 end
  
  if score>=20000 then
   score=0 sfx(21,3)
   health=100 dhealth=0
   strength+=1
  end
   
  --
  
  if health<1 then die() end
  
  if stillt==400 then
   nx=px ny=py
   while hit(nx,ny,ew,eh)!=0 or
   dist(px,py,nx,ny)<60 do
    nx=rnd(106)+7
    ny=rnd(90)+7
   end
   add_enemy(7,nx,ny)
   stillt=0
  end
  
  if enemies_alive<=0 then
   mset(1,0,17)
  
   if mget((px+4)/8,(py+4)/8)==17 then 
    level+=1
    gamet=0
    btime=-1
    clear_particles()
    stillt=0
    
    shopt=(score<100) and 300 or 0
    shopcur=0
    sfx(18,0)
    cstate(3) --goto shop
   end
  end
 
  player_move()
  
  for e=1,#enemies do
   update_enemy(enemies[e],e)
  end
  
  update_particles()
  
 end
end

shopt=0
shopcur=0

function shop:update()
 shopt+=1
 
 if 10-shopt\60==0 then
  cstate(2) newmap(rnd()) --lets go
 end
 
 if btn(Ž) then
  shopt+=5
  sfx(7,2)
 elseif shopt%60==0 then
  sfx(16,0)
 end
  
 if btnp(”) and shopcur>0 then
  shopcur-=1 sfx(17,1) end
 if btnp(ƒ) and shopcur<2 then
  shopcur+=1 sfx(17,1) end
 
 if btnp(—) then
  bought=false
  if shopcur==0 and score>=100 
  and bombs<999 then
   bombs+=1 
   score-=100
   bought=true
  elseif shopcur==1 and score>=250 
  and health<100 then
   health=min(100,health+25) 
   score-=100
   bought=true
  elseif shopcur==2 and score>=1500 then
   strength+=1
   score-=1500
   bought=true
  end
  sfx(bought and 19 or 20,2)
 end
end

overt=0

function over:update()
 if (overt==0) clear_particles()
 
 if overt>=0 and overt<200 then
  overt+=1
 else overt=-1 end
 
 update_particles()
 sfx(3,3)
 
 add_particle(67,64,2,.2,20)
 if overt==-1 and
  (btnp(—) or btnp(Ž)) then
  cstate(1) titlet=0
 end
end
-->8
--draw

function title:draw()
 cls()
 
 if titlet<800 then
  pal(14,(t/6)%7+8)
  pal(7,(t/6+3)%7+8)
  sspr(0,64,116,24,6,30)
  pal()
  spr(124,48,104,4,1)
 else
  for b=0,#enemy_names-1 do
   write(enemy_names[b+1],20,18+b*12,6)
   anim=(b<7) and (t/5)%2 or 0
   spr(48+b*2+anim,103,20+b*12)
  end
 end
end

wa=0

function game:draw()
 cls()
 if gamet>-1 then
  writec("floor "..level,60,6)
 else
  clip(4,20,120,104)
 
  for g=-1,12 do
   wc=cos(t/800)*(20+20*waveboost)
   ws=sin(t/1600)*(12+22*waveboost)
   line(g*12+wc,0,g*12-wc,g+128,4)
   line(0,g*18+ws,128,g*18-ws,4)
  end
  
  
   
  if btime!=-1 then --bullet
   for l=0,btime do
    xx=bx+4-l*bdx
    yy=by+20-l*bdy
    pset(xx,yy,t%7+8)
   end
  end
  
  
  
  palt(0,false) 
  map(0,0,4,20,15,13)
  palt(0,true)
  
 --enemies 

  for e in all(enemies) do
   if e.dead==false then
    anim=(e.t<7) and (t/5)%2 or 0
    spr(48+e.t*2+anim,e.x+4,e.y+20)
   end
  end
  
  pal()
  pal(4,128,1)  
  pal(3,2,1)
  
  
  --player
 
  if (dx!=0 or dy!=0) then
   wa=(t/4)%4 end
  if btn(—) then wa=1 end
  
  pal(12,(12+strength-1)%7+8)
  
  if dx==0 then
   spr(32+wa%2,px+4,py+20)
  else
   spr(34+wa,px+4-booln(pd),py+20,1,1,pd,false)
  end
 
  pal(12,12)
 
 draw_particles(4,20)
 
 if (distort>0) distor()
 
 clip()
 draw_hud()
 end
end

function distor()
 for p=0,distort*200 do
  x=rnd(128) y=rnd(128)
  pset(x,y,pget(x+rnds(),y+rnds()))
 end
end

function shop:draw()
 cls()
 draw_hud()
 
 spr(66,13,56+10*shopcur)
 
 write("bomb",20,55,7)
 write("health",20,65,7)
 write("strength",20,75,7)
 
 for d=0,2 do
  write("$",83,55+d*10,11) end
  
 prints("1000",89,56,6)
 prints("2500",89,66,6)
 prints("15000",89,76,6)
 
 pal(12,(12+strength-1)%7+8)
 spr(35,60,40)
 pal(12,12)
 
 writec(pad(10-shopt\60,2),91,5)
end

function over:draw()
 clip() cls()
 
 spr(112,56,60,2,1)
 
 draw_particles(0,0)
 
 anim=(lastbite<7) and (t/5)%2 or 0
 spr(48+lastbite*2+anim,64,60)
 
 if overt==-1 then
  printsc("death by "..enemy_names[lastbite+1],24,6)
  printsc("level "..level,31,5)
  writec("the end",98,(t/3)%7+8)
 end
end

function draw_hud()
 spr(64,4,4)
 hc=(dhealth>.1) and 2 or 6
 
 write(pad(max(0,flr(health-flr(dhealth))),3),10,3,hc)
 
 spr(65,31,4)
 write(pad(bombs,3),37,3,6)
 write("$",83,3,11)
 write(pad(score,5).."0",89,3,7)
 
end

function draw_particles(xo,yo)
 for p in all(particles) do
  if not p.dead then
   pset(p.x+xo,p.y+yo,p.c)
  end
 end
end


-->8
--map gen
--15x13

badmaps={{"03","21"},{"12","30"},{"31","02"}}

mapstr=""

function newmap(seed)
 srand(seed)
 
  
  good=false
  
  while not good do
   reload(0x2000,0x2000,0x1000)
   mapstr=""
   for pily=3,9,3 do
    for pilx=3,11,4 do --each pillar
     dr=flr(rnd(4))
     mapstr=mapstr..dr
     if dr==0 then
      mapline(1,pilx,pily,1,-4)
	    elseif dr==1 then
      mapline(1,pilx,pily,1,4)
     elseif dr==2 then
      mapline(1,pilx,pily,-4,1)
     elseif dr==3 then
      mapline(1,pilx,pily,4,1)
     end
    end
   end
   check=false
   for r=1,#mapstr-4 do
    for bad=1,#badmaps do
     if sub(mapstr,r,r+1)==badmaps[bad][1]
      and sub(mapstr,r+3,r+4)==badmaps[bad][2]
       then check=true end
    end
   end
   if (not check) good=true
  end
 
 create_walls()
 px=8 py=8
 
 enemies={}
 enemies_alive=0
 
 enemygen()
 
 mset(1,0,16)
 
 music(0)
end

function create_walls()
 for rh=0,12 do
  for rw=0,14 do
   if mget(rw,rh)!=0 then
    wall=0
    wall+=getwall(rw,rh-1)
    wall+=getwall(rw,rh+1)*2
    wall+=getwall(rw-1,rh)*4
    wall+=getwall(rw+1,rh)*8
    mset(rw,rh,wall)
   end
  end
 end
end

function enemygen()
 for count=1,min(120,12+level^1.4) do
  enemies_alive+=1
  ex=0 ey=0
  while hit(ex,ey,ew,eh)!=0 or
  dist(px,py,ex,ey)<50 do
   ex=rnd(106)+7
   ey=rnd(90)+7
  end
  diff=.4*level^1.2
  add_enemy(mid(0,flr(rnd(diff)+.02*level),6),ex,ey)
 end
end

--

function getwall(x,y)
 if x<0 or x>14 
  or y<0 or y>12 then
   return 0 end
 return mget(x,y)!=0 and 1 or 0
end

function mapline(n,x,y,w,h)
 for yy=0,h-sgn(h),sgn(h) do
  for xx=0,w-sgn(w),sgn(w) do
   if mget(x+xx,y+yy)==0 then
   mset(x+xx,y+yy,n) end
   end end end
-->8
--gameplay

score=0
health=100
bombs=0

strength=0

--player

px=8 py=8 pd=false
dx=0 dy=0

stillt=0

function player_move()
 stillt+=1
 dx=0 dy=0
	if btn(‹) then dx-=1 pd=true end
 if btn(‘) then dx+=1 pd=false end
 if btn(”) then dy-=1 end
 if btn(ƒ) then dy+=1 end
 
 if btime==-1 then
  if not (dx==0 and dy==0) then
   bdx=dx bdy=dy end
   if btn(—) then  --shoot
    bx=px+3 by=py+3
    btime=0 sfx(0,2)
   end
  else bullet_move()
 end
  
 if not btn(—) then --move
  if hit(px+dx,py,6,7)<1 then
   px+=dx*.7 end
  if hit(px,py+dy,6,7)<1 then
   py+=dy*.7 end
  if not (dx==0 and dy==0)
   then stillt=0 
   if (t/4)%4==2 then
    sfx(6,2)
   end end
 end
 
 if btnp(Ž) and bombs>0
  and enemies_alive>0 then
  distort=10
  
  bombs-=1
  for e=1,#enemies do
   enemy=enemies[e]
   if rnd()<.45 and not enemy.dead
    then --kill
    enemy.dead=true
    score+=enemy.t+1 

    add_particle(enemy.x+2,enemy.y+2,8+enemy.t,2,80+rnd(55))
    
    enemies_alive-=1
    
   end
  end
  sfx(5,1) sfx(0,3)
 end
 
end

function die()
 overt=0
 cstate(4)
end

--bullet

bx=0 by=0
bdx=1 bdy=0
btime=-1

function bullet_move()
 if fget(mget(bx/8,by/8))==1
  or hit_enemy() or btime>30 then
   btime=-1
   return
 end 
 
 btime+=1
 
 bx+=bdx*4 by+=bdy*4
end

-->8
--enemies

enemies={}
enemies_alive=0

ew=4 eh=3

lastbite=0

function add_enemy(t,x,y)
 local e={}
  e.t=t
  e.x=x 
  e.y=y
  
  a=1
  if (e.t==0) a=.2
  if (e.t==4) a=.48
  if (e.t==6) a=.8
  if (e.t==7) a=1
  
  e.dx=rnds()*a
  e.dy=rnds()*a
  e.dead=false
 add(enemies,e)
end

function update_enemy(e,num)
 if e.dead==false then
 
  --enemy sounds
  if (t+num)%((8-e.t)*6)==0 then
   if e.t==6 then
    poke(0x35b8,flr(rnd(63))+192)
   end
   sfx(8+e.t,e.t==7 and 3 or 0) end
 
  if dist(px,py,e.x,e.y)>5 then
  
   
   
   if e.t==0 or e.t==4 or e.t==6
    or e.t==7 then --bounce
    
     if e.t==4 then
      sm=sind(200,200,.01,.01,num)
      e.dx+=sm[1]
      e.dy+=sm[2]
     elseif e.t==6 then
      sm=sind(50,40,.02,.02,num)
      e.dx+=sm[1]
      e.dy+=sm[2]
     end
    
     e.dx=mid(-1,e.dx,1)
     e.dy=mid(-1,e.dy,1)
    
     e.x=max(8,e.x+e.dx)
     e.y=max(8,e.y+e.dy)
    
     if hit(e.x+e.dx,e.y,ew,eh)!=0 then
      e.dx*=-1 end
     if hit(e.x,e.y+e.dy,ew,eh)!=0 then
      e.dy*=-1 end
   else --slide
    m={0,0}
    sm={0,0}
    
    if e.t==1 then 
     m=followd(e.x,e.y,.2,.2)
     sm=sind(20,30,.6,.3,num)
    elseif e.t==2 then 
     m=followd(e.x,e.y,.05,.1)
     sm=sind(80,50,.7,.4,num)
    elseif e.t==3 then 
     m=followd(e.x,e.y,.1,.4)
     sm=sind(160,90,.05,.4,num)
    elseif e.t==5 then 
     m=followd(e.x,e.y,.5,.1)
     sm=sind(240,10,.4,.2,num)
    end
    
    e.dx=m[1]+sm[1] 
    e.dy=m[2]+sm[2]

   
    if hit(e.x+e.dx,e.y,ew,eh)==0 then
     e.x=max(8,e.x+e.dx) end
    if hit(e.x,e.y+e.dy,ew,eh)==0 then
     e.y=max(8,e.y+e.dy) end
   end
   
   
  elseif (t+num)%((8-e.t)*5)==0 then
   --enemy attacks
   bite=max(1,e.t*2+2-(strength*14/e.t))
   
   if (e.t==7) bite*=5
   
   dhealth=bite --display health
   lastbite=e.t
   
   health-=bite
   
   if health>0 then
    sfx(4,1) end
   
   e.dead=true
   enemies_alive-=1
   
   for p=1,5 do
    add_particle(px+3,py+4,2,.1,50)
   end
   
  end
 end 
end

function hit_enemy()
 for e in all(enemies) do
  if e.dead==false and bx>e.x and by>e.y and
   bx<e.x+ew+1 and by<e.y+eh+1 then
    --zap!
    e.dead=true
    sfx(1,1)
    
    waveboost=1
    
    if e.t!=7 then
     score+=e.t*3+1 
     for p=1,10 do
     add_particle(e.x+2,e.y+2,8+e.t,1,80+rnd(55))
    end
    else 
     sfx(5,1) 
     for p=1,200 do
      add_particle(e.x+2,e.y+2,8+e.t,6,200+rnd(100))
     end
    end
    
    enemies_alive-=1
    
    return true 
  end
 end
 return false
end

function followd(ex,ey,ax,ay)
 return {sgn(px-ex)*ax,sgn(py-ey)*ay}
end

function sind(sx,sy,ax,ay,n)
 return {cos(t/sx+n/10)*ax,sin(t/sy+n/10)*ay}
end
-->8
--particles

particles={}

function clear_particles()
 for p=1,#particles do
  del(particles,particles[1])
 end
end

function add_particle(x,y,c,a,dur)
 local p={}
  p.c=c
  p.x=x
  p.y=y
  p.dx=(rnd(2)-1)*a
  p.dy=(rnd(2)-1)*a
  p.t=0
  p.dur=dur
  p.dead=false
 add(particles,p)
end

function update_particle(p)
 if not p.dead then
  p.x+=p.dx
  p.y+=p.dy
  p.t+=1
  if p.t>p.dur then
   p.dead=true sfx(2,0) end
  if st==2 and is_wall(p.x,p.y) then
   p.dx*=-.2 p.dy*=-.2 end
 end
end

function update_particles()
 foreach(particles,update_particle)

  for pa=1,#particles do
   if particles[pa].dead then
    del(particles,particles[pa])
    return
   end
  end 
end
