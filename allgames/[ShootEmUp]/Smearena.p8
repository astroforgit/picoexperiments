pico-8 cartridge // http://www.pico-8.com
version 17
__lua__
--smearena
--by daniel brackenbury

cartdata("fifty_smearena")
best=dget(0)

function savegame()
	dset(0, best)
end

function _init()
	bullets={}
	ebullets={}
	enemies={}
	smears={}
	clots={}
	hits={}
	sparks={}
	psmokes={}
	spawnps={}
	sections={}
	trails={}
	combos={}
	crunches={}
	esmokes={}
	debris={}
	pups={}
	
	score=0
	newhigh=false
	saved=false
	combosfx=(-1)
	multipler=1
	
	for x=0,15 do
		for y=0,13 do
			init_section(x*8,y*8)
		end
	end
	
	entimer=270
	instructions=270
	retry=90
	
	player_init()
end

function _update()
	update_smear()
	update_clots()
	update_hits()
	player_update()
	update_bullet()
	update_ebullet()
	update_enemy()
	update_spawn()
	update_doink()
	update_esmokes()
	update_psmoke()
	update_debris()
	update_powerup()
	update_section()
	
	entimer-=1
	
	if entimer<0 and #enemies<20 then
		for x=0,flr(rnd(2.99))+1 do
			init_enemy(flr(rnd(224))+1)
		end
		entimer=flr(rnd(90))+120
	elseif entimer<0 then
		entimer=flr(rnd(90))+120
	end
	
	if instructions > 0 then
		instructions-=1
	end
	
	if p.combo<4 then
		multiplier=1
	elseif p.combo<10 then
		multiplier=2
	elseif p.combo>=10 then
		multiplier=3
	end
	
	if score > best then
		best = score
		newhigh = true
	end
end

function _draw()
	cls()
	draw_smear()
	draw_clots()
	draw_hits()
	draw_trail()
	draw_powerup()
	print("score:"..score,2,114,10)
	player_draw()
	draw_debris()
	draw_bullet()
	draw_enemy()
	draw_ebullet()
	draw_doink()
	draw_esmokes()
	draw_psmoke()
	draw_spawn()
	
	if p.alive==true then
		if p.move==true then
			fillp()
			circfill(p.x,p.y,2,3)
		else
			fillp()
			circfill(p.x,p.y,2,11)
		end
	end
	
	draw_combo()
	draw_crunch()
	
	print("combo "..p.combo.."x"..multiplier,2,120,7)
	fillp()
	rect(45,120,77,124,7)
	
	if p.combotimer!=0 then
		combosfx=1
		fillp()
		rectfill(46,121,46+p.combotimer/3,123,8)
	elseif p.combotimer==0 and combosfx==1 then
		combosfx=0
	elseif p.combotimer==0 then
		combosfx=(-1)
	end
	
	if p.move==false then
		print("firing",86,120,8)
	elseif p.move==true then
		print("moving",86,120,9)
	end
	
	if combosfx==0 and p.combo<4 then
		sfx(9)
		combosfx-=1
		score+=p.combo
		init_combo(p.combo,p.x-2,p.y)
	elseif combosfx==0 and p.combo<10 then
		sfx(10)
		combosfx-=1
		score+=p.combo*2
		for x=1,20 do
			init_esmokes(p.x,p.y)
		end
		for x=1,10 do
			init_spawn(p.x,p.y)
		end
		init_combo(p.combo*2,p.x-2,p.y)
	elseif combosfx==0 then
		sfx(11)
		combosfx-=1
		score+=p.combo*3
		for x=1,50 do
			init_esmokes(p.x,p.y)
		end
		for x=1,25 do
			init_spawn(p.x,p.y)
		end
		init_combo(p.combo*3,p.x-2,p.y)
	end
	
	if instructions>260 then
		print("kill all enemies!",32,32,5)
		print("Ž fires, — changes state",16,38,5)
		print("”ƒ‹‘ rotates and moves",16,44,5)
		print("high score is",30,50,4)
		print(best,86,50,1)
	elseif instructions>252 then
		print("kill all enemies!",32,32,6)
		print("Ž fires, — changes state",16,38,6)
		print("”ƒ‹‘ rotates and moves",16,44,6)
		print("high score is",30,50,9)
		print(best,86,50,2)
	elseif instructions>12 then
		print("kill all enemies!",32,32,7)
		print("Ž fires, — changes state",16,38,7)
		print("”ƒ‹‘ rotates and moves",16,44,7)
		print("high score is",30,50,10)
		print(best,86,50,8)
 elseif instructions>6 then
 	print("kill all enemies!",32,32,6)
		print("Ž fires, — changes state",16,38,6)
		print("”ƒ‹‘ rotates and moves",16,44,6)
		print("high score is",30,50,9)
		print(best,86,50,2)
 elseif instructions>0 then
 	print("kill all enemies!",32,32,5)
		print("Ž fires, — changes state",16,38,5)
		print("”ƒ‹‘ rotates and moves",16,44,5)
		print("high score is",30,50,4)
		print(best,86,50,1)
	end
	
	if p.alive==false and retry>0 then
		retry-=1
	end
	
	if p.alive==false and newhigh==true and saved==false then
		savegame()
		saved=true
	end
	
	if p.trishottimer>(0) then
		print("tri:"..flr(p.trishottimer/30),52,114,3)
	end
	if p.lasersighttimer>(0) then
		print("lsr:"..flr(p.lasersighttimer/30),86,114,11)
	end
	
	if retry==0 then
		print("reset cart to play again",15,58,6)
	elseif retry<8 then
		print("reset cart to play again",15,58,5)
	elseif retry<16 then
		print("reset cart to play again",15,58,1)
	end
	
	if newhigh==true and retry==60 then
		sfx(13)
		for x=1,80 do
			init_esmokes(rnd(50)+30,rnd(12)+44)
		end
	end
	
	if newhigh==true and retry<53 then
		print("new high score!",35,44,10)
		print(best,57,50,10)
	elseif newhigh==true and retry<55 then
		print("new high score!",35,43,10)
		print(best,57,49,10)
	elseif newhigh==true and retry<57 then
		print("new high score!",35,44,10)
		print(best,57,50,10)
	elseif newhigh==true and retry<59 then
		print("new high score!",35,45,10)
		print(best,57,51,10)
	elseif newhigh==true and retry<61 then
		print("new high score!",35,44,10)
		print(best,57,50,10)
	end
end
-->8
--copy function + powerups/misc

function copy(obj)
	if type(obj) ~= 'table' then
		return obj
	end
	local res=setmetatable({},getmetatable(obj))
	for k, v in pairs(obj) do
		res[k] = v
	end
	return res
end


function init_powerup(x,y,sprite)
	pup={}
	pup.x=x
	pup.y=y
	pup.sprite=sprite
	pup.expire=300
	add(pups,copy(pup))
end

function update_powerup()
	temppups={}
	for x=1,#pups do
		local pup=pups[x]
		
		if pup.expire>0 then
			pup.expire-=1
			add(temppups,pup)
		end
		
		if (pup.x+5>p.x-5 and pup.x<p.x+5) and (pup.y+5>p.y-5 and pup.y<p.y+5) then
			if pup.sprite==17 then
				p.trishottimer+=225
				p.trishot=true
				pup.expire=0
				sfx(14)
			elseif pup.sprite==18 then
				p.lasersighttimer+=225
				p.lasersight=true
				pup.expire=0
				sfx(15)
			end
		end
	end
	pups=temppups
end

function draw_powerup()
	for x=1,#pups do
		local pup=pups[x]
		spr(pup.sprite,pup.x,pup.y)
	end
end
-->8
--player

function player_init()
	p={}
	p.alive=true
	p.x=64
	p.y=64
	p.dx=0
	p.dy=0
	p.life=5
	p.angle=0
	p.radius=8
	p.da=0
	p.turretx=p.x+p.radius*cos(p.angle/360)
	p.turrety=p.y+p.radius*sin(p.angle/360)
	p.move=false
	p.shottimer=15
	p.trailtimer=2
	p.combotimer=0
	p.combo=0
	p.trishot=false
	p.trishottimer=0
	p.lasersight=false
	p.lasersighttimer=0
end

function player_update()

if p.alive==true then

	if p.trishottimer==1 then
		sfx(16)
	end
	if p.lasersighttimer==1 then
		sfx(16)
	end

	if p.trishottimer>0 then
		p.trishottimer-=1
	elseif p.trishottimer==0 then
		p.trishot=false
	end
	if p.lasersighttimer>0 then
		p.lasersighttimer-=1
	elseif p.lasersighttimer==0 then
		p.lasersight=false
	end
	
	if p.combotimer>0 then
		p.combotimer-=1
	elseif p.combotimer==0 then
		p.combo=0
	end
	
	if btn(1) then
		p.da-=10
	elseif btn(0) then
		p.da+=10
	end
	
	p.da*=0.3
	if p.da<0.45 and p.da>(-0.45) then
		p.da=0
	end
	
	p.angle+=p.da
	
 p.turretx=p.x+p.radius*cos(p.angle/360)
	p.turrety=p.y+p.radius*sin(p.angle/360)
	
	if btnp(4) and p.move==false and p.shottimer==0 then
		init_bullet(2*cos(p.angle/360),2*sin(p.angle/360))
		if p.trishot==true then
			init_bullet(2*cos((p.angle+10)/360),2*sin((p.angle+10)/360))
			init_bullet(2*cos((p.angle-10)/360),2*sin((p.angle-10)/360))
		end
		for x=1,16 do
			init_psmoke()
		end
		sfx(0)
		p.shottimer=15
	end
	
	if btnp(5) and p.move==false then
		p.move=true
	elseif btnp(5) and p.move==true then
		p.move=false
	end
	
	if p.move==true then
		if btn(2) then
			p.trailtimer-=1
			p.dx=(cos(p.angle/360))/1.8
			p.dy=(sin(p.angle/360))/1.8
			sfx(6)
		elseif btn(3) then
			p.trailtimer-=1
			p.dx=(cos(p.angle/360))/(-1.8)
			p.dy=(sin(p.angle/360))/(-1.8)
			sfx(6)
		end
	end
	
	if p.trailtimer<0 then
		init_trail()
		p.trailtimer=2
	end
	
	p.x+=p.dx
	p.y+=p.dy
	
	p.dx*=0.85
	p.dy*=0.85
	
	if p.dx<0.2 and p.dx>(-0.2) then
		p.dx=0
	end
	if p.dy<0.2 and p.dy>(-0.2) then
		p.dy=0
	end
	
	if p.x-8<0 then
		p.dx*=(-1)
		p.x+=1
	elseif p.x+8>128 then
		p.dx*=(-1)
		p.x-=1
	end
	if p.y-8<0 then
		p.dy*=(-1)
		p.y+=1
	elseif p.y+8>128 then
		p.dy*=(-1)
		p.y-=1
	end
	
	if p.shottimer>0 then
		p.shottimer-=1
	end
	
	for l=1,#ebullets do
		local eb = ebullets[l]
		
		if (eb.x+1>p.x-3 and eb.x<p.x+3) and (eb.y+1>p.y-3 and eb.y<p.y+3) then
			p.alive=false
			eb.active=false
			sfx(12)
			for x=1,20 do
				init_spawn(p.x,p.y)
			end
			for x=1,60 do
				init_doink(p.x,p.y)
			end
			for x=1,12 do
				init_debris()
			end
		end
	end
end
end

function player_draw()
	
if p.alive==true then
	
	if p.lasersight==true then
		fillp(0b0011110000111100.1)
		line(p.x,p.y,p.x+128*cos(p.angle/360),p.y+128*sin(p.angle/360),8)
	end
	
	if p.move==false then
		fillp()
		circfill(p.x,p.y,5,1)
		circfill(p.x,p.y,3,3)
		line(p.x,p.y,p.turretx,p.turrety,3)
		line(p.x,p.y+1,p.turretx,p.turrety,3)
		line(p.x-1,p.y,p.turretx,p.turrety,3)
	else
		fillp()
		circfill(p.x,p.y,5,1)
		circfill(p.x,p.y,3,11)
		line(p.x,p.y,p.turretx,p.turrety,11)
		line(p.x,p.y+1,p.turretx,p.turrety,11)
		line(p.x-1,p.y,p.turretx,p.turrety,11)
	end
	
end
end

function init_trail()
	trail={}
	trail.x1=p.x+4*cos(p.angle/360)
	trail.y1=p.y+4*sin(p.angle/360)
	trail.x2=p.x+4*cos(p.angle/(-360))
	trail.y2=p.y+4*sin(p.angle/(-360))
	trail.timer=1600
	add(trails,copy(trail))
end

function draw_trail()
	temptrails={}
	for x=1,#trails do
	 trails[x].timer-=1
	 
	 if trails[x].timer>0 then
	 	add(temptrails,trails[x])
			pset(trails[x].x1,trails[x].y1,1)
			pset(trails[x].x2,trails[x].y2,1)
		end
	end
	trails=temptrails
end

function init_combo(input,x,y)
	comb={}
	comb.x=x
	comb.y=y
	comb.combo=input
	comb.timer=60
	if comb.combo>1 then
		sfx(7)
	end
	add(combos,copy(comb))
end

function draw_combo()
	tempcombos={}
	for x=1,#combos do
		local comb=combos[x]
		
		if comb.combo>1 and comb.timer>57 and comb.y>8 then
			print(comb.combo,comb.x+2,comb.y-3,5)
		elseif comb.combo>1 and comb.timer>54 and comb.y>8 then
			print(comb.combo,comb.x+2,comb.y-5,6)
		elseif comb.combo>1 and comb.timer>0 and comb.y>8 then
			print(comb.combo,comb.x+2,comb.y-6,7)
		elseif comb.combo>1 and comb.timer>57 then
			print(comb.combo,comb.x+2,comb.y+5,5)
		elseif comb.combo>1 and comb.timer>54 then
			print(comb.combo,comb.x+2,comb.y+7,6)
		elseif comb.combo>1 and comb.timer>0 then
			print(comb.combo,comb.x+2,comb.y+8,7)
		end
		
		if comb.timer>0 then
			comb.timer-=1
		end
		
		if comb.timer>0 then
			add(tempcombos,comb)
		end
	end
	combos=tempcombos
end

function init_crunch(x,y)
	crunch={}
	crunch.x=x
	crunch.y=y
	crunch.timer=30
	add(crunches,copy(crunch))
end

function draw_crunch()
	tempcrunches={}
	for x=1,#crunches do
		local crunch = crunches[x]
		
		if crunch.timer>27 and crunch.y > 8 then
			print("crunch!",crunch.x-4,crunch.y-3,1)
		elseif crunch.timer>24 and crunch.y > 8 then
			print("crunch!",crunch.x-4,crunch.y-5,2)
		elseif crunch.timer>0 and crunch.y > 8 then
			print("crunch!",crunch.x-4,crunch.y-6,8)
		elseif crunch.timer>27 then
			print("crunch!",crunch.x-4,crunch.y+5,1)
		elseif crunch.timer>24 then
			print("crunch!",crunch.x-4,crunch.y+7,2)
		elseif crunch.timer>0 then
			print("crunch!",crunch.x-4,crunch.y+8,8)
		end
		
		if crunch.timer>0 then
			crunch.timer-=1
			add(tempcrunches,crunch)
		end
	end
	crunches=tempcrunches
end
-->8
--bullet

function init_bullet(dx,dy)
	b={}
	b.active=true
	b.x=p.turretx
	b.y=p.turrety
	b.dx=dx
	b.dy=dy
	add(bullets,copy(b))
end

function update_bullet()
	tempbullets={}
	for x=1,#bullets do
		local b=bullets[x]
		if b.x > 128 or b.x < 0 or b.y > 128 or b.y < 0 then
			b.active = false
		end
		
		b.x+=b.dx
		b.y+=b.dy
		
		if b.active==true then
			add(tempbullets,b)
		end
	end
	bullets=tempbullets
end

function draw_bullet()
	for x=1,#bullets do
		local b=bullets[x]
		fillp()
		line(b.x,b.y,b.x-b.dx,b.y-b.dy,10)
		line(b.x-0.3,b.y-0.3,b.x-b.dx-0.3,b.y-b.dy-0.3,10)
		line(b.x-0.6,b.y-0.6,b.x-b.dx-0.6,b.y-b.dy-0.6,10)
	end
end

function init_ebullet(x,y)
	eb={}
	eb.active=true
	eb.angle=atan2(p.x-x, p.y-y)
	eb.x=x
	eb.y=y
	eb.dx=1.2*cos(eb.angle+(rnd(0.06)-0.03))
	eb.dy=1.2*sin(eb.angle+(rnd(0.06)-0.03))
	eb.animtimer=10
	eb.sprite=3
	add(ebullets,copy(eb))
end

function update_ebullet()
	tempebullets={}
	for x=1,#ebullets do
		local eb=ebullets[x]
		
		eb.x+=eb.dx
		eb.y+=eb.dy
		
		if eb.animtimer>5 then
			eb.sprite=3
			eb.animtimer-=1
		elseif eb.animtimer>0 then
			eb.sprite=4
			eb.animtimer-=1
		elseif eb.animtimer==0 then
			eb.sprite=4
			eb.animtimer=10
		end
		
		if eb.x>128 or eb.x<0 or eb.y>128 or eb.y<0 then
			eb.active=false
		end
		
		if eb.active==true then
			add(tempebullets,eb)
		end
	end
	ebullets=tempebullets
end

function draw_ebullet()
	for x=1,#ebullets do
		spr(ebullets[x].sprite,ebullets[x].x,ebullets[x].y)
	end
end
-->8
--enemy

function init_enemy(sec)
	if sections[sec].activated==false then
		e={}
		e.x=sections[sec].x+2
		e.y=sections[sec].y+2
		e.alive=true
		e.shottimer=flr(rnd(500.99))+60
		e.sprite=1
		e.animtimer=0
		e.pupspawn=0
		for x=1,9 do
			init_spawn(e.x,e.y)
		end
		sfx(4)
		add(enemies,copy(e))
	end
end

function update_enemy()
	tempenemies={}
	for x=1,#enemies do
		local e=enemies[x]
		
		if e.shottimer>0 then
			e.shottimer-=1
		elseif e.shottimer==0 then
			e.animtimer=76
			e.shottimer=(-1)
		end
		
		if e.animtimer>61 then
			e.sprite=2
		 e.animtimer-=1
		elseif e.animtimer>46 then
			e.sprite=1
			e.animtimer-=1
		elseif e.animtimer>31 then
			e.sprite=2
			e.animtimer-=1
		elseif e.animtimer>16 then
			e.sprite=1
			e.animtimer-=1
		elseif e.animtimer>1 then
			e.sprite=2
			e.animtimer-=1
		elseif e.animtimer==1 then
			e.sprite=1
			init_ebullet(e.x+2,e.y+2)
			for x=1,12 do
				init_esmokes(e.x,e.y)
			end
			sfx(8)
			e.animtimer-=1
			e.shottimer=flr(rnd(500.99))+60
		end
			
		for x=1,#bullets do
			local b=bullets[x]
			if e.alive==true and (b.x >=e.x-1 and b.x<=(e.x+6)) and (b.y>=e.y-1 and b.y<=(e.y+6)) or (b.x-b.dx >=e.x-1 and b.x-b.dx <=(e.x+6)) and (b.y-b.dy>=e.y-1 and b.y-b.dy<=(e.y+6)) then
				e.alive=false
				b.active=false
				e.pupspawn=flr(rnd(12))
				
				if e.pupspawn==0 then
					init_powerup(e.x,e.y,flr(rnd(1.999))+17)
				end
				
				sfx(flr(rnd(2.99))+1)
				for x=1,6 do
					init_smear(e.x+3,e.y+3)
				end
				for x=1,4 do
					init_clot(e.x+3,e.y+3)
				end
				for x=1,9 do
					init_hits(e.x+3,e.y+3)
				end
				for x=1,13 do
					init_doink(e.x+3,e.y+3)
				end
				p.combotimer=90
				p.combo+=1
				init_combo(p.combo,e.x,e.y)
			end
		end
		
		if e.alive==true and (p.x+5>=e.x and p.x-5<=e.x+5) and (p.y+5>=e.y and p.y-5<=e.y+5) then
			e.alive=false
			score+=1
			sfx(5)
			for x=1,6 do
				init_smear(e.x+3,e.y+3)
			end
			for x=1,4 do
				init_clot(e.x+3,e.y+3)
			end
			for x=1,9 do
				init_hits(e.x+3,e.y+3)
			end
			init_crunch(e.x,e.y)
			p.combotimer=90
		end
	
		if e.alive==true then
			add(tempenemies,e)
		end
	end
	enemies=tempenemies
end

function draw_enemy()
	for x=1,#enemies do
		local e=enemies[x]
		
		if e.alive==true then
			rectfill(e.x,e.y,e.x+4,e.y+4,1)
			spr(e.sprite,e.x,e.y)
		end
	end
end
-->8
--blood

function init_smear(x,y)
	s={}
	s.fx=x
	s.fy=y
	s.x=x
	s.y=y
	s.dx=rnd(12)-6
	s.dy=rnd(12)-6
	s.timer=4500
	add(smears,copy(s))
end

function update_smear()
	tempsmears={}
	for x=1,#smears do
		local s=smears[x]
		
		s.x+=s.dx
		s.y+=s.dy
		
		s.dx*=0.55
		s.dy*=0.55
		
		if s.dx<0.1 and s.dx>(-0.1) then
			s.dx=0
		end
		if s.dy<0.1 and s.dy>(-0.1) then
			s.dy=0
		end
		
		s.timer-=1
		if s.timer>0 then
			add(tempsmears,s)
		end
	end
	smears=tempsmears
end

function draw_smear()
	for x=1,#smears do
		local s=smears[x]
		
		if s.timer>3 then
			fillp()
			line(s.x,s.y,s.fx,s.fy,2)
		elseif s.timer>0 then
			fillp(0b0101101001011010.1)
			line(s.x,s.y,s.fx,s.fy,2)
		end
	end
end

function init_clot(x,y)
	c={}
	c.x=x
	c.y=y
	c.dx=rnd(4)-2
	c.dy=rnd(4)-2
	c.size=flr(rnd(1.99))+1
	c.timer=4500
	add(clots,copy(c))
end

function update_clots()
	tempclots={}
	for x=1,#clots do
		local c=clots[x]
		
		c.x+=c.dx
		c.y+=c.dy
		
		c.dx*=0.6
		c.dy*=0.6
		
		if c.dx<0.2 and c.x>(-0.2) then
			c.dx=0
		end
		if c.dy<0.2 and c.dy>(-0.2) then
			c.dy=0
		end
		
		c.timer-=1
		
		if c.timer>0 then
			add(tempclots,c)
		end
	end
	clots=tempclots
end

function draw_clots()
	for x=1,#clots do
		local c=clots[x]
		
		if c.timer>3 then
			fillp()
			circfill(c.x,c.y,c.size,2)
		elseif c.timer>0 then
			fillp(0b0101101001011010.1)
			circfill(c.x,c.y,c.size,2)
		end
	end
end

function init_hits(x,y)
	h={}
	h.x=x
	h.y=y
	h.dx=rnd(8)-4
	h.dy=rnd(8)-4
	h.timer=4500
	add(hits,copy(h))
end

function update_hits()
	temphits={}
	for x=1,#hits do
		local c=hits[x]
		
		c.x+=c.dx
		c.y+=c.dy
		
		c.dx*=0.8
		c.dy*=0.8
		
		if c.dx<0.2 and c.x>(-0.2) then
			c.dx=0
		end
		if c.dy<0.2 and c.dy>(-0.2) then
			c.dy=0
		end
		
		c.timer-=1
		
		if c.timer>0 then
			add(temphits,c)
		end
	end
	hits=temphits
end

function draw_hits()
	for x=1,#hits do
		local c=hits[x]
		
		if c.timer>0 then
			pset(c.x,c.y,2)
		end
	end
end
-->8
--particles

function init_doink(x,y)
	d={}
	d.x=x
	d.y=y
	d.dx=rnd(10)-5
	d.dy=rnd(10)-5
	d.size=d.dx+d.dy
	d.col=true
	add(sparks,copy(d))
end

function update_doink()
	tempsparks={}
	for x=1,#sparks do
		local d=sparks[x]
		
		d.x+=d.dx
		d.y+=d.dy
		
		d.dx*=0.72
		d.dy*=0.72
		
		if d.dx<0.2 and d.dx>(-0.2) then
			d.dx=0
		end
		if d.dy<0.2 and d.dy>(-0.2) then
			d.dy=0
		end
		
		if d.col==true then
			d.col=false
		elseif d.col==false then
			d.col=true
		end
		
		d.size=d.dx+d.dy
		
		if d.size<0 then
			d.size*=(-1)
		end
		
		if d.dx!=0 or d.dy!=0 then
			add(tempsparks,d)
		end
	end
	sparks=tempsparks
end

function draw_doink()
	for x=1,#sparks do
		local d=sparks[x]
		
		if d.col==true and (d.dx!=0 or d.dy!=0) then
			fillp()
			circfill(d.x,d.y,d.size,10)
		elseif d.col==false and (d.dx!=0 or d.dy!=0) then
			fillp()
			circfill(d.x,d.y,d.size/3,9)
		end
	end
end

function init_psmoke()
	ps={}
	ps.x=p.turretx
	ps.y=p.turrety
	ps.dx=3.5*cos(p.angle/360)+(rnd(4)-2)
	ps.dy=3.5*sin(p.angle/360)+(rnd(4)-2)
	ps.size=ps.dx+ps.dy
	ps.col=flr(rnd(1.12))
	if ps.col==0 then
		ps.dx*=1.5
		ps.dy*=1.5
	end
	add(psmokes,copy(ps))
end

function update_psmoke()
	temppsmokes={}
	for x=1,#psmokes do
		local ps = psmokes[x]
		
		ps.x+=ps.dx
		ps.y+=ps.dy
		
		ps.dx*=0.65
		ps.dy*=0.65
		
		if ps.dx<0.15 and ps.dx>(-0.15) then
			ps.dx=0
		end
		if ps.dy<0.15 and ps.dy>(-0.15) then
			ps.dy=0
		end
		
		ps.size=ps.dx+ps.dy
		
		if ps.size<0 then
			ps.size*=(-1)
		end
		
		if ps.dx!=0 or ps.dy!=0 then
			add(temppsmokes,ps)
		end
	end
	psmokes=temppsmokes
end

function draw_psmoke()
	for x=1,#psmokes do
		local ps = psmokes[x]
		
		if ps.col==0 then
			fillp()
			circfill(ps.x,ps.y,ps.size/1.5,9)
		elseif ps.col==1 then
			fillp(0b0101101001011010.1)
			if ps.size<2 then ps.size=2 end
			circfill(ps.x,ps.y,ps.size,6)
		end
	end
end

function init_spawn(x,y)
	spawn={}
	spawn.x=x
	spawn.y=y
	spawn.dx=rnd(3)-1.5
	spawn.dy=rnd(3)-1.5
	spawn.size=3*(spawn.dx+spawn.dy)
	add(spawnps,copy(spawn))
end

function update_spawn()
	tempspawnps={}
	for x=1,#spawnps do
		local d=spawnps[x]
		
		d.x+=d.dx
		d.y+=d.dy
		
		d.dx*=0.9
		d.dy*=0.9
		
		if d.dx<0.1 and d.dx>(-0.1) then
			d.dx=0
		end
		if d.dy<0.1 and d.dy>(-0.1) then
			d.dy=0
		end
		
		d.size=3*(d.dx+d.dy)
		
		if d.size<0 then
			d.size*=(-1)
		end
		
		if d.dx!=0 or d.dy!=0 then
			add(tempspawnps,d)
		end
	end
	spawnps=tempspawnps
end

function draw_spawn()
	for x=1,#spawnps do
		local ps = spawnps[x]
		fillp(0b0101101001011010.1)
		circfill(ps.x,ps.y,ps.size,5)
	end
end

function init_esmokes(x,y)
	esmok={}
	esmok.x=x
	esmok.y=y
	esmok.dx=rnd(10)-5
	esmok.dy=rnd(10)-5
	esmok.size=esmok.dx+esmok.dy
	add(esmokes,copy(esmok))
end

function update_esmokes()
	tempesmokes={}
	for x=1,#esmokes do
		local d=esmokes[x]
		
		d.x+=d.dx
		d.y+=d.dy
		
		d.dx*=0.72
		d.dy*=0.72
		
		if d.dx<0.2 and d.dx>(-0.2) then
			d.dx=0
		end
		if d.dy<0.2 and d.dy>(-0.2) then
			d.dy=0
		end
		
		d.size=d.dx+d.dy
		
		if d.size<0 then
			d.size*=(-1)
		end
		
		if d.dx!=0 or d.dy!=0 then
			add(tempesmokes,d)
		end
	end
	esmokes=tempesmokes
end

function draw_esmokes()
	for x=1,#esmokes do
		local d=esmokes[x]
		
		if (d.dx!=0 or d.dy!=0) then
			fillp()
			circfill(d.x,d.y,d.size,12)
		end
	end
end


function init_debris()
	deb={}
	deb.x=p.x
	deb.y=p.y
	deb.dx=rnd(12)-6
	deb.dy=rnd(12)-6
	deb.sprite=5+flr(rnd(6.99))
	add(debris,copy(deb))
end

function update_debris()
	tempdebris={}
	for x=1,#debris do
		local d=debris[x]
		
		d.x+=d.dx
		d.y+=d.dy
		
		d.dx*=0.75
		d.dy*=0.75
		
		if d.dx<0.1 and d.dx>(-0.1) then
			d.dx=0
		end
		if d.dy<0.1 and d.dy>(-0.1) then
			d.dy=0
		end
	end
end

function draw_debris()
	for x=1,#debris do
		local d=debris[x]
		spr(d.sprite,d.x,d.y)
	end
end
-->8
--sections

function init_section(x,y)
	sec={}
	sec.x=x
	sec.y=y
	sec.x2=x+8
	sec.y2=y+8
	sec.activated=false
	add(sections,copy(sec))
end

function update_section()
	for x=1,#sections do
		local sec=sections[x]
		sec.activated=false
		
		for y=1,#enemies do
			local e=enemies[y]
			if (e.x+5>=sec.x and e.x<=sec.x2) and (e.y+3>=sec.y and e.y<=sec.y2) then
				sec.activated=true
			end
		end
		
		if (p.x+8>=sec.x and p.x-8<=sec.x2) and (p.y+8>=sec.y and p.y-8<=sec.y2) then
			sec.activated=true
		end
	end
end

function draw_section()
	for x=1,#sections do
		local sec=sections[x]
		
		if sec.activated==true then
			fillp()
			rectfill(sec.x,sec.y,sec.x2,sec.y2,14)
		elseif sec.activated==false then
			fillp()
			rectfill(sec.x,sec.y,sec.x2,sec.y2,13)
		end
	end
end
