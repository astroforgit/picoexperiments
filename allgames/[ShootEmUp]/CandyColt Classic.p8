pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
--candycolt
--by candycolt games

cartdata("candycolt")

function _init()
	poke(0x5f2e,1)
	for c=0,15 do
		pal(c,c+128,1)
	end
	pal(0,5+128,1)
	pal(7,0,1)
	pal(5,7,1)
	pal(10,10,1)
	pal(0,3+128,1)
	pal(12,10+128,1)
	p1={
		sp=1,
		x=64,
		y=64,
		w=8,
		h=8,
		spd=0.25,
		dy=0,
		dx=0,
		max_dx=2,
		max_dy=7,
		gas=10,
		max_gas=10,
	}
	game={
		cam_x=0,
		cam_y=0,
		score=0,
		highscore=dget(0),
		state="intro",
		tim=time(),
		gravity=0.2,
		friction=0.85,
	}
	candys={}
	candy_start=16
	candy_count=6

	bones={}
	bone_start=32
	bone_count=3
	
	stars={}
	star_start=56
	star_count=2
	
	arrows={}
	
	booms={}
	
	music(0)
	insp=215
	inx=-10
	iny=63
	inx2=100
	iny2=94
	intim=time()
	intime=time()
	in2=false
end

function _update()
	if game.state=="menu" then
		update_menu()
	elseif game.state=="game" then
		update_game()
	elseif game.state=="dead" then
		if btnp(—) then
			p1.sp=1
			p1.x=64
			p1.y=64
			p1.w=8
			p1.h=8
			p1.spd=0.25
			p1.dy=0
			p1.dx=0
			p1.max_dx=2
			p1.max_dy=7
			p1.gas=10
			p1.max_gas=10
			game.state="menu"
			music(0)
			for candy in all(candys) do
				del(candys,candy)
			end
			for bone in all(bones) do
				del(bones,bone)
			end
		end
	elseif game.state=="intro" then
		update_intro()
	end
end

function _draw()
	if game.state=="menu" then
		draw_menu()
	elseif game.state=="game" then
		draw_game()
	elseif game.state=="intro" then
		draw_intro()
	end
end
-->8
--updates

function update_menu()
	if btnp(—) then game.state="game" p1.dy-=5 end
end

function update_game()
	p1.dy*=game.friction
	if btn(‹) then
		if p1.gas>0 then
			p1.dx-=p1.spd
			sfx(4)
			p1.gas-=0.1
		end
	end
	if btn(‘) then
		if p1.gas>0 then
			p1.dx+=p1.spd
			sfx(4)
			p1.gas-=0.1
		end
	end
	if btn(ƒ) then
		if p1.gas>0 then
			p1.dy+=p1.spd
			sfx(4)
			p1.gas-=0.1
		end
	end
	if btn(”) then
		if p1.gas>0 then
			p1.dy-=p1.spd
			sfx(4)
			p1.gas-=0.1
		end
	end
	if btnp(Ž) then
		if p1.gas>0.2 then
			pew()
			sfx(3)
		end
	end
	if p1.gas>p1.max_gas then
		p1.gas=p1.max_gas
	else
		p1.gas+=0.05
	end
	p1.y+=p1.dy
	p1.x+=p1.dx
	if p1.y<0 then p1.y=128 end
	if p1.y>128 then p1.y=0 end
	if p1.x<0 then p1.dx+=1 end
	if p1.x>119 then p1.dx-=1 end
	if p1.dx>p1.max_dx then p1.dx=p1.max_dx end
	if p1.dy>p1.max_dy then p1.dy=p1.max_dy end
	p_animate()
	if #candys==0 then
		make_candy()
	end
	if #bones==0 then
		make_bone()
	end
	make_star()
	for candy in all(candys) do
		candy.x-=1
		if candy.x==-8 then
			del(candys,candy)
		end
		if candy.y+4<p1.y+p1.h
		and candy.y+4>p1.y
		and candy.x+4<p1.x+p1.w
		and candy.x+4>p1.x then
			del(candys,candy)
			game.score+=1
			sfx(5)
		end
	end
	for boom in all(booms) do
		boom.x-=1
		if boom.x==-8 then
			del(booms,boom)
		end
	end
	for bone in all(bones) do
		bone.x-=1
		bone.y+=bone.boost
		if bone.x==-8 then
			del(bones,bone)
		end
		if bone.y+4<p1.y+p1.h
		and bone.y+4>p1.y
		and bone.x+4<p1.x+p1.w
		and bone.x+4>p1.x then
			die()
		end
	end
	for arrow in all(arrows) do
		arrow.x+=arrow.spd
		for bone in all(bones) do
			if bone.y+4<arrow.y+8
			and bone.y+4>arrow.y
			and bone.x+4<arrow.x+8
			and bone.x+4>arrow.x then
				boom={
					sp=8,
					x=bone.x,
					y=bone.y,
				}
				add(booms,boom)
				del(bones,bone)
				game.score+=1
				sfx(6)
			end
			if arrow.x>p1.x+128 then
				del(arrows,arrow)
			end
		end
	end
	for star in all(stars) do
		star.x-=star.spd
		if star.x<-8 then
			del(stars,star)
		end
	end
end
-->8
--draws

function draw_menu()
	cls()
	print("squidkidd and greyskull9 present",1,37,15)
	spr(64,9,43,14,2)
	print("classic",50,60,15)
	print("all of the candy has been stolen",1,80,10)
	print("by the evil skulls. and the only",0,86,10)
	print("person to rescue them is you and",0,92,10)
	print("a colt",50,98,10)
	print("use ”ƒ‹‘ to boost",32,104,15)
	print("z to fire",44,110,15)
	print("x to start",42,116,15)
end

function draw_game()
	cls()
	map(0,0)
	for star in all(stars) do
		spr(star.sp,star.x,star.y)
	end
	spr(p1.sp,p1.x,p1.y)
	for candy in all(candys) do
		spr(candy.sp,candy.x,candy.y)
	end
	for bone in all(bones) do
		spr(bone.sp,bone.x,bone.y)
	end
	for arrow in all(arrows) do
		spr(arrow.sp,arrow.x,arrow.y)
	end
	for boom in all(booms) do
		spr(boom.sp,boom.x,boom.y)
	end
	print("score: "..game.score,0,1,10)
	print("hichscore: "..game.highscore,50,1,10)
	rectfill(10,120,p1.max_gas*10+10,120,5)
	rectfill(10,120,p1.gas*10+11,120,gascol())
end

-->8
--collide(obj,aim,flag)

function collide(obj,aim,flg)
	
	local x=obj.x local y=obj.y
	local w=obj.w local h=obj.h
	
	local x1=0 local y1=0
	local x2=0 local y2=0
	
	if aim=="”" then
		x1=x      y1=y-1
		x2=x+w-1  y2=y
	elseif aim=="ƒ" then
		x1=x      y1=y+h-1
		x2=x+w-1  y2=y+h
	elseif aim=="‘" then
		x1=x+w    y1=y
		x2=x+w    y2=y+h-1
	end
	
	x1/=8 y1/=8
	x2/=8 y2/=8
	
	if fget(mget(x1,y1),flg)
	or fget(mget(x2,y1),flg)
	or fget(mget(x1,y2),flg)
	or fget(mget(x2,y2),flg) then
		return true
	else
		return false
	end
end
-->8
--die()+gascol()

function die()
	print("’ŽŽ ‚ŽŒˆ† ˆ #ƒ",5,111,1)
	print("game over",42,50,8)
	print("press x",44,58,8)
	game.state="dead"
	if game.score>game.highscore then
		game.highscore=game.score
		dset(0,game.score)
	end
	game.score=0
	music(-1)
	sfx(2)
end

function gascol()
	if p1.gas<1 then
		return 8
	elseif p1.gas<3 then
		return 10
	elseif p1.gas<7 then
		return 12
	else
		return 11
	end
end
-->8
--animations

function p_animate()
	if p1.gas>1 then
		if time()-game.tim>0.1 then
			p1.sp+=1
			game.tim=time()
			if p1.sp>3 then p1.sp=1 end
		end
	else
		p1.sp=4
	end
end
-->8
--make_candy()+pew()+_intro()

function make_candy()
	for i=1,game.score+2 do
		candy={
			sp=flr(rnd(candy_count))+candy_start,
			x=i*16+128,
			y=flr(rnd(120)),
		}
		add(candys,candy)
	end
end

function pew()
	arrow={
		sp=58,
		x=p1.x+p1.w,
		y=p1.y,
		spd=3,
	}
	add(arrows,arrow)
end

function draw_intro()
	if in2==false then
		cls()
		poke(0x5f2e,1)
		for c=0,15 do
			pal(c,c+128,1)
		end
		pal(0,5+128,1)
		pal(7,0,1)
		pal(5,7,1)
		pal(10,10,1)
		pal(0,3+128,1)
		pal(12,10+128,1)
		pal(3,4,1)
		spr(128,10,62,15,5)
		print("age",58,102,6)
		print("10",72,102,6)
		print("age 10",57,101,5)
		rectfill(inx+10,iny-3,inx+144,iny+25,0)
		rectfill(in2,iny2,inx2+40,iny2+20,0)
		spr(insp,inx,iny,3,3)
	else
		if time()-intime<1 then
			for i=0,15 do
				pal(i,i,1)
			end
		else
			for c=0,15 do
				pal(c,c+128,1)
			end
			pal(0,5+128,1)
			pal(7,0,1)
			pal(5,7,1)
			pal(10,10,1)
			pal(0,3+128,1)
			pal(12,10+128,1)
		end
	end
end

function update_intro()
	if in2==false then
		if time()-intime<5 then
			inx+=1
			iny2+=0.1
			if time()-intim>0.1 then	
				insp+=3
				if insp>223 then insp=215 end
				intim=time()
			end
		else
			in2=true
			intime=time()
		end
	else
		if time()-intime>1 then
			game.state="menu"
		end
	end
end
-->8
--make_bone()+make_star()

function make_bone()
	for i=1,flr(game.score*2)+1 do
		bone={
			sp=flr(rnd(bone_count))+bone_start,
			x=i*16+128,
			y=flr(rnd(120)),
			boost=rnd(01)-0.5
		}
		add(bones,bone)
	end
end

function make_star()
	for i=1,1 do
		if flr(rnd(101))>70 then
			local rn=flr(rnd(star_count))+star_start
			star={
				sp=rn,
				y=flr(rnd(127)),
				x=i*2+130,
				spd=rn/100,
			}
			add(stars,star)
		end
	end
end
