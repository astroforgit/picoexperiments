pico-8 cartridge // http://www.pico-8.com
version 30
__lua__
--stargunner
--1982 telesys by alex leavens 
--2020 lostcadesoft by bgelais

hd=-4
hx=0
flp=false
score=0
hits=0
‡=3
level=1
dead=false
spawn=false
timeout=0
respawn=0
speed=1

function _init()
intro_init()
end

function hills_draw(tx)
	for i=tx-96,tx+192,96 do
	spr(16,i,110,6,1,false)
	spr(16,i+48,110,6,1,true) end
	rectfill(0,118,127,127,3)
end

function hud_draw()
hs=score.."00"
if (score==0) hs="00"
	for i=1,#hs do
		spr(32+tonum(sub(hs,i,i))
		,72-(#hs*8)+(i*8),0)
 end
 for i=1,‡ do
 	pal(8,9)
 	spr(1,30+i*16,8)
 	pal() 
 end
end
-->8
--player and ufo

function player_init()
	dead=false
	pl={x=64,y=64,flp=false}
	shots={}
end

function player_update()
	if (btn(‹)) hd=4 pl.x-=1 pl.flp=true
	if (btn(‘)) hd=-4 pl.x+=1 pl.flp=false
	if (btn(”)) pl.y-=1
	if (btn(ƒ)) pl.y+=1
	if (btnp(Ž) or btnp(—)) shots_init(pl.x,pl.y)
	hx+=hd
	hx=hx%96
	pl.x=pl.x%127
	pl.y=mid(28,pl.y,96)
	if (col(pl,‚)) dead_init()
	if (col(pl,†)) dead_init()
end

function player_draw()
	spr(1,pl.x-4,pl.y-4,1,1,pl.flp)
end

function dead_init()
 sfx(2,-2) sfx(1)
	expl_init(pl.x,pl.y)
	dead=true
	‡-=1
	respawn=time()+2
end

function dead_update()
 if dead and time()>=respawn then
		
		if (‡<=0) title_init()
		if (‡>0) respawn_init()
	end
end

function shots_init(x,y)
	if #shots<1 then
	shot={x=x,y=y,xd=5}
	if (pl.flp) shot.xd=-5
	sfx(4)
	add(shots,shot) end
end

function shots_update(o)
	o.x+=o.xd
	if (o.x<-8 or o.x>127) del(shots,o)
end

function shots_draw(o)
	pal(6,8+rnd(3))
	spr(2,o.x-4,o.y-4)
	pal()
end

--ufos Œ=bomber ‚=others †=bombs

function Œinit()
 Œ={x=64,y=20,fr=0,xd=0}
 †={}
end

function Œupdate()
	Œ.x=mid(4,Œ.x,108)
	if(time()%.5==0) Œ.xd=-3+flr(rnd(7))
	if (flr(Œ.xd)==0) Œ.xd=1
	if (Œ.x<=4 or Œ.x>=108) Œ.xd=-Œ.xd
	Œ.x+=Œ.xd
 if (#†<1) †init(Œ.x,Œ.y)
	
	Œ.fr=Œ.fr%1.5
	Œ.fr+=.1
end

function Œdraw()
	pal(12,12+rnd(3))
	spr(3+Œ.fr,Œ.x-4,Œ.y-4)
	pal()
end

function †init(x,y)
	add(†,{x=x,y=y})
end

function †update(o)
	o.y+=1
	if (o.y>100) del(†,o)
end

function †draw(o)
	pal(6,rnd(15))
	spr(2,o.x-4,o.y-4)
	pal()
end 

function ‚init()
‚={}

	for i=1,level do
		‚create(
		4+flr(rnd(120)),
		32+flr(rnd(70))
		)
	end
end

function ‚create(x,y)
	add(‚,{
	x=x,y=y,dx=0,dy=0,
	spr=3+2*level,fr=0,
	pl=1+flr(rnd(14))
	})
end

function ‚update(o)
	o.fr+=0.1
	o.fr=o.fr%2

	if time()%1==0 then 
	o.dx=(-1+flr(rnd(3)))*speed
	o.dy=(-1+flr(rnd(3)))*speed
	end
	o.x+=o.dx/4
	o.y+=o.dy/4
	o.x=o.x%127
	o.y=mid(28,o.y,96)
	if col(o,shots)
	then
		sfx(8)
		expl_init(o.x,o.y)
  spawn_init()
		score+=level
		hits+=1
		shots={}
		del(‚,o)	
 end
	
end

function ‚draw(o)
	pal(11,o.pl+o.fr)
	spr(o.spr+o.fr,o.x-4,o.y-4)
	pal()
end

function col(a,b)
	for o in all(b) do
	 if abs(a.x-o.x)<4
		and abs(a.y-o.y)<4
		then return true end
	end
end

function spawn_init()
	spawn=true
	wx=rnd(127)
	wy=32+rnd(64)
	sfx(3)
	warps_init(wx,wy)
end

function spawn_update()
	if #warps==0	
	then
	‚create(wx,wy)
	sfx(2,2)
	spawn=false end
end

-->8
--fx (warp & explode)

function warps_init(x,y)
warptime=16
warps={
{x=x-64,y=y-64,xd=2,yd=2,t=32},
{x=x+64,y=y-64,xd=-2,yd=2,t=32},
{x=x-64,y=y+64,xd=2,yd=-2,t=32},
{x=x+64,y=y+64,xd=-2,yd=-2,t=32}
}	
end

function warps_update(o)
		o.x+=o.xd	o.y+=o.yd
		o.t-=1
if (o.t<=0) del(warps,o)
end

function warps_draw(o)
	pal(6,1+rnd(6))
	spr(2,o.x-4,o.y-4)
	pal()
end

function expl_init(x,y)
	sfx(2,-2)
	expl={
{x=x,y=y,xd=-2,yd=-2,t=32},
{x=x,y=y,xd=2,yd=-2,t=32},
{x=x,y=y,xd=-2,yd=2,t=32},
{x=x,y=y,xd=2,yd=2,t=32}
}
warps_init(rnd(128),rnd(128))
end

function expl_update(o)
	o.x+=o.xd
	o.y+=o.yd
	o.t-=1
	if (o.t<=0)	del(expl,o)
end

function expl_draw(o)
	pal(6,6+rnd(5))
	spr(2,o.x-4,o.y-4)
	pal()
end
-->8
--game

function game_init()
	dead=false
	sfx(2,2)
	player_init()
	†={}
	Œinit()
	‚init()
	_update60=game_update
	_draw=game_draw
end

function game_update()
 if (dead) dead_update()
	if not dead then
	player_update()
	Œupdate()
	foreach(‚,‚update)
	foreach(shots,shots_update)
	foreach(†,†update) end
	if (spawn) spawn_update()
	if (#‚<level and #warps==0) spawn_init()
	if (not dead and spawn) foreach(warps,warps_update)
	foreach(expl,expl_update)
	
	if (hits==level*10) levelup()
end

function levelup()
	level+=1
	if (level==4) level=1
	spawn=false
	sfx(2,-2) sfx(7)
	for t=1,60 do flip() end
	hits=0
	score+=4 
	game_init()
end

function game_draw()
	cls()
	hills_draw(hx)
	foreach(shots,shots_draw)
	if (not dead) foreach(‚,‚draw)
	if (not dead) player_draw()
	foreach(†,†draw)
	Œdraw()
	foreach(warps,warps_draw)
	foreach(expl,expl_draw)
	hud_draw()
end

function respawn_init()
 ‚={} Œ={} †={}
 dead=true
 sfx(-1) sfx(0)
 warps_init(64,64)
	_update60=respawn_update
	_draw=respawn_draw
end

function respawn_update()
 hx+=hd
 hx=hx%96
 foreach(warps,warps_update)
	if (#warps==0) game_init()
end

function respawn_draw()
	cls()
	foreach(warps,warps_draw)
	hills_draw(hx)
	hud_draw()
end
-->8
--title

function title_init()
	sfx(-1)
	timeout=time()+10
	_update60=title_update
	_draw=title_draw
end

function title_update()
	hx+=hd
 hx=hx%96
 if (time()>=timeout) intro_init()
 if btnp(—) or btnp(Ž) then 
 speed=1 
 level=1 
 hits=0 
 score=0 
 ‡=3 
 music(0)
 for t=1,180 do flip() end
 respawn_init() end
end

function title_draw()
	cls()
	hills_draw(hx)
	hud_draw()
	
	spr(64,0,32,16,4)
 
 print("  1982 telesys by alex leavens",0,66,3)
	print("  2020 lostcadesoft by bgelais",0,72,11)
	if (time()%1>.5) print("Ž/— to start",40,100,7)
end
-->8
--intro

function intro_init()
t=0 f=0
timeout=time()+12
Œinit()
introtext=[[
   stop the invasion of the 
   sphyzygi and score as many
       points as you can.

you'll do this by avoiding bombs
   and gunning down the alien 
    saucers and creatures:
the space buzzies and squeezers.
 

   100         200         300

  but don't collide with them,
  or let them rematerialize at
 your location or lose a ship.]]
 _update60=intro_update
 _draw=intro_draw
end

function intro_update()
 Œupdate()
	t+=1 t=min(t,#introtext)
	f+=.2 f=f%2
	if (time()>=timeout) title_init()
	if (btnp(—) or btnp(Ž)) title_init()
	hx+=hd
 hx=hx%96
end

function intro_draw()
	cls()
 Œdraw()
	hud_draw()

	if t>214 then
	 pal(11,rnd(15))
		spr(5+f,14,77)
		spr(7+f,61,77)
		spr(9+f,110,77)
		pal()
	end
	if t==#introtext then
		spr(1,60,118)
	end
	print(sub(introtext,1,t),0,26,6)

end
