pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
-- wavy navy
-- 1982 by rodney mc.auly
-- 2020 by lostcadesoft/bgelais
cartdata("lostcadesoft_wavy")
poke(24412,255)
‡=3
score=0
high=dget(0)
level=0
proms={
"galley slave","boatswain",
"cook","deckhand","crewchief",
"gunner","captain","admiral",
"defense chief","president"}

function _init()
intro_init()
end

function start_init()
	if (level==0) sfx(11)
	–x=0
 –xd=-.2
 bonus=0
 if (rnd(1)<.5) –xd=.2
 timeout=time()+3
 if (level>0) music(0) timeout=time()+10
	_update60=start_update
	_draw=start_draw
end

function start_update()
	waves_update()
		if time()>=timeout then
		level+=1
		level=min(level,#proms)
		enemys_init()
		game_init()	end
end

function start_draw()
	cls()
	hud_draw()
	waves_draw()
if level>0 then 
 ?[[   you have been promoted to 
 ]],0,18,9
 s=proms[level]
 print(s,(128-(#s*4))/2,24,7)
 print("bonus\n 50 x",16,36,12)
 if time()%.5==0 
 and time()>timeout-5
 and bonus!=‡ then
 	sfx(3)
 	bonus+=1
 	score+=5 end	
 for l=1,bonus do
 spr(2,32+l*11,40) end

end
	spr(144,24,64,10,1)
	s=tostr(level)

end

function waves_update()
	–x+=–xd –x=–x%128
end

function waves_draw()
	rectfill(0,108,256,128,1)
	for i=48-–x,256,64 do
	circfill(i,108,16,1) end
	for i=16-–x,256,64 do
	circfill(i,100,16,0) end
end

function •(a,b)
	for m in all(b) do
		if abs(a.x-m.x)<8
		and abs(a.y-m.y)<8
		then return true end
	end
end

„={} --explodes
function „init(_x,_y,_p)
	sfx(1)
	score+=_p
	add(„,{x=_x,y=_y,t=10,r=_p})
end

function „update(o)
	o.t-=1
	
	if (o.t<=0) camera() del(„,o)
end

function „draw(o)
	circfill(o.x+rnd(3),o.y+rnd(3),rnd(10+o.r),7)
	circfill(o.x+rnd(3),o.y+rnd(3),rnd(8+o.r),10)
	circfill(o.x+rnd(3),o.y+rnd(3),rnd(8+o.r),9)
	circfill(o.x+rnd(3),o.y+rnd(3),rnd(8+o.r),8)
	circfill(o.x+rnd(3),o.y+rnd(3),rnd(4),0)
end




-->8
--player

function player_init()
	pl={x=64,y=0,xd=0,frm=2,flp=false}
	yc=0
end

function player_update()
	pl.flp=false
 if (btn()==0) pl.xd=0
	if (btn(‹)) pl.xd-=.1  
	if (btn(‘)) pl.xd+=.1
	if (btnp(Ž) or btnp(—)) shoot_init()
	pl.xd=mid(-1,pl.xd,1) 
 pl.x+=pl.xd
 pl.x=mid(8,pl.x,120)
 if (•(pl,jets)) dead_init()
 if (•(pl,chopers)) dead_init()
 if (•(pl,bombers)) dead_init()
 if (•(pl,bombs)) dead_init()
 if (•(pl,guns)) dead_init()
 if (•(pl,rockets)) dead_init()
 if (•(pl,mines)) dead_init()
end

function float(_x,_y)
	for i=127,80,-1 do
		if (pget(_x,i)!=1) return i
	end
end

function player_draw()
	pl.y=float(pl.x,pl.y)
	pl.frm=2-pget(pl.x-6,pl.y)+pget(pl.x+6,pl.y)
	spr(pl.frm,pl.x-4,pl.y-6,1,1,pl.flp)
 yc=pl.y
end

shots={}

function shoot_init()
	if (#shots==0) sfx(0) add(shots,{x=pl.x,y=pl.y-6,})
end

function shoot_update(o)
	o.y-=2
	if (o.y<0) del(shots,o)
end

function shoot_draw(o)
	spr(4,o.x-4,o.y-4)
	line(o.x,o.y,o.x,o.y+rnd(8)\1,8+rnd(3))
end

-->8
--enemys

function idle_move(o)
	o.flx=false
 o.xd=gxd/2
	o.x+=gxd/2
	if (gxd<0) o.flx=true
end

--chopers

function add_choper(_x,_y)
	add(chopers,{
	x=_x,y=_y,xd=1,yd=0,t=0,
	idle=true,flx=false,f=0})
end

function chopers_update(o)
	o.f+=.5 o.f=o.f%2
	o.x=o.x%128
	o.t+=1 o.t=o.t%20
	if (o.y>80) o.yd=0
	if (pget(o.x,o.y+6)==1 or o.y>127) „init(o.x,o.y,0) del(chopers,o)
	if (o.idle) idle_move(o)
	if (•(o,shots)) shots={} „init(o.x,o.y,2) del(chopers,o)
 if (o.t==0 and o.y>70) gun_init(o,o.x,o.y)

 if not o.idle then
 	o.x+=o.xd/2 o.y+=o.yd/2
 	if (o.x<8 or o.x>120) o.xd=0 o.yd=1
 	if time()%2==0 and o.y>70 then
 		if (o.x<pl.x) o.xd=1
 		if (o.x>pl.x) o.xd=-1
  end
 end
end

function chopers_draw(o)
	o.flx=false
	if (o.xd<0) o.flx=true
	spr(8+o.f,o.x-4,o.y-4,1,1,o.flx)
end

function gun_init(o,_x,_y)
	sfx(4)
	gun={x=_x,y=_y,xd=1,yd=.5}
	if (o.flx) gun.xd=-1
	add(guns,gun)
end

function gun_update(o)
	o.x+=o.xd o.y+=o.yd
end

function gun_draw(o)
	if (pget(o.x,o.y)==1) del(guns,o)
	pset(o.x,o.y,7)
end

--jets

function add_jet(_x,_y)
	add(jets,{
	x=_x,y=_y,xd=0,yd=1,
	idle=true,
	flx=false,
	fly=false,
	f=7,
	})
end

function jets_update(o)
	if (pget(o.x,o.y+6)==1 or o.y>127) „init(o.x,o.y,0) del(jets,o)
	if (•(o,shots)) shots={} „init(o.x,o.y,1) del(jets,o)
	if (o.idle) idle_move(o)

	if not o.idle then
		if time()%2==0 then
		 o.xd=0 o.yd=0
		 if (rnd(1)<.5) o.xd=-1
		 if (rnd(1)>.5) o.xd=1
		 if (rnd(1)<.5) o.yd=0
		 if (rnd(1)>.5) o.xd=0 o.yd=1
		 if (o.xd==0) o.xd=1
		end
	 if (time()%.5==0 and level>=5 and o.y>70) bomb_init(o.x,o.y)
	 o.x+=o.xd o.y+=o.yd/4
	 o.x=o.x%128
		o.flx=false o.fly=false
		if (o.xd<0) o.flx=true
		if (o.yd>0) o.fly=true
		if (o.yd!=0 and o.xd==0) o.f=5
		if (o.yd!=0 and o.xd!=0) o.f=6
		if (o.yd==0 and o.xd!=0) o.f=7
	end

end

function jets_draw(o)
	spr(o.f,o.x-4,o.y-4,1,1,o.flx,o.fly)
end

--rockets
function add_rocket()
	m=rnd(1)
	if m<.5 then
	r={x=-32,y=70+(rnd(21)\1),
	flx=false,xd=2} end
	if m>.5 then
	r={x=134,y=70+(rnd(21)\1),
	flx=true,
	xd=-2} end
	add(rockets,r)
end

function rocket_update(o)
	sfx(2)
	o.x+=o.xd
	if (•(o,shots)) shots={} „init(o.x,o.y,10) del(rockets,o)
	if (o.x<-32 or o.x>192) del(rockets,o)
end

function rocket_draw(o)
	line(o.x,o.y,o.x-o.xd*rnd(8),o.y,8+rnd(3))
	circfill(o.x-o.xd*4,o.y,rnd(4),8+rnd(3))
	spr(12,o.x-8,o.y-4,2,1,o.flx)
end

--bombers
function add_bomber()
	m=rnd(1)
	if m<.5 then
	b={x=-32,y=70+(rnd(10)\1),
	flx=false,xd=1,t=20} end
	if m>.5 then
	b={x=134,y=70+(rnd(10)\1),
	flx=true,xd=-1,t=20} end
	add(bombers,b)
end

function bomber_update(o)
	o.x+=o.xd
	o.t-=1 o.t=o.t%20
	if (o.x<-32 or o.x>134) del(bombers,o)
	if (o.t==0) bomb_init(o.x,o.y)
 if (•(o,shots)) shots={} „init(o.x,o.y,10) del(bombers,o)

end

function bomber_draw(o)
	spr(10,o.x-4,o.y-4,1,1,o.flx)
end

function bomb_init(_x,_y)
	sfx(5)
	add(bombs,{x=_x,y=_y})
end

function bomb_update(o)
	o.y+=.5
	if (o.y>128 or pget(o.x,o.y+4)==1) del(bombs,o)
 if (•(o,shots)) „init(o.x,o.y,0) del(bombs,o)
end

function bomb_draw(o)
	spr(11,o.x-4,o.y-4)
end

--mines

function add_mine()
	mine={x=-8,y=118,xd=-–xd*2}
	if (–xd>0) mine.x=128 
	add(mines,mine)
end

function mine_update(o)
	o.x+=o.xd
	if (o.x<-32 or o.x>150) del(mines,o)
end

function mine_draw(o)
	spr(14,o.x-4,o.y-4)
end

--global enemys updates & draws

function enemys_init()
chopers={}
jets={}
rockets={}
bombers={}
bombs={}
mines={}
guns={}
gxd=1
	for y=0,15 do
  for x=0,15 do
 		id=mget(x,y)
 		if (id==8) add_choper(x*8,y*8)
	 	if (id==7) add_jet(x*8,y*8)
	 end
 end
end

function enemys_update()
	if (time()>=ftime) gxd=-gxd ftime=time()+4
	
	if time()%1==0 and #jets!=0	then 
	jets[#jets].idle=false
	jets[#jets].xd=0
	jets[#jets].yd=1 end
	
	if time()%4==0 and #chopers!=0 then
	chopers[#chopers].idle=false
	chopers[#chopers].xd=gxd*5 end
	
	if (time()%5==0 and level>=2) add_rocket()
	if (time()%10==0 and level>=3) add_bomber()
		 
 foreach(guns,gun_update)
 foreach(chopers,chopers_update)
	foreach(jets,jets_update)
	foreach(rockets,rocket_update)
	foreach(bombers,bomber_update)
	foreach(bombs,bomb_update)
	foreach(mines,mine_update)
	foreach(„,„update)
	if #chopers==0 and #jets==0 
	and #„==0	then	
	start_init()	end
end

function enemys_draw()
	foreach(guns,gun_draw)
	foreach(chopers,chopers_draw)
	foreach(jets,jets_draw)
	foreach(rockets,rocket_draw)
	foreach(bombers,bomber_draw)
	foreach(bombs,bomb_draw)
	foreach(mines,mine_draw)
	foreach(„,„draw)
end

-->8
--game

function game_init()
	gxd=.1
 ftime=time()+4
	player_init()
	if (level>=4) add_mine()
 _update60=game_update
 _draw=game_draw
end

function game_update()
	
	waves_update()
 player_update()
 enemys_update()
 foreach(shots,shoot_update)
end

function game_draw()
	cls()
	waves_draw()
 player_draw()
	enemys_draw()
	foreach(shots,shoot_draw)
	hud_draw()
end

function dead_init()
	„init(pl.x,pl.y,0)
	sfx(10)
	dead={
	x=pl.x,y=pl.y,
	xd=–xd,yd=-2,f=0}
	guns={}
	bombs={}
	bombers={}
	rockets={}
	mines={}
	for o in all(chopers) do
		if (not o.idle) del(chopers,o)
	end
	for o in all(jets) do
		if (not o.idle) del(jets,o)
	end
	‡-=1
	if (‡<=0) music(1)
	_update60=dead_update
	_draw=dead_draw
end

function dead_update()
	dead.f+=.1 dead.f=dead.f%3
	dead.y+=dead.yd
	dead.x+=dead.xd
	dead.yd+=.05
	dead.yd=min(dead.yd,1)
 foreach(„,„update)
 waves_update()
 if dead.y>180 and ‡<=0 
 then title_init()
 elseif dead.y>180 and ‡>0 
 then game_init() end
end

function dead_draw()
	cls()
	waves_draw()
  
 if dead.yd>0 and ‡>0 then
 	spr(144,24,64,10,1)
 elseif dead.yd>0 and ‡<=0 then
 	spr(128,26,64,9,1)
 end
 
 pal(6,8) pal(7,8)
 if pget(dead.x,dead.y-4)==1 then
 	dead.f=0 dead.yd=.1
 	pal(6,2)	pal(7,2)
 end 
 spr(1+dead.f,dead.x-4,dead.y-4)
 pal()
	
	enemys_draw()
	hud_draw()
end

function hud_draw()
 
 spr(16,0,0,2,1)
 spr(32,67,0,2,1)
 
 s="0000"..score.."0"
 s=sub(s,-6)
 for i=1,#s do
 	spr(18+tonum(sub(s,i,i)),9+i*8,0)
 end
 
 s="0000"..high.."0"
 s=sub(s,-6)
 for i=1,#s do
 	spr(34+tonum(sub(s,i,i)),72+i*8,0)
 end

 for l=0,‡-1 do
 	spr(2,l*9,120)
 end
end


-->8
--title

function title_init()
 tx=128
	–x=0
 –xd=-.2
 if (score>high) high=score dset(0,high)
 score=0
 ‡=3
 level=0
 timeout=time()+10
	_update60=title_update
	_draw=title_draw
end

function title_update()
	waves_update()
	tx-=2 tx=max(0,tx)
	if (time()>=timeout) intro_init()
	if (btnp(—) or btnp(Ž)) start_init()
end

function title_draw()
	cls()
	waves_draw()
	hud_draw()
	ty=float(32,100)/2
	spr(64,tx,80-ty,16,2)
	spr(64,-tx+16,94-ty,16,2)
 ?"1982 sirius by rodney mc.auly",8,70,13
 ?"2020 lostcadesoft by bgelais",8,76,12
 if (time()%1<.5) print("Ž/— start",44,118,7)
end
-->8
--intro

function intro_init()
	–x=0
 –xd=-.2
 timeout=time()+10
 enemys_init()
	_update60=intro_update
	_draw=intro_draw
end

function intro_update()
	waves_update()
	if (btnp()!=0) title_init()
	if (time()>=timeout) demo_init()
end

function intro_draw()
	cls()
	waves_draw()
	spr(67,-1,0,9,2)
	spr(101,62,6,9,2)
	print("point table",8,24,7+rnd(8))
	line(8,30,50,30,2)
	print("rank table",74,24,7+rnd(8))
	line(73,30,112,30,2)
	print("10\n\n20\n\n100\n\n100\n\n0",32,36,7)
	spr(7,14,34)
	spr(8,14,44)
	spr(10,14,58)
	spr(12,10,70,2,1)
	spr(14,14,83)
	for i=1,#proms do
	 ?proms[i],74,29+(i*6),7
	end
end
-->8
--demo

function demo_init()
	enemys_init()
	player_init()
	–x=0
 –xd=-.2
	gxd=.1
 ftime=time()+4
	rmove=0
	level=1+flr(rnd(6))
	if (level>=4) add_mine()
	timeout=time()+10
	_update60=demo_update
	_draw=demo_draw
end

function demo_update()
	
	if (time()%.5==0) rmove=flr(rnd(4))
	pl.flp=false
 if (rmove==0) pl.xd=0
	if (rmove==1) pl.xd-=.1  
	if (rmove==2) pl.xd+=.1
	shoot_init()
	pl.xd=mid(-1,pl.xd,1) 
 pl.x+=pl.xd
 pl.x=mid(8,pl.x,120)

 waves_update()
 enemys_update()
 foreach(shots,shoot_update)
 if (time()>=timeout or btnp()!=0) title_init()
end

function demo_draw()
 sfx(-1)
	cls()
	waves_draw()
 player_draw()
	enemys_draw()
	foreach(shots,shoot_draw)
	hud_draw()
 if (time()%1<.5) print("Ž/— start",44,118,7)

end
