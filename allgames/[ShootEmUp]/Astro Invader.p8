--game over

over={}
over.update=function()
 if btnp(4) or btnp(5) then 
  game.mode='title'
 end
end

over.draw=function()
 game.draw()
 rectfill(43,60,83,70,0)
 rect(44,61,82,69,7)
 print('game over',64-(9*4)/2,63,7)
end
-->8
---------------------
-- collision stuff --
---------------------

-- objects should have
-- x,y = location of object
-- box=offset of bounding box
-- box={x1,y1,x2,y2}


function abs_box(s)
 local box = {}
 box.x1 = s.box.x1 + s.x
 box.y1 = s.box.y1 + s.y
 box.x2 = s.box.x2 + s.x
 box.y2 = s.box.y2 + s.y
 return box
end

function coll(a,e)
 box_a = abs_box(a)
 box_b = abs_box(e)
 if box_a.x1 > box_b.x2 or
    box_a.y1 > box_b.y2 or
    box_b.x1 > box_a.x2 or
    box_b.y1 > box_a.y2 then
    return false
 end
 return true
end

function hoverlap(x1,x2,x3,x4)
 if(x2<x3 or x1>x4)return false
 return true
end
