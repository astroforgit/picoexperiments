--titlescreen
title={}
title.tcolors={8,9,10,11,12,13,14}
title.cp=1
title.tt=4
title.update=function()
 if btnp(5) then
  game.new()
  game.mode='game'
 end
end

title.draw=function()
 cls()
 print("a s t r o   i n v a d e r",14,40,12)
 print("press — to play",32,70,12) 
 print("a pico-8 remake of the",20,94,1)
 print("1980 game published by stern",8,100,1)
 print("by jim weil",42,112,1)
 title.tt-=1
	if title.tt==0 then
	 title.cp+=1
	 if(title.cp>#title.tcolors)title.cp=1
	 title.tt=4
	end
	local cc=title.cp
	for r=40,44 do
	 for c=0,127 do
	  if(pget(c,r)!=0)pset(c,r,title.tcolors[cc])
	 end
	 cc-=1
	 if(cc==0)cc=#title.tcolors
	end
end


