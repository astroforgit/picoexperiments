pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- astro invader
-- 1980 by stern electronics
-- pico-8 remake
-- 2018 by jim weil

-- saucer = mothershihp
-- aliens = small aliens in slots
-- ufo = large dropping ships

game={}
game.mode='title'
game.deathtimer=0
game.init=function()
 game.mode='title' --game mode
end
game.new=function()
 basescore=0
 score=4800
 level=1
 enemies=100
 lives=3
 deathtimer=0
 deathmax=100 
 saucer.init()
 aliens.init()
 ufo.init()
 player.init()
 shot.init()
end

game.update=function()
 if(t%aliens.freq==0) and 
   saucer.mode=='spawn' then
  aliens.make(60,8)
  enemies-=1
  if enemies==0 then
   saucer.mode='leave'
   level+=1
  end
 end
 shot.update()
 aliens.update()
 saucer.update()
 ufo.update()
 player.update()
end

game.draw=function()
 local s='000000'..tostr(score)
 local l='lvl 00'..tostr(level)
 cls(bg)
 
 print(sub(s,#s-6,#s),99,0,7)
 print(sub(l,#l-7,#l),99,6,7)
 if lives>1 then
  --spr(17,0,0)
  --spr(18,8,0)
  --spr(16,0,0)
 end
 if lives>2 then
  --spr(17,15,0)
  --spr(18,23,0)
  spr(16,8,0)
 end
 for i=1,lives-1 do
  spr(16,(i-1)*8,0)
 end
 
 drawframe()
 saucer.draw()
 --three red ufo drop bars
 rectfill(6,36,21,39,8)
 rectfill(55,36,70,39,10) 
 rectfill(104,36,119,39,8)
 --hole in top
 rectfill(58,14,66,22,0)
 --line at bottom
 line(0,127,125,127,8)
 --draw vertical bars
 for i=22,48,8 do
  vline(i,36,26,11)
  vline(i,36,6,10)
  vline(i+49,36,26,11)
  vline(i+49,36,6,10)
 end
 vline(54,36,26,11)
 vline(54,36,6,10)
 vline(103,36,26,11)
 vline(103,36,6,10)
 
 aliens.draw()
 ufo.draw()

 player.draw()
 shot.draw()
end

function _init()
	t=0
 game.init()
end

function _update()
 t+=1
 if game.mode=='death' then
  deathtimer-=1
  if deathtimer<=0 then
   if lives>0 then
    game.mode='game'
   else
    game.mode='over'
   end
  end
 end

 if(game.mode=='game')game.update()
 if(game.mode=='title')title.update()
 if(game.mode=='over')over.update()
end

function _draw()
 pal()
 if(game.mode=='title')title.draw()
 if(game.mode=='game')game.draw()
 if(game.mode=='death') then
  palall(8)
  game.draw() 
 end
 if(game.mode=='over')over.draw()
end

function vline(x,y,h,c)
 line(x,y,x,y+h,c)
end

function drawframe()
 for x=0,120,6 do
  spr(48,x,14)
 end
 for y=116,104,-6 do
  spr(49,0,y)
  spr(49,120,y)
 end
 for y=98,86,-6 do
  spr(50,0,y)
  spr(50,120,y)
 end
 for y=80,68,-6 do
  spr(51,0,y)
  spr(51,120,y)
 end
 for y=62,50,-6 do
  spr(52,0,y)
  spr(52,120,y)
 end
 for y=44,32,-6 do
  spr(53,0,y)
  spr(53,120,y)
 end  
 for y=26,14,-6 do
  spr(48,0,y)
  spr(48,120,y)
 end         
end

function stacky(s)
 return 57-(saucer.stacks[s]*7)
end

function palall(v)
 --set all drawing to a
 --single colour
 for i=1,15 do
  pal(i,v)
 end
end

function rndb(lo,hi)
 --return integer inclusive
 return flr(rnd((hi-lo)+1)+lo)
end

function delall(l)
 for r in all(l) do
  del(l,r)
 end
end
-->8
--player
player={}
player.init=function()
 player.base={}
 player.base.x=57
 player.base.y=122
 player.base.box={x1=0,y1=0,x2=12,y2=4}
end
player.update=function()
 if(btn(0)) then --left
  player.base.x-=2
  if(player.base.x<-2)player.base.x=-2
 end
 if(btn(1)) then --right
  player.base.x+=2
  if(player.base.x>116)player.base.x=116
 end
 if(btnp(5)) and shot.x<0 then
  sfx(2)
  shot.x=player.base.x+6
  shot.y=115
  shot.shots+=1
 end
end
player.die=function()
 sfx(-1,3)
 sfx(6)
 lives-=1
 game.mode='death'
 deathtimer=deathmax
 --clear aliens and ufo
 for f in all(aliens) do
  if(f.mode=='attack')del(aliens,f)
 end
 ufo.mode='hide'
end
player.score=function(s)
 score+=s
 if score-basescore>=5000 then
  lives+=1
  basescore+=5000
  sfx(8)
 end
end
player.draw=function()
 if game.mode=='death' then
  palall(8)
  spr(20,player.base.x,player.base.y)--119
  spr(21,player.base.x+8,player.base.y)
 else
  spr(17,player.base.x,player.base.y)--119
  spr(18,player.base.x+8,player.base.y)
 end
end


-->8
--aliens
aliens={}
aliens.init=function()
 aliens.freq=20
 delall(aliens)
end
aliens.make=function(x,y)
 a={
    x=x,
    y=y,
    mode='drop',
    dest=nil,
    stack=nil,
    inq=false,
    c=12, --color
    ny=0,
    timer=0,
    box={x1=0,y1=0,x2=4,y2=5}
   }
 if level%2==1 then
  --odd levels
  --aliens drop back&forth
  a.dest=saucer.dest[saucer.curslot]
  a.stack=saucer.curslot
  saucer.curslot+=saucer.slotdx
  if saucer.curslot==9 then
   saucer.slotdx=-1
   saucer.curslot=7
  end
  if saucer.curslot==0 then
   saucer.slotdx=1
   saucer.curslot=2
  end 
 else
  --even levels
  --aliens drop near player
  if player.base.x>=64 then
   local curdest=rndb(5,8)
   a.dest=saucer.dest[curdest]
   a.stack=curdest
  else
   local curdest=rndb(1,4)
   a.dest=saucer.dest[curdest]
   a.stack=curdest
  end
 end  
 add(aliens,a)
 sfx(4)
end

aliens.update=function()
 for a in all(aliens) do
  aliens[a.mode](a)
 end
end

aliens.drop=function(a)
 --drop from saucer
 a.y+=2
 if a.y>27 then
  a.mode='horz'
 end
end

aliens.horz=function(a)
 --move horz over to stack
 if a.dest>a.x then
  a.x+=2
  if a.x>=a.dest then
   a.x=a.dest
   a.mode='fill'
   a.c=10
  end
 elseif a.dest<a.x then
  a.x-=2
  if a.x<=a.dest then
   a.x=a.dest
   a.mode='fill'
   a.c=10
  end
 end
end

aliens.fill=function(a)
 --fill top of stack
 --how far to top of stack
 sy=stacky(a.stack)  
 if sy>a.y then
  a.y+=2
  if(a.y>32)a.c=11
  if a.y>=sy then
   a.y=sy
   a.mode='queue'
   if sy==36 then --top spot
    --shift aliens down
    for f in all(aliens) do
     if f.stack==a.stack and
     f.mode=='queue' then
      f.mode='lower'
      f.ny=f.y+7
     end
    end
   else
    saucer.stacks[a.stack]+=1
    a.mode='queue'
   end
  end
 end
end 

aliens.queue=function(a)
 --do nothing
end
 
aliens.lower=function(a)
 --lower queue
 a.y+=1
 if a.y>=a.ny then
  a.y=a.ny
  a.mode='queue'
  if a.ny>=64 then
   a.mode='attack'
   a.stack=0
   a.c=2
  end
 end
end

aliens.attack=function(a)
 a.y+=1
 if a.y>120 then
  if coll(a,player.base) then
   sfx(-1,3)
   sfx(1)
   player.die()
  else   
   sfx(1)   
   a.mode='flare'
   a.c=12
  end
 end
end

aliens.flare=function(a)
 if hoverlap(player.base.x,player.base.x+13,a.x-6,a.x+10) then
  sfx(-1,3)
  sfx(1)
  lives-=1
  game.mode='death'
  deathtimer=deathmax
  for f in all(aliens) do
   if f.mode=='attack' or
      f.mode=='flare' or
      f.mode=='flare2' then
    del(aliens,f)
   end
  end
 else
  a.mode='flare2'
 end
end

aliens.flare2=function(a)
 if hoverlap(player.base.x,player.base.x+13,a.x-12,a.x+16) then
  sfx(-1,3)
  sfx(1)
  lives-=1
  game.mode='death'
  deathtimer=deathmax
  for f in all(aliens) do
   if f.mode=='attack' or 
      f.mode=='flare' or
      f.mode=='flare2' then
    del(aliens,f)
   end
  end
  ufo.mode='hide'
 else
  del(aliens,a)
 end
end

aliens.die=function(a)
 a.timer-=1
 if a.timer==0 then
  if a.inq then
	  for f in all(aliens) do
	   if f.stack==a.stack and 
	      f.mode=='queue' then
	    f.mode='lower'
	    f.ny=f.y+7
	   end
	  end
	  saucer.stacks[a.stack]-=1 
	 end
  del(aliens,a)
 end 
end

aliens.draw=function()
 for a in all(aliens) do 
  pal(11,a.c)
  if(game.mode=='death')palall(8)
  if a.mode=='die' then
   spr(19,a.x,a.y)
  else
   spr(1,a.x,a.y)
  end
  pal()
  if a.mode=='flare' or 
     a.mode=='flare2' then
   spr(2,a.x-6,a.y)
   spr(2,a.x+4,a.y)
  end
  if a.mode=='flare2' then
   spr(2,a.x-12,a.y)
   spr(2,a.x+10,a.y)
  end
 end
end
-->8
--saucer and ufo

ufo={}
ufo.init=function()
 ufo.dropfreq=600
 ufo.drops={[0]=56,7,105,56,105,56,7,56,56,105,7,56,105,105,7,7}
 ufo.dropptr=0
 ufo.mode='hide'
 ufo.x,ufo.y=0,0
 ufo.box={x1=0,y1=0,x2=13,y2=5}
 ufo.value=100
 ufo.timer=0
end
ufo.attack=function()
 ufo.mode='attack'
 ufo.x=ufo.drops[ufo.dropptr]
 ufo.y=40
 ufo.dropptr=(ufo.dropptr+1)%(#ufo.drops+1)
 sfx(5,3)--ufo snd
end
ufo.update=function()
 if(t%ufo.dropfreq==0)ufo.attack()
 if ufo.mode=='attack' then
  ufo.y+=1
  if coll(ufo,player.base)
     or ufo.y>120 then
   player.die()
  end
 elseif ufo.mode=='die' then
  ufo.timer-=1
  if ufo.timer==0 then
   ufo.mode='hide'
   sfx(-1,3)--stop ufo snd
  end
 end
end
ufo.draw=function()
 if ufo.mode=='attack' then
  if(game.mode=='death')palall(8)
  spr(3,ufo.x,ufo.y)
  spr(4,ufo.x+8,ufo.y)
 end
 if ufo.timer>0 then
  print(ufo.value,ufo.x+1,ufo.y,12)
 end 
end

saucer={}
saucer.init=function()
 saucer.stacks={0,0,0,0,0,0,0,0}
 saucer.dest={24,32,40,48,73,81,89,97}
 saucer.curslot=1 --next slot for alien    
 saucer.slotdx=1 --next curdest is 1 or -1
 saucer.x=128
 saucer.mode='enter'
 sfx(3)
end

saucer.update=function()
 if saucer.mode=="enter" then
  saucer.x-=1
  if saucer.x<43 then
   saucer.x=43
   saucer.mode="spawn"
   sfx(-1)
  end
 elseif saucer.mode=="spawn" then
 elseif saucer.mode=="leave" then
  saucer.x+=1
  if saucer.x>128 then
   enemies=100
   saucer.mode="enter"
  end
 end
end
saucer.draw=function()
 local nx=saucer.x+14
 spr(7,saucer.x,-3)
 spr(8,saucer.x+8,-3)
 spr(9,saucer.x+16,-3)
 spr(10,saucer.x+24,-3)
 spr(11,saucer.x+32,-3)
 spr(23,saucer.x,5)
 spr(24,saucer.x+8,5)
 spr(25,saucer.x+16,5)
 spr(26,saucer.x+24,5)
 spr(27,saucer.x+32,5)
 if(enemies<100)nx=saucer.x+16
 if(enemies<10)nx=saucer.x+18
 print(enemies,nx,5,7)
 
end
-->8
--shot

shot={}
shot.init=function()
 shot.shots=0
 shot.x=-1
 shot.y=0
 shot.box={x1=0,y1=0,x2=0,y2=1}
end
shot.update=function()
 local s=0
 if shot.x>0 then --there is a shot
  shot.y=shot.y-3
  if(shot.y<20) then
   shot.x=-1 --off top
   return
  end 
  --check if ufo hit
  if ufo.mode=='attack' then
   if coll(shot,ufo) then
    sfx(-1,3)--stop ufo snd
    sfx(6)
    ufo.mode='die'
    ufo.timer=10
    shot.x=-1
    local num=shot.shots%16
    local s=100
    if(num==4)s+=100
    if(num==8)s+=200
    if(num==12)s+=100
    if(num==0)s+=300
    player.score(s)
    ufo.value=s
    return
   end
  end   
   --check if alien hit
  for a in all(aliens) do
   if coll(shot,a) then
    if(a.mode=='queue') then    
     s=a.stack
     player.score(10)
    else
     player.score(20)
    end
    if(a.mode=='queue')a.inq=true
    a.mode='die'
    a.timer=4
    --del(aliens,a)
    sfx(0)
    shot.x=-1
    break
   end
  end

  if pget(shot.x,shot.y)!=0 then --or 
     --pget(shot.x,shot.y+1)!=0 or
     --pget(shot.x,shot.y+2)!=0 then  
   shot.x=-1
  end
 end
end
shot.draw=function()
 if shot.x>0 then
  spr(33,shot.x,shot.y)
 end 
end

 					

