pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--roboduel
--by leo

gameover=true

function init_game()
 --draw game switch
 draw=false
 
 timer=99
 set_timer=time()
 --player 1 settings
 p1={
 	hp=3,
 	dead=false,
 	pos={x=20,y=12},
 	direction="r",
 	lastshot=0,
 	canshoot=true,
 	shotrate=0.6,
 	sprite=0,
 	frames={0,1,2,3},
 	framecount=1,
 	hitbox={x=2,y=1,w=4,h=6},
 	speed=1,
 	flipx=false,
 	frametime=time(),
 	animate=function(self) 
 		if time()-self.frametime>0.07 then
 			self.sprite=self.frames[self.framecount]
 			if self.framecount%2==0 then
 				sfx(3)
 			end
 			if self.framecount>4 then
 				self.sprite=self.frames[1]
 				self.framecount=1
 			end
 			self.framecount+=1
 			self.frametime=time()
 		end
 	end
 }
 --player 2 settings
 p2={
 	hp=3,
 	dead=false,
 	pos={x=100,y=108},
 	direction="l",
 	lastshot=0,
 	canshoot=true,
 	shotrate=0.6,
 	sprite=6,
 	frames={6,7,8,9},
 	framecount=1,
 	hitbox={x=2,y=1,w=4,h=6},
 	speed=1,
 	flipx=true,
 	frametime=time(),
 	animate=function(self) 
 		if time()-self.frametime>0.07 then
 			self.sprite=self.frames[self.framecount]
 			if self.framecount%2==0 then
 				sfx(3)
 			end
 			if self.framecount>4 then
 				self.sprite=self.frames[1]
 				self.framecount=1
 			end
 			self.framecount+=1
 			self.frametime=time()
 		end
 	end
 }
--wall lights
lights={}
add(lights,light(48,32))
add(lights,light(72,32))
add(lights,light(48,96))
add(lights,light(72,96))
 
--bullets container
bullets={}

--sparks container
sparks={}
end


--flag for solid walls
fwall=0

--wall lights
light=function(x,y)
	local l={}
	l.pos={x=x,y=y}
	l.sprite=160
	l.direction=1
	l.frames={160,161,162}
	l.framecount=1
	l.frametime=time()
	l.animate=function(self)
		if time()-self.frametime>0.25 then
			self.sprite=self.frames[self.framecount]
			self.framecount+=self.direction
			self.frametime=time()
			if self.framecount==3 or self.framecount==1 then
				l.direction*=-1
			end
		end
	end
	return l
end

--sparks when player hit
spark=function(x,y)
	local s={}
	s.pos={x=x,y=y}
	s.dead=false
	s.sprite=10
	s.frames={64,65,66,67,68,69,70,71,72,73,74,75,76,77}
	s.framecount=1
	s.frametime=time()
	s.animate=function(self) 
		if time()-self.frametime>0.04 then
			self.sprite=self.frames[self.framecount]
			if self.framecount>9 then
				self.dead=true
			end
			self.framecount+=1
			self.frametime=time()
		end
 end
	return s
end

--bullet creation
bullet=function(p,x,y,d)
	local b={}
	b.firedby=p
	b.pos={x=x,y=y}
	b.direction=d
	b.sprite=4
	b.hitbox={x=2,y=4,w=4,h=3}
	--set bullet direction and hitbox
	if b.direction=="l" or b.direction=="r" then
		b.sprite=4
		b.hitbox={x=2,y=4,w=4,h=3}
	end
	if b.direction=="u" or b.direction=="d" then
		b.sprite=5
		b.hitbox={x=2,y=2,w=3,h=5}
	end
	
	b.update=function(self)
		if b.direction=="l" then
			self.pos.x-=2
		end
		if b.direction=="r" then
			self.pos.x+=2
		end
		if b.direction=="u" then
			self.pos.y-=2
		end
		if b.direction=="d" then
			self.pos.y+=2
		end
	end
	return b
end

--detect collision between bullets and player
function collision(obj,other)
	if other.pos.x+other.hitbox.x+other.hitbox.w>
		obj.pos.x+obj.hitbox.x and
		other.pos.y+other.hitbox.y+other.hitbox.h>
		obj.pos.y+obj.hitbox.y and
		other.pos.x+other.hitbox.x<
		obj.pos.x+obj.hitbox.x+obj.hitbox.w and
		other.pos.y+other.hitbox.y<
		obj.pos.y+obj.hitbox.y+obj.hitbox.h then
		return true
	end
end

-- detect wall collision
function checkwall(o)
	local xpos=flr((o.pos.x+o.hitbox.x)/8)
	local ypos=flr((o.pos.y+o.hitbox.y)/8)

	local foundsprite=mget(xpos,ypos)
	local d=fget(foundsprite,fwall)
	--top right corner
	if d==false then
		d=fget(mget(flr((o.pos.x+
		o.hitbox.x+o.hitbox.w)/8),
		flr((o.pos.y+o.hitbox.y))/8),fwall)
	end
	--bottom left corner
	if d==false then
		d=fget(mget(flr((o.pos.x+o.hitbox.x)/8),
			flr((o.pos.y+o.hitbox.y+o.hitbox.h)/8)),fwall)
	end	
	--bottom right corner
	if d==false then
		d=fget(mget(flr((o.pos.x+o.hitbox.x+o.hitbox.w)/8),
			flr((o.pos.y+o.hitbox.y+o.hitbox.h)/8)),fwall)
	end
	return d
end

--player 1
function p1_control(p)
	--left	
	if btn(0,0) then
		p.pos.x-=p.speed
		p.direction="l"
		if checkwall(p) or collision(p,p2) then
			p.pos.x+=p.speed
		end
		p.frames={0,1,2,3}
		p.flipx=true
		p.animate(p)
	end
	--right
	if btn(1,0) then
		p.pos.x+=p.speed
		p.direction="r"
		if checkwall(p) or collision(p,p2) then
			p.pos.x-=p.speed
		end
		p.frames={0,1,2,3}
		p.flipx=false
		p.animate(p)
	end
	--up
	if btn(2,0) then
		p.pos.y-=p.speed
		p.direction="u"
		if checkwall(p) or collision(p,p2) then
			p.pos.y+=p.speed
		end
		p.frames={32,33,34,35}
		p.animate(p)
	end
	--down
	if btn(3,0) then
		p.pos.y+=p.speed
		p.direction="d"
		if checkwall(p) or collision(p,p2) then
			p.pos.y-=p.speed
		end
		p.frames={16,17,18,19}
		p.animate(p)
	end
	--left diagonal
	if btn(0,0) and (btn(2,0) or btn(3,0)) then
		p.direction="l"
	end
	--right diagonal
	if btn(1,0) and (btn(2,0) or btn(3,0)) then
		p.direction="r"
	end
	--shoot
	if time()-p.lastshot>=p.shotrate then
		p.canshoot=true
	end
	if btnp(5,0) and p.canshoot then
		sfx(0)
		add(bullets,bullet("p1",
			p.pos.x,p.pos.y,p.direction))
		p.canshoot=false
		p.lastshot=time()
	end
end	

--player 2
function p2_control(p)
	--left	
	if btn(0,1) then
		p.pos.x-=p.speed
		p.direction="l"
		if checkwall(p) or collision(p,p1) then
			p.pos.x+=p.speed
		end
		p.frames={6,7,8,9}
		p.flipx=true
		p.animate(p)
	end
	--right
	if btn(1,1) then
		p.pos.x+=p.speed
		p.direction="r"
		if checkwall(p) or collision(p,p1) then
			p.pos.x-=p.speed
		end
		p.frames={6,7,8,9}
		p.flipx=false
		p.animate(p)
	end
	--up
	if btn(2,1) then
		p.pos.y-=p.speed
		p.direction="u"
		if checkwall(p) or collision(p,p1) then
			p.pos.y+=p.speed
		end
		p.frames={38,39,40,41}
		p.animate(p)
	end
	--down
	if btn(3,1) then
		p.pos.y+=p.speed
		p.direction="d"
		if checkwall(p) or collision(p,p1) then
			p.pos.y-=p.speed
		end
		p.frames={22,23,24,25}
		p.animate(p)
	end
	--left diagonal
	if btn(0,1) and (btn(2,1) or btn(3,1)) then
		p.direction="l"
	end
	--right diagonal
	if btn(1,1) and (btn(2,1) or btn(3,1)) then
		p.direction="r"
	end
	--shoot
	if time()-p.lastshot>=p.shotrate then
		p.canshoot=true
	end
	if btnp(5,1) and p.canshoot then
		sfx(0)
		add(bullets,bullet("p2",
			p.pos.x,p.pos.y,p.direction))
		p.canshoot=false
		p.lastshot=time()
	end
end

--player death animation
function death_anim(p)
	if p.dead==false then
	 sfx(4)
	 p.dead=true
	end
	if time()-p.frametime>0.14 then
		p.sprite=p.frames[p.framecount]
		if p.framecount>6 then
			p.sprite=p.frames[6]
			if p.framecount>30 then
				gameover=true
				p.framecount=1
				music(0)
			return
			end
		end
		p.framecount+=1
		p.frametime=time()
	end
end	

function _init()
	init_game()
	music(0)
end

--main game loop
function _update()
	foreach (lights,function(light)
		light.animate(light)
	end)

	foreach (sparks, function(spark)
		spark.animate(spark)
		if spark.dead==true then
			del(sparks,spark)
		end
	end)

	foreach (bullets, function(bullet)
		bullet.update(bullet)
		if collision(bullet,p1) and bullet.firedby!="p1" then
			del(bullets,bullet)
			add(sparks,spark(p1.pos.x, p1.pos.y))
			p1.hp-=1
			sfx(1)
		end
		if collision(bullet,p2) and bullet.firedby!="p2" then
			del(bullets,bullet)
			add(sparks,spark(p2.pos.x, p2.pos.y))
			p2.hp-=1
			sfx(1)
		end
		if checkwall(bullet) then
			del(bullets,bullet)
		end		
	end)
	
	if gameover then
		if btnp(4) then	
			music(-1)
			init_game()
			gameover=false
		else
			return
		end
	end

	if p1.hp<=0 then
		death_anim(p1)
		p1.frames={48,49,50,51,52,53}
		return
	end
	if p2.hp<=0 then
		death_anim(p2)
		p2.frames={54,55,56,57,58,59}
		return
	end
	
	if time()-set_timer>1 then
		timer-=1
		set_timer=time()
	end
	
	if timer<=0 then 
		if p1.hp>p2.hp then
			p2.hp=0
		elseif p1.hp<p2.hp then
			p1.hp=0
		else
			death_anim(p1)
			p1.frames={48,49,50,51,52,53}				
			death_anim(p2)
			p2.frames={54,55,56,57,58,59}
			draw=true					
		end
	end
	
	p1_control(p1)
	p2_control(p2)
	
end

function _draw()
	cls(0)
	if gameover then
		mapdraw(15,0)
		print("press z to battle",30,80,7)
		return
	end
	
	mapdraw(0,0)
	
	foreach (lights, function(light)
		spr(light.sprite,
			light.pos.x,light.pos.y)
		end)

	foreach (bullets, function(bullet)
		spr(bullet.sprite,
			bullet.pos.x,bullet.pos.y)
		end)
	
	spr(p1.sprite,p1.pos.x,p1.pos.y,
		1,1,p1.flipx)
		
	spr(p2.sprite,p2.pos.x,p2.pos.y,
		1,1,p2.flipx)
		
	foreach (sparks, function(spark)
		spr(spark.sprite,
			spark.pos.x,spark.pos.y)
	end)
		
	if (p1.dead) or (p2.dead) or (draw) then
		if p1.hp>p2.hp then
			print("player1 wins",40,2,12)
		elseif p2.hp>p1.hp then
			print("player2 wins",40,2,8)
		elseif draw then
			print("draw",56,2,6)
		end
	elseif timer>0 then
		print(timer,62,2,6)
	end
	
	print("p1",5,2,12)
	for i=1,p1.hp do
		print("\153",i*6+9,2,10)
	end
	
	print("p2",94,2,8)
	for i=1,p2.hp do
		print("\153",i*6+98,2,10)
	end
end

