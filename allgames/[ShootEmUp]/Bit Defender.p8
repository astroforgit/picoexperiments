pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
-- bit defender:
--   the game
function _init()
	_update=update_menu
	_draw=draw_menu

	timer=0
	timer_disp=0
	sec_tmr = 0
--	buff1_tmr=0
	
	score=0
	shld_cnt=6
	scan_cnt=3
	percent=0
	shake=0
	toolbar=1
	
	en_cnt=100
	en_live=0
	en_dead=0
	en_accel=1
	en_lost=0
	en_won=0
	
	enemies={}
	scans={}
	lasers={}
	bits={}
	dust={}
	
	p={x=60,y=107,dir=4,h=5,w=6,spd=1.5,
		draw=function(self)
			spr(1,self.x,self.y)
		end
	}
	
	bit_field()
end

function bit_field()
	bit_accel=8
	for i=1,3 do
		if i==1 then bit_make(300,8,8,16,i,21)
		elseif i==2 then bit_make(100,5,5,24,i,19)
		elseif i==3 then bit_make(50,6,6,24,i,17) end
	end
end

--function bit_make(n,x,y,br,i,c)
--	for j=1,n do
--		local b={bx=x*flr(rnd(br)),by=y*flr(rnd(br)),bz=i,spr=c+flr(rnd(2))}
--		add(bits,b)
--	end
--end

	-- Testing Print Bits
function bit_make(n,x,y,br,i,c)
	for j=1,n do
		if i == 3 then
			local b={bx=x*flr(rnd(br)),by=y*flr(rnd(br)),bz=i,spr=flr(rnd(2))}
			add(bits,b)
		else
			local b={bx=x*flr(rnd(br)),by=y*flr(rnd(br)),bz=i,spr=c+flr(rnd(2))}
			add(bits,b)
		end
	end
end
	----------------
function shoot()
	local l={spr=3,x=p.x+3,y=p.y,dx=0,dy=-1,}
	add(lasers,l)
end

function scan()
	local s={spr=32,x=p.x,y=p.y,r=0}
	add(scans,s)
	sfx(1)
	scan_cnt-=1
end

function add_enemies()  -- remove won, lost. Will be global
	local e={
		class=flr(rnd(4)),
		x=flr(rnd(119)),
		y=0,
		h=0,
		w=0,
		pts=1,
	}
	add(enemies,e)
end

function update_menu()
	if btn(5) and not btn5_prev then _update=update_game _draw=draw_game btn5_prev=true
	elseif not btn(5) and btn5_prev then btn5_prev=false end
end

function do_shake()
	local shakex=4-rnd(8)
	local shakey=4-rnd(8)
	
	shakex*=shake
	shakey*=shake
	
	camera(shakex,shakey)
	
	shake=shake*0.75
	if (shake<0.05) shake=0
end

function update_game()
	if shld_cnt <= 0 then _update=update_endlose _draw=draw_endlose end
	if percent >= 100 then _update=update_endwin _draw=draw_endwin end
	

	-- Second Counter
	timer+=1
	timer_disp+=1
	if timer > 30 then sec_tmr+=1 timer=0 end
	
	-- Spawn Enemies (Needs to be changed)	
	if timer == 30 or timer == 60 then
		if en_live < en_cnt then
			add_enemies()
			en_live+=1
		end
	end
	
	for b in all(bits) do b.by+=b.bz*bit_accel/10
		if b.by>128 then
			b.by=0
			b.bx=5*flr(rnd(24))
		end
	end
	
	for l in all(lasers) do
		l.x+=l.dx
		l.y+=l.dy
		if l.y < 0 then del(lasers,l) end
	end
	
	for s in all(scans) do s.r+=4
		if s.r == 4 then shake+=1 end
		if s.r > 150 then del(scans,s) end
	end
	
	for e in all(enemies) do
		e.y+=en_accel
		dx1=p.x-e.x
		dx2=p.x-(e.x+e.w)
		dy1=p.y-e.y
		dy2=p.y-(e.y+e.h)
		
		dist1=sqrt((dx1*dx1)+(dy1*dy1))
		dist2=sqrt((dx2*dx2)+(dy2*dy2))
		
		if e.class == 0 then e.h=5 e.w=7 end
		if e.class == 1 then e.h=7 e.w=7 end
		if e.class == 2 then e.h=7 e.w=7 end
		if e.class == 3 then e.h=5 e.w=5 end
		if 	(p.x >= e.x and p.x <= e.x+e.w and
			p.y >= e.y and p.y <= e.y+e.h) or
			(p.x+p.w >= e.x and p.x+p.w <= e.x+e.w and
			p.y+p.h >= e.y and p.y+p.h <= e.y+e.h) or
			(p.x+p.w >= e.x and p.x+p.w <= e.x+e.w and
			p.y >= e.y and p.y <= e.y+e.h) or
			(p.x >= e.x and p.x <= e.x+e.w and
			p.y+p.h >= e.y and p.y+p.h <= e.y+e.h) then
				en_lost+=1
				en_dead+=1
				add_new_dust(e.x+4,e.y+4,rnd(2)-1,rnd(2)-3,15,rnd(6)+2,0.3,11)
				sfx(03)
				shld_cnt-=1
				score+=e.pts
				del(enemies,e)
		end
		
		for s in all(scans) do
			 if dist1 <= s.r or dist2 <= s.r then
				en_lost+=1
				en_dead+=1
				add_new_dust(e.x+4,e.y+4,rnd(2)-1,rnd(2)-3,15,rnd(6)+2,0.3,11)
				sfx(03)
				score+=e.pts
				del(enemies,e)
			end
		end
		
		if e.y >= 113 then
			en_won+=1
			en_dead+=1
			sfx(02)
			add_new_dust(e.x+4,e.y+4,rnd(2)-1,rnd(2)-3,15,rnd(6)+2,0.3,8)
			score-=e.pts
			del(enemies,e)
		end
		
		for l in all(lasers) do
			if 	l.x >= e.x and l.x <= e.x+e.w and
				l.y >= e.y and l.y <= e.y+e.h then
			add_new_dust(e.x+4,e.y+4,rnd(2)-1,rnd(2)-3,15,rnd(6)+2,0.3,11)
			en_lost+=1
			en_dead+=1
			sfx(03)
			score+=e.pts
			del(enemies,e)
			del(lasers,l)
			end
		end
	end
	
	-- Update dust particles
	for d in all(dust) do d:update() end

	-- Player input
	if btn(0) and p.x > 0 then p.x-=p.spd end
	if btn(1) and p.x < 121 then p.x+=p.spd end
	if not btn(0) and not btn(1) and not btn(2) and not btn(3) then p.dir=4 end
	if btn(4) and scan_cnt > 0 and not btn4_prev then scan() btn4_prev=true
		elseif not btn(4) and btn4_prev then btn4_prev=false end
		
	if btn(5) and not btn5_prev then
		if #lasers < 6 then sfx(00) shoot() end
		btn5_prev=true
	elseif not btn(5) and btn5_prev then btn5_prev=false end
	
	if btn(2) then toolbar = 2 end
	if btn(3) then toolbar = 1 end
		
		
	-- TESTING BUFFS--
--	if btnp(2) then bufftest() end
--	if sec_tmr <= buff1_tmr then
--		for b in all(bits) do bit_accel=4 end
--		for e in all(enemies) do en_accel=0.5 end
--	else
--		for b in all(bits) do bit_accel=8 end
--		for e in all(enemies) do en_accel=1 end
--	end
	----------------------
end

function update_endlose()
	if btn(5) and not btn5_prev then _init() btn5_prev=true
	elseif not btn(5) and btn5_prev then btn5_prev=false end
end

function update_endwin()
	if btn(5) and not btn5_prev then _init() btn5_prev=true
	elseif not btn(5) and btn5_prev then btn5_prev=false end
end

--function bufftest()
--	buff1_tmr=sec_tmr+5
--end

function draw_menu()
	cls()
	print("bit defender: the game",20,20,7)
	print("PRESS — TO START",30,30,7)
	print("cONTROLS:",40,60,7)
	print(" —  sHOOT\n Ž  sCAN\n\139\145 mOVEMENT\n\148\131 sCROLL TOOLBAR",20,70,7)
	print("n3RD dESIGN sTUDIO",55,122,7)
end

function draw_game()
	cls()
	
	for b in all(bits) do 
		if b.bz == 3 then
			print(b.spr,b.bx,b.by,11) -- text test
		else
			spr(b.spr,b.bx,b.by)
		end
	end
--	for b in all(bits) do spr(b.spr,b.bx,b.by) end
	for l in all(lasers) do spr(l.spr,l.x,l.y) end
	for s in all(scans) do circ(s.x+3,s.y+3,s.r,12) end
	
	do_shake()
	
	for e in all(enemies) do
		if e.class == 0 then spr(43,e.x,e.y) end
		if e.class == 1 then spr(59,e.x,e.y) end
		if e.class == 2 then spr(27,e.x,e.y) end
		if e.class == 3 then spr(11,e.x,e.y) end
	end
	
	-- Draw dust particles
	for d in all(dust) do d:draw() end
	
	p:draw()
	
	if  toolbar == 1 then draw_toolbar1()
	else draw_toolbar2() end
	
	--Debug
	--print(sec_tmr,0,0,7)
	print(percent,0,0,7)
end

function draw_endlose()
	cls()
	rectfill(0,0,127,127,12)
	print("\151",120,1,7)
	print("flagrant system error",20,50,7)
	print("cOMPUTER oVER.",35,70,7)
	print("vIRUS = vERY yES.",30,77,7)
	
end

function draw_endwin()
	cls()
	rectfill(0,0,127,127,0)
	rectfill(20,30,107,97,6)
	line(21,30,107,30,7)
	line(107,30,107,96,7)
	line(20,31,20,97,5)
	line(20,97,106,97,5)
	
	print("\151",100,31,5)
	print("scan results:",22,32,0)
	print("\143 qUARANTINES fILES:",22,45,7)
	print("          "..en_lost,22,52,0)
	print("\143 cORRUPTED fILES:",22,60,0)
	print("          "..en_won,22,67,0)
	print("\143 oVERALL sCORE:",22,75,0)
	print("          "..score,22,82,0)
end
	
function draw_toolbar1()
	-- Toolbar Background	
	rectfill(0,113,127,127,6)
	line(1,113,127,113,7)
	line(127,113,127,126,7)
	line(0,127,126,127,5)
	line(0,114,0,127,5)
	--print("SCORES",52,117,5)
	--spr(5,121,114)
	print("\148",120,114,0)
	print("\131",120,122,13)
	
	-- Scan in Progress
	if sec_tmr%2 == 0 then print("scanning...",3,115,1)
	else print("scanning..",3,115,11) end
	
	-- Completion Percentage
	percent=flr((en_dead/en_cnt)*100)
	if percent < 100 then
		print(timer_disp.."/3300 fILES ("..percent.."%)", 3, 121, 0)
	else
		print("3300/3300 fILES ("..percent.."%)",3,121,0)
	end

	-- Shield Sprites
	--print("shld",60,115,0)
	if shld_cnt == 6 then spr(2, 83, 115) else spr(4, 83,115) end
	if shld_cnt >= 5 then spr(2, 89, 115) else spr(4, 89, 115) end
	if shld_cnt >= 4 then spr(2, 95, 115) else spr(4, 95, 115) end
	if shld_cnt >= 3 then spr(2, 101, 115) else spr(4, 101, 115) end
	if shld_cnt >= 2 then spr(2, 107, 115) else spr(4, 107, 115) end
	if shld_cnt >= 1 then spr(2, 113, 115) else spr(4, 113, 115) end
	
	-- Deep Scan UI
	print("scan:"..scan_cnt, 95, 121)
end

function draw_toolbar2()
	-- Toolbar Background	
	rectfill(0,113,127,127,6)
	line(1,113,127,113,7)
	line(127,113,127,126,7)
	line(0,127,126,127,5)
	line(0,114,0,127,5)
	--print("STATUS",52,118,5)
	--spr(5,61,119,1,1,false,true)
	print("\148",120,114,13)
	print("\131",120,122,0)
	
	spr(48,2,115)
	print(en_lost,11,116,0)
	spr(49,25,116)
	print(en_won,32,116,0)
	
	print("score:"..score,60,116,0)

end

function add_new_dust(_x,_y,_dx,_dy,_l,_s,_g,_f)
	add(dust, {
			fade=_f,
			x=_x,
			y=_y,
			dx=_dx,
			dy=_dy,
			life=_l,
			orig_life=_l,
			rad=_s,
			col=0,
			grav=_g,
			draw=function(self)
				pal()
				palt()
				circfill(self.x,self.y,self.rad,self.col)
			end,
			update=function(self)
				self.x+=self.dx
				self.y+=self.dy
				self.dy+=self.grav
				self.rad*=0.9
				self.life-=1
				if type(self.fade)=="table"then
					self.col=self.fade[flr(#self.fade*(self.life/self.orig_life))+1]
				else 
					self.col=self.fade
				end
				if self.life<0then
					del(dust,self)
				end
			end
		}
	)
end

