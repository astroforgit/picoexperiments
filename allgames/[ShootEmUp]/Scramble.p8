pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
--scramble
--minionsoft 2020 (konami 1981)
function _init()
 cartdata("scamble_minionsoft_2020")
	hiscores={}
	hiscore=0
--	reset_hiscore()
	load_hiscore()

	clr={{136,12},{140,10},{2,8},{11,8},{136,10},{8,12},{8,2}}
	clrs=1
	titles={" 1st"," 2nd"," 3rd"," 4th"," 5th"," 6th"," 7th"," 8th"," 9th","10th"}
	score=0
	hipos=0
	stars={}
	stars_setup()
	areas={0,335,556,780,1116,1339,1402,1394}
	_mx=752
	_mx=1240-32
	_my=0
	_mz=32
	cnt=0	

	title_x=1
	title_y=1
	title_z=1
	title_state=1
	title_cnt=0
	gamestate="title"
--gamestate="game"

end

function new_game()
--begin game
	clrs=1

	score=0
	lives=3
	area=1
	
	music(0)
	new_life()

end

function new_life()
-- new life
	fuel=80
	dead=false
	dead_cnt=0	
	eol=false
	
	parts={}
	shots={}
	missiles={}
	objs={}
	bonus={}
	
	_mx=areas[area]-32
	_my=0
	_mz=32
	cnt=0
	
	player:reset()

	play_bg()
end



function slow(n)
	for n=1,n do
		flip()
	end
end

function add_score(n,x,y)
	if n==1 then score+=5 end
	if n==2 then score+=8 end
	if n==3 then 
		score+=15
		fuel+=10
		if fuel>=80 then fuel=80 end
 end
	if n==4 then 
		r=flr(rnd(3))+1
		score+=(10*r)
		add_bonus(x,y,r)
 end
	if n==5 then 
		score+=80
		eol=true
 end
	if n==6 then 
		score+=10
 end
 if n==99 then
		score+=1
	end
end
	
function _update()
//slow(5)
	if gamestate=="title" then
		update_title()
	elseif gamestate=="game" then
		if dead==true then
			update_dead()
		end
		update_game()
	elseif gamestate=="gameover" then
		update_gameover()
	elseif gamestate=="eol" then
		update_eol()
	end

end

function _draw()

	if gamestate=="title" then
		draw_title()
	elseif gamestate=="game" then
		draw_game()
	elseif gamestate=="gameover" then
		draw_gameover()
	elseif gamestate=="eol" then
		draw_eol()
	end
	
end


function update_gameover()
 stars_update()
 gameover_cnt-=1
 if gameover_cnt<=0 then
 	hiscore_pos()
 	gamestate="title"
 	kill_bg()
 	title_x=1
		title_y=1
		title_z=1
		title_state=3
		title_cnt=0		
 end
end

function draw_gameover()
	cls()
 stars_draw()
	print("game over",46,64,7)
	display_area()
	display_scores()
end

function update_eol()
 stars_update()
 eol_cnt-=1
 if eol_cnt<=0 then
 	gamestate="title"
		kill_bg()
		title_x=1
		title_y=1
		title_z=1
 end
end

function draw_eol()
	cls()
 stars_draw()
	cprint("congratulations",54,9)
	cprint("you completed your duties",64,10)
	cprint("good luck next time again",74,12)
	display_area()
	display_scores()
end

function play_bg()
	if area==2 then
		sfx(9,-2)
		sfx(7,1)
	else
		sfx(7,-2)
		sfx(9,1)
	end
end

function kill_bg()
	sfx(7,-2)
	sfx(9,-2)
end

function update_dead()
	dead_cnt+=1
	if dead_cnt<=20 then
		add_part(player.x+rnd(16)-4,player.y+rnd(12)-4,1)
		if dead_cnt%3==0 then sfx(4) end
	end
	if dead_cnt%4==0 then
		pal(14,rnd(12)+2,1)
		pal(13,rnd(12)+2,1)
	end
	if dead_cnt>=60 then
		lives-=1
  new_life()
  if lives==0 then 
  	gameover_cnt=60
  	gamestate="gameover" 
  end
	end
end

function update_game()
 stars_update()
 
 if (_mx%8==0) and _my==0 then
 	add_score(99,0,0)
 end
 
 if _mx>areas[7]-11 then
		if eol==true then
			gamestate="eol"
			eol_cnt=90
		end
	end

 if _mx>areas[area+1] then
		if area==6 then
			_mx-=56
		else
			area+=1
			play_bg()
		end
 end
 
--if _mx>0 then slow(30) end
	if dead==false then
		fuel-=0.1--05

		if fuel<=0 then fuel=0 end
		myd=1--0.75
		_my+=myd
		if _my>(4-myd) then 
			_my=0 
--			if _mz>0 then
				_mz-=1
--			else
				_mx+=1
--			end
		end
	end
	
	calc_map(_mx,_my)
	for itm in all(objs) do
		itm:update()
		if itm.alive==false then
			del(objs,itm)
		end
	end
	
	for itm in all(parts) do
		itm:calc()
		if itm.alive==false then
			del(parts,itm)
		end
	end

	for itm in all(bonus) do
		itm:calc()
		if itm.alive==false then
			del(bonus,itm)
		end
	end

	if dead==false then
		player:update()
	end

	for itm in all(shots) do
		itm:update()
		if itm.alive==false then
		 del(shots,itm)
		end
	end
	for itm in all(missiles) do
		itm:update()
		if itm.alive==false then
		 del(missiles,itm)
		end
	end
	
end

function chk(_x,_y,_c)
	xx=flr((_x+4+_my)/4)
	yy=_y//flr(_x-_my)/4
	
	if yy<top[xx] then
		return -1
	end
	if yy>bot[xx] then
		return 1
	end
	return 0
end



function draw_game()

	cls()

	clrs=(flr(_mx/64)%7)+1
	c1=clr[clrs][1]
	c2=clr[clrs][2]
	pal(14,c1,1)
	pal(13,c2,1)

	stars_draw()
	draw_map(_mx,_my)
	
	for itm in all(objs) do
		itm:draw()
	end

	player:draw()
	
	for itm in all(shots) do
		itm:draw()
		chk(itm.x,itm.y,8)
	end
	for itm in all(missiles) do
		itm:draw()
		//chk(itm.x,itm.y)
	end

	for itm in all(parts) do
		itm:draw()
	end

	for itm in all(bonus) do
		itm:draw()
	end

	display_area()
	display_scores()
end

function mapget(_x,_y)
	yy=0
	if _x<0 then _x=0 end
	while _x>=128 do
		_x-=128
		yy+=3
	end
	_y+=yy
	return mget(_x,_y)
end

function calc_map(_mm,_x)
	top={}
	bot={}
	for n=0,32 do
		mn=_mm+n

		if n<_mz then 
			mn=_mm+_mz-1
			mn1=mn
			mn2=mn
		else
			mn=_mm+n
			mn1=mn-1
			mn2=mn+1
		end

		mt=mapget(mn,0)
		mb=mapget(mn,1)
		mi=mapget(mn,2)

		top[n+1]=(mt+4)*4
		bot[n+1]=(37-mb)*4
		midway=bot[n+1]-top[n+1]

		if _x==0 and n==32 then
		 if (_mx%2)==0 then
			 if mi==1 or mi==2 or mi==4 or mi==8 or mi==16 or mi==32 then
					m=39-mb
					x=(32*4)+1
					if mi==1 then add_obj(x,(m-4)*4,1) end
					if mi==2 then add_obj(x,(m-4)*4,3) end
					if mi==4 then add_obj(x,(m-4)*4,4) end
					if mi==8 then add_obj(x,(m-4)*4,5) end
				end
			else
				if _mx>areas[2]-32 and _mx<areas[3]-48 then
					if _mx%12==1 then
						md=bot[n+1]-(midway/2)-4
						add_obj(129,md,6)
					end
				end
				if _mx>areas[3]-48 and _mx<areas[4]-48 then
					if _mx%4==1 then
						md=bot[n+1]-(midway/2)-4
						md=rnd(68)+16
						//md=76+16
						add_obj(129,md,7)
					end
				end
			end
		end
			
	end
end		

function draw_map(_mm,_x)

	mx=_mm-_mz
	for n=0,32 do
	
		if n<_mz then 
			mn=_mm+_mz
			mn1=mn-1
			mn2=mn
		else
			mn=_mm+n
			mn1=mn-1
			mn2=mn+1
		end
		mnx=_mm+n	
--		if mn<mx then mn=_mm+31 end
--		if mn1<mx then mn1=_mm+31 end
--		if mn2<mx then mn2=_mm+31 end
		
		mto=mapget(mn1,0)
		mbo=mapget(mn1,1)

		mt=mapget(mn,0)
		mb=mapget(mn,1)
--		mi=mapget(mn,2)

		mtn=mapget(mn2,0)
		mbn=mapget(mn2,1)

		x=(n*4)-_x

		sp=63
		if mn>=784 then sp=73+((mnx)%2) end
		for m=1,mt,1 do
			spr(sp,x,(m+2)*4)
		end

		for m=37-mb,28,1 do
			spr(sp,x,(m+1)*4)
		end
		
		dy=0
		m=39-mb
		sp=63
		if mbo==mb and mb==mbn then sp=64 end
		if mbo>mb and mb<mbn then sp=96 end
		if mbo<mb and mb>mbn then sp=80 end
		if mbo<mb and mb<=mbn then sp=68 end
		if mbo>=mb and mb>mbn then sp=84 end

		if mbo>mb and mb==mbn then sp=64 end
		if mbo==mb and mb<mbn then sp=64 end

		dy=-2
		
		df=((mnx+1)*13)%4
		
		if mn>=areas[4]+4 then --784
		 sp=72
		 df=0 
		end

		spr(sp+df,x,(m+dy)*4)

		if (mn>areas[2] and mn<areas[3]) or (mn>areas[5] and mn<areas[6]) then
		else
   mt-=1
  end
		if (mn-1>areas[2] and mn-1<areas[3]) or (mn-1>areas[5] and mn-1<areas[6]) then
		else
   mto-=1
  end
		if (mn+1>areas[2] and mn+1<areas[3]) or (mn+1>areas[5] and mn+1<areas[6]) then
		else
   mtn-=1
  end
  
--		if (mn>areas[2] and mn<areas[3]) or (mn>areas[5] and mn<areas[6]) then
--			mt=mt
--			mto=mt-1
--		else
--			mt-=1
--			mto-=1
--			mtn-=1
--		end
		
		m=mt
		sp=63
		if mto==mt and mt==mtn then sp=64 end
		if mto>mt and mt<mtn then sp=96 end
		if mto<mt and mt>mtn then sp=80 end
		if mto<mt and mt<=mtn then sp=68 end
		if mto>=mt and mt>mtn then sp=84 end

		if mto>mt and mt==mtn then sp=64 end
		if mto==mt and mt<mtn then sp=64 end

		dy=-2
		
		df=((mnx+1)*13)%4
		
		if mn>=784 then
		 sp=72
		 df=0 
		end

--		spr(sp+df,x,(m+dy)*4)
	
		if m>=0 then
			spr(sp+df,x,(m+3)*4,0.5,0.5,false,true)
		end
--		else
--				spr(sp+df,x,(m+3)*4,0.5,0.5,false,true)
--		end
 
 end
end

function display_scores()
 print("score:"..pad(score,5).."0",0,0,6)
	print("hiscore:"..pad(hiscore,5).."0",72,0,6)
--print(pad(score,6),,6)
end


function	display_area()

	for m=1,6 do
		if area<m then
			spr(52,m*16,6,2,1)
		else
 		spr(54,m*16,6,2,1)
		end		
	end
	print("1st 2nd 3rd 4th 5th bse",18,6,8)
	print("fuel",32,122,10)
	for m=0,9 do
		spr(11,48+(m*8),122)
	end
	rectfill(48+fuel,122,128,128,00)

	for m=1,lives do
		spr(7,(m-1)*8,122)
	end
end

