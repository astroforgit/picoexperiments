--shots

function shot_add(_x,_y)
	s={
				alive=true,
				x=_x,
				y=_y,
				begin=true,
				
			 update=function(self)
			 	if self.alive==true then
			 		self.x+=2
			 		self:coll()
						--self:coll()
						if chk(self.x,self.y)!=0 then
			 			self.alive=false
			 			add_part(self.x,self.y,2)
						end
			 		if self.x>=112 then
			 			self.alive=false
			 		end
			 	end
			 end,			
			
				coll=function(self)
					if self.alive==true then
						for itm in all(objs) do
							if itm.alive==true then
		 					if collision(self.x,self.y,1,1,itm.x,itm.y,8,8) then
									self.alive=false
									if itm.typ!=7 then 
										itm.alive=false
										add_part(itm.x,itm.y,1)
										sfx(2)
										add_score(itm.typ,itm.x,itm.y)
									end
								end
							end
						end
					end
				end,
							
				draw=function(self)
					if self.alive==true then
--					 spr(16,self.x-1,self.y-1)
					 pset(self.x,self.y,9)
					end
				end
			}
			sfx(0)
			add(shots,s)
end
				
				
				
				
function miss_add(_x,_y)
	s={
				alive=true,
				x=_x,
				y=_y,
				cnt=0,
				begin=true,
				an=0,
				
			 update=function(self)
			  self.cnt+=1
			  self.an=1-self.an
			 	if self.alive==true then
			 		if self.cnt<=8 then
				 		self.x+=2
						elseif self.cnt>=16 then
				 		self.y+=1
				 	else
				 		self.x+=0.75
				 		self.y+=0.75
				 	end
						self:coll()
						if chk(self.x,self.y)!=0 then
			 			self.alive=false
			 			add_part(self.x,self.y,2)
						end
			 		if self.y>=112 then
			 			self.alive=false
			 		end
			 	end
			 end,			
			
				coll=function(self)
					if self.alive==true then
						for itm in all(objs) do
							if itm.alive==true then
								if self.alive==true then
									if itm.typ==1 or itm.typ==2 then sz=5 else sz=8 end
			 					if collision(self.x,self.y,3,3,itm.x,itm.y,sz,8) then
										self.alive=false
										if itm.typ!=7 then 
											itm.alive=false
											add_part(itm.x,itm.y,1)
											sfx(2)
 										add_score(itm.typ,itm.x,itm.y)
										end
									end
								end
							end
						end
					end
				end,
							
				draw=function(self)
					if self.alive==true then
--					 spr(16,self.x,self.y)
			 		if self.cnt<=8 then
					 sspr(8,8+(self.an*4),4,4,self.x,self.y)
						elseif self.cnt>=16 then
					 sspr(16,8+(self.an*4),4,4,self.x,self.y)
				 	else
					 sspr(12,8+(self.an*4),4,4,self.x,self.y)
				 	end
--					 sspr(8,8,4,4,self.x,self.y)
					end
				end
			}
			sfx(1)
			add(missiles,s)
end
								
				
				
				
				
				
-->8
function add_part(_x,_y,_t)
	local s={
		alive=true,
		x=_x,
		y=_y,
		typ=_t,
		anim=0,
	
		calc=function(self)
			if dead==false then
			 self.x-=1
			end
			if self.typ==1 then
				self.anim+=1
				if self.anim==12 then
					self.alive=false
				end
			end		
			if self.typ==2 then
				self.anim+=1
				if self.anim==4 then
					self.alive=false
				end
			end		
		end,

		draw=function(self)
			if self.alive==true then 
				if self.typ==1 then
					spr(31-self.anim,self.x,self.y)
				end
				if self.typ==2 then
					spr(48+self.anim,self.x-4,self.y-4)
				end
			end
		end
	
	}
	
	add(parts,s)
end
				
----------------------

function add_bonus(_x,_y,_t)
	local s={
		alive=true,
		x=_x,
		y=_y,
		typ=_t,
		flash_rt=8,
		flash_cnt=-10,
		flash=false,
	
		calc=function(self)
			if dead==false then
			 self.x-=1
			end
	
			if self.x<-8 then
			 self.alive=false
			end
		end,

		draw=function(self)
			if self.alive==true then 
				if self.typ==1 then
					spr(57,self.x,self.y)
				end
				if self.typ==2 then
					spr(58,self.x,self.y)
				end
				if self.typ==3 then
					spr(59,self.x,self.y)
				end
			end
		end
	
	}
	
	add(bonus,s)
end
				
					
	
