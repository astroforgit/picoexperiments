function dec(a)
	if a=="0" then return 0 end
	if a=="1" then return 1 end
	if a=="2" then return 2 end
	if a=="3" then return 3 end
	if a=="4" then return 4 end
	if a=="5" then return 5 end
	if a=="6" then return 6 end
	if a=="7" then return 7 end
	if a=="8" then return 8 end
	if a=="9" then return 9 end
	if a=="a" then return 10 end
	if a=="b" then return 11 end
	if a=="c" then return 12 end
	if a=="d" then return 13 end
	if a=="e" then return 14 end
	if a=="f" then return 15 end
	
	return 15

end


function reset_hiscore()
	for m=0,9 do
	 dset(m, 0)
	end
end

function save_hiscore()
	for m=0,9 do
	 dset(m, hiscores[m+1])
	end
end

function load_hiscore()
	for m=0,9 do
	 hiscores[m+1]=dget(m)
	end
	if hiscores[1]==0 then
			hiscores={200,190,180,170,160,150,140,130,120,110}
			save_hiscore()
	end
 hiscore = hiscores[1]
end

