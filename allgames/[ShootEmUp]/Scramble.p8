function collision(x1,y1,w1,h1,x2,y2,w2,h2)

	rectfill(x1,y1,x1+w1-1,y1+h1-1,12)
	rectfill(x2,y2,x2+w2-1,y2+h2-1,11)

	if x1+w1-1<x2 then return false end
	if x1>x2+w2-1 then return false end
	if y1+h1-1<y2 then return false end
	if y1>y2+h2-1 then return false end
	return true
end 


function pad(a,l)
	x=""
	x=tostr(a)		
	while #x<l do
		x="0"..x
	end
	return x
end
function bpad(a,l)
	x=""
	x=tostr(a)		
	while #x<l do
		x=" "..x
	end
	return x
end
			
function cprint(str,y,c)
  print(str, 64 - (#str * 2), y,c) 
end
