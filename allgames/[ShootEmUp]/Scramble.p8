--objects

function add_obj(_x,_y,_t)
	local s={
		alive=true,
		x=_x,
		y=_y,
		dx=1,
		dy=2,
		ddx=0,
		ddy=0,
		anm=0,
		
		typ=_t,

		update=function(self)
			if self.alive==true then
				if dead==false then
					self.x-=1
				end
				
				if self.x<-8 then
					self.alive=false
				end
				if self.typ==1 then
					if self.x<72 and self.x>48 then
						if rnd(100)>95 then
							self.typ=2
						end
					end
				end		
				if self.typ==2 then
					self.y-=1
				end	

				if self.typ==7 then
					self.x-=2
				end	

				if self.typ==6 then
					self.ddy+=self.dy
					self.ddx+=self.dx
					if self.ddy<-4 then 
						self.dy+=0.25//0.75 
					end
					if self.ddy>4 then
					 self.dy-=0.25//0.75 
					end
					
					if self.ddx<-1 then 
						self.dx+=0.25//0.75 
					end
					if self.ddx>1 then
					 self.dx-=0.25//0.75 
					end

self.x+=self.dx
self.y+=self.dy
				end
				
				self.anm+=1
				if self.anm>3 then 
				 self.anm=0
				end
					
			end
		end,

		draw=function(self)
			if self.alive==true then 
				if self.typ==1 then
					spr(32,self.x,self.y)
				end
				if self.typ==2 then
					spr(19,self.x+1,self.y+3+rnd(3))
					spr(32,self.x,self.y)
				end
				if self.typ==3 then
					spr(33,self.x,self.y)
				end
				if self.typ==4 then
					spr(34,self.x,self.y)
				end
				if self.typ==5 then
					spr(35,self.x,self.y)
				end
				if self.typ==6 then
--					spr(36+self.anm,self.x+self.ddx,self.y+self.ddy)
					spr(36+self.anm,self.x,self.y)
				end
				if self.typ==7 then
					spr(40+self.anm,self.x,self.y)
				end
			end
		end
	
	}
	
	add(objs,s)
end
				

-->8
--stars

function rnd_bool()
	if rnd(100)>50 then
		return true
	else
		return false
	end
end

function add_star(_x,_y)
	local s={
		x=_x,
		y=_y,
		col=rnd(12)+2,
		rate=rnd(20)+20,
		cnt=0,
		flash=rnd_bool(),
		
		update=function(self)
			self.cnt+=1
			if self.cnt>=self.rate then
				if self.flash==true then
					self.flash=false
				else
				 self.flash=true
				end
				self.cnt=0
			end
		end,
		
		draw=function(self)
			if self.flash==false then
				pset(self.x,self.y,self.col)
			end
		end
		
	}
	add(stars,s)
end

function stars_setup()
	for m=1,50 do
		add_star(rnd(128),rnd(104)+16)
	end
end

function stars_update()
	for itm in all (stars) do
		itm:update()
	end
end

function stars_draw()
	for itm in all (stars) do
		itm:draw()
	end
end



-->8
--titles

function hiscore_pos()
-- check score for hiscore table
-- shift scores down accordingly
-- add score to table and save pos
	hipos=99
	for m=1,10 do
		if score>=hiscores[m] then
	 	hipos=m
		 for n=9,m,-1 do
		 	hiscores[n+1]=hiscores[n]
	 	end
		 hiscores[m]=score
		 break
		end
	end
	hiscore = hiscores[1]
	save_hiscore()
end

function update_title()
	stars_update()
	title_cnt+=1
	if title_cnt==100 then
		title_cnt=0
		title_state+=1
		if title_state>3 then
			title_state=1
			title_x=1
			title_y=1
			title_z=1
		end
	end
	
	if btn(Ž) then 
		new_game()
		gamestate="game" 
	end
end

function draw_title()
 scrs={"   50  ","   80  ","  100  ","  150  ","  800  ","mystery",""}
	cls()
	stars_draw()

	if title_state==2 then
		cprint("- score table -",12,9)
		
		spr(32,17,30)
		spr(19,18,43+rnd(4))
		spr(32,17,42)
		spr(36,16,54)
		spr(33,16,66)
		spr(35,16,78)
		spr(34,16,90)
	
		for m=1,title_y-1 do	
			str="  ...  "..scrs[m].." pts"
			print(str,30,((m-1)*12)+30,7)
		end

		str="  ...  "..scrs[title_y].." pts"
		
		sts=sub(str,1,title_x)
		
		print(sts,30,((title_y-1)*12)+30,7)
		

		if (title_y!=7) then
			title_z+=1
			if title_z>2 then
				title_z=1
				title_x+=1
				if title_x>#str then
					title_x=1
					title_y+=1
				end
			end
			if title_cnt>20 then
				title_cnt=0
			end
		end
	
	end

	if title_state==3 then

		cprint("- score ranking -",12,9)
	
		for m=1,10 do
		 a_str=titles[m].."  "..bpad(hiscores[m],5).."0  pts"
			clur=2
			if m<7 then
				clur=12
			end
			if m<4 then
			 clur=10
			end
			if m<2 then
				clur=7
			end
			if hipos==m then
				if title_cnt%10<6 then
				 clur=7
				else
					clur=8
				end
		 end
			cprint(a_str,20+(m*8),clur)
		end
	end
	if title_state==1 then
	
		cprint("play",12,10)
//		spr(160,0,24,16,6)
		print_logo()
--		cprint("s c r a m b l e",40,9)
		cprint("how far can you invade",80,9)
		cprint("our scramble system ?",90,12)

	end
	
 if title_cnt%20<15 then 
		cprint("press Ž to play",110,7)
	end
	cprint("konami 1981  minionsoft 2020",122,7)
	display_scores()
end


