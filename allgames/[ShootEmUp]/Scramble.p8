--player

player={
	x=16,
	y=32,
	anm=0,
	fire=0,
	miss=0,
	
	chk_pnts={{1,2},{6,2},{9,3},{1,6},{6,6},{9,5},{11,3}},
	
 reset=function(self)
 	self.x=16
		self.y=32
		self.anm=0
		self.fire=0
		self.miss=0
	end,

	update=function(self)

		if	self.fire>0 then
			self.fire-=1
		end
		if	self.miss>0 then
			self.miss-=1
		end

		if fuel<=0 then
			self.y+=1
		end

		if btn(”) and self.y>16 and fuel>0 then
			self.y-=1
		end
		if btn(ƒ) and self.y<112 then
			self.y+=1
		end
		if btn(‹) and self.x>0 then
			self.x-=1
		end
		if btn(‘) and self.x<48 then
			self.x+=1
		end
		
		if btn(Ž) and self.fire==0 then
--		if self.fire==0 then
			self.fire=8
			shot_add(self.x+12,self.y+3)
		end
--		if self.miss==0 and self.miss==0 and #missiles<2 then
		if btn(—) and self.miss==0 and #missiles<2 then
			self.miss=9
			miss_add(self.x+4,self.y+5)
		end

	for m=1,#player.chk_pnts do
		if chk( self.x+self.chk_pnts[m][1] , self.y+self.chk_pnts[m][2] )!=0 then
			dead=true
			break
		end
	end

	ship_collision()

	end,
	
	draw=function(self)
		self.anm+=0.2
		if self.anm>=3 then
		 self.anm=0
	 end
	 r=rnd(3)
	 s=rnd(100)
	 if s>50 then
	 	s=true
	 	xd=1
	 else
	 	s=false
	 	xd=0
	 end

		if dead==false then
			spr(13+r,self.x-7,self.y-xd,1,1,false,s)
			spr(1+(flr(self.anm)*2),self.x,self.y,2,1)
		end
	end
}



function ship_collision()

col=false
for itm in all(objs) do
	
	if itm.typ==1 or itm.typ==2 then
		col=collision(player.x+1,player.y+1,10,5,itm.x+1,itm.y+1,3,6)
	end
	if itm.typ==3 or itm.typ==4 or itm.typ==5 then
		col=collision(player.x+1,player.y+1,10,5,itm.x+1,itm.y+1,6,6)
	end
	if itm.typ==6 then
		col=collision(player.x+1,player.y+1,10,5,itm.x+1,itm.y+3,6,3)
	end
	if itm.typ==7 then
		col=collision(player.x+1,player.y+1,10,5,itm.x+1,itm.y+2,6,3)
	end
	
	if col==true then
		dead=true
		break
	end
end
end

