pico-8 cartridge // http://www.pico-8.com
version 14
__lua__
daynumber="17"
::_::
if (btnp()>0) goto donewithintro
cls()
f=4-abs(t()-4)
for z=-3,3 do
 for x=-1,1 do
  for y=-1,1 do
   b=mid(f-rnd(.5),0,1)
   b=3*b*b-2*b*b*b
   a=atan2(x,y)-.25
   c=8+(a*8)%8
   if (x==0 and y==0) c=7
   u=64.5+(x*13)+z
   v=64.5+(y*13)+z
   w=8.5*b-abs(x)*5
   h=8.5*b-abs(y)*5
   if (w>.5) rectfill(u-w,v-h,u+w,v+h,c) rect(u-w,v-h,u+w,v+h,c-1)
  end
 end
end
 
if rnd()<f-.5 then
 ?daynumber,69-#daynumber*2,65,2
end
 
if f>=1 then
 for j=0,1 do
  for i=1,f*50-50 do
   x=cos(i/50)
   y=sin(i/25)-abs(x)*(.5+sin(t()))
   circfill(65+x*8,48+y*3-j,1,2+j*6)
  end
 end
 
 for i=1,20 do
  ?sub("pico-8 advent calendar",i),17+i*4,90,mid(-1-i/20+f,0,1)*7
 end
end
 
if (t()==8) goto donewithintro
 
flip()
goto _
::donewithintro::

state={}
p={}
lasers={}
glt={}
cam={}
land={}
noisesrc={}
aliens={}
expl={}
lives=4
wave=1
max_lives=4
score=0
disp_score=0
hiscore=0
got_hi=false
gifts={}
points={}
flash=0
flashc=0
mute=false
snow={}
t=0
hyper=false
hypert=0
scroll={}
play_top=19
wave_msg=nil
wave_msgs={
	"hold onto your hat",
 "not exactly a silent night",
 "follow that star",
 "jingle bells, jingle bells",
 "a man of great presents",
 "keep the receipt",
 "did you deck the halls?",
 "long as you've got your elf"
}

function printc(s,y,c)
	x=64-(#s*0.5)*4-1
	print(s,x,y,c)
end

function _init()
	state.t=0

 for i=0,256-1 do
  noisesrc[i]=rnd(2)-1
	end

	gen_snow()
	gen_land()

	show_titles()
end

function _update60()
 if (state.t>0) state.t-=1
 state.upd()
 t+=1
end

function show_titles()
 play_top=-20
	cam.x=128*5
	cam.y=64
	state.upd=upd_titles
	state.draw=draw_titles
	scroll.x=128
	scroll.text="christmas eve ... santa's unknown annual battle against the inexplicable present-stealing aliens begins once more ..."
	music(6)
end

function flash_screen(c,ttl)
	flash=ttl
	flashc=c
end

function hit(a,b)
 return (a.x>b.x-a.w and a.x<b.x+b.w and a.y>b.y-a.h and a.y<b.y+b.h)
end

function ssfx(n)
 if (not mute)	sfx(n)
end

function laser_hitbox(l)
	lb={}
	lb.x=min(l.x,l.x-l.vx*2)
	lb.y=l.y-1
	lb.w=abs(l.vx*2)
	lb.h=4
	return lb
end

function add_point(x,y,s)
	local pt={}
	pt.x=x
	pt.y=y
	pt.s=s
	pt.ttl=40
	add(points,pt)
end

function inc_score(v)
	score+=v
	if score>hiscore then
		got_hi=true
		hiscore=score
	end
end

function kill(a,win)
	ssfx(2)
	del(aliens,a)
	local e={x=a.x,y=a.y,ttl=30}
	add(expl,e)
	for i=1,20 do
		gx=a.x+cos(rnd())*4
		gy=a.y+sin(rnd())*4
		g=glitter(gx,gy,7)
		g.vx*=2
	end

	if (win) then
		inc_score(100)
		add_point(a.x,a.y-5,12)
	end
	
	if a.targ then
		g=a.targ
		if g.owner==a then
			g.owner=nil
		 g.upd=gift_fall
	 	g.vy=0
	 	ssfx(9)
	 end
	end
end

function blow_gift(g)
	local e={x=g.x,y=g.y,ttl=30}
	add(expl,e)
	del(gifts,g)
	if g.owner then
		g.owner.targ=nil
		g.owner.upd=alien_drift
	end
	ssfx(2)
end

function gift_fall(g,i)
	g.y+=g.vy
	g.vy+=0.02
	if (g.vy>0.5) g.vy=0.5
	
	for i=1,3 do
		gl=glitter(g.x,g.y,7)
		gl.vx=rnd(3)-1
		gl.vy=0
	end
	
	if g.y>128-land_height(flr(g.x/5))+8 then
		blow_gift(g)
	end
end

function upd_snow()
	for s in all(snow) do
		s.y+=0.3
		s.x+=sin(s.y*0.1)*0.8
		if (s.y>128) s.y=play_top
	end
end

function upd_expl()
	for e in all(expl) do
		e.ttl-=1.5
		if e.ttl==0 then
			del(expl,e)
		end
	end
end

function upd_point(pt)
	pt.y-=0.2
	pt.x+=sin(t*0.05)*0.2
	wrap(pt)

	pt.ttl-=1
	if pt.ttl==0 then
		del(points,pt)
	end
end

function dead(p)
	state.upd=upd_dead
	state.t=100
	p.dead=true
	flashc=8
	flash=10

	ssfx(2)
	local e={x=p.x,y=p.y,ttl=30}
	add(expl,e)
	for i=1,20 do
		gx=p.x+cos(rnd())*4
		gy=p.y+sin(rnd())*4
		g=glitter(gx,gy,7)
		g.vx*=2
	end

	for g in all(gifts) do
		if g.owner==p then
			g.owner=nil
		 g.upd=gift_fall		 
	 	g.vy=0
	 	ssfx(9)
	 end
	end

	if lives==1 then
		music(-1,1000)
		mute=true
	end
end

function upd_new_wave()
	if state.t==0 then
		new_wave()
	else
		upd_game()
	end
end

function upd_wave_done()
	if state.t==0 then
		start_new_wave()
	else	 	
 	if (score>disp_score and state.t%6==0) sfx(10)

		upd_game()
	end
end

function upd_gameover()
	if state.t==0 then
		show_titles()
	else
		upd_game()
	end
end

function upd_dead()
	if state.t==0 then
		lives-=1
		if lives==0 then
			state.t=200
			state.upd=upd_gameover
			state.draw=draw_gameover
			music(5)

		else
 		p.dead=false
 		state.upd=upd_game
 		p.x=0
 		p.y=64
 		p.vx=0
 		p.vy=0
 		p.hohoho=0
 		p.inv=100
 	end
	end
	upd_game()
end

function upd_titles()
 local inc=sin(t*0.001)*10
 if (abs(inc)>1) inc=sgn(inc) 
	cam.x+=inc
	upd_snow()
	
	scroll.x-=0.6
	if scroll.x<-#scroll.text*5 then
		scroll.x=128
	end
	
	if (btnp(5)) then
		state.t=100
		state.upd=upd_start_game
		state.draw=draw_start_game
		music(-1,1000)
	end
end

function upd_start_game()
	if (state.t==0) then
		new_game()
	end
	if (play_top<19) play_top+=0.5
	upd_snow()
end

function upd_game()
	if (disp_score<score) disp_score+=5

	upd_player(p)
	
	cam.x=p.x+p.vx*15

	for l in all(lasers) do
		upd_laser(l)
		local did_hit=false
		local lb=laser_hitbox(l)
		
		for a in all(aliens) do
			if hit(lb,a) then
				kill(a,true)
				del(lasers,l)
				did_hit=true
				break
			end
		end

		if not did_hit then
			for g in all(gifts) do
				if hit(lb,g) then
					blow_gift(g)
					del(lasers,l)
					break
				end
			end
		end
	end

	for g in all(glt) do
		upd_glitter(g)
	end

	for pt in all(points) do
		upd_point(pt)
	end
		
	i=0
	hp={x=p.x+4,y=p.y+2,w=8,h=4}
	for a in all(aliens) do
 	if (t%10==0) a.so=1-a.so
		a.upd(a,i)
		
		if not p.dead and p.inv==0 and hit(a,hp) then
			dead(p)
			kill(a,false)
		end
		
		i+=1
	end

	i=0
	for g in all(gifts) do
		if (g.upd) g.upd(g,i)
		if g.vy!=0 and not p.dead and hit(p,g) then
			g.owner=p
			g.upd=gift_owned
			ssfx(8)
		end
		i+=1
	end
	
	upd_expl()
	upd_snow()
	
	if #aliens==0 then
		wave_done()
	end
	
	if not hyper and #gifts==0 then
		hyperspace()
	end
	
	if hypert>0 then
		hypert-=1

		if hypert%10==0 then
			flash_screen(15-flr(hypert/10),2)
	 end
	end
end

function hyperspace()
	ssfx(7)
	for a in all(aliens) do
		berserker(a)
		hyper=true
	end
	hypert=100
end

function alien_drift(a,id)
	a.x+=a.vx
	a.y+=a.vy+sin((t+id)/60)*0.3
	wrap(a)
	if (a.y<play_top or a.y>90) a.vy*=-1
	if (t%20<10) glitter(a.x+4,a.y+4,11)
	
	-- find a target
	for g in all(gifts) do
		if g.owner==nil then
 		dx=(g.x-a.x)
 		dy=(g.y-a.y)
 		if len(dx,dy)<30 then
 			a.targ=g
 			a.upd=alien_steal
 			break
 		end
 	end
	end
end

function head_to(a,b,spd)
	local dx=b.x-a.x
	local dy=b.y-a.y
 local l=len(dx,dy)
	a.x+=(dx*spd)/l
	a.y+=(dy*spd)/l
	return l
end

function alien_steal(a,i)
	local l=head_to(a,a.targ,0.4)
	
	if (l<8) then
		a.upd=alien_run
 	a.targ.upd=gift_owned
		a.targ.owner=a
	end
end

function berserker(a)
	a.s=50
	a.c=14
	a.upd=alien_berserk
	del(gifts,a.targ)
	a.targ=nil
end

function alien_run(a,i)
	a.y-=0.15
	
	if (a.y<play_top) then
		berserker(a)
		flash_screen(14,2)
		ssfx(3)
	end
end

function alien_berserk(a,i)
	head_to(a,p,0.5)
	a.x+=cos((t+i)/10)
	a.y+=sin((t+i)/10)
end

function len(x,y)
 x*=0.1
 y*=0.1
	return sqrt(x*x+y*y)*10
end

function gift_owned(g,i)
 o=g.owner
	g.x=o.x+(o.w-8)*0.5
	g.y=o.y+7
	g.vy=0
	
	if (o==p) then
	 ly=128-land_height(flr(g.x/5))
	 if (g.y>ly+8) then
	 	g.owner=nil
	  g.upd=gift_safe
	  ssfx(5)
	  p.hohoho=80
	 end
	end
end

function gift_safe(g,i)
	g.x-=0.05
	
	gx=g.x+4
	y1=132-land_height(flr(gx/5)+1)
	y2=132-land_height(flr(gx/5))
	d=(5-gx%5)/5
	g.y=y1+(y2-y1)*d
	
	wrap(g)
end

function glitter(x,y,c)
	local g={}
	g.x=x
	g.y=y
	g.vx=(1-rnd(3))*0.5
	g.vy=0.2+rnd(0.5)
	g.ttl=flr(rnd(30))+1
	g.c=c
	wrap(g)
	add(glt,g)
	return g
end

function shoot(p)
	local l={}
	pf=(p.facing+1)*0.5
	l.x=p.x+16*pf
	l.y=p.y+3
	l.vx=p.facing*12
	l.ttl=7
	add(lasers,l)
	p.lt=20
	
	for i=1,20 do
		g=glitter(l.x,l.y,10)
		g.vx=p.facing*(rnd(1)+0.5)
		g.vy=rnd(2)-1
	end
	
	ssfx(0)
	ssfx(1)
end

function upd_glitter(g)
	g.x+=g.vx
	g.y+=g.vy
	wrap(g)
	g.vx*=0.9
	g.ttl-=1
	if (g.ttl<0) del(glt,g)
end

function upd_laser(l)
	l.x+=l.vx	
	l.ttl-=1
	if (l.ttl<0) del(lasers,l)
	for i=1,2 do
		gx=l.x-rnd(abs(l.vx))
		glitter(gx,l.y,7)
	end
end

function upd_player(p)
	if (p.dead) return
	if (p.inv>0) p.inv-=1

	if state.upd==upd_game then
 	if (p.lt>0) p.lt-=1
 	if (btn(4) and p.lt==0) then
 		shoot(p)		
 	end
 
 	if (btn(0)) then
 		p.vx-=0.1
 		p.facing=-1
 	end
 	if (btn(1)) then
 		p.vx+=0.1
 		p.facing=1
 	end
 	if (p.vx>2) p.vx=2
 	if (p.vx<-2) p.vx=-2
 	
 	if (btn(2)) p.vy-=0.6
 	if (btn(3)) p.vy+=0.6
 end

	if (p.vy>1) p.vy=1
	if (p.vy<-1) p.vy=-1
	
	p.x+=p.vx
	p.y+=p.vy

	if p.y>120 then
		p.y=120
		p.vy*=-1
	elseif p.y<20 then
		p.y=20
		p.vy*=-1
	end

	wrap(p)
	
	p.vx*=0.95
	p.vy*=0.95
	
	if (abs(p.vy)<=0.1) then
		p.vy=0
		p.y+=sin(t/70)*0.25
	end

	if (t%20<10) glitter(p.x,p.y+4,7)
end

function wrap(t)
	if (t.x<0) t.x+=256*5
	if (t.x>256*5) t.x-=256*5
end

function new_game()
	play_top=19

	mute=false
 music(0,1000,3)

	state.upd=upd_game
	state.draw=draw_game

	lives=4
	score=0
	disp_score=0
	wave=0
	got_hi=false

	p.x=cam.x
	p.y=64
	p.vx=0
	p.vy=0
	p.facing=1
	p.lt=0
	p.w=16
	p.h=8
	p.hohoho=0
	p.dead=false
	p.inv=100
	
	cam.x=p.x
	cam.y=p.y
	
	gen_land()
	hyper=false

	new_gifts()
	new_wave()
end

function new_gifts()
 gifts={}	
	gc=5
	x=0
	w=256*5/gc
	for i=1,gc do
		add_gift(x+flr(rnd(w)))
		x+=w
	end
end

function wave_done()
 if (p.dead) return
 if (state.upd!=upd_game) return
	state.t=150
	state.upd=upd_wave_done
	state.draw=draw_wave_done
	inc_score(#gifts*50)
	sfx(20)
end

function start_new_wave()
 if (state.upd==upd_new_wave) return
	state.t=150
	state.upd=upd_new_wave
	state.draw=draw_new_wave
	wave_msg=wave_msgs[flr(rnd(#wave_msgs))+1]
end

function new_wave()
	wave+=1
	ac=6+wave*2
	
 ssfx(6)

	if #gifts==0 then
		new_gifts()
	elseif #gifts<5 then
		add_gift(flr(rnd(256/5)))
 end
	
	hyper=false
	hypert=0
	p.inv=100

	aliens={}
	x=0
	w=256*5/ac
	for i=1,ac do
		add_alien(x+flr(rnd(w)))
		x+=w
	end

	state.upd=upd_game
	state.draw=draw_game
end

function gen_snow()
	local x=0
	local w=256*5/80
	for i=1,80 do
		local s={}
		s.x=x+flr(rnd(w))
		s.y=flr(rnd(100))
		s.d=rnd(0.5)+1
		add(snow,s)
		x+=w
	end
end

function add_alien(x)
	local a={}
	a.x=x
	a.y=flr(rnd(10))+play_top
	a.s=48
 a.so=0
	a.c=11
	a.upd=alien_drift
	a.w=8
	a.h=8
	a.vx=(rnd(2)-1)*0.6
	a.vy=0.1
	add(aliens,a)
end

function add_gift(x)
 local g={}
 g.x=x
 g.y=128-land_height(flr(x/5))
 g.vy=0
 g.w=8
 g.h=8
 g.upd=gift_safe
 add(gifts,g)
end

function gen_land()
	land={}
	for i=0,255 do
		land[i]=(noise(i/5)+noise(i/10)+noise(i/20))*40+30
		if (land[i]<14) land[i]=14
	end
end

function land_height(x)
 if (x<0) x+=256
	return land[x%256]
end

function noise(x)
  local lo = flr(x)
  local hi = lo+1
  local dist = x-lo
  local loslope = noisesrc[lo%256]
  local hislope = noisesrc[hi%256]
  local lopos = loslope * dist
  local hipos = -hislope * (1-dist)
  local u = dist * dist * (3.0 - 2.0 * dist)
  return (lopos*(1-u)) + (hipos*u)
end

function _draw()
	cls()
	state.draw()
end

function radar()
	w=80
	h=15
	left=24
	top=play_top-15
	
	sw=(128/(256*5))*w
	rect(left-1,top-1,left+w+1,top+h+1,13)
	rect(64-sw*0.5,top-1,64+sw*0.5,top+h+1,7)
	rectfill(left,top,left+w,top+h,0)

	rectfill(64-sw*0.5,top,64+sw*0.5,top+h,1)

	if not hyper then
		local sc=h/128
 	local start=flr(p.x/5)-128
 	if (start<0) start+=256
 	local li=flr(start/3)*3
 	local y=h-flr(land_height(li)+0.5)*sc
 	x=left
 	for i=1,256,3 do
 		li+=3
 		if (li>256) li=1
 		nx=(i/256)*w+left
 		ny=h-flr(land_height(li)+0.5)*sc
 		line(x,top+y,nx,top+ny,2)
 		x=nx
 		y=ny
 	end
 end
	
	for a in all(aliens) do
		ax=a.x-p.x
		rx=(ax/(256*5))*w+w/2
		if (rx<0) rx+=w
		if (rx>w) rx-=w
		ry=(a.y/128)*h
		pset(rx+left,ry+top,a.c)
	end

	for g in all(gifts) do
		gx=g.x-p.x
		rx=(gx/(256*5))*w+w/2
		if (rx<0) rx+=w
		if (rx>w) rx-=w
		ry=(g.y/128)*h
		pset(rx+left,ry+top,12)
	end

	ry=(p.y/128)*h	
	pset(64,ry+top,8)
end

function draw_score(x,val)
	ss=tostr(val)
	sp=5-#ss
	
	c=4+flr(((t*0.5)%12))
	print(ss,x+sp*2,play_top-14,c)
end

function draw_scroll()
	local x=scroll.x
	local y=80
	local c=1
	col=7
	while c<=#(scroll.text) do
		y=sin(t*0.01+c*0.03)*5+80
		chr=sub(scroll.text,c,c)
		if c==1 or chr=='.' or sub(scroll.text,c-1,c-1)==' ' then
			print(chr,x-2,y,col)
			print(chr,x,y,col)
			print(chr,x-1,y-1,col)
			print(chr,x-1,y+1,col)
			print(chr,x-1,y,3)
		else
			print(chr,x,y,11)
		end
		c+=1
		x+=4
		if (chr==' ') x+=2
	end
end

function draw_msg(s,sy)
	local sx=64-#s*2.5
	for i=1,#s do
 	local x=sx+flr(cos(t*0.04+i*0.07+sy*0.01)*1.8)
 	local y=sy+flr(sin(t*0.04+i*0.07+sy*0.01)*1.8)
 	c=sub(s,i,i)
 	print(c,x+1,y,7)
 	print(c,x-1,y,8)

 	print(c,x-1,y+1,8)
 	print(c,x,y+1,7)

 	print(c,x,y-1,8)

 	print(c,x,y,10)
 	sx+=5
 end
end

function draw_wave_done()
	draw_game()
	if #gifts==0 then
 	draw_msg("no bonus - sad face", 61)	
	else
 	draw_msg("bonus", 61)	
 	gx=64-(#gifts*7+5+32)/2
 	gy=78
 	for i=1,#gifts do
	 	local x=gx+flr(cos(t*0.06+i*0.1)*2)
 		local y=gy+flr(sin(t*0.06+i*0.1)*2)
 		spr(32,x,y)
 		gx+=7
 	end
 	spr(63,gx,gy)
 	print("50 = "..(#gifts*50),gx+5,gy)
 end
end

function draw_new_wave()
	draw_game()
	draw_msg(wave_msg,52)
	draw_msg("wave "..(wave+1),62)
end

function draw_gameover()
	draw_game()
	draw_msg("game over!",61)
end

function draw_start_game()
	p.x=0
	p.y=0
	p.dead=true
	draw_game()
	draw_msg("get ready ..",61)
end

function draw_titles()
	hx=cos((t+3)*0.01)*sin((t+5)*0.008)*2
	hy=sin((t+3)*0.01)*2
	spr(22,26+hx,20+hy,10,2)
	hx=cos(t*0.01)*sin(t*0.008)*2+12
	hy=sin(t*0.01)*2+10
	spr(36,hx,hy,2,2)
	hx=cos((t+10)*0.01)*sin((t+10)*0.008)*2+12
	hy=sin((t+10)*0.01)*2+10
	spr(36,hx+86,hy,2,2,true)

 draw_land(cam,1)
 draw_snow(cam)

	if (cam.x-64<0) then
	 local c={x=cam.x+256*5,y=cam.y}
 	draw_land(c,1)
 	draw_snow(c)

	elseif (cam.x-64>256*5-128) then
	 local c={x=cam.x-256*5,y=cam.y}
	 draw_land(c,1)
	 draw_snow(c)
	end
	
	draw_msg("sanity clause!",40)	
	draw_scroll()
	
 printc("(c) joe trewin",100,1)
 printc("http://fistfulofsquid.com",108,1)
 printc("@joeyspacerocks",116,1)
end

function draw_game()
	if (flash>0) then
		flash-=1
		rectfill(0,0,128,128,flashc)
	end
	
	y=play_top-9
	for i=0,5 do
	 h=5-i
		rectfill(0,y,128,y+h,1)
		y+=h+i
	end

	radar()
	
	local ly=play_top-5
	for i=1,max_lives do
		if i<=lives-1 then
			spr(16,i*4+1,ly)
		else
			spr(17,i*4+1,ly)
		end
	end
	draw_score(2,disp_score)
	draw_score(108,hiscore)

	draw_scene(cam)
	
	if (p.x-64<0) then
	 c={x=cam.x+256*5,y=cam.y}
	 draw_scene(c)

	elseif (p.x-64>256*5-128) then
	 c={x=cam.x-256*5,y=cam.y}
	 draw_scene(c)
	end
	
	if hypert>0 then
		draw_msg("no sanity clause!",61)
	end
end

function draw_snow(cam)
	for s in all(snow) do
		local c={x=cam.x*s.d,y=cam.y}
		sc=scrn(c,s.x,s.y)
		pset(sc.x,sc.y,7)
		pset(sc.x-20,sc.y+40,7)
		pset(sc.x+50,sc.y+20,7)
	end
end

function draw_scene(cam)
 draw_land(cam,1)
	draw_player(p,cam)

	lc=rnd(4)+7
	for l in all(lasers) do
		s=scrn(cam,l.x,l.y)
		pf=(p.facing+1)*0.5
		dx=l.x-(p.x+pf*16)
		s2x=s.x-min(abs(dx),abs(l.vx)*10)*sgn(l.vx)
		rectfill(s.x,s.y,s2x,s.y+1-flr(rnd(3)),lc)
	end

	for g in all(glt) do
		if (rnd(100)>60) do
			local s=scrn(cam,g.x,g.y)
 		pset(s.x,s.y,g.c)
 	end
	end

	pal(7,4+flr(((t*0.5)%12)))
	for pt in all(points) do
		local s=scrn(cam,pt.x,pt.y)
		spr(pt.s,s.x,s.y)
	end
	pal()
	
	played_berserk=false
	for a in all(aliens) do
		local s=scrn(cam,a.x,a.y)
		spr(a.s+a.so,s.x,s.y)

		if a.upd==alien_berserk and not player_berserk and s.x>0 and s.x<128 then
			played_berserk=true
			if (t%30==0) ssfx(4)
	 end
	end

	for g in all(gifts) do
		local s=scrn(cam,g.x,g.y)
		spr(32,s.x,s.y)
	end
	
	for e in all(expl) do
		draw_expl(cam,e)
	end

	draw_snow(cam)
end

function draw_expl(cam,e)
	l=30-e.ttl
	s=scrn(cam,e.x,e.y)

	pal(7,flr(rnd(13)+3))
	rectfill(s.x-l,s.y-l,s.x-l+2,s.y-l+2,7)
	rectfill(s.x-l,s.y+l,s.x-l+2,s.y+l+2,7)
	rectfill(s.x+l,s.y-l,s.x+l+2,s.y-l+2,7)
	rectfill(s.x+l,s.y+l,s.x+l+2,s.y+l+2,7)

	rectfill(s.x-l,s.y,s.x-l+2,s.y+2,7)
	rectfill(s.x+l,s.y,s.x+l+2,s.y+2,7)
	rectfill(s.x,s.y-l,s.x+2,s.y-l+2,7)
	rectfill(s.x,s.y+l,s.x+2,s.y+l+2,7)
	pal()
	
	if l<4 then
		circfill(s.x,s.y,12,7)
	end
end

function scrn(c,x,y)
	return {
		x=x-c.x+64,
	 y=y-c.y+64
 }
end

function draw_land(cam,scale)
	if (hyper) return
	--zero=scrn(cam,0,0)
	--line(zero.x,0,zero.x,128,2)

 local by=128
	local sx=flr(cam.x)-64
	local s=flr((sx)/5)
	local x=-(sx%5)
	local y=by-flr(land_height(s)+0.5)*scale
	for i=1,135/5 do
		nx=x+5
		ny=by-flr(land_height(i+s)+0.5)*scale
		
		if ny<90 and y<90 then
			c=7
 	elseif ny<100 and ny<100 then
 	 c=6
		else
		 c=13
		end
		
		line(x,y,nx,ny,c)
		x=nx
		y=ny
	end
end

function draw_player(p,cam)
	if (p.dead) return
	if ((p.inv%5>2)) return

	local s=scrn(cam,p.x,p.y)
 local x=s.x
	local y=s.y
	
	local sp=(flr(p.x/10)%2)*2+1
	spr(sp,x,y,2,1,p.facing<0)
	
	if p.hohoho>0 then
  p.hohoho-=1
		hx=s.x-4

		pal(7,4+flr(((t*0.5)%12)))		
		spr(14,hx,s.y-8+sin(t*0.01)*2)
		spr(14,hx+8,s.y-8+sin((t+30)*0.01)*2)
		spr(14,hx+16,s.y-8+sin((t+60)*0.01)*2)
		spr(15,hx+24,s.y-8+sin((t+90)*0.01)*2)
	 pal()
	end
end
