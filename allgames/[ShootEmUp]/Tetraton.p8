backgroundcol=1
tetracol0=0
tetracol1=2
tetracol2=3
tetracol3=9
shipcol=8
bulletcol0=9
bulletcol1=10
cloudcol0=7
cloudcol1=6
cloudcol2=13
starcol=15
txtcol0=7
txtcol1=2

t=0

mapw=16*64 maph=8*64

px=mapw/2 py=maph/2 pa=0.005
pvx=0 pvy=0

psmax=3

espd=0.25
esmax=3.5

cloud={}
pcloud={}
star={}

p1mapw=mapw/2 p1maph=maph/2
p2mapw=mapw/4 p2maph=maph/4

camx=0 camy=0
shkx=0 shky=0

camivx=0.5
camivy=0.5

e={}
e.c=0

b={}
b.c=0
bs=2
br=3

wpntype=0

score=0
dships=0

ingame=0
pdead=1

plt={}

mzc=1


function start_again()
 score=0
 pdead=0
 ingame=1
 wpntype=0
 
 wpnst=t
 
 while(e.c>0) do
  delete_ship(0)
 end

 while(b.c>0) do
  delete_bullet(0)
 end
 
 px=(camx+mapw/2)%mapw
 py=maph/2
 
 pvx=0
 pvy=0
 
 pa=0.005
end


function draw_ship_on_ssheet()
 for n=0,99 do

 ax=(n%11)*11+5
 ay=((n/11)-(n/11)%1)*11+5
 
 for i=ax-5,ax+5 do
 for j=ay-5,ay+5 do
 
  r=sqrt((i-ax)*(i-ax)+(j-ay)*(j-ay))
  a=atan2(i-ax,j-ay)
  
  x=cos(a-n/100+0.25)*r
  y=sin(a-n/100+0.25)*r
  
  if(x<0)then
  	--left
   dx=-x
   dy=y
  elseif(x>=0)then
   --right
   dx=x
   dy=y
  end
  
  if(dx<(dy+4)/2 and dy<4) then
   sset(i,j,shipcol)
  end
 
 end
 end
 
 end
end

function draw_bullet_on_ssheet()

 bbbx=(100%11)*11
 bbby=((100/11)-(100/11)%1)*11

 for i=0,6 do
  if(i>1 and i<5) then
   sset(bbbx+i,bbby+0,bulletcol0)
   sset(bbbx+i,bbby+6,bulletcol0)
  end
 end
 
 for i=0,6 do
  if(i==1 or i==5) then
   sset(bbbx+i,bbby+1,bulletcol0)
   sset(bbbx+i,bbby+5,bulletcol0)
  elseif(i>1 and i<5) then
   sset(bbbx+i,bbby+1,bulletcol1)
   sset(bbbx+i,bbby+5,bulletcol1)
  end
 end
 
 for i=0,6 do
  if(i==0 or i==6) then
   sset(bbbx+i,bbby+2,bulletcol0)
   sset(bbbx+i,bbby+3,bulletcol0)
   sset(bbbx+i,bbby+4,bulletcol0)
  elseif(i>0 and i<6) then
   sset(bbbx+i,bbby+2,bulletcol1)
   sset(bbbx+i,bbby+3,bulletcol1)
   sset(bbbx+i,bbby+4,bulletcol1)
  end
 end

end


function _init()
 create_stars()
 create_pclouds()
 create_clouds()

 move_crate()
 
 music(0)
end

shootin={}

function process_ginput() 
 if(btn(4)) then
 pa=pa+0.015
 end
 
 if(btn(5)) then
 pa=pa-0.015
 end
 
 pa=pa%1

 for i=0,3 do
  shootin[i]=0
 end

 if(btn(0)) then
  pshoot(0.5)
  shootin[2]=1
 end
 
 if(btn(1)) then
  pshoot(0)
  shootin[0]=1
 end
 
 if(btn(2)) then
  pshoot(0.25)
  shootin[1]=1
 end
 
 if(btn(3)) then
  pshoot(0.75)
  shootin[3]=1
 end
end

mc=0
mct=0
mctt=0

function process_minput()
 if(btn(3) and t-mct>0.5) then
  mc=(mc+1)%3
  mct=t
 end

 if(btn(2) and t-mct>0.5) then
  mc=(mc-1)%3
  mct=t
 end

 if(btn(4) or btn(5)) then
  
  --things n stuff
  --play
  --randomize palette
  --reset palette
  
  if(mc==0 and t-mctt>0.5) then
   start_again()
  elseif(mc==1 and t-mctt>0.5) then
   randomize_palette()
  elseif(mc==2 and t-mctt>0.5) then
   reset_palette()
  end

  mctt=t
 end
end

function process_m0input()
 if((btn(4) or btn(5)) and t-mctt>0.5) then
  ingame=1
  start_again()
  
  reset_palette()

  for i=0,255 do
  for j=0,255 do
   sset(i,j,0)
  end
  end
  
  draw_bullet_on_ssheet()
  draw_ship_on_ssheet()
 end
end

function update_tetra()
 spd=sqrt(pvx*pvx+pvy*pvy)
 if(spd>psmax) then
  pvx=pvx*psmax/spd
  pvy=pvy*psmax/spd
 elseif(spd>1) then
  pvx=pvx*(spd-0.05)/spd
  pvy=pvy*(spd-0.05)/spd
 end

 px=px+pvx
 py=py+pvy
 
 if(py<0) then
  pvy=pvy+(-py/10)
 elseif(py>maph) then
  pvy=pvy+((maph-py)/10)
 end

 px = px%mapw
end

function update_cam()
 camx=(4*camx+camrelx(px-64+10*pvx)+camx)/5
 camy=(4*camy+(py-64+10*pvy))/5

 camx=camx%mapw
 
 camy=min(max(camy,0),maph-128)
end

function cam_fucksoff()
 camx=camx+camivx
 camy=camy+camivy
 camx=camx%mapw
 camy=min(max(camy,0),maph-128)
 
 if(camy==0 or camy==maph-128) then
  camivy=-camivy
 end
end

function _update()
 t=t+0.1
 
 if(btnp(12)) then
  if(mzc==1) then
   music(0,-1)
  else
   music(0)
  end
 else
 
 end

 if(pdead==0) then
  process_ginput()
  update_tetra()
  update_cam()
 else
  cam_fucksoff()
  if(ingame==1) then
   process_minput()
  else
   process_m0input()
  end
 end
 
 if(e.c<min(score+3,12) and pdead==0) then
  create_ship()
 end
 
 checkcol_bullets()
 
 if(pdead==0) then
  checkcol_ships()
 end
 
 checkcol_crate()
 
 update_crate()
 update_ships()
 update_bullets()
 
 update_explos()
end

function draw_menu()
 draw_text("you had a score of",64-9*4,8,txtcol0,txtcol1)
 if (score<10) then
  draw_text(score,60,16,txtcol0,txtcol1)
 elseif (score<100) then
  draw_text(score,56,16,txtcol0,txtcol1)
 else
  draw_text(score,52,16,txtcol0,txtcol1)
 end

 draw_text("ships destroyed so far:",8,112,txtcol0,txtcol1)
 draw_text(dships,103,112,txtcol0,txtcol1)

 draw_text("try again",32,60-16,txtcol0,txtcol1)
 draw_text("randomize palette",32,60,txtcol0,txtcol1)
 draw_text("reset palette",32,60+16,txtcol0,txtcol1)

 if((t-mct)%4 < 3) then
  pal(shipcol,plt[txtcol1])

  sspr(0,0,11,11,19,41+mc*16)
  sspr(0,0,11,11,19,43+mc*16)
  sspr(0,0,11,11,18,42+mc*16)
  sspr(0,0,11,11,20,42+mc*16)

  sspr(0,0,11,11,18,41+mc*16)
  sspr(0,0,11,11,20,41+mc*16)
  sspr(0,0,11,11,18,43+mc*16)
  sspr(0,0,11,11,20,43+mc*16)

  sspr(0,0,11,11,17,42+mc*16)
  sspr(0,0,11,11,17,43+mc*16)
  
  sspr(0,0,11,11,19,44+mc*16)
  sspr(0,0,11,11,18,44+mc*16)

  sspr(0,0,11,11,17,44+mc*16)
  
  pal(shipcol,plt[txtcol0])

  sspr(0,0,11,11,19,42+mc*16)

  pal(shipcol,plt[shipcol])
 end

end

function draw_titlescreen()
 --draw_text("tetraton",32,32,txtcol0,txtcol1)

 x=34
 y=16
 
 step=5

 pal(7,rnd(16))
 sspr(0,0,64,8,x-step,y+(step-2))
 sspr(0,0,64,8,x-step,y+(step-1))
 sspr(0,0,64,8,x-(step-2),y+step)
 sspr(0,0,64,8,x-(step-1),y+step)
 sspr(0,0,64,8,x-step,y+step)
 
 step=4
 
 pal(7,rnd(16))
 sspr(0,0,64,8,x-step,y+(step-2))
 sspr(0,0,64,8,x-step,y+(step-1))
 sspr(0,0,64,8,x-(step-2),y+step)
 sspr(0,0,64,8,x-(step-1),y+step)
 sspr(0,0,64,8,x-step,y+step)
 
 step=3
 
 pal(7,rnd(16))
 sspr(0,0,64,8,x-step,y+(step-2))
 sspr(0,0,64,8,x-step,y+(step-1))
 sspr(0,0,64,8,x-(step-2),y+step)
 sspr(0,0,64,8,x-(step-1),y+step)
 sspr(0,0,64,8,x-step,y+step)
 
 step=2
 
 pal(7,rnd(16))
 sspr(0,0,64,8,x-step,y+(step-2))
 sspr(0,0,64,8,x-step,y+(step-1))
 sspr(0,0,64,8,x-(step-2),y+step)
 sspr(0,0,64,8,x-(step-1),y+step)
 sspr(0,0,64,8,x-step,y+step)
 
 pal(7,txtcol1)
 sspr(0,0,64,8,x-1,y)
 sspr(0,0,64,8,x+1,y)
 sspr(0,0,64,8,x,y-1)
 sspr(0,0,64,8,x,y+1)
 
 sspr(0,0,64,8,x+1,y-1)
 sspr(0,0,64,8,x-1,y-1)
 sspr(0,0,64,8,x+1,y+1)
 sspr(0,0,64,8,x-1,y+1)
  
 pal(7,txtcol0)
 sspr(0,0,64,8,x,y)
 
 pal(7,7)

 draw_text("by trasevol_dog",34,50,txtcol0,txtcol1)


 if(t%5<4) then
  draw_text("press z or x to start",24,96,txtcol0,txtcol1)
 end

end

function _draw()
 update_shake()

 rectfill(0,0,127,127,backgroundcol)
 draw_stars()
 draw_pclouds()
 draw_clouds()
 
 if(pdead==0) then
  draw_crate()
  draw_tetraton()
 end
 
 draw_ships()
 draw_bullets()
 --print(stat(1),0,0,7)
 --print(stat(0),0,8,7)

 draw_explos()

 if(pdead==0) then
 	draw_crateindic()
  draw_text("score:",4,1,txtcol0,txtcol1)
  draw_text(score,30,1,txtcol0,txtcol1)
		draw_weaponname()
 elseif(ingame==1) then
  draw_menu()
 else
  draw_titlescreen()
 end
end

function draw_clouds()
for n=0,5 do
 for i=0,5 do
  circfill(camrelx(cloud[n][i].x+cloud[n].x),
           camrely(cloud[n][i].y+cloud[n].y+4),
           cloud[n][i].r+1,
           cloudcol1)
 end
 for i=0,5 do
  circfill(camrelx(cloud[n][i].x+cloud[n].x),
           camrely(cloud[n][i].y+cloud[n].y),
           cloud[n][i].r-1,
           cloudcol0)
 end
end
end

function draw_pclouds()
for n=0,15 do

 x=p1camrelx(pcloud[n].x)
 y=p1camrely(pcloud[n].y)

 for i=0,4 do
  circfill(pcloud[n][i].x+x,
           pcloud[n][i].y+y+2,
           pcloud[n][i].r+2,
           cloudcol2)
 end

 for i=0,4 do
  circfill(pcloud[n][i].x+x,
           pcloud[n][i].y+y,
           pcloud[n][i].r,
           cloudcol1)
 end
end
end

function draw_stars()
 for n=0,star.c-1 do

  x=p2camrelx(star[n].x)
  y=p2camrely(star[n].y)

  pset(x,y,starcol)
 end
end

function draw_tetraton()
 ax=camrelx(px)
 ay=camrely(py)
 
 paa=pa-(pa%0.01)+0.005

 for i=ax-10,ax+10 do
 for j=ay-10,ay+10 do
 
  r=sqrt((i-ax)*(i-ax)+(j-ay)*(j-ay))
  a=atan2(i-ax,j-ay)
  
  x=cos(a-paa)*r
  y=sin(a-paa)*r
  
  if(x>-y and x<=y)then
   --down
   qx=x
   qy=y
   qa=3
  elseif(x>=y and x<-y)then
   --up
   qx=-x
   qy=-y
   qa=1
  elseif(-x>=y and x<y)then
  	--left
   qx=y
   qy=-x
   qa=2
  elseif(x>y and -x<=y)then
   --right
   qx=-y
   qy=x
   qa=0
  end
  
  if (qy>=5 and qy<9
  and qx>=-2 and qx<2)
  then pset(i,j,tetracol0)

  elseif(qy>=4 and qy<10
     and qx>=-3 and qx<3
     and shootin[qa]==1)
  then pset(i,j,tetracol3)
  
  elseif(qy>=4 and qy<10
     and qx>=-3 and qx<3)
  then pset(i,j,tetracol1)
  
  
  elseif(qy<2)
  then pset(i,j,tetracol2)
  
  elseif(qy<6)
  then pset(i,j,tetracol0)
  end
 
 end
 end
 
 if(tetracol2~=3) then
  tetracol2=3
 end
end

function create_clouds()
for n=0,5 do
 cloud[n]={}
 cloud[n].x=n*mapw/6 + rnd(100)-50
 cloud[n].y=(n%2)*2*maph/5+maph/5 + rnd(100)-50
 for i=0,5 do
  cloud[n][i]={}
  cloud[n][i].x = rnd(60)-30
  cloud[n][i].y = rnd(40)-20
  cloud[n][i].r = rnd(20)+10
 end
end
end

function create_pclouds()
for n=0,15 do
 pcloud[n]={}
 pcloud[n].x=n*p1mapw/16 + rnd(30)-15
 pcloud[n].y=(n%4)*p1maph/3+ rnd(30)-15
 for i=0,4 do
  pcloud[n][i]={}
  pcloud[n][i].x = rnd(20)-10
  pcloud[n][i].y = rnd(10)-5
  pcloud[n][i].r = rnd(4)+4
 end
end
end

function create_stars()
 star.c=0
 for i=0,63 do
  star[star.c]={}
  star[star.c].x=i*p2mapw/64 + rnd(20)-10
  star[star.c].y=(i%8)*p2maph/5 - p2maph/5 + rnd(20)-10
  star.c=star.c+1
 end
end


function camrelx(x)
 if(x<camx-mapw/2) then
  return (mapw-camx + x)-shkx
 elseif(x>=camx+mapw/2) then
  return -(mapw-x + camx)-shkx
 else
  return x-camx-shkx
 end
end

function camrely(y)
 return y-camy-shky
end



function p1camrelx(x)

 xxx=(camx+64-shkx)/(mapw/p1mapw)

 if(x<xxx-p1mapw/2) then
  return x+p1mapw-xxx+64
 elseif(x>=xxx+p1mapw/2) then
  return x-p1mapw-xxx+64
 else
  return x-xxx+64
 end
end

function p1camrely(y)

 yyy=(camy+64-shky)/(maph/p1maph)

 return y-yyy+64

end


function p2camrelx(x)

 xxx=(camx+64-shkx)/(mapw/p2mapw)

 if(x<xxx-p2mapw/2) then
  return x+p2mapw-xxx+64
 elseif(x>=xxx+p2mapw/2) then
  return x-p2mapw-xxx+64
 else
  return x-xxx+64
 end
end

function p2camrely(y)

 yyy=(camy+64-shky)/(maph/p2maph)

 return y-yyy+64

end


function create_ship()
 n=e.c
 
 e[n]={}
 
 a=rnd(100)/100
 e[n].x=px+cos(a)*64*2
 e[n].y=py+sin(a)*64*2
 e[n].a=a+rnd(100)/400
 e[n].vx=0
 e[n].vy=0
 
 e.c=e.c+1
end

function update_ships()
 for n=0,e.c-1 do
  x=camrelx(e[n].x)
  y=camrely(e[n].y)

  tpx=camrelx(px)
  tpy=camrely(py)
  
  pda=atan2(tpx-x,tpy-y)
  
  
  a=e[n].a-pda
  if(a<0) then
  a=1+a
  end
  a=a%1
  
  if(a<pda) then
   e[n].a=e[n].a-0.01
  elseif(a>pda) then
   e[n].a=e[n].a+0.01
  end
  
  e[n].a=e[n].a%1
 
  e[n].vx=e[n].vx+espd*cos(e[n].a)
  e[n].vy=e[n].vy+espd*sin(e[n].a)


  spd=sqrt(e[n].vx*e[n].vx+e[n].vy*e[n].vy)
  if(spd>esmax) then
  e[n].vx=e[n].vx*esmax/spd
  e[n].vy=e[n].vy*esmax/spd
  end


  e[n].x=e[n].x+e[n].vx
  e[n].y=e[n].y+e[n].vy
  
  e[n].x=e[n].x%mapw
  
 end
end

function draw_ships()
 for n=0,e.c-1 do

  ax=camrelx(e[n].x)-5
  ay=camrely(e[n].y)-5
 
  aa=(e[n].a*100)%100
  aa=aa-aa%1
  
  sspr(
   (aa%11)*11,
   ((aa/11)-((aa/11)%1))*11,
   11,11,
   ax,
   ay
  )
 
 end
end

function delete_ship(n)
 e.c=e.c-1

 for i=n,e.c-1 do
  e[i]=e[i+1]
 end
end

function create_bullet(x,y,a,acc,offset,s,l)
 n=b.c
 
 b[n]={}
 
 b[n].x=x+offset*cos(a)
 b[n].y=y+offset*sin(a)
 
 acco=(1-acc)*1000
 a=a+(rnd(acco)-acco/2)/1000
 
 b[n].vx=s*cos(a)
 b[n].vy=s*sin(a)
 b[n].l=l
 
 b.c=b.c+1
end

function create_bullet2(x,y,a,aos,acc,offset,s,l)
 n=b.c
 
 b[n]={}
 
 b[n].x=x+offset*cos(a)
 b[n].y=y+offset*sin(a)
 
 acco=(1-acc)*1000
 a=a+(rnd(acco)-acco/2)/1000
 
 b[n].vx=s*cos(a+aos)
 b[n].vy=s*sin(a+aos)
 b[n].l=l
 
 b.c=b.c+1
end

function create_bullet3(x,y,a,aos,acc,xos,yos,s,l)
 n=b.c

 b[n]={}

 b[n].x=x+yos*cos(a)+xos*cos(a+0.25)
 b[n].y=y+yos*sin(a)+xos*sin(a+0.25)

 acco=(1-acc)*1000
 a=a+(rnd(acco)-acco/2)/1000

 b[n].vx=s*cos(a+aos)
 b[n].vy=s*sin(a+aos)
 b[n].l=l
 
 b.c=b.c+1
end

function update_bullets()

 k=0

 for m=0,b.c-1 do
 
  n=m+k
  b[n].x=b[n].x+b[n].vx
  b[n].y=b[n].y+b[n].vy
  
  b[n].x=b[n].x%mapw

  b[n].l=b[n].l-0.1
  if(b[n].l<=0) then
   delete_bullet(n)
   k=k-1
  end
 end
end

function draw_bullets()
 for n=0,b.c-1 do

  x=camrelx(b[n].x)
  y=camrely(b[n].y)

  --circfill(x,y,br,bulletcol0)
  --circfill(x,y,br-1,bulletcol1)

  sspr(bbbx,bbby,7,7,x-3,y-3)
  
 end
end

function delete_bullet(n)
 b.c=b.c-1

 for i=n,b.c-1 do
  b[i]=b[i+1]
 end
 
end

cooldown={}
for i=0,3 do
 cooldown[i]=-5
end

rra=0

drra={}
for i=0,3 do
 drra[i]=0
end

wpnz=16

nna=0

function pshoot(a)

 if(wpntype==0) then     --classic
  cldwn=0.5 sp=1 sshk=1 ssfx=6

 elseif(wpntype==1) then --shotgun
  cldwn=2 sp=5 sshk=3 ssfx=9

 elseif(wpntype==2) then --triple
  cldwn=0.5 sp=1 sshk=1.5 ssfx=6

 elseif(wpntype==3) then --smg
  cldwn=0.1 sp=0.15 sshk=1.5 ssfx=6

 elseif(wpntype==4) then --flamethrower
  cldwn=0.05 sp=0.1 sshk=0.5 ssfx=6

 elseif(wpntype==5) then --pop-pop
  cldwn=0.1 sp=0.25 sshk=0 ssfx=6

 elseif(wpntype==6) then --starblast
  cldwn=2 sp=3 sshk=2 ssfx=9

 elseif(wpntype==7) then --looper
  cldwn=0.05 sp=0.1 sshk=0.5 ssfx=6
 
 elseif(wpntype==8) then --brackets
  cldwn=2.5 sp=5 sshk=3 ssfx=9

 elseif(wpntype==9) then --wavy
  cldwn=0.15 sp=0.3 sshk=1 ssfx=6
 
 elseif(wpntype==10) then--meteorite
  cldwn=0.05 sp=-0.2 sshk=0.75 ssfx=6

 elseif(wpntype==11) then--shower
  cldwn=2 sp=-5 sshk=3 ssfx=9

 elseif(wpntype==12) then--boom
  cldwn=3 sp=5 sshk=5 ssfx=9

 elseif(wpntype==13) then--shelly
  cldwn=0.1 sp=0.5 sshk=0 ssfx=6
 
 elseif(wpntype==14) then--ithearts
  cldwn=1 sp=2 sshk=1 ssfx=6

 elseif(wpntype==15) then--lancelot
  cldwn=0.05 sp=-0.2 sshk=0.5 ssfx=6

 end


 if(cooldown[a*4]<t-cldwn) then
  if(wpntype==0) then
   create_bullet
    (px,py,pa+a,0.99,11,bs,5)
    
  elseif(wpntype==1) then
   for i=0,7 do
    create_bullet
     (px,py,pa+a,0.75,11,bs/10+rnd(bs*9)/10,1)
   end

  elseif(wpntype==2) then
   for i=-1,1 do
    create_bullet2
     (px,py,pa+a,i*0.1,0.96,11,bs,3)
   end

  elseif(wpntype==3) then
   create_bullet
    (px,py,pa+a,0.9,11,bs*1.5,5)

  elseif(wpntype==4) then
   create_bullet
    (px,py,pa+a,0.8,11,bs/2+rnd(bs*10)/10,0.75)

  elseif(wpntype==5) then
   create_bullet
    (px,py,pa+a,1,11,bs/4,2)
    
  elseif(wpntype==6) then
   for i=0,7 do
    create_bullet
     (px,py,pa+i/8,0.99,11,bs/2,3)
   end
   
  elseif(wpntype==7) then
   create_bullet
    (px,py,pa+rra,1,11,bs/4,1)
   rra=rra+0.05
   
  elseif(wpntype==8) then
   for i=-4,4 do
    create_bullet2
     (px,py,pa+a,i*0.05,1,11,bs/2+(1-cos(i*0.05))*bs*0.8,3)
   end

  elseif(wpntype==9) then
   create_bullet2
    (px,py,pa+a,sin(drra[a*4])/10,1,11,bs,2)
   drra[a*4]=drra[a*4]+0.1

  elseif(wpntype==10) then
   create_bullet2
    (px,py,pa+a,0.35,0.9,11,bs,2)
   create_bullet2
    (px,py,pa+a,-0.35,0.9,11,bs,2)

  elseif(wpntype==11) then
   for i=0,19 do
    create_bullet2
     (px,py,pa+a,0.5,0.4,13,bs/2+rnd(bs*10)/10,2)
   end

  elseif(wpntype==12) then
   for i=0,49 do
    create_bullet
     (px,py,0,0,11,bs/2+rnd(bs*20)/10,3)
   end
   
  elseif(wpntype==13) then
   nna=(nna+1)%2
   for i=-3,3 do
    create_bullet
     (px,py,pa+a+(rnd(60)-30)/100,1,15,0,0.25)
   end

  elseif(wpntype==14) then
   aofs=(rnd(40)-20)/100

   create_bullet3
    (px,py,pa+a,aofs,1,0,11,bs,2)
   create_bullet3
    (px,py,pa+a,aofs,1,0,19,bs,2)

   for i=0,1 do
    create_bullet3
     (px,py,pa+a,aofs,1,(i-0.5)*4*1,13,bs,2)
    create_bullet3
     (px,py,pa+a,aofs,1,(i-0.5)*4*2,15,bs,2)
    create_bullet3
     (px,py,pa+a,aofs,1,(i-0.5)*4*3,17,bs,2)
    create_bullet3
     (px,py,pa+a,aofs,1,(i-0.5)*4*3,19,bs,2)
    create_bullet3
     (px,py,pa+a,aofs,1,(i-0.5)*4*2,21,bs,2)
   end

  elseif(wpntype==15) then
   for i=-4,4 do
    create_bullet3
     (px,py,pa+a,0,1,i,11,psmax+(2.5-(abs(i/2)))*5,0.2)
   end

  end

  sfx(ssfx,2)

  pvx=pvx-sp*cos(pa+a)
  pvy=pvy-sp*sin(pa+a)

  add_shake(sshk)

  if(wpntype==6 or wpntype==7) then
   for i=0,3 do
    cooldown[i]=t
   end
  else
   cooldown[a*4]=t
  end
 end

end

wpnst=0

function draw_weaponname()
 if(t-wpnst<3 or (t-wpnst<6 and (t-wpnst)%1<0.5)) then
  if(wpntype==0) then
   wpnname="the classic" wpnnl=11
  elseif(wpntype==1) then
   wpnname="the shotgun" wpnnl=11
  elseif(wpntype==2) then
   wpnname="the triple" wpnnl=10
  elseif(wpntype==3) then
   wpnname="the smg" wpnnl=7
  elseif(wpntype==4) then
   wpnname="the flamethrower" wpnnl=16
  elseif(wpntype==5) then
   wpnname="the pop-pop" wpnnl=11
  elseif(wpntype==6) then
   wpnname="the starblast" wpnnl=13
  elseif(wpntype==7) then
   wpnname="the looper" wpnnl=10
  elseif(wpntype==8) then
   wpnname="the brackets" wpnnl=12
  elseif(wpntype==9) then
   wpnname="the wavy" wpnnl=8
  elseif(wpntype==10) then
   wpnname="the meteorite" wpnnl=13
  elseif(wpntype==11) then
   wpnname="the shower" wpnnl=10
  elseif(wpntype==12) then
			wpnname="the boom" wpnnl=8
  elseif(wpntype==13) then
			wpnname="the shelly" wpnnl=10
  elseif(wpntype==14) then
			wpnname="the ithearts" wpnnl=12
  elseif(wpntype==15) then
			wpnname="the lancelot" wpnnl=12
  end
  
  draw_text(wpnname,125-wpnnl*4,1,txtcol0,txtcol1)
 end
end

shkl=5

function add_shake(p)
 a=rnd(100)/100
 shkx=shkx+p*cos(a)
 shky=shky+p*sin(a)
end

function update_shake()
 a=atan2(shkx,shky)
 if((a>0.125 and a<0.375) or (a>0.625 and a<875)) then
  l=shky/sin(a)
 else
  l=shkx/cos(a)
 end
 
 a=a+0.5+(rnd(30)-15)/100
 
 if(l>shkl) then
  l=shkl
 end
 
 shkx=0.8*l*cos(a)
 shky=0.8*l*sin(a)
end

function checkcol_bullets()
 
 for n=0,b.c-1 do
  for m=0,e.c-1 do
  
   dx=camrelx(b[n].x)-camrelx(e[m].x)
   dy=camrely(b[n].y)-camrely(e[m].y)

   if(abs(dx)<6 and abs(dy)<6) then
    create_explo(e[m].x,e[m].y,8+rnd(4))
    delete_bullet(n)
    delete_ship(m)
    dships=dships+1
    
    sfx(0,3)
   end
  
  end
 end

end

boom={}
boom.c=0

function create_explo(x,y,r)

 n=boom.c
 
 boom[n]={}
 boom[n].x=x
 boom[n].y=y
 boom[n].r=r
 boom[n].s=-1

 boom.c=boom.c+1
end

function update_explos()
 for i=0,boom.c-1 do
 
  boom[i].s=boom[i].s+1
  
  if(boom[i].s>=2) then
   delete_explo(i)
  else
   add_shake(2)
  end
  
  if(boom[i].s==1 and boom[i].r>=16) then
   n=2+rnd(3)
   for k=0,n-1 do
    create_explo(boom[i].x+rnd(40)-20,boom[i].y+rnd(40)-20,8+rnd(8))
   end
  elseif(boom[i].s==1 and boom[i].r>=8) then
   n=2+rnd(3)
   for k=0,n-1 do
    create_explo(boom[i].x+rnd(40)-20,boom[i].y+rnd(40)-20,rnd(8))
   end
  end
 
 end
end

function draw_explos()
 for i=0,boom.c-1 do
 
 if(boom[i].s==0) then
  circfill
  (camrelx(boom[i].x),
   camrely(boom[i].y),
   boom[i].r,
   7)
 elseif(boom[i].s==1) then
  circfill
  (camrelx(boom[i].x),
   camrely(boom[i].y),
   boom[i].r,
   0)
 end
 
 end
end

function delete_explo(n)
 boom.c=boom.c-1

 for i=n,boom.c-1 do
  boom[i]=boom[i+1]
 end
 
end

function move_crate()
 cratex=rnd(mapw)
 cratey=rnd(maph)
 cratea=rnd(100)/100
 crateas=(rnd(10)-5)/100
 cratevx=0.25*cos(cratea)
 cratevy=0.25*sin(cratea)
end

function update_crate()
 cratex=cratex+cratevx
 cratey=cratey+cratevy
 cratea=cratea+crateas
 
 if(cratex>mapw or cratex<0) then
  cratevx=-cratevx
 end
 
 if(cratey>maph or cratey<0) then
  cratevy=-cratevy
 end
end

cratecoln=0

function draw_crate()

 circfill(camrelx(cratex),
          camrely(cratey),
          3,
          tetracol2)
 circfill(camrelx(cratex),
          camrely(cratey),
          2,
          rnd(16))--10)
end

function draw_crateindic()
 x=camrelx(cratex)
 y=camrely(cratey)

 if(x<-4 or x>132
  or y<-4 or y>132) then
 
  pal(shipcol,plt[tetracol2])

  a=atan2(x-camrelx(px),y-camrely(py))
  aa=a*100-(a*100)%1
  sspr((aa%11)*11,((aa/11)-((aa/11)%1))*11,11,11,camrelx(px)+32*cos(a),camrely(py)+32*sin(a))

  pal(shipcol,plt[shipcol])
 end
end

function checkcol_crate()
 dx=camrelx(px)-camrelx(cratex)
 dy=camrely(py)-camrely(cratey)

 if(abs(dx)<12 and abs(dy)<12) then
  
  tetracol2=10
  change_wpn()
  move_crate()
  add_shake(2)
  
  score=score+1
  
  sfx(8,2)
  
 end
end

function change_wpn()
 k=rnd(wpnz-1)
 
 k=k-k%1
 
 if(k>=wpntype) then
  wpntype=k+1
 else
  wpntype=k
 end
 
 wpnst=t
end

function draw_text(blah,x,y,c0,c1)

 print(blah,x,y,c1)
 print(blah,x+2,y,c1)
 print(blah,x,y+2,c1)
 print(blah,x+2,y+2,c1)

 print(blah,x,y+1,c1)
 print(blah,x+2,y+1,c1)
 print(blah,x+1,y,c1)
 print(blah,x+1,y+2,c1)

 print(blah,x,y+3,c1)
 print(blah,x+1,y+3,c1)
 --print(blah,x+2,y+3,c1)

 --print(blah,x-1,y,c1)
 print(blah,x-1,y+1,c1)
 print(blah,x-1,y+2,c1)

 print(blah,x-1,y+3,c1)

 print(blah,x+1,y+1,c0)

end

function checkcol_ships()
 for i=0,e.c-1 do
  dx=camrelx(px)-camrelx(e[i].x)
  dy=camrely(py)-camrely(e[i].y)

  if(abs(dx)<8 and abs(dy)<8) then

   pdead=1
   create_explo(px,py,20)
   add_shake(5)
   mctt=t
   sfx(7,2)

  end
 end
end

function reset_palette()
 for i=0,15 do
  plt[i]=i
  pal(i,i)
 end
end

function randomize_palette()
 rest={}
 
 for i=0,15 do
  rest[i]=i
 end

 for i=0,15 do
  k=rnd(16-i)
  k=k-(k%1)
  
  plt[i]=rest[k]
  pal(i,rest[k])
  
  for j=k,15-i-1 do
   rest[j]=rest[j+1]
  end
 end
end
