pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
    --the destiny of bob ross
--gamejam 18.12.17-21.12.17
--school of games,cologne
--maxi thiemer and
--michael miebach

--functions and logic
function frames()--counting and stuff
  aframes+=1--counting up frames
 if player.frame and aframes==10 then
  sfx(6)--movesound
 end
 if aframes>=10 then--reset frmes
  aframes=0 
  if player.gap==4 or--stop animation
   player.gap>=5 then--stop animation
   player.gap=1
  else
   player.gap+=1--walking animation
  end
  if player.frame==false then
   player.gap=1--make bob stand still if not moving
  end 
 end
  player.frame=false --its true if a arrow is pressed
 if player.shotcd<player.maxshotcd then
  player.shotcd+=1--shot cooldown
 end
 if player.hitcd<player.maxhitcd then
  player.hitcd+=1
 end--hit cooldown    invinsable after a hit
 if #enemies==0 then--after clearing the stage
  enemiecounter+=1--we need more enemies!
  spawn_enemies()--spawining new enemies
 end
 if player.potatocd<player.maxpotatocd then
  player.potatocd+=1
  player.potato_timer+=1
  if player.potato_timer>player.max_potato_timer then 
   player.dv=1
  end
 end 
end--function

function add_hit(_x,_y,_i,_dx,_dy)--attack move
 local p={x=_x,--attackmove starting point
          y=_y,
     sindex=_i,--sprite index
         dx=_dx,--movementspeed
         dy=_dy,--movementspeed
         age=0--duration until the shot despawns
         }
 add(hit,p)
end

function move_hit()
 if #hit>0 then
  for e in all (hit) do 
   e.x+=e.dx--make attacks move
   e.y+=e.dy
   e.age+=1--make them despawn
   if e.age > 30 then
    del(hit,e)
   end--if
  end--loop
 end--if
end--function

function add_enemie(_x,_y,_i,_dv,_b)
 local p={x=_x,--enemy starting location
          y=_y,
         dv=_dv,--movementspeed
     sindex={--enemy types + view diration
      {06,22,38,54},--1sprite
      {08,24,40,56},--2sprite
      {10,26,42,58},--3sprite
            },
        row=_i,--animation table index
        gap=1,--animation table index
        att=_b,--if=true enemies will follow you if=false they leave the screen
     random=flr(rnd(4)+1)--diraction where they leave the screen
         }
 add(enemies,p)
end

function spawn_enemies()
 for i=1,enemiecounter do
  local s=flr(rnd(3))+1--sprite    enemy typ
  local xr=rnd(2)--calculates where the enemies should spawn
  local yr=rnd(2)
  local r1=flr(rnd(5)+1)--makes it random but 
  local r2=flr(rnd(5)+122)-- they always spawn outside of the screen
  local x=0--acctual spawn location
  local y=0
  
 if xr<1 then x=r1       
 else x=r2
 end
 
 if yr<1 then y=r1       
 else y=r2
 end
  add_enemie(x,
             y,
             s,
             0.1*s+(0.05*rnd(3)),--sprite index *0,1+random value so they dont stack 
             true--if=true enemies will follow you if=false they leave the screen
             )          
 end--loop to spawn enemies
end


function move_enemies()
 for e in all (enemies) do
  if e.att==true then--make them follow bob
   if e.y<player.y then
    e.y+=e.dv 
    e.gap=1--view diration
   end
   if e.y>player.y then
    e.y-=e.dv 
    e.gap=2--view diration
   end
  
   if e.x<player.x+1 then 
    e.x+=e.dv--enemies links vom spieler
    if abs(e.x)-abs(player.x)<abs(e.y)-abs(player.y) then--checks where bob is
     e.gap=3--view diration
    end
   end
  
   if e.x>player.x+1 then
    e.x-=e.dv
    if abs(e.x)-abs(player.x)>abs(e.y)-abs(player.y) then--checks where bob is
     e.gap=4--view diration
    end
   end
  
   if flr(e.x)==player.x then--fixxes some buggy views
    if e.y<player.y then
     e.gap=1
    elseif e.y>player.y then
     e.gap=2
    end
   end
  elseif e.att==false then--make enemies leave the screen
   if e.random==1 then 
    e.x+=e.dv*2--movediraction
    e.gap=3--view diration
   elseif e.random==2 then 
    e.x-=e.dv*2--movediraction
    e.gap=4--view diration
   elseif e.random==3 then
    e.y+=e.dv*2--movediraction
    e.gap=1--view diration
   elseif e.random==4 then
    e.y-=e.dv*2--movediraction
    e.gap=2--view diration
   end
   
   if(e.x<3 or e.x>123) or
     (e.y<3 or e.y>123) then
    del(enemies,e)--make them despawn
   end
  end--if att==true or false
 end--loop enemies
end--function

function hit_enemie()
 for e in all (enemies) do
  for h in all (hit) do
   if (h.x>=e.x and--collision x dir
       h.x<=e.x+7) or
      (h.x+7>=e.x+2 and
       h.x+7<=e.x+7) then
    if(h.y>=e.y and-- collision y dir
       h.y<=e.y+7) or
      (h.y+7>=e.y and
       h.y+7<=e.y+7) then
      e.att=false--if hit make them leave
      del(hit,h)--delete hit
      shake+=0.12--screenshake!!!
      sfx(2)
     for i=1,10 do--color splatter
      add_points(e.x,
                 e.y,
                 e.s)
       
     end--loop to add points
    end--if collision
   end --if collision
  end--loop hit
 end--loop enemies
end--function

function collision_enemie(_x1,_y1,_x2,_y2)
 for e in all (enemies) do
  if _x1<=e.x+2 and--special case where enemies fits nearly exacly in bob
     _x2>=e.x+5 then
   if(_y1>=e.y+1 and-- collsion y dir
      _y1<=e.y+6) or
     (_y2>=e.y+1 and
      _y2<=e.y+6) then
    return true--if collision if true
   end
  end
  if (_x1>=e.x+2 and--usual collision
      _x1<=e.x+5) or--collsion x dir
     (_x2>=e.x+2 and
      _x2<=e.x+5) then
   if(_y1>=e.y+1 and-- collsion y dir
      _y1<=e.y+6) or
     (_y2>=e.y+1 and
      _y2<=e.y+6) then
    return true
   end--if y collsion
  end-- if x collsion
 end--loop enemies
end--function

function lose_life()
 if collision_enemie(player.x+2,--hitbox
                     player.y+1,
                     player.x+6,
                     player.y+7)
 and player.hitcd==50 then--invinsible duation
  player.hitcd=0
  player.lifes-=1
  sfx(5)
  if player.lifes==0 then
   mode="gameover"
   music(4)
  end
 end
end
      
function playercontrol()
 if btn(0) and player.x>7then
  player.x-=player.dv--left
  player.row=2--animation
  player.flp=true-- true to flip sprite 
  player.frame=true--make animations happen
 end
 
 if btn(1) and player.x<113then
  player.x+=player.dv--right
  player.row=2--animation
  player.flp=false
  player.frame=true--make animations happen
 end
 
 if btn(2) and player.y>7then
  player.y-=player.dv--up
  player.row=3--animation
  player.flp=false
  player.frame=true--make animations happen
 end
 
 if btn(3) and player.y<112then
  player.y+=player.dv--down
  player.row=1--animation
  player.flp=false
  player.frame=true--make animations happen
 end
 
 if btn(4) and 
 (player.potatocd>=player.maxpotatocd) and
  player.frame==false then
   player.dv=1.5
   player.potatocd=0
   player.potato_timer=0
   player.row=4
   sfx(7)
 end

  if btnp(5) and player.frame==false and
   player.shotcd==player.maxshotcd then
   player.gap=5--attack animation
   player.shotcd=0--reset shot cooldown
   sfx(4)
   player.frame=true--animation stuff
   if player.row ==1 then--check attack diration
    hit.dy=1
    hit.dx=0
   elseif player.row ==2 and--check attack diration
    player.flp==false then
    hit.dx=1
    hit.dy=0
   elseif player.row ==3 then--check attack diration
    hit.dy=-1
    hit.dx=0
   elseif player.row ==2 and--check attack diration
    player.flp==true then
    hit.dx=-1
    hit.dy=0
   end
    add_hit(player.x,--start position
            player.y,--start position
            16,--sprite
            hit.dx,--speed
            hit.dy--speed
            )
 end 
end


function add_points(_x,_y)--color splatta
 local p={
     x=_x,--starting position
     y=_y,--starting position
     c=flr(rnd(8)+8),--color
    vx=rnd(2)-1,--movespeed x dir
    vy=rnd(2)-1,--movespeed y dir
  size=flr(rnd(3)+2)--ciclesize
    }
 add(points,p)
end

function move_points()--move and despawn
 for e in all (points) do
  e.x+=e.vx--movement
  e.y+=e.vy
  e.vx*=0.95--slow them down over time
  e.vy*=0.95--slow them down over time
  if abs(e.vx)<0.3 then--amke them stop if movespeed is pretty low
   e.vx=0
  end
  if abs(e.vy)<0.3 then--amke them stop if movespeed is pretty low
   e.vy=0
  end
  if(e.x<5 or e.x>123) or
     (e.y<5 or e.y>123) then
    del(points,e)--delete them if they leave the screen
  end
  if #points>400 then--memory issues   daaamn pico d:
   del(points,e)--delete the first if they become to many
  end
 end--points loop
end--function

function doshake()--screenshake
 local shakex=rnd(32)-16--make the cam move
 local shakey=rnd(32)-16--make the cam move

 shakex*=shake--random value*shake intensity
 shakey*=shake
 
 camera(shakex,shakey)

 shake*=0.95
 if (shake<0.05) then 
  shake=0-- make it stop if intensity is pretty low
 end
end

-----------------------------------------------------------------------------

function titlescreen()
 if btnp(5) then
  mode="control"
  sfx(3)
  music(3)
 end
end

function control()
 if btnp(5) then
  mode="game"
  sfx(3)
  music(0)
 end
end

function game()
  playercontrol()
  frames()
  lose_life()
  hit_enemie()
  move_enemies()
  move_hit()--move attack 
  move_points()--splatta
  doshake()--screenshake
end

function gameover()
 if btnp(5) then
  mode="game"
 _init()--restart the game
 end
end

---------------------------------------------------------------------
--draw stuff
function draw_title()
 cls()
 map(28,4,--map coordinates
     35,45,--screen pixels
     9,7)--map width + height
 print("press x to play",38,90,blinky)
end

function draw_control()
 cls()
 print("you are playing as bob ross",12,45,8)
 print("and you need to sign autographs",3,55,8)
 print("for your happy little fans.",12,65,8)
 print("but care, they really love you!",5,75,8)
 print("dont let them come to close. ",11,85,8)
 print("stand still and press x to sign.",2,100,14)
 print("stand still and press z to eat.",3,110,14)
 print("press x to play",34,35,blinky)
end

function draw_game()
 cls(0)
 
 palt(0,false)--black(transparent color)
 palt(14,true)--pink(transparent color)
 --background map
 map(0, 0, -- map coordinates
     0, 0,     -- screen pixels
   128, 64  -- map width + height
   )
     
 palt()--reset palt(transparent color)
 
 
 for e in all (points) do
  circfill(e.x,--x poistion
           e.y,--x poistion
           e.size,-- circ size
           e.c-- color
           )
 end
 
 if player.hitcd%5==0 then--make bob blink while invinsible
  spr(player.sindex[player.row][player.gap],
      player.x,
      player.y,
      1,
      1,
      player.flp--to mirror walking to the left/right
      )
 end    
 
 for e in all (enemies) do
  if aframes<8 then--waling animation
   spr(e.sindex[e.row][e.gap],
       e.x,
       e.y) 
  else 
   spr((e.sindex[e.row][e.gap])+1,
       e.x,
       e.y)
  end
  if e.att==false and aframes <5 then--add some hearths if they dont follow bob
   spr( 92,
       e.x,
       e.y
       )
  elseif e.att==false and aframes >5 then --add some hearths if they dont follow bob
   spr( 93,
       e.x,
       e.y
       )
  end 
 end
  for e in all (hit) do
  spr(flr(rnd(4)+12)+(flr(rnd(4))*16),--so the shot changes on flight randomly
      e.x,
      e.y)
 end
 
 palt(0,false)--black(transparent color)
 palt(14,true)--pink(transparent color)
 --second map so the boarder is always over the acctual game
 map(40, 0, -- map coordinates
      0, 0,  -- screen pixels
    128, 64)  -- map width + height 
 
 palt()--reset palt(transparent color)

 
 print("stage:"..enemiecounter-2,68,1,7)
  if player.lifes==2 then --lifebar
   spr(79,120,24)
  elseif player.lifes==1 then--lifebar
   spr(79,120,24)
   spr(79,120,32)
  elseif player.lifes==0 then--lifebar
   spr(79,120,24)
   spr(79,120,32)
   spr(79,120,40)
 end  
 rectfill(122,93,125,94-(player.potatocd/100),8)-- enegiebar
 if player.potatocd>=player.maxpotatocd then
  rectfill(122,94,125,82,blinky)-- enegiebar if ready
 end
end

function draw_gameover()
 cls()
 map(27,0,-- map coordinates
     20,60,-- screen pixels
      6,4)-- map width + height
 print("we dont die,",71,55,8)
 print("we just make ",70,70,8)
 print(" happy little ",66,80,blinky)
 print("accidents",76,90,blinky)
end

-------------------------------------------------------------------------
--_init()  _update60()  _draw()
function _init()
 mode="title"
 aframes=0--frame counter
 enemiecounter=3	--number of enemies
 shake=0--screenshake
 blinky=1--make things blink
 hit={}--table for attacks
 points={}--table for color splatter
 enemies={}--enemy table
 player={--player table
  x=64,--position y
  y=64,--position y
  dv= 1,--movementspeed
  sindex={--animation sprites
   {01,02,03,04,05},
   {17,18,19,20,21},
   {33,34,35,36,37},
   {49,50,51,52,53}
  },
  row=1,--sprite index
  gap=1,--sprite index
  flp=false,--mirror sprites
  frame=false,--for stopping animations(true is btn is pressed)
  lifes=3,--lifes
  hitcd=50,--reseting value
  maxhitcd=50,--max invinsible time
  shotcd=50,--reseting value
  maxshotcd=50,--max shotcooldown
  potatocd=0,--reseting value
  maxpotatocd=1200,--movementspeedcd
  potato_timer=0,--reseting value
  max_potato_timer=125--movementspeed buff duation
 }
 spawn_enemies()
end

function _update60()
  blinky +=1--make things blinky
 if blinky>15 then 
  blinky=0
 end
  
 if mode=="title" then
  titlescreen()
 elseif mode=="control"then
  control()
 elseif mode=="game" then
  game()
 elseif mode=="gameover" then
  gameover()
 end
end

function _draw()
 if mode =="title" then
  draw_title()
 elseif mode=="control" then
  draw_control()
 elseif mode=="game" then
  draw_game()
 elseif mode=="gameover" then
  draw_gameover()
 end
end
if(_update60)_update=function()_update60()_update_buttons()_update60()end␀
