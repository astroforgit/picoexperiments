pico-8 cartridge // http://www.pico-8.com
version 30
__lua__
--seaquest
--1983 steeve cartwright (activision)
--2020 lostcadesoft by bgelais

sea={2,8,8,9,9,10,1,1,1,1,1,1,1}
f=0
oxygen=0
score=0
‡=3
Œ=0

function _init()
intro_init()

end

function waves_update()
	f+=1 f=f%10
	if f==0 then
		for i=7,13 do
			sea[i]=1+12*flr(rnd(2))
		end
	end
end

function hud_draw()
	palt(0,false) spr(32,8,106,3,1) palt()
 hs=score.."0"
if (score==0) hs="00"
	for i=1,#hs do
		spr(35+tonum(sub(hs,i,i))
		,72-(#hs*8)+(i*8),0)
 end
 for i=1,‡ do
 	spr(5,24+i*10,8)
 end
 full=false
 if (Œ==6) full=true
 for i=1,Œ do
  pal(13,1)
  if (full and pl.y>29 and time()%1>.5) pal(13,6)
 	spr(22,32+i*9,112)
 end
 pal()
 rectfill(40,107,100,111,8)
 if (oxygen<20 and time()%1>.5) sfx(6,1) pal(7,0)
 rectfill(40,107,40+oxygen,111,7)
 
end
-->8
--player 

function player_init()
 pl={x=64,y=28,flp=false,f=0}
 full=false
end

function player_update()
	pl.f+=.2 pl.f=pl.f%2
	if (btn(ƒ)) pl.y+=1
	if (btn(”)) pl.y-=1
	if (btn(‹)) pl.x-=1 pl.flp=true
	if (btn(‘)) pl.x+=1 pl.flp=false
	if (btnp(Ž) or btnp(—)) torp_init()
	pl.y=mid(28,pl.y,92)
	pl.x=mid(16,pl.x,110)
	if (pl.y<29) oxygen+=.5-.1*Œ sfx(2,2,oxygen/2)
	if (pl.y>29 or oxygen>=60) oxygen-=.01+Œ/100 sfx(-1,2)
	
	if Œ>0	and pl.y<29 
	and time()%.5==0 and oxygen<60
	then sfx(8,1) Œ-=1 score+=5 end
	oxygen=mid(0,oxygen,60)
	if (oxygen==0) dead_init()
end

function player_draw()
	spr(1+2*flr(pl.f),pl.x-8,pl.y-4,2,1,pl.flp)
end

torps={}

function torp_init()
	if pl.y>29 then
		torp={}
		if #torps<2 then
			torp.x=pl.x
			torp.y=pl.y
			torp.xd=5
			if (pl.flp) torp.xd=-5
			add(torps,torp)
			sfx(0) sfx(1)
		end
	end
end

function torp_update(o)
	o.x+=o.xd
	if (o.x<0 or o.x>128) del(torps,o)
end

function torp_draw(o)
	spr(21,o.x-4,o.y-4)
end

function col(a,b)
	for o in all(b) do
		if abs(a.x-o.x)<8
		and abs(a.y-o.y)<6
		then return true end
	end
end

function colplayer(o)
	if abs(pl.x-o.x)<8
		and abs(pl.y-o.y)<6
		then return true end
end
-->8
--shark/subs/divers

function diver_init()
		for i=45+flr(rnd(20)),90-flr(rnd(20)),16 do
		diver={}
		diver.x=-8+136*flr(rnd(2))
		if (diver.x>127) diver.xd=-.5 diver.flp=true
		if (diver.x<0) diver.xd=.5 diver.flp=false
		diver.y=i
		diver.f=0
		add(divers,diver) end
end

function diver_update(o)
	o.x+=o.xd
	o.f+=o.xd/4 o.f=o.f%2
	if (o.x<-10 or o.x>150) del(divers,o)
 if (colplayer(o) and Œ<6) Œ+=1 sfx(4,1) del(divers,o)
end

function diver_draw(o)
	spr(6+o.f,o.x-4,o.y-8,1,2,o.flp)
end

--sharks
function shark_init()
	for i=50+flr(rnd(32)),90-flr(rnd(32)),16 do
		s={x=-8+136*flr(rnd(2)),y=i}
		s.f=0
		s.deg=0
		if (s.x>127) s.xd=-.5 s.flp=true	
		if (s.x<0) s.xd=.5 s.flp=false
 	add(sharks,s)	
	end
end

function shark_update(o)
	o.x+=o.xd
	o.f+=o.xd/4 o.f=o.f%2
	o.deg +=0.01
 o.y = o.y + sin(o.deg)/4
	if (o.x<-8 or o.x>136) del(sharks,o)
 if (col(o,torps)) score+=2 sfx(3,1) del(sharks,o)
 if (colplayer(o)) dead_init()
end

function shark_draw(o)
	spr(16+o.f,o.x-4,o.y-4,1,1,o.flp)
end

--subs
function sub_init()
	for i=28+flr(rnd(32)),90-flr(rnd(32)),16 do
		s={x=-8+136*flr(rnd(2)),y=i}
		s.f=0
		s.deg=0
		if (s.x>127) s.xd=-.5 s.flp=true	
		if (s.x<0) s.xd=.5 s.flp=false
 	
 	add(subs,s)
 		
	end
end

function sub_update(o)
	o.x+=o.xd
	o.f+=o.xd/4 o.f=o.f%2
 if (#†<#subs and o.y>30 and time()%2>1) †init(o.x,o.y,o.xd,o.flp)
	if (o.x<-8 or o.x>136) del(subs,o)
	if (col(o,torps)) score+=2 sfx(5,1) del(subs,o)
 if (colplayer(o)) dead_init()

end

function sub_draw(o)
	spr(18+o.f,o.x-4,o.y-4,1,1,o.flp)
end

function †init(_x,_y,_xd,_flp)
	add(†,{
	x=_x,y=_y,
	xd=_xd*1.5,
	flp=_flp})
end

function †update(o)
	o.x+=o.xd
	if (o.x<-16 or o.x>143) del(†,o)
 if (colplayer(o)) dead_init()
end

function †draw(o)
	spr(20,o.x-4,o.y-4,1,1,o.flp)
end



-->8
--game

function game_init()
 sharks={}
 subs={}
 divers={}
 †={}
 oxygen=30
 torps={}
 Œ=0
 player_init()
	_update60=game_update
	_draw=game_draw
end

function game_update()
	player_update()
	waves_update()
	if (time()%5==0 and #subs<3) sub_init()
	if (time()%5==1 and #sharks<3) shark_init()
	if (#divers==0 and Œ!=7) diver_init()
	foreach(torps,torp_update)
	foreach(divers,diver_update)
 foreach(sharks,shark_update)
 foreach(subs,sub_update)
 foreach(†,†update)
end

function game_draw()
 cls()
	rectfill(0,0,127,100,1)
	for i=1,11 do
		line(0,16+i,127,16+i,sea[i])
	end
	rectfill(0,96,127,116,3)
	rectfill(0,104,127,120,6)
	for i=0,100,32 do
	spr(48,i,96,4,1) end
	foreach(torps,torp_draw)
	player_draw()
	foreach(divers,diver_draw)
	foreach(sharks,shark_draw)
	
	foreach(†,†draw)
	foreach(subs,sub_draw)
	line(0,16+12,127,16+12,sea[12])
	line(0,16+13,127,16+13,sea[13])
	line(0,30,127,30,0)
	
	hud_draw()

end

function dead_init()
	sfx(7)
	‡-=1
	exps=12
	f=0
	_update60=dead_update
	_draw=dead_draw
end

function dead_update()
	f+=1
	if (f==10 or f==20 or f==30) exps=12
	if (f==15 or f==25 or f==35) exps=1
	if (f==40) exps=8
	if (f==45) exps=10
	if (f==60) exps=14
	if (f==100 and ‡<=0) title_init()
	if (f==100 and ‡>0) game_init()

end

function dead_draw()
	cls()
	if (f==10 or f==20 or f==30) pal(1,12)
 if (f==15 or f==25 or f==35) pal()
	rectfill(0,0,127,100,1)
	
	for i=1,#sea do
		line(0,16+i,127,16+i,sea[i])
	end
	rectfill(0,96,127,116,3)
	rectfill(0,104,127,120,6)
	for i=0,100,32 do
	spr(48,i,96,4,1) end
	foreach(torps,torp_draw)
	spr(exps,pl.x-4,pl.y-4,2,1,pl.flp)
	foreach(divers,diver_draw)
	foreach(sharks,shark_draw)
	
	foreach(†,†draw)
	foreach(subs,sub_draw)
	line(0,16+13,127,16+13,sea[13])
	line(0,30,127,30,0)
	
	hud_draw()
end
-->8
--title

function title_init()
	sharks={}
 subs={}
 divers={}
 †={}
 torps={}
 oxygen=30
 l=-128
 timeout=time()+10
	player_init()
	diver_init()
	pl.y=64
	_update60=title_update
	_draw=title_draw
end

function title_update()
	waves_update()
	foreach(divers,diver_update)
	l+=1 l=min(l,0)
	pl.x=l+64
	pl.y-=.2
	pl.y=max(28,pl.y)
	pl.f+=.5 pl.f=pl.f%2
	if (btnp(—) or btnp(Ž)) score=0 ‡=3 game_init()
 if (time()>=timeout) intro_init()
end

function title_draw()
	game_draw()
 if time()%8<4 then
	print("1983           steeve cartwright",0,122,13)
 spr(52,17,120,8,1) end
 if time()%8>4 then
	print("  2020 lostcadesoft by bgelais",0,122,13)end
 if (time()%1<.5) print("Ž/— to start",36,86,7)
spr(64,l,40,16,4)
end
-->8
--intro

function intro_init()
	oxygen=30
	l=0
	timeout=time()+12
	_update60=intro_update
	_draw=intro_draw
end

function intro_update()
	l+=1
	waves_update()
	if (time()>=timeout or btnp(—) or btnp(Ž)) title_init()
end

function intro_draw()
	cls()
	rectfill(0,0,127,100,1)
	for i=1,11 do
		line(0,16+i,127,16+i,sea[i])
	end
	rectfill(0,96,127,116,3)
	rectfill(0,104,127,120,6)
	for i=0,100,32 do
	spr(48,i,96,4,1) end
	line(0,16+12,127,16+12,sea[12])
	line(0,16+13,127,16+13,sea[13])
	line(0,30,127,30,0)
	print(sub([[
   your divers have retrieved
  buried treasure, and now you 
   must come to their rescue.

retrieve as many treasure-divers
 as you can, while dodging and
    blasting enemy subs 
         and killer sharks... 

all before your oxygen runs out!
	]],1,l),0,34,7)
 if time()%8<4 then
	print("1983           steeve cartwright",0,122,13)
 spr(52,17,120,8,1) end
 if time()%8>4 then
	print("  2020 lostcadesoft by bgelais",0,122,13)end

	hud_draw()
end
