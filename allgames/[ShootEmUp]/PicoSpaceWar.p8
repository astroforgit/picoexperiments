pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
--initialize
function _init()
 --constants
 laser_range=32
 laser_acc=10
 fuel_efficiency=.1
-- debug={}
 init_stars()
 g_t=0 --game timer
 b_t=0 --blink timer
 select=0
 e_ani={96,98,100,102,104,106,108}
 music(1)
 _upd=start_screen
 _drw=draw_start
end

function start_game()
 g_t=0 --game timer
 b_t=0 --blink timer
 is_game_over=false
 p={x=24,y=24,s=1,c=12,vx=0,
    vy=0,a=90,flame=false,
    fuel=99,shld=99,sh=false,
    fire=false,targ=nil}
 q={x=74,y=94,s=5,c=8,vx=0, 
    vy=0,a=270,flame=false, 
    fuel=99,shld=99,sh=false,
    fire=false,targ=nil}
 ships={p,q}
 init_stars()
 explosions={}
 music(3)
 _upd=play_game
 _draw=draw_game
end

function init_stars()
 stars={}
 for j=1,100 do
  local col
  if rnd(100)<5 then
   col=7
  elseif rnd(100)<15 then
   col=6
  else
   col=5
  end
  add(stars,{x=rnd(128),y=rnd(128),c=col})
 end
end

-->8
--update
function _update()
 _upd()
 g_t+=1
 if g_t%30==0 then
 b_t+=1
 end
end

function start_screen()
 move_stars()
 if btnp(2) then
  if select >0 then
   select-=1
  end
 end
 if btnp(3) then
  if select < 1 then
   select+=1
  end
 end
 if btnp(5) then
  if select==0 then
   start_game()
  end
  if select==1 then
   select=0
   _upd=do_instructions
   _drw=draw_instructions
  end
 end
end

function do_instructions()
 move_stars()
 for j=0,5 do
  if btnp(j) then
   start_game()
  end
 end
end

function play_game()
 check_ded()
 move_stars()
 move_ships() 
 check_torps()
 regen_energy()
 get_input()
end

function check_ded()
 for ship in all(ships) do
  if ship.shld <=0 then
   del(ships,ship)
   ship.fire=false
   ship.flame=false
   if ship==p then
    explode(p)
    is_game_over=true
    _upd=game_over
    music(1)
   end   
   if ship==q then
    explode(q)
    is_game_over=true
    _upd=game_over
    music(1)
   end   
  end
 end
end

function move_stars()
 for star in all(stars) do
  if star.y<128 then
   if star.c==7 then
    star.y+=.125
   elseif star.c == 6 then
    star.y+=.05
   else
    star.y+=.0625
   end
  else
   star.y=0
  end
 end
end

function move_ships()
 for j in all(ships) do
  j.x+=j.vx
  j.y+=j.vy
  if j.x>=120 then
   j.x=-8
  elseif j.x<=-8 then
   j.x=120
  end
  if j.y>=120 then
   j.y=-8
  elseif j.y<=-8 then
   j.y=120
  end
 end
end

function check_torps()
 for ship in all(ships) do
  if ship.targ then
   if dist(ship.x,ship.y,ship.targ.x,ship.targ.y)<=4 then
    ship.shld=0
    ship.targ.shld-=20
    ship.targ.sh=true
    sfx(05)
   end
  end
 end
end

function regen_energy()
 for j in all(ships) do
  if j.fuel < 99 then
   j.fuel+=0.16667
  end
 end
end

function get_input()
 if btn(0,0) then p.a-=15 end
 if btn(1,0) then p.a+=15 end 
 p.a=p.a%360 
 if btn(2,0) then
  burn(p)
 end 
 if btnp(3,0) then
  charge_shields(p)
 end 
 if btnp(4,0) then
  launch_torp(p,q)
 end 
 if btnp(5,0) then
   do_laser(p,q)
 end 
 if btn(0,1) then q.a-=15 end
 if btn(1,1) then q.a+=15 end 
 q.a=q.a%360 
 if btn(2,1) then
  burn(q)
 end 
 if btnp(3,1) then
  charge_shields(q)
 end 
 if btnp(4,1) then
  launch_torp(q,p)
 end 
 if btnp(5,1) then
  do_laser(q,p)
 end 
end

function launch_torp(j,k)
 if j.fuel>=25 then
  j.fuel-=25
  n=add(ships,{s=7,x=j.x+j.vx,y=j.y+j.vy,vx=j.vx,vy=j.vy,fuel=99,shld=2,a=j.a,c=j.c,targ=k})
  for i=1,12 do
   burn(n) 
  end
  n.flame=false
 end
end

function do_laser(j,k)
 if j.fuel>=2 then
  j.fuel-=2
  j.fire=true
  if #ships >= 3 then
   for i=3,#ships do
    if test_hit(j,ships[i]) then
     ships[i].shld-=2
     sfx(4)
    end
   end
  end
  if test_hit(j,k) then
   sfx(0)
   k.sh=true
   k.shld-=2
  else
   sfx(2)
  end
 end
end

function charge_shields(j)
 if j.fuel >=2.5 and j.shld<=98.5 then
  j.fuel-=2.5
  j.shld+=.5
  sfx(03)
 end
end

function burn(j)
 if j.fuel >= 1 then
  j.vx+=-sin(j.a/360)*fuel_efficiency
  j.vy+=-cos(j.a/360)*fuel_efficiency
  j.flame=true
  j.fuel-=1
  sfx(01)
 end
end

function move_exp()
 for j in all(explosions) do
  j.x+=j.vx
  j.y+=j.vy
  if j.x>=120 then
   j.x=-8
  elseif j.x<=-8 then
   j.x=120
  end
  if j.y>=120 then
   j.y=-8
  elseif j.y<=-8 then
   j.y=120
  end
  if e_ani[j.ani] < 108 then
   if g_t%5==0 then
    j.ani+=1
   end
  else
   del(explosions,j)
  end
 end
end

function dist(x1,y1,x2,y2)
 return sqrt((x2-x1)^2+(y2-y1)^2)
end

function test_hit(j,k)
 local dx=j.x-k.x
 local dy=j.y-k.y
 a=atan2(dx,dy)*360+90
 a=a%360
 if dist(j.x+8,j.y+8,k.x+8,k.y+8)<laser_range then
  if a+j.a<360+laser_acc and a+j.a>360-laser_acc then
   return true
  end    
 end 
end

function explode(j)
 add(explosions,{x=j.x,y=j.y,vx=j.vx,vy=j.vy,ani=1})
 sfx(06)
end

function game_over()
 move_stars()
 move_ships() 
 move_exp()
 if btn(5) then
  if btn(4) then
   start_game()
  end
 end
end

-->8
--draw
function _draw()
 _drw()
-- print_debug()
end

function draw_instructions()
 cls()
 draw_stars()
 color(7)
 cursor(1,1)
 print("")
 print("object: destroy your opponent!")
 print("")
 print("controls:")
 print("     ‹‘ rotate left/right")
 print("     ”   thrust")
 print("     ƒ   charge shields")
 print("     —   laser")
 print("     Ž   torpedos")
 print("")
 print("weapons:")
 print(" laser    2 damage    -3 en")
 print(" torpedo  20 damage   -25 en")
 print("")
 print("defense:")
 print(" engine  .25 sec burn -6 en")
 print(" shields +1 sh charge -5 en")
 print("")
 print("reactor: +5 en/sec")
 end

function draw_start()
 cls()
 draw_stars()
 cursor(56,24)
 color(7)
 print("pico")
 spr(64,32,30,8,2)
 cursor(40,62)
 print("play now!")
 print("")
 print("instructions")
 if b_t%2==0 then
  if select==0 then
   spr(72,32,61)
  else
   spr(72,32,73)
  end
 end
 cursor(24,86)
 print("")
 print("press — to continue")
 color(6)
 cursor(2,114)
 print("copyleft 2019 by dale w. morris")
-- color(5)
 print("         dalesworld.ga")
end

function draw_game()
 cls()
 draw_stars()
 draw_lasers()
 draw_shield()
 draw_ships()
 draw_explosions()
 draw_hud()
 if is_game_over then
  draw_gover()
 end
end

function draw_explosions()
 for exp in all(explosions) do
  spr(e_ani[exp.ani],exp.x,exp.y,2,2)
 end
end

function draw_gover()
 color(7)
 cursor(44,40)
 print("game over")
 if p.shld>0 and q.shld<0 then
  color(12)
  print("blue wins!")
 elseif p.shld<0 and q.shld>0 then
  color(8)
  print("red wins!")
 else
  print("nobody wins!")
 end
 color(7)
 cursor(16,52)
 print(" ")
 if b_t%2==0 then
  print("press —+Ž to continue")
 end
end

function draw_shield()
 for j in all({p,q}) do
  if j.sh then
   circ(j.x+8,j.y+8,5,j.c)
   j.sh=false
  end
 end
end

function draw_lasers()
 for ship in all({p,q}) do
  if ship.fire then
   line(ship.x+8,ship.y+8,laser_range*-sin(ship.a/360)+ship.x+8,laser_range*-cos(ship.a/360)+ship.y+8,ship.c)
  end
  ship.fire=false
 end
end

function draw_hud()
 if p.shld>0 then
  color(12)
  cursor(0,1)
  print("en ")
  color(5)
  rectfill(8,3,8+20,4)
  color(12)
  rectfill(8,3,8+20*p.fuel/99,4)
  cursor(0,7)
  print("sh ")
  color(5)
  rectfill(8,9,8+20,10)
  color(12)
  rectfill(8,9,8+20*p.shld/99,10)
  color(8)
 end
 if q.shld>0 then
  cursor(98,1)
  color(8)
  print("en ")
  color(5)
  rectfill(108,3,108+20,4)
  color(8)
  rectfill(108,3,108+20*q.fuel/99,4)
  cursor(98,7)
  print("sh ")
  color(5)
  rectfill(108,9,108+20,10)
  color(8)
  rectfill(108,9,108+20*q.shld/99,10)
 end
end

function draw_stars()
 for star in all(stars) do
  pset(star.x,star.y,star.c)
 end
end

function draw_ships()
 for j in all(ships) do
  if j.flame then
  spr_r(3,j.x,j.y,j.a,2,2)
  end
  spr_r(j.s,j.x,j.y,j.a,2,2)
  if j.targ then
   pset(j.x+8,j.y+8,j.c)
  end
  j.flame=false
 end
end

--function print_debug()
-- color(8)
-- for j=1,#debug do
--  cursor(0,j*6)
--  print(debug[j])
-- end
--end

function spr_r(s,x,y,a,w,h)
 sw=(w or 1)*8
 sh=(h or 1)*8
 sx=(s%8)*8
 sy=flr(s/8)*8
 x0=flr(0.5*sw)
 y0=flr(0.5*sh)
 a=a/360
 sa=sin(a)
 ca=cos(a)
 for ix=0,sw-1 do
  for iy=0,sh-1 do
   dx=ix-x0
   dy=iy-y0
   xx=flr(dx*ca-dy*sa+x0)
   yy=flr(dx*sa+dy*ca+y0)
   if (xx>=0 and xx<sw and yy>=0 and yy<=sh) then
    if sget(sx+xx,sy+yy) !=0 then
     pset(x+ix,y+iy,sget(sx+xx,sy+yy))
    end
   end
  end
 end
end
