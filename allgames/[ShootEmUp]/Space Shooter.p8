pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- space shooter
-- sdy 2017/01/13 v1.00

-- 2017/01/13 sdy v1.00
-- 2017/01/01 sdy v0.03
-- 2016/31/12 sdy v0.02
-- 2016/29/12 sdy v0.01

-- inspired by (based on):
-- space shooter in 16 gifs
-- https://ztiromoritz.github.io/pico-8-shooter/


-- with inspiration/code from:

-- music
-- http://www.robbyduguay.com/2015/11/sharing-music-between-pico-8-carts/
--  6 - melancholy, 33-36
--  7 - mission, 37-42
--  8 - hijinx, 43-52
--  9 - out of control, 53-62

-- rotating star field

-- space shooter title
-- zep "hello world"

-- code notes:

-- had lots of chars/symbols, so used long varnames
-- uses global variables of course
-- functions have side effects
-- very little error checking

-- this code is *not* intended
-- to show best practices for
-- coding or pico-8.

-- game name considerations:
-- space shooter
-- silly space shooter
-- stupid space shooter
-- space turds


function _init()
 init()  -- defined
end

function _draw()
 draw() -- redefined later
end

_update = nil -- do not use 30fps
_fps = 0 -- frame counter
fps = 2  -- _fps mod this = draw

function _update60()
 _fps += 1
 if (_fps%fps != 0) return
 update() -- redefined later
end

-- called only once at startup
function init()

 -- return if called again
 if (_global_init) return
 assert(not _global_init)
 _global_init = true

 -- set cart data name
 cartdname = "sdy_1_simple_space_shooter_1__1483054074"
 cartdata(cartdname)

 init = 0
 menu = 1
 play = 2
 over = 3
 
 -- get things started ...
 gm = init
 game_mode(gm)
  
end

function game_mode(ngm)

 if (ngm < 0) ngm = 0
 if (ngm > 3) ngm = 0
 
 if (ngm == init) then
  update = nil
  draw = nil
  doit = game_init
 elseif (ngm == menu) then
  update = update_menu
  draw = draw_menu
  doit = game_menu
 elseif (ngm == play) then
  update = update_game
  draw = draw_game
  doit = game_play
 elseif (ngm == over) then
  update = update_over
  draw = draw_over
  doit = game_over
 end
 
 lgm = gm
 gm = ngm
 
 doit()
 
end


-- mode 0 :  game init

function game_init()

 -- global timer
 t = 0
  
 swarp = 0
 warp = swarp -- used for "level"
 
 -- wave movement delta factor
 wdx = {1,2,1,2,2,4,4,5,6,8}
 wdy = {1,1,2,2,4,2,4,5,6,8}
  
 ship = {
  sp=1, -- sprite
  x=32+rnd(64),
  y=92+rnd(16),
  h=3, -- health
  mxh=3, -- max health
  p=0, -- ship/player score
  t=0, -- ship timer
  te=0, -- game over time check
  imm=false, -- ship protected
  box={x1=0,y1=0,x2=7,y2=7},
  sf=0,
  sh=0, 
 }
 
 fire_hack = false -- unlimited fire
 
 game_mode(menu)
 
end


-- mode 1 :  game menu

function game_menu()
 fps = 1 -- 60 fps
 if (lgm != over) then
  music(33,10000)
 end
 mstars_init()
 tm = t+90
end
 
function update_menu()

 t += 1
 
 mstars_update()
 
 if (btnp(0)) ship.mxh-=1
 if (btnp(1)) ship.mxh+=1
 if (btnp(2)) swarp+=1
 if (btnp(3)) swarp-=1
 
 if (ship.mxh < 1) ship.mxh = 1
 if (ship.mxh > 10) ship.mxh = 10 
 ship.h = ship.mxh

 if (swarp < 1) swarp = 1
 if (swarp > 10) swarp = 10
 
 if btn(4) then
  fps = 1 -- every frame -- 60 fps
  game_mode(play)
 end
 
 if btn(5) then
  fps = 2 -- every other frame -- 30 fps
  -- 1/2 speed for kids?
  -- fps = 3 = 1/3 speed = slooow
  game_mode(play)
 end
 
 -- hack for unlimited fire
 if (btnp(5,1)) fire_hack = not fire_hack
 
 if (btnp(0,1)) game_mode(over)
 
end

function draw_menu()

 cls()
 
 mstars_draw()
 
 -- from "hello world"
 for i = 1,13 do
  for j0 = 0,0 do -- no tail effect
   j = 7-j0
   col = 7+j
   t1 = t + i*4 - j*2
   x = cos(t0)*5
   y = 28 + j + cos(t1/50)*5
   col = flr(rnd(15)+1)
--  gray for shadows? ugly.
--  if (j0<6) col=7
--  if (j0<4) col=6
--  if (j0<2) col=5
  
   pal(7,col)
   spr(48+i, i*8 + x, y)
  
  end
 end
 
 print("play: Ž normal",32,74,6)
 print("      — easy",32,84,6)
 
 print("warp "..swarp,54,120,5)
 
 for i = 1,ship.mxh do
  spr(33,58-(ship.mxh*4)+8*i,106)
 end 
 
 if fire_hack then
  spr(3,60,96)
  spr(3,62,94)
  spr(3,64,96)
 end
 
 if (t < tm) then
  print("simple game, stupid name",16,1,5)
 elseif (t < tm+90) then
  print("sdy 2017/01/13 v1.00",24,1,5)
 end 
  
end


-- mode 2 :  game play

function game_play()

 music(37,10000,7)
 sfx(15) -- warning
 
 warp = swarp
 
 -- reset some game play items
 
 t = 0
 
 stars = {} -- background
 lasers = {} -- enemy shots
 bullets = {} -- player shots
 enemies = {} -- enemies
 asteroids = {} -- asteroids
 
 explosions = {} -- big badda booms
 
 ship.x = 32+rnd(64)
 ship.y = 92+rnd(16)
 ship.h = ship.mxh
 ship.p = 0 -- score/points
 ship.t = 0 -- timer for ship
 ship.te = 0 -- t > te = game over
 ship.sf = 0 -- shots fired
 ship.sh = 0 -- shots hit
 ship.imm = false -- protected
 
 respawn() -- enemies
  
 init_stars() -- background

 
end

function update_game()

 t = t+1

 if (ship.te > 0 and t > ship.te ) game_mode(over)
 
 -- ship can not take damage
 if ship.imm then
  ship.t += 1
  if ship.t > 30 then
   ship.imm = false
   ship.t = 0
  end
 end
 
 -- play field background stars
 for star in all(stars) do
  star.y += star.s*(warp*0.1)
  star.x += star_skew
  if star.y >= 128 then
   star.y = 0
   star.x = rnd(128)
  end
 end
 
 -- explosions
 for ex in all(explosions) do
  ex.t += 1
  if (ex.t > ex.te) del(explosions, ex)
 end
 
 -- check enemies
 if #enemies <= 0 then
 
  if (warp > 0) ship.p += flr(rnd(100))
  
  warp += 1 -- next wave!
  sfx(15) -- alarm
  
  -- set music for level(s)
  if (warp == 3) music(37,5000)
  if (warp == 5) music(43,4000)
  if (warp == 10) music(53,3000)

  respawn() -- make next wave!
  
  if (warp%3 == 0) then
   sfx(16) -- reward bells
   ship.h += 1 -- extra life every 5 waves
  end
  
 end
 
 -- update enemies
 for e in all(enemies) do
 
  -- make enemies zoom off bottom
  local dy = 0.0
  if (e.y > ship.y+30) dy = warp/2
  
  e.m_y += 0.25+dy+(warp/12) -- (t%127)/120
  
  -- enemy radius for x and y
  local rx = ((t*e.dx)%360)/360
  local ry = ((t*e.dy)%360)/360
  
  e.x = (e.r*sin(rx)) + e.m_x
  e.y = (e.r*cos(ry)) + e.m_y
  
  -- enemy colliding player?
  if (ship.te == 0) then
   if coll(ship,e) and not ship.imm then
    sfx(13) -- player hit
    ship.imm = true -- protect
    ship.h -= 1 -- lose 1 heart
    del(enemies,e)
    explode(ship.x+4,ship.y+4)
    if (ship.h <= 0) explode_player_ship()
   end
  end
  -- enemy fire? fire in batches
  if (ship.te == 0) and
   (rnd() > 1.0-(warp/300)) and 
   #lasers < 1+flr((warp/5)) and
   e.y < (ship.y-32) then

   sfx(11) -- enemy fires laser
   
   -- get direction to player
   local ldx = abs(ship.x-e.x)
   local ldy = abs(ship.y-e.y)

   local l = {
    sp=4,
    x=e.x+2,
    y=e.y,
    dx=sgn(ship.x-e.x)*((ldx/ldy)/flr(1+rnd(12/warp))), -- aim closer at higher levels
    dy=0.75+rnd(e.c+flr(warp/6)),
    box = {x1=2,y1=2,x2=3,y2=4}
    }
   add(lasers,l)
   
  end
 
  -- enemy off bottom?
  -- 150 arbitrary but gives some
  -- range > 127 for ships to loop back from off bottom!
  if e.y > 150 then
   e.m_y = -50 -- loop to attack again!
   -- del(enemies,e) -- delete for single pass? lame.
  end
 
 end
 
 -- player shots (ie: bullets)
 for b in all(bullets) do
 
  b.x += b.dx -- move bullet x
  b.y += b.dy -- move bullet y
  
  -- delete if off screen
  if b.x < 0 or b.x > 128 or
   b.y < 0 or b.y > 128 then
   del(bullets,b)
  end
  
  -- player shot hit enemy ship?
  for e in all(enemies) do
   if coll(b,e) then
    sfx(12) -- default explosion
    del(enemies,e)
    del(bullets,b)
    ship.p += flr(e.c*3)+flr((130-(ship.y-e.y))/10)
    ship.sh += 1
    explode(e.x+4,e.y+4)
   end
  end
  
  -- bullet hits asteroid?
  for a in all(asteroids) do
   if coll(b,a) then
    del(bullets,b)
    a.dx = -a.dx+rnd(abs(b.dx)/2)
    a.dy -= rnd(abs(b.dy)/5)
    if (a.sp == 5) then -- large = split
     sfx(14) -- bonk sound
     for i = 0,1+rnd((warp+4)/4) do
      split_asteroid(a)
     end
    else -- if small already, explode
     sfx(12) -- standard explosion    explode(a.x+4,a.y+8)
     del(asteroids,a)
    end
   end
  end
  
 end

 for l in all(lasers) do
 
  l.x += l.dx -- move laser x
  l.y += l.dy -- move laser y
  
  -- delete if offscreen(+)
  if l.x < -8 or l.x > 136 or
   l.y < -8 or l.y > 136 then
   del(lasers,l)
  end
  
  -- enemy laser hit player?
  if (ship.te == 0 ) then
   if coll(ship,l) and not ship.imm then
    sfx(13) -- player ship bewm!
    ship.imm = true -- protect!
    ship.h -= 1 -- lose heart
    del(lasers,l)
    explode(ship.x+4,ship.y+4)
    if (ship.h <= 0) explode_player_ship()
   end
  end
  
  -- laser hit asteroid?
  for a in all(asteroids) do
  
   if coll(a,l) then
    sfx(14) -- bonk sound
    a.dx = -a.dx+rnd(abs(l.dx)/3)
    a.dy += rnd(abs(l.dy)/4)
    for i = 0,2+rnd((warp+4)/4) do
      split_asteroid(a)
    end
    explode(a.x+4,a.y+8)
    del(lasers,l)
   end
   
   -- turd hit other turd?
   for aa in all(asteroids) do
    if (a != aa) then -- don't collide with myself!
      if coll(a,aa) then
       if (a.sp == 5) then
        a.sp = 6 -- force split
        split_asteroid(a)
       else
        a.dx = sin(rnd(360))
        a.dy = cos(rnd(360))
       end
       if (aa.sp == 5) then
        aa.sp = 6 -- force split
        split_asteroid(aa)
       else
         aa.dx = sin(rnd(360))
         aa.dy = cos(rnd(360))
       end
      end
    end
   end
   
  end
  
  
 end
 
 if #asteroids < 1+(warp/5) then
   if (rnd() > 0.95+rnd((30-warp)/850)) then
    add(asteroids, {
     c=c,
     sp=5,
     x=32+rnd(64),
     y=-rnd(32),
     dx=0.1+sin(rnd(180))/5,
     dy=0.1+cos(rnd(180))/2,
     box = {x1=3,y1=1,x2=6,y2=6}
    })
   end
 end
 
 -- update all assturdroids
 for a in all(asteroids) do
 
  a.x+=a.dx -- move turd x
  a.y+=a.dy -- move turd y
  
  if (ship.te == 0) then
   if coll(ship,a) and not ship.imm then
    ship.imm = true -- protect
    ship.h -= 1 -- lose heart
    del(asteroids,a)
    explode(ship.x+4,ship.y+4)
    a.dx = -a.dx
    a.dy = a.dy/2
    if (ship.h <= 0) explode_player_ship()
   end
  end
  if a.x < -8 or a.x > 136 or
   a.y < -16 or a.y > 136 then
   del(asteroids,a)
  end
  
  -- turd hits enemy ship?
  for e in all(enemies) do
   if coll(a,e) then
    del(enemies,e)
    a.dx = -a.dx
    a.dy = a.dy*2
    explode(e.x+4,e.y+8)
   end
  end
  
 end

 if (t%8<4) then
  ship.sp = 1
 else
  ship.sp = 2
 end
 
 -- ship movement based on warp
 dm = 0.5+0.25*flr(warp/2)
 if (btn(0)) ship.x -= dm
 if (btn(1)) ship.x += dm
 if (btn(2)) ship.y -= dm
 if (btn(3)) ship.y += dm
 
 -- keep ship in bounds
 if (ship.x < 0) ship.x = 0
 if (ship.y < 16) ship.y = 16 
 if (ship.x > 120) ship.x = 120
 if (ship.y > 120) ship.y = 120
 
 -- fire
 if (ship.te == 0) then
  if (btn(4)) fire() -- fast
  if (btnp(5)) fire() -- throttled
 end
 
end


function draw_game()

 cls()

 -- draw all stars in background
 for st in all(stars) do
  local c = 5+st.c
  if (st.c > 1) then -- twinkle
   if (rnd() > 0.8) c = rnd(16)
  end
  pset(st.x,st.y,c)
 end
 
 -- draw all turds
 for a in all(asteroids) do
  local fx = (rnd()>0.90)
  local fy = (rnd()>0.90)
  spr(a.sp,a.x,a.y,1,1,fx,fy)
 end

 -- display score
 print(ship.p,9,5,7) -- 1+t%16)
 
 -- display warp
 print(warp,120,5,5)
 
 -- draw ship
 if (ship.te == 0) then
  if not ship.imm or t%8 < 4 then
   pal(4,5+(t%5),0)
   spr(ship.sp,ship.x,ship.y)
  end
 end
 
 -- draw all explosions
 for ex in all(explosions) do
  local r = ex.t/6 -- radius grows
  if (rnd() < 0.8) then
   circ(ex.x,ex.y,r,8+ex.t%3)
  else
   circ(ex.x,ex.y,r,t%16)
  end
  for i = 1,4 do
   nr = r*1.2 -- radius modifier
   a = rnd(360)
   x1 = sin(a)*rnd(nr*nr)
   y1 = cos(a)*rnd(nr*nr)
   c = rnd(6)
   pset(ex.x+x1,ex.y+y1,5+c)
   end
 end
  
 -- draw all bullets
 for b in all(bullets) do
  pal(4,5+(t%5),0)
  spr(b.sp,b.x,b.y)
 end
 
 -- draw all enemy lasers
 for l in all(lasers) do
  pal(4,5+(t%5),0)
  spr(l.sp,l.x,l.y)
 end
 
 -- draw all enemies
 for e in all(enemies) do
  pal(4,(t%16),0)
  spr(e.sp,e.x,e.y)
 end
 
 -- draw hearts
 for i = 1,ship.mxh do
  if i <= ship.h then 
   spr(33,112-8*i,3)
  else
   spr(34,112-8*i,3)
  end
 end
 
 if (ship.te > 0) then
   print("game over",46,60,8)
 end
 
 pal()
 
end

-- mode 3 :  game over

function game_over()

 music(33,12000)
 -- should make game_mode credits
 -- but i use over to do 2 things
 om = 0 -- over mode 1 or 2
 
 tm = t+500 -- switch to om 2
 cydy = 0.01 -- scroll modifier
 
 ti = t+200 -- block input until
 
 score = ship.p
 highscore = dget(0)
 highwarp = dget(1)
 highpct = dget(2)
 pct = 0
 if (ship.sf > 0) pct=(((ship.sh)*100)/(ship.sf))
 
 -- if not cheating, is this a new high score?
 if (not fire_hack) and (fps == 1) and (score>highscore) then
 
  dset(0,score) -- cart save
  highscore = score
  
  highwarp = warp
  dset(1,highwarp) -- cart save
  
  highpct = pct
  dset(2,highpct) -- cart save
  
 end
 
 -- turn numbers into strings
 ss = ""..score
 hss = ""..highscore
 ws = ""..warp
 hws = ""..highwarp
 pcts = ""..pct
 hpcts = ""..highpct
 
 mstars_init() -- rotating stars
 
 cy = 132 -- credits y, for scrolling from bottom to top
 
end

function update_over()

 t += 1
 
 mstars_update()
 
 if (om == 0 ) then -- high score mode
  if (t > tm) om = 1 -- switch to credits
  if (t > ti) then
   --  allow contine?
   --  if btnp(0) then game_mode(play) end -- continue?
   if (btn(1)) then
    om = 1
    ti = t+100
   end
   if (btn(5)) game_mode(play)
    
   -- reset cart data
   if btnp(3,1) then
    highscore = 0
    highwarp = 0
    highpct = 0
    hss = ""..highscore
    hws = ""..highwarp
    hpcts = ""..highpct
    dset(0,highscore) -- high score
    dset(1,highwarp) -- high accuracy
    dset(2,highpct) -- high warp
   end
  end
 elseif (om == 1) then
  cy -= (0.25+cydy)
  if (cy<-310) om = 2
  if (cy>140) om = 2
  if (t > ti) then
   if btn(0) then
    om = 0
    tm = t+500
   end
   if (btn(1)) om = 2
   if (btn(2)) cydy += 0.02
   if (btn(3)) cydy -= 0.02
   if (btn(5)) game_mode(play)
  end
 end
 
 if (om == 2) game_mode(menu)

end

function draw_over()

 cls()
 
 mstars_draw()

 if (om == 0) then
   draw_over_scores()
 else
   draw_over_credits()
 end
 
end

function draw_over_scores()

 print("game over",50,16,8)
 
 local c = 7
 if (fps != 1) c=5

 -- player
 print("player",56,36,7)
  
 if (score == highscore) c = 1+t%16 -- twinkle
 
 print("score",32,44,6)
 print(ss,98-#ss*4,44,c)
 
 print("accuracy",32,52,6)
 print(pct.."%",98-#pcts*4,52,c)
 
 print("warp",32,60,6)
 print(ws,98-#ws*4,60,c)

 -- best
 c = 6
 print("best",60,72,7)

 print("score",32,80,6)
 print(hss,98-#hss*4,80,c)
 
 print("accuracy",32,88,6)
 print(hpcts.."%",98-#hpcts*4,88,c)

 print("warp",32,96,6)
 print(hws,98-#hws*4,96,c)


 print("press — to play again",24,120,5)

end

function draw_over_credits()

 local cc = 7

 local lc = 8
 local rc = 124
 local ccy = cy

 cc = 7
 print(" credits ",14,ccy,cc)

 cc = 6
 ccy += 32
 print("pico-8",lc,ccy,cc)
 cc = 7
 s = "zep"
 print(s,rc-#s*4,ccy,cc)

 cc = 5
 ccy += 16
 print("inspiration",lc,ccy,cc)
 cc = 6
 s = "moritz rebbert" 
 print(s,rc-#s*4,ccy,cc)

 cc = 5
 ccy += 16
 print("music",lc,ccy,cc)
 cc = 6
 s = "robbie duguay"
 print(s,rc-#s*4,ccy,cc)

 cc = 5
 ccy += 16
 print("( see code for full credits )",lc,ccy,cc)

 cc = 6
 ccy += 64
 print("this cart",lc,ccy,cc)
 cc = 1+t%16 -- twinkle
 s = "scott d. yelich"
 print(s,rc-#s*4,ccy,cc)

 cc = 1+t%16 -- twinkle
 ccy += 120
 print("thank you for playing ...",24,ccy,cc)

end

--  rotating star field

function mstars_init()
 mstars = {}
 s_limit = 600
 s_count = 0
 r = 0
 m = 0
 fc = {1,5,6,7}
end
 
function mstars_update()

 for x = 0,10 do
  mstars_new()
 end
 
 r = (r+0.001)%1
 m = (m+0.001)%1
 
 for s in all(mstars) do
  s.z += s.z*0.05
  s.s += 0.2
  s.c = fc[min(flr(s.s),3)]
  s.xs += cos(m)*0.02
  s.ys += sin(m)*0.02
  s.x = ((cos(s.a+sin(r)*0.09)+s.xs)*s.d)*s.z
  s.y = ((sin(s.a+sin(r)*0.09)+s.ys)*s.d)*s.z
  if (s.z > 10) then
   del(mstars,s)
   s_count -= 1
  end
 end
 
end
  
function mstars_draw()

  for s in all(mstars) do
-- pset(s.x+64,s.y+64,s.c)
  local c=s.c
--  if (rnd() > 0.95) c=rnd(16) -- twinkle
  pset(s.x+64,s.y+64,c)
 end
 
end

function mstars_new()

 if (s_count >= s_limit ) return
 
 local s = {}
 s.z = 1
 s.a = rnd(1)
 s.d = rnd(200)+2
 s.x = cos(s.a)*s.d
 s.y = sin(s.a)*s.d
 s.xs = 0
 s.ys = 0
 s.s = 0
 s.c = 7
 s_count += 1
 
 add(mstars,s)
 
end


-- helper functions

function init_stars()
 
 for i = 1,10+rnd(warp*5) do
  local r = rnd()
  local z = 0
  if (r>0.5) z = 1
  if (r>0.85) z = 2
  add(stars, {
   x = rnd(128),
   y = rnd(128),
   s = rnd(3)+1,
   c = z
  })
 end 
  
end

-- create new wave of enemy ships
function respawn()

 -- lame side effect here!
 -- this make background stars
 -- direction change slightly
 -- and has nothing to do with
 -- the enemies
 star_skew = 0.25-(rnd()/2)
 
 local n = 3+flr(rnd((warp/3)*2))
 for i = 1,n do
  local d = -1
--  if rnd(1)<0.5 then d=1 end
  local c = flr(rnd(warp/3)%3)
  local bx = {x1=2,y1=0,x2=5,y2=5}
  if (c == 1) bx = {x1=1,y1=0,x2=6,y2=7}
  if (c == 2) bx = {x1=0,y1=0,x2=7,y2=7}
  local wave = ((warp-1)%10)+1
  add(enemies, {
   c=c,
   sp=17+c, -- (rnd(10)%3),
--   m_x=64+(i*(4*(1-(i%2)*2))),
   m_x=8+rnd(112),
   m_y=-70+rnd(40),
   d=d,
   x=-32,
   y=-32,
   r=12+rnd((4*(c+1))+warp*2),
   dx=2+rnd(wdx[wave]),
   dy=2+rnd(wdy[wave]),
--   dy=1+rnd((rdy*(c+1))),
   box = bx
  })
 end

end

function explode_player_ship()
 ee = 120+rnd((120))
 add(explosions,{x=ship.x+4,y=ship.y+4,t=0,te=ee})
 ship.te = t+ee -- end game at this time
end

-- collision detection helper
function abs_box(s)

 local box = {}
 
 box.x1 = s.box.x1 + s.x
 box.y1 = s.box.y1 + s.y
 box.x2 = s.box.x2 + s.x
 box.y2 = s.box.y2 + s.y
 
 return box

end

-- collision detection
--  by intersection rectangles
function coll(a,b)

 local box_a = abs_box(a)
 local box_b = abs_box(b)
 
 if box_a.x1 > box_b.x2 or
    box_a.y1 > box_b.y2 or
    box_b.x1 > box_a.x2 or
    box_b.y1 > box_a.y2 then
    return false
 end
 
 return true
 
end

-- simple helper to add to explosions
function explode(x,y)
 add(explosions,{x=x,y=y,t=0,te=18+rnd(12)})
end

-- turdsplosion
function split_asteroid(a)

 -- throttle if too many
 -- 12 is arbitrary. i've used 10 to 50 just fine
 if (#asteroids>12) return

 -- split this large asteroid?
 if (rnd() >0.80+(warp/100)) then
  a.sp = 6
 end

 -- split off smaller one
 add(asteroids, {
  c=c,
  sp=6,
  x=a.x+1-rnd(3),
  y=a.y+1-rnd(3),
  dx=-a.dx+sin(rnd(180))/4,
  dy=a.dy+cos(rnd(180))/2,
  box={x1=2,y1=2,x2=4,y2=4}
 })
end
 
-- fire buller from player ship
function fire()
 
 -- max bullets 
 local max_fire = (warp/5)
 if (fire_hack) max_fire=200 -- cheater!

 -- throttle # of bullets
 if (#bullets > max_fire) return
 
 sfx(10) -- player ship fires
 
 ship.sf += 1 -- shots fired
 
 local b = {
  sp=3,
  x=ship.x,
  y=ship.y,
  dx=0,
  dy=-(1+warp/3), -- faster at higher warp
  box = {x1=2,y1=0,x2=5,y2=4}
 }
 
 add(bullets,b)
 
end

-- that's all, folks!

-- thanks for playing!

-- thanks for reading!



