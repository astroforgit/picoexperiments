			spawn_enemy (rnd(120)+4,rnd(112),0,0)
					end		end


end

function s_rnd_angle()
				local rndx = rnd(120)+4
				local rndy = rnd(64)
				spawn_enemy (rndx,rndy)
				spawnbullet(rndx, rndy,rnd(25)/100-0.50+0.125)
				
end

function s_aimed()

				local rndx = rnd(120)+4
				local rndy = rnd(96)
				spawn_enemy (rndx,rndy)
				spawnaimbullet(rndx, rndy,ship.x,ship.y)
				

end
