			c_color=1	end
			
		if(rnd_c>=5)then 
		level_color=1 
			c_color=13	end		
	
	if(rnd_c>=6)then 
	level_color=5 
		c_color=0	end

	if(rnd_c>=7)then 
	level_color=0 
		c_color=5	end

--level_color=0


if(white_back<-7 and white_back>-15 ) then


for t=1,3 do

create_back_object(c_color,128)
create_back_object(level_color,128)
create_back_object(c_color,32)
create_back_object(level_color,32)


end
 end
 
 
end


