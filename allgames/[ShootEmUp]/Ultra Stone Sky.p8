				local rndx = rnd(120)+4
				local rndy = rnd(64)
				spawn_enemy (rndx,rndy)
				spawnaimbullet(rndx, rndy,ship.x,ship.y)
				spawn_enemy (rnd(120)+4,rnd(96))
				spawn_enemy (rnd(120)+4,rnd(96))
					end		end

--2- 1 shooter. 2 aim offset
		if (pattern==2 or pattern2==2 or pattern3==2 or patterndx==2)then
			if(t%30==1) then

				local rndx = rnd(120)+4
				local rndy = rnd(64)
				spawn_enemy (rndx,rndy)
				spawnaimbullet(rndx,rndy,ship.x,ship.y)
				
				local rndx2 = rnd(120)+4
				local rndy2 = rnd(64)
				spawn_enemy (rndx2,rndy2)
				spawnaimbullet(rndx2,rndy2,ship.x+32,ship.y)

				local rndx3 = rnd(120)+4
				local rndy3 = rnd(64)
				spawn_enemy (rndx3,rndy3)
				spawnaimbullet(rndx3,rndy3,ship.x-32,ship.y)
			end		end
			
--3-- 1 fast shooter
		if (pattern==3 or pattern2==3 or pattern3==3 or patterndx==3)then
			if(t%15==1) then
