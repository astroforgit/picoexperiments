				turret1y = rnd(64)
				spawn_enemy (turret1y,turret1y)
				spawn_enemy (rnd(120)+4,rnd(96))
				--spawn_enemy (rnd(120)+4,rnd(96))

				
				end
				if(t%10==1) then
				spawnaimbullet(turret1y, turret1y,ship.x,ship.y)
							end			end

	--6- 4x turret
		if (pattern==6 or pattern2==6 or pattern3==6 or patterndx==6)then
			if(t%60==1) then
				turret1x = rnd(120)+4
				turret1y = rnd(64)
				spawn_enemy (turret1y+4,turret1y+4)
				spawn_enemy (turret1y-4,turret1y-4)
				spawn_enemy (turret1y-4,turret1y+4)
				spawn_enemy (turret1y+4,turret1y-4)


				end
				if(t%16==1) then
				spawnaimbullet(turret1y-4, turret1y+4,ship.x,ship.y)
