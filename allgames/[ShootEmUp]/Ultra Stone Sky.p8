--init
function _init()

	game_state=0

	pattern=0
	pattern2=0
	pattern3=0
	patterndx=-1
	patterndxs={4,5,6,7,8,9,4,5,6,7,8,9}
	
	
	sequence=0
	s_t=0
	arr_pattern=1
	
	level_color=0
	rnd_c=0
	white_back=0
	deaths=0
	
	score=0
	top_score=0
	shake=0
	t=0
	time=0
	progress=0
	level_goal=20
	level=0
	mode_life=0
	lives=5
	hold_b=1
	
	fade_effect=0
	fade_black=0
	c_color=0
	
	bullet_speed=3
	
	turret1x=0
	turret1y=0	
	
	turret_angle=0
	
	ship = {sp=1,x=60,y=120-1,speed =4}
	bullets = {}
	enemies = {}
	aimbullet = {}
	spawneffect = {sp=7,x=0,y=0,t=0}
	explosion = {}
	back_object={}
	sequences={
	
	--{{-2,-2,-2},{-2,-2,-2},{-2,-2,-2},{-2,-2,-2}},
	{{1,6,-1},{-2,-1,10},{5,6,10},{-1,6,10}},
	{{2,5,-1},{2,-1,-1},{1,5,-1},{0,5,-2}},
	{{1,-1,10},{1,7,10},{-1,7,-1},{1,7,10}},
	{{4,1,10},{4,9,-1},{-1,9,10},{4,9,-1}},
	{{0,-1,7},{0,6,1},{5,6,7},{5,0,1}},
	{{1,10,7},{2,4,-1},{2,4,7},{10,0,4}},
	{{5,8,3},{5,4,10},{5,8,3},{9,8,0}},
	{{2,5,8},{7,8,10},{2,5,8},{7,5,0}},
	{{3,4,5},{10,9,5},{3,4,5},{7,5,0}},
	{{1,5,9},{9,7,6},{1,5,9},{0,2,10}},
	{{1,5,9},{9,7,6},{1,5,9},{0,2,10}}

	}
	
	
	dbg="empty "
		music(10)
	max_music_notes=0
	max_notes=509

end


function create_back_object(color,size)

local b = {
		
		x=rnd(128),
		y=rnd(128),
		w=rnd(size),
		h=rnd(size),
		c=color,
		dx=(rnd(100)-50)/1000,
		dy=(rnd(100)-50)/1000
		--dy=-(rnd(50))/1000
	}
	add(back_object,b)
	

end

function spawnaimbullet(start_x,start_y,aimpos_x,aimpos_y,s_speed)

	local b = {
		sp=5,
		x=start_x,
		y=start_y,
		dx=bullet_speed,
		dy=bullet_speed,
				--angle=rnd(100)/100
	}
	add(aimbullet,b)
	
	sfx(16,2)

	--aim bullet towards player
	aimbullet[count(aimbullet)].angle= atan2(aimpos_x -aimbullet[count(aimbullet)].x, aimpos_y - aimbullet[count(aimbullet)].y)
local randomc=rnd(4)
local sprite=0

if (randomc>=0) then sprite=5 end
if (randomc>=1) then sprite=21 end
if (randomc>=2) then sprite=37 end
if (randomc>=3) then sprite=53 end

sprite=5


	aimbullet[count(aimbullet)].sp=sprite


	--dbg=aimbullet[count(aimbullet)].angle
end

function spawnbullet(start_x,start_y,s_angle)

	local b = {
		sp=5,
		x=start_x,
		y=start_y,
		dx=3,
		dy=3,
	 angle=s_angle
	}
	add(aimbullet,b)
	
 sfx(16,2)

end

function spawn_enemy (start_x,start_y,s_dx,s_xy)

	if(s_dx==nil)then s_dx=0 end

	if(s_dy==nil)then s_dy=0 end

	local e={
		sp=7,
		x=start_x,
		y=start_y,
		t=30,
		dx=s_dx,
		dy=s_dy
		
		
	}
	
	add(spawneffect,e)

end	

function create_explosion(startx,starty)

local b = {

		sp=6,
		x=startx,
		y=starty,
		dx=0,
		dy=0,
		t= 15,
		amgle=0

}
add(explosion,b)

local e = {

		sp=8,
		x=startx,
		y=starty,
		dx=2-rnd(100)/100,
		dy=2-rnd(100)/100,
		t= 5,
		angle=rnd(100)/100
}
add(explosion,e)

end

function create_dust(startx,starty)

local e = {

		sp=8,
		x=startx,
		y=starty,
		dx=0,
		dy=0,
		t= 5,
		angle=0
}
add(explosion,e)

end

function fire()

	local b = {
		sp=3,
		x=ship.x,
		y=ship.y,
		dx=0,
		dy=-6
	
	}
	add(bullets,b)

--if (stat(23) ==-1) then	sfx(06,3,0,2) end

end

--snes style pixel fades,
--thanks marballs 2 lactron!
function p_fade_out()
 local pw=2 --pixel width
 while pw < 128/32 do
  for x=0,127,pw do
   for y=0,127,pw do
    rectfill(x,y,x+pw-1,y+pw-1,pget(x+rnd(pw),y+rnd(pw)))
   end
  end
  flip()
  pw *= 1.08 --high for shorter effect
 end
end

function sleep(n)
 --halt for n frames
 for i=1,n do flip() end
end
