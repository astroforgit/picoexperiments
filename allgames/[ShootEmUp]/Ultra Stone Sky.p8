--pattern

function patterns() 

-- scaling bullet speed in mode life
if (mode_life==1 or mode_life==0)then

	if(level-deaths>=2)then bullet_speed=3 end
	if(level-deaths>=3)then bullet_speed=3.05 end
	if(level-deaths>=4)then bullet_speed=3.075 end
	if(level-deaths>=5)then bullet_speed=3.1 end
	if(level-deaths>=6)then bullet_speed=3.15 end
	if(level-deaths>=7)then bullet_speed=3.175 end
	if(level-deaths>=8)then bullet_speed=3.2 end
	if(level-deaths>=9)then bullet_speed= 3.225 end
	if(level-deaths>=10)then bullet_speed=3.25 end
	if(level-deaths>=11)then bullet_speed=3.275 end
	if(level-deaths>=12)then bullet_speed= 3.3 end
	if(level-deaths>=13)then bullet_speed=3.35 end
	if(level-deaths>=14)then bullet_speed=3.4 end
	if(level-deaths>=15)then bullet_speed=3.5 end
	if(level-deaths>15)then bullet_speed=
			3.5+1*((level-15)/50) end
end

if (sequence==1) then

	if (flr (s_t)==5)then
		pattern=-1
		pattern2=6
		pattern3=-1
	end

	if (flr (s_t)==10)then
		pattern= flr(rnd(10))
		pattern2=-1
		pattern3=10
	end

	if (flr (s_t)==15)then
		pattern=5
		pattern2=6
		pattern3=10
		
	end

	if (flr (s_t)==20)then
		pattern=-1
		pattern2=6
		pattern3=10

		s_t=0
	end
end

if (sequence==2) then

	if (flr (s_t)==5)then
		pattern=2
		pattern2=5
		pattern3=-1
	end

	if (flr (s_t)==10)then
			pattern=2
		pattern2=-1
		pattern3=-1
	end

	if (flr (s_t)==15)then
		pattern=-1
		pattern2=5
		pattern3=-1
		
	end

	if (flr (s_t)==20)then
		pattern=0
		pattern2=5
		pattern3=flr(rnd(10))
		
		s_t=0
	end
end

if (sequence==3) then
pattern=1
pattern2=7
pattern3=10
end

if (sequence==4) then
pattern=4
pattern2=9
pattern3=-1
end

if (sequence==5) then

    if (flr (s_t)==5)then
