				spawn_enemy (turret1y+2,turret1y+2)
				spawn_enemy (turret1y-2,turret1y-2)
				spawn_enemy (turret1y-2,turret1y+2)
				spawn_enemy (turret1y+2,turret1y-2)

				
				end
