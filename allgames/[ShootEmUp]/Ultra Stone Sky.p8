pattern3=7
    end

    if (flr (s_t)==10)then
pattern=0
pattern2=6
pattern3=-1
    end

    if (flr (s_t)==15)then
pattern=5
pattern2=6
pattern3=7
        
    end

    if (flr (s_t)==20)then
pattern=5
pattern2=0
pattern3=-1
        
        s_t=0
    end
end

if (sequence==6) then
pattern=2
pattern2=4
pattern3=7
end

if (sequence==7) then
pattern=5
