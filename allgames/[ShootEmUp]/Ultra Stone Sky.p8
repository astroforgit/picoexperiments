		music(01,0,3)
	 t=0
			fade_black=1
			
			
					game_state=-1
		end
	

	end
	
	if (game_state==-1) and t>15 then
game_state=1
	end
	
		if (game_state==-2) and t>15 then
game_state=2
	end
	

	
		if (game_state==2)then

	if (btn(—) or btn(Ž))  and 
	(hold_b==0) and (t>30) then

		game_state=1
		
		sfx(16)
		shake+=10
		
		time=0
		top_score=0
		score=0
		t=0
		s_t=0
		level=0
		sequence=0
		level_color=0
		progress=0
		lives=5

		_init()
		hold_b=1

		end
end
	
	
	
	if (game_state==1)then
	--adds to time
	
	time+=1/30
	
	if(mode_life==1)then

	if(lives<0) then 
	music(13)
 	sfx(23,1)

 	t=0
 		hold_b=1
 		
 		 		
 		fade_black=1
			game_state=-2
 end 

end

	
	if(mode_life==0)then
 if(time>120) then 
 music(13)
 	sfx(23,1)

 	t=0
 		hold_b=1
 		
 		fade_black=1
			game_state=-2
 		
 end 

	if(t%30==1 and time>100) then 
		
		sfx(22,1) 
		sequence=0
	
	end 
	
	if(t%30==1 and flr(time)==90) then sfx(22,1) end 

	if(t%30==1 and flr(time)==60) then sfx(22,1) end 

	if(t%30==1 and flr(time)==30) then sfx(22,1) end 

	if(t%30==1 and time>0 and time <=3) then sfx(22,1) end 

end

	-- shoots enemy
	for e in all(spawneffect) do
		for b in all(bullets)do
			if e.x+3 >= b.x-3 and e.x-3 <= (b.x + 3) and 
					e.y+3 >= b.y-3 and e.y-3 <= (b.y + 3) 
					then
					del(spawneffect,e)
					del(bullets,b)
					
					if(e.t<10)then 
					
						sfx(19,3,0,25)
						score+=3
						shake=2
						for i=1,5 do create_explosion(e.x+4,e.y+4) end
						for i=1,5 do create_explosion(e.x-4,e.y-4) end 
						for i=1,5 do create_explosion(e.x-4,e.y+4) end
						for i=1,5 do create_explosion(e.x+4,e.y-4) end

					end
					
					if(e.t>10)then 
					
						sfx(18,3,0,26)
						score+=2
						shake=2
					for i=1,5 do create_explosion(e.x,e.y) end

					end
					
					if(e.t>20)then 
					 score+=1
					 shake=1
					 for i=1,3 do create_explosion(e.x,e.y) end
					 sfx(20,2,0,20)
					end

				 progress+=1

					end
		end
	end
	
	
	--aiming bullets
	for b in all(aimbullet) do
	
-- is aimbullet out of screen
	if b.y>128 or b.y<0 or 
	   b.x>128 or b.x <0  then 
	del(aimbullet,b) end	
	
--	bullet wrap around
		
--[[	if b.y>128 or b.y <0  then 
	del(aimbullet,b) end	

if   b.x>128 and b.y>=96 then 
		del(aimbullet,b) end	

	if   b.x <0 and b.y>=96  then 
		del(aimbullet,b) end	
	


	if   b.x>128 then 
		b.x=0 end	

	if   b.x <0  then 
		b.x=128 end	]]
	
	--player death
		if b.x >= ship.x-3 and b.x <= (ship.x + 3) and 
					b.y >= ship.y-3 and b.y <= (ship.y + 3) 
					then
			sfx(17,1)
			del(aimbullet,b)
			fade_effect=1
			if (score>top_score)then top_score=score end

			score=0
			shake=25
			progress=flr(deaths)
			deaths+=1
			lives-=1

			for i=1,5 do create_explosion(ship.x,ship.y) end

			for b in all(aimbullet) do
				create_dust(b.x,b.y)
			del(aimbullet,b)
		end	
	
		end
	end
	
	
		if (fade_effect==1) then 
			fade_effect=0
			p_fade_out()
			end
	
	--random bullets
		patterns()

	
	-- move aimbullets
		for b in all(aimbullet)do
		b.x+=b.dx*cos(b.angle)
		b.y+=b.dy*sin(b.angle)
	end


	for b in all(back_object)do
		b.x+=b.dx
		b.y+=b.dy
	end

	-- chnage spawn effects
		for e in all(spawneffect)do
		
			e.x+=e.dx
			e.y+=e.dy
			e.t=e.t-0.6
			
			
			 
			if(e.t<20) then	e.sp=11 end
			if(e.t>20) then	e.sp=12 end
			
			if (e.t<10) then 
				if (t%2==1)then e.sp=13 
				else e.sp=7	end
						
			 end
			
			
			if(e.t<0) then	del(spawneffect,e) end

	end
	
	
	--explosions
		for e in all(explosion)do
			e.t=e.t-0.6
					e.x+=e.dx*cos(e.angle)
					e.y+=e.dy*sin(e.angle)
					
			if(e.t<5) then e.sp=8 end
			if(e.t<2) then e.sp=9 end
			if(e.t<1) then e.sp=10 end	
			if(e.t<0) then	del(explosion,e) end

	end


--player bullets	
	for b in all(bullets)do
		b.x+=b.dx
		b.y+=b.dy
	
		if b.y<0  then
			del(bullets,b)
				end	
		end
	

	if btn(‹) and btn(‹) then
	
	else
ship.sp=1	
	end

if (t%5>=1) and (t%5<=3) then 

for b in all(aimbullet)do
		b.sp=21
	end

else

for b in all(aimbullet)do
		b.sp=5
	end

end

	--player movement
	if btn(‹) then 
			ship.sp=18
	if(ship.x<0) then 
		ship.x+=1 
	--	ship.x=120
	
	else
		ship.x-=(ship.speed) end
	end

	if btn(‘) then 
	ship.sp=2
	if(ship.x>120) then 
		ship.x-=1
		-- ship.x=0
		 else
			 ship.x+=ship.speed end
				
		end

	if btn(—) or btn(Ž)  then 
		if (t%2==1)then	fire() end
		ship.speed=2.5
		hold_b=1
	else
	
		hold_b=0
	
	ship.speed=4
	
	end
	
end end


