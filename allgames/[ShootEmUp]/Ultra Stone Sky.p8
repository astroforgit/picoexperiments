end

if(progress>=level_goal) then
	if (level%5==4)then lives+=1 
	sfx(33,0)
	end
	s_t=0
	progress=0
	level+=1
	top_score+=score
	
	deaths=0
	
	sfx(21,1)
	shake+=10

 sequence=level%10

	level_color=15
	white_back=8

if (level>10)	then 

--patterndx=flr(rnd(5)+4) 
patterndx=patterndxs[level%10+1]

end

	for b in all(back_object)do
		del(back_object, b)
	end

end

--pick pattern
 arr_pattern=flr(s_t/4)
	if(arr_pattern<1) then arr_pattern=1 end 
	if(arr_pattern>4) then arr_pattern=4 end 

 if (sequence>=11)then sequence=10 end

 
 if (sequence<1)then 
 	
 	if (flr (s_t)==5)then pattern=0 end
  if (flr (s_t)==10)then pattern=1 end
  if (flr (s_t)==15)then pattern=0 end
