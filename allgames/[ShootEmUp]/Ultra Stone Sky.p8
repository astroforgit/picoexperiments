				local rndy = rnd(64)
				spawn_enemy (rndx,rndy)
				spawnaimbullet(rndx, rndy,ship.x,ship.y)
					end		end

--4- 1 spread 3
		if (pattern==4 or pattern2==4 or pattern3==4  or patterndx==4)then
			if(t%30==1) then
				local rndx = rnd(120)+4
				local rndy = rnd(64)
				spawn_enemy (rndx,rndy)
				spawnaimbullet(rndx, rndy,ship.x,ship.y)

				spawnaimbullet(rndx, rndy,ship.x,ship.y)
				aimbullet[#aimbullet].angle+=0.05
				
				spawnaimbullet(rndx, rndy,ship.x,ship.y)
				aimbullet[#aimbullet].angle-=0.05
				
				spawn_enemy (rnd(120)+4,rnd(96))
