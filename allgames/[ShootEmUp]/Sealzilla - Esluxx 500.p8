pico-8 cartridge // http://www.pico-8.com
version 8
__lua__

function _init()
--fix scoreboard
 t=0
 tt=0
 state=0 -- titlescreen
 palt(2,true)
 palt(0,false)
 titlex=53
 titley=50
 seal = {
  sp=1,
  x=10,
  y=80,
  h=4,
  p=0,
  t=0,
  imm=false,
  power=0,
  powertime=0,
  box = {x1=0,y1=0,x2=7,y2=7}}
 bullets = {}
 enemybullets = {}
 enemies = {}
 objects = {}
 explosions = {}
 messages = {}
 stars = {}
 spawnsea()
  for i=1,64 do
  add(stars,{
   x=rnd(128),
   --y=rnd(60),
   y=rnd(127),
   s=rnd(2)+1
  }) 
 end 
 sfx(3,3,1)
 --start()
 titlescreen()
end

function spawnpowerup(xpos,ypos)
 add(objects, {
	  sp=30,
	  x=xpos,
	  y=ypos, 
	  box = {x1=0,y1=0,x2=7,y2=7},
	  imm=0
	 })
end

function respawn()
 local n = flr(rnd(5))+2
 local ypos = 50
 -- 0 = tank
 -- 1 = plane
 -- 2 = policecar
 for i=1,n do
  local d = 0
  local r = flr(rnd(10))
  if(r >= 0 and r <= 1) then 
	etype = 0
	enemysprite = 51
	ypos = 60
  end
  if(r >= 2 and r <= 2) then 
	etype = 1
    enemysprite = 17 
	ypos = 10
  end
  if(r >= 3 and r <= 9) then
	etype = 2
    enemysprite = 35
    ypos = 60
  end
  
 add(enemies, {
  --sp=17,
  --sp=35,
  sp=enemysprite,
  m_x=i*16,
  m_y=-20-i*8,
  enemytype=etype,
  --x=80,
  --x=127,
  x=127,
  --y=52+(i*12),
  y=ypos+(i*9),
  r=2,
  h=1,
  box = {x1=0,y1=0,x2=7,y2=7}
 })
 end

end

function spawnobjects()
 local n = 7
 --24 big house
 --28 small house
 --26 tree
 --10 lamp
 --12 car
 for i=1,n do
  local d = -1
  local objsp = 0
  local n = flr(rnd(12))
  if (n >= 1 and n <= 4) then objsp = 24 end
  if (n >= 5 and n <= 7) then objsp = 28 end
  if (n >= 8 and n <= 9) then objsp = 10 end
  if (n >= 10 and n <= 10) then objsp = 12 end
  if (n >= 11 and n <= 11) then objsp = 26 end
  if (i == 3 or i == 6) then 
	objsp = 1
    n = 1	
  end
  if rnd(1)<0.5 then d=1 end
  
 if(n > 0) then
	add(objects, {
	  sp=objsp,
	  m_x=i*16,
	  m_y=-20-i*8,
	  d=d,
	  --x=80,
	  x=127,
	  y=53+(i*9), 
	  r=12,
	  imm=0,
	  box = {x1=0,y1=0,x2=7,y2=7}
	 })
    end
 end
end

function createmessage(text,xpos,ypos,length,blink,moving,color)
 add(messages, {
  mess=text,
  b=blink,
  m=moving,
  l=length,
  x=xpos,
  y=ypos,
  t=0,
  c=color
 })
end

function updatemessages()
 for m in all(messages) do
  m.t += 1
  if m.t%8==1 and m.m == 1 then m.y -= 1 end
  if m.t >= m.l then del(messages,m) end
 end
end

function drawmessages()
 for m in all(messages) do
  print(m.mess,m.x,m.y,m.c)
  if(m.t%8 < 4  and m.b == 1) then print(m.mess,m.x,m.y,10) end
  if(m.t%32 < 16 and m.b == 2) then print(m.mess,m.x,m.y,10) end
 end
end

function spawnsea()
 local i = 0
 local j = 0
 for i=0,6 do
  for j=1,8 do
	add(objects, {
	  sp=32,
	  x=(i*8),
	  y=62+(j*8), 
	  imm=0,
	  box = {x1=0,y1=0,x2=7,y2=7}
	 })
  end
 end
end

function titlescreen()
 _update = update_title
 _draw = draw_title
end

function update_title()
 tt+=1
 if(tt == 32000) then tt=1000 end
 for st in all(stars) do
  st.x -= st.s
  if st.x <= 0 then
   st.x = 128
   st.y=rnd(127)
  end
 end 
 if btn(0) or btn(1) or btn(2) or btn(3) or btn(4) or btn(5) then start() end
end

function draw_title()
  cls()
  rectfill(0,0,127,127,1)
  for st in all(stars) do
	pset(st.x,st.y,6)
  end
  --rectfill(45,47,89,110,1)
  --rect(45,47,89,110,7)
  print("esluxx 500",43,20,7)
  print("sealzilla",45,30,7)
  print("\142 = attack    \151 = sealsound",5,100,7)
  print("\148, \131, \145, \139 = move ",5,110,7)
  print("press any key",38,70,7) 
  print("to begin terror",33,80,7)
  if tt%16 < 8 then
  --spr(seal.sp,seal.x,seal.y)
	spr(20,titlex,titley)
	spr(21,titlex+8,titley)
	spr(4,titlex,titley-8)
	spr(5,titlex+8,titley-8)
 else
	spr(22,titlex,titley)
	spr(23,titlex+8,titley)
	spr(6,titlex,titley-8)
	spr(7,titlex+8,titley-8)
	--4 5 20 21
 end
end


function start()
 _update = update_game
 _draw = draw_game
end

function game_over()
 _update = update_over
 _draw = draw_over
end

function update_over()
	sfx(-1,3,0)
end

function draw_over()
 cls()
 print("game over",45,50,7)
 print("score ",41,65,7)
 print(seal.p,75,65,7)
end


function abs_box(s)
 local box = {}
 box.x1 = s.box.x1 + s.x
 box.y1 = s.box.y1 + s.y
 box.x2 = s.box.x2 + s.x
 box.y2 = s.box.y2 + s.y
 return box

end

function coll(a,b)
 -- todo
 local box_a = abs_box(a)
 local box_b = abs_box(b)
 
 if box_a.x1 > box_b.x2 or
    box_a.y1 > box_b.y2 or
    box_b.x1 > box_a.x2 or
    box_b.y1 > box_a.y2 then
    return false
 end
 
 
 return true 
 
 
end

function explode(x,y)
 add(explosions,{x=x,y=y,t=0})
 sfx(4,flr(rnd(1))+1,0)
end

function fire()
 local b = {
  sp=3,
  x=seal.x+14,
  y=seal.y,
  dx=3,
  dy=0,
  box = {x1=2,y1=0,x2=5,y2=4},
  life=6
 }
 add(bullets,b)
 if(seal.power == 1) then
   local b = {
    sp=3,
    x=seal.x+14,
    y=seal.y,
    dx=4,
    dy=1,
    box = {x1=2,y1=0,x2=5,y2=4},
    life=6
   }
   add(bullets,b)
   local b = {
    sp=3,
    x=seal.x+14,
    y=seal.y,
    dx=4,
    dy=-1,
    box = {x1=2,y1=0,x2=5,y2=4},
    life=6
   }
   add(bullets,b)
 end
 sfx(1,0,0)
end

function enemyfire()
 if(t%32 == 0) then
  for e in all(enemies) do
   if(e.enemytype==0) then
    local b = {
     sp=49,
     x=e.x,
     y=e.y,
     dx=-3,
     dy=0,
     box = {x1=2,y1=0,x2=5,y2=4},
     life=1
    }
    add(enemybullets,b)
   end
   if(e.enemytype==1) then
    local b = {
     sp=49,
     x=e.x,
     y=e.y,
     dx=-1,
     dy=3,
     box = {x1=2,y1=0,x2=5,y2=4},
     life=1
    }
    add(enemybullets,b)
   end
   if(e.enemytype==3) then
    local b = {
     sp=49,
     x=e.x,
     y=e.y,
     dx=-3,
     dy=0,
     box = {x1=2,y1=0,x2=5,y2=4},
     life=1
    }
    add(enemybullets,b)
	local b = {
     sp=49,
     x=e.x,
     y=e.y-8,
     dx=-3,
     dy=0,
     box = {x1=2,y1=0,x2=5,y2=4},
     life=1
    }
    add(enemybullets,b)
	local b = {
     sp=49,
     x=e.x,
     y=e.y,
     dx=-2,
     dy=-1,
     box = {x1=2,y1=0,x2=5,y2=4},
     life=1
    }
    add(enemybullets,b)
	local b = {
     sp=49,
     x=e.x,
     y=e.y,
     dx=-2,
     dy=1,
     box = {x1=2,y1=0,x2=5,y2=4},
     life=1
    }
    add(enemybullets,b)
   end
  end
 end
end

function spawnboss()
 add(enemies, {
  sp=38,
  m_x=0,
  m_y=0,
  enemytype=3,
  --x=80,
  --x=127,
  x=127,
  --y=52+(i*12),
  y=80,
  r=2,
  h=100,
  box = {x1=0,y1=0,x2=7,y2=7}
 })
end

function update_game()
 t=t+1
 if(t==32000) then t=1000 end
 if(seal.power == 1) then 
  seal.powertime += 1 
  if seal.powertime == 70 then 
    seal.power = 0
	seal.powertime = 0
  end
 end
 if seal.imm then
  seal.t += 1
  if seal.t >30 then
   seal.imm = false
   seal.t = 0
  end
 end
 
 if (t%9 == 0) then
	spawnobjects()
 end
 
 updatemessages()
 
  for st in all(stars) do
  st.x -= st.s
  if st.x <= 0 then
   st.x = 128
   st.y=rnd(60)
  end
 end 
 
 for ex in all(explosions) do
  ex.t+=1
  ex.x-=1
  if ex.t == 13 then
   del(explosions, ex)
  end
 end
 
 --if #enemies <= 0 and t>150 then
 -- respawn()
 --end
 if(t%80==0 and t>150) then
  respawn()
 end
 
 if(t%650==0 and t>200) then
  spawnboss()
  createmessage("!! warning wack boss incoming !!",0,38,120,2,0,8)

 end
 
 
 
 for e in all(enemies) do
  --e.m_x += 1.3
  --e.x = e.r*sin(e.d*t/50) + e.m_x
  --e.y = e.r*cos(t/50) + e.m_y
  if (e.enemytype < 3) then e.x -= 1 end 
  
  if t%16 == 1 and e.enemytype == 0 then
		if seal.x < e.x then e.x -= 1 else e.x += 1 end	
		if seal.y < e.y then e.y -= 1 else e.y += 1 end
  end
  
  if t%16 == 1 and e.enemytype == 1 then
		if (e.x > seal.x-20) then 
			e.x = e.x - 2*cos(t/45)
			e.y = e.y + 2*sin(t/90)
		else
			e.x -= 4
		end
		
  end
  
  if t%2 == 0 and e.enemytype == 2 then
		e.x -= 1
  end
  
  if t%10 == 1 and e.enemytype == 3 then
		if seal.x < e.x and ((e.x - seal.x) > 40) then e.x -= 2 else e.x += 3 end	
		if seal.y < e.y then e.y -= 2 else e.y += 2 end
  end
  
  
  
  if coll(seal,e) and not seal.imm then
    seal.imm = true
    seal.h -= 1
    if seal.h <= 0 then
     game_over()
    end
  
  end
  
  if e.x < -8 then
   del(enemies,e)
  end
 
 end
 
 enemyfire()
 
 for o in all(objects) do
   o.x -= 1
  if coll(seal,o) and not seal.imm then
    --explode(o.x,o.y)
	  if (o.sp==24) then o.sp = 9 end
	  if (o.sp==10) then o.sp = 11 end
	  if (o.sp==12) then o.sp = 13 end
	  if (o.sp==26) then o.sp = 27 end
	  if (o.sp==28) then o.sp = 29 end
	  if (o.sp==1) then o.sp = 2 end
	  if (o.sp == 30 or o.sp == 31) then 
	    del(objects,o)
		sfx(5,1,0)
		createmessage("20",seal.x+8,seal.y-18,15,1,1,12)
		seal.power = 1
	  end
	--del(objects,o)
  end
  
  if o.x < -8 then
   del(objects,o)
  end
end 
 
 for b in all(bullets) do
  b.x+=b.dx
  b.y+=b.dy
  if b.x < 0 or b.x > 128 or
   b.y < 0 or b.y > 128 then
   del(bullets,b)
  end
  for e in all(enemies) do
   if coll(b,e) and b.life > 0 then
    e.h -= 1
	b.life -= 1
	if(e.monstertype == 3) then b.life -= 100 end
    if(e.h <= 0) then 	 
	  --createmessage(message,xpos,ypos,length,blink,moving,color)
      createmessage("10",seal.x+8,seal.y-18,15,1,1,12)	
      seal.p += 10
	  if(e.enemytype == 3) then 
	   createmessage("100",seal.x+8,seal.y-18,15,1,1,8)
	   seal.p += 100 
	   explode(e.x+flr(rnd(16)),e.y+flr(rnd(16)))
	   explode(e.x-flr(rnd(16)),e.y+flr(rnd(16)))
	   explode(e.x+flr(rnd(16)),e.y-flr(rnd(16)))
	   explode(e.x-flr(rnd(16)),e.y-flr(rnd(16)))
	   explode(e.x+flr(rnd(16)),e.y+flr(rnd(16)))
	   explode(e.x-flr(rnd(16)),e.y+flr(rnd(16)))
	   explode(e.x+flr(rnd(16)),e.y-flr(rnd(16)))
	   explode(e.x-flr(rnd(16)),e.y-flr(rnd(16)))
	   explode(e.x+flr(rnd(16)),e.y+flr(rnd(16)))
	   explode(e.x-flr(rnd(16)),e.y+flr(rnd(16)))
	  end
	  del(enemies,e)
      explode(e.x,e.y)
	  explode(e.x+flr(rnd(10)),e.y+flr(rnd(10)))
	  explode(e.x-flr(rnd(10)),e.y+flr(rnd(10)))
	end
   end
  end
  for o in all(objects) do
   --if (coll(b,o) and o.sp == 24) then
   if (coll(b,o) and b.life > 0 and o.imm == 0) then
    --del(objects,o)
	if (o.sp==24) then 
		o.sp = 9
		explode(o.x+4,o.y)
	end
	if (o.sp==28) then 
		o.sp = 29 
		explode(o.x+4,o.y)
	end
	if (o.sp==10) then o.sp = 11 end
	if (o.sp==12) then o.sp = 13 end
	if (o.sp==26) then o.sp = 27 end
	if (o.sp==1) then o.sp = 2 end
    --seal.p += 1
    b.life -= 1
	o.imm = 1
	--del(bullets,b)
	if(flr(rnd(100)) == 99) then spawnpowerup(o.x,o.y) end
   end   
  end 
  if b.life <= 0 then del(bullets,b) end
 end
 
 for b in all(enemybullets) do
  b.x+=b.dx
  b.y+=b.dy
  
  if coll(seal,b) and not seal.imm then
    seal.imm = true
    seal.h -= 1
	del(enemybullets,b)
    if seal.h <= 0 then
     game_over()
    end
    
  end
  
  if b.x < 0 or b.x > 128 or
   b.y < 0 or b.y > 128 then
   del(enemybullets,b)
  end
 end
 
 
 
 if(t%6<3) then
  seal.sp=1
 else
  seal.sp=2
 end
 
 if btn(0) and seal.x >= 0 then seal.x-=1 end
 if btn(1) then seal.x+=1 end
 if btn(2) and seal.y >= 63 then seal.y-=1 end
 if btn(3) and seal.y <= 128 then seal.y+=1 end
 if btnp(4) then fire() end
 if btnp(5) then sealsound() end
end

function sealsound()
	sfx(0,0,0)
end

function draw_game()
 cls()
 rectfill(0,0,127,69,1)
 rectfill(0,70,127,127,6)
 for st in all(stars) do
  pset(st.x,st.y,6)
 end
 
 for o in all(objects) do
	spr(o.sp,o.x,o.y)
	if(o.sp == 24) then spr(8,o.x,o.y-8) end
	if(o.sp == 30 and t%16<8) then spr(31,o.x,o.y) end
 end
 
 print("score: ",7)
 print(seal.p,30,0,7)
 --if not seal.imm or t%8 < 4 then
 if t%16 < 8 then
  --spr(seal.sp,seal.x,seal.y)
	spr(20,seal.x,seal.y)
	spr(21,seal.x+8,seal.y)
	spr(4,seal.x,seal.y-8)
	spr(5,seal.x+8,seal.y-8)
 else
	spr(22,seal.x,seal.y)
	spr(23,seal.x+8,seal.y)
	spr(6,seal.x,seal.y-8)
	spr(7,seal.x+8,seal.y-8)
	--4 5 20 21
 end
 
 for ex in all(explosions) do
  circ(ex.x,ex.y,ex.t/2,8+ex.t%3)
  circ(ex.x,ex.y,(ex.t/2),10-ex.t%3)
  circ(ex.x,ex.y,1+(ex.t/5),8+ex.t%3)
 end
  
 for b in all(bullets) do 
	if(t%8 < 4) then
		spr(b.sp,b.x,b.y)
	else
		spr(b.sp+16,b.x,b.y)
	end
 end
 
 for b in all(enemybullets) do 
	if(t%8 < 4) then
		spr(b.sp,b.x,b.y)
	else
		spr(b.sp+1,b.x,b.y)
	end
 end
 
  
 
 for e in all(enemies) do
	if t%16 < 8 then
		
		if(e.enemytype == 3) then
		 spr(54,e.x,e.y)
		 spr(55,e.x+8,e.y)
		 spr(38,e.x,e.y-8)
		 spr(39,e.x+8,e.y-8)
		end
		if(e.enemytype < 3) then spr(e.sp,e.x,e.y) end
	else
		
		if(e.enemytype == 3) then
		 spr(56,e.x,e.y)
		 spr(57,e.x+8,e.y)
		 spr(40,e.x,e.y-8)
		 spr(41,e.x+8,e.y-8)
		end
		if(e.enemytype < 3) then spr(e.sp+1,e.x,e.y) end
	end
 end
 
  if (t<150) then
	print("!! get ready !!",34,50,7)
	print("** approaching gothenburg **",6,67,7)
	
	print("!! get ready !!",35,51,7)
	print("** approaching gothenburg **",7,68,7)
	
	print("!! get ready !!",36,50,7)
	print("** approaching gothenburg **",8,67,7)
	
	--print("!! get ready !!",19,49,7)
	--print("** approaching gothenburg **",4,69,7)
	
	print("!! get ready !!",35,50,8)
	print("** approaching gothenburg **",7,67,8)
	
	
  end
 
 for i=1,4 do
  if i<=seal.h then 
  spr(33,80+9*i,3)
  else
  spr(34,80+9*i,3)
  end
 end
 
 drawmessages()
 
end
