pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
--p.i.command
--by guerragames

attack_button_held = 0
one_frame = 1.0 / 60.0
timer = 0.0
game_over = false
title_screen = true
hi_score = 0

---------------------------
-- vector2d ---------------

function magnitude( x, y )
  return sqrt( (x * x) + (y * y) )
end

-------------------

function normalizewithmag( x, y )
  local mag = magnitude( x, y )
  local one_over_mag = 1 / mag

  x = x * one_over_mag
  y = y * one_over_mag

  return x, y, mag
end

---------------------------
-- explosions -------------

explosions={}
explosions.count = 100
explosions.colors = {7,10,9,8,2}

for i=1,explosions.count do
 explosions[i] = {}
 explosions[i].bits = {}
 explosions[i].bits.count = 36

 for j=1,explosions[i].bits.count do
  explosions[i].bits[j] = {}
 end
end

----------

explosions.init = function()
 explosions.next = 1

 for i=1,explosions.count do
  explosions[i].spawn_timer = 0
  explosions[i].timer = 0
  explosions[i].color = 0
  explosions[i].decel = 0
  
  for j=1,explosions[i].bits.count do
   explosions[i].bits[j].x = 0
   explosions[i].bits[j].y = 0
   explosions[i].bits[j].dx = 0
   explosions[i].bits[j].dy = 0
  end
 end
end

----------

explosions.spawn = function( x, y, timer )

 local explosion = explosions[explosions.next]
 explosion.spawn_timer = timer
 explosion.timer = timer

 local speed = 0.5 + rnd(0.5)
 explosion.decel = 0.01 + rnd(0.04)
  
 for j=1,explosion.bits.count do
  local bit = explosion.bits[j]
  bit.x = x
  bit.y = y
  
  local theta = j/explosion.bits.count
  
  local dx = sin(theta)
  local dy = cos(theta)
  
  bit.dx = dx * speed
  bit.dy = dy * speed
  
 end
 
 explosions.next += 1
 
 if ( explosions.next > explosions.count ) then
  explosions.next = 1
 end
end

----------

explosions.update = function()

 for i=1,explosions.count do
  local explosion = explosions[i]
  
  if explosion.timer > 0 then
   explosion.timer -= one_frame
   
   local color_index = 1+flr((#explosions.colors)*explosion.timer/explosion.spawn_timer)
   
   explosion.color = explosions.colors[color_index]

   for j=1,explosion.bits.count do
    local bit = explosion.bits[j]
	bit.dx -= explosion.decel * bit.dx
    bit.dy -= explosion.decel * bit.dy
    bit.x += bit.dx
    bit.y += bit.dy
   end
  end
 end

end

----------

explosions.draw = function()
 for i=1,explosions.count do
  if explosions[i].timer > 0 then
   for j=1,explosions[i].bits.count do
    pset( explosions[i].bits[j].x, explosions[i].bits[j].y, explosions[i].color )
   end
  end
 end
end

----------
-- cursor

cursor = {}
cursor.x = 64 + 16
cursor.y = 64 + 16
cursor.velx = 0.0
cursor.vely = 0.0
cursor.accel = 0.1
cursor.decel = 0.2
cursor.max_vel = 2.0
cursor.anim = {32,32,33,33,34,34,35,35,36,36,37,37,38,38}
cursor.anim_index = 1

----------

cursor.init = function()
 cursor.velx = 0.0
 cursor.vely = 0.0
 cursor.anim_index = 1
end

----------

cursor.update = function()
 
 -- handle x speed calc
 if btn(0) and btn(1) or not btn(0) and not btn(1) then
  -- decelerate!
  if cursor.velx > -cursor.decel and cursor.velx < cursor.decel then
   cursor.velx = 0.0
  elseif cursor.velx <= -cursor.decel then
   cursor.velx += cursor.decel
  elseif cursor.velx >= cursor.decel then
   cursor.velx -= cursor.decel
  end
 elseif btn(0) then
  cursor.velx -= cursor.accel
  
  if cursor.velx < -cursor.max_vel then
   cursor.velx = -cursor.max_vel
  end
 elseif btn(1) then
  cursor.velx += cursor.accel
  
  if cursor.velx > cursor.max_vel then
   cursor.velx = cursor.max_vel
  end
 end

 -- handle y speed calc
 if btn(2) and btn(3) or not btn(2) and not btn(3) then
  -- decelerate!
  if cursor.vely > -cursor.decel and cursor.vely < cursor.decel then
   cursor.vely = 0.0
  elseif cursor.vely <= -cursor.decel then
   cursor.vely += cursor.decel
  elseif cursor.vely >= cursor.decel then
   cursor.vely -= cursor.decel
  end
 elseif btn(2) then
  cursor.vely -= cursor.accel
  
  if cursor.vely < -cursor.max_vel then
   cursor.vely = -cursor.max_vel
  end
 elseif btn(3) then
  cursor.vely += cursor.accel
  
  if cursor.vely > cursor.max_vel then
   cursor.vely = cursor.max_vel
  end
 end
 
 -- move cursor
 cursor.x += cursor.velx
 cursor.y += cursor.vely
 
 if cursor.x < 0 then
  cursor.x = 0
  cursor.velx = 0
 elseif cursor.x > 128-8 then
  cursor.x = 128-8
  cursor.velx = 0
 end

 if cursor.y < 0 then
  cursor.y = 0
  cursor.vely = 0
 elseif cursor.y > 128-8 then
  cursor.y = 128-8
  cursor.vely = 0
 end
  
 -- anim stuff
 cursor.anim_index += 1
 
 if cursor.anim_index > #cursor.anim then
  cursor.anim_index = 1
 end
 
 -- shooting
 if btn(4) then
  if attack_button_held == 0 then
   if not game_over then
    planet.shooting = 0.1
	lasers.spawn()
	cursor.velx = 0
	cursor.vely = 0
    sfx(0)
   end
  end
  
  attack_button_held += 1
 else
  attack_button_held = 0
 end

end

----------

cursor.draw = function()
 spr( cursor.anim[cursor.anim_index], cursor.x, cursor.y )
end

----------
-- lasers

lasers = {}
lasers.count = 10
lasers.next = 1
lasers.max_timer = 1

----------

lasers.init = function()
 for i=1,lasers.count do
  laser = {}
  laser.x = 0
  laser.y = 0
  laser.basex = 0
  laser.basey = 0
  laser.timer = 0
  laser.radius = 8
  
  add(lasers, laser)
 end
end

----------

lasers.spawn = function()
 local laser = lasers[lasers.next]
 
 laser.timer = lasers.max_timer
 laser.radius = 8
 laser.x = cursor.x + 3
 laser.y = cursor.y + 3
 
 laser.basex = 64 + planet.offsetx
 laser.basey = 64 + planet.offsety
 
 lasers.next += 1
 
 if lasers.next > lasers.count then
  lasers.next = 1
 end
 
end

----------

lasers.update = function()
 for i=1,lasers.count do
  local laser = lasers[i]
  
  if laser.timer > 0 then
   laser.timer -= one_frame
   laser.radius = 8*(1 - laser.timer)
  end
 end 
end

----------

lasers.draw = function()
 for i=1,lasers.count do
  local laser = lasers[i]
  
  if laser.timer > 0 then
   local half_max = lasers.max_timer/2
  
   if laser.timer > half_max then
    local scale = 2*(laser.timer - half_max)
    local lerpx = laser.x + scale * ( laser.basex - laser.x )
    local lerpy = laser.y + scale * ( laser.basey - laser.y )
   
    line( lerpx, lerpy, laser.x, laser.y, 8 )
   end
   
   circfill( laser.x, laser.y, laser.radius, 10 )
  end
 end 
end

----------
-- planet

planet = {}
planet.radius = 8
planet.max_shield = 8
planet.shield = planet.max_shield

planet.offsetx = 0
planet.offsety = 0
planet.coffsetx = 0
planet.coffsety = 0

planet.shake_timer = 0
planet.shooting = 0

----------

planet.init = function()
 planet.shield = planet.max_shield
 planet.offsetx = 0
 planet.offsety = 0
 planet.coffsetx = 0
 planet.coffsety = 0
 planet.shake_timer = 0
 planet.shooting = 0
end

----------

planet.update = function()
 planet.shake_timer -= one_frame
 planet.shooting -= one_frame
 
 local xdiff = cursor.x - 64
 local ydiff = cursor.y - 64
   
 local normalx, normaly, mag = normalizewithmag( xdiff, ydiff )
 
 local iris_offset = 2 + planet.shield * 2/8
 
 local adjx = ( (normalx < 0) and 1 or 0 )
 local adjy = ( (normaly < 0) and 1 or 0 )
 
 planet.offsetx = normalx * iris_offset + adjx
 planet.offsety = normaly * iris_offset + adjy
 planet.coffsetx = normalx * 2 + adjx
 planet.coffsety = normaly * 2 + adjy
end

----------

planet.draw = function()
 local planetx = 64
 local planety = 64
 
 if planet.shake_timer > 0 then
  if planet.shield > planet.max_shield/2 then
   planetx += -1 + rnd(2)
   planety += -1 + rnd(2)
  else
   planetx += -2 + rnd(4)
   planety += -2 + rnd(4)
  end
 end

 circfill( planetx, planety, planet.radius + planet.shield, 13 )
 circ( planetx, planety, planet.radius + planet.shield, 2 )
 
 local eye_color = game_over and 13 or 7
 
 circfill( planetx, planety, planet.radius, eye_color )
 
 local iris_color = game_over and 2 or 8
 local iris_radius = 5

 if planet.shooting > 0 then
  iris_color = 10
 end
 
 if planet.shield > 6 then
  iris_radius = 2
 elseif planet.shield > 4 then
  iris_radius = 3
 elseif planet.shield > 2 then
  iris_radius = 4
 else
  iris_radius = 5
 end

 circfill( planetx + planet.coffsetx, planety + planet.coffsety, 6, 9 )
 circfill( planetx + planet.offsetx, planety + planet.offsety, iris_radius, iris_color )
 
end

----------
-- missiles

missiles = {}
missiles.killed = 0
missiles.count = 100
missiles.next = 1
missiles.next_spawn = 1.0
missiles.spawn_rate = 1.0
missiles.min_speed = 0.05
missiles.max_speed = 0.1
missiles.anim = {5,5,5,5,6,6,6,6,7,7,7,7,8,8,8,8}

for i=1,missiles.count do
 missile = {}
  
 missile.active = false
 missile.x = 0  
 missile.y = 0
 missile.basex = 0  
 missile.basey = 0
 missile.speed = 1
 missile.blink = 0
 missile.anim_index = 1
  
 add( missiles, missile )
end
 
----------

missiles.init = function()
 missiles.killed = 0
 missiles.next = 1
 missiles.next_spawn = 1.0
 
 missiles.spawn_rate = 1.0
 missiles.min_speed = 0.05
 missiles.max_speed = 0.1
 
 for i=1,missiles.count do
  missile = missiles[i]
  
  missile.active = false
  missile.x = 0  
  missile.y = 0
  missile.basex = 0  
  missile.basey = 0
  missile.speed = 1
  missile.blink = 0
 end
end

----------

missiles.spawn = function()
 local missile = missiles[missiles.next]

 missile.active = true
 missile.speed = missiles.min_speed + rnd(missiles.max_speed-missiles.min_speed)
 missile.blink = 0
 
 local quadrant = flr(rnd(5))
  
  if quadrant == 0 then
   -- left quadrant
   missile.x = 0
   missile.y = rnd(128)
  elseif quadrant == 1 then
   -- up quadrant
   missile.x = rnd(128)
   missile.y = 0
  elseif quadrant == 2 then
   -- right quadrant
   missile.x = 127
   missile.y = rnd(128)
  else
   -- down quadrant
   missile.x = rnd(128)
   missile.y = 127  
  end
  
  missile.basex = missile.x
  missile.basey = missile.y
  
 missiles.next += 1
  
 if missiles.next > #missiles then
  missiles.next = 1
 end
    
end

----------

missiles.update = function()

 -- increase difficulty every 10 kills
 local difficulty = flr(missiles.killed/10)
 missiles.spawn_rate = 1.0 - 0.05 * difficulty
 missiles.min_speed = 0.05 + 0.01 * difficulty
 missiles.max_speed = 0.1 + 0.02 * difficulty
 
 if missiles.spawn_rate < 0.2 then
  missiles.spawn_rate = 0.2
 end
 
 -- spawn missiles
 if timer > missiles.next_spawn then
  missiles.spawn()
  
  missiles.next_spawn = timer + missiles.spawn_rate
 end

 -- update missile positions
 for i=1,missiles.count do
  local missile = missiles[i]
  
  if missile.active then
   local xdiff = 64 - missile.x
   local ydiff = 64 - missile.y
   
   local normalx, normaly, mag = normalizewithmag( xdiff, ydiff )
   
   if mag > planet.radius or planet.shield > 0 then
    if mag <= planet.shield + planet.radius then
     missile.active = false
	 planet.shield -= 1
	 planet.shake_timer = 0.5
	 sfx(1)
	 explosions.spawn( missile.x, missile.y, 0.25 )
	 explosions.spawn( missile.x, missile.y, 0.5 )
     explosions.spawn( missile.x, missile.y, 0.75 )
	 explosions.spawn( missile.x, missile.y, 1.0 )
	 
	 if planet.shield <= 0 then
	  game_over = true
	  sfx(2)
	  if hi_score < missiles.killed then
	   hi_score = missiles.killed
	   dset(0,hi_score)
	  end
	 end
    else
     missile.x += normalx * missile.speed
     missile.y += normaly * missile.speed
	 missile.blink += missile.speed
	 
	 -- anim stuff
	 missile.anim_index += 1
	 
	 if missile.anim_index > #missiles.anim then
	  missile.anim_index = 1
	 end	 
    end
   end
  end
 end
end

----------

missiles.draw = function()
 for i=1,missiles.count do
  local missile = missiles[i]
  
  if missile.active then
   local blink = (flr(missile.blink) % 2) == 0
   line( missile.basex, missile.basey, missile.x, missile.y, blink and 9 or 7 )
   spr( missiles.anim[missile.anim_index], missile.x - 1, missile.y - 1 )
  end
 end
end

----------
-- background

background = {}
background.timer = 0
background.max_timer = 64/60 -- to pulse with the music's beat

----------

background.update = function()
 background.timer += one_frame
 
 if background.timer > background.max_timer then
  background.timer = 0
 end
 
end

----------

background.draw_layer = function( starti, offset, skip, random, color )
 for i=starti, 64, skip do
  local pos1x = i
  local pos1y = 0
  local pos2x = 64
  local pos2y = 64
  
  local normalx, normaly, mag = normalizewithmag( pos1x - pos2x, pos1y - pos2y )
  
  local newx = 64 + normalx * (offset + rnd(random))
  local newy = 64 + normaly * (offset + rnd(random))
  
  -- can probably optimize this further (do 8 sections instead of 4)
  line( pos1x, pos1y, newx, newy, color )
  line( 127 - pos1x, pos1y, 127 - newx, newy, color )
  
  line( pos1x, 127 - pos1y, newx, 127 - newy, color )
  line( 127 - pos1x, 127 - pos1y, 127 - newx, 127 - newy, color )
  
  line( pos1y, pos1x, newy, newx, color )
  line( pos1y, 127 - pos1x, newy, 127 - newx, color )

  line( 127 - pos1y, pos1x, 127 - newy, newx, color )
  line( 127 - pos1y, 127 - pos1x, 127 - newy, 127 - newx, color )
 end 
end

----------

background.draw = function()
 local scale = background.timer/background.max_timer
 
 circ( 64, 64, 64*scale, 1 )
 circ( 64, 64, (32 + 64*scale)%64, 1 )

 local closer = 2*(8 - planet.shield)
 
 background.draw_layer(1, 56 - 3*closer, 8, 16, 2)
 background.draw_layer(1, 64 - 1.5*closer, 2, 8, 4)
 background.draw_layer(0, 76 - closer, 2, 4, 10)
end

--------------------
-- main game stuff

cartdata( "picommand" )
music(0)

----------

function _init()

 timer = 0.0
 game_over = false

 hi_score = dget(0)
 
 explosions.init()
 cursor.init()
 lasers.init()
 missiles.init()
 planet.init()
end

----------

function touch()
 if game_over then
  return
 end
 
 -- check for laser to missile collisions
 for i=1,missiles.count do
  local missile = missiles[i]
  
  if missile.active then
   for i=1,lasers.count do
    local laser = lasers[i]
  
    if laser.timer > 0 then 
     local xdiff = laser.x - missile.x
	 local ydiff = laser.y - missile.y
	
     local mag = magnitude( xdiff, ydiff )
	
	 if mag <= laser.radius + 1 then -- +1 to account for the missile radius
	  -- missile destroyed
	  missile.active = false
	  missiles.killed += 1
	  sfx(3+flr(rnd(4)))
	  
	  explosions.spawn( missile.x, missile.y, 0.5 )
	 end
	end
   end
  end
 end
end

----------

function _update60()
 
 timer += one_frame
 
 background.update()
 
 cursor.update()
 
 planet.update()

 lasers.update()
 
 if not title_screen then 
  missiles.update()
 end
 
 if title_screen or game_over then
  if btn(5) then
   title_screen = false
   game_over = false
   
   _init()
  end
 end
 
 touch()
 
 explosions.update()
end

----------

function zspr(n,w,h,dx,dy,dz)
  sx = 8 * (n % 16)
  sy = 8 * flr(n / 16)
  sw = 8 * w
  sh = 8 * h
  dw = sw * dz
  dh = sh * dz
  
  sspr(sx,sy,sw,sh, dx,dy,dw,dh)
end

----------

function print_outline( text, x, y, color, backc )
  local offsetx = (#text * 0.5)*4
  
  print( text, x - offsetx - 1, y - 0, backc )
  print( text, x - offsetx - 0, y + 1, backc )
  print( text, x - offsetx + 0, y - 1, backc )
  print( text, x - offsetx + 1, y + 0, backc )
  
  print( text, x - offsetx, y, color )
end

----------

function _draw()
 cls()
 
 background.draw()
  
 missiles.draw()
 
 planet.draw()
 
 explosions.draw()
 
 lasers.draw()
 
 cursor.draw()
  
 print_outline("hi-score:"..hi_score, 64, 2, 7, 2)
 print_outline("score:"..missiles.killed, 64, 120, 7, 2)

 if title_screen or game_over then
  -- title 
  zspr( 64, 8, 2, 7, 10, 2 )
  
  print_outline( "<x> to start", 64, 30, 7, 2 )
  print_outline( "<z> to shoot lasers", 64, 37, 7, 2 )
 end
  
 if game_over then
  zspr( 96, 7, 2, 11, 82, 2 ) 
 end
 
end

----------

function _update() _update60() _update60() end
if(_update60)_update=function()_update60()_update60()end
