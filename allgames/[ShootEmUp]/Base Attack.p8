pico-8 cartridge // http://www.pico-8.com
version 32
__lua__
-- base attack
-- 1983 home vision
-- 2020 lostcadesoft by bgelais

score=0
level=0
‡=3

function _init()
intro_init()
end

function hud_draw()
 local f=0
	schar=sub("0000"..score.."0",-6)
	for i=1,#schar do
  f=tonum(sub(schar,i,i))		
		spr(48+f,32+i*8,0)
	end
	lsprite=mget(15,15)+16
	for i=1,‡ do
		spr(lsprite,84+i*9,0)
		spr(lsprite,36-i*9,0)
	end
end

function col(a,b)
	for o in all(b) do
		 if abs(a.x-o.x)<8
		and abs(a.y-o.y)<8
		then return true end
	end
end
-->8
--player / bases

function player_init()
 pl={x=64,y=24}
 fires={}	
end

function player_update()
	if (btn(‹)) pl.x-=1
	if (btn(‹) and btn(—)) fire(-3,0)
	if (btn(‘)) pl.x+=1
	if (btn(‘) and btn(—)) fire(3,0)
	if (btn(”)) pl.y-=1
	if (btn(”) and btn(—)) fire(0,-3)
	if (btn(ƒ)) pl.y+=1
	if (btn(ƒ) and btn(—)) fire(0,3)

	pl.y=mid(14,pl.y,64)
	pl.x=mid(8,pl.x,120)
	
	if (col(pl,balls)) dead_init()
	if (col(pl,missiles)) dead_init()
	if (col(pl,ships)) dead_init()
end

function player_draw()
	spr(1,pl.x-8,pl.y-4,2,1)
end

function fire(_dx,_dy)
	if #fires<1 then
	sfx(0)
	add(fires,{
	x=pl.x,y=pl.y,
	dx=_dx,dy=_dy
	}) end
end

function fire_update(o)
	o.x+=o.dx
	o.y+=o.dy
	if (o.x<0 or o.x>127) del(fires,o)
	if (o.y<8 or o.y>127) del(fires,o)
 
 colmap=mget(o.x/8,o.y/8)

	if (fget(colmap)==1) del(fires,o)
	if (colmap>=3 and colmap<=10)	nb-=1 score+=10 explode_init(o.x,o.y,0) del(fires,o)
 if (colmap==16 or colmap==18) nb-=1 score+=10 explode_init(o.x,o.y,1) del(fires,o)
 if (colmap==17 or colmap==19) nb-=1 score+=10 explode_init(o.x,o.y,-1) del(fires,o)

end

function fire_draw(o)
	pset(o.x,o.y,rnd(8))
end

explodes={}
function explode_init(mx,my,_w)
	sfx(1)
 mx=mx/8
 my=my/8
	add(explodes,{
	x=mx,y=my,fr=0,w=_w
	})
 mset(mx,my,0)
 mset(mx+_w,my,0)
end

function explodes_update(o)
	o.fr+=0.1
 if o.fr>3 then 
 nb-=1
 score+=10
 del(explodes,o) end
 
	if (o.w==0) mset(o.x,o.y,42+o.fr)
 if o.w==-1 then
 	mset(o.x-1,o.y,58+2*flr(o.fr))
 	mset(o.x,o.y,59+2*flr(o.fr))
 end
 if o.w==1 then
 	mset(o.x,o.y,58+2*flr(o.fr))
 	mset(o.x+1,o.y,59+2*flr(o.fr))
 end
end

--bases balls and ships
missiles={}
balls={}
ships={}

function bases_update()
nb=0
	for x=0,15 do
	 	for y=9,15 do
 			base=mget(x,y)
 			ran=flr(rnd(5))
 			if (fget(base)==2) nb+=1
 			if fget(base)==2
 			and ran==2 then
 			missile_init(flr(x*8)+4,flr(y*8)+8) end
			end
	 end
end

function missile_init(_x,_y)
if (#missiles<1) add(missiles,{x=_x,y=_y-8})	
end

function missile_update(o)
	o.y-=.8
	if (col(o,balls)) del(missiles,o)
	if (o.y<9) del(missiles,o)
	if o.y<pl.y+4 and o.y>pl.y-4 
	and #balls<level	
	then
	ball_init(o.x,o.y)
	del(missiles,o) end
	
	
end

foreach(missiles,missile_draw)

function missile_draw(o)
	pset(o.x,o.y,rnd(15))
	pset(o.x,o.y+1,rnd(15))
	pset(o.x,o.y+2,rnd(15))
end

function ball_init(x,y)
	add(balls,{x=x,y=y})
end

function ball_update(o)
 if level>1
 and o.y>pl.y-8
 and o.y<pl.y+8 
 and time()%1==0
 then 
 ship_init(o.x,o.y)
 del(balls,o)
 end
 
 if col(o,fires) then
 explode_init(o.x,o.y,0)
 score+=1
 del(balls,o) end
end

function ball_draw(o)
	spr(13,o.x-4,o.y-4)
end

function ship_init(_x,_y)
 sfx(3)
 ship={x=_x,y=_y,xd=0,spr=14}
 if (ship.x>pl.x) ship.xd=-1.5
 if (ship.x<pl.x) ship.xd=1.5 ship.spr=15
 add(ships,ship)
end

function ship_update(o)
	o.x+=o.xd
	if (o.x<0 or o.x>127) del(ships,o)
 if col(o,fires) then
 explode_init(o.x,o.y,0)
 score+=5
 del(ships,o) end

end

function ship_draw(o)
	spr(o.spr,o.x-4,o.y-4)
end


-->8
--game

function game_init()
reload(0x2000, 0x2000, 0x1000)
 if (level>6) level=0
 level+=1
 for x=level*16,level*16+15 do
 	for y=8,15 do
 		mset(x-level*16,y,mget(x,y))
		end
 end
explodes={}
balls={}
ships={}
missiles={}

player_init()
_update60=game_update
_draw=game_draw
end

function game_update()
	player_update()
	bases_update()
	foreach(balls,ball_update)
	foreach(ships,ship_update)
	foreach(fires,fire_update)
	foreach(missiles,missile_update)
 if (nb==0 and #explodes==0) levelup()
end

function game_draw()
	cls()
	map()
	hud_draw()
	foreach(fires,fire_draw)
	foreach(missiles,missile_draw)
	foreach(explodes,explodes_update)
	foreach(balls,ball_draw)
	foreach(ships,ship_draw)
	player_draw()
end

function dead_init()
 sfx(4)
 fr=0 ‡-=1
	_update60=dead_update
	_draw=dead_draw
end

function dead_update()
	fr+=.1
	if fr>2 then 
		for t=1,60 do flip() end
		if (‡<=0) sfx(5) title_init()		
		if ‡>0 then
		player_init()
		missiles={}
		balls={}
		ships={}
		_update60=game_update
		_draw=game_draw end
	end

end

function dead_draw()
	cls(rnd(4))
	map()
	hud_draw()
	spr(32+2*flr(fr),pl.x-8,pl.y-4,2,1)
end

function levelup()
	sfx(2)
	for t=1,60 do flip() end
  game_init()	
end
-->8
--title

function title_init()
	player_init()
	‡=0
	x=-8
	timeout=time()+10
	_update60=title_update
	_draw=title_draw
end

function title_update()
 x+=2
 x=min(200,x)
 if (time()>=timeout) intro_init()

 if btnp(Ž) or btnp(—) then
 	‡=3
 	score=0
 	level=0
 	sfx(2)
 	game_init()
 end	
end

function title_draw()
	cls()
	map(16)
	spr(80,min(-88+x,20),32,11,1)
	
	spr(1,x,32,2,1)
	if x>136 then
	print("1983 home vision",28,46,2)
	print([[2020 lostcadesoft 
	       by bgelais]],28,52,8)
	if (time()%1>.5)	print("Ž/— to start",36,72,7)
	end
	pal(9,1+rnd(15))
	hud_draw()
	pal()
end
-->8
-- intro

function intro_init()
	timeout=time()+12
	x=128
 _update60=intro_update
 _draw=intro_draw
end

function intro_update()
	if (time()>=timeout or btnp()!=0) title_init()
 x-=5
 x=max(0,x)
end

function intro_draw()
	cls()

	print([[
           you are...	
	
	
	destroy all bases below and
	then move to next level.
	
	base launch defense's missiles
	    that chan changes to...
	    
	                10 pts 
	                 
	    and in a certain time
	    can change to...
	    
	                50 pts
	                  
	   fly towards you, beware!
	   
move  ”
	   ‹  ‘ + — shoot direction
	     ƒ 
	]],x,0,1+6)
	spr(13,56-x,52)
	spr(15,56-x,82)
	spr(1,51-x,8,2,1)
end
