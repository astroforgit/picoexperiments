pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
--ship and gravity
--presented by nylon1919
version=2.0

function _init()
 cartdata("shipngravity")
 game=false
 init_star()
	t=0
	ready=0
	if version==dget(1) then
 	hscore=dget(0)
 else
 	hscore=0
 end
	dset(1,version)
end

function _update60()
 if ready>0 then
  ready-=1
  if (ready==8) readyf()
 else
  if game then
   if pl.life>0 and timelimit>0 then
   	update_game()
   else
    if not gameover then
     gameover=true
     if (timelimit==0) bonus=5*pl.life score+=bonus
     music(32)
     for s in all(shot) do
     	add_ptcl8(s,12)
     	del(shot,s)
     end
     newscore()
    end
    if btn(Ž) or btn(—) then
    	ready=16
    	readyf=init_title
    	sfx(0)
    end
    if abs(pl.y-64)<128 then
     pl.y+=pl.vy
     pl.vy=1
     pl_mot()
     add_smoke()
     add_smoke()
    end
    update_move_only(enemy)
    update_move_only(ast)
    update_move_only(item)
    foreach(ptcl,update_ptcl)
   end
  else
   if btn(Ž) or btn(—) then
   	ready=16
   	readyf=init_game
   	sfx(0)
   end
   t%=120
   t+=1
  end
 end
end

function _draw()
 cls()
 foreach(star,draw_star)
 if game then
 	draw_game()
 else
 	draw_title()
 end
 if ready>0 then
 	local y=(8-abs(ready-8))^2
 	rectfill(0,64-y,128,64+y,1)
 	rectfill(0,64-y+4,128,64+y-4,7)
 end
end

function init_title()
	game=false
end

function draw_title()
	pal(7,1)
	if (abs(t-56)<2 or abs(t-60)<2) pal(7,12)
	for i=1,5 do
		spr(64,0,32+i,16,2)
	end
	pal()
	spr(64,0,32,16,2)
	printcs("press Ž or — start",64,8,1,2)
 printcs("move:‹‘”ƒ",96,1,0,4)
 print("highscore:"..hscore.."0",38,77,1)
 print("highscore:"..hscore.."0",38,76,8)
 print("ver "..version,96,120,1)
end

function printcs(a,y,c,s,n)
 if (n==nil) n=0
	local x=64-#a*2-2*n
	print(a,x,y+1,s)
	print(a,x,y,c)
end

function newscore()
	if (score>hscore) hscore=score
	dset(0,hscore)
end
-->8
--game


function init_game()
	init_pl()
	shot={}
	smoke={}
	ptcl={}
	enemy={}
	ast={}
	astf=0
	enemyf=0
	shake=0
	bonus=0
	music(0)
	timelimit=1800
	time_limit_up=0
	item={}
	itemf=180
	game=true
	gameover=false
	score=0
end

function update_game()
 if time_limit_up>0 then
  if (time_limit_up%6==0) timelimit+=60 sfx(3)
  add_smoke_time(time_limit_up/6)
  time_limit_up-=1
 end
 if (astf==0) add_ast()
 if (enemyf==0) add_enemy()
 if (itemf==0) add_item()
	update_pl()
	update_thing()
	astf-=1 enemyf-=1 itemf-=1 timelimit-=1
end

function update_thing()
	foreach(shot,update_shot)
	foreach(ast,update_ast)
	foreach(enemy,update_enemy)
	foreach(item,update_item)
 foreach(ptcl,update_ptcl)
end

function update_move_only(a)
 for aa in all(a) do
 	aa.y+=1
 	if (aa.y>256) del(a,aa)
 end
end

function draw_game()
 shake_cam()
	foreach(ast,draw_ast_area)
	foreach(ast,draw_ast)
 foreach(smoke,draw_smoke)
 foreach(ptcl,draw_ptcl)
	foreach(enemy,draw_enemy)
	foreach(item,draw_enemy)
 foreach(shot,draw_shot)
	draw_pl()
	draw_ui()
end

function draw_ui()
	camera()
	print_time(flr((timelimit+59)/60))
	print("life:"..pl.life,2,1,7)
	if gameover then
 	spr(128,26,32,10,2)
 	printcs("press Ž or —",104,7,1,2)
  if score==hscore then
   printcs("new record!!",84,10,9)
  end
  print("score:"..score.."0",44,72,7)
  if (bonus>0) print("life bonus:"..bonus.."0",34,64,6)
 else
  print("score:"..score.."0",80,8,7)
	 print("high :"..hscore.."0",80,1,7)
 end
end

function print_time(n)
	if n<10 then
	 spr(96+n,60,1,1,2)
	else
	 spr(96+flr(n/10),56,1,1,2)
	 spr(96+n%10,64,1,1,2)
	end
end

function dist(a,b,n)
 if (n==nil) n=1
 return max(abs(a.x-b.x)*n,abs(a.y-b.y))
end

function dist2(a,b)
 return sqrt((a.x-b.x)^2+(a.y-b.y)^2)
end

function limit(x,a,b)
 return max(a,min(x,b))
end

function myrnd(a)
	return rnd(2*a)-a
end

function frnd(a)
	return flr(rnd(a))
end

function shake_cam()
	local x,y=0,0
	if shake>0.5 then
	 x,y=myrnd(shake),myrnd(shake)
	 shake*=0.95
	end
	camera(x,y)
end
-->8
--player


function init_pl()
 pl={}
 pl.s=0
 pl.x=64
 pl.y=96
 pl.vx=0
 pl.vy=0
 pl.v=1
 pl.sf=0
 pl.mf=0
 pl.df=0
 pl.life=3
end

function update_pl()
 pl_flag()
 pl_move()
 pl_shot()
 pl_mot()
 add_smoke()
end

function pl_move()
	if (btn(‹) and pl.vx>-pl.v) pl.vx-=0.1
	if (btn(‘) and pl.vx<pl.v) pl.vx+=0.1
	if (btn(”) and pl.vy>-pl.v) pl.vy-=0.1
	if (btn(ƒ) and pl.vy<pl.v) pl.vy+=0.1
 if (abs(pl.vx)>pl.v) pl.vx*=pl.v/abs(pl.vx)
 if not (btn(‹) or btn(‘)) then
  if abs(pl.vx)>0.01 then
   pl.vx*=0.9
  else
   pl.vx=0
  end
 end
 if (abs(pl.vy)>pl.v) pl.vy*=pl.v/abs(pl.vy)
 if not (btn(”) or btn(ƒ)) then
  if abs(pl.vy)>0.01 then
   pl.vy*=0.9
  else
   pl.vy=0
  end
 end
 pl.x+=pl.vx
 pl.y+=pl.vy
 pl.x=limit(pl.x,4,123)
 pl.y=limit(pl.y,4,123)
end

function pl_shot()
	if pl.sf==0 then
		add_shot()
	end
end

function pl_mot()
 pl.mf+=2
 if (pl.vy<0) pl.mf+=2
 if (pl.vy>0) pl.mf-=1
 pl.mf%=24
 pl.s=flr(pl.mf/8)
end

function pl_flag()
	if (pl.df>0) pl.df-=1
	if (pl.sf>0) pl.sf-=1
end

function draw_pl()
 if pl.df%2==0 then
  spr(pl.s,pl.x-4,pl.y-5,1,2)
 end
end
-->8
--back


function init_star()
	star={}
	for i=1,50 do
		local s={}
		s.x=rnd(128)
		s.y=rnd(144)-8
		s.v=frnd(3)+1
		s.col=6+frnd(2)
		add(star,s)
	end
end

function add_smoke()
	for i=0,2 do
		local s={}
		s.rec=rnd(2)<1
		s.x=pl.x+myrnd(3)
		s.y=pl.y+3+myrnd(1)
		s.vx=(s.x-pl.x)/6
		s.vy=(s.y-pl.y)/2
		s.w=rnd(1)
		s.h=rnd(1)
		s.life=8+rnd(4)*s.w*s.h
		s.col=6
		if (not s.rec and rnd(3)<1) s.col=9
	 add(smoke,s)
	end
end

function add_smoke_time()
	for i=0,3 do
		local s={}
		s.rec=false
		s.x=64+myrnd(1)
		s.y=7+myrnd(1)
		s.vx=cos(i/4+0.125)
		s.vy=sin(i/4+0.125)
		s.w=1.5
		s.h=1.5
		s.life=8+rnd(4)*s.w*s.h
		s.col=2
	 add(smoke,s)
	end
end

function add_ptcl8(a,col)
	for i=0,7 do
 	local p={}
 	p.x=a.x
 	p.y=a.y
 	p.vx=4*cos(i/8)
 	p.vy=4*sin(i/8)
 	p.t=0
 	p.col=col
 	add(ptcl,p)
	end
end

function update_ptcl(p)
 if (p.t==8) del(ptcl,p)
	p.x+=p.vx	p.y+=p.vy
	p.vx*=0.7	p.vy*=0.7
	p.t+=1
end

function draw_smoke(s)
 s.x+=s.vx
 s.y+=s.vy
 s.life-=1
 local x,y,w,h,c=s.x,s.y,s.w,s.h,s.col
	if s.rec then
		rectfill(x-w,y-h,x+w,y+w,c)
	else
		ovalfill(x-w,y-h,x+w,y+w,c)
	end
	if (s.life<=0) del(smoke,s)
end

function draw_star(s)
	s.y+=s.v
	if (s.y>135) s.y-=144
	pset(s.x,s.y,s.col)
end

function draw_ptcl(p)
	pset(p.x,p.y,p.col)
end
-->8
--shot


function add_shot()
	local s={}
	s.x=pl.x
	s.y=pl.y
	add(shot,s)
	sfx(0)
	pl.sf=8
end

function update_shot(s)
	s.y-=4
	for e in all(enemy) do
 	if dist2(e,s)<5 then
	  add_ptcl8(e,7)
		 del(enemy,e)
		 del(shot,s)
		 sfx(2)
		 score+=1
		end
	end
	if (s.y<-4) del(shot,s)
end

function draw_shot(s)
	ovalfill(s.x-1.5,s.y-1.5,s.x+1.5,s.y+1.5,12)
	ovalfill(s.x-0.5,s.y-0.5,s.x+0.5,s.y+0.5,7)
	ovalfill(s.x-0.5,s.y-0.5+4,s.x+0.5,s.y+0.5+4,12)
end
-->8
--asteroid


function add_ast()
	local a={}
	a.x=frnd(9)*16
	a.m=frnd(4)
	a.r=32+a.m*4
	a.y=-2*a.r
	a.v=0.5+(3-a.m)/4
	a.m=(a.m/3)^2+2
	add(ast,a)
	astf=flr((a.r/a.v)*(2.5+rnd()))
end

function update_ast(a)
 a.y+=a.v
 local d=dist2(a,pl)
 if d<a.r*2+4 and dist(a,pl)<a.r*2+4 then
 	if d<a.r+4 then
  	pl.vx-=256*a.m*(a.x-pl.x)/d^2
  	pl.vy-=256*a.m*(a.y-pl.y)/d^2
 	 pl.x+=pl.vx
 	 pl.y+=pl.vy
 	 if pl.df==0 then
  	 sfx(1)
  	 shake=5
 	  pl.df=60
 	  pl.life-=1
 	 end
 	else
  	pl.vx+=64/d*a.m*(a.x-pl.x)/d^2
  	pl.vy+=64/d*a.m*(a.y-pl.y)/d^2
  end
 end
 if (a.y>128+2*a.r) del(ast,a)
end

function draw_ast_area(a)
	circ(a.x,a.y,2*a.r,1)
end

function draw_ast(a)
	circfill(a.x,a.y,a.r,9)
	circfill(a.x,a.y,a.r-1,4)
end
-->8
--enemy


function add_enemy()
 local e={}
 e.x=frnd(7)*16+16
 e.y=-4
 e.t=frnd(60)
 e.s=32
 add(enemy,e)
 enemyf=8+frnd(8)
end

function update_enemy(e)
	e.x+=sin(e.t/180)/4
	e.y+=1
	if dist(pl,e,1.2)<8 and pl.df==0 then
		shake=5
		pl.df=60
		pl.life-=1
		sfx(1)
	end
	if (e.y>132) del(enemy,e)
	e.t+=1
	e.t%=180
	e.s=32+flr(e.t%60/45)
end

function draw_enemy(e)
	spr(e.s,e.x-4,e.y-4)
end
-->8
--item


function add_item()
	local i={}
 local e={}
 i.x=frnd(3)*32+16
 i.y=-4
 i.s=8
 i.f=false
 add(item,i)
 itemf=360
end

function update_item(i)
 if i.f then
  i.x+=(64-i.x)/4
  i.y+=(7-i.y)/4
  if max(abs(i.x-64),abs(i.y-7))<6 then
   time_limit_up=30
   del(item,i)
  end
 else
 	i.y+=2
	 if dist(pl,i,1.2)<8 then
		 get_item(i)
	 end
	 if (i.y>132) del(item,e)
	 i.s=8
 end
end

function get_item(i)
	i.f=true
	sfx(4)
	add_ptcl8(i,8)
end
