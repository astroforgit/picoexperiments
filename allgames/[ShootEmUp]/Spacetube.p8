pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
--spacetube
--presented by nylon-1919

function _init()
 game=0
 curs=0
 col={}
 init_menu()
 hscore={}
 for i=1,10 do
  hscore[i]=0
 end
 auto=true
end

function _update60()
 if game==0 then
  update_menu()
 elseif game==1 then
  update_game()
 elseif game>2 then
  if btnp(4) or btnp(5) then
   game=0
   sfx(60)
   t=0
  end
  if t%48==0 then
   r=1
  end
  if 48%(47-t%48)==0 then
   r+=1
  end
  t+=1
  foreach(star,update_mstar)
 else
  if btnp(4) or btnp(5) then
   game=4
   sfx(60)
   r=1
   t=0
  end
  foreach(star,update_mstar)
 end
end

function _draw()
 cls(0)
 if game==0 then
  draw_menu()
 elseif game==1 then
  draw_game()
 elseif game==2 then
  draw_how()
 elseif game==3 then
  draw_high()
 elseif game==4 then
  draw_how2()
 end
end
-->8
--menu


function init_menu()
 star={}
 for i=1,100 do
  local s={}
  s.x=rnd(127)
  s.y=rnd(127)
  s.size=0
  s.col=6
  add(star,s)
 end
 t=0
 r=0
 game=0
 music(8)
end

function update_menu()
 if (btnp(”)) curs-=1 sfx(63)
 if (btnp(ƒ)) curs+=1 sfx(63)
 curs%=3
 if btnp(‹) or btnp(‘) then
  auto=not auto
  sfx(61)
 end
 if btnp(—) then
  sfx(60)
  if (curs==0) game_init()
  game=curs+1
 end
 foreach(star,update_mstar)
 t+=1
end

function draw_menu()
 foreach(star,draw_ast1)
 for i=0,3 do
  pal(13,7+flr((t%12)/2))
  spr(192,16+cos(i/4),32+sin(i/4),13,2)
 end
 pal(13,0)
 spr(192,16,32,13,2)
 pal()
 local col={}
 for i=1,3 do
  col[i]=6
 end
 col[curs+1]=7
 printcs("game start",64,col[1],1)
 printcs("how to play",72,col[2],1)
 printcs("high score",80,col[3],1)
 printccs("select —",90,1,1)
 if auto then
  printccs("‹auto mode‘",98,2,1)
 else
  printccs("‹manual mode‘",98,2,1)
 end
end

function draw_how()
 foreach(star,draw_ast1)
 printcs("your ship was grasped",24,7)
 printcs("space tube",32,8)
 printcs("run or die",64,7)
 printcs("move cross ‹‘",80,6)
 printcs("move vertical ”ƒ",88,6)
 printcs("shot Ž/z(only manual mode)",96,6)
end

function draw_how2()
 foreach(star,draw_ast1)
 spr(0,4,8,2,2)
 circfill(12,36,r,9)
 circfill(12,36,r-1,4)
 circfill(12,64,r,14)
 circfill(12,64,r-1,8)
 circ(12,92,r,11)
 circ(12+cos(t%8/8),92+sin(t%8/8),r,8+t%8)
 prinths("player",13,12,1)
 prinths("asteroid",33,10,1)
 prinths("get bigger, more points",42,1)
 prinths("pink asteroid",61,14,1)
 prinths("3times points",70,1)
 prinths("warp zone",89,11,1)
 prinths("delete all asteroids",98,1)
end

function draw_high()
 foreach(star,draw_ast1)
 for i=1,10 do
  printcsn(hscore[i],i*8+20,7)
 end
end

function printcs(a,y,c,s)
 if s==nil then
  s=0
 end
 local x=64-2*#a
 for i=0,3 do
  print(a,x+cos(i/4),y+sin(i/4),s)
 end
 print(a,x,y,c)
end

function printccs(a,y,b,c,s)
 if s==nil then
  s=0
 end
 local x=64-2*(#a+b)
 for i=0,3 do
  print(a,x+cos(i/4),y+sin(i/4),s)
 end
 print(a,x,y,c)
end

function prinths(a,y,c,s)
 if s==nil then
  s=0
 end
 local x=26
 for i=0,3 do
  print(a,x+cos(i/4),y+sin(i/4),s)
 end
 print(a,x,y,c)
end

function printcsn(a,y,c,s)
 if s==nil then
  s=1
 end
 local x=64-2*slength(a)-2
 for i=0,3 do
  print(a..0,x+cos(i/4),y+sin(i/4),s)
 end
 print(a..0,x,y,c)
end

function slength(s)
 if s<10 then
  return 1
 else
  return slength(s/10)+1
 end
end

function update_mstar(s)
 s.y+=0.5
 if s.y>=132 then
  s.y=-1
 end
end
-->8
--game


function game_init()
 init_pl()
 ast={}
 star={}
 smoke={}
 circle={}
 item={}
 shot={}
 ptcl={}
 number={}
 for i=1,50 do
  add_star()
 end
 score=0
 t=0
 gameover=false
 alldel=false
 shake=0
 music(0)
end

function update_game()
 if alldel then
  if (t%2==0) del_ast(ast[1],true)
  if (#ast==0) alldel=false
  t+=1
 else
  if pl.life>0 then
   update_pl()
   foreach(circle,update_circle)
   foreach(item,update_item)
   foreach(shot,update_shot)
   foreach(ast,update_ast)
   foreach(ptcl,update_ptcl)
   foreach(star,update_star)
   foreach(smoke,update_smoke)
   foreach(number,update_number)
   if (t%6==0) add_ast()
   if t%150==0 then
    if rnd(6)<1 then
     add_item()
    else
     add_circle()
    end
   end
   for i=1,8 do
    add_star()
    if (pl.df>30) add_smoke()
   end
   t+=1
  else
   if not gameover then
    gameover=true
    add_high(score)
    music(16)
    if (btn(Ž)) btnpp=true
   end
   if (not btn(Ž)) btnpp=false
   if btnp(—) then
    game_init()
    t+=1
   elseif btnp(Ž) and not btnpp then
    init_menu()
   end
  end
 end
end

function draw_game()
 if (alldel) cls(7)
 local dx,dy=0,0
 if shake>0.5 then
  dx,dy=rnd(2*shake)-shake,rnd(2*shake)-shake
  shake*=0.95
 end
 camera(-64+dx,-64+dy)
 for i=0,7 do
  line(80*cos(pl.theta/360+i/16+t*0.0025),80*sin(i/16+t*0.0025),80*cos((i+8)/16+t*0.0025),80*sin((i+8)/16+t*0.0025),1)
  circ(0,0,10+i^2+t%2,1)
 end
 circfill(0,0,10+t%2,0)
 circfill(0,0,6+t%2,10)
 circfill(0,0,5+t%2,7)
 foreach(star,draw_ast1)
 camera()
 if pl.bf>50 then
  rectfill(0,4+pl.bf,127,123-pl.bf,0)
 elseif pl.bf>30 then
  rectfill(0,54,127,73,0)
  printcs("item get!!",61,7)
 end
 camera(-64+dx,-64+dy)
 foreach(ptcl,draw_ast1)
 foreach(ast,draw_ast1)
 foreach(item,draw_item)
 foreach(number,print_num)
 foreach(circle,draw_circle)
 foreach(shot,draw_shot)
 draw_pl()
 foreach(ast,draw_ast2)
 foreach(smoke,draw_smoke)
 camera()
 for i=0,29 do
  line(i,0,0,i,13)
  line(127-i,127,127,127-i,13)
  line(i,127,0,127-i,13)
  line(127-i,0,127,i,13)
  circ(64,64,70+i,13)
  circ(63,63,70+i,13)
 end
 for i=0,2 do
  circ(63,63,70+i^2*5,6)
  circ(63,64,70+i^2*5,6)
  circ(64,63,70+i^2*5,6)
  circ(64,64,70+i^2*5,6)
 end
 fillp()
 print("life",112,115,1)
 rectfill(111,121,126,126,0)
 local col=7+2^(pl.life-1)
 for i=1,pl.life do
  rectfill(107+i*5,122,110+i*5,125,col)
 end
 print(hscore[1].."0",2,4,1)
 print(score.."0",2,122,1)
 if pl.life<=0 then
  rectfill(39,49,89,80,1)
  rectfill(40,50,88,79,13)
  printcs("gameover",54,1,7)
  printcs("restart —",62,1,7)
  printcs("menu Ž",70,1,7)
 end
end

function dist(a,b)
 return sqrt((a.x-b.x)^2+(a.y-b.y)^2)
end

function add_high(s)
 if (s>hscore[10]) hscore[10]=s
 for i=0,8 do
  if hscore[10-i]>hscore[9-i] then
   hscore[10-i],hscore[9-i]=hscore[9-i],hscore[10-i]
  end
 end
end

function polex(a)
 return a.r*cos((a.theta-pl.theta-90)/360)
end

function poley(a)
 return a.r*sin((a.theta-pl.theta-90)/360)
end
-->8
--player


function init_pl()
 pl={}
 pl.x=0
 pl.y=40
 pl.r=40
 pl.theta=0
 pl.vx=0
 pl.vxmax=18
 pl.vy=0
 pl.s=0
 pl.df=0
 pl.sf=0
 pl.bf=0
 pl.sup=false
 pl.xflip=false
 pl.yflip=false
 pl.life=3
end

function update_pl()
 if pl.df<40 then
  pl_move()
  if auto or btn(4) then
   pl_shot()
  end
 else
  pl.theta+=pl.vx
  pl.vx*=0.9
 end
 pl_anime()
 pl_frag()
end

function pl_move()
 if btn(‹) then
  if pl.vx>-pl.vxmax then
   pl.vx-=1/16
  end
 end
 if btn(‘) then
  if pl.vx<pl.vxmax then
   pl.vx+=1/16
  end
 end
 if btn(”) then
  if pl.vy>-0.5 then
   pl.vy-=1/16
  end
 end
 if btn(ƒ) then
  if pl.vy<0.5 then
   pl.vy+=1/16
  end
 end
 pl.vx=max(-pl.vxmax,min(pl.vx,pl.vxmax))
 
 if not(btn(‹) or btn(‘)) or (btn(‹) and btn(‘)) then
  if pl.vx>1/16 then
   pl.vx-=1/16
  elseif pl.vx<-1/16 then
   pl.vx+=1/16
  else
   pl.vx=0
  end
 end

 if not(btn(”) or btn(ƒ)) then
  if pl.vy>1/16 then
   pl.vy-=1/16
  elseif pl.vy<-1/16 then
   pl.vy+=1/16
  else
   pl.vy=0
  end
 end
 pl.theta+=pl.vx
 if abs(pl.r+pl.vy-40)<20 then
  pl.r+=pl.vy
 end
 pl.vxmax=18-pl.r/8
 pl.y=pl.r
end

function pl_shot()
 if pl.sf==0 then
  if pl.sup then
   add_shot(4)
   add_shot(-4)
  end
  add_shot(8)
  add_shot(-8)
  pl.sf=6
  sfx(63)
 end
end

function pl_anime()
 if pl.df>40 then
  pl.s=((60-pl.df)%8)*2
 else
  if abs(pl.vx)>pl.vxmax/6 then
   pl.s=2
  else
   pl.s=0
  end
 end
 pl.xflip=pl.vx>0
end

function pl_frag()
 if (pl.df>0) pl.df-=1
 if (pl.sf>0) pl.sf-=1
 if (pl.bf>0) pl.bf-=1
end

function draw_pl()
 if pl.df%2==0 or pl.df>40 then
  if alldel then
   pal(9,6)
   pal(5,1)
  end
  if pl.sup and t%8==0 then
   pal(13,7)
  end
  spr(pl.s,pl.x-8,pl.y-8,2,2,pl.xflip,pl.yflip)
  pal()
 end
end
-->8
--asteroid


function add_ast()
 local a={}
 a.theta=rnd(360)
 a.r=rnd(48)
 a.x=polex(a)
 a.y=poley(a)
 a.size=1
 a.life=3
 a.col=9
 a.col2=4
 if rnd(100)<5 then
  a.col=14
  a.col2=8
  a.life=5
 end
 a.t=0
 add(ast,a)
end

function add_star()
 local a={}
 a.theta=rnd(360)
 a.r=rnd(64)
 a.x=polex(a)
 a.y=poley(a)
 a.size=0
 a.col=6
 a.t=0
 add(star,a)
end

function add_ptcl(a)
 for i=1,8 do
  local p={}
  p.r=a.r
  p.theta=a.theta
  p.x=a.x
  p.y=a.y
  p.dx=rnd(2)-1
  p.dy=rnd(2)-0.25
  p.size=rnd(a.size)
  p.col=4
  p.life=flr(rnd(12))+4
  add(ptcl,p)
 end
end

function update_ast(a)
 if (a.life<=0) del_ast(a)
 if (a.t==48) del(ast,a)
 if 48%(47-a.t)==0 then
  a.r+=4
  a.size+=1
 end
 a.x=polex(a)
 a.y=poley(a)
 if abs(a.t-44)<=2 and dist(pl,a)<12 and pl.df==0 then
  pl.df=60
  sfx(61)
  pl.life-=1
  shake=5
  pl.sup=false
  if a.theta<=pl.theta%360 then
   pl.vx=20
  else
   pl.vx=-20
  end
 end
 a.t+=1
end

function del_ast(a,b)
 local s
 if (b==nil) b=false
 if a.col==9 or b then
  s=5*a.size
 else
  s=15*a.size
 end
 add_ptcl(a)
 add_number(a,s)
 score+=s
 del(ast,a)
 sfx(62)
end

function update_star(a)
 a.r+=1.5
 a.x=polex(a)
 a.y=poley(a)
 a.t+=1
 if a.r>64 then
  del(star,a)
 end
end

function update_ptcl(p)
 p.theta-=pl.vx
 p.theta+=p.dx
 p.r+=p.dy
 p.x=polex(p)
 p.y=poley(p)
 p.life-=1
 if p.life<=0 then
  del(ptcl,p)
 end
end

function draw_ast1(a)
 if a.size<6 then
  circfill(a.x,a.y,a.size,a.col)
  if a.col2!=nil then
   circfill(a.x,a.y,a.size-1,a.col2)
  end
 end
end

function draw_ast2(a)
 if a.size>=6 then
  circfill(a.x,a.y,a.size,a.col)
  if a.col2!=nil then
   circfill(a.x,a.y,a.size-1,a.col2)
  end
 end
end
-->8
--shot

function add_shot(ang)
 local a={}
 a.theta=pl.theta+ang
 a.r=pl.r
 a.x=polex(a)
 a.y=poley(a)
 a.size=1
 a.t=0
 add(shot,a)
end

function update_shot(a)
 if a.r>20 then
  a.r-=4
 elseif a.r>10 then
  a.r-=2
 elseif a.r>2 then
  a.r-=1
 end
 a.x=polex(a)
 a.y=poley(a)
 
 if a.r<=8 and a.t>5 then
  del(shot,a)
 end
  
 for as in all(ast) do
  if abs(as.r-a.r)<=3 then
   if dist(as,a)<a.size+as.size then
    del(shot,a)
    as.life-=1
   end
  end
 end
 a.t+=1
end

function draw_shot(s)
 circfill(s.x,s.y,1,12)
 pset(s.x,s.y,7)
end
-->8
--effect


function add_number(a,s)
 local n={}
 n.x=a.x
 n.y=a.y
 n.s=s*10
 n.col=1
 n.t=0
 add(number,n)
end

function add_smoke()
 local s={}
 s.theta=pl.theta+rnd(16)-8
 s.r=pl.r+rnd(8)-4
 s.x=polex(s)
 s.y=poley(s)
 s.vx=rnd(2)-1
 s.vy=rnd(2)-1
 s.sx=flr(rnd(2))+1
 s.sy=flr(rnd(2))+1
 s.col=6
 s.life=8+rnd(8)
 add(smoke,s)
end

function update_number(n)
 n.t+=1
 if n.t==12 then
  n.y-=1
 elseif n.t==14 then
  if n.s<500 then
   n.col=15
  else
   n.col=8
  end
 elseif n.t>16 then
  del(number,n)
 end
end

function update_smoke(s)
 s.theta+=s.vx
 s.r+=s.vy
 s.x=polex(s)
 s.y=poley(s)
 s.life-=1
 if s.life<0 then
  del(smoke,s)
 end
end

function print_num(n)
 print(n.s,n.x,n.y,n.col)
end

function draw_smoke(s)
 rectfill(s.x,s.y,s.x+s.sx,s.y+s.sy,s.col)
end
-->8
--circle


function add_circle()
 local c={}
 c.theta=rnd(360)
 c.r=rnd(48)
 c.x=polex(c)
 c.y=poley(c)
 c.size=1
 c.col=11
 c.t=0
 add(circle,c)
end

function update_circle(c)
 if (c.t==48) del(circle,c)
 if 48%(47-c.t)==0 then
  c.r+=4
  c.size+=1
 end
 if c.size>=6 and dist(pl,c)<14 and pl.df==0 then
  alldel=true
  sfx(60)
  del(circle,c)
 end
 c.x=polex(c)
 c.y=poley(c)
 c.t+=1
end

function draw_circle(c)
 circ(c.x,c.y,c.size,c.col)
 circ(c.x+cos(c.t%8/8),c.y+sin(c.t%8/8),c.size,8+c.t%8)
end

function add_item()
 local i={}
 i.theta=rnd(360)
 i.r=rnd(48)
 i.x=polex(i)
 i.y=poley(i)
 i.n=flr(rnd(2))
 i.size=1
 i.t=0
 add(item,i)
end

function update_item(i)
 if (i.t==48) del(item,i)
 if 48%(47-i.t)==0 then
  i.r+=4
  i.size+=0.5
 end
 if i.size>=2.5 and dist(pl,i)<14 and pl.df==0 then
  get_item(i)
 end
 i.x=polex(i)
 i.y=poley(i)
 i.t+=1
end

function get_item(i)
 if i.n==0 then
  if pl.life<3 then
   pl.life+=1
  else
   score+=10
  end
 elseif i.n==1 then
  if pl.sup then
   score+=10
  else
   pl.sup=true
  end
 end
 pl.bf=60
 del(item,i)
 sfx(59)
end

function draw_item(i)
 sspr(i.n*8,16,8,8,i.x-i.size,i.y-i.size,i.size*2,i.size*2)
end
