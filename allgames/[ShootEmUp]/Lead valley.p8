pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
--leadvalley
--vars
highscore = 0
cooldown = 0
function _init()
gamestate="menu"
playr={
sp=1,
x=192,
y=80,
w=6,
h=8,
flp=false,
direction = 1,
dx=0,
dy=0,
max_dx=2,
max_dy=3,
acc=0.5,
boost=4,
rate=4,
coold=0,
anim=0,
fric=0.75,
runnin=false,
jumpin=false,
fallin=false,
slidin=false,
landed=false
	}
	max_enemies=15
	grav=0.3
	frict=0.75
	cam_pos=65
end


-->8
--update and draw

function _update()


if cooldown >0 then
cooldown -=1
end

if gamestate == "game" then

	player_update()
	player_animate()
	shoot()
	firerate()

if ammo<7 and #ammocr <1 then --btnp(ƒ) then
sfx(6)
add_ammo(24+rnd(336),8,1)
end

--update bullet
for b in all(bullets) do
b:update()

	for e in all(enemy) do
		
		if hit(b.x,b.y,e.x-2,e.y-4,8,8) then
		sfx(2)
		e.lif-=4
		e.dy=-0.5
		e.dx=1*b.dx/3
		b.lif=0
	end

	end
end

for e in all(enemy) do
e:update()

for o in all(explo) do
		
		if hit(e.x,e.y,o.x-4,o.y-6,12,12) then
		if not e.stf then
		sfx(2)
		e.lif-=3
		e.dy=-1
		e.dx=1*e.dx
		else
		e.lif-=1
		e.dy=-0.5
		e.dx=0.5*e.dx
		end
	
	end

--explosion knockback
		if hit(playr.x,playr.y,o.x-24,o.y-24,48,48) then
		--local 
		sfx(2)
		--playr.dy=-2
		--playr.dx=-4*playr.direction
		end
		
	end
end

for o in all(explo) do
o:update()
end

for a in all(ammocr) do
a:update()


if hit(playr.x,playr.y,a.x-4,a.y-1,8,8) then
sfx(4)
ammo +=50
del(ammocr,a)
end

end

for p in all(portal) do
p:update()
end

for l in all(payload) do
l:update()

--	if hit(playr.x,playr.y,l.x-2,l.y-4,8,8) then
--		if ammo == 0 then
--			if btnp(Ž) then
--				playr.coold = 16
--				sfx(4)
--				ammo += 100
--			end
--		end	
--	end
	
end


if lif <= 0 and endwait >=1 then
endwait -=1
end

if endwait ==0 then
sfx(7)
gamestate = "gameover"
cooldown = 300
if kills > highscore then
highscore = kills
end

end
end

cam()

if gamestate == "gameover" then
if not collide_map(playr,"down",0) then
playr.y+=1
end
if cooldown <= 0 then
gamestate = "menu"
cooldown = 16
end
end

if gamestate == "menu" then
if btn(—) and cooldown == 0 then
sfx(9)
gamestate = "game"
cooldown = 16
startgame()
end
end

end

function _draw()

cls(12)
map(0,0)


if gamestate == "game" then
--draw bullet
for p in all(portal) do
p:draw()
end

for l in all(payload) do
l:draw()

	--if hit(playr.x,playr.y,l.x,l.y-4,4,8) and
	--		ammo == 0 then
	--	print("press Ž to reload",l.x-32,l.y-24,15)
	--end
end

for a in all(ammocr) do
a:draw()
end

for b in all(bullets) do
b:draw()
end

for e in all(enemy) do
e:draw()
end

--draw player
spr(playr.sp,playr.x,playr.y,1,1,playr.flp)

--draw explosion
for o in all(explo) do
o:draw()
end

--ammo_pointer()

flare()
printp("ammo:"..ammo,8,113,10,9)
printp(kills,64,8,14,8)
end

if gamestate == "menu" then
map(0,16,cam_pos)
printp("press — to play",32,102,15,14)
printp("made by jalecko",64,120,10,9)
printp("highscore "..highscore,4,4,8,2)
end

if gamestate == "gameover" then
spr(33,playr.x,playr.y,1,1,playr.flp)
--printp("press Ž to return",28,102,15,14)
printp("highscore:"..highscore,40,50,15,14)
printp("score:"..kills,48,60,15,14)
for i = 1,6 do
spr(111+i,cam_pos+36+i*8,36)
end

end

--printp(cooldown,8,8,1,2)
--print(#enemy,16+cam_pos,16,8)
--map(0,16,cam_pos)

end
-->8
--colision

function collide_map(obj,aim,flag)
--obj = table needs x,y,w,h


local x=obj.x local y=obj.y
local w=obj.w local h=obj.h

local x1=0 
local y1=0
local x2=0 
local y2=0

	if aim=="left" then
		x1=x-1	y1=y
		x2=x	y2=y+h-1
	elseif aim=="right" then
		x1=x+w-1	y1=y
		x2=x+w	y2=y+h-1
	elseif aim=="up" then
		x1=x+2	y1=y-1
		x2=x+w-3	y2=y
	elseif aim=="down" then
		x1=x+2	y1=y+h
		x2=x+w-3	y2=y+h
	end

--decide direction
if playr.flp == false then
playr.direction = 1
else
playr.direction = -1
end


--pixels to tiles
x1/=8	y1/=8
x2/=8	y2/=8

if fget(mget(x1,y1), flag)
or fget(mget(x1,y2), flag)
or fget(mget(x2,y1), flag)
or fget(mget(x2,y2), flag) then
		return true
	else
			return false
		end

end

function hit(x,y,enx,eny,enw,enh)
	if (x>enx-8 and x<enx+enw+8) and
		(y>eny and y<eny+enh) then
		-- there was a colision
		return true
	end
 return false
end


-->8
--player

function player_update()
--physics
playr.dy+=grav
playr.dx*=playr.fric

if playr.landed then
playr.fric = 0.75
else
playr.fric = 0.95
end


--controls
if btn(0) then
	playr.dx-=playr.acc
	playr.runnin=true
	if not btn(Ž) then 
	playr.flp=true
	end
	end
	if btn(1) then
	playr.dx+=playr.acc
	playr.runnin=true
	if not btn(Ž) then
	playr.flp=false
	end
	end
	
	if playr.runnin
	and not btn(0)
	and not btn(1)
	and not playr.fallin
	and not playr.jumpin then
	playr.runnin = false
	playr.slidin = true	
	end
	--jump
	if btnp(—) then
	if playr.landed then
	playr.dy-=playr.boost
	playr.landed=false
	end
	end
	
	if playr.dy<0 and not btn(—) then
		playr.dy = max(playr.dy,-playr.boost/3) 
	end
	--check collision up and down
	if playr.dy>0 then
	playr.fallin = true
	playr.landed = false
	playr.jumpin = false
	
	playr.dy=limit_spd(playr.dy,playr.max_dy)
	
if collide_map(playr,"down",0) then
playr.landed = true
playr.fallin = false
playr.dy=0
playr.y-=(playr.y+playr.h)%8
end
elseif playr.dy<0 then
playr.jumpin = true
if collide_map(playr,"up",0) then
playr.dy=0
end
end

--horizontal colision
if playr.dx<0 then
playr.dx=limit_spd(playr.dx,playr.max_dx)
if collide_map(playr,"left",0) then
playr.dx =0
end
elseif playr.dx>0 then
playr.dx=limit_spd(playr.dx,playr.max_dx)
if collide_map(playr,"right",0) then
playr.dx = 0
end
end



--stop slidin
if playr.slidin then
	if abs(playr.dx)<.2
	or playr.runnin then
		playr.dx = 0
		playr.slidin = false
		end
	end
	
	playr.x +=playr.dx
	playr.y +=playr.dy
	end
	
	function player_animate()
	if playr.jumpin then
		playr.sp = 3
	elseif playr.fallin then
		playr.sp = 3
	elseif playr.runnin 
	or	playr.slidin then
	if time()-playr.anim>.1 then
		playr.anim = time()
		playr.sp+=1
		if playr.sp>2 then
		playr.sp=1
		end
	end
	else --playr idle
	playr.sp = 1
	end
	end

function firerate()
if playr.coold>0 then
playr.coold-=1
end
end

function flare()
if playr.coold == 3 and ammo>0 then
circfill(playr.x+4+playr.direction*4,playr.y+4,3,10)
end
end

	--shooting
	function shoot()
		if btn(Ž) and playr.coold <= 0 then 
			playr.coold = playr.rate
			if ammo > 0 then
				add_bullet(playr.x,playr.y,8*playr.direction,rnd(1)-0.5)
				sfx(0)
				ammo-=1
				playr.dx -= playr.acc*playr.direction
		 else
				sfx(3)
			end  
		end
	end

function limit_spd(num,maximum)
return mid(-maximum,num,maximum)
end
-->8
--other objects
function init_objects()
--declare bullets
bullets={}
--declare enemies
enemy={}
--declare portal
portal={}
--declare explosion
explo={}
--declare payload
payload={}
--declare ammo crate
ammocr={}
end

function add_bullet(_x,_y,_dx,_dy)
add(bullets,{
x=_x,
y=_y,
w=8,
h=2,
dx=_dx,
dy=_dy,
lif=8,
fli=playr.flp,
draw=function(self)
	spr(6,self.x,self.y,1,1,self.fli)
end,
update=function(self)
self.x+=self.dx
self.y+=self.dy
self.lif-=1
	if collide_map(self,"up",0) or
 collide_map(self,"down",0) or
 collide_map(self,"left",0) or
 collide_map(self,"right",0) then
	del(bullets,self)
	sfx(3)
	end
	if self.lif<0 then
		del(bullets,self)
	end
	end
})
end

function add_enemy(_x,_y,_dx,_dy,_dir)
add(enemy,{
x=_x,
y=_y,
w=6,
h=8,
dx=_dx,
dy=_dy,
lif=20,
stf=false,
fuse=60,
fli=false,
direc=_dir,
spn=20,
anim=0,
draw=function(self)
	if not self.stf then
	spr(self.spn,self.x,self.y,1,1,self.fli)
	else
	spr(19,self.x,self.y,1,1,self.fli)
	end
end,
update=function(self)

self.x+=self.dx
self.y+=self.dy

self.dx*=frict
self.dx=_dx*_dir

	if self.lif<0 then
	 sfx(1)
	 add_explosion(self.x,self.y)
		del(enemy,self)
		kills+=1
	end
	
if 	collide_map(self,"down",0) then
	self.dy=0
	self.y-=(self.y+self.h)%8
	else
	self.dy+=grav
	end
	
	
--fuse state things
if not self.stf then 
if time()-self.anim>.1 then
		self.anim = time()
		self.spn+=1
		if self.spn>21 then
		self.spn=20
		end
	end

if self.direc == 1 then
self.fli = false
else
self.fli = true
end

if 	collide_map(self,"right",0) and self.fli == false or 
collide_map(self,"left",0) and self.fli == true then
self.dy = -2
end

if self.x >= 184 and self.x <= 192 then
self.stf = true
sfx(5)
end
--state unfused
else
self.fuse-=1
self.dx = 0

	if self.fuse <= 0 and
		self.x >= 180 and self.x <= 204 then
		lif-=1
		sfx(8)
	 sfx(1)
	 add_explosion(self.x,self.y)
		del(enemy,self)
	end

end

end
})
end

function add_spawner(_x,_y,_dir)
add(portal,{
x=_x,
y=_y,
direc = _dir,
spn=16,
anim=0,
timut=100,
draw=function(self)
spr(self.spn,self.x,self.y)
end,
update=function(self)

	if time()-self.anim>.1 then
		self.anim = time()
		self.spn+=1
		if self.spn>18 then
		self.spn=16
		end
	end

self.timut-=1

if self.timut <=0 and
#enemy <= 16 then
	add_enemy(self.x,self.y,0.75+rnd(0.5),0,self.direc)
	self.timut=120+rnd(60)
end

end
})
end

function add_explosion(_x,_y)
add(explo,{
x=_x,
y=_y,
siz=32,
draw=function(self)
circfill(self.x,self.y,self.siz,7)
end,
update=function(self)
self.siz-=7
if self.siz <= 0 then
del(explo,self)
end
end
})
end

function add_payload(_x,_y)
add(payload,{
x=_x,
y=_y,
--lif=10,
draw=function(self)
spr(22,self.x,self.y)
for i=1,lif do
spr(32,(self.x+i*6)-(lif*3),self.y-16)
end
end,
update=function(self)

end
})
end

function add_ammo(_x,_y,_dy)
add(ammocr,{
x=_x,
y=_y,
w=8,
h=8,
dy=_dy,
landed=false,
lif=10,
draw=function(self)
spr(34,self.x,self.y)
if not collide_map(self,"down",0) then
spr(25,self.x,self.y-8)
end

if self.x<playr.x-64 then
printp("‹ ammo",8,8,10,9)
end

if self.x>playr.x+64 then
printp("ammo ‘",96,8,10,9)
end

end,
update=function(self)

if 	collide_map(self,"down",0) then
	self.dy=0
	self.y-=(self.y+self.h)%8
	else
	self.dy=0.4
	end

self.y+=self.dy

end
})
end
-->8
--camera and helper scripts

function cam()
if playr.x > 65 then
if playr.x < 320 then
cam_pos = playr.x-64
camera(cam_pos,0)
end
end
end


function startgame()
init_objects()
add_spawner(16,48,1)
add_spawner(360,48,-1)
add_spawner(24,96,1)
add_spawner(352,96,-1)
add_payload(188,80)
playr.coold = 16
	lif = 10
	kills = 0
	ammo = 60
	cam_pos=65
	endwait=15
	playr={
sp=1,
x=192,
y=80,
w=6,
h=8,
flp=false,
direction = 1,
dx=0,
dy=0,
max_dx=2,
max_dy=3,
acc=0.5,
boost=4,
rate=4,
coold=0,
anim=0,
fric=0.75,
runnin=false,
jumpin=false,
fallin=false,
slidin=false,
landed=false
	}
end


function printp(_string,_x,_y,_col,_shad)
print(_string,_x+1+cam_pos,_y+1,_shad)
print(_string,_x-1+cam_pos,_y+1,_shad)
print(_string,_x+cam_pos,_y+1,_shad)
print(_string,_x+1+cam_pos,_y,_shad)
print(_string,_x-1+cam_pos,_y,_shad)
print(_string,_x+cam_pos,_y-1,_shad)
print(_string,_x-1+cam_pos,_y-1,_shad)
print(_string,_x+1+cam_pos,_y-1,_shad)
print(_string,_x+cam_pos,_y,_col)
end
