pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- invaders 0.9
-- 2019 paul hammond

-- debug
version="0.9"
debug_stats=false
noversion=false

-- cartridge data
cartdata("phammond_inv_1p8")

-- constants
fps=60

-- movement
d_none=0
d_up=1
d_down=3
d_left=4
d_right=2

-- enums
gs_titles=0
gs_game=1

s_levelstart=-1
s_levelcomplete=-3
s_playing=0
s_loselife=2
s_landed=8
s_gameover=9

m_lower=1
m_weaving=2
m_basemove=4
m_homing=8
m_baseinvisible=16
m_faster=32

-- sfx and music
sfx_mothership=0
sfx_fire=1
sfx_drop=2
sfx_explode1=3
sfx_explode2=4
sfx_tick1=5
sfx_tick2=6
sfx_tick3=7
sfx_tick4=8
sfx_playerexplode=9
sfx_shieldsdown=10
sfx_landed=11

music_titles=0
music_gameover=40
music_start=42

-- game state
game_state=gs_titles

-- mode
mode=dget(0)

function _init()
 -- game session
 game=session:new()
 
 -- enable kb
 poke(24365,1)
 
 -- initialise
 reset_titles()
end

function reset_titles()
 flash=false
 flashcounter=0
 game_state=gs_titles
 title_counter=0
 
 -- clear sfx
 sfx(-1)
 
 -- title music
 music(music_titles) 

 -- new hi score?
 if game.score!=nil and game.score>hiscore then
  hiscore=game.score
  
  -- save (per mode)
  dset(1+mode,hiscore)
 end
 
 -- mode
 modeupdate(0)
 
 -- transition
 transition.fadein()
end

function reset_newgame()
 game_state=gs_game
 game:reset_newgame() 
 
 -- stop music
 music(-1) 
end

function _update60()
 -- counters
 flashcounter=(flashcounter+1)%60
 flash=flashcounter<30

 -- update
 if game_state==gs_titles then
  update_titles() 
 else
  update_game()
 end
 
 -- transition
 if (transition.active) transition.process()
 
 -- quit game?
 if (kb("q")) game.gameover=true
end

function update_game()
 game:update()
 
 -- game over?
 if (game.gameover) reset_titles()
end

function update_titles()
 if (title_counter<1000) title_counter+=1

 -- mode
 if (btnp(0)) modeupdate(-1)
 if (btnp(1)) modeupdate(1)
 
 -- demo game
 game:update()

 -- new game?
 if (btnp(5)) reset_newgame()
end

function _draw()
 -- draw
 if game_state==gs_titles then
  draw_titles()
 else
  game:draw()
 end
 
 -- transition
 if (transition.active) transition.draw() 
 
 -- debug
 if debug_stats then
  rectfill(0,0,60,17,10)
  ? "cpu: "..(100*(stat(1)/2)).."%",0,0,1
  ? "mem: "..stat(0),0,6
  ? "fps: "..stat(7),0,12
 end 
end

function draw_titles()
 -- demo game
 game:draw()
 
 -- version
 if (title_counter<120 and not noversion) print(version,116,1,7)

 -- camera
 camera(0,min(0,-128+title_counter))

 -- title
 pal(11,0)
 map(0,0,26,4,11,4)
 pal(11,11)
 
 -- mode etc
 printc("‹ mode "..(mode+1).." ‘",79,7,-4,true)
 if (hiscore>0) printc("hi "..hiscore.."0",88,10,0,true)
 if (flash) printc("— to start",98,7,-2,true)  

 -- other
 printc("2019 paul hammond",120,7,0,true)
 
 -- finalise
 camera()
end

function modeupdate(dir)
 local lastmode=mode
 mode=(mode+dir)%63

 -- reset demo game
 game:reset_newgame()
  
 -- save default mode
 dset(0,mode)
 
 -- load hi-score
 hiscore=dget(1+mode)
end
-->8
-- classes


-- session
session={}

function session:new()
 return init_obj({},self)
end

function session:reset_newgame()
 local s=self

 -- title screen demo?
 s.demo=(game_state==gs_titles)
 s.gameover=false

 -- general
 s.lives=3
 s.score=0
 s.level=1
 
 -- objects
 s.input=input:new(s.index)
 s.player=player:new(s)
 s.invaders=invaders:new(s)
 s.bases=bases:new(s)
 s.mothership=mothership:new(s)
 
 -- reset level
 s:reset_level(true)
end

function session:reset_level(newgame)
 local s=self

 -- sfx
 sfx(-1)

 -- collections
 s.missiles={}
 s.particles={}

 -- reset
 s:setstate(s_levelstart)
 
 -- objects
 s.invaders:initialise()
 s.bases:initialise()
 s.mothership:initialise()
 s.player:reset()
 
 -- other
 s.missilecount_player=0 
 s.missilecount_invaders=0
 
 -- level palette
 
 -- transition
 if (not s.demo) transition.fadein()
end

function session:reset_newlife()
 local s=self
 
 s.message=""
 s.player:reset()
 
 s:setstate(s_playing)
end

function session:setstate(s,c)
 if (c==nil) c=0
 self.state=s
 self.statecount=c
end

function session:update()
 local s=self
 local invaders=s.invaders
 local mothership=s.mothership

 -- input
 s.input:update()
 
 -- objects
 invaders:update()
 if (not invaders.landed) s.player:update()
 s:update_missiles()
 mothership:update()
 s.bases:update()
 
 -- particles
 s:update_particles()
 
 -- state
 if s.state==s_levelstart then
  -- ###########
  -- level start
  -- ###########
  if s.statecount==1 then
   s.message="wave "..s.level
  
   -- sfx
   if (not s.demo) music(music_start)  
  elseif s.statecount>=100 then
   s.message=""
   s:setstate(s_playing)
  end
 elseif s.state==s_playing then
  -- #######
  -- playing 
  -- #######
 elseif s.state==s_levelcomplete then
  -- ##############
  -- level complete
  -- ##############
  if s.statecount==1 then
   s.message="wave cleared"
  elseif s.statecount==120 then
   -- next level
   s.level+=1   
   s:reset_level(false)
  end
 elseif s.state==s_loselife then
  -- #########
  -- lose life
  -- #########
  if s.statecount==1 then
   s.player.active=false
   s:particlesadd(24,s.player.x+s.player.w/2,s.player.y+4,5,10)
   
   -- sfx
   gsfx(sfx_playerexplode,1)
   
   -- temporary missile reprieve
   invaders.missile_delay=90
  elseif s.statecount==90 then
   s.lives-=1
   if s.lives==0 then
    s:setstate(s_gameover)
   else
    s:reset_newlife()
   end
  end
 elseif s.state==s_landed then
  -- ######
  -- landed
  -- ######
  if s.statecount==1 then
   s.message="human civilisation is doomed"
   
   -- sfx
   gsfx(sfx_landed,0)
  elseif s.statecount==120 then
   s:setstate(s_gameover)
  end
 elseif s.state==s_gameover then
  -- #########
  -- game over
  -- #########
  if s.statecount==1 then
   s.message="game over"
   
   -- sfx
   sfx(-1)
   music(music_gameover) 
  elseif s.statecount==220 then
   s.gameover=true
  end
 end
 
 -- collisions
 for m in all(s.missiles) do
  if m.player then
   -- player missile hit invader?
   for e in all(invaders.enemies) do
    if e.active and rectsoverlap(m,e) then
     m.active=false
     invaders:destroy(e)
    end
   end
   
   -- player missile hit mother ship?
   if (mothership.active and rectsoverlap(m,mothership)) mothership:destroy()
  elseif s.player.active and s.player.shieldcount==0 then
   -- invader missile hit player?
   if rectsoverlap(m,s.player) then
    m.active=false
    if (s.state==s_playing) s:setstate(s_loselife)
   end
  end
  
  -- hit barrier?
  if (m.active and s.bases:testhit(m)) m.active=false
 end
 
 -- state counter
 if (s.statecount<1000) s.statecount+=1
end

function session:draw()
 local s=self
 
 -- initialise
 cls(1)

 -- missiles
 for m in all(s.missiles) do
  m:draw()
 end

 -- player
 s.player:draw()
 
 -- invaders
 s.invaders:draw()

 -- mother ship
 s.mothership:draw()
 
 -- bases
 s.bases:draw()

 -- particles
 for p in all(s.particles) do
  circfill(p.x,p.y,p.r,p.c)
 end
 
 -- message
 if (not s.demo and s.message) printc(s.message,48,10,0,true)
 
 -- score panel
 if (not s.demo) s:draw_scorepanel()
end

function session:draw_scorepanel()
 local s=self
 
 -- initialise
 rectfill(0,118,128,128,11)
 
 -- level
 prints(s.level,3,121,7)
 
 -- lives
 for i=1,s.lives do prints("‡",126-i*7,121,8) end
 
 -- score
 if flash or s.score<hiscore or hiscore==0 then
  local sc="0"
  if (s.score!=0) sc=s.score.."0"
  printc(sc,121,7,1,true)
 end
end

function session:scoreadd(v)
 local s=self
 
 -- score
 local oldscore=s.score
 s.score+=v
 
	-- bonus life?
 if oldscore<1500 and s.score>=1500 then
  s.lives+=1
  --gsfx(sfx_bonuslife,0)
 end
end

function session:lifelost()
 local s=self
 
 s.lives-=1
 if s.lives==0 then
  s:setstate(s_gameover)
  s.message="game over"
 else
  s:reset_newlife()
 end
end

function session:particlesadd(count,x,y,r,c)
 local s=self

 local r2,x1,y1,dx,dy,ttl
 
 for i=1,count do
  x1=x-r+rnd(r*2)
  y1=y-r+rnd(r*2)
  dx=rnd(1)-0.5
  dy=rnd(1)-0.5
  
  r2=0.5+rnd(r)  
  ttl=30+flr(rnd(15))
     
  add(s.particles,{x=x1,y=y1,r=r2,c=c,dx=dx,dy=dy,ttl=ttl})
 end
end

function session:missilesadd(x,y,player)
 local s=self
 
 local m=missile:new(s)
 m:reset(x,y,player)
 add(s.missiles,m)
 
 if player then
  s.missilecount_player+=1
 else
  s.missilecount_invaders+=1
 end 
end

function session:update_particles()
 local s=self
 
 for i=#s.particles,1,-1 do
  local p=s.particles[i]

  p.ttl-=1
  if p.ttl==0 or p.r<0.5 then
   del(s.particles,p)
  else
   if (p.r>0.5) p.r-=0.09
   p.x+=p.dx
   p.y+=p.dy
  end
 end
end

function session:update_missiles()
 local s=self
 
 for i=#s.missiles,1,-1 do
  local m=s.missiles[i]

  m:update()
  
  if not m.active then
   -- counters
   if m.player then
    s.missilecount_player-=1
   else
    s.missilecount_invaders-=1
   end
   
   del(s.missiles,m)
  end
 end
end


-- invaders
invaders={}

function invaders:new(s)
 return init_obj({session=s},self)
end

function invaders:initialise()
 local s=self
 local session=s.session
 
 -- initialise
 s.dir=2
 s.drop=false
 s.landed=false
 s.max_missiles=4
 s.missile_delay=30 
 s.speed=50
 s.speedcounter=0
 s.statecount=0
 s.tick=0
 s.sfx=0

 -- mode/level
 local starty=session.level*8
 if (hasmode(m_faster)) s.speed-=15
 if (hasmode(m_lower)) starty+=16
 
 -- enemies
 s.enemies={}
 for y=0,4 do
  for x=0,5 do
   add(s.enemies,{x=1+x*14,y=min(starty,32)+y*12,w=8,h=8,sprite=y*2,active=true,bottom=y==4})
  end
 end
 s.countactive=#s.enemies
end

function invaders:update()
 local s=self
 local session=s.session
 
 -- initialise
 local nextdrop=false
 
 -- process
 s.speedcounter+=1
 if s.speedcounter>=s.speed then
  -- tick tock
  s.speedcounter=0
  s.tick=bxor(s.tick,1)
  
  -- sfx
  if (session.state==s_playing) gsfx(sfx_tick1+s.sfx,2)
  s.sfx=(s.sfx+1)%4
  
  if not s.landed then
   -- move
   for e in all(s.enemies) do
    if e.active then
     if s.drop then
      -- drop down
      if session.demo then
       -- don't drop in demo mode
      else
       e.y+=4
       
       -- deactivate bases/ landing/ landed?
       if e.y>=106 then
        s.landed=true
        session:setstate(s_landed)
       elseif e.y>=100 then
        nextdrop=true
       elseif e.y>=82 then
        session.bases:deactivate()
       end
      end
     else
      -- march
      e.x+=s.dir
      
      -- drop missile?
      if s.missile_delay==0 and e.bottom and session.missilecount_invaders<s.max_missiles and randi(1,6)==1 then
       session:missilesadd(e.x+4,e.y,false)
       s.missile_delay=20-min(session.level,6)
      end
      
      -- edge reached?
      if (e.x==1 or e.x>=118) nextdrop=true
     end
    end
   end
   
   -- reverse direction if dropping down next go
   s.drop=nextdrop
   if (s.drop) s.dir*=-1
   
   -- don't drop down in demo mode or if player dying
   if (session.demo or session.state==s_loselife or session.state==s_gameover) s.drop=false
  end
 end
 
 -- state counters
 if (s.missile_delay>0) s.missile_delay-=1 
 if (s.statecount<1000) s.statecount+=1 
end

function invaders:draw()
 for e in all(self.enemies) do
  spr16(e,self.tick*32)
 end
end

function invaders:destroy(e)
 local s=self
 local session=s.session
 
 if e.active then
  -- destroy
  e.active=false
  session:particlesadd(16,e.x+e.w/2,e.y+4,3,10)
  
  -- score
  session:scoreadd(1)
  
  -- sfx
  gsfx(sfx_explode1,1)
  
  -- recalculate bottom-most invader
  for i=#s.enemies,1,-1 do
   local e2=s.enemies[i]
   if e2.active and e2.x==e.x then
    e2.bottom=true
    break
   end
  end
  
  -- all dead?
  s.countactive-=1  
  if (s.countactive==0) session:setstate(s_levelcomplete)
  
  -- speed up
  s.speed=max(2,s.speed-2)
  if (s.countactive==1) s.speed=1
 end
end


-- player
player={}

function player:new(s)
 return init_obj({session=s},self)
end

function player:reset()
 local s=self
 local session=s.session
 
 -- general
 s.active=not session.demo
 s.shieldcount=90
 s.x=60
 s.y=111
 s.w=9
 s.h=6
 s.sprite=64
 
 s:setstate(ps_normal) 
end

function player:setstate(s,c)
 if c==nil then c=0 end
 self.state=s
 self.statecount=c 
end

function player:update()
 local s=self
 local session=s.session
 local i=session.input
 local invaders=session.invaders
 
 if (not s.active) return
 
 if s.state==ps_normal then
  -- ======
  -- normal
  -- ======
  if (s.shieldcount>0) s.shieldcount-=1
  
  -- move
  if (i.left and s.x>1) s.x-=1
  if (i.right and s.x<119) s.x+=1
  
  -- fire
  if (i.fire and session.missilecount_player==0) session:missilesadd(s.x+4,s.y,true)
 elseif s.state==ps_dying then
  -- =====
  -- dying
  -- =====
  if (s.statecount==120) session:lifelost()
 end
 
 -- state counter
 if (s.statecount<1000) s.statecount+=1 
end

function player:draw()
 if (self.active and (self.shieldcount==0 or self.shieldcount%8<4)) spr16(self,0)
end


-- missile
missile={}

function missile:new(s)
 return init_obj({session=s},self)
end

function missile:reset(x,y,player)
 local s=self
 
 -- general
 s.active=true
 s.dircount=0
 s.x=x
 s.y=y
 s.w=1
 s.h=4
 s.player=player
 if s.player then
  s.dir=-2
  s.sprite=70
  gsfx(sfx_fire,0)
 else
  s.dir=1
  s.sprite=66
  gsfx(sfx_drop,0)
 end
end

function missile:update()
 local s=self
 local session=s.session
 
 -- move
 s.y+=s.dir
 
 -- special behaviour
 if not s.player then
  if hasmode(m_weaving) then
   -- weave
   s.dircount=(s.dircount+1)%16
   if s.dircount<8 then
    s.x+=0.5
   else
    s.x-=0.5
   end
  elseif hasmode(m_homing) then
   -- home in on player
   if session.player.x>s.x then
    s.x+=0.25
   elseif session.player.x<s.x then
    s.x-=0.25
   end
  end
 end
 
 -- deactivate?
 if s.y<-4 or s.y>128 then
  s.active=false
 elseif not session.demo and s.y>116 then
  -- harmless ground explosion
  s.active=false
  session:particlesadd(8,s.x,116,3,7)
 end
end

function missile:draw()
 spr16(self,(flr(self.y/4)%2)*2)
end


-- bases
bases={}

function bases:new(s)
 return init_obj({session=s},self)
end

function bases:initialise()
 local s=self
 
 -- initialise
 s.active=true
 s.dir=0
 s.dircounter=0

 -- mode/level
 
 -- individual bases
 s.bases={}
 for i=0,2 do
  local b=base:new(s)
  b:initialise(i,16+i*40)
  add(s.bases,b)
 end
end

function bases:update()
 for b in all(self.bases) do
  b:update()
 end
end

function bases:draw()
 for b in all(self.bases) do
  b:draw()
 end
end

function bases:testhit(e)
 local s=self
 local session=s.session
 
 for b in all(self.bases) do
  -- check rectangle collision first
  if b.active and rectsoverlap(b,e) then
   -- get position inside base rectangle
   local rx,ry=e.x-b.x,e.y-b.y
   
   -- check pixel hit
   if sget(b.sprite_offsetx+rx,b.sprite_offsety+ry)!=0 or sget(b.sprite_offsetx+rx+1,b.sprite_offsety+ry)!=0 then
    -- clear pixels (3x3)
    -- note: don't worry about overflow since all sprites have enough space around then to cope
    for y=-1,e.h-1 do
     for x=-1,1 do
      sset(b.sprite_offsetx+rx+x,b.sprite_offsety+ry+y,0)
     end
    end
   
    -- make visible
    if (b.visiblecount>=0) b.visiblecount=30
    
    -- particles
    session:particlesadd(8,e.x+e.w/2,e.y+4,1,9)
    
    return true
   end
  end
 end
 
 return false
end

function bases:deactivate()
 local s=self
 
 if s.active then
  s.active=false
  
  for b in all(self.bases) do
   if b.active then
    b.active=false
   end
  end
  
  -- sfx
  gsfx(sfx_shieldsdown,1)
 end
end


-- base
base={}

function base:new(s)
 return init_obj({session=s},self)
end

function base:initialise(index,x)
 local s=self
 
 -- general
 s.active=true
 s.x=x
 s.y=90
 s.w=16
 s.h=16
 s.dircount=32
 if hasmode(m_baseinvisible) then
  s.visiblecount=30
 else
  s.visiblecount=1
 end
 
 -- restore base sprite from template (sprite 96 2x2)
 s.sprite=208+index*2
 s.sprite_offsetx=index*16
 s.sprite_offsety=104
 for y=0,15 do
  --memcpy(104*64+y*64+index*8,48*64+y*64,8)
  memcpy(6656+y*64+index*8,3072+y*64,8)
 end 
end

function base:update()
 local s=self
 
 -- weave?
 if hasmode(m_basemove) then
  s.dircount=(s.dircount+1)%128
  if s.dircount<64 then
   s.x+=0.25
  else
   s.x-=0.25
  end
 end
 
 -- invisible?
 if hasmode(m_baseinvisible) then
  if (s.visiblecount>0) s.visiblecount-=1
 end
end

function base:draw()
 if (self.active and self.visiblecount>0) spr(self.sprite,self.x,self.y,2,2)
end


-- mothership
mothership={}

function mothership:new(s)
 return init_obj({session=s},self)
end

function mothership:initialise()
 local s=self
 
 -- general
 s.active=false
 s.y=1
 s.w=14
 s.h=6
 s.sprite=99
 s.anim=0
 s.activetime=0
end

function mothership:update()
 local s=self
 
 -- move
 if s.active then
  s.x+=s.dir
  if s.x>128 then
   s.active=false
   gsfx(-1,3)
  end
  
  -- animate
  s.anim=(s.anim+s.dir)%3
  s.sprite=103-flr(s.anim)*2
 elseif s.activetime==0 then
  s.activetime=randi(300,3600)
  s.dir=randi(3,6)/10
  s.x=-20
 else
  s.activetime-=1
  if s.activetime==0 then
   s.active=true
   s.activetime=0
   gsfx(sfx_mothership,3) 
  end
 end
end

function mothership:draw()
 spr16(self,0)
end

function mothership:destroy()
 local s=self
 local session=s.session
 
 s.active=false
 session:scoreadd(10)
 session:particlesadd(16,s.x+s.w/2,s.y+2,4,10)
 
 -- sfx
 gsfx(-1,3)
 gsfx(sfx_explode2,1)
end

-->8
-- helper
function hasmode(m)
 return band(mode,m)==m
end

function gsfx(n,c)
 if (game_state==gs_game and game.state!=s_gameover) sfx(n,c)
end

function spr16(e,sprite_offset)
 -- offset 16x16 sprites by 1 pixel to account for borders
 if (e.active) spr(e.sprite+sprite_offset,e.x-1,e.y-1,2,2)
end

function rectsoverlap(e1,e2)
 return e1.x<e2.x+e2.w and
        e2.x<e1.x+e1.w and
        e1.y<e2.y+e2.h and
        e2.y<e1.y+e1.h
end

function randi(n1,n2)
 return flr(n1+rnd(n2-n1))
end

function kb(k)
 return stat(30) and stat(31)==k
end

function init_obj(o,self)
 setmetatable(o,self)
 self.__index=self
 return o
end

function printc(s,y,c,offx,shad)
 local x=64-#s*2
 if (offx!=nil) x+=offx
 if shad then
  for y1=-1,1 do
   for x1=-1,1 do
    ? s,x+x1,y+y1,0
   end
  end
 end
	? s,x,y,c
end

function prints(s,x,y,c)
 for y1=-1,1 do
  for x1=-1,1 do
   ? s,x+x1,y+y1,0
  end
 end

	? s,x,y,c
end


-- input
input={}

function input:new()
 return init_obj({},self)
end

function input:update()
 local s=self
 
 --s.up=btn(2)
 --s.down=btn(3)
 s.left=btn(0)
 s.right=btn(1)
 s.fire=btnp(5)
end
-->8
-- effects

-- transition
transition={active=false,complete=true,effect=false}

transition.fadein=function()
 local t=transition
 
 t.effect="fadein"
 t.active=true
 t.complete=false
 t.value=0
end
 
transition.process=function()
 local t=transition
 
 if (not t.active) return 
 
 if t.effect=="fadein" and not t.complete then
  t.value+=4
  if t.value>=64 then
   t.complete=true
   t.active=false
  end
 end
 
 return t.complete
end

transition.draw=function()
 local t=transition
 
 if (not t.active) return 
 
 if t.effect=="fadein" then
  rectfill(0-t.value,0,64-t.value,128,0)
  rectfill(64+t.value,0,128+t.value,128,0)
 end
end


