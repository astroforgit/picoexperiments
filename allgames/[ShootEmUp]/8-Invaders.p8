pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- 8-invaders
-- (c)2016, blerkotronic software

-- this is my first attempt at
-- a pico-8 game, so please be
-- gentle with me if i've done
-- anything 'the hard way' in
-- this source code. ‡‡‡
-- @blerkotron

-- version 1.0, 14nov2016


-- init
function _init()
	hiscore=0
	ingame=false
	solcount=0
	eolcount=0
	gocount=0
	initstars()
	initbars()
	sfx(9)
end

-- update
function _update()

	-- always update starfield
	updatestars()
	
	if(ingame==false) then

		-- update bars
		updatebars()
		
		-- do the main menu
		if(btn(4) or btn(5)) then
			initgame()
			ingame=true
		end
	else

		-- play the game
		
		-- animation tick
		local tick=gametick()
						
		-- check for game over
		updategameover()
		if(gocount>0) then
		 return
		end
		
		-- check for start of level
		updatestartoflevel()
		if(solcount>0) then
			return
		end
		
		-- check for end of level
		updateendoflevel()
		if(eolcount>0) then
			return
		end
		
	 -- update explosions
	 updateexplosions()
	 
		-- move bullets
		movebullets()
		
		-- move invaders
		if(tick==true) then
			moveinvaders()
		end
		
		-- move saucer
		movesaucer()
		
		-- move ship
		moveship()
		
		-- update barriers
		updatebarriers()
		
		-- check to see if ship dead
		checkdead()
	end
end

-- draw
function _draw()
 
 -- clear the screen
	rectfill(0,0,127,127,0)
		
	-- draw stars
	drawstars()
	
	if(ingame!=true) then
	
		-- draw bars behind
		drawbars(0)
		
		-- render the menu
		domenu()
		
		-- draw bars in front
		drawbars(1)
	else
	
		-- render the game
				
		-- draw barriers
		drawbarriers()
		
		-- draw the bullets
		drawbullets()
		
		-- draw the explosions
		drawexplosions()
		
		-- draw the invaders
		drawinvaders()
		
		-- draw the saucer
		drawsaucer()
		
		-- draw the ship
		drawship()
		
		-- draw the display
		drawdisplay()
		
		-- start of level
		drawstartoflevel()
		
		-- end of level
		drawendoflevel()
		
		-- draw game over
		drawgameover()
		
	end
end

-- initialise a new game
function initgame()

	-- set up game variables
	score=0
	lives=2
	level=0
	anim=0
	animfast=0
	animtick=0
	invright=true
	invdown=false
	invbottom=false
	eolcount=0
	
	-- initialise ship
	ship={x=60,y=112,active=true,
							countdown=0,
							box={x1=1,x2=6,
												y1=2,y2=6}}
							
	-- initialise ship bullet
	sbullet={x=0,y=0,
										fire=false,
										box={x1=3,x2=4,
															y1=1,y2=4}}
	
	-- initialise saucer
	saucer={x=0,y=12,active=false,
									countdown=0,
									box={x1=0,x2=7,
														y1=1,y2=5}}
	initsaucercountdown()
	
	-- build a new level
 nextlevel()
 
end

-- initialise a new level
function nextlevel()

	-- increase level
	level+=1

	-- create invaders
	createinvaders()
			
	-- create barriers
	createbarriers()
	
	-- calculate chance of firing
	firechance=5+((level-1)*2)

	-- flag start of level
	solcount=60
	sfx(10)
	
end

-- menu
function domenu()
 
 -- title
 for n=0,9 do
 	spr(n+21,24+(8*n),20)
 end
 
 -- other text
 print("by @blerkotron",
 						36,36,1)
	print("(c)2016, blerkotronic software",
							4,112,12)
	print("fire to start",
							38,65,rnd(14)+1)
							--38,50,rnd(14)+1)
							
	-- high score
	highstr="high score:"..hiscore
	highpos=(128-(#highstr*4))/2
	print(highstr,highpos,90,10)
end 

-- initialise saucer countdown
function initsaucercountdown()
	saucer.countdown=rnd(150)+90
end

-- build a new set of invaders
function createinvaders()

	-- reset invaders map
	invmap={}
	
	-- reset bullet map
	bulletmap={}
	
	-- reset explosion map
	expmap={}
	
	-- create four rows of baddies
	createrow(3,1,1,6,1,6)
	createrow(4,17,1,6,1,6)
	createrow(5,5,1,6,1,6)
	createrow(6,5,1,6,1,6)
	
end

-- create a row of invaders
function createrow(rownum,sprnum,
																			cx1,cx2,
																			cy1,cy2)
	for n=0,9 do
		local inv={x=(8*n)+24,
		           y=rownum*8,
													status=0,
													sprite=sprnum,
													box={x1=cx1,x2=cx2,
																		y1=cy1,y2=cy2}}
		add(invmap,inv)
	end
end

-- draw the invaders
function drawinvaders()
	for inv in all(invmap) do
		spr(inv.sprite+anim,
						inv.x,
						inv.y)
	end
end

-- draw the bullets
function drawbullets()
	for bullet in all(bulletmap) do
		spr(14,bullet.x,bullet.y)
	end
end

-- draw the ship and its bullet
function drawship()
	if(ship.active) then
		spr(19+animfast,ship.x,ship.y)
	end
	if(sbullet.fire) then
		spr(11,sbullet.x,sbullet.y)
	end
end

-- draw the saucer
function drawsaucer()
	if(saucer.active) then
		spr(7+animfast,saucer.x,saucer.y)
	end
end

-- draw the scoreboard
function drawdisplay()
 print("score:",0,0,9)
	print(score,26,0,10)
	if(lives>0) then
		for n=0,(lives-1) do
			spr(19,(n*8),120)
		end
	end
	print("l:",112,122,12)
	if(level>10) then
		print(level,120,122,13)
	else
		print("0"..level,120,122,13)
	end
end

-- game 'tick'
function gametick()

	-- next count
	animtick+=1
	
	-- determine tick max
	local tickmax=
					gettickmax(count(invmap))
	
	-- update fast anim count
	if(animfast==0) then
		animfast=1
	else
		animfast=0
	end
	
	-- if we passed the limit...
	if(animtick>=tickmax) then
	
		-- reset the count
	 animtick=0
	 
	 -- change the animation frame
		if(anim==0) then
			anim=1
	   else
		 anim=0
		end
		
		-- and return true
		return true
	else
	
		-- return false
		return false
	end
end

-- determine invader speed
function gettickmax(i)

	-- speed based on number of
	-- invaders still left alive
	local tickmax=30	
	if(i<=5) then
		tickmax=5
	elseif(i<=10) then
		tickmax=10
	elseif(i<=20) then
		tickmax=20
	end

	-- adjust by level
	tickmax-=(level-1)
	if(tickmax<0) then
		tickmax=0
	end
	
	return tickmax
end

-- move the invaders
function moveinvaders()
	local reverse=false
	
	-- move each invader
	for inv in all(invmap) do
	
		-- move
		if(invdown and not(invbottom)) then
			inv.y+=4
		else
			if(invright) then
				inv.x+=4
				if(inv.x>=120) then
					reverse=true
				end
			else
				inv.x-=4
				if(inv.x<=0) then
					reverse=true
				end
			end
		end
	
		-- maybe fire?
		invaderfire(inv)
				
	end
	
	-- if we reached the edge
	if(reverse) then
		invdown=true
		invright=not invright
	elseif(invdown) then
	
		-- only move down once
		invdown=false
		
		-- and if any invader reached
		-- the bottom then don't move
		-- down again
		invbottom=false
		for inv in all(invmap) do
			if(inv.y>=ship.y) then
				invbottom=true
				break
			end
		end
	end
	
	-- sfx
	if(count(invmap)>0) then
		sfx(0+anim)
	end	
end

-- maybe make an invader fire
function invaderfire(inv)
	
	-- maybe fire if ship active
	if(ship.active and
				rnd(100)<firechance) then
		local bullet={x=inv.x,
																y=inv.y,
																box={x1=3,x2=4,
																					y1=3,y2=6}}
		add(bulletmap,bullet)
	end
end

-- move the ship
function moveship()

	-- only move if not dead
	if(ship.active) then
	
		-- left and right
		if(btn(0) and ship.x>0) then
			ship.x-=1
		end
		if(btn(1) and ship.x<121) then
			ship.x+=1
		end	

	else
	
		-- either dead or dying
		if(ship.countdown>0) then
			ship.countdown-=1
			
			-- lose all lives if
			-- invaders reach bottom
			if(invbottom) then
				lives=0
			end
		else
		
			-- lose a life
			if(lives>0) then
				lives-=1
			end
			
			-- reset the ship
			if(lives>=0) then
				ship.x=60
				ship.active=true
			end
		end
	end
	
	-- handle firing
	movesbullet(btn(4) or btn(5))
	
end

-- handle ship bullets
function movesbullet(firepressed)

	-- fire
	if(sbullet.fire) then
	
		-- update the bullet
		sbullet.y-=4
		if(sbullet.y<8) then
			sbullet.fire=false
			sbullet.x=0
			sbullet.y=0
		end
	elseif(firepressed and
								ship.active) then
		
		-- create the bullet
		sbullet.fire=true
		sbullet.x=ship.x
		sbullet.y=ship.y-4
	
		-- sfx
		sfx(2)
	end
		
	-- collisions
	if(sbullet.fire) then
		checkhit()
	end
end 

-- check if ship bullet hit
-- any invaders,etc.
function checkhit()
	
	-- check invaders
	for inv in all(invmap) do
		if coll(sbullet,inv) then
			destroyinvader(inv)
			return
		end
	end
	
	-- check saucer
	if coll(sbullet,saucer) then
		destroysaucer()
		return
	end
	
	-- check bullets
	for bullet in all(bulletmap) do
		if coll(sbullet,bullet) then
			destroybullet(bullet)
			return
		end
	end

end

-- move the bullets
function movebullets()	
	for bullet in all(bulletmap) do
		
		-- move bullet down
		bullet.y+=2
				
		-- check for bottom of screen
		if(bullet.y>=120) then
			del(bulletmap,bullet)
		end
	end
end

-- collision box helper
function abs_box(o)

	local box={}
	box.x1=o.box.x1+o.x
	box.x2=o.box.x2+o.x
	box.y1=o.box.y1+o.y
	box.y2=o.box.y2+o.y

	return box
end

-- collsion test
function coll(a,b)

	-- get hit boxes for both
	local boxa=abs_box(a)
	local boxb=abs_box(b)
	
	-- check for intersection
	if boxa.x1>boxb.x2 or
				boxa.y1>boxb.y2 or
				boxb.x1>boxa.x2 or
				boxb.y1>boxa.y2 then
				return false
	end
	
	-- collision detected
	return true
end

-- destroy an invader
function destroyinvader(inv)
	
	-- remove from map
	del(invmap,inv)
	
		-- handle bullet hit
	bullethit(inv.x, inv.y)
	
	-- score
	score+=10
end

-- destroy the saucer
function destroysaucer()
	
	-- handle bullet hit
	bullethit(saucer.x, saucer.y)
	
	-- destroy the saucer
	saucer.active=false
	saucer.x=0
	initsaucercountdown()
	
	-- score
	score+=50
end

-- destroy an invader bullet
function destroybullet(bullet)

	-- remove from map
	del(bulletmap,bullet)
	
		-- handle bullet hit
	bullethit(bullet.x, bullet.y)
	
	-- score
	score+=5
end

-- destroy the ship's bullet
function bullethit(x,y)
	
		-- add an explosion
	createexplosion(x,y,5)
		
	-- destroy bullet too
	sbullet.fire=false
	sbullet.x=0
	sbullet.y=0
																
end

-- update explosions
function updateexplosions()
	for exp in all(expmap) do
		exp.t-=1
		if(exp.t>0) then
			exp.tick=not exp.tick
			--sfx(3)
		else
			del(expmap,exp)
		end
	end
end

-- draw explosions
function drawexplosions()
	for exp in all(expmap) do
		local s=10
		if(exp.tick) then
			s=15
		end
		spr(s,exp.x,exp.y)
	end
end

-- move the saucer
function movesaucer()
	if(saucer.active) then
		saucer.x-=1
		if(animfast==1) then
			sfx(4)
		end
		if(saucer.x<-8) then
			saucer.active=false
			saucer.x=0
			initsaucercountdown()
		end
	else
		saucer.countdown-=1
		if(saucer.countdown<0) then
			saucer.active=true
			saucer.x=128
		end
	end
end

-- check for end of level
function updateendoflevel()

	-- if not end of level already
	if(eolcount==0) then
	
		-- check for end of level
		if(count(invmap)==0 and
					saucer.active==false and
					count(expmap)==0 and
					sbullet.fire==false and
					count(bulletmap)==0) then
					eolcount=60
					sfx(6)
		end
	else
	
		-- reduce counter						
		eolcount-=1
		
		-- setup next level
		if(eolcount==0) then
			score+=250
			nextlevel()
		end
	end 
end

-- draw end of level message
function drawendoflevel()
	if(eolcount>0) then
	
		-- display message
		print("well done",46,42,
								rnd(14)+1)
		print("bonus: 250pts",38,52,
								rnd(14)+1)
	end												
end

-- check start of level
function updatestartoflevel()
	if(solcount>0) then
		solcount-=1
	end
end

-- draw 'get ready' message
function drawstartoflevel()
	if(solcount>0) then
	
		-- display message
		print("get ready",46,85,
								rnd(14)+1)
	end
end

-- check game over
function updategameover()
	
	-- game over?
	if(gocount==0) then
	
		-- if dead and out of lives
		if(ship.active==false and
					ship.countdown==0 and
					lives <= 0) then
					gocount=150
					sfx(7)
		end
	else

		-- descrease counter
		gocount-=1
		
		-- counter expired, game over
		if(gocount==0) then
				if(score>hiscore) then
					hiscore=score
				end
				ingame=false
				sfx(9)
		end
	end
end

-- draw 'game over' message
function drawgameover()
	if(gocount>0) then
		
		-- display message
		print("game over",46,75,
								rnd(14)+1)
		
		-- new high?
		if(score>hiscore) then
			print("new high score!",
									34,85,rnd(14)+1)
		end
		
	end
end

-- check to see if ship dead
function checkdead()
	local dead=0
			
	-- invaders at bottom?
	for inv in all(invmap) do
		if(dead==0 and
					inv.y>=ship.y
					and ship.active) then
			dead=2
			break
		end
	end
	
	-- hit by bullet?
	for bullet in all(bulletmap) do
		if(dead==0 and
					ship.active and 
					coll(bullet,ship)) then
			dead=1
			del(bulletmap,bullet)
			break
		end	
	end
		
	-- hit by invader?
	if(dead==0) then
	 for inv in all(invmap) do
			if(dead==0 and 
						ship.active and
						coll(inv,ship)) then
	 		dead=1
	 		del(invmap,inv)
	 		break
			end
		end	
	end
	
	-- dead?
	if(dead>0) then
	
		-- create explosion if not
		-- already dead
		if(dead==1 or (dead==2 
					and ship.active)) then
			createexplosion(ship.x,
																			ship.y,
																			8)
		end
		
		-- disable ship
		ship.active=false
		ship.countdown=120
		
		-- invaders reached bottom?
		if(dead==2) then
			lives=-1
		end
	end	
end
	
-- make an explosion
function createexplosion(xpos,ypos,fxnum)
	local exp={x=xpos,y=ypos,
												t=10,tick=false}
	add(expmap,exp)
	sfx(fxnum)
end

-- intialise the stars
function initstars()
	starmap={}
	for n=0,50 do
		add(starmap,{x=rnd(128),
															y=rnd(128),
															inc=rnd(2)+1})
	end
end

-- update stars
function updatestars()
	for star in all(starmap) do
		star.y+=star.inc
		if(star.y>128) then
			star.y=0
			star.x=rnd(128)
			star.inc=rnd(2)+1
		end
	end
end

-- draw stars
function drawstars()
	
	-- draw starfield
	for star in all(starmap) do
		pset(star.x,star.y,
							rnd(14)+1)
	end
end

-- create barriers
function createbarriers()
	
	-- blank barrier map
	barriermap={}
	
	-- create 4x2 barriers
	createbarrier(16)
	createbarrier(24)
	createbarrier(40)
	createbarrier(48)
	createbarrier(72)
	createbarrier(80)
	createbarrier(96)
	createbarrier(104)
end

-- create a single barrier
function createbarrier(xpos)

	-- build barrier
	local barrier={x=xpos,y=96,
																str=4,
																box={x1=0,x2=7,
																y1=0,y2=6}}
																
	-- add to map
	add(barriermap,barrier)
end

-- update barriers
function updatebarriers()

	-- check all barriers
	for barrier in all(barriermap) do

		-- check for bullet hits
		for bullet in all(bulletmap) do
			if coll(bullet,barrier) then
				bullethitbarrier(barrier,bullet)
			end
		end
	
		-- check for invader hits
	 for inv in all(invmap) do
			if coll(inv,barrier) then
		 	invhitbarrier(barrier,inv)
	 	end
	 end
	
 	-- check for ship bullet hits
		if coll(sbullet,barrier) then
		 sbullethitbarrier(barrier)
		end
	
	end	
end

-- alien destroy barrier
function invhitbarrier(barrier,inv)
	
	-- destroy invader
	del(invmap,inv)
	
	-- create explosion
	createexplosion(inv.x,
																	inv.y,
																	5)
																	
	-- and wipe out the barrier
	-- completely, no messing
	del(barriermap,barrier)
end

-- bullet destroy barrier
function bullethitbarrier(barrier,bullet)
	
	-- destroy bullet
	del(bulletmap,bullet)
	
	-- create explosion
	createexplosion(bullet.x,
																	bullet.y,
																	5)
	
	-- destroy barrier
	destroybarrier(barrier)
end

-- ship bullet destroy barrier
function sbullethitbarrier(barrier)
	
	-- destroy bullet
	bullethit(barrier.x,barrier.y)
	
	-- destroy barrier
	destroybarrier(barrier)
end

-- destroy barrier
function destroybarrier(barrier)
	
	-- reduce barrier strength
	barrier.str-=1
	
	-- is barrier still active?
	if(barrier.str<=0) then
		del(barriermap,barrier)
	else
		barrier.box.y1=(4-barrier.str)*2
	end
 
end

-- draw barriers
function drawbarriers()
	for barrier in all(barriermap) do
		if(barrier.str>0) then
			spr(32+((barrier.str-1)*2)+animfast,
							barrier.x,
							barrier.y)
		end
	end
end

-- init bars
function initbars()
	barmap={}
	add(barmap,
					{y=0,inc=rnd(4)+1,
						col1=1,col2=13,col3=12})
	add(barmap,
					{y=123,inc=-(rnd(4)+1),
					 col1=2,col2=8,col3=14})
	add(barmap,
					{y=32,inc=rnd(4)+1,
					 col1=5,col2=6,col3=7})
	add(barmap,
					{y=96,inc=-(rnd(4)+1),
						col1=9,col2=10,col3=15})
end

-- draw bars
function drawbars(type)
	for bar in all(barmap) do
		if(type==0 and bar.inc<0) then
			drawbar(bar)
		elseif(type==1 and bar.inc>0) then
			drawbar(bar)
		end
	end
end

-- draw a bar
function drawbar(bar)
	line(0,bar.y,128,bar.y,bar.col1)
	line(0,bar.y+1,128,bar.y+1,bar.col2)
	line(0,bar.y+2,128,bar.y+2,bar.col3)
	line(0,bar.y+3,128,bar.y+3,bar.col2)
	line(0,bar.y+4,128,bar.y+4,bar.col1)
end

-- move bars
function updatebars()
	for bar in all(barmap) do
		bar.y+=bar.inc
		if(bar.inc>0) then
			if(bar.y>=123) then
				bar.y=123
				bar.inc=-(rnd(4)+1)
			end
		else
			if(bar.y<=0) then
				bar.y=0
				bar.inc=rnd(4)+1
			end	
		end
	end
end
