pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
function _init()
	music()
end

xx=0
yy=0
timel=180*60
function _draw()
	if opr==false and timel>0 then
		cls(1)
		xx,yy=mid(pl.x-64+pcx*16,-16,63*8-112),mid(-16,63*8-112,pl.y-64+pcy*16)
		camera(xx,yy)
		map(0,0,0,0,63,63)
		depthmap1()
		dptc()
		for e in all(enm) do
					pal(14,0)
	spr(80,e.x-3,e.y+7)
	pal()
		end
		d_drbl()
		depthmap2()
		for e in all(enm) do
			denm(e)
		end
		camera()
		local txt={"‹ and ‘ to turn",
		"z to accelerate",
		"x to brake",
		"z and x to drift",
		"stop to let people on",
		"run into low enemies to kill",
		""
		}
		cnt(txt[ttc],16)
		local ttxt=flr(timel/3600)
		local tt2=tostr(flr((timel%3600)/60))
		if #tt2==1 then
			tt2="0"..tt2
		end
		cnt(ttxt..":"..tt2,8)
	elseif opr then
		opening()
		if opt<760 then
		pal(7,6)
		cnt("press ” to skip opening",120)
		pal()
		if btn(2) then
			opt=800
		end end
	else
		local cdd=128+timel
		for i=1,8 do
			circfill(64+cos(i/8)*cdd,64+sin(i/8)*cdd,32,0)
		end
		cnt("time's up!",32)
		cnt("you saved "..hmc.." people",44)
		cnt("you beat "..enk.." aliens",50)
		cnt("press ” to replay!",64)
		if btn(2) then
			run()
		end
	end
end

wc=0
ttc=1
function _update60()
	if opr==false then
			timel-=1
	end
	if opr==false and timel>0 then
		upl()
		uhm()
		uenm()
		local tcon={
		btn(0) or btn(1),
		btn(4),
		btn(5) and not btn(4),
		btn(4) and btn(5),
		hmc>0,
		enk>0
		}
		if tcon[ttc] then ttc+=1 end


		if count(enm)<8 then
			local wx=0
			local wy=0
			while fget(mget(wx,wy),6)==true or (wy*8<yy+128 and wy*8>yy) do
			wx=rnd(64)
			wy=rnd(64)
			end
			menm(wx*8,wy*8,0)
		end

		if count(hm)<5 then
			local wx=0
			local wy=0
			while fget(mget(wx,wy),6)==true or (wx*8>xx and wx*8<xx+128) do
			wx=rnd(64)
			wy=rnd(64)
		 end			
			mhm(wx*8,wy*8)
		end
		uptc()
	end
end
-->8
--graphics misc
function depthmap1()
	local sx=flr(xx/8)-2
	local sy=flr(yy/8)-2
	bc=0
	for x=sx,sx+20 do
		for y=sy,sy+20 do
			local mg=mget(x,y)
			local cm1=mget(x+sgn(x-11-sx),y)
			local cm2=mget(x,y+sgn(y-12-sy))
			if fget(mg,7) and fget(mg,6) and not (fget(cm2,7) and fget(cm1,7)) then
				local zz=(fget(mg)%(2^7)%(2^6))*2
				bc+=zz
				for z=1,zz,mid(flr(bc/48),2,4) do
					local rx=(x*8-64-xx)*(z/64+1)+64+xx
					local ry=(y*8-80-yy)*(z/64+1)+80+yy
					local ww=z/10
					rectfill(rx-ww,ry-ww,rx+7+ww,ry+7+ww,5)
				end
			end
		end
	end

end

function depthmap2()
		local sx=flr(xx/8)-2
		local sy=flr(yy/8)-2

		for x=sx,sx+20 do
		for y=sy,sy+20 do
			local mg=mget(x,y)
			if fget(mg,7) then
			local mgn=(fget(mg)%2^7%2^6)*2
			local ic=1+flr(mgn/16)
					local rx=(x*8-64-xx)*(mgn/64+1)+64+xx
					local ry=(y*8-80-yy)*(mgn/64+1)+80+yy
					rectfill(rx-ic,ry-ic,rx+7+ic,ry+7+ic,13)
			end
		end
	end
end

function rspr(sx,sy,sw,sh,rx,ry,x,y,r)
	for x0=0,sw do
		for y0=0,sh do
			local cc=sget(x0+sx,y0+sy)
			if cc!=0 then
			local dd=sqrt((x0-rx)^2+(y0-ry)^2)
			local dx=x+cos(r+atan2(x0-rx,y0-ry))*dd
			local dy=y+sin(r+atan2(x0-rx,y0-ry))*dd
			rectfill(dx,dy,dx,dy+1,cc) end
		end
	end
end

function bprint(t,x,y,c1,c2)
	for x1=-1,1 do
		for y1=-1,1 do
			print(t,x1+x,y1+y,c1)
		end
	end
	print(t,x,y,c2)
end

drbl={}

nmm=0
doi=2
function d_drbl()
	nmm+=1
	for da=1+nmm%doi,count(drbl),doi do
		d1=drbl[min(da,count(drbl))]
		for db=1,count(drbl) do
			d2=drbl[db]
			if d1.y>d2.y and da<db then
				drbl[da],drbl[db]=drbl[db],drbl[da]
			end
		end
	end
	for h in all(hm) do
		pal(14,0)
		spr(80,h.x-4,h.y)
		pal()
	end
	for d in all(drbl) do
		if d==pl then
			circfill(d.x,d.y+4,4,0)
			dpl()
		elseif d.a==nil then
			dhm(d)
		else
			denm(d)
		end
	end
end
-->8
--player
pl={}
pl.x=56
pl.y=64
pl.xs=0
pl.ys=0
pl.dr=0
pl.dd=0
pl.sp=0
pl.ac=0.01
pl.gc=0
pl.hd=0.9
pl.ss=0
pl.ts=1/60
pl.dt=0
pcx=0
pcy=0
hmc=0
enk=0
add(drbl,pl)

function zc(y)
	return 0.75-mid((y-yy-80)/100,.25,-.25)
end
function dcar(x,y,r)
	for i=6,0,-1 do
		local zsc=zc(y)
		rspr(104,i*4,7,3,3,2,flr(x),flr(y+i*zsc),r)
	end
end

function dpl()
	dcar(pl.x,pl.y,pl.dr)
	if hmc>0 then
		bprint(hmc.."‰",pl.x-4,pl.y-10,7,13)
	end
end
function is(x,y)
	return fget(mget(x/8,y/8),6)
end


function upl()
	pl.dt=max(-8,pl.dt-1)
	pcx+=(pl.xs-pcx)/16
	pcy+=(pl.ys-pcy)/16
	if mget(pl.x/8,pl.y/8)==41 and pl.ss>=0.2 then
	for i=1,3 do
	p={}
	p.x=pl.x-pl.xs
	p.y=pl.y-pl.ys
	p.xs=-pl.xs/8+rnd(1)-.5
	p.ys=-pl.ys/8+rnd(1)-.5
	p.h=0
	p.t=0
	add(ptc,p) end end
	if btn(4) and btn(5) then
		pl.hd=0.05
	else
		pl.hd=1
	end
	if btn(4)==false and btn(5) then
		pl.xs*=0.9
		pl.ys*=0.9
	else
		pl.xs+=(cos(pl.dr)*pl.sp-pl.xs)*pl.gc
		pl.ys+=(sin(pl.dr)*pl.sp-pl.ys)*pl.gc
	end
	if pl.dt<=0 then
		if btn(0) then
			pl.dr+=pl.ts
		end
		if btn(1) then
			pl.dr-=pl.ts
		end
		if btn(4) and pl.dt<=0 then
			pl.gc=min(pl.hd,pl.gc+pl.ac)
			pl.sp=min(1.5,pl.sp+pl.ac*4)
		else
			pl.gc=max(0.5,pl.gc-pl.ac*2)
			if btn(5) then
				pl.sp-=0.5
			end
			pl.sp=max(0,pl.sp-pl.ac*2)
		end
	else
		pl.dr+=1/8
	end
	for i=0,1,1/16 do
		if is(pl.x+cos(i)*3,pl.y+sin(i)*3) then
			pl.xs-=cos(i)
			pl.ys-=sin(i)
			pl.x-=cos(i)
			pl.y-=sin(i)
			pl.gc=0
		end
	end
	pl.x+=pl.xs
	pl.y+=pl.ys
	pl.ss=sqrt(pl.xs^2+pl.ys^2)
end
-->8
--people
hm={}
function mhm(x,y)
	h={}
	h.x=x
	h.y=y
	h.xs=0
	h.ys=0
	h.zs=0
	h.s=0
	h.t=0
	add(hm,h)
	add(drbl,h)
end

function dhm(h)
		if h.s!=3 then
			local sp=64
			local dy=0
			if h.xs!=0 or h.ys!=0 then
				sp+=flr((h.t/8)%2)
			end
			if h.s==5 then
				sp=66
				dy=sin(mid(h.t,0,30)/60)*16
			end
			spr(sp,h.x-4,h.y-7+dy)
		else
			local sc=1/mid(1,h.t/8,2)
			local hp=sin((h.t/60)%.5)*8
			sspr(0,32,8,8,h.x-4+1/sc+(pl.x-h.x)*(h.t/30),h.y-7+hp+1/sc+(pl.y-h.y)*(h.t/30),sc*8,sc*8)
		end
end

function sdist(x1,y1,x2,y2)
	return max(abs(x1-x2),abs(y1-y2))
end

uoi=20
function uhm()
	for h in all(hm) do
		local pd=sdist(h.x,h.y,pl.x,pl.y)
		local wd=atan2(pl.x-h.x,pl.y-h.y)
		local stcon={pl.ss<0.4 and pd<=24,
		pl.ss>=0.4 and pd<=50 and pd>sdist(pl.x+pl.xs,pl.y+pl.ys,h.x,h.y),
		(pl.ss<0.4 and pd<=4 and pl.dt<=0) or h.s==3,
		pd>64,
		(pd<=6 and pl.ss>=0.4) or h.s==5
		}
		local lh=1
		for i=1,#stcon do
			if stcon[i] then lh=i end
		end
		if h.s!=lh then	h.s=lh h.t=0 end
		h.t+=1
		if h.s==1 then
			h.xs=cos(wd)/2
			h.ys=sin(wd)/2
		end
		if h.s==2 then
			if h.t>=15 then
				if pd>sdist(pl.x+pl.xs,pl.y+pl.ys,h.x,h.y) then
					h.xs=-cos(wd)
					h.ys=-sin(wd)
				end
			else
				h.xs,h.ys=0,0
			end
		end
		if h.s==3 then
			h.xs=0
			h.ys=0
			if h.t>=30 then
				del(hm,h)
				del(drbl,h)
				hmc+=1
				sfx(20)
			end
		end
		if h.s==4 then
			h.xs,h.ys=0,0
		end
		if h.s==5 then
			if h.t==1 then
				h.xs,h.ys=pl.xs,pl.ys
				pl.xs*=-1
				pl.ys*=-1
			end
			if h.t>=30 then
				h.xs*=0.5
				h.ys*=0.5
			end
			if h.t>=60 then
				h.s=1
			end
		end
		if is(h.x+h.xs,h.y)==false then
		h.x+=h.xs end
		if is(h.x,h.y+h.ys)==false then
		h.y+=h.ys end
	end
end
