--opening cutscene
--[[
opr=true
opt=0


crc={}
for i=0,6 do
	add(crc,{rnd(1),rnd(1),rnd(1),rnd(1)})
end

function cnt(t,y)
	local st=#t
	bprint(t,66-#t*2,y,0,7)
end

function opening()
	cls(12)
	opt=min(800,opt+1)
	if opt<=660 then
	--draw city
		local csc=cos(mid(opt-60,0,64)/128+.5)
		for j=0,3 do
			for i=0,16 do
				rectfill(i*8,-sin(i/32+j/50)*32+cos(i/4+j/2)*4+64+j*16+csc*(j/16+.25)*96,i*8+8,128,2+(j%2)*2)
			end
		end
		if opt>=120 then
			local op2=max(opt-140,0)
			local function arc(x,y,r,s,e,c)
				for i=s,e,1/r do
					line(x+cos(i)*r,y+sin(i)*r,x+cos(i+1/r)*r,y+sin(i+1/r)*r,c)
				end		
			end
			for j=1,mid(count(crc),1,flr(op2/4)) do
				for i=1,count(crc[j]) do
					local al=crc[j][i]
					local r1=(j)^2
					local rd=(j+1)^2
					line(64+cos(al)*r1,32+sin(al)*r1,64+cos(al)*rd,32+sin(al)*rd,1)
					if j<count(crc) then
						arc(64,32,rd+0.2,al,crc[j+1][i],7)
						arc(64,32,rd-0.3,al,crc[j+1][i],13)
						arc(64,32,rd,al,crc[j+1][i],1)
					end
				end
			end
			
			if opt>=240 then
				local op3=max(opt-240,0)
				circfill(64,32,16,0)
				if max(op3-60,0)%15<7 and opt<=335 then
					for x=0,1,1/16 do
						for y=3,15,12 do
							local oy=y+(240-240/op3)/8
							spr(97,56+cos(x)*oy,24+sin(x)*oy,2,2)
						end
					end
				end
					if opt>=320 then
						local eh=mid(3,12,opt-330)
						for ey=0,eh do
							local ew=sin(ey/eh/2)*12
							local dey=32-eh/2+ey
							line(64+ew,dey,64-ew,dey,8)
						end
						if opt>=330 then
							circfill(64,31,5,0) 
						end
						if opt>=400 then
							op2=max(0,opt-400)
							rbt=128-(op2-120)
							for i=0,60 do
								local dy=max(32,(op2-i*5))
								circfill(64-sin(i/20+(i%2)/2)*(dy-32),min(dy,rbt),(dy-32)/4,0)
							end					
							rectfill(0,rbt,128,128,0)
						end
				end		
			end			
		end
	elseif opt>=800 and btn(4) then
	opr=false
	music(6)
	end
	if opt>660 then
		cls(0)
	end
	if opt<180 then
	cnt("the year is 2119 ad",62) end
	if opt<500 and opt>=360 then
	cnt("a mysterious force has",60)
	cnt("invaded the city",66)
	end
	if opt>=500 and opt<660 then
		cnt("it's hacking into",60)
		cnt("all the self-driving cars",66)
	end
	if opt>=660 and opt<=760 then
		cnt("this looks like",60)
		cnt("a job for...",66)
	end
	if opt>760 then
		cnt("the last taxi",62)
		cnt("@gunturtle 2019",120)
		pal(7,6)
		cnt("press z!",80)
		pal()
	end
end


