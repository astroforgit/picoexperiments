-->8
--enemies
enm={}

function menm(x,y,t)
	e={}
	e.x=x
	e.xs=0
	e.y=y
	e.ys=0
	e.t=t
	e.s=0
	e.h=0
	e.a=0
	e.d=0
	add(enm,e)
end
--menm(32,-32)
function denm(e)

	if e.d==0 then
		if e.t==0 then
			local oy=-8-cos(mid((e.a/120)%2,1,2))*8
			circfill(e.x,e.y+oy,7,2)
			circfill(e.x,e.y+oy,5,0)
			spr(96,e.x-3.5+e.xs,e.y-4+oy)
		elseif e.t==1 then
			circfill(e.x,e.y,3,2)			
			circfill(e.x,e.y,1,0)		
		end
	else
		for r=0,1,1/8 do
			local rs=(120-(120/e.d))/4
			circfill(e.x+cos(r)*rs,e.y+sin(r)*rs,4,2)
			circfill(e.x+cos(r)*rs,e.y+sin(r)*rs,2,0)
		end
	end
end

function uenm()
	for e in all(enm) do

		if e.d>0 then
			e.d+=1
			if e.d>=30 then
				del(enm,e)
				del(drbl,e)
			end
		else
			e.x+=e.xs
			e.y+=e.ys			
		end
		if is(e.x+e.xs,e.y+e.ys) then
			if e.t==0 then
			e.xs*=-1
			e.ys*=-1
			elseif e.t==1 then
				del(enm,e)
				del(drbl,e)
			end
		end

		if sdist(e.x,e.y,pl.x,pl.y)<=8 and (abs(1.5-(e.a/120%2))<=0.3 or e.t==1) and e.d==0 and (e.t==1 or pl.ss>=0.5) then
			e.d=1
			if e.t==1 then
				pl.dt=60
				pl.sp=0
				pl.gc=0
				pl.xs=e.xs
				pl.ys=e.ys
			else
				enk+=1
			end
		end

		if e.t==0 then
			e.a%=240
			e.xs=mid(e.xs+rnd(0.1)-0.05,-0.3,0.3)
			e.ys=mid(e.ys+rnd(0.1)-0.05,-0.3,0.3)
			if e.a/120%1==0 and e.x>xx and e.y>yy and e.x<xx+128 and e.y<yy+128 then
				sfx(18,3,rnd(3),1)
				menm(e.x,e.y,1)
				local sd=atan2(e.x-pl.x,e.y-pl.y)
				enm[count(enm)].xs=-cos(sd)
				enm[count(enm)].ys=-sin(sd)
			end
		end
		e.a+=1
	end
end
-->8
--particles

ptc={}

function dptc()
	for p in all(ptc) do
		local oy=sin(p.t/30%0.5)*(15-p.t/4)
		line(p.x,p.y+oy,p.x+cos(p.t/30),p.y+sin(p.t/30)+oy,3)
		line(p.x,p.y,p.x+cos(p.t/30),p.y+sin(p.t/30),1)
	end
end

function uptc()
	for p in all(ptc) do
		p.t+=1
		p.x+=p.xs
		p.y+=p.ys
		if p.t>=30 then
			p.xs*=0.5
			p.ys*=0.5
		end
		if p.t>=60 then
			del(ptc,p)
		end
	end
end
