pico-8 cartridge // http://www.pico-8.com
version 29
__lua__

-- crazy position
-- by bgelais 2020
-- instant 3d snippet by mot
-- extra code tweaks by remcode

cartdata("lostcadesoft_crazypostiion")

score=0
high=dget(1) 
lives=3
camy=0

function _init()
go3d()
intro_init()
end


function oprint(str,_x,_y,c)
for h=_x-1,_x+1 do
 for v=_y-1,_y+1 do
  print(str,h,v,0)
 end
end
print(str,_x,_y,c)
end

-- instant 3d+!

do
 -- parameters
 p3d={
  vanish={x=64,y=0}, -- vanishing pt
  d=128,             -- screen dist in pixels
  near=1,            -- near plane z
  camyoff=32,        -- added to cam y pos
  camheight=32       -- camera height
 }

 -- save 2d versions
 map2d,spr2d,sspr2d,pset2d,camera2d=map,spr,sspr,pset,camera

 -- 3d camera position
 local cam={x=0,y=0,z=0}

 -- is 3d mode enabled?
 is3d=false

 -- helper functions

 -- screen to camera space
 local function s2c(x,y,z)
  return x-cam.x,y-cam.y,z-cam.z
 end

 -- perspective projection
 local function proj(x,y,z)
  if -y>=p3d.near then
   local scale=p3d.d/-y
   return x*scale+p3d.vanish.x,-z*scale+p3d.vanish.y,scale
  end
 end

 -- screen to projected
 local function s2p(x,y,z)
  local x,y,z=s2c(x,y,z)
  return proj(x,y,z)
 end

 -- 3d drawing fns
 function sspr3d(sx,sy,sw,sh,x,y,z,w,h,fx,fy)
  w=w or sw
  h=h or sh
  local px,py,scale=s2p(x,y,z)

  if(not scale)return
  local pw,ph=w*scale,h*scale

  -- sub pixel stuff
  local x0,x1=flr(px),flr(px+pw)
  local y0,y1=flr(py),flr(py+ph)
  sspr2d(sx,sy,sw,sh,x0,y0,x1-x0,y1-y0,fx,fy)
 end

 spr3d=function(n,x,y,z,w,h,fx,fy)
  if(not z)return
  -- convert to equivalent sspr() call
  w=(w or 1)*8
  h=(h or 1)*8
  local sx,sy=flr(n%16)*8,flr(n/16)*8
  sspr3d(sx,sy,w,h,x,y,z,w,h,fx,fy)
 end 

 function map3d(cx,cy,x,y,z,w,h,lyr)
  if(not h)return

  -- near/far corners
  local fx,fy,fz=s2c(x,y,z)
  local nx,ny,nz=s2c(x,y+h*8,z)

  -- clip
  ny=min(ny,-p3d.near)
  if(fy>=ny)return

  -- project
  local npx,npy,nscale=proj(nx,ny,nz)
  local fpx,fpy,fscale=proj(fx,fy,fz)

  if npy<fpy then
   local tx,ty,ts=npx,npy,nscale
   npx,npy,nscale=fpx,fpy,fscale
   fpx,fpy,fscale=tx,ty,ts
  end

  -- clamp
  npy=min(npy,128)
  fpy=max(fpy,0)

  -- rasterise
  local py=flr(npy)
  while py>=fpy do

   -- floor plane intercept
   local g=(py-p3d.vanish.y)/p3d.d
   local d=-nz/g  

   -- map coords
   local mx,my=cx,(-fy-d)/8+cy

   -- project to get left/right
   local lpx,lpy,lscale=proj(nx,-d,nz)
   local rpx,rpy,rscale=proj(nx+w*8,-d,nz)

   -- delta x
   local dx=w/(rpx-lpx)

   -- sub-pixel correction
   local l,r=flr(lpx+0.5)+1,flr(rpx+0.5)
   mx+=(l-lpx)*dx

   -- render
   tline(l,py,r,py,mx,my,dx,0,lyr)

   py-=1
  end 
 end 

 function map3dupright(cx,cy,x,y,z,w,h,lyr)
  if(not h)return
  local px,py,scale=s2p(x,y,z)
  if(not scale)return

  local pw,ph=w*8*scale,h*8*scale

  -- texture step
  local dx,dy=w/pw,h/ph
  local mx,my=cx+0.0625,cy+0.0625

  -- sub pixel stuff
  local x0,x1=flr(px),flr(px+pw)
  local y0,y1=flr(py),flr(py+ph)
  mx+=(x0-px)*dx
  my+=(y0-py)*dy  

  if(x0>=x1 or y0>=y1)return

  for y=y0,y1-1 do
   tline(x0,y,x1,y,mx,my,dx,0,lyr)
   my+=dy
  end
 end

 function camera3d(x,y,z)
  cam.x,cam.y,cam.z=x,y,z
 end

 -- "instant 3d" wrapper functions
 local function icamera(x,y)
  cam.x=(x or 0)+64
  cam.y=(y or 0)+128+p3d.camyoff
  cam.z=p3d.camheight
 end

 local function isspr(sx,sy,sw,sh,x,y,w,h,fx,fy)
  z=h or sh
  y+=z
  sspr3d(sx,sy,sw,sh,x,y,z,w,h,fx,fy)
 end

 local function ispr(n,x,y,w,h,fx,fy)
  z=(h or 1)*8
  y+=z
  spr3d(n,x,y,z,w,h,fx,fy)
 end

 local function imap(cx,cy,x,y,w,h,lyr)
  cx=cx or 0
  cy=cy or 0
  x=x or 0
  y=y or 0
  w=w or 128
  h=h or 64
  map3d(cx,cy,x,y,0,w,h,lyr)
 end

 function go3d()
  camera,sspr,spr,map=icamera,isspr,ispr,imap
  camera2d()
  is3d=true
 end

 function go2d()
  map,spr,sspr,pset,camera=map2d,spr2d,sspr2d,pset2d,camera2d
  is3d=false
 end

 -- defaults
 icamera()
end






-->8
--player

function player_init()
pl={
y=107,
x=64,
sp=0,
frm=1
}
end

function player_update()
sfx(0,0,pl.sp*5)
local spi,spd,spden=0.05,0.1,1
if (pl.sp>190) spden=((250-190)/3)
spi/=spden spd/=spden

if (btn(Ž)) pl.sp+=spi
if (btn(—)) pl.sp-=spd
if (btn(‹) and pl.sp>0) pl.x-=1 pl.frm=-1
if (btn(‘) and pl.sp>0) pl.x+=1 pl.frm=1
if (not btn(‹) and not btn(‘)) pl.frm=0
pl.sp=mid(0,pl.sp,5)
pl.x=mid(52,pl.x,76)
if (rival_col(pl)) explode_init()
end

function player_draw()
palt(0,false) palt(4,true)
spr3d(4,pl.x-4+pl.frm,pl.y+pl.sp,0)
spr3d(3,pl.x-4,pl.y+pl.sp,0)
spr3d(2,pl.x-4-pl.frm,pl.y+pl.sp,0)
palt()
end

function rival_col(o)
	for r in all(rivals) do
		if r.x>=o.x-8 
		and r.x<=o.x+8
		and r.y>=o.y
		and r.y<=o.y+8
		then
		del(rivals,r)
		return true end
	end
end

function explode_init()
sfx(1)
dead=true
lives-=1
timeout=time()+2	
end

function explode_update()
pl.sp-=0.1
pl.sp=max(pl.sp,0)
	if time()>=timeout then
		if lives>0 then
		 dead=false
		 sfx(2,1)	
		elseif lives==0 then
		 over_init() end
	end
end

function explode_draw()
player_draw()
spr3d(10,pl.x-8+rnd(8),pl.y+rnd(8),rnd(2))
spr3d(11,pl.x-8+rnd(8),pl.y+rnd(8),rnd(2))
spr3d(12,pl.x-8+rnd(8),pl.y+rnd(8),rnd(2))
spr3d(13,pl.x-8+rnd(8),pl.y+rnd(8),rnd(2))
end
-->8
--inits

function game_init()
sfx(2,1)
camy=0
dead=false
rivals_init()
player_init()
_update60=game_update
_draw=game_draw	
end

function title_init()
ty=128
lives=3
pl.sp=.1
timeout=time()+10
rivals_init()
_update60=title_update
_draw=title_draw
end

function over_init()
sfx(-1) sfx(4)
if (score>high) high=score dset(1,high)
ty=-512
camy=0
_update60=over_update
_draw=over_draw
end

function intro_init()
rivals_init()
player_init()
pl.sp=3 pl.frm=0
l=0
timeout=time()+12
_update60=intro_update
_draw=intro_draw	
end


-->8
--updates

function game_update()
if (time()%.5==0) build_add()
if (not dead) player_update()
if (dead) explode_update()
foreach(builds,build_update)
camy-=pl.sp camy=-128+camy%128
foreach(rivals,rivals_update)
end

function title_update()
	ty-=1
	foreach(rivals,rivals_update)
	ty=max(ty,16)
	if (time()>=timeout) intro_init()
	if btnp(—) or btnp(Ž) then
	lives=3
	score=0
	game_init()
	end
end

function over_update()
ty+=4
if (ty==128) title_init()
end

function intro_update()
if (time()>=timeout or btnp(—) or btnp(Ž)) title_init()
if (time()%.5==0) build_add()
camy-=pl.sp camy=-128+camy%128
foreach(builds,build_update)
foreach(rivals,rivals_update)
l+=pl.sp/2
dead=false
end

-->8
--draws

function game_draw()
cls(3)

--map road 3d camera
camera3d(pl.x,camy+150,24)
rectfill(0,0,127,8,12)

map(0,0,0,-256,16,16)
map(0,0,0,-128,16,16)
map(0,0,0,0,16,16)
--trafic lights
spr(21,44,-144,1,2)
spr(21,44,-16,1,2)
spr(21,44,112,1,2)
--trees
spr(35,100,-128,1,2)
spr(35,100,0,1,2)

--cars and stufs 3d camera
camera3d(pl.x,150,24)
build_draw()
rivals_draw()
if (not dead) player_draw()
if (dead) explode_draw()
--
hud_draw()
if pl.sp==0 and time()%.5>.3
and not dead then
	sfx(3)
	oprint("hit the gas!",44,46,8)
end 
end

function title_draw()
cls(12)
rectfill(0,8,127,127,3)

map(0,0,0,-256,16,16)
map(0,0,0,-128,16,16)
map(0,0,0,0,16,16)
--trafic lights
spr(21,44,-144,1,2)
spr(21,44,-16,1,2)
spr(21,44,112,1,2)
--trees
spr(35,100,-128,1,2)
spr(35,100,0,1,2)
camera3d(64,100,ty)
build_draw()
rivals_draw()
palt(0,false) palt(4,true)
spr2d(64,24,ty+16,10,4)
palt()
hud_draw()
if (ty==16) oprint("2020 lostcadesoft by bgelais",8,80,12)
if (time()%1>.5) oprint("—/Ž to play",38,100,7)

end

function over_draw()
cls(3)
rectfill(0,0,127,8,12)
map(0,0,0,-256,16,16)
map(0,0,0,-128,16,16)
map(0,0,0,0,16,16)
build_draw()
camera3d(pl.x,camy+150,24)

palt(0,false) palt(4,true)
spr3d(74,pl.x-24,ty,0,6,4)
palt()	
hud_draw()
end

function intro_draw()
game_draw()
oprint(sub([[
       
  pass as many rival cars as
  possible. beware, red and  
     yellow rival cars are 
  dangerous bastard drivers!
  
     red car.........20 pts
     yellow car......10 pts
     green car.......5 pts
     
               Ž-accel
               
      left-‹      ‹-right
      
               —-break
]],1,l),0,18,7)
end


function hud_draw()
oprint("score",1,1,8)
oprint("high score",48,1,9)

oprint(sub("‡‡‡",0,lives),100,2,14)
oprint(sub("00000"..high,-6),56,7,7)
oprint(sub("00000"..score,-6),1,7,7)
oprint(sub("00"..flr(pl.sp*50),-3).." KM/H",1,120,11)
end
-->8
--rivals & stufs

function rivals_init()
rivals={}
	for i=-256,100,40 do
		add(rivals,{
		x=50+flr(rnd(20)),
		y=i,
		xd=0,
		sp=4,
		spr=7+(16*flr(rnd(3)))
		})
	end
end

function rivals_update(o)
	o.y-=o.sp-pl.sp
	o.sp=min(o.sp,3)
	o.x+=o.xd
	o.x=mid(52,o.x,76)
	
	if o.y>pl.y+pl.sp then 
		if (o.spr==7) score+=20	
		if (o.spr==23) score+=5	
		if (o.spr==39) score+=10	
	add(rivals,{
	y=-256,
	x=50+flr(rnd(20)),
	sp=4,
	xd=0,
	spr=7+(16*flr(rnd(3))) 
	})
	del(rivals,o)
	end 
	
	if (o.x<=52 or o.x>=76) o.xd=0
		
 if o.spr==7 or o.spr==39 then
 	local d=flr(rnd(50))
 	if (d==1) o.xd=-.15
 	if (d==2) o.xd=.15
 	if (d==3) o.xd=0
 	if (d==4 and o.spr==39) o.xd=0
 end
end

function rivals_draw(o)
	for i=#rivals,1,-1 do
	o=rivals[i]
		if o.y>-128 and o.y<128 then
		 palt(0,false) palt(4,true)
	  spr3d(o.spr+1,o.x-4+o.xd,o.y-1,0)
	  spr3d(o.spr,o.x-4,o.y,0)
	  spr3d(o.spr-1,o.x-4-o.xd,o.y+1,0)
	  palt()
	 end
	end
end

-- buildings and elements

builds={}
for i=128,-256,-32 do
	add(builds,{
	x=22+(66*flr(rnd(2))),
	y=i})
	
end

function build_add()
	if pl.sp>0 then
	add(builds,{
	x=22+(66*flr(rnd(2))),
	y=-256})	
	end
end

function build_update(o)
 o.y+=pl.sp
 if (o.y>128) del(builds,o)
end

function build_draw()
 for i=#builds,1,-1 do
 o=builds[i]
 spr3d(9,o.x,o.y,32,1,4)
	spr3d(9,o.x+8,o.y,32,1,4)
	end	
end
