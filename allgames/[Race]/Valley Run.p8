pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
--valleyrun by program_ix
--dodge obstacles, stay alive
function _init()
	state=1
	debug=false
	music(1)
	updates={
		title_update,
		game_update,
		endgame_update
	}
	draws={
		title_draw,
		game_draw,
		endgame_draw
	}
	cliffs={}
	obstacles={}
	starting_fuel=500
	--player - xy coords
	p={x=60,y=100,
	--direction
	   d=0,
	--boosting?
				b=false,
	--fuel
				f=starting_fuel,
	--speed
				spd=1
	  }
	--left bound
	w={l=16,
	--right bound
		  r=104,
	--top bound
		  t=0,
	--bottom bound
		  b=120,
	--highest pos when boosting
				bt=70,
	--lowest pos when not boosting
				bb=100,
	--cliff scroll speed
				c_spd=1,
	--obstacle scroll speed
				o_spd=2,
	--warning sprite for obstacle
				sw=194,
	--time (frames) (sec*30)
				t=0,
	--distance(m)
				d=0,
	--amount of fuel from pickup
				fc=50,
		 }
	time_mods={}
	time_mods[0]=1
	time_mods[1]=1.1
	time_mods[2]=1.15
	time_mods[3]=1.3
	time_mods[4]=1.5
	time_mods[5]=1.75
	time_mods[6]=2
	time_mods[7]=2.3
	time_mods[8]=2.7
	time_mods[9]=3.1
	time_mods[10]=3.5
	time_mods[11]=4
	init_cliffs()
	init_obstacles()
end

--

function c_print(txt,y,c)
	txt=""..txt
	if(not c) then c=7 end
	print(txt,64-(#txt*2),y,c)
end

--

function collide(a,b,tol)
	if(not a.w or not a.h or 
				not b.w or not b.h)
	then
		return collide_8(a,b,tol)
	end
	return false
end

--

function collide_8(a,b,tol)
	local xmid_a=a.x+4
	local xmid_b=b.x+4
	local ymid_a=a.y+4
	local ymid_b=b.y+4
	return abs(xmid_a-xmid_b)<tol
								and
								abs(ymid_a-ymid_b)<tol
end

--

function title_update()
 if(btnp(4))
	then
		state=2
	end
end

--

function spawn_obstacle()
 o={}
 o.x=flr(rnd(80))+16
 o.y=-80-flr(rnd(400))
 o.s=128+flr(rnd(4))
 o.f=o.s==128+3
 o.xmod=0
 o.ymod=w.o_spd
 add(obstacles,o)
end

--

function init_cliffs()
	for i=0,18
	do
		spawn_cliff(true,-8+i*8)
		spawn_cliff(false,-12+i*8)
	end
end

--

function init_obstacles()
	for i=1,5
	do
		spawn_obstacle()
	end
end

--

function spawn_cliff(left,y)
	c={l=left}
	if(left)
	then
		c.s=flr(rnd(8))+2
		c.x=8
		c.y=-8
		if(y)
		then
			c.y=y
		end
	else
		c.s=flr(rnd(8))+18
		c.x=112
		c.y=-12
		if(y)
		then
			c.y=y
		end
	end
	add(cliffs,c)
end

--

function tmod()
	local mod=flr((w.t/30)/10)
	if(time_mods[mod])
	then
		return time_mods[mod]
	else
		return 4
	end
end

--

function move_cliffs()
	for c in all(cliffs)
	do
		c.y+=w.c_spd*tmod()
		--double speed if boosting
		if(p.b)
 	then
 		c.y+=w.c_spd*tmod()
 	end
		if(c.y>=129)
		then
			spawn_cliff(c.l)
			del(cliffs,c)
		end
	end
end

--

function move_player()
	local moved=false
	--reset shadow if no movement
	p.d=2
	if(btn(0) and p.x>w.l)
	then
		p.x-=p.spd*tmod()
		p.d=0
	else
		if(btn(1) and p.x<w.r)
		then
			p.x+=p.spd*tmod()
			p.d=1
		end
	end
	
	--boost
	if(btn(5) and p.f>0)
	then
		sfx(5)
		sfx(6)
		p.b=true
		p.f-=1
		w.d+=2
	else
		p.b=false
	end
	
	
	--move forward while boosting
	if(p.b and p.y>w.bt)
	then
		p.y-=p.spd*tmod()
	end
	
	if(not p.b and p.y<w.bb)
	then
		p.y+=p.spd*tmod()
		--p.d=2
	end
	p.f-=0.5
	w.d+=1
	if(p.f<=0)
	then
		reason="out of fuel!"
		state=3
	end
end

--

function move_obstacles()
	--move obstacles
	for o in all(obstacles)
	do
		o.x+=o.xmod*tmod()
		o.y+=o.ymod*tmod()
		--double speed if boosting
		if(p.b)
 	then
 		o.y+=o.ymod*tmod()
 	end
		if(o.y>128)
		then
			del(obstacles,o)
			for i=1,flr(tmod())
			do
				spawn_obstacle()
			end
		end
		if(collide(o,p,4))
		then
			--if it's fuel
			if(o.f)
			then
				p.f+=w.fc
				del(obstacles,o)
				for i=1,flr(tmod())
				do
					spawn_obstacle()
				end
			else
				--otherwise game over
				reason="crashed!"
				state=3
			end
		end
	end
	--check collision with player
	--check offscreen
	--spawn new???
end

--

function game_update()
	move_player()
	move_obstacles()
	move_cliffs()
	w.t+=1
end

--

function endgame_update()
	if(btnp(4))
	then
		_init()
	end
end

--

function title_draw()
	map(0,0)
	sspr(88,96,24,32,54,12)
	c_print("valleyrun",64,7)
	c_print("by program_ix",72,7)
	c_print("boost with x",80,7)
	c_print("dodge obstacles",88,7)
	c_print("get fuel",96,7)
	c_print("press z",104,7)
end

--

function draw_obstacles()
	for o in all(obstacles)
	do
		if(o.y<128 and o.y>-1)
		then
			spr(o.s,o.x,o.y)
		else
			if(o.y>-50 and o.y<0)
			then
				spr(w.sw,o.x,0)
			end
		end
	end
end

--

function draw_player()
	--1st sprite is 64
	--directions follow below
	--active sprites next to those
	local p_spr=64 --player
	local s_spr=80 --shadow
	local b_spr=0
	if(p.b)
	then
		b_spr=82 --blast
	else
		b_spr=81
	end
	if(p.d==0)
	then
		b_spr+=16
		s_spr+=16
		p_spr=65
	end
	if(p.d==1)
	then
		b_spr+=32
		s_spr+=32
		p_spr=66
	end
	spr(s_spr,p.x,p.y+5)
	spr(p_spr,p.x,p.y)
	spr(b_spr,p.x,p.y+8)
end

--

function draw_hud()
 --local bat=flr(p.p/starting_power*15)
 --local tum=flr(p.t/starting_tum*15)
 local fuel=flr(p.f/starting_fuel*14)
 local fc=11
 if(fuel==0 and p.f>0)
 then
 	fuel=1
 	fc=8
 end
 --local a=14
	--battery
	rectfill(120,113,128,128,0)
	rectfill(120,127-fuel,128,128,fc)
	sspr(0,96,8,16,120,112,8,16)
	--bullet???
	--rectfill(0,113,7,128,0)
	--rectfill(0,127-a,7,128,9)
	--sspr(8,96,8,16,0,112,8,16)
	
	--draw time
	print("time",1,104,7)
	print(flr(w.t/30),1,112,7)
	print("dist",1,88,7)
	print(flr(w.d),1,96,7)
	--if scaling seems weird?
	--print(tmod(),1,110,5)
end

--

function draw_map()
	map()
end

--

function draw_cliffs()
	--base
	for i=0,15
	do
		spr(1,0,i*8)
		spr(1,120,i*8)
	end
	for c in all(cliffs)
	do
		spr(c.s,c.x,c.y)
	end
end

--

function game_draw()
	draw_map()
	draw_player()
	draw_obstacles()
	draw_cliffs()
	draw_hud()
end

--

function endgame_draw()
	c_print("game over",50,7)
	c_print("you "..reason,58,7)
	c_print("you covered "
		..flr(w.d).."m",80,7)
	c_print("in "
		..flr(w.t/30)
		.." seconds",88,7)
	c_print("z to restart",104,7)
end

--

function _update()
	updates[state]()
end

--

function _draw()
	cls()
 draws[state]()
end
