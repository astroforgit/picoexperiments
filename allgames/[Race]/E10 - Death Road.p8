	 truck_verts = {{2, 0, 3.4},{2, 0, -5.4},{2, 4, -5.4},
        	{2, 4, 3.2},{2, 2, 3.4},{2, 0.7, 5.4},{-2, 0, 3.4},
        	{-2, 0, -5.4},{-2, 4, -5.4},{-2, 4, 3.2},
        	{-2, 2, 3.4}, {-2, 0.7, 3.4}}
  truck_rlight = {{1.8, 1, -5.4},{1.8, 1.2, -5.4},{1.4, 1, -5.4},
       	{1.4, 1.2, -5.4},{-1.8, 1, -5.4},
       	{-1.8, 1.2, -5.4},{-1.4, 1, -5.4},
       	{-1.4, 1.2, -5.4}}
  truck_light_sides = {
  {1,2},{1,3},{2,3},{2,4},
