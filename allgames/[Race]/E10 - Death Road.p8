function rot_verts_z(verts, angle)
	new_verts = {}
	for i = 1, #verts do
		add(new_verts,
		{verts[i][1] * cos(angle) -
		 verts[i][2] * sin(angle),
			verts[i][1] * sin(angle) +
		 verts[i][2] * cos(angle),
		verts[i][3]
		})
	end
	return new_verts
end

function rot_verts_y(verts, angle)
	new_verts = {}
	for i = 1, #verts do
		add(new_verts,
		{verts[i][3] * cos(angle) -
		 verts[i][1] * sin(angle),
		 verts[i][2],
			verts[i][3] * sin(angle) +
		 verts[i][1] * cos(angle),
		 
		})
	end
	return new_verts
end

function scale_verts(verts, scale)
	new_verts = {}
	for i = 1, #verts do
		add(new_verts,
		{verts[i][1] * scale,
			verts[i][2] * scale,
			verts[i][3] * scale
		})
	end
	return new_verts
end

function translate(verts, x, y, z)
	new_verts = {}
	for i = 1, #verts do
		add(new_verts,
		{verts[i][1] + x,
			verts[i][2] + y,
			verts[i][3] + z
		})
	end
	return new_verts
end

function get_road_angle(pos_z)
 dx = get_road_x(pos_z+1) - get_road_x(pos_z)
	return 2*pi*atan2(dx,-1)
	             
end

function get_road_x(pos_z)
	return 12*sin(pos_z / 151) + 2*sin(pos_z / 200)

end

function get_road_y(pos_z)
	return 2 + 1 *sin(pos_z / 132) + 0.5*sin(pos_z / 400)

end

