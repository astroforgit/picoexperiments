--update_game

function update_game()	
  if (btn(‹)) then
    car.roty += 0.03
    car.rotz = 0.1
  end
  if (btn(‘)) then
    car.roty -= 0.03
    car.rotz = -0.1
  end
  if (car.speed * 25 < 140 and 
      (btn(”) or btn(Ž))) then
      car.speed += 0.05 
  end
  if (btn(ƒ) or btn(—)) car.speed -= 0.08
  if (car.speed > 0) car.speed -=0.01
  
  car.speed = max(car.speed, 0)
  car.x += car.speed*cos(car.roty)
  
  if car.speed < 0.1 then
    sfx(20,3)
  elseif car.speed < 0.5 then
    sfx(21,3)
  elseif car.speed < 1.5 then
   sfx(22,3)
  elseif car.speed < 2.5 then
    sfx(23,3)
  elseif car.speed < 3.5 then
    sfx(24,3)
  else
    sfx(25, 3)
  end

  if (car.x > get_road_x(road_z) + road_width/2) then
   car.x -= 0.5
   car.roty += 0.25
   car.rotz -= 0.5
   car.damage += 10
   sfx(1,2)
  end
  if (car.x < get_road_x(road_z) - road_width/2) then
   car.x += 0.5
   car.roty -= 0.25
   car.rotz += 0.5
   car.damage += 10
   sfx(1,2)
  end
  car.rotz = 10 * car.rotz / 11
  if (not god_mode) then
    for i=1,#enemies do
      local enemy = enemies[i]
      if(abs(car.z - enemy.z) < 3 and abs(car.x - enemy.x) < 2) then
       if (enemy.speed < -0.5) then
        sfx(1,2)
        car.damage += 101
        frontal = true
        car.speed = 0
       else
        car.damage += 20
        if (car.x < enemy.x) car.roty += 0.3
        if (car.x > enemy.x) car.roty -= 0.3
        car.speed *= 0.5
        sfx(1,2)
       end  
      end
    end
  end

  if (road_z > 150) bomb_active = true
  if (get_dist_km() > end_dist) then
    game_won = true
    game_won_time = time()
    music(-1)
  end

  if (bomb_active and car.speed * 25 < 80) then
    car.bomb += 0.5
  else
    car.bomb -= 0.1
    car.bomb = max(car.bomb,0)
  end	
  	
	if ((not dead) and (car.damage >= 100 or car.bomb >= 100) and (not god_mode)) then
			deadtime = time()
			music(-1) 
			sfx(-1,3) 
			car.damage = min(car.damage, 100)
			car.bomb = min(car.bomb, 100)
			dead = true
			if (frontal) then
				car.velz = -3
			else
			car.velx = rnd(2) - 1
			car.vely = -rnd(1) - 0.1
			car.velz = sqrt(1 - car.velx*car.velx-
			                    car.vely*car.vely)
			end
			--if (rnd(10) > 5 ) car.velz *= -1 
			  
			sfx(5)
	end
	
	if(bomb_active and car.speed *25 < 80) then
 	if (car.bomb < 50) then
  		if ((flr(time()*100) % 100) == 0) sfx(4)
 	else
  		if ((flr(time()*100) % 50) == 0) sfx(4)
 	end
	end
	
	--car.z += car.speed*sin(car.roty)
	
	if (not dead) road_z += car.speed*sin(car.roty) 
	if (not dead) car.y = get_road_y(road_z)
	
	car.roty = (3*car.roty + get_road_angle(road_z)) / 4
	camera_x = (6*camera_x + car.x) /7
  
  if (mean_speed_counter == 0) then
    mean_speed = flr(car.speed * 25)
    mean_speed_counter += 1
  else
    mean_speed = mean_speed + (flr(car.speed * 25) - mean_speed) / mean_speed_counter
    mean_speed_counter += 1
  end
	update_road()
	update_enemies()
end

function update_dead()
  update_enemies()
  car.x += car.velx
  car.y += car.vely
  car.z += car.velz
  if(time() - deadtime > 2) then
    if (not dead_sound) then
      sfx(6)
      dead_sound = true
    end
    
  end
  if(time() - deadtime > 3 and
    (btnp(Ž) or btnp(—))) then
    _init()
  end
end

function update_game_won()
	if car.speed < 0.1 then
    sfx(20,3)
  elseif car.speed < 0.5 then
    sfx(21,3)
  elseif car.speed < 1.5 then
   sfx(22,3)
  elseif car.speed < 2.5 then
    sfx(23,3)
  elseif car.speed < 3.5 then
    sfx(24,3)
  else
    sfx(25, 3)
  end
		
	if (car.speed > 0) car.speed -=0.05
  car.speed = max(car.speed, 0)
  road_z += car.speed*sin(car.roty)
  
  car.y = get_road_y(road_z)
	car.x += car.speed*cos(car.roty)
	car.roty = (3*car.roty + get_road_angle(road_z)) / 4
	camera_x = (6*camera_x + car.x) /7
	update_road()
	update_enemies()

  if(time() - game_won_time > 0.5) then
    if (not won_sound) then
      sfx(7)
      won_sound = true
    end
    
  end
  if(time() - game_won_time > 6 and
    (btnp(Ž) or btnp(—))) then
    _init()
  end
end

