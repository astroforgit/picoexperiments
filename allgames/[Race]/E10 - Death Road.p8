function _update()
	if (game_state == 0) then
	 update_title()
	else
    if (not (dead or game_won)) then
      update_game()
    elseif (dead) then
      update_dead()
    elseif (game_won) then
    		update_game_won()
    end
	end
end

function add_enemy()
	next_z =  road[#road].z + 70 + rnd(50)
	next_x = get_road_x(next_z) + road_width / 4
	speed = 2
	children ={{verts=truck_rlight,
 										lines=truck_light_sides,
 										col=8}}
	
	if (rnd(10) > 5) then 
		speed = -2
		children[1].col=10
	end
	
	truck = {verts=truck_verts,
 							lines=truck_sides,
 							x = next_x, y = 3, z = next_z - road_z,
 							roty = pi/2, rotz = 0,
 							col = 0, speed = speed,
 							x_offset = 2*(rnd(1) - 0.5),
 							children=children}
	add(enemies, truck)
end

function update_enemies()
	for i = #enemies,1,-1 do
		e = enemies[i]
		
		in_front = (e.z > 6) 
		e.z = e.z - car.speed + e.speed
		e.x = (get_road_x(road_z + e.z) + 
									mid(e.speed, -1, 1) * road_width/4 +
									e.x_offset)
		e.y = get_road_y(road_z + e.z)
		
		if (in_front and e.z < 6) then
			if(e.speed < 0) sfx(2)
			if(e.speed > 0) sfx(3)
		end
		
		if (e.z < -3) del(enemies, e)
	end
	
	if (#enemies < get_num_enemies()) add_enemy()
end

function get_num_enemies()
	if(road_z < 2000) return 1
	if(road_z < 4000) return 2
	if(road_z < 8000) return 3
	if(road_z < 10000) return 4
	return 5
end

function add_road_segment()
	if (#road > 0) then
		next_z =  road[#road].z + 10
	else
		next_z = 0
	end
	x = get_road_x(next_z)
	y = get_road_y(next_z)
	
	segment = {z = next_z, x = x, y = y}
	add(road, segment)
end

function update_road()
	if (road[1].z - road_z) < -8 then
		del(road, road[1])
		add_road_segment()
	end
end

function draw_obj(obj)
	if (obj.z < -3) return
	verts = rot_verts_y(obj.verts, obj.roty)
	verts = rot_verts_z(verts, obj.rotz)
	lines = obj.lines
	
 for i = 1,#lines do
	z_world1 = verts[lines[i][1]][3] + obj.z - screen_pos
	z_world2 = verts[lines[i][2]][3] + obj.z - screen_pos
	
	line((verts[lines[i][1]][1] + obj.x - camera_x)*scaling/z_world1 + 64,
	     (verts[lines[i][1]][2] + obj.y)*scaling/z_world1 + 64,
	     (verts[lines[i][2]][1] + obj.x - camera_x)*scaling/z_world2 + 64,
	     (verts[lines[i][2]][2] + obj.y)*scaling/z_world2 + 64, obj.col)
	end
	for obj_num=1,#obj.children do
		child = obj.children[obj_num]
		verts = rot_verts_y(child.verts, obj.roty)
		verts = rot_verts_z(verts, obj.rotz)
		lines = child.lines
	
  for i = 1,#lines do
 	z_world1 = verts[lines[i][1]][3] + obj.z - screen_pos
 	z_world2 = verts[lines[i][2]][3] + obj.z - screen_pos
	line((verts[lines[i][1]][1] + obj.x - camera_x)*scaling/z_world1 + 64,
	 (verts[lines[i][1]][2] + obj.y)*scaling/z_world1 + 64,
	 (verts[lines[i][2]][1] + obj.x - camera_x)*scaling/z_world2 + 64,
	 (verts[lines[i][2]][2] + obj.y)*scaling/z_world2 + 64, child.col)
		end
	end
end

function draw_road()
 for i = 1,#road do
		z_world = road[i].z - screen_pos - road_z
	col = 6
	
	if (z_world < 60) col = 13
	if (z_world < 40) col = 5
		line((road[i].x - road_width/2 - camera_x) * scaling/z_world + 64,
	     road[i].y * scaling/z_world + 64,
	     (road[i].x + road_width/2 - camera_x)*scaling/z_world + 64,
	     road[i].y * scaling/z_world + 64, col)
	     
		if (i < #road) then
			z_world2 = road[i + 1].z - screen_pos - road_z
			line((road[i].x - road_width/2 - camera_x) * scaling/z_world + 64,
	     road[i].y * scaling/z_world + 64,
	     (road[i+1].x - road_width/2 - camera_x)*scaling/z_world2 + 64,
	     road[i+1].y * scaling/z_world2 + 64, col)
	  line((road[i].x + road_width/2 - camera_x) * scaling/z_world + 64,
	     road[i].y * scaling/z_world + 64,
	     (road[i+1].x + road_width/2 - camera_x)*scaling/z_world2 + 64,
	     road[i+1].y * scaling/z_world2 + 64, col)
		end
	end
end

function draw_meter()
	damx, damy, width, height = 60, 15, 60, 10
	print_fet("skada", damx+2, damy-7, 7,0)
	if (car.damage > 50) then
 	cols = {8, 9, 10}
		c = cols[flr(time()*100+10) % 3 + 1] 
	else
		c = 8	
	end
	
	rectfill(damx, damy,
	  damx + width*car.damage / 100, damy + height, c)
	rect(damx, damy,
	  damx + width, damy + height, 0) 
	line(damx+1, damy+ height + 1,
 	     damx+width+1, damy+ 1 + height,0)
 line(damx+width+1, damy+1,
 	     damx+width+1, damy+1+ height,0)
	dist_s = tostr(get_dist_km()) .."/337"
	print_fet(dist_s, 30 - #dist_s * 2,54, 7, 0)
	if (bomb_active) then
 	print_fet("bomb", damx+2, damy+18, 7, 0)
 	 if (car.bomb > 50) then
 	 	cols = {8, 9, 10}
				c = cols[flr(time()*100) % 3 + 1] 
 	 else
 	 	c = 8
 	 end
 	
 	 
 	rectfill(damx, damy + 25,
 	  damx + width*car.bomb / 100, damy + 25 + height, c)
 	rect(damx, damy + 25,
 	  damx + width, damy+ 25 + height, 0)    
 	line(damx+1, damy+26+ height,
 	     damx+width+1, damy+26+ height,0)
 	line(damx+width+1, damy+26,
 	     damx+width+1, damy+26+ height,0)
 	angle = 0.75*pi + (0.5*pi*80/25/2)
 	--circ(cx,cy,r,col)
 	line(cx, cy,
 	cx + 0.85*r*cos(angle),
 	cy + 0.85*r*sin(angle), 3)
	end
	
	if (bomb_active and car.speed*25 < 80 and (not game_won)) then
    cols = {0,8}
		c = cols[flr(time()*100) % 4+ 1] 
 else
 	c = 0
 end
	angle = 0.75*pi + (0.5*pi*car.speed/2) + 0.1*(time() % 1)
	cx, cy, r = 30, 30, 20
	--col = 0
	--circ(cx+1,cy+1,r,5)
	
	circ(cx,cy,r,c)
	circ(cx,cy+1,r,c)
	circfill(cx, cy, 2, c)
	print_fet(flr(car.speed * 25) .. " km/h", 20,40,7,c)
	line(cx, cy,
	cx + 0.75*r*cos(angle),
	cy + 0.75*r*sin(angle), c)
end

function draw_enemies()
	for i = 1, #enemies do
		draw_obj(enemies[i])
	
	end
end


