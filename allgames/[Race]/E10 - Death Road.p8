		pset(90,64)
		cols = {8, 9, 10}
		c = cols[flr(time()*100) % 3 + 1] 
		
		if(title_state > 0) then
		
 		print("dessutom har du en ", 15, 85, c)
 		print("bomb i skuffen!!!", 15, 92, c)
 		print("kor inte under 80 km/h!!", 15, 102, c)
			pset(19,101)
			pset(21,101)
		 spr(78,
		 	93 + 1.5*sin(20*time()),
		 	82 + 1.5*cos(20*time()),2,2) 
		end
		
		print("tryck — eller Ž", 30, 115, 7)
	else
  cls(1)
 	draw_road()
 	draw_signs()
 	draw_obj(car)
 	draw_meter()
 	draw_enemies()
 	if (dead_sound) then
 		draw_end()
 	end 
  
  if (won_sound) then
    draw_game_won()
  end
	end
end

function draw_end()
	if (time() - deadtime > 1.5) then
 	s = "du kom till " 
 	x = 64 - 2*(#s + #platser[next_sign-1][1])
 	y = 70
 	print_fet(s, x, y, 7, 0)
 	x += 4*#s
 	fet_plats(platser[next_sign - 1], x, y, 9, 0)
	end
	if (time() - deadtime > 2.5) then
		dist_km = flr(road_z * dist_scaling)
 	dist_s = tostr(dist_km) .. " km. " .. tostr(337-dist_km) .. " km kvar"
 	x = 64 - 2*(#dist_s)
 	y = 80
 	print_fet(dist_s, x, y, 7, 0)
	end
		if (time() - deadtime > 3) then
		s = "tryck pa en knapp"
 	x = 64 - 2*(#s)
 	y = 90
 	print_fet(s, x, y, 7, 0)
 	pset(x+29, y-1, 7)
	end
end

function draw_game_won()
  cols = {11, 12, 14}
	c = cols[flr(time()*5) % 3 + 1] 
	if (time() - game_won_time > 0.5) then
  
 	s = "bra jobbat! du kom anda fram!" 
 	x = 64 - 2*#s
 	y = 70
 	print(s, x, y, c)
  pset(x+76, y-1, c)
  pset(x+78, y-1, c)
 	x += 4*#s
	end
	if (time() - game_won_time > 1.5) then
		dist_km = flr(road_z * dist_scaling)
 	dist_s = "medelhastighet: " .. tostr(flr(mean_speed)) .. " km/h"
 	x = 64 - 2*(#dist_s)
 	y = 80
 	print(dist_s, x, y, c)
	end
		if (time() - game_won_time > 2) then
		s = "tryck pa en knapp"
 	x = 64 - 2*(#s)
 	y = 90
 	print(s, x, y, c)
 	pset(x+29, y-1, c)
	end
end

function get_dist_km()
	return flr(road_z * dist_scaling)
end

function draw_signs()
	sign_z = platser[next_sign][2]/dist_scaling
	sign_z = platser[next_sign][2]/dist_scaling
	

	if (road_z > sign_z + 10) then
    printh("road_z:" .. road_z .. ", sign_z:" .. sign_z .. ", next_sign:" .. next_sign)
		next_sign += 1
		sign_z = platser[next_sign][2]/dist_scaling
	end
	s = platser[next_sign][1]
	z_world = sign_z - screen_pos - road_z
	sign_scaling = 0.2
	sign_width = #s*4+1
	sign_height = 6
	scaled_width = sign_width*sign_scaling*scaling/z_world
 scaled_height = sign_height*sign_scaling*scaling/z_world
	
	scaledx = (get_road_x(sign_z) - road_width/2 - 1 - camera_x)*scaling/z_world +64
	scaledy = (get_road_y(sign_z) - 2)*scaling/z_world + 64
	
	if (scaled_height > 3) then
		sign_w_clamp = min(sign_width,scaled_width)
		sign_h_clamp = min(sign_height, scaled_height)
 
			fet_plats(platser[next_sign],
          scaledx-sign_width/2 + 1,
          scaledy-sign_height/2 + 1,
           7, 0)
	end
end

function print_fet(s, x, y, col1, col2)
	for dx=-1, 1 do
	 for dy=-1, 1 do
	 	print(s, x+dx, y+dy, col2)
  end
	end
		print(s, x, y, col1)

end

function fet_plats(ort, x, y, col1, col2)
	for dx=-1, 1 do
	 for dy=-1, 1 do
	 	print_plats(ort, x+dx, y+dy, col2)
  end
	end
		print_plats(ort, x, y, col1)
end

function print_plats(ort, x, y, col)
	s = ort[1]
	print(s, x, y, col)
 for i = 3,#ort do
  pset(x + ort[i], y-1, col)
 end

end
