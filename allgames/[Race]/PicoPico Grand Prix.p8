function get_map_flag(sprx,spry)
	local celx=flr(sprx/8)
	local cely=flr(spry/8)
	local celc=mget(celx,cely)
	return fget(celc,0)
end

function get_spr_flag(sprx,spry)
	local celx=flr(sprx/8)
	local cely=flr(spry/8)
	local celc=mget(celx,cely)
	return fget(celc)
end

--work in collision engine
function collision(x,y)
	return 	get_map_flag(scene.x+c2*3,scene.y+s2*3) or
	get_map_flag(scene.x+c3*3,scene.y+s3*3) or
	get_map_flag(scene.x+c4*3,scene.y+s4*3) or
	get_map_flag(scene.x+c5*3,scene.y+s5*3)
end
function _draw()
	if titlemode==true then
		cls(3)
		rectfill(10,40,120,106,1)
		rectfill(8,38,118,104,5)
		for i=0,120,8 do
		spr(85,i,0)
		spr(85,i,120)
		end
		spr(3,56,72,2,2)
		s=sin((cnt/40))*4
		printo(" pico pico ",s+40,20,10)
		printo("grand prix ",-s+40,30,10)
		printo("push é key to setting mode",15,110,10)
		printo("accelerator-é",12,45,7)
		printo("brake----ó",24,55,7)
		printo("boost--î",32,65,7)
		printo("left--ã         ë--right",14,78,7)
		printo("extreme driftãorë+é+ó",14,90,8)
		printo("(when high speed)",16,98,8)
	elseif settingmode==true then
		cls(12)
		rectfill(10,40,120,106,1)
		rectfill(8,38,118,104,3)
		for i=0,120,8 do
		spr(15,i,0)
		spr(31,i,120)
		end
		s=cos((cnt/20))*3
		printo("<< setting mode >>",s+32,20,9)
		printo("game style",40,50,10)
		printo("time attack   race battle",15,60,7)
		rect(12,58,60,68,9)
		spr(111,85,53)
		printo("course select",40,75,10)
		printo("short course  long course",12,85,7)
		if (courseflag==1) then
			rect(9,83,60,93,9)
		elseif (courseflag==2) then
			rect(66,83,113,93,9)
		end
		printo("push é key to start",25,110,10)
	elseif	resultmode==true then
		cls(0)
		for i=1,#sparks do
			if sparks[i].alive then
				circfill(
				sparks[i].x,
				sparks[i].y,
				sparks[i].r,
				rnd(15))
			end
		end
		score=10000-(timer+crushcnt*30)
		if score<0 then score =0 end
		s=cos((cnt/20))*3
		print("áá result áá",s+27,20,7)
		if (courseflag==1) then print("[[ short course ]]",30,40,11) end
		if (courseflag==2) then print("[[ long course  ]]",30,40,8) end
		print("time "..int2time(timer),35,50,10)
		print("crush: "..crushcnt,35,60,8)	
		print("score: "..score.."0",35,80,7)
		if (score>8500) and (courseflag == 1) then
		  print("çåç good racer çåç",-s+20,90,11)
		end
		if (score>7000) and (courseflag == 2) then
		  print("çåç excellent çåç",-s+25,90,11)
		end
		print("push ó key to restart",25,110,10)	
	else
		cls(0)
		mode()
		if (t<100)and(courseflag==1) then
			mset(75,42,65)
			mset(75,41,66)
			mset(75,40,67)
			mset(75,39,68)
			mset(75,38,66)
		end
		if (t<100)and(courseflag==2) then
			mset(95,53,65)
			mset(95,51,66)
			mset(95,49,67)
			mset(95,47,68)
			mset(95,45,66)
		end
		if (t>100)and(goal==false) then
			mset(75,42,50)
			mset(75,41,37)
			mset(75,40,37)
			mset(75,39,37)
			mset(75,38,51)
			mset(95,53,37)
			mset(95,51,37)
			mset(95,49,37)
			mset(95,47,37)
			mset(95,45,37)
		end
		if ((t>0)and(t<120)) then
			sspr(48,56,8,8,48,16,32,24)
		end
		if ((t>0)and(t<30)) then
			sspr(56,56,8,8,54,19,16,16)
		end
		if ((t>30)and(t<59)) then
			sspr(64,56,8,8,54,19,16,16)
		end
		if ((t>60)and(t<89)) then
			sspr(72,56,8,8,54,19,16,16)
		end
		if ((t>90)and(t<120)) then
			sspr(80,56,8,8,54,19,16,16)
		end

		-- left turn when driftflag on slide car sprite and sound on zazaza
		if (rotflag==1)and(driftflag==true) then
			spr(1,55,55,2,2)
			sfx(4) 
			foreach(smoke,draw_smoke)
		-- right turn when driftflag on slide car sprite and sound on zazaza
		elseif(rotflag==2)and(driftflag==true) then
			spr(7,55,55,2,2)
			sfx(4) 
			foreach(smoke,draw_smoke)
		elseif (cnt%2 == 1) and (abs(scene.spd) > 0.05) then
			spr(sprno,55,55,2,2)
		else
			spr(3,55,55,2,2)
		end
		if (nitro==true) then
			spr(103,55,71,2,1)
			sfx(5) 
		end
		if (lefttop) then
			if (crushno~=1) crushcnt+=1
			crushno=1
			spr(64,55,55)
		end
		if (righttop) then
			if (crushno~=2) crushcnt+=1
			crushno=2
			spr(64,63,55)
		end
		if (leftbottom) then
			if (crushno~=3) crushcnt+=1
			crushno=3
			spr(64,55,63)
		end
		if (rightbottom) then
			if (crushno~=4) crushcnt+=1
			crushno=4
			spr(64,63,63)
		end
		--speed meter process
		spd=0
		if scene.spd>0 then
			spd=(scene.spd/18)%1*-1
			if (crashflg==true) then
				spd=0
			end
		end
		rectfill(0,112,127,127,5)
		-- meter flame
		circfill(110,112,17,1)
		spr(80,94,96,2,2)
		spr(80,110,96,2,2,true)
		spr(80,110,112,2,2,true,true)
		spr(89,94,112,2,2,false,true)
		-- meter needle 
		line(110,112,110-cos(-spd*1.82)*15,112+sin(-spd*1.82)*15,9)
		circ(110,112,3,9)
		circfill(110,112,2,10)
		-- boost counter
		rectfill(64,120,64+nitropow*3,126,8)
		rect(64,120,64+nitropow*3,126,12)

		-- debug mode comment out 
		--debugline()
		
		printo("time ",3,121,7)
		printo("lap "..lapcnt.."/3",5,113,7)
		printo(int2time(timer),24,121,7)
		printo("boost",64,114,6)
		carspd=abs(flr(scene.spd*45))
		if (crashflg==true) then
			carspd=0
		end
		carspd_l=carspd%10
		carspd_m=((carspd-carspd_l)%100)/10
		carspd_r=flr(carspd/100)
		print(carspd_r,105,119,7)
		print(carspd_m,109,119,7)
		print(carspd_l,113,119,7)
		printo("crush:  "..crushcnt,0,0,8)
	end
	if (goal)and (latetime<0)and(resultmode==false) then
		sfx(-1)
		rectfill(0,25,127,40,1)
		if(cnt%2==1) then
			printo("push ó key to result",25,30,10)
		end
		if (btnp(5)) then
			resultmode=true
			music(3)
		end
	end
end

function cppass()
	precp=get_spr_flag(scene.x+c2*3,scene.y+s2*3)
	if ((get_spr_flag(scene.x+c2*3,scene.y+s2*3)==4)or(get_spr_flag(scene.x+c3*3,scene.y+s3*3)==4))and(cpcnt==0) then
		cpcnt=1
	end
	if ((get_spr_flag(scene.x+c2*3,scene.y+s2*3)==8)or(get_spr_flag(scene.x+c3*3,scene.y+s3*3)==8))and(cpcnt==1) then
		cpcnt=2
	end
	if ((get_spr_flag(scene.x+c2*3,scene.y+s2*3)==16)or(get_spr_flag(scene.x+c3*3,scene.y+s3*3)==16))and(cpcnt==2) then
		cpcnt=3
	end
	if ((get_spr_flag(scene.x+c2*3,scene.y+s2*3)==2)or(get_spr_flag(scene.x+c3*3,scene.y+s3*3)==2))and(cpcnt==3) then
		cpcnt=0
		cpcheck=true
		lapcnt+=1
	end
	if(lapcnt==4)then
		goal=true
		laptimer=false
		lapcnt=3
		if (courseflag==1)then
		mset(75,42,83)
		mset(75,41,69)
		mset(75,39,67)
		mset(75,38,84)
		elseif (courseflag==2)then
		mset(95,52,83)
		mset(95,50,69)
		mset(95,48,67)
		mset(95,46,84)
		end
	end
	if(goal) then
		latetime-=1
		--scene.spd=0
	end
end
---particle fireworks
sparks={}
for i=1,300 do
	add(sparks,{
		x=0,y=0,velx=0,vely=0,
		r=0,alive=false,mass=0,
		g=0
	})
end

function fireworks(x,y,r,particles)
	local selected=0
	for i=1,#sparks do
		if not sparks[i].alive then
			sparks[i].x=x
			sparks[i].y=y
			sparks[i].velx=-3+rnd(5)
			sparks[i].vely=-3+rnd(5)
			sparks[i].mass=0.5+rnd(5)
			sparks[i].g=0.9
			sparks[i].r=0.5+rnd(r)
			sparks[i].alive=true
			selected+=1
			if selected == particles then
				break 
			end
		end
	end
end
-->8
function int2time(i)
 local s=flr(i/30)
 local m=flr(s/60)
 local h=flr(99*(i-s*30)/30)
 s-=m*60
 if (s<10) s="0"..s
 if (m<10) m="0"..m
 if (h<10) h="0"..h
 return m..":"..s.."."..h
end
function printo(str,x,y,c)
 for q=-1,1 do
  for w=-1,1 do
   print(str,x+q,y+w,0)
  end
 end
 print(str,x,y,c)
end

-->8
function make_smoke(x,y,init_size,col)
	local s={}
	s.x=x
	s.y=y
	s.col=col
	s.width=init_size
	s.width_final=init_size+rnd(3)+1
	s.t=0
	s.max_t=15+rnd(10)
--	s.max_t15=15
	s.dx=(rnd(.4)-.2)
	s.dy=rnd(.2)
	s.ddy=.1
	add(smoke,s)
	return s
end
function move_smoke(sp)
	if (sp.t>sp.max_t) then
		del(smoke,sp)
	end

--	if(sp.t>sp.max_t15) then
--		sp.width+=1
--		sp.width=min(sp.width,sp.width_final)
--	end
	sp.x=sp.x+sp.dx
	sp.y=sp.y+sp.dy
	sp.dy=sp.dy+sp.ddy
	sp.t=sp.t+1
end
function draw_smoke(s)
circfill(s.x,s.y,s.width,s.col)
end
