__lua__
--[ pico pico grandprix ] 
--tline test program
--rotate course design free race game for pico8
-- pico-8 0.2.0i version and over
-- program @hoikoro man
-------------------------------------------
scene = {x=624,y=324,rot=0.5,spd=0}
c2=0
s2=0
c3=0
s3=0
c4=0
s4=0
c5=0
s5=0

-- draw some course map
function mode()
	-- grab cos and sin of scene angle
	scene.rot = scene.rot % 1
	c=cos(scene.rot)
	s=sin(scene.rot)
	rot2=(scene.rot+0.125) % 1
	rot3=(scene.rot-0.125) % 1
	rot4=(scene.rot+0.375) % 1
	rot5=(scene.rot-0.375) % 1
	c2=cos(rot2)
	s2=sin(rot2)
	c3=cos(rot3)
	s3=sin(rot3)
	c4=cos(rot4)
	s4=sin(rot4)
	c5=cos(rot5)
	s5=sin(rot5)
 
-- draw green ground
	rectfill(0,0,127,127,3)

	u=(scene.x+c2*90.5)/8
	v=(scene.y+s2*90.5)/8
	
	step=0.125

	u_step=-step*s
	v_step= step*c
	
	-- tline processing
	for y=0,127 do
		tline(0,y,127,y,u,v,u_step,v_step)
		u-= c*step
		v-= s*step
	end	
end

function _init()
	ground=false
	cnt=0
	sprno=3
	nitro=false
	nitropow=10
	t=-60
	timer=0
	ftime=0
	cnt=0
	latetime=30
	score=0
	smoke={}
	particle_cursorx=63
	particle_cursory=71
	particle_color=5
	goal=false
	cpcheck=false
	cpcnt=0
	laptimer=false
	lapcnt=1
	titlemode=true
	settingmode=false
	resultmode=false
	courseflag=1
	crushcnt=0
	crushno=0
	music(1)
	scene.spd=0
	mset(75,42,50)
	mset(75,41,37)
	mset(75,40,37)
	mset(75,39,37)
	mset(75,38,51)
	mset(95,53,37)
	mset(95,52,37)
	mset(95,51,37)
	mset(95,50,37)
	mset(95,49,37)
	mset(95,48,37)
	mset(95,47,37)
	mset(95,46,37)
	mset(95,45,37)

	scene.x=624
	scene.y=324
	scene.rot=0.5
	scene.spd=0
end

function _update()
	cnt+=1
	if titlemode==true then
		if btnp(4)  then
			titlemode=false
			settingmode=true
			gameover=0
			t=-60
		end
		return
	end

	if settingmode==true then
		if btn(0) then 
			courseflag=1
			scene.x=624
			scene.y=324
			scene.rot=0.5
			scene.spd=0
		end
		if btn(1) then
			courseflag=2
			scene.x=776
			scene.y=384
			scene.rot=0.5
			scene.spd=0
		end
		if btnp(4) then
			settingmode=false
			titlemode=false
			resultmode=false
		end
		return
	end
	if resultmode==true then
		for i=1,#sparks do
			if sparks[i].alive then
				sparks[i].x+=sparks[i].velx / sparks[i].mass
				sparks[i].y+=sparks[i].vely / sparks[i].mass*sparks[i].g
				sparks[i].r-=0.1
				if sparks[i].r<0.1 then
					sparks[i].alive=false
				end
			end
		end
		if ((score>8500) and (courseflag == 1)) or ((score>7000) and (courseflag == 2))  then
			if (cnt%16==1) then
				fireworks(rnd(127),rnd(127),5,50)
			end
		end
		if btnp(5) then
			resultmode=false
			titlemode=true
			settingmode=false
			music(1)
			_init()
		end
		return
	end
	rotflag=0
	driftflag=false
	nitro=false
	crashflg=false
	driftdiff=0.008
	t+=1
	sfx(0) --idling sound
	sprno=71
	if(t==0) sfx(6) --pi..pi..pi..piii..
	if(t==160) music(0)
	if(t>120)and(goal==false) then
		timer+=1
		laptimer=true
	end
	local prex = scene.x
	local prey = scene.y
	if(t>100)and(latetime>0)then
		--boost processe  îbutton
		if ((btn(2)==true)and(btn(5)==false)) then 
			if nitropow>0 then
				nitropow-=0.1
				nitro=true
			else
				nitropow=0
				nitro=false
			end
		end
		-- óbutton (brake)
		if btn(5)  then
			--left or right turn when over speed 2.5 and óbutton (drift on)
			if ((btn(0) or btn(1)) and scene.spd>2.5) then
				driftflag=true
			else  
				scene.spd-=0.08 --scene.spd -0.01 (speed down)
			end
		end 
		if driftflag==true then
			driftdiff=0.015
		end
		--left button when over speed 0.08
		if (btn(0)) and (abs(scene.spd)>0.08) then 
		--if btn(0) then --debug use
			scene.rot+=driftdiff*sgn(scene.spd)	--scene.rot add 0.01 (right turn)
			sprno=98
			rotflag=1
		end
		--right button when over speed 0.08
		if (btn(1)) and (abs(scene.spd)>0.08)  then 
		--if btn(1)  then  --debug use
			scene.rot-=driftdiff*sgn(scene.spd)	--scene.rot sub 0.01 (left turn)
			sprno=100
			rotflag=2
		end
		-- ébutton when under speed 6 (accelerator)
		if btn(4) and scene.spd<6 then
			scene.spd+=0.08	--scene.spd add 0.08 speed up
			sfx(1) --engine sound
		else
			scene.spd*=0.9 -- speed down when no action button
		end 
		if nitro==true then
			scene.spd+=0.8
		end
	end
	if(latetime>0) then
	
		scene.x += cos(-scene.rot)*scene.spd -- here is most worried point
		scene.y -= sin(-scene.rot)*scene.spd
		diffx=scene.x-prex
		diffy=scene.y-prey
 	lefttop=get_map_flag(scene.x+c2*3,scene.y+s2*3)
 	righttop=get_map_flag(scene.x+c3*3,scene.y+s3*3)
 	leftbottom=get_map_flag(scene.x+c4*3,scene.y+s4*3)
 	rightbottom=get_map_flag(scene.x+c5*3,scene.y+s5*3)

		if collision(scene.x,scene.y) then
			crashflg=true
			sfx(7)
			scene.x -= cos(-scene.rot)*scene.spd*2
			scene.y += sin(-scene.rot)*scene.spd*2
			if scene.spd > 0 then
				scene.spd-=0.01
			end
		end
	end
	--protection code perhaps do not need it
	if ((scene.x) < 0) or ((scene.x) > 1016) or
	((scene.y) < 0) or ((scene.y) > 504) then
		scene.x=prex
		scene.y=prey
	end

	foreach(smoke,move_smoke)
	make_smoke(particle_cursorx,particle_cursory,rnd(3),particle_color)
	cppass()

end


