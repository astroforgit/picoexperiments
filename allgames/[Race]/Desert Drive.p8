pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--desert drive
--tom brinton
-------------
debug=false
--debug mode-

p={} --player
p.x=12
p.y=72
p.xs=0
p.ys=0
p.angle=.75
p.speed=0
p.maxspd=8
p.accel=.4
p.nextc=1
p.laps=1
p.turnspd=.0125
p.pos=4
p.starttime=0
p.endtime=0

maxlaps=5

compass="       |      e      |      se      |       s       |       sw       |       w       |       nw       |       n       |       ne"

obs={} -- obstacles
numobs=75

cp={} -- checkpoints

cars={} -- ai drivers

tracks={}
maxtracks=100
trackcols={4,9,6}

drawables={} -- ordered draw list

shake=0
numcp=4

mx=0 --scrollmap start x
steering="none"

timer=0

gamestate="start" --start,play,end
countdown=4
titlezoom=0
showlap=0

function _init()
 makecheckpoints()
 for i = 1,numobs do
  makeobstacle(0,0,0)
 end
 makefence()
 addcar(10,16)
 addcar(12,17)
 addcar(14,18)
 music(0)
end

function _update()
 timer+=1
 if (timer>30) timer=0
 if gamestate=="start" then
  if titlezoom<2 then
    titlezoom+=.1
  else
    if countdown==4 then
      if btnp(4) or btnp(5) then
        countdown-=1
        countsound()
        titlezoom=0
        timer=0
      end
    else
     if timer==30 then
       titlezoom=0
       countdown-=1
       countsound()
       if (countdown==-1) sfx(3);gamestate="play";p.starttime=time() else sfx(1)
     end
    end
  end
 elseif gamestate=="play" then
  updateplayer()
  foreach(cars,updatecar)
  if (p.laps>maxlaps) gameover() 
 elseif gamestate=="end" then
  p.angle+=.005
  if (p.angle>1) p.angle-=1
  mx=-(p.angle*512)
  
  if (timer==30)endtime+=1
  
  if endtime>2 then
   if btnp(4) or btnp(5) then
    resetgame()
    gamestate="start"
   end
  end
 end
end

function gameover()
p.endtime=flr(time()-p.starttime)
p.laps=maxlaps
gamestate="end"
  p.xs=0
  p.ys=0
  for c in all(cars) do
   c.xs=0
   c.ys=0
  end
  endtime=0
end

function countsound()
 if countdown==3 then
  sfx(6)
 elseif countdown==2 then
  sfx(7)
 elseif countdown==1 then
  sfx(14)
 elseif countdown==0 then
  sfx(15)
 end
end

function resetgame()
countdown=4
titlezoom=0
showlap=0
p.laps=1
p.x=12
p.y=72
p.xs=0
p.ys=0
p.angle=.75
p.pos=4
 for o in all(obs) do
  del(obs,o)
 end
 for c in all(cars) do
  del(cars,c)
 end
 for c in all(cp) do
  del(cp,c)
 end
 for t in all(tracks) do
  del(tracks,t)
 end
 makecheckpoints()
 for i = 1,numobs do
  makeobstacle(0,0,0)
 end
 makefence()
 addcar(10,16)
 addcar(12,17)
 addcar(14,18)
end

function _draw()
 cls()
 if (shake==0) camera(0,0) else screenshake()
 drawback()
 drawmap()
 foreach(drawables,clear) --clear draw queue
 foreach(tracks,drawtracks)
 foreach(cars,getdrawable)
 foreach(obs,getdrawable)
 sort(drawables)
 foreach(drawables,ordereddraw)

 if gamestate=="start" then
   if countdown==4 then
     zspr(64,6,4,64-(22*titlezoom),64-(20*titlezoom),titlezoom)
     if titlezoom>2 then
       printc("ã/ë-steer",64,96,7,1,2)
       printc("î/z-forward",64,103,7,1,1)
       printc("É/x-reverse",64,110,7,1,1)
       printc("z or x to start",64,117,7,1,0)
     end
   elseif countdown==3 then
     drawdash()
    zspr(32,1,1,64-(4*titlezoom),32-(8*titlezoom),titlezoom)
  elseif countdown==2 then
    drawdash()
    zspr(33,1,1,64-(4*titlezoom),32-(8*titlezoom),titlezoom)
  elseif countdown==1 then
    drawdash()
    zspr(34,1,1,64-(4*titlezoom),32-(8*titlezoom),titlezoom)
  elseif countdown==0 then
    drawdash()
    zspr(35,1,1,64-(4*titlezoom),32-(8*titlezoom),titlezoom)
   end
 elseif gamestate=="play" then
  drawcompass()
  drawdash()
  if (showlap>0) drawlap()
 elseif gamestate=="end" then
  if p.pos==1 then
   printc("Å you win! Å",64,64,11,3,2)
   printc("1st place",64,72,10,9,0)
  elseif p.pos==2 then
   printc("Å you lost Å",64,64,8,2,2)
   printc("2nd place",64,72,10,9,0)
  elseif p.pos==3 then
   printc("Å you lost Å",64,64,8,2,2)
   printc("3rd place",64,72,10,9,0)
  elseif p.pos==4 then
   printc("å you came in last å",64,64,8,2,2)
   printc("4th place",64,72,10,9,0)
  end
  printc("time: "..p.endtime.." s",64,80,10,9,0)
  printc("[press z to race again]",64,96,6,5,0)
 end
 if (debug) pset(p.x,p.y,11)
 if (debug) circ(p.x,p.y,1,3)
 if (debug) pset(p.x+cos(p.angle),p.y-sin(p.angle),7)
 if (debug) foreach(obs,psetobs)
 if (debug) print(stat(1)..", "..stat(7),2,2,8)
 if (debug) foreach(cp,psetcp)
 if (debug) foreach(cars,psetcars)
end

-->8
function updateplayer()

  if (timer%10==0)updatetracks(p)
  foreach(tracks,growtracks)

  steering="none"
  if btn(ë) then
  	p.angle+=p.turnspd
  	steering="right"
   if (p.angle > 1) p.angle = -1+p.angle
  end
  if btn(ã) then
  	p.angle-=p.turnspd
  	steering="left"
   if (p.angle <0) p.angle = 1+p.angle
  end
  if ( (btn(î) or btn(4)) and abs(p.xs)<p.maxspd and abs(p.ys)<p.maxspd) then
   sfx(0)
   p.xs+=cos(p.angle)*(p.accel/10)
   p.ys-=sin(p.angle)*(p.accel/10)
  end
  if ((btn(É)or btn(5)) and abs(p.xs)<p.maxspd and abs(p.ys)<p.maxspd) then
   p.xs-=cos(p.angle)*(p.accel/20)
   p.ys+=sin(p.angle)*(p.accel/20)
  end
  
  if collisionahead(p) then
   p.xs=-(p.xs)
   p.ys=-(p.ys)
   shake=10
   sfx(2)
  end

  if (p.x<1)p.x=1
  if (p.x>126)p.x=126
  if (p.y<1)p.y=1
  if (p.y>126)p.y=126

  if passcheckpoint(p) then
   p.nextc+=1
   sfx(1)
   if (p.nextc>numcp) sfx(3);p.nextc=1;p.laps+=1;showlap=1
  end
  p.xs*=.95
  p.ys*=.95
  p.x+=p.xs
  p.y+=p.ys
  mx=-(p.angle*512)
  p.speed=((abs(p.xs)+abs(p.ys))/2)*10
  getpos(p)
end

function updatetracks(p)
  local t={}
  t.x=p.x-cos(p.angle)
  t.y=p.y+sin(p.angle)
  t.col=trackcols[ceil(rnd(3))]
  t.size=1
  add(tracks,t)
end

function growtracks(t)
  t.size+=.05
  if (t.size>3) del(tracks,t)
end

function updatecar(c)
 nexta=directiontocheckpoint(c.nextc,c)
  if (c.angle-nexta >.5) nexta+=1
  if (c.angle-nexta <-.5) nexta-=1
  if (c.angle > nexta) c.angle -= c.turnspd
  if (c.angle < nexta) c.angle += c.turnspd
  if (c.x<1)c.x=1
  if (c.x>127)c.x=127
  if (c.y<1)c.y=1
  if (c.y>127) c.y=127
   
  if (c.angle>1) c.angle-=1
  if (c.angle<0) c.angle+=1
 if rnd(1) > .4 then
  if c.xs<c.maxspd and c.ys<c.maxspd then
   c.xs+=cos(c.angle)*(c.accel/10)
   c.ys-=sin(c.angle)*(c.accel/10)
  end
  
 end
 if passcheckpoint(c) then
  c.nextc+=1
  if (c.nextc>numcp) c.nextc=1;c.laps+=1
 end
 c.xs*=.95
 c.ys*=.95
 c.x+=c.xs
 c.y+=c.ys

 if (timer%5==0)updatetracks(c)
end

-->8
function screenshake()
 camera(ceil(rnd(4)-2),ceil(rnd(4)-2))
 if (shake>0) shake-=1
end
function drawback()
 rectfill(0,0,127,48,12)
 rectfill(0,48,127,127,15)

end

function drawmap()
 map(0,0,mx,0,64,6)
 if mx< -384 then
   map(0,0,mx+512,0,64,6)
 end
end

function drawdash()
 rectfill(0,96,127,127,1)
 for i =22,25,.2 do
  circ(32,108,i,5)
 end
 circfill(32,108,10,5)
 if steering=="right" then
 	line(10,100,54,116,5)
 	line(10,101,54,117,5)
 elseif steering=="left" then
  line(10,116,54,100,5)
  line(10,117,54,101,5)
 else
  line(8,108,56,108,5)
  line(8,109,56,109,5)
 end
 drawspeedometer()
 --printo("lap "..p.laps.."/"..maxlaps,80,120,6,5)
 printo("place "..p.pos.."/4",91,89,12,1)

end

function drawlap()
 showlap+=1
 if (showlap>60) showlap=0
 printc("Å lap "..p.laps.." Å",64,32,0,7,2)
 if p.laps==maxlaps and showlap%10<5 then
 printc("final lap",64,40,8,2,0)
 end
end

function drawspeedometer()
 circfill(92,116,10,7)
 rectfill(82,117,102,127,1)
 if p.speed>0 then
  sa=.5+(p.speed/16)
  line(92,116,92+(cos(sa)*8),116-(sin(sa)*8),8)
 else
  line(92,116,83,116,8)
 end
end

function drawcompass()
 printo(compass,mx,1,6,1)
 if mx < -384 then
 printo(compass,mx+512,1,6,1)
 end
 d=directiontocheckpoint(p.nextc,p)
 if d>p.angle-.125 and d< p.angle+.125 then
  dx=64+(((d-p.angle)*100)*5.3)
  spr(13,dx-4,0)
 end
end

function psetobs(o)
 pset(o.x,o.y,8)
end

function psetcp(c)
 line(c.x1,c.y1,c.x2,c.y2,14)
end
function psetcars(c)
 pset(c.x,c.y,11)
end

function ordereddraw(d)
  scale=25/d.dist
  vx=d.x
  vx-=(8*scale)/2
  zspr(d.s,1,1,vx,50,scale)
end

-->8
function makeobstacle(x,y,t)
local o={}
 ::redo::
 if (x==0) o.x = flr(rnd(120)+4) else o.x=x
 if (y==0) o.y = flr(rnd(120)+4) else o.y=y
 for ob in all(obs) do
   if (badspot(ob,o.x,o.y)) goto redo
 end
 if (t==0) o.t = ceil(rnd(3)) else o.t=t
 if o.t==1 then
 	o.s = 1
 elseif o.t==2 then
  o.s=9
 elseif o.t==3 then
  o.s=10
 elseif o.t==4 then
  o.s=11
 elseif o.t==5 then
  o.s=12
 end
add(obs,o)
end

function badspot(ob,cx,cy)
  if ob.t==4 or ob.t==5 then
   if (distance(ob.x,ob.y,cx,cy) <8) return true
  else
   if (distance(ob.x,ob.y,cx,cy) <3) return true
  end
  return false
end

function makefence()
 for i = 0,127,2 do
  addfence(0,i)
  addfence(i,0)
  addfence(127,i)
  addfence(i,127)
 end
end

function addfence(fx,fy)
 local o={}
 o.x=fx
 o.y=fy
 o.t=4
 o.s=8
 add(obs,o)
end


-->8

function directiontocheckpoint(n,p)
if cp[n].d=="h" then
 cpx=(cp[n].x1+cp[n].x2)/2
 cpy=cp[n].y1
elseif cp[n].d=="v" then
 cpy=(cp[n].y1+cp[n].y2)/2
 cpx=cp[n].x1
end
return atan2(cpx-p.x,-(cpy-p.y))
end

function distancetocheckpoint(n,p)
if cp[n].d=="h" then
 cpx=(cp[n].x1+cp[n].x2)/2
 cpy=cp[n].y1
elseif cp[n].d=="v" then
 cpy=(cp[n].y1+cp[n].y2)/2
 cpx=cp[n].x1
end
return distance(cpx,cpy,p.x,p.y)
end

function collisionahead(p)
 cx=p.x+(p.xs)
 cy=p.y+(p.ys)
 for o in all(obs) do
 if abs(cx-o.x)<.75 and abs(cy-o.y)<.75 then
  return true
 end
 end
 for c in all(cars) do
 if abs(cx-c.x)<.75 and abs(cy-c.y)<.75 then
  c.xs=p.xs
  c.ys=p.ys
  return true
 end
 end
 if (cx<1 or cx>127 or cy<1 or cy>127) return true
 return false
end

function passcheckpoint(p)
n=p.nextc
c=cp[n]
if c.d=="h" then
 if p.x> c.x1 and p.x<c.x2 then
  if abs(p.y-c.y1) <1 then
   return true
  end
 end
elseif c.d=="v" then
 if p.y> c.y1 and p.y<c.y2 then
  if abs(p.x-c.x1) <1 then
   return true
  end
 end
end
return false
end

function getpos(p)
 p.pos=1
 for c in all(cars) do
  if c.laps > p.laps then
   p.pos+=1
   goto skip
  end
  if c.laps==p.laps and c.nextc > p.nextc then
   p.pos+=1
   goto skip
  end
  if c.laps==p.laps and c.nextc==p.nextc and distancetocheckpoint(c.nextc,c) < distancetocheckpoint(p.nextc,p) then
   p.pos+=1
  end
  ::skip::
 end 
end

function getdrawable(o)
rcangle=atan2(o.x-p.x,-(o.y-p.y))
rcdist=distance(p.x,p.y,o.x,o.y)

if abs(cos(rcangle) - cos(p.angle)) <1 then
 if rcdist<35 then
  ad=rcangle-p.angle
  if (ad<-.125) ad+=1
  if (ad>.125) ad-=1
  rcx=64+((ad*100)*5.3)
  local d={}
  d.dist=rcdist
  d.s=o.s
  d.x=rcx
  add(drawables,d)
  --if (o.laps!=nil) print(laps,rcx,40,11)
 end
end
end

function drawtracks(t)
rcangle=atan2(t.x-p.x,p.y-t.y)
rcdist=distance(p.x,p.y,t.x,t.y)

if abs(cos(rcangle) - cos(p.angle)) <1 then
 if rcdist<35 then
  ad=rcangle-p.angle
  if (ad<-.125) ad+=1
  if (ad>.125) ad-=1
  rcx=64+((ad*100)*5.3)
  scale=25/rcdist
  fillp(0b0101101001011010.1)
  circfill(rcx-(4*scale),(50-t.size)+(8*scale),t.size*scale,t.col)
  circfill(rcx+(4*scale),(50-t.size)+(8*scale),t.size*scale,t.col)
  fillp()
 end
end
end

function makecheckpoints()
	addcheckpoint(4,8,64,16,64,"h",true) -- starting point
	makeobstacle(8,64,5)
	makeobstacle(16,64,5)
	addcheckpoint(1,64,8,64,16,"v",false)
	makeobstacle(64,8,4)
	makeobstacle(64,16,4)
	addcheckpoint(2,112,64,120,64,"h",false)
	makeobstacle(112,64,4)
	makeobstacle(120,64,4)
	addcheckpoint(3,64,112,64,120,"v",false)
	makeobstacle(64,112,4)
	makeobstacle(64,120,4)
end

function addcheckpoint(n,x1,y1,x2,y2,d,start)
 local c={}
 c.start=start
 c.x1=x1
 c.y1=y1
 c.x2=x2
 c.y2=y2
 c.d=d
 cp[n]=c
end

function addcar(x,sprite)
 local c={}
 c.x=x
 c.y=66
 c.s=sprite
 c.angle=.75
 c.xs=0
 c.ys=0
 c.accel=rnd(.25)+.4
 c.maxspd=rnd(.25)+7.7
 c.turnspd=rnd(.025)+.005
 c.nextc=1
 c.laps=1
 c.pos=1
 add(cars,c)
end


function zspr(n,w,h,dx,dy,dz)
  sx = 8 * (n % 16)
  sy = 8 * flr(n / 16)
  sw = 8 * w
  sh = 8 * h
  dw = sw * dz
  dh = sh * dz

  sspr(sx,sy,sw,sh,dx,dy,dw,dh)
end
function printo(str,startx,starty,col,col_bg)
	print(str,startx+1,starty,col_bg)
	print(str,startx-1,starty,col_bg)
	print(str,startx,starty+1,col_bg)
	print(str,startx,starty-1,col_bg)
	print(str,startx+1,starty-1,col_bg)
	print(str,startx-1,starty-1,col_bg)
	print(str,startx-1,starty+1,col_bg)
	print(str,startx+1,starty+1,col_bg)
	print(str,startx,starty,col)
end
function printc(
	str,x,y,
	col,col_bg,
	special_chars)

	local len=(#str*4)+(special_chars*3)
	local startx=x-(len/2)
	local starty=y-2
	printo(str,startx,starty,col,col_bg)
end

function distance ( x1, y1, x2, y2 )
  local dx = x1 - x2
  local dy = y1 - y2
  return sqrt( dx * dx + dy * dy )
end

function sort(a)
    for i=1,#a do
        local j = i
        while j > 1 and a[j-1].dist < a[j].dist do
            a[j],a[j-1] = a[j-1],a[j]
            j = j - 1
        end
    end
end

function clear(a)
 del(drawables,a)
end
