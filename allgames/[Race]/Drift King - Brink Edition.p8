-- main menu & unlock

function draw_main_menu()
 camera(0,0)
 cls(13)
 local x0 = 0--p.x-59
 local y0 = 0--p.y-70
 sspr(24,8,16,8,x0+32,y0+16,64,32)
 print("brink edition",x0+36,y0+50,7)
 
 if menu_select == 1 then
  sspr(56,8,16,16,x0+34,y0+62,58,26)
 elseif menu_select == 2 then
  sspr(56,8,16,16,x0+34,y0+76,58,26)
 elseif menu_select == 3 then
  sspr(56,8,16,16,x0+34,y0+90,58,26)
 end
 
 print("map select",x0+44,y0+72,0)
 print("how to play",x0+42,y0+86,0)
 print("unlocks",x0+49,y0+100,0)
 
 if time()-start_flash>0.5 then
 	flash = not flash
  start_flash = time()
 end
 if flash then
  print("— to select",x0+42,y0+116,7)
 end
end

function update_main_menu()
 if btnp(ƒ) then
  menu_select+=1
  if menu_select > 3 then
   menu_select = 1
  end
 end
 
 if btnp(”) then
  menu_select-=1
  if menu_select < 1 then
   menu_select = 3
  end
 end
 
 if btnp(—)
 and time() - ui_time > 0.6 then
  if menu_select == 1 then
   start_map_menu()
  elseif menu_select == 2 then
   start_intro()
  elseif menu_select == 3 then
   start_unlock()
  end
 end
end

function update_unlock_menu()
 if btnp(”) then
  unlock_select-=1
  if unlock_select < 1 then
   unlock_select = 1
  end
 end
 
 if btnp(ƒ) then
  unlock_select+=1
  if unlock_select > unlocks+1 then
   unlock_select = unlocks+1
  end
 end
 
 if btnp(—)
 and time() - ui_time > 0.6 then
  set_vehicle(unlock_select)
 end
 
 if btnp(Ž)
 and time() - ui_time > 0.6 then
  start_menu()
 end
end

function set_vehicle(num_vehicle)
 vehicle = num_vehicle
 dset(0,num_vehicle)
 if num_vehicle == 5 then
  for i=0,15 do
   pal(i,i+128,1)
  end
 else
  for i=0,15 do
   pal(i,i,1)
  end
 end
end

function draw_unlock_menu()
 camera(0,0)
 cls(13)
 
 print("select your unlock",28,20,7) 
 local y0 = 40 + (unlock_select-1)*14
 sspr(56,8,16,16,24,y0,80,26)
 
 print("Ž",4,120,7)
 print("   back",4,120,0)
 print("select  ",88,120,0)
 print("       —",88,120,7)

 local h_count = 0
 for m in all (maps) do
  if m.pb > m.h then
   h_count+=1
  end
 end
 
 print("stock",54,50,0)
 if h_count > 0 then
  print("whiteout", 48,64,0)
 else
  print("whiteout", 48,64,5)
 end
 
 if h_count > 1 then
  print("muscle", 52,78,0)
 else
  print("muscle", 52,78,5)
 end
 
 if h_count > 3 then
  print("dragon", 52,92,0)
 else
  print("dragon", 52,92,5)
 end
 
 if h_count > 5 then
  print("shadow", 52,106,0)
 else
  print("shadow", 52,106,5)
 end
 
 print("‚",86,36+vehicle*14,0)
end
