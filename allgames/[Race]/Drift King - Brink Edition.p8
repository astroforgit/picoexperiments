-- end race
function make_endrace()
 er_select = true
end

function update_endrace()
 if btnp(‹) or btnp(‘) then
  er_select = not er_select
 end
 
 if btnp(—) 
 and time()-ui_time > 0.6 then
  if er_select then
   start_map(map_selection)
  else
   start_menu()
  end
 end
end

function draw_endrace()
 local x0 = p.x-59
 local y0 = p.y-70
 
 rectfill(x0+31,y0+31,x0+98,y0+98,0)
 rectfill(x0+32,y0+32,x0+97,y0+97,13)
 
 if not dead then
  --race complete
  if score>=cm.pb then
   print("you beat your",x0+40,y0+40,7)
   print("personal best",x0+40,y0+48,12)
  elseif score>=cm.h then
   print("you beat the",x0+42,y0+40,7)
   print("hidden score",x0+42,y0+48,12)
  elseif score>=cm.g then
   print("you beat the",x0+42,y0+40,7)
   print("gold score",x0+44,y0+48,10)
  elseif score>=cm.s then
   print("you beat the",x0+42,y0+40,7)
   print("silver score",x0+42,y0+48,6)
  elseif score>=cm.b then
   print("you beat the",x0+42,y0+40,7)
   print("bronze score",x0+42,y0+48,9)
  else
   print("you really suck",x0+36,y0+40,7)
   print("learn to drift",x0+38,y0+48,7)
  end
 else
  --fell off edge
  print("yOU fELL",x0+48,y0+56,0)
  spr(21,x0+56,y0+36,2,2)
 end
 
 print("tRY aGAIN?",x0+45,y0+76,7)
 
 if er_select then
  sspr(56,8,16,16,x0+42,y0+81,20,16)
  print("yES",x0+46,y0+86,0)
  print("nO",x0+76,y0+86,0)
 else
  sspr(56,8,16,16,x0+69,y0+81,20,16)
  print("yES",x0+46,y0+86,0)
  print("nO",x0+76,y0+86,0)
 end
 
end
