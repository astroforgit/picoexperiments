--player
function make_player()
	 p = {
	  x=32,
	 	y=32,
	 	aim=0.25,
	 	vel=0,
	  acc=0.9,
	  brk=.3,
	  steer = 0,
	  maxsteer=0.05,
	  wheelbase = 10,
	  grip=0.9 ,
	  friction=0.85,
	  size=16,
	  old={0.25,0.25,0.25,0.25,0.25,0.25},
	  drifting = false
	 }
	 momentum = p.aim
	 danim = time()
end

function update_player()
 add(p.old, p.aim)
	if(btn(—)) then
		p.vel+=p.acc-- * (1-p.vel/5)
	end
	
	if(p.vel >4) then
		--p.vel = 4
	end
	
	
 p.steer = 0
	if btn(‹) then
	 p.steer = -p.maxsteer
	end
	
	if btn(‘) then
	 p.steer = p.maxsteer
	end
	
	
	p.vel*=p.friction
	
	--get front and back wheel location
	front_w_x = sin(p.aim)*p.wheelbase/2 + p.x
	front_w_y = cos(p.aim)*p.wheelbase/2 + p.y
	back_w_x = sin(p.aim)*p.wheelbase/2*-1 + p.x
	back_w_y = cos(p.aim)*p.wheelbase/2*-1 + p.y
	
	--move front wheel in steering direction
	front_w_x = sin(p.aim+p.steer)*p.vel+front_w_x
	front_w_y = cos(p.aim+p.steer)*p.vel+front_w_y
	
	--move backwheel in forward direction
	back_w_x = sin(p.aim)*p.vel+back_w_x
 back_w_y = cos(p.aim)*p.vel+back_w_y
 
 pdx = front_w_x-back_w_x
 pdy = front_w_y-back_w_y

 p.aim = atan2(pdy,pdx)

 if(abs(p.aim-p.old[1])>0.3)then
  if(p.aim>p.old[1]) then
   p.aim-=1
  else
   p.old[1]-=1
  end
 end
 
 
 
 momentum = lerp(p.aim,p.old[1],p.grip)
	p.x = sin(momentum)*p.vel+p.x
	p.y = cos(momentum)*p.vel+p.y
	
	del(p.old,p.old[1])
	
	if abs(momentum-p.aim)>0.12 then
	 --drifting
	 score+=1
	 p.drifting = true
	 sfx(3)
	 
	 --spawn dust at rear
	 local op = (p.aim+0.5)%1 
	 op+=rnd(0.2)-0.1
	 local dx = sin(op)*8+p.x
	 local dy = cos(op)*8+p.y
	 dust_spawn(dx,dy,rnd(1))
	else
	 p.drifting = false
	end
	
	if check_collide(p) then
	 if probzdead then
	  dead = true
	  ui_time = time()
	 end
	 probzdead = true
	else
	 probzdead = false
	end
end

function check_collide(p)
 num_collide = 0
 for i=1,10 do
  local x = sin(i/10) * 10 + p.x
  local y = cos(i/10) * 10 + p.y
  if pget(x,y) == 0 or pget(x,y) == 1 then
   num_collide +=1
  end
 end
 if num_collide > 2 
 and p.drifting then
  intensity = 3
 end
 if num_collide > 7 then
  return true
 else
 	return false
 end
end

function lerp(a,b,i) return (1-i)*a+i*b end
-->8
--map

function sprite_map(sprite)
 --sprite 10
 for i=0,7 do
  for j=0,7 do
   local col = sget(i+sprite*8,j)
   local x = (i-5)*64
   local y = (j-1)*64
   if col==10 then --yellow
    hori(x,y)
   elseif col==12 then --blue
    vert(x,y)
   elseif col==8 then --red
    down_right(x,y)
   elseif col==13 then --purple
    up_right(x,y)
   elseif col==11 then --green
    down_left(x,y)
   elseif col==9 then --orange
    up_left(x,y)
   elseif col==7 then --white
    hori(x,y)
   elseif col==5 then --pink
    draw_start(x,y)
   elseif col==2 then --dark purple
    vert_close(x,y)
   elseif col==3 then --dark green
    vert_open(x,y)
   elseif col==1 then --dark blue
    vert_narrow(x,y)
   else
    --hori(x,y)
   end
  end
 end
end

function draw_start(x,y)
 sspr(96,32,32,32,x,y,64,64)
end

function vert(x,y)
 sspr(0,32,32,32,x,y,64,64)
end

function vert_close(x,y)
 sspr(0,64,32,32,x,y,64,64)
end

function vert_open(x,y)
 sspr(0,64,32,32,x,y,64,64,false,true)
end

function vert_narrow(x,y)
 sspr(32,64,32,32,x,y,64,64,false,true)
end

function hori(x,y)
 sspr(32,32,32,32,x,y,64,64)
end
	
function up_right(x,y)
 sspr(64,32,32,32,x,y,64,64)
end

function up_left(x,y)
sspr(64,32,32,32,x,y,64,64,true,false)
end

function down_right(x,y)
 sspr(64,32,32,32,x,y,64,64,false,true)
end

function down_left(x,y)
 sspr(64,32,32,32,x,y,64,64,true, true)
end


