--ui

function draw_ui()
 local x0 = p.x-59
 local y0 = p.y-70
 
 rectfill(x0,y0,x0+30,y0+8,13)
 rectfill(x0+103,y0,x0+127,y0+8,13)
 rectfill(x0+49, y0,x0+80,y0+8,0)
 if p.drifting and flash then
  rectfill(x0+50, y0+1,x0+79,y0+7,8)
 else
  rectfill(x0+50, y0+1,x0+79,y0+7,10)
 end

 print(score,x0+52,y0+2,0)
 print("PTS",x0+66,y0+2,0)
 
 print("lap "..(laps+1).."/3",x0+2,y0+2,7)
 
 local time_y = {}
 if cm.pb >= cm.h then
  time_y = {
   {"pb",cm.pb}
  }
 elseif cm.pb >= cm.g then
  time_y = {
   {"pb",cm.pb}
  }
 elseif cm.pb >= cm.s then
  time_y = {
   {"g",cm.g}
  } 
 elseif cm.pb >= cm.b then
  time_y = {
   {"s",cm.s}
  } 
 else
  time_y = {
   {"b",cm.b}
  }
 end

 local tc = 1
 for o in all(time_y) do
  local col = 11
  if o[1] == "g" then
   col = 10
  elseif o[1] == "s" then
   col = 6
  elseif o[1] == "b" then
   col = 9
  elseif o[1] == "’" then
   col = 12
  end
  print(o[1],x0+105,y0-4+6*tc,col)
	 print(o[2],x0+115,y0-4+6*tc,7)
  tc+=1
 end
end

function draw_drifting()
	if p.drifting then
	 rectfill(p.x-17,p.y+15,p.x+18,p.y+16+5,0)
	 if flash then
		 print("drifting!",p.x-16,p.y+16,8)
		 flash = not flash
		else
		 print("drifting!",p.x-16,p.y+16,10)
		 flash = not flash
  end
	end	
end

start_flash = time()
flash = true

function draw_map_menu()
 camera(0,0)
 cls(13)
 local x0 = 0--p.x-59
 local y0 = 0--p.y-70
 
 print("map select",x0+44,y0+10,7)
 print("Ž",x0+4,y0+120,7)
 print("   back",x0+4,y0+120,0)
 print("select  ",x0+88,y0+120,0)
 print("       —",x0+88,y0+120,7)
 
 for i=1,#maps do
  local y = 38 + y0
  local x = 10+(i-1)*30 + x0
  if i>4 then
   y = 76 + y0
   x = 10+(i-5)*30 + x0
  end
  
  sprite = maps[i].sp
  --print(i,x-2,y-8,7)
  if i == map_selection then
   rectfill(x-2,y-2,x+17,y+17,8)
  else
   rectfill(x-2,y-2,x+17,y+17,5) 
  end
  rectfill(x-1,y-1,x+16,y+16,0)
  sspr(sprite*8,0,8,8,x,y,16,16)
  local hiscore = dget(i)
  
  --gold
  if hiscore>=maps[i].h then
   print("’",x+4,y+20,10)
  elseif hiscore>=maps[i].g then
   print("g",x+6,y+20,10)
  elseif hiscore>=maps[i].s then
   print("s",x+6,y+20,6)
  elseif hiscore>=maps[i].b then
   print("b",x+6,y+20,9)
  end
 end
end

function update_map_menu()
 if btnp(”) and map_selection<5 then
  map_selection +=4
 elseif btnp(”) then
  map_selection -=4
 end
 
 if btnp(ƒ) and map_selection<5 then
  map_selection +=4
 elseif btnp(ƒ) then
  map_selection -=4
 end
 
 if btnp(‘) then 
  if map_selection == 4 or
  map_selection == 8 then
   map_selection -=3
  else
   map_selection +=1 
  end
 end
 
 if btnp(‹) then
  if map_selection == 1 or
  map_selection == 5 then
   map_selection +=3
  else
   map_selection -=1
  end
 end
 
 if btnp(—) 
 and time() - ui_time > 0.6 then
  start_map(map_selection)
 end
 
 if btnp(Ž) 
 and time() - ui_time > 0.6 then
  start_menu()
 end
end

