--dust particles

function dust_spawn(dx,dy,dangle)
 local d = {
  x = dx,
  y = dy,
  a = dangle,
  life = 10,
  speed =1
 }
 add(dust,d)
end

function update_dust()
 for d in all (dust) do
  d.life-=1
  local x = sin(d.a)*d.speed+d.x
  local y = cos(d.a)*d.speed+d.y
  
  --d.x = x
  --d.y = y
  if d.life == 0 then
   del(dust,d)
  end
 end
end

function draw_dust()
	for d in all (dust) do
 	pset(d.x,d.y,15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 	pset(d.x+r(),d.y+r(),15)
 end
end

function r()
 return rnd(4)-2
end

function shake()
 local shake_x=rnd(intensity) - (intensity /2)
 local shake_y=rnd(intensity) - (intensity /2)

 --offset the camera
 camera(p.x-59+shake_x,p.y-70+ shake_y)

 --ease shake and return to normal
 intensity *= .9
 if intensity < .3 then intensity = 0 end
end
