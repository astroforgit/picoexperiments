--laps

function update_laps()
 if check1 and not check2
 and get_check2_collide() then
  check2 = true
  check1 = false
 end
 if not check1 and check2
 and get_check1_collide() then
  laps+=1
  check1 = true
  check2 = false
 end
 -- end race
 if laps == 3 then
  if score > cm.pb then
   dset(map_selection,score)
   cm.pb = score
  end
  ui_time = time()
  endrace = true
  camera(0,0)
 end
end



--check start
function get_check1_collide()
 local sx = spawn.x
 local sy = spawn.y
 --rectfill(sx+24,sy-8,sx+40,sy+74,8)

 if(p.x>sx+20 and p.x<sx+40) then
  if(p.y >sy-8 and p.y<sy+74) then
   return true
  end
 end
 return false
end

--check mid
function get_check2_collide()
 local cx = cm.checkpoint.x
 local cy = cm.checkpoint.y
 if(p.x>cx+20 and p.x<cx+40) then
  if(p.y >cy-8 and p.y<cy+72) then
   return true
  end
 end
 return false
end
