--player draw

function draw_player()
 
 --print(momentum,p.x-8,p.y-16)
 --print(p.aim,p.x-8,p.y-24)
 local x0 = 0
 if vehicle == 1 then
  x0 = 8
 elseif vehicle == 2 then
  x0 = 32
 elseif vehicle == 3 then
  x0 = 56
 elseif vehicle == 4 then
  x0 = 80
 elseif vehicle == 5 then
  x0 = 104
 end
 local y0 = 104
 
 local r=flr(-p.aim*20)/20
 local s=sin(r)
 local c=cos(r)
 local b=s*s+c*c
 local size = p.size/2
 local w = sqrt(size^2*2)-2
 for y=-w,w do
   for x=-w,w do
     local ox=( s*y+c*x)/b+size+x0
     local oy=(-s*x+c*y)/b+size+y0
     local col=sget(ox,oy)
     if col == 14 then
      col = -1
     end
     if col>0 then 
       if col == 1 then
        col = 0
       end
       pset(p.x+x,p.y+y,col)
     end
   end 
 end
 --dline(p.x,p.y,momentum,8)
 --dline(p.x,p.y,p.aim,7)
 
 --pset(back_w_x,back_w_y,10)
 --pset(front_w_x,front_w_y,10)
end

function dline(x,y,angle,c)
 local x2 = sin(angle)*10+x
 local y2 = cos(angle)*10+y
 line(x,y,x2,y2,c)
end

