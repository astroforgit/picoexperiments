__lua__
--initialize

function _init()
 cartdata("drift_king_brink_edition_v_1")
 
 maps = {
  {sp=3,h=350,g=300,s=200,b=100},
  {sp=4,h=400,g=350,s=200,b=100},
  {sp=5,h=300,g=250,s=150,b=75},
  {sp=6,h=300,g=250,s=200,b=100},
  {sp=7,h=400,g=350,s=250,b=150},
  {sp=8,h=350,g=300,s=200,b=100},
  {sp=9,h=300,g=250,s=200,b=150},
  {sp=10,h=150,g=100,s=80,b=60},
 }
 menuitem(2,"main menu",start_menu)
 spawn = {}
 load_cart_data()
 laptime = time()
 
 --swap transparent to pink
 palt(0, false)
 palt(14, true)
 
 --game states
 start_menu()
 ui_time = time()
 
 --unlocks
 vehicle = dget(0)
 if vehicle == 0 then
  vehicle = 1
 end
 set_vehicle(vehicle)
 unlocks = 0
end

function start_menu()
 main_menu = true
 map_menu = false
 intro = false
 endrace = false
 unlock = false
 menu_select = 1
 ui_time = time()
end

function start_map_menu()
 main_menu = false
 map_menu = true
 intro = false
 endrace = false
 unlock = false
 ui_time = time()
 map_selection = 1
end

function start_intro()
 main_menu = false
 map_menu = false
 intro = true
 endrace = false
 unlock = false
 ui_time = time()
end

function start_unlock()
 main_menu = false
 map_menu = false
 intro = false
 endrace = false
 unlock = true
 ui_time = time()
 unlock_select = 1
 
 local h_count = 0
 for i=1,8 do
  if dget(i) > maps[i].h then
   h_count += 1
  end
 end
 
 if h_count > 5 then
  unlocks = 4
 elseif h_count > 3 then
  unlocks = 3
 elseif h_count > 1 then
  unlocks = 2
 elseif h_count > 0 then
  unlocks = 1
 end
end

function swap_colours()
 --alt colours
 for i=0,15 do
  pal(i,i+128,1)
 end
end

function start_map(mapnum)
 menuitem(1,"restart",start_map)
 endrace = false
 map_menu = false
 make_endrace()
 if mapnum == nil then
  mapnum = map_selection
 end
 score = 0
 make_player()
 laps = 0
 load_map(maps[mapnum])
 check1 = true
 check2 = false
 drift_time = 0
 music(0)
 probzdead = false
 dead = false
 anim = time()
 totaltime= time()
 dust = {}
 flash = true
 ui_time = time()
 intensity = 0
end

function load_map(map_obj)
 cm = map_obj
 spawn = get_start(cm.sp)
 p.x = spawn.x+48
 p.y = spawn.y+32
 cm.checkpoint = get_checkpoint(cm.sp)
end

function load_cart_data()
 for i=1,8 do
  maps[i].pb= dget(i)
 end
end

function get_start(sprite)
 for i=0,7 do
  for j=0,7 do
   local xoff = sprite%16*8
   local yoff = flr(sprite/16)*8
   local col = sget(i+xoff,j+yoff)
   local x = (i-5)*64
   local y = (j-1)*64
   if col == 5 then
    point = {
     x = x,
     y = y
    }
   	return point
   end
  end
 end
end

function get_checkpoint(sprite)
 for i=0,7 do
  for j=0,7 do
   local xoff = sprite%16*8
   local yoff = flr(sprite/16)*8
   local col = sget(i+xoff,j+yoff)
   local x = (i-5)*64
   local y = (j-1)*64
   if col == 7 then
    local checkpoint = {
			  x = x,
			  y = y
			 }
   	return checkpoint
   end
  end
 end
end

-->8
--update and draw

function _update() 
 if not map_menu 
 and not intro 
 and not endrace
 and not main_menu
 and not unlock then
	 if not dead then
	  update_player()
	  update_laps()
	 else 
	  music(-1)
	  --falling
	  if time()-anim > 0.1 then
	   anim = time()
	   p.size*=0.8
	  end
	 end
	 update_dust()
	 if intensity > 0 then 
		 shake() 
	 else
	 	camera(p.x-59,p.y-70)
	 end
 	if dead and time()-ui_time > 0.6 then
  	endrace=true
  	ui_time = time()
 	end
 elseif intro then
  update_intro()
 elseif main_menu then
	 update_main_menu()
 elseif endrace then
  update_endrace()
 elseif unlock then
  update_unlock_menu()
 else
  update_map_menu()
	end
end


function _draw()
 if not map_menu 
 and not intro
 and not endrace
 and not main_menu
 and not unlock then
	 cls(0)
	 rectfill(-512,-512,512,512,0)
	 sprite_map(cm.sp)
		draw_player()
		draw_dust()
		draw_ui()
		draw_drifting()
	elseif intro then
	 draw_intro()
	elseif main_menu then
	 draw_main_menu()
	elseif unlock then
	 draw_unlock_menu()
	elseif endrace then
	 cls(0)
	 rectfill(-512,-512,512,512,0)
	 sprite_map(cm.sp)
		draw_player()
	 draw_endrace()
	else
	 draw_map_menu()
	end
end
