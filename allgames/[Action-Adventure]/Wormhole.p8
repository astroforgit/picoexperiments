-- lift()

function lift(x,y,k)
	
	k=max(k,1)
	
	-- main body
	spr(128-min(k,9),x,y)
	
	-- arm
	local hc=0
	while hc<(k-4)/4-1 do
		
		spr(127-min(k-hc*4,15),x,y-(hc+1)*8)
		
		hc+=1
	end
	
end
-->8
-- collides()

function collides(obj,aim,flg)

	-- shoutout to nerdyteachers
	-- for making one of the few
	-- pico-8 tutorials out here
	--            ‡
	
	local x=obj.x
	local y=obj.y
	local w=obj.w
	local h=obj.h
	
	local x1=0 local x2=0
	local y1=0 local y2=0
	
	
	if     aim=="left" then
		x1=x-1     y1=y
		x2=x       y2=y+h-1
	
	elseif aim=="right" then
		x1=x+w-1   y1=y
		x2=x+w     y2=y+h-1
	
	elseif aim=="up" then
		x1=x+2     y1=y-1
		x2=x+w-3   y2=y
	
	elseif aim=="down" then
		x1=x+2     y1=y+h
		x2=x+w-3   y2=y+h
		
	end
	
	x1/=8 x2/=8 y1/=8 y2/=8
	
	return fget(mget(x1,y1),flg)
	or fget(mget(x1,y2),flg)
	or fget(mget(x2,y1),flg)
	or fget(mget(x2,y2),flg)
	
end
