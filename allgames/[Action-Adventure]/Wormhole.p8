-- titlescreen()

function titlescreen()
	cls()
	
	print("w",46,60,7)
	print("rmh",56,60,7)
	print("le",74,60,7)
	spr(251,50,59)
	spr(252,68,59)
	
	print("press — to begin",30,72,6)
	
	if btn(—) then
	started=true end
	
end
