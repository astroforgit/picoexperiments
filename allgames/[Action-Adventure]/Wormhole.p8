-- wormholecalcs()

function wormholecalcs()
	
	if  dist(p.x,p.y,
	(wb.x*8),(wb.y*8)) >= 7
	and dist(p.x,p.y,
	(wo.x*8),(wo.y*8)) >= 7
	then gonew=true end
	
	if gonew and not p.looking
	and dist(p.x,p.y,
	(wb.x*8),(wb.y*8)) < 5
	and shotb and shoto then
		p.x=(p.x-wb.x*8)+wo.x*8
		p.y=(p.y-wb.y*8)+wo.y*8
		g.x=p.x  g.y=p.y
		p.midair=true
		gonew=false
		
		sfx(1)
		
		local dx
		local dy
		
		-- in
		if shotb then
			if wb.d == 0 then
				dx=-p.dx  dy=-p.dy
				
			elseif wb.d == 1 then
			 dx=-p.dy  dy=p.dx
			 
			elseif wb.d == 2 then
				dx=p.dx   dy=p.dy
				
			else
			 dx=p.dy   dy=-p.dx
			end
			
			-- out
			if wo.d == 0 then
				p.dx=dx  p.dy=dy
				
			elseif wo.d == 1 then
			 p.dx=-dy  p.dy=dx
			 
			elseif wo.d == 2 then
				p.dx=-dx  p.dy=-dy
				
			else
			 p.dx=dy  p.dy=-dx
			end
		end
		
	end
		
	if gonew and not p.looking
	and dist(p.x,p.y,
	(wo.x*8),(wo.y*8)) < 5
	and shotb and shoto then
		p.x=(p.x-wo.x*8)+wb.x*8
		p.y=(p.y-wo.y*8)+wb.y*8
		g.x=p.x  g.y=p.y
		p.midair=true
		gonew=false
		
		sfx(1)
		
		local dx
		local dy
		
		-- in
		if shoto then
			if wo.d == 0 then
				dx=-p.dx  dy=-p.dy
				
			elseif wo.d == 1 then
			 dx=-p.dy  dy=p.dx
			 
			elseif wo.d == 2 then
				dx=p.dx   dy=p.dy
				
			else
			 dx=p.dy   dy=-p.dx
			end
			
			-- out
			if wb.d == 0 then
				p.dx=dx  p.dy=dy
				
			elseif wb.d == 1 then
			 p.dx=-dy  p.dy=dx
			 
			elseif wb.d == 2 then
				p.dx=-dx  p.dy=-dy
				
			else
			 p.dx=dy  p.dy=-dx
			end
		end
		
	end
	
	
end
