-- update() & physics()

function _update()
	if started then
		physics()
	end
	
	local mg=mget(p.x/8,p.y/8)
	if fget(mg,7) and not (
	fget(mg,0) or fget(mg,1) or
	fget(mg,2) or fget(mg,3) or
	fget(mg,4) or fget(mg,5) or
	fget(mg,6))
	then
	 hasgun=true
		mset(p.x/8,p.y/8,248)
		music(2)
		tutworm=true
	end
	
	local a=false
	
	if not elevating then
		if p.x>cam.tx+126 then
			cam.tx+=128
			a=true
		elseif p.x<cam.tx-2 then
		 cam.tx-=128
			a=true
		end
		
		if p.y>cam.ty+126 then
			cam.ty+=128
			p.dy*=0.6
			a=true
		elseif p.y<cam.ty-2 then
			cam.ty-=128
			p.dy-=2
			a=true
		end
	end
	
	if a then
	 shoto=false
	 shotb=false
	end
end



function physics()
 if elevating then
  p.flp=false
  p.x=lerp(p.x,84*8,0.4)
  p.y=13*8-(elevator+delev)*2
  p.midair=false
  p.falling=false
  p.looking=false
  p.running=false
  elevator+=delev
  delev=min(delev+0.01,1)
  if elevator > 100 then
   init()
   mset(3,8,134)
   mset(4,8,135)
   mset(3,9,150)
   mset(4,9,151)
   mset(76,29,134)
   mset(77,29,135)
   mset(76,30,150)
   mset(77,30,151)
   mset(6,30,247)
   mset(89,30,191)
   mset(80,29,70)
		 mset(80,30,70)
  end
 else
	 playercalcs()
	end
end



function playercalcs()
 
 px=p.x+4
 py=p.y+4
 
 if not p.sleeping then
 	
 	if not p.looking then
 	
	 	if not btn(”) then
	 		jumphold=false
	 	end
	 	
			fric=0.8
			
			-- go
			p.running=false
			if btn(‹) then
				p.dx-=p.acc
				p.running=true
			 if not btn(‘) then p.flp=true end
			end
			if btn(‘) then
				p.dx+=p.acc
				p.running = not btn(‹)
				if btn(‹) then
				 fric=0.5
				else
					p.flp=false
				end
			end
			
			-- jamp
			if btnp(”) and
			not p.midair and
			not jumphold and
			p.dy == 0 then
				jumphold=true
				p.dy-=p.jumpboost
				p.midair=true
				sfx(0)
			end
			
			if btnp(Ž) 
			and not p.looking
			and not p.midair
			and not shooting
			and hasgun
			then p.looking = true
			 p.direc=0
			end
		
		
		
		if fget(mget((p.x+4)/8,(p.y+4)/8),3)
		then
		 if not p.inemance then
		  if shoto or shotb then
		   sfx(4)
		  end
		  shoto=false
		  shotb=false
		  sfx(3)
		  p.inemance=true
		 end
		else
		 p.inemance=false
		end
		
		-- gun aiming stuff
		else
		 p.aims*=0.8
			if btn(‹) then
			 p.aims*=1.2
				p.aims -= 0.001
			end
			if btn(‘) then
			 p.aims*=1.2
				p.aims += 0.001
			end
			if btn(‘) and btn(‹) then
			 p.aims *= 0.4
			end
			if btnp(—) then
				shooting=true
				p.looking=false
				oraorblu=false
				p.aims=0
				sfx(2)
			end
			if btnp(Ž) then
				shooting=true
				p.looking=false
				oraorblu=true
				p.aims=0
				sfx(2)
			end
			p.direc+=p.aims
			
			if abs(p.direc)>0.5 then
				p.direc*=-0.99
			end
		end
		
		if p.x >= 87*8
		and not cake then
		 cake=true
		 p.dx=-10
		 p.dy=-4
		 mset(89,30,190)
		 mset(80,29,84)
		 mset(80,30,85)
		 music(23)
		end
		if cake and cakec < 128 then
		 cakec+=0.5
		end
		
		if hasgun then
		 wormholecalcs()
		end
		
		if not midair then
		 p.dx*=fric
		end
		p.dy+=grav
		
		if p.dy>p.mdy then p.dy*=0.95 end
		if p.dy<-p.mdy then p.dy*=0.95 end
		if p.dx>p.mdx then p.dx*=0.95 end
		if p.dx<-p.mdx then p.dx*=0.95 end
		
		
		
		if p.dy>0 then
			p.falling=true
			p.midair=true
			
			if collides(p,"down",0) then
				p.midair=false
				p.falling=false
				p.dy=0
				p.y-=((p.y+p.h+1)%8)-1
			end
			
		elseif p.dy<0 then
			p.falling=false
			p.midair=true
			
			if collides(p,"up",1) then
				p.midair=true
				p.falling=true
				p.dy=0
			end
		end
		
		if p.dx<0
		and collides(p,"left",1) then
			p.dx=0
		elseif p.dx>0
		and collides(p,"right",1) then
			p.dx=0
		end
		
		
		p.x+=p.dx
		p.y+=p.dy
		
		if cake then
	 	if dist(84*8,13*8,p.x,p.y) < 3 then
	   elevating=true
	  end
		end
	end
end
