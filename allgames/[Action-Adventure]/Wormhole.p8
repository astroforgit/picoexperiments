-- shooting

function shoot()
 
 
 if shooting then
  tutworm=false
  
  if k<=256 then
   
   kx=spx-k*sin(p.direc)
   ky=spy-k*cos(p.direc)
   
   if oraorblu
   then spr(39,kx,ky)
   else spr(7,kx,ky)
   end
   k+=1.5
   
   local mg=mget((kx+4)/8,(ky+4)/8)
   
   if fget(mg,3) then
    shooting=false
    k=4
    sfx(4)
   elseif fget(mg,1) then
    shooting=false
    if fget(mg,2) then
     --kx=spx-(k-6)*sin(p.direc)
     --ky=spy-(k-6)*cos(p.direc)
     
     --mg=mget((kx)/8,(ky)/8)
     --local mh=mget((kx)/8,(ky+8)/8)
     
     --dir=3
     --if fget(mg,7)
     --or fget(mh,7) then
     -- dir-=1 end
     --if fget(mg,6)
     --or fget(mh,6) then
     -- dir-=2 end
          
     --w={
     --	x=flr((kx+4)/8),
     --	y=flr((ky+4)/8),
     --	d=dir,
     --}
     
     --if  not (wb.x==w.x
     --    and wb.y==w.y)
     --and not (wb.x==w.x
     --    and wb.y==w.y)
     --then
     -- if oraorblu then
     --  wb=w
     --  shotb=true
     -- else
     --  wo=w
     --  shoto=true
     -- end
     -- shooting=false
     
     local dir=3
     local wx=flr((kx+4)/8)
     local wy=flr((ky+4)/8)
     
     if fget(mg,7) then
      dir-=1
     end
     if fget(mg,6) then
      dir-=2
     end
     
     local yes=false
     
     if dir==3 then
      wx-=1
      yes=sin(p.direc)<0
     elseif dir==2 then
      wy+=1
      yes=cos(p.direc)>0
     elseif dir==1 then
      wx+=1
      yes=sin(p.direc)>0
     else
      wy-=1
      yes=cos(p.direc)<0
     end
      
     w={
      x=wx,
      y=wy,
      d=dir,
     }
     
     if  not (wb.x==w.x
         and wb.y==w.y
         and shotb)
     and not (wo.x==w.x
         and wo.y==w.y
         and shoto)
     and yes then
      sfx(3)
      if oraorblu then
       wb=w
       shotb=true
      else
       wo=w
       shoto=true
      end
     end
     
     shooting=false
    end
    k=4
   end
  else
   shooting=false
  end
  
 else
  k=5
  spx=p.x
  spy=p.y
 end
 
end
