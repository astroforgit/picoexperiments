-- draw()

function _draw()
	cls()
	
	cam.x=lerp(cam.x,cam.tx,0.4)
	cam.y=lerp(cam.y,cam.ty,0.4)
	if abs(cam.x-cam.tx) <= 0.5 then
		cam.x=cam.tx
	end
	if abs(cam.y-cam.ty) <= 0.5 then
		cam.y=cam.ty
	end
	
	camera(cam.x,cam.y)
	
	map(0,0)
	
	if started then
	
	
		-- animation timers
		p.animi+=0.125
		if p.animi>=4 then p.animi-=4 end
		p.animj+=0.25
		if p.animj>=4 then p.animj-=4 end
		p.animw+=0.5
		if p.animw>=4 then p.animw-=4 end
		
		if p.sleeping then
			if p.anims < 2 then
				p.anims+=0.025
			else
				p.anims+=0.125
			end
			if p.anims>=4 or btn(”) then
				p.sleeping=false
				p.anims=0
			end
		end
		
		if p.looking then
	  p.flp=(p.direc<0)
	 end
	 
	 lift(728,240,min(cakec-32,16))
 	lift(744,232,min(cakec-48,24))
 	lift(81*8,26*8,min(cakec-56,8))
 	lift(92*8,23*8,min(cakec-56,16))
 	lift(84*8,14*8,elevator+8)
	 
	 -- draw wormholes
	 if shotb then
	 spr(8+2*wb.d+r16(p.animj),wb.x*8,wb.y*8)
	 end if shoto then
	 spr(9+2*wo.d+r16(p.animj),wo.x*8,wo.y*8)
	 end
	 
	 -- animl
	 if abs(p.direc) >= 0.375 then
   p.animl=0
  elseif abs(p.direc) >= 0.25 then
   p.animl=1
  elseif abs(p.direc) >= 0.125 then
   p.animl=2
   else
   p.animl=3
  end
	 
		-- draw player
		if p.midair then
		 if p.falling then
			 spr(3+r16(p.animj),p.x,p.y,1,1,p.flp)
			else
			 spr(2+r16(p.animj),p.x,p.y,1,1,p.flp)
			end
		else
		 if p.looking then
		  spr(4+r16(p.animl),p.x,p.y,1,1,p.flp)
		 elseif p.sleeping then
		  spr(5+r16(p.anims),p.x,p.y,1,1,p.flp)
		 else
			 if p.running then
			  spr(1+r16(p.animw),p.x,p.y,1,1,p.flp)
			 else
			  spr(0+r16(p.animi),p.x,p.y,1,1,p.flp)
		  end
		 end
		end
		
		if hasgun then
			if looking then
				
			else
			 local yd=0
			 local xd=5
			 if p.animi>=2 then yd=2 end
			 if p.flp then xd=-5 end
			 g.x=lerp(g.x,p.x+xd,0.5)
			 g.y=lerp(g.y,p.y+yd,0.7)
			 spr(22,g.x,g.y,1,1,p.flp)
			end
		end
	 
	 if tutworm then
	  if not p.looking then
	   print("Ž to shoot",p.x-16,p.y-8,6)
	  else
	   spr(253,p.x-30,p.y-18)
	   spr(254,p.x-6,p.y-18)
	   spr(250,p.x-14,p.y-24)
	  	print("   to aim",
	  	 p.x-14,p.y-24,6)
	  	print("or    to shoot",
	  	 p.x-18,p.y-18,6)
	  end
	 end
	 
	 if p.looking then
	 	line(
	 	 px-6*sin(p.direc),
	 	 py-6*cos(p.direc),
	 	 px-16*sin(p.direc),
	 	 py-16*cos(p.direc),
	 	8)
	 	
	 end
	
 shoot()
 
 --print(test,p.x,p.y-10)
	
	else
		titlescreen()
	end
	
end

