function drfr(x,y,f)
local i=1
local c=0
for is=1,#f do
i=1
for iy=f[is][2],f[is][4] do
for ix=f[is][1],f[is][3] do
c=tonum("0x0"..sub(f[is][5],i,i))
if(c!=14)pset(x+ix,y+iy,c)
i+=1
end
end
end
end
function drfr_f(x,y,f)
local i=1
local c=0
for is=1,#f do
i=1
for iy=f[is][2],f[is][4] do
for ix=f[is][3],f[is][1],-1 do
c=tonum("0x0"..sub(f[is][5],i,i))
if(c!=14)pset(x+ix,y+iy,c)
i+=1
end
end
end
end
function draw_pic(x,y,p)
local i=1
local c=0
local s=0
for iy=0,32 do
for ix=0,23 do
if s <= 0 then
c=tonum("0x0"..sub(p,i,i))
i+=1
s=tonum("0x0"..sub(p,i,i))
i+=1
end
if (c!=14) pset(x+ix,y+iy,c)
s-=1
end
end
end
function draw_girl()
if on_g then
if hp<=0 then
if pfli then
drfr_f(flr(px)-2,flr(py+.1),pgko)
else
drfr(flr(px)-2,flr(py+.1),pgko)
end
elseif crou or hu>0 then
if (abs(pdx) < .9) then
if pfli then
drfr_f(flr(px)-2,flr(py+.1),pgc)
else
drfr(flr(px)-2,flr(py+.1),pgc)
end
else
if pfli then
drfr_f(flr(px)-2,flr(py+.1),pgc)
drfr_f(flr(px)-2,flr(py+.1),pgcr["c"..tostr(pf)])
else
drfr(flr(px)-2,flr(py+.1),pgc)
drfr(flr(px)-2,flr(py+.1),pgcr["c"..tostr(pf)])
end
end
else
if pfli then 
drfr_f(flr(px)-2,flr(py+.1),pgb)
if (ey) drfr_f(flr(px)-2,flr(py+.1),pgeu)
if (not ey) drfr_f(flr(px)-2,flr(py+.1),pge)
drfr_f(flr(px)-2,flr(py+.1),pgw["w"..tostr(pf)])
else
drfr(flr(px+.1)-2,flr(py+.1),pgb)
if (ey) drfr(flr(px)-2,flr(py+.1),pgeu)
if (not ey) drfr(flr(px+.1)-2,flr(py+.1),pge)
drfr(flr(px+.1)-2,flr(py+.1),pgw["w"..tostr(pf)])
end
end
elseif hgg then
if shg then
if pfli then 
drfr_f(flr(px)-2,flr(py+.1),pgh)
else
drfr(flr(px+.1)-2,flr(py+.1),pgh)
end
else
drfr(flr(px+.1)-2,flr(py+.1),pghb)
end
else
if pdy<0 then
if pfli then 
drfr_f(flr(px)-2,flr(py+.1),pgb)
if (pf!=0) drfr_f(flr(px)-2,flr(py+.1),pge)
if (pf==0) drfr_f(flr(px)-2,flr(py+.1),pgeu)
drfr_f(flr(px)-2,flr(py+.1),pgj["j"..tostr(pf)])
else
drfr(flr(px+.1)-2,flr(py+.1),pgb)
if (pf!=0) drfr(flr(px+.1)-2,flr(py+.1),pge)
if (pf==0) drfr(flr(px+.1)-2,flr(py+.1),pgeu)
drfr(flr(px+.1)-2,flr(py+.1),pgj["j"..tostr(pf)])
end
else
if pfli then 
drfr_f(flr(px)-2,flr(py+.1),pgf)
else
drfr(flr(px+.1)-2,flr(py+.1),pgf)
end
end
end
end
