{girl,n,"xemi","i'm a courier, not","a carpenter."},
{witch,n,"yuku","no problem. i lost","4 artifacts", "down there."},
{gls,n,"lin","please find them","while i'm fetching","enough rope."},
{0},
{2},
{witch,n,"yuku","need something?"},
{girl,n,"xemi","this is your \"basement\"?"},
{witch,n,"yuku","basement,gaping caverns,","same diff."},
{girl,n,"xemi","so, how do i get","anywhere?"},
{witch,n,"yuku","there should be","plenty of ledges.","find the paths."},
{girl,n,"xemi","ugh whatever.","there's a plant","here that glows."},
{witch,n,"yuku","blue berries?","that's magic. it'll","heal your wounds."},
{witch,n,"yuku","also, it'll help","with our magic","too."},
{girl,n,"xemi","am i going to","need your magic?"},
{witch,n,"yuku","maybe? eat some","and we'll see."},
{0},
{2},
{gls,n,"lin","hey, think you","could order us","some pizza?"},
{girl,n,"xemi","...why?"},
{gls,n,"lin","they keep track","of customers by","phone number."},
{gls,n,"lin","i get sweet deals","that way."},
{girl,n,"xemi","won't they notice","a different voice?"},
{gls,n,"lin","oh yeah."},
{gls,n,"lin","okay, instead just","patch me through","on 3-way."},
{gls,n,"lin","after 5 minutes","or so hang up."},
{girl,n,"xemi","sure. whatever."},
{0},
{witch,n,"yuku","what's this?"},
{gls,n,"lin","emergency app.","it tells when","someone's ko'd."},
{witch,n,"yuku","oh, the courier?","what're you","going to do?"},
{gls,n,"lin","straight regen isn't","good without food","to go with it."},
{gls,n,"lin","i'll rewind her","to avoid side","effects."},
{0},
{2},
{witch,n,"yuku","what's up?"},
{girl,n,"xemi","please tell me","this statue isn't","an artifact."},
{witch,n,"yuku","no. definitely not.","some guy gave me","that as a gift."},
{witch,n,"yuku","it's a good","example of why","i rejected him."},
{girl,girl_smile,"xemi","ugh. that's sucks.","why not just","dismantle it?"},
{witch,witch_frown,"yuku","well..i mean...","it's still a","hand-made gift."},
{0},
{2},
{witch,n,"yuku","yo."},
{girl,n,"xemi","i...uh...","broke your sword."},
{witch,n,"yuku","honest. but","the blade isn't","important."},
{girl,n,"xemi","how did you...?"},
{witch,n,"yuku","magic artifacts are","hard to break."},
{witch,n,"yuku","the eternal stone","blade is often","confused for broken."},
{witch,n,"yuku","the handle forms","the blade on","activation."},
{girl,n,"xemi","good for a","thousand battles","or some such?"},
{witch,n,"yuku","sure? but lin","just doesn't like","washing knives."},
{0},
{2},
{witch,n,"yuku","yep?"},
{girl,n,"xemi","is this fancy","shield one of","the artifacts?"},
{witch,n,"yuku","that's a pot lid."},
{girl,n,"xemi","i don't believe","you."},
{witch,n,"yuku","you should see","pot then."},
{witch,n,"yuku","anyway, leave the lid."},
{0},
{2},
{witch,n,"yuku","listening."},
{girl,n,"xemi","i've found some","weird yellow gem."},
{witch,n,"yuku","can you send a pic?"},
{witch,n,"yuku","huh...that's not","supposed to be","there."},
{witch,n,"yuku","it's a sap gem.","there's a strong","magic tree nearby."},
{girl,n,"xemi","should i care?"},
{witch,n,"yuku","possibly. if the","tree took an","artefact."},
{witch,n,"yuku","if you can,","try looking up","from there."},
{0},
{2},
{witch,n,"yuku","î×î×?"},
{girl,n,"xemi","ah? wrong number?","uh...lo sento.","no 'ablo espaniol"},
{witch,n,"yuku","huh? no no,","it's me."},
{girl,n,"xemi","oh, good.","that's a relief."},
{girl,n,"xemi","i didn't know","you spoke spanish."},
{girl,n,"xemi","your accent was","really good too."},
{girl,n,"xemi","just like the","family down the","street."},
{witch,witch_frown,"yuku","..."},
{witch,witch_frown,"yuku","what did you","need?"},
{girl,n,"xemi","hammer?"},
{witch,witch_frown,"yuku","not mine.","don't care."},
{0},
{2},
{witch,n,"yuku","greetings."},
{girl,n,"xemi","is this umbrella","one of the","artifacts?"},
{witch,n,"yuku","it is. there's","magic infused","in it."},
{girl,n,"xemi","oh, so it","doesn't break in","strong winds?"},
{witch,n,"yuku","that's...","uh..."},
{witch,n,"yuku","as a tip, i'll","order you a","proper umbrella."},
{0},
{2},
{witch,n,"yuku","lin?"},
{girl,n,"xemi","no, still me."},
{girl,n,"xemi","does this broom","fly?"},
{witch,n,"yuku","no.","it's a broom."},
{girl,n,"xemi","what's it for?"},
{witch,n,"yuku","cleaning."},
{0},
{2},
{witch,n,"yuku","mornin."},
{girl,n,"xemi","it's 3:23 pm."},
{witch,n,"yuku","eh."},
{girl,n,"xemi","i found the","bean bag chair."},
{girl,n,"xemi","it's...uh..."},
{witch,witch_frown,"yuku","shut it."},
{0},
{2},
{witch,n,"yuku","vianna residence."},
{girl,n,"xemi","oh, is that","your last name?"},
{witch,n,"yuku","nope."},
{girl,n,"xemi","huh. whatever.","does the crystal","ball work?"},
{witch,n,"yuku","sure, if you","want it to give","you a horoscope."},
{girl,n,"xemi","does astrology","help find things?"},
{witch,n,"yuku","astrology?","that stuff's","all fake."},
{0},
{2},
{witch,n,"yuku","hmm?"},
{girl,n,"xemi","chainmail?"},
{witch,n,"yuku","yep. be careful.","the rings are","somehow sharp."},
{girl,n,"xemi","why?"},
{witch,n,"yuku","no idea. it","works as a cheese","grater though."},
{0},
{2},
{witch,n,"yuku","gong!"},
{girl,n,"xemi","what?"},
{witch,n,"yuku","nothing. what","do you need?"},
{girl,n,"xemi","i found a","white staff."},
{witch,n,"yuku","that's a","poster. don't","look at it."},
{girl,n,"xemi","i...just did.","ugh."},
{0},
{2},
{girl,n,"xemi","hello?"},
{witch,n,"yuku","just noticed.","you're near","the mid-lake."},
{girl,n,"xemi","you're tracking","me? some help","maybe?"},
{witch,n,"yuku","no point. there's","an artifact in","every area."},
{witch,n,"yuku","anyway. that","area is optional."},
{witch,n,"yuku","if it's too","hard, you can","skip it."},
{0},
{witch,n,"yuku","oh, right.","that's the","last artifact."},
{witch,n,"yuku","i'll go help","lin with that","ladder."},
{0},
{0},
{2},
{gls,n,"lin","hey"},
{girl,n,"xemi","what now?"},
{gls,n,"lin","the ladder's down."},
{gls,n,"lin","feel free to","come back up","when ready."},
{girl,n,"xemi","will do."},
{0},
{gls,n,"lin","hmm...the","courier's getting","ko'd a lot."},
{witch,n,"yuku","shouldn't we","clean up the","basement then?"},
{witch,n,"yuku","we also could","give her more","help, too."},
{gls,n,"lin","nah. she can","rise to","the challenge."},
{0},
{witch,n,"yuku","yay! it's","mr. hug-bug!"},
{gls,n,"lin","welcome back.","how many slices?"},
{girl,n,"xemi","huh?"},
{gls,n,"lin","the pizza? i","told you earlier."},
{girl,n,"xemi","i don't accept","payment in","pizza."},
{gls,n,"lin","it's not payment.","you're a guest."},
{gls,n,"lin","i'll pay you","once i get an","invoice."},
{gls,n,"lin","twice your usual","is fine."},
{girl,n,"xemi","sweet.","i'll take a","full cheese."},
{0},
{gls,n,"lin","you're back.","the artifacts?"},
{girl,n,"xemi","i got what i","could."},
{gls,n,"lin","i guess that's","reasonable.","have some pizza."},
{0},
{gls,n,"lin","huh? no artifacts?"},
{girl,n,"xemi","why would i","fetch anything?"},
{girl,n,"xemi","i never","accepted any job."},
{gls,n,"lin","i guess not."},
{gls,n,"lin","regardless,","you're a guest.","have some pizza."},
{0}
}
labels={n,25,54,62,73,81,91,104,112,120,128,137,144,152}
function final_scene()
if (hu>0 or fl[48]) return
fl[48]=true
if fl[4] and fl[8] and fl[10] and fl[12] and fl[13] then
rscr(176)
elseif fl[4] and fl[8] and fl[12] and fl[13] then
rscr(177)
elseif not fl[4] and not fl[8] and not fl[12] and not fl[13] then
rscr(190)
else
rscr(186)
end
uf=game_end
end
function game_end()
gph=2
uf=n
end
end
