function scam()
if (px-cx<56) cx=px-56
if (px-cx>72) cx=px-72
if py-cy<cmin then
if cmin-py+cy<3 or cpt<0 then
cy=py-cmin
else
cy-=3
end
end
if py-cy>cmax then 
if pdy>1 or cpt<0 or py-cy-cmax<3 then
cy=py-cmax
else
cy+=3
end
end
if(cx<0)cx=0
if(cy<0)cy=0
if mv then
if(cx>48*8)cx=48*8
if(cy>48*8)cy=48*8
else
if(cx>112*8)cx=112*8
if(cy>16*8)cy=16*8
end
end
function inw(x,y)
if crou then
return (ws[(y+15.9)\8][x\8] or
ws[(y+9)\8][x\8] or
ws[(y+9)\8][(x+4)\8] or
ws[(y+15.9)\8][(x+4)\8])
end
return (ws[(y+1)\8][x\8] or
ws[(y+15.9)\8][x\8] or
ws[(y+8)\8][x\8] or
ws[(y+8)\8][(x+4)\8] or
ws[(y+1)\8][(x+4)\8] or
ws[(y+15.9)\8][(x+4)\8])
end
function inpl(x,y)
return ((pls[(y+16)\8][x\8] or
pls[(y+16)\8][(x+4)\8]) and
not pls[(y+15.9)\8][x\8] and
not pls[(y+15.9)\8][(x+4)\8])
end
