else
map(0,0,0,0,128,32,185)
end
for i=1,#wa do
spr(wa[i][4],wa[i][1],wa[i][2])
if wa[i][3] then
if(in_w and rip>0 and (abs(px+2-wa[i][1])<32 and abs(py+8-wa[i][2])<16))then
if(wa[i][6]<=0) wa[i][7]=abs(px+2-wa[i][1])-4 wa[i][6]=rip+wa[i][7]
end
if(wa[i][7]>0)wa[i][7]-=1
if wa[i][6]>0 and wa[i][7]<=0 then
wa[i][6]-=1
