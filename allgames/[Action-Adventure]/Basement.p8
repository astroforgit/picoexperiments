if(in_w and wa[i][1]<=px+2)wa[i][5]=f
if wa[i][5] then
line(wa[i][1]+w_t\2,wa[i][2],wa[i][1]+min(w_t\2+4,7),wa[i][2],1-tbc)
if(w_t\2>3)line(wa[i][1],wa[i][2],wa[i][1]+max(0,w_t\2-4),wa[i][2],1-tbc)
else
line(wa[i][1]+7-w_t\2,wa[i][2],wa[i][1]+min(7-w_t\2+4,7),wa[i][2],1-tbc)
if(w_t\2<4)line(wa[i][1],wa[i][2],wa[i][1]+max(3-w_t\2,0),wa[i][2],1-tbc)
end
else
line(wa[i][1],wa[i][2],wa[i][1]+7,wa[i][2],1-tbc)
end
end
end
