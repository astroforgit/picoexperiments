  isgrow=true
  --holefrm=0
  holeclr=0
 end 
 if scenes[scn].typ=='growlake' then
  ishole=true
  isgrow=true
  --holefrm=0
  holeclr=12
 end
 if scenes[scn].typ=='ladder' then
  isladder=true
 end
 if scenes[scn].typ=='pits' then
  isladder=true
  ispits=true
 end
 if scenes[scn].typ=='crocs' then
  ishole=true
  holefrm=5
  holeclr=12
  iscrocs=true    
 end
  
 numlog=abs(scenes[scn].logs)
 logx={{110},{100,116},{20,100,124}}
   
 islwall=scenes[scn].lw
 isrwall=scenes[scn].rw
 
 issnake=scenes[scn].snake
 isfire=scenes[scn].fire
 
 isring=scenes[scn].ring
 isgold=scenes[scn].gold
 issilver=scenes[scn].silver
 ismoney=scenes[scn].money
 
 isscorp=false
 if not islwall and not isrwall then
  isscorp=true
 end

end
