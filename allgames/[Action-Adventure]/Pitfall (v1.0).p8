--update

function updatelogs()
 if scenes[scn].logs<0 then
	 if(t%logtmr==0)logfrm=37+(38-logfrm)
	 for i=1,#logx[numlog] do  
	  logx[numlog][i]-=1
	  if(logx[numlog][i]<-8) then
	   logx[numlog][i]=127
	  end
	 end
	end
end

function updatehole()
 
 if isgrow==true then
  if holetimer!=0 then
   holetimer-=1
  end
  if holetimer==0 then
   if(t%3==0)holefrm+=holedir
   if(holefrm>5)then
    holefrm=5
    holedir=-1
    holetimer=60
   end
   if(holefrm<1)then
    holefrm=0
    holedir=1
    holetimer=60
   end 
  end
 end  
end

function updaterope()
 local diff
 
 rx+=rdx
 if(rx>=rtx)then
  rdx=-1*rdx
 end
 if(rx<=lfx)rdx=-1*rdx
 
 diff=abs(rx-64)/36
 ry=70-8*diff
 --rdx=sgn(rdx)*(1-(diff))
 
end

