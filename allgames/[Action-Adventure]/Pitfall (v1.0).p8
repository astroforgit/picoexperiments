--map
function buildmap()
 local sn={}
 local lw={}
 local rw={}
 local snk={}
 local fr={}
 local ring,gold={},{}
 local slvr,mony={},{}
 local sc=0
 -------12345678901234567890
 sn[1]='56126173489555553895'
 sn[2]='19612638734896195556'
 sn[3]='17173873871738961738'
 sn[4]='95563444873873448717'
 sn[5]='34871255195563873825'
 sn[6]='63448263482638256173'
 sn[7]='87196125617196171712'
 sn[8]='63487348738263448734'
 sn[9]='44487126382638717125'
 sn[10]='63895656348717171734'
 sn[11]='44896171955612634444'
 sn[12]='44895561734482563871'
 sn[13]='955555612563482xxxxx'
 --walls
 lw[1]={5,14,15,16,26,37,39,40}
 lw[2]={64,87,91,93}
 lw[3]={125,128,134,141}
 lw[4]={168,180,187,188}
 lw[5]={210,215,227,242,244,245,246,247,250}

 rw[1]={1,2,12,13,20,34,48}
 rw[2]={56,62,63,92,100,101}
 rw[3]={107,112,116,117,129,153}
 rw[4]={172,181,185,186}
 rw[5]={205,211,225,226,235,236,243,251,1}

 snk[1]={6,28,63,64,65,72,79}
 snk[2]={100,101,144,153,157}
 snk[3]={159,160,187,197,199}
 snk[4]={215,216,217,218,219}
 snk[5]={228,250}
 
 fr[1]={1,15,43,46,51,57,66,69,74}
 fr[2]={92,95,102,107,118,141}
 fr[3]={148,154,161,180,188,200}
 fr[4]={220,230,235,251}
 
 ring={43,50,73,78,178,196,198,229}
 gold={7,29,80,136,145,175,192,194}
 slvr={70,119,122,131,138,165}
 mony={52,58,84,96,149,177,207,239}
 log1={2,8,16,30,83,87,103,108,112,121,130,137,164,168,176,181,201,206,221,231,238,246,252}
 log3={26,39,41,49,67,75,77,81,93,116,128,135,142,146,155,162,172,174,189,191,193,195,226,236}
 logr1={9,10,12,30,34,35,59,60,88,89,97,113,125,182,183,208,222,223,232,240,242,243,247,253}
 logr2={2,3,13,17,18,20,21,23,31,32,37,38,40,48,53,54,76,82,85,98,104,109,114,120,123,126,129,132,134,150,163,169,173,178,185,190,202,203,205,210,212,225,233,237,243,245,248,254}
 logr3={5,14,24,27,45,56,62,68,71,91,94,105,110,117,139,143,147,151,156,166,170,186,213,227}

 for i=1,256 do
  scenes[i]={typ='none'}
  scenes[i].logs=0
 end

 for r=1,13 do
	 for i=1,20 do
	  sc+=1
	  local c=sub(sn[r],i,i)
	  if c!='x' then
		  if c=='1' then
		   scenes[sc].typ='hole'
		   scenes[sc].rope=true
		  end
		  if c=='2' then
		   scenes[sc].typ='crocs'
		   scenes[sc].rope=true
		  end
		  if c=='3' then
		   scenes[sc].typ='lake'
		   scenes[sc].rope=true
		  end
		  if c=='4' then
		   scenes[sc].typ='growlake'
		  end
		  if c=='5' then
		   scenes[sc].typ='ladder'
		  end
		  if c=='6' then
		   scenes[sc].typ='pits'
		  end
		  if c=='7' then
		   scenes[sc].typ='growhole'
		  end
		  if c=='8' then
		   scenes[sc].typ='growhole'
		   scenes[sc].rope=true
		  end
		  if c=='9' then
		   scenes[sc].typ='crocs'
		  end
		 end
		end
		
		for i=1,5 do
		 for j=1,#lw[i] do
		  scenes[lw[i][j]].lw=true
		 end
		end
		
		for i=1,5 do
		 for j=1,#rw[i] do
		  scenes[rw[i][j]].rw=true
		 end
		end		
		
		for i=1,5 do
		 for j=1,#snk[i] do
		  scenes[snk[i][j]].snake=true
		 end
		end
		
	 for i=1,4 do
		 for j=1,#fr[i] do
		  scenes[fr[i][j]].fire=true
		 end
		end							
		
		for i=1,#ring do
		 scenes[ring[i]].ring=true
		end
		
		for i=1,#gold do
		 scenes[gold[i]].gold=true
		end	
		
		for i=1,#slvr do
		 scenes[slvr[i]].silver=true
		end

		for i=1,#mony do
		 scenes[mony[i]].money=true
		end	
		
		for i=1,#log1 do
		 scenes[log1[i]].logs=1
		end
		for i=1,#log3 do
		 scenes[log3[i]].logs=3
		end	
		for i=1,#logr1 do
		 scenes[logr1[i]].logs=-1
		end		
		for i=1,#logr2 do
		 scenes[logr2[i]].logs=-2
		end	
		for i=1,#logr3 do
		 scenes[logr3[i]].logs=-3
		end														
		
	 for i=1,256 do
	  trees[i]={diceroll(4)}
	 end
	 
	end
 
end

function setupscene()

 --middle of a scene

 ishole=false
 isgrow=false
 isrope=false
 iscrocs=false
 isladder=false
 ispits=false
 islwall=false
 isrwall=false
 isring=false
 isgold=false
 ismoney=false
 issilver=false
 
 sx=60
 
 isrope=scenes[scn].rope

 if scenes[scn].typ=='none' then
 
 end
 if scenes[scn].typ=='hole' then
  ishole=true
  holefrm=5
  holeclr=0
  isrope=true
 end
 if scenes[scn].typ=='lake' then
  ishole=true
  holefrm=5
  holeclr=12
  isrope=true
 end
 if scenes[scn].typ=='growhole' then
