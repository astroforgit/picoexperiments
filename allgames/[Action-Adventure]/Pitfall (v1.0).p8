function _init()

	keybd.init()
	fast=false

 t=0 --frame counter
 state='title'
 debug=''
	score = 2000
	treas = 0
	clockm = 20
	clocks = 60 

 --player data
 lives=3
 x=10
 y=30
 nx,ny=0,0
 pred=false
 feet={}
 feet[1]={4,13,5,11}
 feet[2]={1,12,6,12}
 feet[3]={2,12,5,13}
 feet[4]={3,13,6,12}
 feet[5]={0,13,7,12}
 feet[6]={1,11,7,11} 
 runspr={1,2,3,4,5,6}
 jmpspr={7}
 jmpfeet={0,9,7,11}
 clmspr={9}
 ropespr={8}
 clmtimer=10
 sprs=runspr
 s=1 --sprite
 
 dx=0 --move direction
 dy=0 --jump direction
 jmpstr=-1.6
 grav=.2
 mode='start'
 starttimer=30
 flp = false
 jmpht=0
 
  --describes elements of a scene
 scenes={}
 trees={}

 buildmap()
 scn=1
 
 treetyps={{15,30,53,80},{25,60,80},{10,50,70,95},{40,55,90,110}}
 treestrt={71,73,75,78}
 hifloor=79
 lofloor=115
 floor=hifloor
 
 --hole/lake info
 ishole=false
 isgrow=false
 
 holew={3,12,26,33,36}
 holeh={0,1,2,3,4}
 holefrm=0
 holetimer=60
 holedir=1
 holeclr=12
 
 --croc info
 iscrocs=false
 croctimer=60
 crocfrm=43
 crocx={34,54,74}

 --rope info
 lfx=28
 rtx=100
 rdx=1.5
 isrope=true
 rx=29
 ry=70
 rcx=64
 rcy=0
 
 --scorpian info
 isscorp=false
 scorpfrm=28
 scorptimer=15
 scorpflp=false
 sx=40
 sy=108
 
 --ladder info
 isladder=false
 
 --pits info
 ispits=false
 
 --hazard info
 issnake=false
 isfire=false
 hazx=112
 hazy=76
 hazfrm=0
 
 --logs
 logx={{110},{100,116},{20,100,124}}
 logn={{110},{100,116},{20,100,124}}
 numlog=0
 logflp=false
 logfrm=37
 logtmr=2 --1 sec timer
 
 --reward info
 isring=false
 isgold=false
 ismoney=false
 issilver=false
 rewx=112
 rewy=76
 
 --wall info
 islwall=false
 isrwall=false
 lwallx=8
 rwallx=112
 
 --sound equates
 jmpsnd=0
 
 setupscene()
 
end

function startplayer()
 x=10
 y=30
 if(floor==lofloor)y=80
 sprs=runspr
 s=1
 dx=0 --move direction
 dy=0 --jump direction
 mode='fall' 
 flp = false
 lives-=1
 if lives==-1 then
  _init()
 end
end

function _update()
 t+=1
 if(state=='title')update_title()
 if(state=='game')update_game()
 if(state=='end')update_end()
end

function update_end()
 if(btnp(4) or btnp(5))_init()
end

function update_game()

	if(t%30)==0 then
		clocks-=1
		if clocks==0 then
		 if clockm==0 then
		 	clocks=0
		 	draw_game()
		 	state='end'
		 end
		 clockm-=1
		 clocks=59	 		 
		end
	end
	if(t%5==0)hazfrm=1-hazfrm
	
	if mode=='start' then
		starttimer-=1
		if starttimer==0 then
		 startplayer()
		end
	end

 updatehole()
 if(isrope)updaterope()
 if(isscorp)updatescorp()
 if(numlog>0)updatelogs()
 if iscrocs then
   croctimer-=1
   if croctimer==0 then
     if crocfrm==43 then
      crocfrm=59
     else
      crocfrm=43
     end
     croctimer=60
   end
 end
 
 updateplayer()
 
end

function _draw()
 if(state=='title')draw_title()
 if(state=='game')draw_game()
end

function draw_game()
	cls(0)
	--gray background
	rectfill(0,0,127,80,1)
	--draw tree trunks
	drawtrees(trees[scn][1])
	if(isrope)drawrope()
	--draw tree tops
	rectfill(0,0,127,34,3)

--	for i=1,lives-2 do
--	 print(lives,i*10,24,7)
--	 --line(i*10,24,i*10,30,7)
--	end
	--draw ground	
	 rectfill(0,75,127,85,10)
		rectfill(0,86,127,95,9)

	--draw underground
	rectfill(0,116,127,118,9)
	
	if(ishole) then
	 if isgrow then
	  drawhole(holefrm,holeclr)
	 else
	  drawhole(5,holeclr)
	 end
	end
 if(isladder)drawladder()
 if(ispits)drawpits()

 if(isscorp)drawscorp()

 if(isrwall)then
  spr(36,rwallx,96)
  spr(36,rwallx,104)
  spr(52,rwallx,112)
 end
 if(islwall)then
  spr(36,lwallx,96)
  spr(36,lwallx,104)
  spr(52,lwallx,112)
 end 
 if iscrocs then
  for i=1,#crocx do
   spr(crocfrm,crocx[i],76)
   spr(crocfrm+1,crocx[i]+8,76)
  end
 end
 
 --draw debug info
--print('scn='..scn,0,0,7)
--print(scenes[scn].typ,0,120,7)
--print(x..','..y,90,0,7)
--print(mode,90,120,7)
--print(starttimer,50,120,7)
--print(debug,0,28,7)
	
	--draw player
 if(pred)palall(8)
 if(mode=='drown')clip(x,66,6,14)
-- if(mode=='fall' and x<50)clip(x,40,8,60)
 if mode!='start' then
	 spr(sprs[s],x,y,1,1,flp)
	 spr(sprs[s]+16,x,y+8,1,1,flp)
	end
 if mode=="rope" then
  if not flp then
   line(x+8,y+10,x+9,y+10,3) --right
  else
   line(x-1,y+10,x-2,y+10,3) --left
  end
 end
 pal()
 clip()
 if scenes[scn].typ=='pits' or
    scenes[scn].typ=='ladder' then
  rectfill(0,82,127,85,10)
 end
 if(issnake)spr(12+hazfrm,hazx,hazy)
 if(isfire)spr(14+hazfrm,hazx,hazy-2)
 if(isring)spr(50,rewx,rewy)
 if(isgold)spr(49,rewx,rewy)
 if(issilver)spr(48,rewx,rewy)
 if(ismoney)spr(51,rewx,rewy) 
 if(numlog>0)drawlogs()
 
 --score and clock
 print(score,10,10,7)
 print(clockm..':'..clocks,10,16,7)
	--draw players
	--print('test',10,22,7)
	spr(56+(lives-1),10,19)
 print('activision',17,120,7)
 spr(122,0,117)
 spr(122,8,117)
  
end


