function updatescorp()
 scorptimer-=1

 if scorptimer==0 then
  scorptimer=3
	 if sx>x then 
	  sx-=1
	  scorpflp=false
	 end
	 if sx<x then
	  sx+=1  
	  scorpflp=true
	 end
	 scorpfrm=28+(29-scorpfrm)
 end
end
