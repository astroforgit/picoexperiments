--update player

function updateplayer()

 if(btnp(4))pred=false

 if mode=='stand' then
 
	 if(btn(‹)) then --left
	   flp=true
		  x-=1 
		  mode='run'
	 end
	 if (btn(‘)) then --right
	   flp=false
		  x+=1
		  mode='run'
	 end
	 if (btn(—)) then --jump
	  mode='jump'
	  sprs=jmpspr
	  s=1
	  dy=jmpstr
	  sfx(jmpsnd)
	 end 
	 if btn(”) then
	  if isladder and
	     floor==lofloor then
	   if x>=56 and x<=70 then 
			  mode='climb'
			  sprs=clmspr
			  s=1
			  x=61
			 end
			end
	 end
	 if btnp(ƒ) then
	  if isladder and
	     floor==hifloor then
	   if x>=56 and x<=70 then
	    mode='climb'
	    sprs=clmspr
	    s=1
	    y=77
	    x=61
	   end
	  end
	 end	  
	end
	 
 if mode=='run' then
 
  --not left/right so stop
  if(not btn(0) and not btn(1)) then
   dx=0
   s=1
   mode='stand'
  else
		 if(btn(‹)) then
		  x-=1
		  flp=true
		  mode='run'
		 end
		 if (btn(‘)) then
		  x+=1
		  flp=false
		  mode='run'
		 end  
   if btn(—) then
		  mode='jump'
		  sprs=jmpspr
		  if flp then dx=-1 else dx=1 end
		  s=1
		  dy=jmpstr
		  sfx(jmpsnd)
		 end
		 if btnp(”) then
		  if isladder and 
		     floor==lofloor then
		   if x>=54 and x<=70 then 
				  mode='climb'
				  sprs=clmspr
				  s=1
				  x=61
				  dx=0
				 end
				end		 
		 end
   --update frame
	  if(t%3)==0 then
	   s+=1
	   if s>#sprs then
	    s=1
	   end
	  end
		  
	 end
	 
	end
	
 if mode=='jump' then
  
  dy+=grav
  y+=dy
  x+=dx

	 --did hit floor
  if y+13>floor then
   y=floor-13 --stand on floor
   mode='stand'
   sprs=runspr
   s=1
   dx=0
   offrope=false
  end 
  if ropecollide() and
     offrope==false then
   mode='rope'
   sprs=ropespr
   s=1
   sfx(2)
  end

 end
 
 if mode=='climb' then
  if btn(”) then --up
   if y>=76 then --not at top
	   clmtimer-=1
	   if clmtimer==0 then
	    clmtimer=3
		   if flp==true then
		    flp=false
		   else
		    flp=true
		   end
		   y=y-2
		  end
		 end
  end
  if btn(ƒ) then
   clmtimer-=1
   if clmtimer==0 then
    clmtimer=3
	   if flp==true then
	    flp=false
	   else
	    flp=true
	   end
	   y=y+2
	   if y>102 then
	    mode='stand'
	    sprs=runspr
	    s=1
	    y=102
	    floor=lofloor
	   end
	  end
  end 
  if btn(‹) and y<76 then
  	mode='jump'
		 sprs=jmpspr
		 s=1
		 y=y-8
		 dy=jmpstr
		 dx=-1
		 --if flp then dx=1 else dx=-1 end 
		 x-=1
		 flp=true
		 floor=hifloor
		 sfx(jmpsnd)
		end  
  if btn(‘) and y<76 then
  	mode='jump'
		 sprs=jmpspr
		 s=1
		 y=y-8
		 dy=jmpstr
		 dx=1
		 -- if flp then dx=1 else dx=-1 end
		 
		 x+=1
		 flp=false
		 floor=hifloor
		 sfx(jmpsnd)
		end  				
  	 
 end
 
 if mode=='fall' then
	 y+=1
	 if y==66 or y==102 then
   mode='stand'
   sprs=runspr
   s=1
  end
 end 
 
 if mode=='drown' then
	 y+=.8
	 dx=0
	 sprs=runspr
	 s=1
  if y>79 then
   startplayer()
  end
 end 
 
 if mode=='hitlog' then
  score -= 10
  if scenes[scn].logs>0 then 
	  if(btn(‘))x+=1
	  if(btn(‹))x-=1
	 end
  loghit = false
	 for i=1,#logx[numlog] do
	  if overlap(x+1,x+7,logx[numlog][i],logx[numlog][i]+7) then
	   loghit=true
	  end
	 end  
	 sfx(1)
  if not loghit then
   mode='stand'
   sprs=runspr
   s=1
   y=66
  end

 end
 
 if mode=='rope' then
 
  if btnp(ƒ) then
   mode='jump'
   if rx<64 then
    dx=-1.2
    flp=true
   else
   	dx=1.2
   	flp=false
   end
   offrope=true
   sprs=jmpspr
   s=1
   dy=0
  end
 
  if not flp then
   x=rx-4
   y=ry-4
  else
   x=rx+7
   y=ry-4
  end
  
  if flp==true then
   x=x-7
  else
   x=x-2
  end
  
 end
 
 --hit treasure?
 if scenes[scn].gold then
  if hitbox(rewx,rewy,rewx+7,rewy+7) then
	  isgold=false
	  scenes[scn].gold=false
	  score+=4000
	  treas+=1
	 end
 end 
 if scenes[scn].silver then
  if hitbox(rewx,rewy,rewx+7,rewy+7) then
	  issilver=false
	  scenes[scn].silver=false
	  score+=3000
	  treas+=1
	 end
 end 
 if scenes[scn].ring then
  if hitbox(rewx+1,rewy,rewx+6,rewy+7) then
	  isring=false
	  scenes[scn].ring=false
	  score+=5000
	  treas+=1
	 end
 end  
 if scenes[scn].money then
  if hitbox(rewx+1,rewy+1,rewx+5,rewy+7) then
	  ismoney=false
	  scenes[scn].money=false
	  score+=2000
	  treas+=1
	 end
 end 
 if(treas==32)state='end'
 --hit hazzard?
 if scenes[scn].snake then
  if mode!='start' then
	  if hitbox(rewx+1,rewy+2,rewx+6,rewy+7) then
		  score-=1000
		  if(score<0)score=0
		  mode='start'
		  starttimer=30
		 end
		end
 end 
 if scenes[scn].fire then
  if mode!='start' then
	  if hitbox(rewx+1,rewy+2,rewx+6,rewy+7) then
		  mode='start'
		  starttimer=30
		 end
		end
 end   
 
 if numlog>0 and mode!='rope' then
  if(hitlog()) then
   sfx(1)
   sprs=runspr
   s=6
   y=70
   dx=0
   mode='hitlog'
  end
 end
 
 if hitrwall() then
  if y==102 then
   if flp then
    x=rwallx+6
   else
    x=rwallx-7
   end
  else
   dx=-1*dx
  	flp=not flp  
  end
 end
 
 if hitlwall() then
  if y==102 then
   if flp then
    x=lwallx+6
   else
    x=lwallx-7
   end
  else
   dx=-1*dx
  	flp=not flp  
  end
 end 
 
 if isscorp then
  if hitscorp() then
   --=true
   startplayer()
  else
   --pred=false
  end
 end
 
 if ishole then
  if overhole() then
   if not oncrocs() then
    mode='drown'
   end
  end
 end
 
 if (mode=='run' or mode=='stand') and
    ( overpit() or overladder() ) then
  if mode=='jump' then sfx(0) end
  mode='fall'
  sprs=runspr
  floor=lofloor
  s=1
  dx=0
  score-=100
  if(score<0)score=0
 end
 
 if x>124 then
  --pred=true
  if floor==hifloor then
   scn+=1
   if(scn>255)scn=1
  else
   sfx(0)
   scn+=3
   if(scn>255)scn=scn-255
  end
  x=-2
  setupscene()
 end
 if x<-2 then
  --pred=true
  if floor==hifloor then
   scn-=1
   if(scn==0)scn=255
  else
   scn-=3
   if(scn<=0)scn=255+scn
  end
  x=124
  setupscene()
 end

end

function overhole()
 if y==66 and holefrm>0 then 
	 local hw=holew[holefrm]
		if between(x+4,64-hw,64+hw) then
		 return true
		end
	end
 return false	 
end

 --on crocs
function oncrocs()
 if iscrocs then
  if crocfrm==43 then --closed
   for i=1,#crocx do
    if between(x+3,crocx[i]+6,crocx[i]+16) then
     return true
    end
   end
  else --open
   for i=1,#crocx do
    if between(x+3,crocx[i]+13,crocx[i]+16) then
	    return true
    end
   end
  end
 end
 return false
end

function ropecollide()
 
 for cx=x+4,x+7 do
  for cy=y,y+2 do
   if pget(cx,cy)==7 then
    return true
   end
  end
 end
 return false
end

function overpit()
 if scenes[scn].typ=='pits' then
	 if floor==hifloor then
		 if between(x,25,37) or
		    between(x,85,97) or
		    between(x,58,65) then
		    return true
		 end
		end
	end
 return false
end

function overladder()
 if scenes[scn].typ=='ladder' and
    floor==hifloor then
	 if between(x,58,65) then
	    return true
	 end
	end
 return false
end

function hitlog()
 for i=1,numlog do
  if overlap(x+3,x+5,logx[numlog][i],logx[numlog][i]+7) and
     overlap(y+11,y+11,76,84) then
     return true
  end
    
 end

 return false

end

function hitscorp()
 --check feet
 --no collide if higher than 
 if(y<95)return false
 if mode=='jump' then
  if not flp then--facing right
    --pget(x+4,y+11)==7 or
    if pget(x+7,y+11)==7 then
    return true
   else
    return false
   end
  else --facing left
   if pget(x,y+11)==7 then--or
    --if  pget(x+7,y+11)==7 then
    return true
   else
    return false
   end
  end	 
 else --no jump
  if between(x+3,sx,sx+7) or
     between(x+5,sx,sx+7) then
   return true
  else
   return false
  end   
 end
end

function hitrwall()
	if(floor==hifloor)return false
	if(not isrwall)return false
 if(between(x+6,rwallx+1,rwallx+6))return true
 return false	
end

function hitlwall()
	if(floor==hifloor)return false
	if(not islwall)return false
 if(between(x+1,lwallx+1,lwallx+6))return true
end

function hitbox(x1,y1,x2,y2)
 if overlap(x+3,x+5,x1,x2) and
    overlap(y+12,y+15,y1,y2) then
    	return true
 end
 return false
end

function feethit(c)
 if sprs==runspr then
  if pget(x+feet[s][1],y+feet[s][2],c) or
     pget(x+feet[s][3],y+feet[s][4],c) then
     return true
  else
  	  return false
  end
 end
 if sprs==jmpspr then
  if pget(x+jmpfeet[1],y+jmpfeet[2],c) or
     pget(x+jmpfeet[3],y+jmpfeet[4],c) then
     return true
  else
     return false
  end
 end
end
-->8
--utils
function myspr(s,x,y)

 cy=0

 for r=0,7 do --sprite rows
  a=(s%16)*4+(r*64) --spr address
  cx=0
  for c=a,a+3 do --4 bits per pixel
   v=peek(c) -- get 2 pixels
   p1=band(v,15) --get p1 bits
   p2=shr(band(v,240),4) --get p2 bits

   if(pget(x+cx,y+cy)==0)pset(x+cx,y+cy,p1)
   if(pget(x+cx+1,y+cy)==0)pset(x+cx+1,y+cy,p2)
   cx+=2

  end
  cy+=1

 end
 
end

--spritesheet x
function sprx(s)
 local tx=(s%16)*8
 return tx
end

function palall(v)
 --set all drawing to a
 --single colour
 pal(1,v)
 pal(2,v)
 pal(3,v)
 pal(4,v)
 pal(5,v)
 pal(6,v)
 pal(7,v)
 pal(8,v)
 pal(9,v)
 pal(10,v)
 pal(11,v)
 pal(12,v)
 pal(13,v)
 pal(14,v)
 pal(15,v)
end


-- spritesheet y
function spry(s)
 local ty=flr(s/16)*8
 return ty
end


function dice(sides)
	return flr(rnd(sides)) == 1
end

function overlap(a1,a2,b1,b2)
	return between(a1,b1,b2) or between(a2,b1,b2)
end

function between(a,b,c)
	return a>=b and a<=c
end

function diceroll(sides)
	return flr(rnd(sides))+1
end

function frnd(n)
	return flr(rnd(n))
end

keybd = {
  init = function()
    poke(0x5f2d, 1)
  end,
  key = function()
    return stat(31)
  end	
}


-->8
--title screen

function update_title()
 if(btnp(—))state='game'
end

function draw_title()
 cls(3)
 --write activision
 for i=0,5 do
  spr(i+64,44+i*8,10)
 end 
 --write pitfall
 for i=0,8 do
  spr(i+96,30+i*8,20)
  spr(i+112,30+i*8,28)
 end
 
 --orange box blue fill
 rect(10,48,118,104,9)
 rectfill(11,49,117,103,1)
 
 --ground
 rectfill(11,70,117,78,10)
 rectfill(11,79,117,83,9)
 
 --underground
 rectfill(11,100,117,103,10)
 
 --wall
 spr(36,100,84)
 spr(36,100,92) 
 
 --scorpion
 spr(28,40,92)
 
 --fire
 spr(14,96,70)
 
 --lake
     line(38,74,80,74,12)
 rectfill(42,73,76,75,12)
 rectfill(46,72,73,76,12)
 
 --crocs
 spr(43,42,69)
 spr(44,50,69) 
 spr(43,56,69)
 spr(44,64,69) 
 
 --harry
 spr(8,50,58)
 spr(24,50,66)
 line(50+8,58+10,50+9,58+10,3) --right
  
 
 --rope
 line(64,50,57,60,7)
 
 print('video game cartridge',25,38,10)
 
 print('for use with the',32,110,7)
 print('pico-8 video game system',16,116,7)

end
