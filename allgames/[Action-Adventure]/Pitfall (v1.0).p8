--draw

function drawlogs()
 for i=1,#logx[numlog] do
  spr(logfrm,logx[numlog][i],70)
  spr(logfrm+16,logx[numlog][i],78)
 end
end

function drawhole(frm,clr)
 for i=1,frm do
  h=holeh[frm-i+1]
  w=holew[i]
  rectfill(64-w,80-h,64+w,80+h,clr) 
 end 
end

function drawrope()
--line(64,20,rx,67+rh[rp],7)
  line(rcx,rcy,rx,ry,7)
end

function drawscorp()
 spr(scorpfrm,sx,sy,1,1,scorpflp)
end

function drawladder()
 rectfill(61,78,68,81,0)
 rectfill(61,86,68,95,0)
 for cy=88,118,2 do
  line(63,cy,66,cy,9)
 end
end

function drawpits()
 --left pit
 rectfill(28,78,40,81,0)
 rectfill(28,86,40,95,0)
 --right pit
 rectfill(88,78,100,81,0)
 rectfill(88,86,100,95,0)
end

function drawtrees(n)
 
 local t=treestrt[n]
 
 for i=1,#treetyps[n] do
  tx=treetyps[n][i]
  rectfill(tx,34,tx+5,74,4)
 end
 
 --draw bottom of leaves
 for i=0,15 do
  spr(t,i*8,34)
  t+=1
  if(t>79)t=71
 end
end
 
