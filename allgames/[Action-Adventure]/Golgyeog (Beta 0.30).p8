pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- golgyeog demo
-- by googroker

--game functions

function game_init()
 music(-1)
 reload(0x1000,0x1000,0x2000)
 update=game_update
 draw=game_draw
 
 camx=0
 ptimer=0
 ph=3
 kills=0
 itimer=0
 ibool=true
 ecount=0
 emax=20
 
 actors={}
 
 mtimer=45
 p={
  sp=1,
  x=60,
  y=60,
  w=5,
  h=8,
  flp=false,
  dx=0,
  dy=0,
  maxdx=2.5,
  maxdy=4,
  acc=0.5,
  boost=4.6,
  anim=0,
  --stand,run,jump,fall,slide
  running=false,
  jumping=false,
  falling=false,
  sliding=false,
  landed=false
 }
 
 grav=0.4
 fric=0.85
 
 --random spawner spawner
 --[[local count=0
 while count<20 do
  local rx,ry=rnd(128),rnd(16)
  if fget(mget(rx,ry),1)!=0 then
   --addactor(rx*8,ry*8,7,7,0,0,3,{3})
   addactor(rx*8,ry*8,7,7,0,0,4)
   count+=1
  end
 end]]
 
 --map tile to spawners
 --[[for x=0,127 do
  for y=0,15 do
   if mget(x,y)==18 then
    addactor(x*8,y*8,7,7,0,0,4)
    mset(x,y,0)
   end
  end
 end]]
 
 for x=0,127 do
  for y=0,15 do
   mset(x,y,0)
  end
 end
 
 for i=1,7 do
  copyroom(flr(rnd(8)),1,0,i)
 end
 copyroom(2,1,0,0)
 
 for x=0,127,127 do
  for y=0,15 do
   gtile(x,y,64)
  end
 end
 
end

function game_update()
 --setpal(flr(t()%8))

 p_update()
 p_anim()
 
 for i in all(actors) do
  i:update()
 end
 
 itimer=max(0,itimer-1)
 phitscan()
 
 --setpal(ceil(t()%8))
end

function game_draw()
 cls()
 camx+=flr((p.x-camx-55)*.1)
 camx=mid(0,camx,896)
 camera(camx,0)
 palt(0,false)
 map(0,0)
 
 if(ptimer==1)sfx(4)
 if ptimer>0 and ptimer<mtimer/12 then
  pal(1,3)
  pal(2,3)
 elseif ptimer>0 then
  pal(2,1)
  pal(3,2)
 end
 if(ibool or rnd()>itimer/60)spr(p.sp,p.x,p.y,1,1,p.flp)
 pal(1,1)
 pal(2,2)
 pal(3,3)
 ibool=not ibool
 
 for i in all(actors) do
  i:draw()
  --[[rectfill(0+camx,0,40+camx,10,0)
 end
 
 for i=1,3 do
  local f=16+mid(0,i-ph,1)
  spr(f,i*8+camx-7,0)
 end
 
 --[[
 cprint(stat(1),2+camx,121,3,0)
 cprint(ecount,2+camx,111,3,0)
 ]]
 
 --[[line(64,64,64+cos(t())*8,64+sin(t())*8,8)
 rect(camx+63,0,camx+63,127,8)]]
end
-->8
-- utilities

function collide_map(obj,aim,flag)
 --obj is a table with x,y,w,h
 --aim uses btn directions 0123
 
 local x=obj.x local y=obj.y
 local w=obj.w local h=obj.h
 
 local x1,y1,x2,y2=0,0,0,0

 if aim==0 then --left
  x1=x-2   y1=y
  x2=x     y2=y+h-1
 elseif aim==1 then --right
  x1=x+w   y1=y
  x2=x+w+2 y2=y+h-1
 elseif aim==2 then --up
  x1=x+1   y1=y-2
  x2=x+w-1 y2=y-1
 elseif aim==3 then --down
  x1=x+1   y1=y+h
  x2=x+w-1   y2=y+h
 end
 
 x1/=8 x2/=8 y1/=8 y2/=8
 
 if fget(mget(x1,y1),flag)
 or fget(mget(x2,y1),flag)
 or fget(mget(x1,y2),flag)
 or fget(mget(x2,y2),flag) then
  return true
 else
  return false
 end
end

function cprint(txt,x,y,col1,col2)
 for i=0,.75,.25 do
  print(txt,x+cos(i),y+sin(i),col2)
 end
 print(txt,x,y,col1)
end

function setpal(p)
 for i=1,4 do
  pal(i-1,pals[p*4+i],1)
 end
end

function poof(x,y,v,n,col,s)
 for i=0,10 do
  addactor(x,y,0,0,rnd(v)-v/2,rnd(v)-v/2,1,{s,col,rnd(.15)+.75})
 end
end

function hitscan(s)
 for i in all(actors) do
  if i.enemy and
     abs(i.x-s.x)-s.w/2<s.w/2 and
     abs(i.y-s.y)-s.h/2<s.h/2 then
   poof(i.x,i.y,5,1,2,5)
   poof(i.x,i.y,7,1,3,5)
   sfx(6)
   ptimer=mtimer/12
   del(actors,i)
   ecount-=1
   kills+=10
   del(actors,s)
  end
 end
end

function phitscan()
 for i in all(actors) do
  if i.enemy and
     itimer==0 and
     abs(i.x-p.x)-p.w/2<p.w/2 and
     abs(i.y-p.y)-p.h/2<p.h/2 then
   ph-=1
   if ph<=0 then
    death_init()
   else
    itimer=60
    sfx(7)
   end
  end
 end
end

--returns the tile at x,y on
--page p (0/1)
function smget(x,y,p)
 local bs=p*4
 local mask=rotl(15,bs)
 return rotr(band(mget(x,y),mask),bs)
end

--sets map tile x,y on page p
--to n (0-15)
function smset(n,x,y,p)
 if p==1 then
  mset(x,y,band(mget(x,y),15)+n*16)
 else
  mset(x,y,flr(shr(mget(x,y),4))*16+n)
 end
end

function gtile(x,y,po)
 if po!=nil then mset(x,y,countadjacent(x,y)+po) end
 for i=0,0.75,0.25 do
  local tx,ty=x+sin(i),y+cos(i)
  local tm=mget(tx,ty)
  if(tm>=64 and tm<=79)mset(tx,ty,countadjacent(tx,ty)+flr(tm/16)*16)
 end
end

function countadjacent(x,y)
 local count=0
 for i=0.5,1.25,0.25 do
  local nx,ny=x+sin(i),y+cos(i)
  if fget(mget(nx,ny,1),1) or
     nx<0 or
     nx>127 or
     ny<0 or 
     ny>15 then
   count+=2^((i-0.5)*4)
  end
 end
 return rotl(count)
end
-->8
-- player functions

function p_update()
 p.dy+=grav
 p.dx*=fric
 
 if btn()==0 and p.landed then
  p.sliding=true
 end
 
 if ptimer<mtimer*.92 then
 if btn(‹) then
    p.dx-=p.acc
    p.running=true
    p.flp=true
 end
    
 if btn(‘) then
    p.dx+=p.acc
    p.running=true
    p.flp=false
 end
 end
 
 p.dx=min(max(p.dx,-p.maxdx),p.maxdx)
 
 if btnp(Ž)
 and p.landed then
  p.dy-=p.boost
  p.landed=false
  sfx(0)
 end
 
 ptimer=max(0,ptimer-1)
 if btnp(—) and
    ptimer==0 then
  ptimer=mtimer
  
  local aim=1
  if(p.flp) aim=0
  for i=3,0,-1 do
   if btn(i) then
    aim=i
    break
   end
  end
  if(aim==3)p.landed=false
  local lx,ly=dirs[aim*2+1]*4,dirs[aim*2+2]*4
  p.dx-=lx
  p.dy=-ly
  for i=0,10 do
   addactor(p.x+4,p.y+4,0,0,lx+rnd(4)-2,ly+rnd(4)-2,1,{rnd(6)+2,3,rnd(.15)+.75})
  end
  addactor(p.x+1,p.y+1,6,6,lx,ly,2,{3})
  --addactor(p.x,p.y,7,7,0,0,3,{3})
  sfx(3)
 end
 
 if p.dy>0 then
  p.falling=true
  p.landed=false
  p.jumping=false

  p.dy=min(max(p.dy,-p.maxdy),p.maxdy)
  
  if collide_map(p,3,0) then
   p.landed=true
   p.falling=false
   p.dy=0
   p.y-=((p.y+p.h+1)%8)-1
  end
  
 elseif p.dy<0 then
  p.jumping=true
  if collide_map(p,2,1) then
   p.dy=0
  end
 end
 
 if p.dx<0 then
  if collide_map(p,0,1) then
   p.dx=0
  end
 elseif p.dx>0 then
  if collide_map(p,1,1) then
   p.dx=0
  end
 end
 
 if p.sliding then
  if abs(p.dx)<.2 then
   p.dx=0
   p.sliding=false
   p.running=false
  end
 end
 
 p.x+=p.dx
 p.y+=p.dy
 
end

function p_anim()
 if p.jumping then
  p.sp=5
 elseif p.falling then
  p.sp=6
 elseif p.sliding and not (btn(0) or btn(1)) then
  p.sp=2
 elseif p.running then
  if t()-p.anim>.08 then
   p.anim=t()
   p.sp+=1
   if p.sp>4 then
    p.sp=3
    sfx(1)
   end
  end
 else
  p.sp=t()*2%2+1
 end
end
