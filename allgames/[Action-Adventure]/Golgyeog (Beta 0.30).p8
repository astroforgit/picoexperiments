-- actors

function addactor(x,y,w,h,dx,dy,id,s)
 local a={}
 local b=objs[id]
 a.x=x a.y=y a.w=w a.h=h
 a.dx=dx a.dy=dy a.id=id 
 a.init=b.init
 a.update=b.update
 a.draw=b.draw
 a.enemy=b.enemy
 a:init(s)
 add(actors,a)
end

objs={
 { --1: particle
  enemy=false,
  init=function(s,l)
   s.r=l[1] s.col=l[2] s.d=l[3]
  end,
  
  update=function(s)
   s.x+=s.dx
   s.y+=s.dy
   s.dx*=s.d
   s.dy*=s.d
   s.r*=s.d
   if s.r<0.5 then
    del(actors,s)
   end
  end,
  
  draw=function(s)
   circfill(s.x,s.y,s.r,s.col)
  end
 },
 
 { --2: spell projectile
  enemy=false,
  init=function(s,l)
   s.dmg=l[1] s.aim=aims[flr(atan2(s.dx,s.dy)*4)/4]
  end,
  
  update=function(s)
   if collide_map(s,s.aim,1) then
    for i=0,7 do
     addactor(s.x+4,s.y+4,0,0,-s.dx+rnd(4)-2,-s.dy+rnd(4)-2,1,{rnd(6)+2,3,rnd(.15)+.75})
    end
    del(actors,s)
    sfx(5)
   end
   s.x+=s.dx
   s.y+=s.dy
   
   hitscan(s)
  end,
  
  draw=function(s)
   for i=0,1 do
    circfill(s.x+s.w/2,s.y+s.h/2,s.w/2-i,2+i)
   end
  end
 },
 
 { --3: goomba
  enemy=true,
  init=function(s)
   s.dx=flr(rnd(2))*2-1 s.dy=flr(rnd(2))-.5
   s.flp=s.dx>0 s.off=rnd()
  end,
  
  update=function(s)
   --bouncing behaviour
   if collide_map(s,sgn(s.dx)/2+.5,1) then
    s.dx*=-1
    s.flp=not s.flp
   end
   
   if collide_map(s,sgn(s.dy)/2+2.5,1) then
    s.dy*=-1
   end
   
   --smoke juice
   if rnd()>.90 then
    addactor(s.x+4,s.y+4,0,0,rnd()-.5,rnd()-.5,1,{3,1,rnd(.05)+.94})
   end
   
   s.x+=s.dx
   s.y+=s.dy
  end,
  
  draw=function(s)
   local k=sin(t()+s.off)
   for i=0,.8,.2 do
    circfill(s.x+4+cos(i+t())*3,s.y+k+3+sin(i+t())*3,2,1)
   end
   --s.y+k*2
   spr(33,s.x,s.y+k*2,1,1,s.flp)
  end
 },
 
 { --4: spawner
  init=function(s)
   s.acount=0
  end,
  
  update=function(s)
   local active=s.acount>0
   if active then
    --smoke juice
    if rnd()>.80 then
     addactor(s.x+4,s.y+4,0,0,rnd()-.5,rnd()-.5,1,{3+rnd(3),1+rnd(2),rnd(.05)+.94})
    end
    s.acount-=1
    if s.acount<=0 then
     if(abs(p.x-s.x)<60) sfx(3)
     local p=3+flr(rnd(1.3))*2
     --local p=5
     addactor(s.x,s.y,7,7,0,0,p)
    end
    --[[if ecount>=emax-1 then
     s.acount=0
    end]]
   else
    --activation chance
    if rnd()^5>ecount/emax then
     s.acount=60
     ecount+=1
    end
   end
  end,
  
  draw=function(s)
   spr(18,s.x,s.y+sin(t())*2)
  end
 },
 
 { --5: chunky goombas
  enemy=true,
  init=function(s)
   s.w=9 s.h=9
   s.dx=flr(rnd(2))-.5 s.dy=flr(rnd(2))-.5
   s.flp=s.dx>0 s.off=rnd()
  end,
  
  update=function(s)
   --bouncing behaviour
   if collide_map(s,sgn(s.dx)/2+.5,1) then
    s.dx*=-1
    s.flp=not s.flp
   end
   
   if collide_map(s,sgn(s.dy)/2+2.5,1) then
    s.dy*=-1.2
    if(s.dy<0 and sgn(p.x-s.x)!=sgn(s.dx)) s.dx*=-1 s.flp=not s.flp
    if(s.dy>0)s.dy*=-0.3
   end
   
   s.dy+=0.03
   
   --smoke juice
   if rnd()>.90 then
    addactor(s.x+4,s.y+4,0,0,rnd(2)-1,rnd(2)-1,1,{3,1,rnd(.05)+.94})
   end
   
   s.x+=s.dx
   s.y+=s.dy
  end,
  
  draw=function(s)
   local k=sin(t()+s.off)
   for i=0,.8,.2 do
    circfill(s.x+4+cos(i+t())*4,s.y+3+sin(i+t())*4,3,1)
   end
   --s.y+k*2
   spr(34,s.x,s.y+s.dy*1.5,1,1,s.flp)
   for i=-6,6,12 do
    spr(35,s.x+i,s.y+s.dy*-1.5,1,1,s.flp)
   end
  end
 }
}
