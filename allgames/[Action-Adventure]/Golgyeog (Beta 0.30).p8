-- menu gamestates

function death_init()
 sfx()
 sfx(12)
 dtimer=0
 game_draw()
 update=death_update
 draw=death_draw
 
 camera()
 p.x+=4-camx
 p.y+=4
end

function death_update()
 dtimer+=2
 if dtimer>390 and kills>0 then
  kills-=1
  ascore+=1
  sfx(0)
  if(ascore%100==0) sfx(13)
 end
 
 if(dtimer>60 and btnp(5)) for i=0,3 do sfx(-1,i) end music(-1) ascore+=kills menu_init()
end

function death_draw()
 for i=0,700 do
  local rx,ry=rnd(128),rnd(128)
  if (rx-p.x)^2+(ry-p.y)^2>3780-dtimer*14 then
   circ(rx,ry,1,max(pget(rx,ry)-1))
  end
 end
 
 --270
 if dtimer>270 then
  --cprint("game over",47+camx,50,3,0)
  local o=1-(1-min(1,(dtimer-270)/180))^4
  circfill(64,48*o-16,16*o+sin(t()/2)*2,3)
  spr(96,52,40*o-16,3,2)
  cprint("score  "..kills,47,70*o-16,0,3)
  rect(37,80*o-15,90,80*o-10,3)
  rectfill(37,80*o-15,37+53*(ascore%100)/100,80*o-10,3)
  spr(104,32,80*o-16)
  spr(104,88,80*o-16,1,1,true)
  cprint(abs(100-ascore%100).." to next unlock",29,95*o-16,0,3)
  cprint("press — to return",27,105*o-16,0,3)
 end
end

--#--#--#--#--#--#--#--#--#--#--
--#--#--main menu state --#--#--
--#--#--#--#--#--#--#--#--#--#--

function menu_init()
 update=menu_update
 draw=menu_draw
 music()
 cy=1
 mbutts={
  "start", function() game_init() end,
  "change palette", function() currentpal=(currentpal+1)%14 setpal(currentpal) end,
  "exit", function() cls() print("see you soon...\n\n     -mabeobsa ‡",32,32,1) music(-1) stop() end
 }
 cls()
end

function menu_update()
 if(btnp(2)) cy-=1 sfx(11)
 if(btnp(3)) cy+=1 sfx(11)
 cy=mid(1,cy,#mbutts/2)
 
 if(btnp(4)) mbutts[cy*2]()
end

function menu_draw()
 rect(0,127,127,127,3)
 
 local gh=sin(t()/2)/1.6-1.25
 for i=0,2000 do
  local rx,ry,r=rnd(128),rnd(127),rnd()
  circ(rx+r*2+gh,ry,r*2,max(pget(rx,ry+1)+r-.15,0))
 end
 
 spr(99,43,10,5,2)
 --sspr(24,48,40,16,24,48,80,32)
 for i,p in pairs(mbutts) do
  if i%2==1 then
   local h=0
   local x,y=64-#p*2,40+i*7
   if(cy*2-1==i) h=1 rectfill(x-2,y-2,x+#p*4,y+6,2)
   cprint(p,x,y,3-h*3,h*3)
  end
 end
 
end


