-- main functions+state machine

function _init()
 palt(14,true)
 palt(0,false)
 currentpal=0
 ascore=1
 menuitem(1,"change palette",function() currentpal=(currentpal+1)%14 setpal(currentpal) end)

 pals={
  128,5,13,7,     --greyscale
  1,140,12,7,     --bonechill
  0,128,1,133,    --midnight
  4,142,15,7,     --peachy
  1,3,11,10,      --gameboy
  128,2,9,10,     --pumpkin
  5,134,6,7,      --bone-dry
  0,128,6,7,      --hi-contrast
  
  0,8,7,7,        --downwell
  0,146,13,6,     --squid ink
  130,132,4,137,  --murkbrass
  128,131,14,10,  --ol' cymk
  4,137,9,135,    --opulence
  0,7,7,7,        --1-bit
  0,129,142,10, --peach-black
  130,136,13,10   --blood lemon
 }
 setpal(currentpal)

 dirs={-1, 0,
        1, 0,
        0,-1,
        0, 1 }
 
 aims={[0]=1, 
       [.25]=2, 
       [.5]=0, 
       [.75]=3
       }
 update=nil
 draw=nil
 --game_init()
 menu_init()
end

function _update()
 draw()
end

function _draw()
 update()
end
-->8
-- level generation

function copyroom(x1,y1,p,x2)
 for x=0,15 do
  for y=0,15 do
   local ix=x1*16+x
   local iy=y1*16+y
   local rx=x2*16
   local m=smget(ix,iy,p)
   if m==1 then
    gtile(rx+x,y,64)
   elseif m==2 then
    mset(rx+x,y,81)
   elseif m==3 then
    mset(rx+x,y,80)
   elseif m==4 then
    addactor((rx+x)*8,y*8,7,7,0,0,4)
   end
  end
 end
end
