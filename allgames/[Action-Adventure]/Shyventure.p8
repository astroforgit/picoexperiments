pico-8 cartridge // http://www.pico-8.com
version 29
__lua__

--shyventure
--by nul_h
--game loop

function _init()
 map_setup()
 text_setup()
 make_player()
 color_setup()
 title = true
 music(1)
 
 game_win=false
 game_over=false
end

function _update()
 if (not title) then
	 if (not game_over) then
	  if(not active_text) then
	 		update_map()
	 		move_player()
	 		check_win_lose()
	 	end
	 	color_change()
	 else
	  music(-1)
	 	if (btnp(—)) extcmd("reset")
	 end
	else
		update_map()
	 move_player()
	 draw_title()
	 if (btnp(Ž)) then
	  play()
	  title = false
	  music(0)
	 end
	 if (btnp(Ž)) and (btnp(—)) then
	 	ranibow=true
	  play()
	  title = false
	  music(0)
		end
	end
end

function _draw()
 cls()
 if (not game_over) then
 	draw_map()
 	draw_title()
 	draw_player()
 	if (slime) spr(18,49*8,22*8)
 	if (ranibow) spr(21,49*8,22*8)
 	draw_text()
 	if (btn(—)) show_inventory()
 else
 	draw_win_lose()
 end
end
-->8
--map code

function map_setup()
 --timers
 timer=0
 anim_time=30 --30 = 1sec
 slime=false

 --map tile settings
 wall={3,5,6,7,8,17,19,20,21,23,25,27,34,35,36,40,41}
 key={32,38}
 key1={56}
 key2={58}
 key3={60}
 door={36}
 door1={23}
 door2={25}
 door3={27}
 anim1={48,50}
 anim2={49,51}
 text={17,18,19,20,21,32,40,41}
 lose={48,50}
 win={52}
 gold={34}
end

function update_map()
 if (timer<0) then
  toggle_tiles()
  timer=anim_time
 end
 timer-=1
end

function draw_map()
	mapx=flr(p.x/16)*16
	mapy=flr(p.y/16)*16
	camera(mapx*8,mapy*8)
	map(0,0,0,0,128,64)
end

function draw_title()
 print("press Ž to start",928,464,6)
end

function is_tile(tile_type,x,y)
 tile=mget(x,y)
 for i=1,#tile_type do
  if (tile==tile_type[i]) return true 
 end
 return false
end

function can_move(x,y)
 return not is_tile(wall,x,y)
end

function swap_tile(x,y)
	tile=mget(x,y)
 mset(x,y,tile+1)
end

function unswap_tile(x,y)
	tile=mget(x,y)
 mset(x,y,tile-1)
end

function get_key(x,y)
 p.keys+=1
 swap_tile(x,y)
 sfx(1)
end

function get_key1(x,y)
 p.key1+=1
 swap_tile(x,y)
 sfx(1)
end

function get_key2(x,y)
 p.key2+=1
 swap_tile(x,y)
 sfx(1)
end

function get_key3(x,y)
 p.key3+=1
 swap_tile(x,y)
 sfx(1)
end

function open_door(x,y)
 p.keys-=1
 swap_tile(x,y)
 sfx(3)
end
function open_door1(x,y)
 slime = true
 p.key1-=1
 swap_tile(x,y)
 sfx(3)
end

function open_door2(x,y)
 p.key2-=1
 swap_tile(x,y)
 sfx(3)
end

function open_door3(x,y)
 p.key3-=1
 swap_tile(x,y)
 sfx(3)
end


function get_gold(x,y)
 p.gold+=5
 swap_tile(x,y)
 sfx(1)
end

function play()
	p.x=5
	p.y=4
end

function color_setup()
  col = 8
end

function color_change()
	if ranibow then
	 pal(8,col,0)
  if col >15 then
	  col = 8
		else
	  col += 0.2
		end
	end
end
 
  
-->8
--player code

function make_player()
 p={}
 p.x=190
 p.y=57
 p.sprite=16
 p.keys=0
 p.gold=0
 p.key1=0
 p.key2=0
 p.key3=0
end

function draw_player()
 spr(p.sprite,p.x*8,p.y*8)
end

function move_player()
	newx=p.x
	newy=p.y
	
	if (btnp(‹)) newx-=1	sfx(6)
	if (btnp(‘)) newx+=1 sfx(6) 
	if (btnp(”)) newy-=1 sfx(6)
	if (btnp(ƒ)) newy+=1	sfx(6)
	
	interact(newx,newy)
	
	if(can_move(newx,newy)) then
		p.x=mid(0,newx,127)
		p.y=mid(0,newy,63)
	else
	 sfx(0)
	end
end

function interact(x,y)
	if(is_tile(text,x,y)) then
 	active_text=get_text(x,y)
	end

 if (is_tile(key,x,y)) then
 	get_key(x,y)
 elseif (is_tile(door,x,y)) and p.keys>0 then
 	open_door(x,y)
 elseif (is_tile(door1,x,y)) and p.key1>0 then
 	open_door1(x,y)
 elseif (is_tile(door2,x,y)) and p.key2>0 then
 	open_door2(x,y)
 elseif (is_tile(door3,x,y)) and p.key3>0 then
 	open_door3(x,y)
 elseif (is_tile(key1,x,y)) then
 	get_key1(x,y)
 elseif (is_tile(key2,x,y)) then
 	get_key2(x,y)
 elseif (is_tile(key3,x,y)) then
 	get_key3(x,y)
 elseif (is_tile(gold,x,y)) then
  get_gold(x,y)
	end
end


-->8
--inventory code

function show_inventory()
	invx=mapx*8+40
	invy=mapy*8+8
	
	rectfill(invx,invy,invx+48,invy+66,0)
	print("inventory",invx+7,invy+4,7)
	print("keys "..p.keys,invx+12,invy+14,9)
 print("gold "..p.gold,invx+12,invy+21,9)
 print("zaph.\nkey  "..p.key1,invx+12,invy+28,9)
 print("emer.\nkey  "..p.key2,invx+12,invy+41,9)
 print("ruby \nkey  "..p.key3,invx+12,invy+54,9)
end
-->8
--animation code

function toggle_tiles() 
	for x=mapx,mapx+15 do
		for y=mapy,mapy+15 do
			if (is_tile(anim1,x,y)) then
				swap_tile(x,y)
				sfx(2)
			elseif (is_tile(anim2,x,y)) then
				unswap_tile(x,y)
				sfx(2)
			end
		end
	end
end
-->8
--win/lose code

function check_win_lose()
 if (is_tile(win,p.x,p.y)) then
  game_win=true
  game_over=true
  sfx(4)
 elseif (is_tile(lose,p.x,p.y)) then
  game_win=false
  game_over=true
  sfx(5) 
 end
end

function draw_win_lose()
 camera()
 if (game_win) then
  print("’ you win! ’", 37,64,7)
 else
 	print("game over! :(",38,64,7)
 end
 print("press — to play again",20,72,5)
end
-->8
--text code

function text_setup()
 texts={}
 add_text(0,14,"nice!,you got a key \ncheck inventory with —")
 add_text(3,4,"welcome to nuland! \n the land of ascencion.")
 add_text(3,30,"never press — and Ž in the \ntitle screen together")
 add_text(14,27,"beware traveler,to enter the\ntemple you will need the \nsacred keys")
 add_text(111,47,"nice")
 add_text(49,22,"you shouldnt be here")
 add_text(40,20,"the tomb of\n...idk..\ndead people?")
 add_text(51,20,"i would tell you that the\nprincess is in another castle,\nbut i dont know where it is")
 add_text(30,09,"hyah?")
 add_text(1,18,"you thought i was a sign\n,but it was me\ndio!")
end

function add_text(x,y,message)
 texts[x+y*128]=message
end

function get_text(x,y)
 return texts[x+y*128]
end

function draw_text()
 if (active_text) then
  textx=mapx*8+4
  texty=mapy*8+48
  
  rectfill(textx,texty,textx+119,texty+31,7)
  print(active_text,textx+4,texty+4,1)
  print("Ž to close",textx+4,texty+23,6)
 end
 
 if (btnp(Ž)) active_text=nil
end
