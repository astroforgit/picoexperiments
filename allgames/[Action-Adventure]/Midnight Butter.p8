pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
--midnight butter


function _init()
	titleinit()
end

function _update()
	if (mode == 0) then
		titleupdate()
	else
		gameupdate()
	end
end

function _draw()
	if (mode == 0) then
		titledraw()
	else
		gamedraw()
	end
end


-->8
--map code

function map_setup()
	--map tile settings
	wall=0
	duck=1
	warped=2
	car=3
	robot=4
	plant=5
	win=7
end

function draw_map()

	mapx=flr(p.x/16)*16
	mapy=flr(p.y/16)*16

	camera(mapx*8,mapy*8)
	for i=1,p.lives do
		spr(12,i*8+mapx+91,mapy*8+39)
		spr(rp.sp,(mapx*8)+96,(mapy*8)+52,4,2)
	end
	
	mask_player()
	
	map(0,0,0,0,128,64)
	
end

function is_tile(tile_type,x,y)
	tile=mget(x,y)
	has_flag=fget(tile,tile_type)
	return has_flag
end

function can_move(x,y)
	return not is_tile(wall,x,y)
end


function swap_tile(x,y)
	tile=mget(x,y)
	mset(x,y,tile+1)
end

function unswap_tile(x,y)
	tile=mget(x,y)
	mset(x,y,tile-1)
end

function squeak(x,y)
	p.lives-=1
	swap_tile(x,y)
	sfx(4)
end

function creak(x,y)
	p.lives-=1
	swap_tile(x,y)
	sfx(2)
end

function vroom(x,y)
	p.lives-=1
	swap_tile(x,y)
	sfx(5)
end

function boom(x,y)
	p.lives-=1
	swap_tile(x,y)
	sfx(6)
end

function brk(x,y)
	p.lives-=1
	swap_tile(x,y)
	sfx(7)
end



-->8
--player code

function draw_player()
	palt(0,false)
	palt(8,true)
	spr(p.sprite,p.x*8,p.y*8)
	palt()
end

function move_player()
	newx=p.x
	newy=p.y

	if (btnp(‘)) then 
		newx+=.2
		p.sprite+=1
		if p.sprite >4 then
			p.sprite=1
		end
	end

	if (btnp(”)) then
		newy-=.2
		p.sprite+=1
		if p.sprite >4 then
			p.sprite=1
		end
	end
	
	if (btnp(ƒ)) then 
		newy+=.2
		p.sprite+=1
		if p.sprite >4 then
			p.sprite=1
		end
	end
	
	if (btnp(‹)) then
		newx-=.2
		p.sprite+=1
		if p.sprite >4 then
			p.sprite=1
		end
	end
	
	interact(newx,newy)
	
	if (can_move(newx,newy)) then
		p.x=mid(0,newx,127)
		p.y=mid(0,newy,63)
	else
		sfx(0)
	end		
end


function interact(x,y)
	if (is_tile(duck,x,y)) then
		squeak(x,y)
	end
	if (is_tile(warped,x,y)) then
		creak(x,y)
	end
	if (is_tile(car,x,y)) then
		vroom(x,y)
	end
	if (is_tile(robot,x,y)) then
		boom(x,y)
	end
	if (is_tile(plant,x,y)) then
		brk(x,y)
	end
end

-->8
--tools

function dofade()
	local p,kmax,col,k=flr(mid(0,fadeperc,1)*100)
	for j=1,15 do
		col = j
		kmax=flr((p+(j*1.46))/22)
		for k=1,kmax do
			col=dpal[col]
		end
		pal(j,col,1)
	end
end

function checkfade()
	if fadeperc>0 then
		fadeperc=max(fadeperc-0.1,0)
		dofade()
	end
end

function wait(_wait)
	repeat
		_wait-=1
		flip()
	until _wait<0
end

function fadeout(spd,_wait)
 if (spd==nil) spd=0.04
 if (_wait==nil) _wait=0
 repeat
  fadeperc=min(fadeperc+spd,1)
  dofade()
  flip()
 until fadeperc==1
 wait(_wait)
end

function mask_player(x,y)
	clip(p.x*8-6,p.y*8-16,20,32)
end

-->8
--the win the lose

function check_win_lose()
	if (is_tile(win,p.x,p.y)) then
		game_win=true
		game_over=true
		music(1)
	elseif p.lives<=0 then
		game_win=false
		game_over=true
		music(-1)
	end
end

function draw_win_lose()
	camera()
	if (game_win) then

		rectfill(0,0,128,128,9)
		rectfill(5,5,122,122,0)
		rect(4,4,123,123,10)
		print("you got the butter!!!",24,76,7)
		spr(99,56,36,2,2)
		palt(0,false)
		palt(2,true)
		spr(97,56,52,2,2)
		print("press any button to replay",14,84,7)
	else
		palt(0,false)
		spr(72,96,52,4,2)
		if(t%8<3) then
			print("the music",37,54,8)
			print("stops playing",29,62,8)
		elseif(t%8>5) then
			print("it's back to",38,54,8)
			print("bed for you!",39,62,8)
		else
			print("great job being",27,54,8)
			print("not quiet!",38,62,8)
		end
		print("press any button to replay",16,84,7)
	end
end
-->8
--title screen stuff

function titleinit()
	mode=0
end

function gameinit()
	mode=1
	music(0)
	map_setup()
	
	game_win=false
	game_over=false
	debug={}
	
	
	snd={1,2,3,1,1,1,1,1,1,1}
	dpal={0,8,8,3,11,13,6,4,4,9,3,13,1,13,7}
	fadeperc=1
	
	p={}
	p.x=4
	p.y=0
	p.sprite=1
	p.lives=3
	
	rp= {sp=64,x=96,y=52,w=4,h=2}
	
	t=0
end

function titleupdate()
	if btn(4,0) or btn(5,0) then
		gameinit()
	end
end

function gameupdate()
		if (not game_over) then
		t=t+1
		if(t%8<4) then
			rp.sp=64
		else
			rp.sp=68
		end
		move_player()
		check_win_lose()
	else
		if (btnp(—) or btnp(Ž)) extcmd("reset")
	end
end

function titledraw()
	cls()
	rect(0,0,127,127,2)
	spr(136,38,24,6,2)
	spr(128,28,40,8,4)
	spr(168,44,76,5,2)
	print("press any button to start",14,110,7)
end

function gamedraw()
	cls()
	if (not game_over) then
		draw_map()
		draw_player()
		checkfade()
	else
		draw_win_lose()
	end
end
