end

pal(6,10,1) pal(5,9,1)
pal(4,8,1) pal(3,2,1)
pal(2,1,1) pal(1,0,1)
pal(15,7,1)

for i=0,31 do
  for j=0,127 do
    c=sget(j,i+96)
    if c>1 and c<15 then
      sset(j,i+96,8+rnd(7))
    end
  end
end

p=-128 f=-24
repeat
  for i=1,1400 do
    x=rnd(128) y=rnd(128)
    c=pget(x,y)
    if c>1 and c<8 then
      pset(x,y,c-1)
    end
    if c<=6 then
      pset(x-1+rnd(3),y-2+rnd(5),c)
    end
  end
  if p>-64 then
    if f>=-24 and f<=24 and f%4==0 then
      sfx(26)
    end
    circfill(f,24,12,6)
    circfill(127-f,102,12,6)
    f+=3
  end
  for i=8,14 do
    pal(i,8+rnd(8))
  end
  spr(192,min(p,0),48,16,4)
  p+=1
  flip()
  nano()
until k=="a"
nokey()
sfx(31)
i=1 while i<10 do i+=.03
  for j=0,1200 do
    x=rnd(128) y=rnd(128)
    c=pget(x,y)
    if c>1 then
      if y<64 then
        pset(x-1+rnd(2),y-i,c)
      else
        pset(x-1+rnd(2),y+i,c)
      end
      pset(x,y,0)
    end
  end
  flip()
  if (btn(4)) i=10
end
cls()
pal()
nokey()

n=0
