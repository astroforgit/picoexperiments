end
spr(64,34,8,7,8)
spr(64,38,8,7,8)
pal()
spr(64,36,8,7,8)

sfx(0)
for i=0,127 do
  for j=0,127 do
   scrn[j+i*128]=britec[pget(j,i)+1]
  end
end
memcpy(0,24576,8192)
repeat
  adddrop()
  adddrop()
  memcpy(24576,0,8192)
  for i in all(l_rain) do
    for j=0,6 do
      n=scrn[i.x+flr(j+i.y)*128]
      if (n==nil) n=0
      pset(i.x,i.y+j,n)
    end
    i.y+=i.ay
    i.ay+=.1
    if (i.y>69) del(l_rain,i)
  end
  clip(0,73,128,57)
  print(inx,0,v,5)
  clip()
  v-=.15
  if (k=="b" or v>106) v-=.85
  l+=1
  if l>400 and l<420 then
    if (l%2==0) rectfill(0,0,127,127,7)
  end
  if (l==500) sfx(1) l=0
  flip()
  nano()
until k=="a"

