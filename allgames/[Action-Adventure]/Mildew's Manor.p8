pal(1,4,1)
s=""

-- main game

repeat
  for i=8,15 do
    if fnr(lt*2)==0 or (fnr(16)>0 and matchlit==1) then
      pal(i,7,1)
    else
      pal(i,0,1)
    end
  end
  lt+=.1
  fl+=1
  gf=1-gf
  for i=0,12 do
    if level<4 and gf==0 and (i==0 or matchlit==1 or ((abs(x-itmx[i])<spiritdist and abs(y-itmy[i])<spiritdist) or level==1)) and itmx[i]>0 then
      s=11
      if (i==0) s=25
      spr3(itmx[i],itmy[i],s)
    end
  end
  if fl%2==0 and fl<25 and fl>=0 then
    pal(0,7,1)
  else
    pal(0,0,1)
  end
  if (lt>=50) lt=0 fl=0
  if (fl==100) sfx(1)
  rectfill(0,120,127,127,0)
  if msgt>0 then
    msgt-=1
    prit(-1,121,msg,fnrr(1,7))
  else
    x2=999
    meter=40
    clik=0
    if ghosts<12 then
      for i=1,12 do
        x3=abs(itmx[i]-x)
        y3=abs(itmy[i]-y)
        if x3+y3<x2 and itmx[i]>0 then
          x2=x3+y3
        end
      end
      if x2==1 then
        meter=44
        clik=8
      elseif x2==2 then
        meter=43
        clik=12
      elseif x2==3 then
        meter=42
        clik=20
      elseif x2==4 then
        meter=41
        clik=32
      end
    end
    if clik>0 then
      toclik-=1
      if toclik<=0 then
        sfx(32)
        toclik=clik
      end
    end      
    spr(meter,100,120)
    if gotkey==1 then
      compass+=1
      if compass==40 then
        compass=32
      end
    elseif x<itmx[0] and y<itmy[0] then
      compass=35
    elseif x<itmx[0] and y>itmy[0] then
      compass=33
    elseif x>itmx[0] and y>itmy[0] then
      compass=39
    elseif x>itmx[0] and y<itmy[0] then
      compass=37
    elseif x<itmx[0] then
      compass=34
    elseif x>itmx[0] then
      compass=38
    elseif y<itmy[0] then
      compass=36
    elseif y>itmy[0] then
      compass=32
    end
    spr(compass,40,120)
    if lcompass!=compass then
      lcompass=compass
      if (gotkey==0) sfx(33)
    end
    spr(18,0,120)
    if (ti2!=ti) sfx(7)
    ti="11:"..dec(flr(60-minutes),2)
    if (minutes<=0) gameover(2)
    s=sub(ti,4,5)
    if ti!=ti2 and (s=="15" or s=="30" or s=="45") then
      sfx(8)
    end
    ti2=ti
    minutes-=.01
    if level==4 then
      spr(27,8,121)
      minutes=1
    else
      print(ti,8,121,7)
    end
    spr(19,28,120)
    spr(8,112,120)
    print(dec(shields,2),120,121,7)
    if bottle==1 then
      spr(9,52,120)
      print(dec(ghosts,2),60,121,7)
    end
    if matches>0 then
      if matchlit==1 then
        spr(13,70,120)
      else
        spr(12,70,120)
      end
      print(matches,78,121,7)
    end
    if gotkey==1 then
      spr(14,86,120)
    end
  end
  if skipkey==0 then
    spr3(x,y,10)
    flip()
    nano()
    pal(5,0) pal(6,0) pal(7,0)
    spr3(x,y,26)
  end
  pal(5,0) pal(6,0) pal(7,0)
  x2=x y2=y
  if k=="b" then
    msgt=50
    if gotkey==1 then
      if x==20 then
        if y==1 then
          gameover(0)
        elseif y==37 then
          msg="key does not fit this lock!"
          sfx(15)
          lockkey=50
        end
      else
        msg="cannot use key here"
      end
    else
      msg="you do not have a key"
    end
  end
  if k=="a" then
    if matches==0 then
      msg="you have no more matches"
      msgt=50
    elseif matchlit==0 then
      msg="you strike up a match"
      msgt=50
      matchlit=1
      sfx(12)
      lockkey=50
    end
  end
  if (k=="u") y-=1
  if (k=="d") y+=1
  if (k=="l") x-=1
  if (k=="r") x+=1
  if arrowkey==1 and ghosts==12 and noblock==0 then
    n=0
    repeat
      x3=fnrr(2,38)
      y3=fnrr(2,36)
      ok=1
      for i=y3-1,y3+1 do
        for j=x3-1,x3+1 do
          if area[j+i*41]>0 and (i==y3 or j==x3) then
            ok=0
          end
        end
      end
      n+=1
    until ok==1 or n==1000
    if n==1000 then
      noblock=1
    else      
      spr3(x3,y3,4)
      area[x3+y3*41]=1
    end
  end
  if matchlit==1 and arrowkey==1 then
    matchlit=0
    matches-=1
    msg="match went out"
    msgt=50
  end
  pal(5,5) pal(6,6) pal(7,7)
  skipkey=0  
  if gotkey==0 then
    for i=0,12 do
      if x==itmx[i] and y==itmy[i] then
        if i==0 then
          if bottle==0 then
            bottle=1
            msg="you found a bottle for spirits"
            msgt=50
            sfx(3)
          elseif ghosts<12 then
            matches+=1
            if matches>9 then
              matches=9
            end
            msg="you found a match - Ž to use"
            msgt=50
            sfx(3)
          else
            gotkey=1
            msg="you found a key - — to use"
            msgt=50
            sfx(3)
          end
          repeat
            x2=fnrr(1,39)
            y2=fnrr(1,37)
          until area[x2+y2*41]==0
          if gotkey==1 then
            x2=0 y2=0
          end
          itmx[i]=x2 itmy[i]=y2
        elseif bottle==1 then
          msg="you caught a spirit!"
          if ghosts==11 then
            msg='mildew yells: "get out!"'
            sfx(4)
            poke(0x5f41,1)
          end
          msgt=50
          sfx(6)
          rectfill(itmx[i]*3+2,itmy[i]*3+1,itmx[i]*3+4,itmy[i]*3+3,0)
          itmx[i]=0 itmy[i]=0
          ghosts+=1
        elseif arrowkey==1 then
          msg="you feel a chill"
          msgt=50
          sfx(27)
        end 
      end
    end
  end
  a=area[x+y*41]
  if a==1 then
    sfx(5)
    x=20
    y=37
    msg="walls are electrified!"
    sfx(5)
    shields-=1
    if (shields==0) gameover(1)
    msgt=50
    fl=0
    lockkey=50
  elseif a==4 then
    msg="front door is locked!"
    sfx(10)
    msgt=50
    x=x2
    y=y2
  elseif a==5 then
    if x==20 and y==0 then
      msg="it's just a locked window"
    else
      msg="it's just a sealed window"
    end
    sfx(10)
    msgt=50
    x=x2
    y=y2
  end  
  if a==6 then
    skipkey=1
    sfx(10)
  end
  if (x!=x2 or y!=y2) sfx(2)
  for i=0,12 do
    ix1=itmx[i] iy1=itmy[i]
    pal(5,0) pal(6,0) pal(7,0)
    spr3(itmx[i],itmy[i],26)     pal(5,5) pal(6,6) pal(7,7)
    if arrowkey==1 and i>0 and itmx[i]>0 and level<4 then
      for j=3,level*2 do
        r=fnr(4)
        ix2=ix1 iy2=iy1
        if (r==0) ix1-=1
        if (r==1) ix1+=1
        if (r==2) iy1-=1
        if (r==3) iy1+=1
        if area[ix1+iy1*41]>0 then
          ix1=ix2 iy1=iy2
        end
      end
      itmx[i]=ix1
      itmy[i]=iy1
    end
  end
until forever

end

