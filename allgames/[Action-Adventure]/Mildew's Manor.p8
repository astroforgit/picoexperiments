black()
area={}
prit(-1,121,"just a moment...",15)
rectx(0,0,40,38)
for i=0,38 do
  for j=0,40 do
    area[j+i*41]=0
    if i==0 or i==38 or j==0 or j==40 then
      area[j+i*41]=1
      if (i+j)%4==0 then
        area[j+i*41]=5
        rect(j*3+2,i*3+1,j*3+4,i*3+3,5)
        pset(j*3+3,i*3+2,0)
      end
    end
  end
end
area[20+38*41]=4
rectfill(20*3+2,38*3+1,20*3+4,38*3+3,4)
n=0
repeat
  repeat
    x1=fnr(19)*2+2 y1=fnr(18)*2+2
    x2=fnr(19)*2+2 y2=fnr(18)*2+2
  until x1!=x2 and y1!=y2 and abs(x1-x2)!=abs(y1-y2) and abs(x2-x1)>=3 and abs(y2-y1)>=3
  if (x1>x2) x1,x2=x2,x1
  if (y1>y2) y1,y2=y2,y1
  ok=0
  for i=y1,y2 do
    for j=x1,x2 do
      if (pget3(j,i)>0) goto no
    end
  end
  rectx(x1,y1,x2,y2,1)
  r=fnr(4)
  x=x1 y=y1
  if r<2 then
    x=fnrr(x1+1,x2-1)
    if (r==1) y=y2
    area[x+y*41]=6
    rectfill(x*3+2,y*3+1,x*3+4,y*3+3,0)
    line(x*3+2,y*3+2,x*3+4,y*3+2,6)
    pset(x*3+1,y*3+2,1)
    pset(x*3+5,y*3+2,1)
  else
    y=fnrr(y1+1,y2-1)
    if (r==3) x=x2
    area[x+y*41]=6
    rectfill(x*3+2,y*3+1,x*3+4,y*3+3,0)
    line(x*3+3,y*3+1,x*3+3,y*3+3,6)
    pset(x*3+3,y*3,1)
    pset(x*3+3,y*3+4,1)
  end
  n=0
::no::
  n+=1
until n>10000
pal(15,0,1)
for i=0,255 do
  x=i
  for j=0,119 do
    if pget(i,j)==1 then
      pset(i,j,8+((j+i)/4)%8)
