-- fancy select from menu
function menu(t)
local c,mh,mv,mx,my,m,n,mo
local x,y,mop=vlenx(t),0,{}
local rep,fra="",{0,2,8,9,0}
local ov=0
  nokey()
  repeat
    mop[y],t=yank(t)
    -- ^ thanks tyroney!
    y+=1
  until t==""
  mx=x*4+12
  my=y*10+8
  mh=63-mx/2
  mv=63-my/2
  y-=1
  for i=mv,mv+my do
    for j=mh,mh+mx do
      n=pget(j,i)+1
      rep=rep..sub(set,n,n)
      pset(j,i,7)
    end
  end
  for i=0,5 do
    rectfill(mh+i,mv+i,mh+mx-i,mv+my-i,fra[i+1])
  end
  c=10
  for i=0,y do
    print(mop[i],mh+7,mv+7+i*10,c)
    c=6
    if i==0 then
      m=#mop[0]
      for j=0,4 do
        for l=m*4-1,0,-1 do
          line(mh+7+l*2,mv+7+j,mh+7+l*2+1,mv+7+j,pget(mh+7+l,mv+7+j))
        end
      end
    end
  end
  v=1
  x=mx-12
  m=y
  enflag=1
  sfx(29) 
  repeat
    for i=0,1 do
      for j=0,6 do
        for l=0,mx-12 do
          x=mh+6+l
          y=mv+6+v*10+j
          pset(x,y,6-pget(x,y))
        end
      end
      if (i==0) getkey()
    end
    if (k=="l" or k=="u") v-=1
    if (k=="r" or k=="d") v+=1
    if (v!=ov) ov=v sfx(28) 
    v=wrap(v,1,m)
  until k=="a"
  x=1
  for i=mv,mv+my do
    for j=mh,mh+mx do
      n=instr(set,sub(rep,x,x))
      pset(j,i,n-1)
      x+=1
    end
  end
  k=sub(mop[v],1,1)
  enflag=0
  sfx(30)
  pause(10)
end--menu

-- retn comma delimited word #
function wordno(n,t)
local r
  n+=0 -- clumsy!
  if (t==nil) t=""
  if (n<0 or n>99) n=1
  while n>0 do
    r,t=yank(t)
    n-=1
  end--wend
  return r
end
--wordno

-- retn + remv val r*m of match
function yankrval(s,t,m)
local r,a,c,p=""
  p=instr(t,s)+3
  repeat
    r=r..sub(t,p,p)
    p+=1
    c=sub(t,p,p)
  until c<"0" or c>"9"
  t=replace(t,s..","..r,r*m)
  t=replace(t,s,r)
  return r*m,t
end--yankrval

-- yank comma delimited text
function yank(t)
local r
  if sub(t,#t,#t)!="," then
    t=t..","
  end
  r=sub(t,1,instr(t,",")-1)
  t=sub(t,instr(t,",")+1)
  return r,t
end

function vleny(t)
local r
  vlenyflag=1
  r=vlenx(t)
  vlenyflag=0
  return r
end

function vlenx(t)
local r,x,y,c=0,0,1
  r=0
  x=0
  for i=1,#t do
    c=sub(t,i,i)
    if c=="," then
      x=0 y+=1
    else
      x+=1
      if (y==1) x+=1
      if (r<x) r=x
    end
  end
  if vlenyflag==0 then
    return r
  else
    return y
  end
end

function pause(n)
local i
  for i=1,n*2 do
    flip()
  end
end

function gameover(n)
local t,i,j,l,f,p
  poke(0x5f41,0)
  mode=n
  pal(0,0)
  sfx(-1)
  nokey()
  if n==0 then
    sfx(11)
    pal(7,7)
    for i=1,128 do
      circfill(64,64,i,7)
      circfill(64,64,i-16,0)
      flip()
    end
    sfx(19) 
    bigmsg(win)
  elseif n==1 then
    sfx(17)
    bigmsg(wal)
  elseif n==2 then
    poke(0x5f41,1)
    cls()
    pal()
    sfx(20)
    f=0
    for i=1,3 do
      for j=0,i*3,.1 do
        cls()
        sspr(64,32,64,64,64-j,64-j,j*2,j*2,f)
        f=not(f)
        flip()
      end
      for j=i*3,0,-.05 do
        cls()
        sspr(64,32,64,64,64-j,64-j,j*2,j*2,f)
        f=not(f)
        flip()
      end
    end
    sfx(-1)
    for i=1,fnrr(75,225) do
      flip() -- wait for it!
    end
    p=0
    sfx(21)
    sfx(22)
    for j=16,256,2 do
      i=j
      if (i>64) i=64
      cls()
      sspr(64,32,64,64,64-i,64-i,i*2,i*2)
      for l=0,15 do
        if (p+l)/2%2==0 then
          pal(l,7,1)
        else
          pal(l,0,1)
        end
      end
      p+=1
      flip()
    end
    pal()
    sfx(-1)
    nokey()
    f=0
    repeat
      f=f+1
      if (f==8) pal(0,7,1)
      if (f==9) pal(0,0,1) f=0
      nano()
      flip()
    until k=="a"
    sfx(-1)
    poke(0x5f41,0)
    sfx(9)
    bigmsg(tim)
  end
  cls()
  pal()
  check4name()
end      

function check4name()
  minutes=flr(minutes)
  if (level==4) minutes=0
  score=0
  prit(-1,8,"-- adding up your score --",7)
  v=3
--avg. 11250 (level 3)
--avg. 14000 (level 4)
  if bottle==1 then
    addup(0,bottle,"bottle",5)
  end
  addup(1,ghosts,"ghosts",10)
  if mode==0 then
    addup(1,matches,"matches",25)
    addup(1,minutes,"minutes",50)
    addup(1,shields,"shields",100)
  end
  addup(0,gotkey,"brass key",250)
  if mode==0 then
    v+=1
    prit(-1,v*8,"escaped with your life!",7)
    v+=1
    sfx(6)
    s=500*level
    if (level==4) s=10000
    score+=s
    prit(-1,v*8,"big score bonus: "..s,12)
  end
  v+=2
  prit(-1,v*8,"total score: "..score,10)
  ok=0
  scr=decs(score,5)
  ok=0
  for i=0,9 do
    if scr>sub(hsc[i],1,5) then
      ok=1
    end
  end
  t="you did not make high score..."
  if ok==1 then
    t="you made high score!"
  end
  v+=1
  if (mode>0) v+=1
  prit(-1,v*8,t,7)
  getnokey()
  if ok==0 then
    poke(17152,255)
    run()
  end
  cls()
  if mode==0 then
    sfx(16)
  elseif mode==1 then
    sfx(13)
  else
    sfx(14)
  end
  poke(24364,3)
  pick=letr.." .<}"
  p=0
  n=""
  enflag=1
  repeat
    cls()
    spr(21+mode,30,52)
    print("enter name:",11,12,10)
    line(32,46,34,46)
    line(32,38,34,38)
    print(n.."_",32-#n*2,26,13)
    print(pick,32-p*4,40,7)
    flip()
    nano()
    if (k=="l") p-=1
    if (k=="r") p+=1
    if (k=="u" or p<0) p=0
    if (k=="d" or p>29) p=29
    if k=="b" or (k=="a" and p==28) then
      n=fnd(n)
      sfx(24)
    elseif k=="a" and #n<12 and p<28 then
      n=n..sub(pick,p+1,p+1)
      sfx(23)
    end 
  until k=="a" and p==29
  sfx(25)
  pause(20)
  cls()
  flip()
  poke(24364,0)
  hsc[10]=decs(score,5)..","..fnpad(n,12)
  repeat
    ok=1
    for i=0,9 do
      if hsc[i]<hsc[i+1] then
        hsc[i],hsc[i+1]=hsc[i+1],hsc[i]
        ok=0
      end
    end
  until ok==1
  for i=0,9 do
    for j=0,17 do
      poke(cad+i*18+j,instr(font,sub(hsc[i],j+1,j+1)))
    end
  end
  poke(17152,255)
  run()
end

function addup(typ,n,t,m)
local a="found"
  if (typ==1) a="saved"
  if (n==nil) n=0
  print("you "..a.." "..dec(n,2).." "..t..". "..n*m*level.." pts",2,v*8,6)
  pause(10)
  score+=n*m*level
  v+=1
end

function bigmsg(t)
local i,y=0,120
  cls()
  pal()
  t=decrypt(t)
  punkinbar(120)
  punkinbar(0)
  clip(0,8,128,111)
  pal(15,0,0)
  repeat
    rectfill(0,8,127,119,0)
    print(t,0,y,6)
    for i=0,16 do
      spr(7,i*8-y%8,8)
      spr(6,i*8-y%8,112)
    end
    nano()
    flip()
    y-=.15
    if (k=="b") y-=.85
  until k=="a"
  cls()
  pal()
end

function punkinbar(y)
local x,c
  for i=0,14 do
    x=i*8+4
    c=1
    if i<6 or i>7 then
      c=2
    elseif i==6 then
      c=0
    end
    spr(c,x,y)
  end
end

function nokey()
local i,n=0,0
  repeat
    for i=0,5 do
      btnl[i]=0
      btnd[i]=0
      if (btn(i)) n=0
    end
    n+=1
  until n==10
end

function spr3(x,y,n)
  spr(n,x*3+2,y*3+1)
end

function black()
local i
  for i=0,14 do
    pal(i,0,1)
  end
end

function rectx(a,b,c,d)
local i,j
  for i=b,d do
    for j=a,c do
      if i==b or i==d or j==a or j==c then
        area[j+i*41]=1
      end
    end
  end
  rect(a*3+2,b*3+1,c*3+4,d*3+3,1)
  rect(a*3+3,b*3+2,c*3+3,d*3+2,1)
  rect(a*3+4,b*3+3,c*3+2,d*3+1,1)
end

function pget3(x,y)
  return pget(x*3+3,y*3+2)
end

