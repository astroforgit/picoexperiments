local b={}
  b.x=fnr(128)
  b.y=-7
  b.ay=0
  b.spr={}
  add(l_rain,b)
end

function getnokey()
  nokey()
  getkey()
  nokey()
  k=""
end

function getkey()
  repeat
    flip()
    nano()
  until k>""
end

-- greatly reduced size of this!
-- yes, this an important
-- routine i use in all my
-- serious code for massive
-- and extensive key retrieval.
-- usage: call, returns k
function nano()
local ost,o={0,1,2,3,4,5}
  anykey=0 k="" arrowkey=0
  if wkf==1 then
    ost={2,3,0,1,4,5}
  end
  for i=0,5 do
    o=ost[i+1]
    if btn(o) then
      btnd[o]+=1
      btnl[o]=0
    else
      btnl[o]=btnd[o]
      btnd[o]=0
    end
    if o>3 then
      if ((btnd[o]>0 and enflag==0) or (enflag==1 and btnl[o]>0)) and k=="" then
        if (o==4) k="a"
        if (o==5) k="b"
      end
    elseif ((btnd[o]%4==1 and enflag==0) or ((btnd[o]%4==1 or btnd[o]>16) and enflag==1)) and k=="" then
      if (o==0) k="l"
      if (o==1) k="r"
      if (o==2) k="u"
      if (o==3) k="d"
      if (k>"") arrowkey=1
    end
    if enflag==1 and btnd[4]*btnd[5]>0 then
      k="ab"
    end
  end
  if (k=="l" or k=="r") wkf=1
  if (k=="u" or k=="d") wkf=0
  if lockkey>0 then
    lockkey-=1
    k=""
  end
end

function prit(x,y,t,c)
  if (x<0) x=64-#t*2
  if (y<0) y=61
  print(t,x,y,c)
end

-- verify centers w 9-dots
function verify()
local n=0
  for i=0,127,15.875 do
    for j=0,127,15.875 do
      pset(j,i,1)
      if (n==40) pset(j,i,7)
      n+=1
    end
  end
end

-- convert str back to mem loc
-- warning, a little slow since
-- pico does not provide
-- internal instr() routine
function str2mem(t,m)
local b1,b2,c,n,p=0,0,0,0,1
  repeat
    if b1==0 then
      n=instr(set,fnc(t,p))-1
    end
    if bttst(n,b1)==1 then
      c+=2^b2
    end
    b1+=1
    if (b1==5) b1=0 p+=1
    b2+=1
    if b2==8 or p>#t then
      pset(rnd(128),rnd(128),8)
      poke(m,c)
      b2=0 c=0 m+=1
    end
  until p>#t
end--str2mem

-- decrypt encrypted text
function decrypt(t)
local i,c,p,r=0,0,0,""
  srand(17)
  for i=1,#t do
    c=fnc(t,i)
    p=instr(letr,c)-1
    if p>=0 then
      p-=fnrr(1,25)
      if (p<0) p+=26
      c=fnc(letr,p+1)
    end
    r=r..c
  end
  srand(time())
  return r
end--decrypt

-- replace str a of b with c
function replace(a,b,c)
local i,r=1,""
  if (a==nil or a=="") return a
  if (b==nil or b=="") return a
  if (c==nil or c=="") return a
  repeat
    if instr(sub(a,i,i+#b-1),b)>0 then
      r=r..c
      i+=#b-1
    else
      r=r..sub(a,i,i)
    end
    i+=1
  until i>#a
  return r
end--replace
  
-- return pos # of str b in a
function instr(a,b)
local i,r=0
  if (a==nil or a=="" or b==nil or b=="") return 0
  for i=1,#a-#b+1 do
    if (sub(a,i,i+#b-1)==b) return i
  end
  return 0
end--instr

-- return string minus end char
function fnd(a)
  return sub(a,1,#a-1)
end--fnd

-- fnc: return single character
function fnc(a,b)
local r=sub(a,b,b)
  if (r==nil or r=="") r=" "
  return r
end--fnc(..)

-- return space padded string
function fnpad(a,b)
local r
  r=a
  for i=1,b-#a do
    r=r.." "
  end
  return sub(r,1,b)
end--fnpad

-- return space padded number
function decs(a,b)
local c
  c=""..a
  while #c<b do
    c=" "..c
  end
  return c
end--decs

-- return zero padded number
function dec(a,b)
  if (a==nil) a=""
  a=a..""
  while #a<b do
    a="0"..a
  end
  return a
end--dec

-- wrap number a around b + c
function wrap(a,b,c)
  if (b>c) b,c=c,b
  repeat
    if (a<b) a+=c-b+1
    if (a>c) a-=c-b+1
  until a>=b and a<=c
  return a
end

-- bit test (number,bit)
function bttst(a,b)
local r=0
  if (band(a,2^b)>0) r=1
  return r
end--bttst

-- random # from 0 to a-1
function fnr(a)
  return flr(rnd(a))
end--fnr

-- get random # from a to b
function fnrr(a,b)
  if (a>b) a,b=b,a
  return a+flr(rnd(b-a+1))
end--fnrr

main() -- allow at top
