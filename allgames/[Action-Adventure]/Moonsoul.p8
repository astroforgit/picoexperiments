pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--moonsoul
--v1.1
--by remagamer

function _init() 
 --init stuff
 
 --menu items
  
 --menuitem(1,"camera",cameraswap)
 menuitem(1,"debug",debugger)
 menuitem(2,"corrupt",corruptor)
 
 
 entlist={} --the entitylist
 initkeys() --set up keys
 pl={x=192,y=192,vx=0,vy=0,inv=0,cld=0,cx=64,cy=64,spx=192,spy=192,t=0,k=0,l=0,ph=0,win=0} --player
 cam={x=64,y=64,vx=0,vy=0,t=-1} --the camera
  
 mode=0 --modes
 --0 is title
 --1 is game
 --2 is end1 - bad
 --3 is end2 - good

 
 --debug
 debug=-1
 --corrupt
 corrupted=-1
 
end

function _update60()
 --update stuff
 
 if mode==0 then
  --title update
  
  --add entities
  for i=1,6 do
   addwisp(rnd(32)+28,32+rnd(24),0,0)
  end
  //for i=1,3 do
   //addwisp(rnd(127),200,0,3)
  //end
  --update entities
  entupdate()
  --check for inputs
  if btn(4) then
   mode=1
  end
  
 end
 
 if mode==1 then
  --game update
  
  --update player
  plupdate()
  --update entities
  entupdate()
  --update camera
  camupdate()
  --update debug
  if debug==1 then
   debugmove()
  end
 end
 
 if mode==2 then
  --end1 update
 
  addwisp(60,45,0,0)
  --update entities
  entupdate()
  
 end
 
 if mode==3 then
  --end2 update
  
  for i=1,6 do
   addwisp(rnd(32)+44,25+rnd(32),0,0)
  end
  --update entities
  entupdate()
 end
 
 --corruptor
 if corrupted==1 then
  corrupt()
 end
  
end

function _draw()
 --draw stuff
 
 --clean the screen
 cls()
 camera()
 
 if mode==0 then
  --title draw
  
  --bg
  rectfill(0,0,127,127,1)
  --entities
  entdraw()
  --title sprite
  spr(64,32,32,8,4)
  --prompt
  print2("press ",48,66)
  --credit
  print2("remagamer,2018",0,123)
  --version
  print2("v1.1",113,123)  
 end
 
 if mode==1 then
  --game draw
  
  --camera
  camera(cam.x-64,cam.y-64)
  --draw the map
  map(0,0,0,0,128,64)
  --draw the entities
  entdraw()
  --draw the player
  circfill(pl.x+4,pl.y+4,2,7)
  if pl.inv>0 then
   circ(pl.x+4,pl.y+4,rnd(3),8+rnd(3))
  end
  --draw the second map
  map(0,0,0,0,128,64,2)
  --draw the ui
  drawui()
  --draw debug
  if debug==1 then
   debugui()
  end
 
 end
 
 if mode==2 then
  --end1 draw
  
  --bg
  rectfill(0,0,127,127,1)
  --entities
  entdraw()
  --sprite
  spr(76,60,45)
  --endtext
  print2("freedom at last",34,64)
  --final stats
  print2("time:"..flr(pl.t).."\nkeys:"..pl.k.."\ndeaths:"..pl.l,6,101)
  --thanks
  print2("another path awaits...",6,121)
  
 end
 
 if mode==3 then
  --end2 draw
  
  --bg
  rectfill(0,0,127,127,1)
  --entities
  entdraw()
  --sprite
  spr(72,48,30,4,4)
  --endtext
  print2("whole again",42,64)
  --final stats
  print2("time:"..flr(pl.t).."\nkeys:"..pl.k.."\ndeaths:"..pl.l,6,101)
  --thanks
  print2("thanks for playing my game :)",6,121)
  
 end
 
 
 
end
-->8
--player functions 

function plupdate()
 --this function handles all
 --of the player's logic.
 
 --tick up timer
 pl.t+=1/60
 
 --check for specialty tiles
 
 --goal
 if fmget(pl.x,pl.y,7)==true and pl.win==0 then
  addshine()
  pl.win=1
 end
 --checkpoint
 if fmget(pl.x,pl.y,3)==true then
  pl.spx=pl.x
  pl.spy=pl.y
  addwisp(pl.x+rnd(32)-16,pl.y+rnd(32)-16,0,0)
 end
 --fatality
 if fmget(pl.x,pl.y,4)==true and pl.inv<=0 then
  pl.x=pl.spx
  pl.y=pl.spy
  pl.vx=0
  pl.vy=0
  addpain(pl.x+3,pl.y+3)
  pl.l+=1
 end
 --fall
 if fmget(pl.x,pl.y,5)==true then
  if pl.vy<-2 then
   pl.vy=-2
  end
  pl.vy+=.2
 end
 
 --cool down dash.
 if pl.cld>0 then
 pl.cld-=1
 end
 --tick down invincibility.
 if pl.inv>0 then
 pl.inv-=1
 end
 --take inputs.
 if btn(0) then
  pl.vx-=.1
 end
 if btn(1) then
  pl.vx+=.1
 end
 if btn(2) then
  pl.vy-=.1
 end
 if btn(3) then
  pl.vy+=.1
 end
 if btn(4) and pl.cld<=0 then
  pl.vx*=3
  pl.vy*=3
  pl.cld=60
  pl.inv=30
  for i=1,10 do
   adddasher(pl.x,pl.y)
  end
 end
 --degrade velocity.
 pl.vx/=1.05
 pl.vy/=1.05
 if pl.vx>=7 then
  pl.vx=7
 end
 if pl.vx<=-7 then
  pl.vx=-7
 end
 if pl.vy>=7 then
  pl.vy=7
 end
 if pl.vy<=-7 then
  pl.vy=-7
 end
 --create wisps.
 addwisp(pl.x,pl.y,pl.vx,pl.vy)
 --create dashers.
 if pl.inv>0 then
  adddasher(pl.x,pl.y)
 end
 --apply velocity.
 if fmget(pl.x+pl.vx,pl.y,0)==false then
  pl.x+=pl.vx
 else
  --breakables
  if fmget(pl.x+pl.vx,pl.y,2)==true and pl.inv>0 then
   mset((pl.x+4+pl.vx)/8,(pl.y+4)/8,0)
   for i=1,10 do
    adddebris(pl.x,pl.y)
   end
  else
   --locks
   if fmget(pl.x+pl.vx,pl.y,6)==true and pl.k>0 then
    mset((pl.x+4+pl.vx)/8,(pl.y+4)/8,0)
    mset((pl.x+4+pl.vx-8)/8,(pl.y+4)/8,0)
    mset((pl.x+4+pl.vx+8)/8,(pl.y+4)/8,0)
    pl.k-=1
   else
    pl.vx*=-.5
   end
  end
 end
 
 if fmget(pl.x,pl.y+pl.vy,0)==false then
  pl.y+=pl.vy
 else
  --breakables
  if fmget(pl.x,pl.y+pl.vy,2)==true and pl.inv>0 then
   mset((pl.x+4)/8,(pl.y+4+pl.vy)/8,0)
   for i=1,10 do
    adddebris(pl.x,pl.y)
   end
  else
   --locks
   if fmget(pl.x,pl.y+pl.vy,6)==true and pl.k>0 then
    mset((pl.x+4)/8,(pl.y+4+pl.vy)/8,0)
    mset((pl.x+4+8)/8,(pl.y+4+pl.vy)/8,0)
    mset((pl.x+4-8)/8,(pl.y+4+pl.vy)/8,0)
    pl.k-=1
   else
    pl.vy*=-.5
   end
  end
 end
 
end
-->8
--general functions

function fmget(x,y,f)
 --this function is a simplified
 --tile checker.
 return fget(mget((x+4)/8,(y+4)/8),f)
end

function debugui()
 --useful debug displays.

 --draws debug stats
 print2("fps:"..stat(7).." cpu:"..flr(100*stat(1)).."%",cam.x-62,cam.y+57,7)
 print2("x:"..flr(pl.x).." y:"..flr(pl.y),cam.x-62,cam.y+51)
 print2("cx:"..flr((pl.x+4)/8) .." cy:"..flr((pl.y+4)/8),cam.x-62,cam.y+45)
 print2("vx:"..pl.vx.." vy:"..pl.vy,cam.x-62,cam.y+39)
 
end

function debugger()
 --this function turns on and off
 --the debug stuff.
 --that's it :)
 debug=debug*-1
end

function cameraswap()
 --this function switches between
 --the camera modes.
 --that's it :)
 cam.t=cam.t*-1
end

function print2(text,x,y)
 --simplification of an outline
 --effect.
 print(text,x+1,y,0)
 print(text,x-1,y,0)
 print(text,x,y+1,0)
 print(text,x,y-1,0)
 print(text,x+1,y+1,0)
 print(text,x-1,y-1,0)
 print(text,x+1,y-1,0)
 print(text,x-1,y+1,0)
 print(text,x,y,7)
end

function camupdate()
 --this function controls the
 --camera.
 
 --absolute cam.
 if cam.t==-1 then
  cam.x=pl.x
  cam.y=pl.y
 end
 --dynamic cam.
 if cam.t==1 then
  if pl.x>cam.x then 
   cam.vx+=.2
  end
  if pl.x<cam.x then
   cam.vx-=.2
  end
  if pl.y>cam.y then
   cam.vy+=.2
  end
  if pl.y<cam.y then
   cam.vy-=.2
  end
  --stabilize.
  cam.vx/=1.05
  cam.vy/=1.05
  if flr(cam.x)==flr(pl.x) then
   cam.vx=0
  end
  if flr(cam.y)==flr(pl.y) then
   cam.vy=0
  end
  --apply.
  cam.x+=cam.vx
  cam.y+=cam.vy
 end
 
end

function drawui()
 --this function draws ui.
 print2("“"..flr(pl.t).."\n…"..pl.k.."\n†"..pl.l,cam.x-63,cam.y-62)
end

function cld(v)
 --this function returns the
 --tile that the xy coords
 --fall under. for collisions.
 return flr((4+v)/8)*8
end

function debugmove()
 --lets you use debug movement
 --and perma-invulnerability.
 --uses 2p controller.
 if btn(0,1) then
  pl.x-=2
  pl.inv=2
  pl.vx=0
 end
 if btn(1,1) then
  pl.x+=2
  pl.inv=2
  pl.vx=0
 end
 if btn(2,1) then
  pl.y-=2
  pl.inv=2
  pl.vy=0
 end
 if btn(3,1) then
  pl.y+=2
  pl.inv=2
  pl.vy=0
 end
end

function initkeys()
 --initializes the key positions
 --and the teleport position.
 addkey(192,320)
 addkey(336,320)
 addkey(608,480)
 addkey(576,400)
 addwarp(992,472,244,488)
end

function corrupt()
 --this function corrupts
 --the game.
 for i=1,5 do
  poke(rnd(0x8000),rnd(0x100))
 end
end

function corruptor()
 --this function flips the
 --corrupt thing on and off.
 corrupted*=-1
end
-->8
--entity add functions

function addwisp(x,y,vx,vy)
 --places a wisp.
 add(entlist,{n="wisp",x=x+rnd(2)-1,y=y+rnd(2)-1,vx=vx*-1+rnd(1)-.5,vy=vy*-1+rnd(1)-.5,lt=60,s=3,c=rnd(2)+5})
end

function adddasher(x,y)
 --places a dasher.
 add(entlist,{n="dasher",x=x,y=y,lt=30,s=3,c=8+rnd(3)})
end

function adddebris(x,y)
 --places a debris.
 add(entlist,{n="debris",x=x,y=y,vy=-rnd(3),vx=rnd(3)-1.5,lt=30})
end

function addpain(x,y)
 --places a pain.
 add(entlist,{n="pain",x=x,y=y,s=32})
end

function addkey(x,y)
 --places a key.
 add(entlist,{n="key",x=x,y=y,oy=y,sn=0})
end

function addwarp(x,y,dx,dy)
 --places a warp.
 add(entlist,{n="warp",x=x,y=y,oy=y,sn=0,dx=dx,dy=dy})
end

function addshine()
 --places a pain.
 add(entlist,{n="shine",s=0})
end
-->8
--entity list functions

function entupdate()
 --this function updates the entityl ist.
 
 for i in all(entlist) do
 
 --wisp
 if i.n=="wisp" then
  --tick down stuff
  i.lt-=1
  i.s-=.05
  if i.lt<=0 then
   del(entlist,i)
  end
  --move
  i.x+=i.vx
  i.y+=i.vy
  --degrade
  i.vx/=1.01
  i.vy/=1.01
 end
 
 --dasher
 if i.n=="dasher" then
  --tick down stuff
  i.lt-=1
  i.s-=.05
  if i.lt<=0 then
   del(entlist,i)
  end
  --move
  i.x+=rnd(2)-1
  i.y+=rnd(2)-1
 end
 
 if i.n=="debris" then
  --tick down stuff
  i.lt-=1
  if i.lt<=0 then
   del(entlist,i)
  end
  --move
  i.x+=i.vx
  i.y+=i.vy
  --degrade
  i.vx/=1.01
  i.vy+=.2
 end
 
 if i.n=="pain" then
  --tick down size
  i.s-=2
  if i.s<=0 then
   del(entlist,i)
  end
 end
 
 if i.n=="key" then
  --sine
  i.sn+=.005
  if i.sn>=1 then
   i.sn=0
  end
  --apply position
  i.y=i.oy+3*sin(i.sn)
  --effect
  if rnd(3)>2.5 then
   addwisp(i.x,i.y,0,1)
  end
  --check for grab
  if cld(pl.x)==cld(i.x) and cld(pl.y)==cld(i.y) then
   pl.k+=1
   del(entlist,i)
  end
 end

 if i.n=="warp" then
  --sine
  i.sn+=.005
  if i.sn>=1 then
   i.sn=0
  end
  --apply position
  i.y=i.oy+3*sin(i.sn)
  --effect
  adddasher(i.x,i.y)
  --check for grab
  if cld(pl.x)==cld(i.x) and cld(pl.y)==cld(i.y) then
   pl.x=i.dx
   pl.y=i.dy
   pl.spx=i.dx
   pl.spy=i.dy
   addpain(pl.x,pl.y)
   pl.ph=1
   del(entlist,i)
  end
 end
 
 if i.n=="shine" then
  --tick up size
  i.s+=2
  if i.s>=150 then
   del(entlist,i)
   --victory phasing
   if pl.ph==1 then
    mode=3
   else
    mode=2
   end
  end
 end
  
 --end of for loop
 end
end

function entdraw()
 --this function draws the entity list.
 
 for i in all(entlist) do
  
  --wisp
  if i.n=="wisp" then
   circ(i.x+4,i.y+4,i.s,i.c)
  end
  
  if i.n=="dasher" then
   circ(i.x+4,i.y+4,i.s,i.c)
  end
  
  if i.n=="debris" then
   rectfill(i.x,i.y,i.x+1,i.y+1,7)
  end
  
  if i.n=="pain" then
   circfill(i.x,i.y,i.s,10)
  end
  
  if i.n=="key" then
   spr(56,i.x,i.y)
  end
  
  if i.n=="warp" then
   circfill(i.x+4,i.y+4,rnd(5)+1,10)
  end
  
  if i.n=="shine" then
   circfill(pl.x,pl.y,i.s,7)
  end
  
  --end of for loop
 end
end
