pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
---happy birthday brianna
--gravitoid
--finished 5/11/2020
--music by gruber

--variables
state="start"
function _init()
		init[state]()
end

function _update()
	update[state]()
end

function _draw()
palt(0,false)
palt(5,true)
		draw[state]()
end
-->8
--state system test
init={}
update={}
draw={}

init["start"]=function ()
	
end
update["start"]=function ()
	for i=0,8 do
		if (btn(4,i) or btn(5,i)) state="game" _init()
	end
end
draw["start"]=function ()
	cls()
	print("you arrive home...",10,10,12)
	if (time()*3%3>1) print("press x",50,58,7)
end



-->8
--game functions

init["game"]=function()
 x=22*8 
 y=16*8
 fx=-1 fy=0
 spx=48 spy=16
 ticker=0
 canmove=true
 flipped=false
 outside=true
 --text stuff
 triggers={}
 --exterior dialogues
 text1={x=176,y=128,w=16*4,h=16*3,text="dude, where's my car?", finite=false,canskip=true}
 add(triggers,text1)
 text2={x=176,y=56,w=16*3,h=16*3,text="hey, it's johnny's garden", finite=false,canskip=true}
 add(triggers,text2)
 text3={x=0,y=0,w=16,h=200,text="i should probs go in the house", finite=false,canskip=true}
 add(triggers,text3)
 text4={x=128,y=64,w=24,h=16*4,text="looks like steven got his car", finite=false,canskip=true}
 add(triggers,text4)
 text5={x=128,y=24,w=16,h=16,text="i don't need no damn tools now", finite=false,canskip=true}
 add(triggers,text5)
 --interior dialogues
 text6={x=440,y=224,w=16,h=32,text="it's quiet in here",finite=false,canskip=false}
 add(triggers,text6)
 text7={x=408,y=160,w=16,h=16,text="johnny's not in here right now",finite=false,canskip=true}
 add(triggers,text7)
 text8={x=504,y=232,w=32,h=16,text="no time for the piano",finite=false,canskip=true}
 add(triggers,text8)
 text9={x=424,y=120,w=16,h=32,text="alas, i must poop",finite=false,canskip=true}
 add(triggers,text9)
 text10={x=496,y=184,w=32,h=32,text="smells like someone was baking",finite=false,canskip=true}
 add(triggers,text10)
 text11={x=464,y=72,w=64,h=32,text="where is everyone?",finite=true,canskip=false}
 add(triggers,text11)
 --upstairs
 text12={x=616,y=32,w=32,h=64,text="wow, jay's room is so tidy!",finite=false,canskip=true}
 add(triggers,text12)
 text13={x=744,y=8,w=16,h=16,text="i can see uranus from here, heh",finite=false,canskip=true}
 add(triggers,text13)
 text14={x=744,y=56,w=32,h=16,text="there's a note on the table?",finite=false,canskip=true}
 add(triggers,text14)
 text14={x=776,y=16,w=16,h=16,text="brianna, come downstairs please",finite=true,canskip=true}
 add(triggers,text14)
 --text and trigger data
 showbtn=false
 showtext=false
 textboxy=128
 curtext=-1
 textstall=0
 inbox=false
 readtext=true
 textsize=0
 curchar=0
 --cam position
 camx=x-64 camy=y-64
 --debug text
 debug=""
 
 --music
 playmusic=false
 --story
 foundnote=false
 family={}
 endgame=false
 sang=false
 tally=0
end
update["game"]=function()
 --controls
 if canmove and readtext then
  ticker=0
  if (btn(‹)) spx=48 spy=16
  if (btn(‘)) spx=48 spy=16
  if (btn(”)) spx=48 spy=32 
  if (btn(ƒ)) spx=48 spy=00 
  if (btn(‹) and fget(mget(x/8-1,y/8))!=1 and fget(mget(x/8-1,y/8+1))!=1) fx=-1 fy=00 canmove=false
  if (btn(‘) and fget(mget(x/8+2,y/8))!=1 and fget(mget(x/8+2,y/8+1))!=1) fx=01 fy=00 canmove=false
  if (btn(”) and fget(mget(x/8,y/8-1))!=1 and fget(mget(x/8+1,y/8-1))!=1) fx=00 fy=-1 canmove=false
  if (btn(ƒ) and fget(mget(x/8,y/8+2))!=1 and fget(mget(x/8+1,y/8+2))!=1) fx=00 fy=01 canmove=false
 	--outdoor bounds
 	if outside then
 	 if (x==0 and fx==-1) fx=00 fy=00 canmove=true
 	 if (x==224 and fx==01) fx=00 fy=00 canmove=true
 	end
 end
 	
 	--detect dialogue triggers
 	inbox=false
 	for t in all(triggers) do
 	 if t.name!=nil then
 	  inbox=aminbox(x,y+8,t.x-8,t.y,32,16)
   else
 	  inbox=aminbox(x,y+8,t.x,t.y,t.w,t.h)
   end
   if inbox then
    curtext=t
    textsize=#t.text
    debug=textsize
    break
   end
 	end
 	
  --text update shit
  if inbox then
   if (textboxy>112) textboxy-=1
   if (flr(textboxy)==112 and not showtext) showbtn=true
   if (showbtn and (btnp(—) or btnp(Ž))) showbtn=false showtext=true readtext=false

  end
  if not inbox then
   textboxy=128
   showbtn=false
   showtext=false
   if curtext.finite and textsize==31 then
    mset(98,01,207)
    foundnote=true
    del(triggers,curtext)
    for tx=56,65 do
    for ty=03,11 do
     if mget(tx,ty)==62 then
     if (sin(tx/ty)>0.1) mset(tx,ty,12)
     if (sin(tx/ty)>0.3) mset(tx,ty,13)
     if (sin(tx/ty)>0.6) mset(tx,ty,28)
     if (sin(tx/ty)>0.8) mset(tx,ty,29)
     end
    end
    end
    mset(62,4,52)
    mset(63,4,53)
    --make family appear
    local john={talkedto=false,x=480,y=16,w=32,h=24,spx=16,spy=16,name="john",text="happy birthday, bri-bri!"}
    add(family,john)
    add(triggers,john)
    local jay={talkedto=false,x=512,y=72,w=32,h=24,spx=16,spy=0,name="jay",text="happy birthday, mommy!"}
    add(family,jay)
    add(triggers,jay)
    local kathie={talkedto=false,x=512,y=32,w=32,h=24,spx=80,spy=0,name="kathie",text="happy birthday, hun‡"}
    add(family,kathie)
    add(triggers,kathie)
    --make ground blocked where they stand
      mset(john.x/8,john.y/8,36)
       mset(jay.x/8,jay.y/8,36)
    mset(kathie.x/8,kathie.y/8,36)
   end
   if curtext.finite and (textsize==18 or textsize==28) then
    del(triggers,curtext)
   end
  end
 
 
 --moving character
 if not canmove then
  x+=fx*1
  y+=fy*1
  ticker+=1
  if ticker%5==0 then
   sfx(10)
  end
  if x%8==0 and y%8==0 then
   canmove=true
  end
 end
 
 --camera stuff
 if outside then
  if (x>64 and x<176) camx=x-64
  if (y>64 and y<128) camy=y-64
 end
 if not outside then
  if not playmusic then
   music(1)
   playmusic=true
  end
  camx=x-64
  camy=y-64
 end
 
 --door hit
 if x==64 and y==32 then
  outside=false
  x=55*8 y=29*8
 elseif x==55*8 and y==30*8 then
  outside=true
  x=64 y=32
  camx=x-64
  camy=0
 elseif x==464 and y==96 then
  x=696 y=80
  camx=x-64
  camy=y-64
 elseif x==704 and y==80 then
  x=472 y=96
  camx=x-64
  camy=y-64
  if (foundnote) music(09) sang=true
 end
end

frames={0,0,0,0,}
draw["game"]=function()
 cls(0)
 camera(camx,camy)
 map(0,0)
 --family
 if #family>0 then
  for f in all(family) do
   if f.name=="kathie" or f.name=="john" then
    sspr(f.spx,f.spy,16,16,f.x,f.y)
   end
   if f.name=="jay" then
    local tfactor=flr(time()*2)%2
    if (tfactor==1) circfill(f.x+8,f.y+12,3,0)
    sspr(f.spx+tfactor*16,f.spy,16,16,f.x,f.y-tfactor*8)
   end
  end
 end
	
 --animate brianna
 if fx!=0 then --did
  frames[1]=48 frames[2]=64
  frames[3]=80 frames[4]=64
 elseif fy==01 then --did
  frames[1]=48 frames[2]=64
  frames[3]=48 frames[4]=64
 elseif fy==-1 then
  frames[1]=48 frames[2]=64
  frames[3]=48 frames[4]=64
 end
 local frame=flr((ticker/16)*4)+1
 spx=frames[frame]
 if (fy!=0 and (frame==3 or frame==4)) or fx==1 then flipped=true
 else flipped=false end
 sspr(spx,spy,16,16,x,y,16,16,flipped)

 --
	camera()
	
	--print text
	rectfill(0,textboxy,128,128,7)
	rect(0,textboxy,127,127,0)
	if showbtn then
	 if (time()*3%3>1) then
	  print("press x",48,116, 0)
	 end
	end
	--print text out
	local lastchar=flr(curchar)
	if showtext and not readtext then
	 print(sub(curtext.text,1,flr(curchar)),4,115,0)
	 curchar+=0.5
	 if (lastchar!=flr(curchar)) sfx(0)
	 if (flr(curchar)==textsize+2) readtext=true curchar=1
	 --if (btn(—) or btn(Ž)) curchar+=1
	end
	if showtext and readtext then
	 print(curtext.text,4,115,0)
	 curchar=1
	end
	--debug
	--rectfill(1,1,30,20,7)
	--print(x..","..y,2,2,0)
	--print(debug,2,15,8)
end

-->8
--helper functions

function aminbox(x1,y1,bx,by,w,h)
 if x1>=bx and x1<=bx+w then
	 if y1>=by and y1<=by+h then
	  return true
	 end 
 end
 return false
end
-->8

init["end"]=function ()
	pos=136
	spd=1
end
update["end"]=function ()
 if pos<20 then
  pos-=spd
 end
end
draw["end"]=function ()
 rectfill(20,pos,108,128,0)
 print("happy birthday, brianna‡",20,pos,8)
 print("hope you liked my little game",20,pos+30,8)
 print("this game was made by jack",20,pos+50,8)
 print("for my sister's birthday",20,pos+60,8)
 print("music by: gruber",20,pos+80,8)
end
