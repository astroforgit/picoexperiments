pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
lvl=0

function _init()
	poke(0x5f2d, 1)
	copym()
	camx=pl.x-64
	camy=pl.y-64
	map_enm()
	map_flw()
	music(8)
end

prt=0
prts=0
sgf=0
function _draw()
	cls()
	pal()
	if dttl==false and sgf<15 then
		sgf+=1
		pfade(sgf)
	end
	camx=mid(camx,0,16*8)
	camy=mid(camy,0,16*8)
	camera(camx,camy)
	dbg()
	map()


	d_flw()
	d_enm()
	d_pl()
	d_p()
	if lvl!=4 then
		rectfill(camx,camy+1,camx+14,camy+7,0)
		spr(4,camx,camy)
		print(count(flw),camx+7,camy+2,7)
	else
			map(32,56,0,32*8-camy/1.5,32,16)
			rectfill(0,40*8-camy/1.5,32*8,40*8,3)
	end
	d_win()
	m=mouse()
	pal()
	for i=-6,6 do
		circfill(m.x+cos(prt/10)*i,m.y+sin(prt/10)*i,3,7)
	end
	for i=-6,6 do
		circfill(m.x+cos(prt/10)*i,m.y+sin(prt/10)*i,1,13)
	end
	circfill(m.x,m.y,4,7)
	circfill(m.x,m.y,2,13)
	d_title()
end

function _update60()
	if dttl==false then
	u_pl()
	u_enm()
	if m.b==1 then
		prts=min(1,prts+.2)
		prt+=prts
	else
		prts=max(prts-0.05,0.05)
		prt+=prts
	end
	end
end
-->8
plst={
{64,24*8},
{60,27*8},
{64,24*8},
{40,27*8},
{15*8,27*8}
}

blw={}
pl={}
pl.x=plst[lvl+1][1]
pl.y=plst[lvl+1][2]
pl.xs=0
pl.ys=0
pl.sz=5
add(blw,pl)
pl.st={}

for i=1,pl.sz*3 do
	s={}
	s.x=pl.x
	s.y=pl.y
	s.ys=0
	s.xs=0
	add(pl.st,s)
end


hbc=16
function u_pl()
	function die()
		if dead==false then
		deaths+=1
		sfx(24)
		for i=1,6 do
			cls(0)
			--pal(7,7)
			pal(12,7)
			d_pl()
			flip()
		end
		dead=true
		mptc(pl.x,pl.y,12) 
		sfx(23)

		end
	end
	if dead==false then
		hbc=pl.sz*3
		pl.ys+=0.01
		if pl.ys<=0 and win==false then
			pl.ys*=0.97
		end
		pl.xs*=0.97
		u_bl(pl,32)
		pl.x+=pl.xs
		pl.y+=pl.ys
		if win==false then
			for i=0,hbc-1 do
				local c={}
				c.x=pl.x+cos(i/hbc)*pl.sz
				c.y=pl.y+sin(i/hbc)*pl.sz
				local mg=mget(c.x/8,c.y/8)
				local fg=fget(mg,0)
				if fg then
					pl.xs-=cos(i/hbc)/2
					pl.ys-=sin(i/hbc)/2
					sfx(8)
				end
				if mg==20 and c.y%8>=5 and pl.ys>0 then
					die()
				end
				if mg==21 and c.y%8<=3 and pl.ys<0 then
					die()
				end
				if mg==36 and c.x%8>=5 and pl.xs>0 then
					die()			
				end
				if mg==37 and c.x%8<=3 and pl.xs<0 then
					die()		
				end
			end
		end
		if dist(camx+64,camy+64,pl.x,pl.y)>24 and win==false then
			local camd=atan2(camx+64-pl.x,camy+64-pl.y)
			camx=pl.x-64+cos(camd)*24
			camy=pl.y-64+sin(camd)*24
		end
		pl.st[1].x=pl.x+cos(-pl.xs/8-1/4)*(pl.sz+1)
		pl.st[1].y=pl.y+sin(-pl.xs/8-1/4)*(pl.sz+1)
		for i=2,count(pl.st) do
			s=pl.st[i]
			s2=pl.st[i-1]
			s.ys+=0.015
			s.y+=s.ys
			s.x+=s.xs
			if dist(s.x,s.y,s2.x,s2.y)>1 then
				local dd=atan2(s.x-s2.x,s.y-s2.y)
				s.x=s2.x+cos(dd)
				s.xs-=cos(dd)/(i*4)/2
				s.y=s2.y+sin(dd)
				s.ys-=sin(dd)/(i*4)
			end
		end
		for f in all(flw) do
			local fd=dist(f.x+4,f.y+4,pl.x,pl.y)
			if fd<pl.sz+12 then
				local dd=atan2(f.x-pl.x,f.y-pl.y)
				f.x-=cos(dd)
				f.y-=sin(dd)
			end	

			if fd<pl.sz+4 then
				if f.t==3 then
					pl.sz+=1
				end
				del(flw,f)
				sfx(9)
			end
		end
	end
end

function d_pl()
	if dead==false then
	circfill(pl.x,pl.y,pl.sz+2,7)
	circfill(pl.x,pl.y,pl.sz,12)
	for s in all(pl.st) do
		circfill(s.x,s.y,1,7)
	end
	end
end
-->8
function mouse()
	local m={}
	m.x=stat(32)+camx
	m.y=stat(33)+camy
	m.b=stat(34)
	return m
end

function dist(x1,y1,x2,y2)
	local dx=abs(x1-x2)
	local dy=abs(y1-y2)
	if dx>80 or dy>80 then
		return 100
	end
	return sqrt(dx^2+dy^2)
end


function copym()
	local lvx=lvl*32
	local lvy=0
	if lvl==4 then
		lvy=32
		lvx=0
	end
	for x1=lvx,lvx+31 do
		for y1=lvy,lvy+31 do
			mset(x1%32,y1%32,mget(x1,y1))
		end
	end
end

function u_bl(b,d)
			local m=mouse()
		md=atan2(b.x-m.x,b.y-m.y)
		local ms=dist(m.x,m.y,b.x,b.y)
		if m.b>0 and ms<d then
			ms=mid(ms,20,5)
			b.xs+=cos(md)/ms
			b.ys+=sin(md)/ms
		end
		if dist(b.xs,b.ys,0,0)>1 then
			local sd=atan2(b.xs,b.ys)
			b.xs=cos(sd)
			b.ys=sin(sd)
		end
end

function pfade(n)
	pal()
	for i=0,15 do
		pal(i,sget(112+mid(n,0,15),31+i))
	end
end
-->8
enm={}

function m_enm(x,y,t)
	e={}
	e.x=x
	e.y=y
	e.xs=0
	e.ys=0
	e.xv=0
	e.t=t
	if t==4 then
		e.sz=4
		e.ox=e.x
		e.oy=e.y
		e.xv=-16
		add(blw,e) 
	end
	add(enm,e)

end

ball_w=32
ball_d=10
function u_enm()
	for e in all(enm) do
		if e.t==1 then
			e.xv+=.5
			for b in all(blw) do
				local ed=dist(e.x,e.y,b.x,b.y)
				if e.xv>60 and ed<48 and win==false then
					local bd=atan2(b.x-e.x,b.y-e.y)
					local cbl=true
					for i=0,dist(b.x,b.y,e.x,e.y),4 do
						local mg=mget((b.x-cos(bd)*i)/8,(b.y-sin(bd)*i)/8)
						if fget(mg,0) then
							cbl=false
						end
					end
					if cbl then
						b.xs+=(cos(bd)/ed)*3
						b.ys+=(sin(bd)/ed)*3
					end
					end
				end
			if e.xv>90 then
				e.xv=0
			end
		end
		if e.t==2 or e.t==3 then
			e.xv+=0.005
			for j=2,e.t do
			if dist(e.x+cos(e.xv+j/2)*ball_w,e.y+sin(e.xv+j/2)*ball_w,pl.x,pl.y)<ball_d+pl.sz then
				die()
			end
			end
		end
		
		if e.t==4 then
			if e.xv<0 then
				e.xv+=1
			end
			u_bl(e,24)
			e.x+=e.xs
			e.y+=e.ys
			e.xs*=0.97
			e.ys*=0.97
			if dist(e.x,e.y,pl.x,pl.y)<pl.sz+e.sz then
				--[[
				e.xs,pl.xs=pl.xs,e.xs
				e.ys,pl.ys=pl.ys,e.ys--]]
				local bd=atan2(e.x-pl.x,e.y-pl.y)
				local bs=e.sz+pl.sz+dist(0,0,pl.xs,pl.ys)
				e.x=pl.x+cos(bd)*bs
				e.y=pl.y+sin(bd)*bs
				e.xs,pl.xs=pl.xs,e.xs
				e.ys,pl.ys=pl.ys,e.ys
			end
			for i=0,7 do
				c={}
				c.x=e.x+cos(i/8)*3
				c.y=e.y+sin(i/8)*3
				if fget(mget(c.x/8,c.y/8),0) and e.xv<1 then
					mptc(e.x,e.y,8)
					sfx(21)
					for x=e.x/8-1,e.x/8+1 do
						for y=e.y/8-1,e.y/8+1 do
							if mget(x,y)==35 then
								mset(x,y,0)
							end
						end
					end
					m_enm(e.ox,e.oy,4)
					e.xv=1
				end
					if e.xv>=1 then
						e.xv+=1
					end
					if e.xv>=10 then
						del(enm,e)
					end
			end
		end
	end
end

function d_enm()
	for e in all(enm) do
		if e.t==1 then
			local dd=max(0,(e.xv-60)/10)
			for i=-16,16 do
				circfill(e.x+cos(dd)*i,e.y+sin(dd)*i,6-abs(i/8),7)
			end
			for i=-16,16 do
				circfill(e.x+cos(dd)*i,e.y+sin(dd)*i,4-abs(i/8),13)
			end
			circfill(e.x,e.y,7,7)
			circfill(e.x,e.y,5,13)
		end
		if e.t==2 or e.t==3 then
			for j=2,e.t do
			for i=0,3 do
				circ(e.x+cos(e.xv+j/2)*i*8,e.y+sin(e.xv+j/2)*i*8,4,6)
			end
			circfill(e.x+cos(e.xv+j/2)*ball_w,e.y+sin(e.xv+j/2)*ball_w,ball_d+2,7)
			circfill(e.x+cos(e.xv+j/2)*ball_w,e.y+sin(e.xv+j/2)*ball_w,ball_d,13)
		end
		end
		if e.t==4 then
			pfade(e.xv+14)
			if e.xv<=0 then
			circfill(e.x,e.y,5,7)
			circfill(e.x,e.y,3,8) end
			pal()
		
		end

	end
end

function map_enm()
	for x=0,31 do
		for y=0,31 do
			if fget(mget(x,y),7) then
				m_enm(x*8+4,y*8+4,fget(mget(x,y))-2^7)
				if fget(mget(x,y))-2^7==1 then
					mset(x,y,0)
				else
					mset(x,y,mget(x+1,y))
				end
			end
		end
	end
end
-->8
flw={}

function map_flw()
	for x=0,31 do
		for y=0,31 do
			if mget(x,y)<=3 and mget(x,y)>0 then
 		f={}
			f.x=x*8
			f.y=y*8
			f.t=mget(x,y)
			add(flw,f)
			mset(x,y,0) end
		end
	end
end

function d_flw()
	for f in all(flw) do
		spr(f.t,f.x,f.y)
	end
end

ptc={}

function mptc(x,y,c)
	p={}
	p.x=x
	p.y=y
	p.t=0
	p.c=c
	add(ptc,p)
end

function d_p()
	for p in all(ptc) do
		p.t+=1
		if p.t>10 then
			del(ptc,p)
		end
		pal()
		for i=0,7 do
			circfill(p.x+p.t*cos(i/8),p.y+p.t*sin(i/8),3,7)
			circfill(p.x+p.t*cos(i/8),p.y+p.t*sin(i/8),1,p.c)
		end
	end
end
-->8
dttl=true
sttl=0
dead=false
dtime=0
gtime=0
gts="gunturtle"
st2l=0
deaths=0
function d_title()
	if dttl then
		camera()
		cls(0)
		pfade(-sttl+120)
		sttl+=1
		circfill(64,64,10-20/sttl,15)
		for i=1,13 do
			print(sub(gts,i,i),44+i*4,80+cos(-sttl/20+i/13)*max(0,4-sttl*.09),7)
		end
		for i=0,15 do
			pal(i,0)
		end
		spr(14,59,59)
		spr(14,60,60)
		spr(14,61,61)
		spr(14,60,59)
		spr(14,59,61)
		spr(14,61,59)
		spr(14,59,60)
		spr(14,60,61)
		pal()
		spr(14,60,60)
		if sttl>120 then
			pfade(sttl-120)
			if st2l>0 then
				pfade(30-st2l)
			end
			cls(0)
			camera()
			rectfill(0,0,128,128,12)
			for i=0,127 do
				line(i,0,i,16-abs(cos(i/128))*16+16,1)
				line(i,128,i,128+abs(cos(i/128))*16-32,1)
			end		

			for i=0,8 do
				circfill(i*16,64,cos(i/9+sttl/200)*10+15,14)
			end
			for i=0,8 do
				circfill(i*16,64,cos(i/9+sttl/200)*10+10,7)
			end
			spr(64,17,56,16,2)
			rectfill(57,95,72,101,0)
			print("tap!",58,96,7)
		
			if mouse().b==1 and st2l==0 then
				st2l+=1
				sfx(22)
			end
			if st2l>0 then
				st2l+=1
				if st2l>30 then
					pal()
					dttl=false
					music(0)
				end				
			end
		end
	end
	if dead then
		dtime+=1
		if dtime>20 then
			copym()
			pl.xs,pl.ys=0,0
			pl.x=plst[lvl+1][1]
			pl.y=plst[lvl+1][2]
			--pl.sz=6
			if lvl>0 then
				enm={} 
				map_enm()
				for x=0,31 do
					for y=0,31 do
						if mget(x,y)==2 or mget(x,y)==3 then
							mset(x,y,0)
						end
					end
				end
				--map_flw()
	end
			dead=false
			dtime=0
		end
	end
end

function dbg()
	if lvl<4 then
	for x=0,31 do
		for y=0,31 do
			spr(99,x*8+flr(camx/2),y*8+flr(camy/2))
		end
	end
	end
	if lvl>=4 then
		cls(12)
		local cyos=camy/2
		for i=0,12 do
			circfill(i*16,64+cyos,cos(i/9+gtime/3)*10+15,14)
		end
		for i=0,12 do
			circfill(i*16,64+cyos,cos(i/9+gtime/3)*10+10,7)
		end
		pal(3,1)
		rectfill(0,24*8+camy/4,32*8,32*8,3)
		map(32,48,-8,camy/4+16*8,32,16)
		pal()
	end
end

wint=0
win=false
function d_win()
	if count(flw)==0 then
		if wint==0 then
			sfx(25)
		end
		wint+=1
		win=true
		if wint<=162 then
			for x=0,7 do
				for y=0,7 do
					circfill(x*16+camx+8,y*16+camy+8,wint/4-x,0)
				end
			end
			d_pl()
			pl.ys-=.2
		end
		if wint==160 then
			pl.xs=0
			pl.ys=0
			n_room()
			map_flw()
			camx,camy=pl.x-64,pl.y-64		
			wint=0
			win=false
			sgf=0
		end
	end
	if pl.y<0 and wint==0 then
		pl.ys=-1
		pl.xs*=0.9
		if pl.y<-32 then
			local yws="you win"
			rectfill(camx+61-#yws*2,camy+59,camx+61+#yws*2,camy+65,0)
			print(yws,camx+62-#yws*2,camy+60,7)
			local times="“"..flr(gtime/60)..":"
			if gtime%60<10 then
				times=times.."0"
			end
			times=times..flr(gtime%60)
			rectfill(camx+60-#times*2,camy+65,camx+63+#times*2,camy+71,0)
			print(times,camx+60-#times*2,camy+66,7)
			local dstr=deaths.." deaths"
			rectfill(camx+61-#dstr*2,camy+72,camx+61+#dstr*2,camy+78,0)
			print(dstr,camx+62-#dstr*2,camy+73,7)

			if m.b!=0 then
				run()
			end
		end
	else
		gtime+=1/60
	end
end

function n_room()
	lvl+=1
	copym()
	enm={}
	map_enm()

	pl.x=plst[lvl+1][1]
	pl.y=plst[lvl+1][2]
	if lvl==4 then
		music(8)
		pl.sz=6
	end
end
