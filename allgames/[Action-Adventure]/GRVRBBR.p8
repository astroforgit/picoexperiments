--map generation
function pickrm()
 local mapx=cur_tilegroup*16 local mapy=tilegroups[cur_tilegroup][flr(rnd(#tilegroups[cur_tilegroup]))+1]
 local m={mapx,mapy}
 add(tile,m)
 return m
end

function place_bones(xy)
	bone_tile[tiles_spawned]={}
	local amt=flr(rnd(3))
	
	if amt>0 then	for i=0,amt do
	 valid={}
	 for i=2,7 do --y
	  for j=1,15 do --x minus walls
	   local cell=fget(mget(tile[tiles_spawned][1]+j,tile[tiles_spawned][2]+i),0) or fget(mget(tile[tiles_spawned][1]+j,tile[tiles_spawned][2]+i),4)
	 	 
	 	 local cell_upper=fget(mget(tile[tiles_spawned][1]+j,tile[tiles_spawned][2]+i-1),0)
	   if cell==true and cell_upper==false then
	    local tmp={}
	    tmp.x=j
	    tmp.y=i-1
	    add(valid,tmp)
	   end
	  end
 	end end
	
	 --if #valid>0 then
	 local selval=flr(rnd(#valid))+1
	 local n={}
	 n.x=valid[selval].x*8
		--find the right y value
		n.y=(tiles_spawned-1)*64+valid[selval].y*8
		n.sp=bone_tile_sp[flr(rnd(#bone_tile_sp))+1]
		n.box={x1=0,y1=0,x2=8,y2=8}
	 add(bone_tile[tiles_spawned],n)
 end
end

function currenttile()
	--div cur y by 64 to find index of tile{}
	return flr(plr.y/64)+1
end

function mapgen_upd()
	if cur_tile>tiles_spawned-3 then
	 if tiles_spawned<103 then
	  local coord=pickrm()
	  place_bones(coord)
	  tiles_spawned+=1
	 else
	  if tiles_spawned==103 then
    local m={64,56}
    add(tile,m)
    tiles_spawned+=1
   end
	 end
	end
end

function checkgroup()
	cur_tilegroup=1
	if(cur_tile>=25) cur_tilegroup=2
	if(cur_tile>=50) cur_tilegroup=3
	if(cur_tile>=75) cur_tilegroup=4
end

function update104()
 if cur_tile==103 then
  grn_tmr+=tmr.el
  if grn_tmr>1 then
   grn_tmr=0
 	 local points={}
 	 add(points,grn_blocks[flr(rnd(#grn_blocks))+1])
		 add(points,grn_blocks[flr(rnd(#grn_blocks))+1])
		 if(rnd(2)>1) add(points,grn_blocks[flr(rnd(#grn_blocks))+1])
   for p in all(points) do
    local flp=false
    if(rnd(2)>1) flp=true
   	make_prtcl(p[1],p[2],0,-1,106,rnd(2)+2,flp)
   end
  end
 end
end
-->8
--bone handling
function givebone(spt)
	if bone_ct<5 then
	 local b={
	  sp=spt
	 }
	 add(bone,b)
	end
	bone_ct+=1
end



-->8
--block coll
function col_sp(b,full)
--b=targ full=full sprite t/f  
  local x=plr.x y=plr.y
  local w=plr.w local h=plr.h
  local x1=0 local x2=0 local y1=0 local y2=0
		
		x1=x+plr.box.x1
		y1=y+plr.box.y1
		x2=x+plr.box.x2
		y2=y+plr.box.y2
		
 local box_a={}
 if full==false then
	 box_a.x1=x1+1
	 box_a.y1=y1+14
	 box_a.x2=x2-1
	 box_a.y2=y2-2
	else
	 box_a.x1=x1
	 box_a.y1=y1
	 box_a.x2=x2
	 box_a.y2=y2
	end
 local box_b=abs_box(b)
 
 if box_a.x1>box_b.x2 or
 			box_a.y1>box_b.y2 or
 			box_b.x1>box_a.x2 or
 			box_b.y1>box_a.y2 then
 			return false 
 			end
 return true
end
