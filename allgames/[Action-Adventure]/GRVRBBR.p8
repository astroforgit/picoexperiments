--init
function _init()
 cartdata("shd_grvrbbr_1")
	reset_state()
end

function reset_state()
 gamest={
		sn=-1, nxtsn=5,
		menu={116,0},
		hint={114,8},
		tr_tmr=0,
		tr_tmr_max=1,
		ebutspwn=false,
		cur_sn_tmr=0
	}
	
	diff=0
	diff_disp=128
	door_state=false
	door_sp={23,24,39,40}
	plr={
  x=20,
  y=34+20,
  dx=0,
  dy=0,
  w=8,
  h=14,
  flp=false,
  sp=18,
  grnd=false,
  fall=false,
  jmp=false,
  hdbob=1,
  anim=0,
  box={x1=0,y1=0,x2=8,y2=16}
 }
 bone_ct=0
 bone={}
 bone_sp={{56,58,60,62},{55,57,59,61}}
 tmr={el=0,l=time()}
 wtmr=0.0
 woff=0
 enemy={}
 d_enemy={}
 e_max=40
 prtcl={}
 etmr=0
 enxt=5+rnd(5)
 e1sp={34,50}
 ptr={
  sf=false,
 	x=0,y=0,w=8,h=8,
 	sp=35,
 	box={x1=0,y1=0,x2=8,y2=8},
 	block={
 	 x=0,y=-900,w=8,h=8,
 	 sp=124,
 	 box={x1=0,y1=0,x2=8,y2=6},
 	 btimer=0
 	}
 }
 ptr_tmr=0
 eprtcl_sp={36,52,53}
 tile={{16,56}}
 cur_tile=1
 tiles_spawned=2
 cur_tilegroup=1
 --all groups should have the same # of rooms
 tilegroups={ --y vals, x=(#-1)*16
  {0,8,16,24,32,40,48},
  {0,8,16,24,32,40,48},
  {0,8,16,24,32,40,48},
  {0,8,16,24,32,40,48}
 }
 bone_tile_sp={33,48,49,54}
 --{x,y,sp}
 bone_tile={{{x=56,y=48,sp=33,box={x1=0,y1=0,x2=8,y2=8}}}}--by actual pixel
 valid={}
 kills=0
 grn_tmr=0
 grn_kills=0
