--functions
function upd_tmr()
	tmr.el=(time()-tmr.l)
	tmr.l=time()
end

function colmap(obj,aim,flag)
  --obj=xywh aim=”ƒ‹‘
  
  local x_abs=obj.x%128
  local y_abs=obj.y%64
		local x=x_abs+(tile[cur_tile][1]*8) local y=y_abs+(tile[cur_tile][2]*8) local w=obj.w local h=obj.h
		local x1=0 local x2=0 local y1=0 local y2=0
		if aim=="l" then
			x1=x-1 y1=y+1
			x2=x y2=y+h-2
		elseif aim=="r" then
		 x1=x+w y1=y+1
			x2=x+w+1 y2=y+h-2
		elseif aim=="u" then
		 x1=x+1 y1=y-1
			x2=x+w-1 y2=y
		elseif aim=="d" then
			x1=x+1 y1=y+h
			x2=x+w-1 y2=y+h
		elseif aim=="c" then
			x1=x+1 y1=y+1
			x2=x+w-1 y2=y+h-1
		end
		x1/=8 y1/=8 x2/=8 y2/=8
		if fget(mget(x1,y1),flag)
		or fget(mget(x1,y2),flag)
		or fget(mget(x2,y1),flag)
		or fget(mget(x2,y2),flag) then return true
		else return false
 end
end

function plr_upd()
	cur_tile=currenttile()
	plr.anim += tmr.el
 local grv =.5
 if btn(”) and plr.dy<0 then grv=.25 end
	if (btn(ƒ)) grv=.9

 plr.dx = 0
 if btn(‹) then plr.dx=-1.5 plr.flp=true end
 if btn(‘) then plr.dx=1.5 plr.flp=false end  
 if btnp(”) and plr.grnd then
  plr.dy=-5
  plr.grnd=false
 end
 if plr.dy>0 then
  plr.fall=true
  plr.grnd=false
  plr.jmp=false
 	if colmap(plr,"d",0) or col_sp(ptr.block,false) or colmap(plr,"d",4) then
 	 plr.grnd=true
 	 plr.fall=false
 	 if plr.dy>2 then
 	  sfx(2)
 	  plr.dy=-2
 	 else plr.dy=0 end
 	 plr.y-=((plr.y+plr.h)%8)
  end
 elseif plr.dy<0 then
 	plr.jmp=true
 	if colmap(plr,"u",0) then
 		plr.dy=0
 	end
 end
 if plr.dx<0 then
  if(colmap(plr,"l",0)) plr.dx=0
 elseif plr.dx>0 then
  if(colmap(plr,"r",0)) plr.dx=0
 end
 plr.dy+=grv
 if(plr.dy>4) plr.dy=4
 plr.hdbob=1
 if(plr.grnd==false) plr.hdbob=0
 
 if door_state==true and colmap(plr,"c",3) then
  sfx(2)
  if(dget(0)<bone_ct) dset(0,bone_ct)
  gamest.sn=-1
		gamest.nxtsn=4
		ebutspwn=false
		for e in all(enemy) do
	 	make_prtcl(e.x,e.y,-1.5*rnd(),-1.5*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,true)
	 	make_prtcl(e.x,e.y,1.5*rnd(),-1.5*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,true)
	 	make_prtcl(e.x,e.y,1*(-1+rnd(2)),2*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,false)
	 	del(enemy,e)
  end
 end
 
 for b in all(bone_tile[cur_tile]) do
  if coll(b,plr) then
   sfx(9)
   local typ=flr(rnd(#bone_sp))+1
   givebone(bone_sp[typ][flr(rnd(#bone_sp[typ]))+1])
 	 make_prtcl(b.x,b.y,0,-1,63,.25,true)
 	 del(bone_tile[cur_tile],b)
  end
 end
 
 if plr.dx==0 then plr.sp=18 else 
		if plr.anim>.1 then
			plr.anim=0
			if plr.sp==19 then plr.sp=18
	  else plr.sp=19 end
		end
	end
 if plr.grnd==false then
  if(plr.dy>0) plr.sp=17
  if(plr.dy<0) plr.sp=20
 end
 plr.x+=plr.dx
 plr.y+=plr.dy
end

function coll(a,b)
 local box_a=abs_box(a)
 local box_b=abs_box(b)
 
 if box_a.x1>box_b.x2 or
 			box_a.y1>box_b.y2 or
 			box_b.x1>box_a.x2 or
 			box_b.y1>box_a.y2 then
 			return false end
 return true
end

function abs_box(s)
	local box={}
	box.x1=s.box.x1+s.x
	box.y1=s.box.y1+s.y
	box.x2=s.box.x2+s.x
	box.y2=s.box.y2+s.y
	return box
end

function ptr_upd()
 ptr.block.btimer+=tmr.el
	poke(0x5d2d,1)
	ptr.sp=35
 ptr.x=stat(32) ptr.y=stat(33)+plr.y-60 
	if stat(34)==1 then
	 --if ptr.sf==false then
	 -- ptr.sf=true
	 -- sfx(3,0)
	 --end
	 ptr.sp=51
  for e in all(enemy) do
 	 if coll(e,ptr) then
 	 	make_prtcl(e.x,e.y,-1.5*rnd(),-1.5*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,true)
 	 	make_prtcl(e.x,e.y,1.5*rnd(),-1.5*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,true)
 	 	make_prtcl(e.x,e.y,1*(-1+rnd(2)),2*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,false)
 	 	del(enemy,e)
 	 	kills+=1
 	 	sfx(4+flr(rnd(2.8)))
 	 	if cur_tile==103 then
 	 		grn_kills+=1
 	 	 local typ=flr(rnd(#bone_sp))+1
     givebone(bone_sp[typ][flr(rnd(#bone_sp[typ]))+1])
 	   make_prtcl(e.x,e.y,0,-1,125,.25,e.flp)
 	 	end
 	 end
 	end
 --else
 	--if stat(16)==3 then
	 -- ptr.sf=false
	 -- sfx(-1,0)
	 --end
 end
 if stat(34)==2 and ptr.block.btimer>1 then
	 sfx(11)
 	local x=flr((ptr.x+4)/8)*8
  local y=flr(ptr.y/8)*8
 	ptr.block.btimer=0
 	ptr.block.x=x
 	ptr.block.y=y
 	make_prtcl(x,y,-1.5,0,eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.2,true)
 	make_prtcl(x,y,1.5,0,eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.2,false) 	
 end
end

function make_prtcl(x,y,dx,dy,sp,life,flp)
	local p={}
	p.x=x	p.y=y p.dx=dx p.dy=dy p.sp=sp p.life=life p.flp=flp
	p.tmr=0
	add(prtcl,p)
end

function prtcl_upd()
	for p in all(prtcl) do
 	p.x+=p.dx
 	p.y+=p.dy
 	p.tmr+=tmr.el
 	if(p.tmr>p.life) del(prtcl,p)
 end
end

function sn_tr_upd()
 gamest.cur_sn_tmr+=tmr.el
	if gamest.sn==-1 then
		gamest.tr_tmr+=tmr.el
		if gamest.tr_tmr>gamest.tr_tmr_max then
			gamest.sn=gamest.nxtsn
			gamest.tr_tmr=0
			gamest.cur_sn_tmr=0
		end
	end
end
