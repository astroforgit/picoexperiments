--update
function _update()
	upd_tmr()
	sn_tr_upd()
	if gamest.sn==5 then
	 if sfx_pl==false then
	  sfx(0)
	  sfx_pl=true
	 end
	 if gamest.cur_sn_tmr>3 then
	  sfx_pl=false
	  gamest.sn=-1
			gamest.nxtsn=0
	 end
	end
	if gamest.sn==0 then
	 if sfx_pl==false then
	  sfx(1)
	  --music(0,1)
	  sfx_pl=true
	 end
		menu_enmy_upd()
		if btn(‹) and btn(‘) then 
	  if(dget(0)!=0) sfx(10) 
		 dset(0,0) 
		 end
		if btn(ƒ) then
		 sfx_pl=false
			gamest.sn=-1
			gamest.nxtsn=1
			ebutspwn=false
			for e in all(enemy) do
 	 	make_prtcl(e.x,e.y,-1.5*rnd(),-1.5*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,true)
 	 	make_prtcl(e.x,e.y,1.5*rnd(),-1.5*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,true)
 	 	make_prtcl(e.x,e.y,1*(-1+rnd(2)),2*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,false)
 	 	del(enemy,e)
   end
		end
	end
	
	if gamest.sn==1 then
	 if ebutspwn==false then
	  kills=0
	 	make_e(34,0,108,114)
	 	ebutspwn=true
	 else
	 	if #enemy!=1 then
	 		gamest.sn=-1
			 gamest.nxtsn=2
			 ebutspwn=false
	 	end
	 end
 end
 
 if gamest.sn==2 then
	 if ebutspwn==false then
	 	make_e(34,0,108,90)
	 	ebutspwn=true
	 else
	 	if #enemy!=1 then
	 		gamest.sn=-1
			 gamest.nxtsn=3
			 ebutspwn=false
			 plr.y-=20
			 ptr.block.x=0
			 ptr.block.y=-900
	 	end
	 end
 end
 
 if gamest.sn==4 then
	 if ebutspwn==false then
	 	camera(0,0)
	 	plr.y+=20
	 	make_e(34,0,108,90)
	 	ebutspwn=true
	 else
	 	if #enemy!=1 then
	 	 music(-1)
	 		reset_state()
	 		nxtsn=0
	 	end
	 end
 end
 

	if gamest.sn==3 then
	 mapgen_upd()
	 if sfx_pl==false then
	  sfx(8)
	  music(0)
	  sfx_pl=true
	 end
	 if next(bone)==nil then
	  if(door_state==true) sfx(8)
	  door_state=false
	 else
	  if(door_state==false) sfx(8)
	  door_state=true 
	 end
	 wtmr+=tmr.el
	 if wtmr>.1 then
	 	wtmr=0
	 	woff+=1
	 	if(woff>3) woff=0
	 end
	 if(flr(plr.y/diff_disp)>diff) diff=flr(plr.y/diff_disp)
	
		checkgroup()
	 plr_upd()
  enmy_upd()
  update104()
 end
 
 ptr_upd()
 prtcl_upd()
end
