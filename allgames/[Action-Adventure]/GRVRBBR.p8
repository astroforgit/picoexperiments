--enemies
function enmy_upd()
	--update enemy spawner
	etmr+=tmr.el
	if etmr>enxt and #enemy<e_max then
	 etmr=0
		enxt=.5+rnd(6-cur_tilegroup)
		if cur_tile==103 then
		 enxt=1/((grn_kills+1)/50)
		 if(enxt>2.5) enxt=2.5
		end
		for i=0,1+flr(rnd(1.5)) do
		 local l=-16
		 if(rnd(10)>5) l=144
		 local sp=34
		 if rnd(100)>97 or cur_tile==103 then sp=50 end
		 make_e(sp,0,l,plr.y-60+rnd(120))
	 end
	end
	for e in all(enemy) do
		e.flp=plr.x<e.x
		local s=.5
		local dx=plr.x-e.x local dy=plr.y-e.y
		if(dx>s) dx=s
		if(dx<-s) dx=-s
		if(dy>s) dy=s
		if(dy<-s) dy=-s
		if e.y<plr.y-128 then
		 e.y=plr.y+120
		 e.x=rnd(128)
		end
		if e.y>plr.y+128 then
		 e.y=plr.y-120
		 e.x=rnd(128)
		end
		if e.sp==50 then
			dx*=1+(grn_kills/50)
			dy*=1+(grn_kills/100)
		end
		e.x+=dx
		e.y+=dy+sin(time()+e.floff)
		
		if col_sp(e,true) then 
		 sfx(7) 
			bone_ct-=1
			if bone_ct<0 then
			 bone_ct=0
			 make_prtcl(e.x,e.y,0,-1,109,.5,false)
			end
			--delete sprite if less than
			if bone_ct<5 then
			 del(bone,bone[#bone])
			end
			make_prtcl(e.x,e.y,-1.5*rnd(),-1.5*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,true)
 	 make_prtcl(e.x,e.y,1.5*rnd(),-1.5*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,true)
 	 make_prtcl(e.x,e.y,1*(-1+rnd(2)),2*rnd(),eprtcl_sp[flr(rnd(#eprtcl_sp))+1],.25,false)
 	 del(enemy,e)
		end	
	end
end

function make_e(sprt,typ,posx,posy)
	local e={
		sp=sprt,
		t=typ,
		x=posx,
		y=posy,
		flp=posy>64,
		box={x1=0,y1=0,x2=8,y2=8},
		floff=rnd(6)
	}
	add(enemy,e)
end

function menu_enmy_upd()
	etmr+=tmr.el
	if etmr>1 then
	 etmr=0
		for i=0,1+rnd(2) do
		 local l=-8
		 if(rnd(10)>5) l=136
		 make_e(34,0,l,4+rnd(120))
	 end
	end
	for e in all(enemy) do
		local dx=.5
		if(e.flp)dx=-.5
		local dy=0
		e.x+=dx
		e.y+=dy+sin(time()+e.floff)
		if e.x>140 or e.x<-20 then
		 del(enemy,e)
		end
	end
end
