--draw
function _draw()
 cls()
 
 if(gamest.sn==5) print("mouse input required for play",6,64,7)
 
 if gamest.sn==0 then
  camera(0,0)
 	map(gamest.menu[1],gamest.menu[2],16,32,12,8)
 	map(116,28,16,15,12,2)
 	print("press ƒ to start",30,56,7)
 	if(dget(0)>0) print("(‹+‘ - reset score)",23,66,1)
 	print("best score:",30,74,15)
 	print(dget(0),30,82,15)
 	print("kills:",1,123,13)
 	print(kills,27,123,1)
 	--print("by: superheavyduty",39,26,2)
 	print("superheavyduty.itch.io",21,21,15)
 	for e in all(enemy) do
  	spr(e.sp,e.x,e.y,1,1,e.flp)
  end
 end
 
 if gamest.sn==1 then
 	map(gamest.hint[1],gamest.hint[2],8,16,14,12)
  print("as a necromancer, your\nmost valuable asset is\na large collection of\nbones, but the ghosts who\nowned them won't let you\nescape with them alive!\n\nleft-click on them with\nyour mage hand to send\nthem to the next plane\nand return to the\nentrance of the tomb to\nclaim your collection!",15,24,7)
  print("click the ghost to begin",8,114,15)
  print("[story]",24,10,15)
  for e in all(enemy) do
  	spr(e.sp,e.x,e.y,1,1,e.flp)
  end
 end
 if gamest.sn==2 then
 	map(114,20,8,24,14,8)
  print("\narrow keys:\n ‹‘ - move\n ” - jump (hold)\n ƒ - fall faster\n\nmouse:\n l. click - attack\n r. click - platform",15,26,15)
  print("click the ghost to begin",8,90,15)
  print("[controls]",24,18,15)
  for e in all(enemy) do
  	spr(e.sp,e.x,e.y,1,1,e.flp)
  end
  spr(35,94,64,1,1,false)
  spr(51,103,64,1,1,false)
  spr(124,99,73,1,1,false)
 end
 if gamest.sn==4 then
 	map(114,20,8,24,14,8)
 	print("\n’stage complete’",30,26,10)
  print("\nbest score:",15,38,15)
  print(dget(0),20,52,7)
  print("\nattempt score:",15,56,15)
  print(bone_ct,20,70,7)
  
  print("click to return to menu",12,90,15)
  for e in all(enemy) do
  	spr(e.sp,e.x,e.y,1,1,e.flp)
  end
 end
 
 
 if gamest.sn==3 then
  camy=plr.y-60
  camera(0,camy)
  for i=1,#tile do
  	map(tile[i][1],tile[i][2],0,(i-1)*64,16,8)
  end
  --door sprites
  if door_state==false then
  	spr(door_sp[1],16,32)
  	spr(door_sp[2],24,32)
  	spr(door_sp[3],16,40)
  	spr(door_sp[4],24,40)
  end
  
  for bt in all(bone_tile) do
  	for b in all(bt) do
  	 spr(b.sp,b.x,b.y)
  	end
  end
  
  for i=0,16 do
		 spr(16,-4,8*i+camy)
		 spr(16,124,8*i+camy)
  end
  for i=-1,5 do
  	spr(32,-4,32*i+(woff*8)+camy)
  	spr(32,124,32*i-(1+woff*8)+camy)
  end
 
  for e in all(enemy) do
  	spr(e.sp,e.x,e.y,1,1,e.flp)
  end
  
 	for i=1,5 do
 		if #bone>=i then
 			--spr(bone[i].sp,plr.x+cos(time()/2+1.3*i)*8,plr.y+4+sin(time()/2)*4)
 			spr(bone[i].sp,plr.x+cos(time()/2+i*.2)*8,plr.y+4+sin(time()/2+.5+i*.2)*8)
 		end
 	end
  
  spr(plr.sp,plr.x,plr.y+6,1,1,plr.flp)
  spr(2,plr.x,plr.y-plr.hdbob*(.5+(.5*cos(time()))),1,1,plr.flp)
  spr(ptr.block.sp,ptr.block.x,ptr.block.y)
  print(bone_ct,plr.x,plr.y-10)
  --print(cur_tile,plr.x,plr.y-10)
  
 end
 
 for p in all(prtcl) do
  	spr(p.sp,p.x,p.y,1,1,p.flp)
 end
 if gamest.sn!=-1 then
  poke(0x5f2d,1)
  spr(ptr.sp,ptr.x,ptr.y)
 end
end
