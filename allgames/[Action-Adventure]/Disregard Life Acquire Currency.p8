pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
--disregard life,
--acquire currency

function _salt()
 return stat(85)*rnd(1)
end
salt=_salt()
--player and view objs
function resetp()
 for x=16,23 do
  for y=8,15 do
   sset(x,y,0)
  end
 end
 rocks={8,9,11}
	p={x=10,y=56,dx=0.1,dy=0.1,
	 hp=100,c=0.01,fp=0}
	start=false
end
resetp()
v={x=0,y=0}
bob={x=0,y=0,dx=0,dy=0,z=0}

function drawsky(w)
	cls() fillp() pal()
	local x=30
	if (w) x=30+rnd(69)
	circfill(x,22,15,7)
	for i=0,20 do
	 circfill(x-9+rnd(18),
	  12+rnd(20),rnd(4),6)
	end
	for i=0,38 do
	 circfill(rnd(128),
	  rnd(64),rnd(2),7)
	end
	if p and p.bob then
		for i=1,#rocks do
		 circfill(x-16+i*8,
		  14+i%2*12,1,
		  rocks[i])
		end
	end
	
	
	circfill(48+rnd(64),
	  16+rnd(32),1,14)
	
	line(63,31,65,33,10)
	line(65,31,63,33,10)
	--save sky as sprite
	flip()
	memcpy(0x1000,0x6000,64*128)
end
drawsky()

function _draw()
 local st = sin(t())
 --kitty tail
 for i=0,3 do
 sset(i,10,0)
 end
 sset(flr(1.5+1.5*st),10,5)
 --kitty blink
 local bl=st>0.98 and 5 or 10
 sset(5,12,bl)
 sset(7,12,bl)
 
 --rainbowflag
 for i=9,14 do
  for k=8,14 do
   local c=0
   local w=sin(i/10+t())
   if k>8+w and
    k<13+w then
    c=8+(k/3+i/2+t()*10)%8
   end
   sset(i,k,c)
  end
 end
 
 
 pal()
	palt(0,false)
 if p.free and wrp==0 then
  warp()
 end
	if wrp>0 then
	 for i=0,16 do
	 	pal(i,(i+wrp)%16)
	 end
	 rectfill(0,0,127,127,wrp%8)
	 wrp=wrp-1
	else
		cls(0)
		sspr(v.x/65,v.y/65+64,128,64)
	end
	
 ghost=nil
 ship=nil
	sl=newsprl()
	for ix=-1,0 do
	 for iy=-1,0 do
		 local x=pget(ix+64+v.x/256,iy+32+v.y/256)
   if x==7 or x==14 or x==10 
    or x==8 or x==9 or x==11 then
		  ghost={xx=x,
		   x=0,
		   y=0,w=8,
		   h=6,
		   dx=128-(v.x%256)/2,
			  dy=128-(v.y%128)/2,
			  dw=8,dh=6}
			 
			 if ghost.xx==14 then
			  --big ghost
			 	ghost.x=8
			 elseif ghost.xx==10 then
			  --fish ghost
			  ghost.x=24
			 elseif ghost.xx==8 
			  or ghost.xx==9
			  or ghost.xx==11 then
			  --moonrocks
			  ghost.x=120
			  ghost.dw=0
			 end
			 
			 sl:adds(ghost)
			 break
		 end
		end
		if (ghost) break
	end
 ship={
	 x=0,y=8,w=24,
	 h=13,
	 dx=p.x,
		dy=p.y,
		dw=24,dh=13,
		f=p.dx<0}
	if(p.hp==0)ship.dh=msgs.t/120
	sl:adds(ship)
	
	if not ghost and wrp<1
	 and msgs.t==0
	 and pget(100,1)>0 then
	 dollar={
	  x=16,y=0,w=8,h=7,
   dx=128-(v.x%256)/2,
	  dy=128-(v.y%128)/2,
			dw=8,dh=7}
		sl:adds(dollar)
	else
	 dollar=nil
	end
	
 uis={}
 if start and p.hp>0 and not p.free then
	 ui({s='life‡:'.. flr(p.hp*100)/100 ..' ',
	 x=76,y=3,c=8})
	 ui({s='currency$$:'..p.c,
	 x=60,y=10,c=11})
	 if p.bob then
		 ui({s='fish•:'..p.fp.. ' ',
		 x=76,y=17,c=9})
		end
	 
	 mrox={}
	 mrox[8]='‡'
	 mrox[9]='•'
	 mrox[11]='$$'
		for i=1,#rocks do
		 mrox[rocks[i]]=''
		end
		local s
		 =mrox[8]..mrox[11]..mrox[9]
		if #s>0 then
		 ui({s=s..'  ',
			 x=2,y=2,c=14})
		end
	elseif not start then
		ui({s='disregard life',
	 x=50,y=8,c=8})
		ui({s='acquire currency',
	 x=50,y=15,c=11})
	 ui({s='follow the stars',
	 x=50,y=32,c=9})
	 ui({s='trade with sailors',
	 x=50,y=39,c=9})
	 ui({s='find a way home',
	 x=50,y=46,c=9})
	 ui({s='sail: ”ƒ‹‘    ',
	 x=50,y=60,c=6})
	end
 if p.free then
 	ui({s="you are free",
 		x=38+sin(t()/6.7)*32,
 		y=32+sin(t()/3.1)*32,
 		c=8+(t()*10)%8})
 end
 if start and ghost and near(ghost,ship) then
  --msgs={t=0}
  if ghost.x==0 then
   --normal ghost
	  ui({s='ahoy fair maiden.',
	  x=48,y=32,c=9})
	  ui({s='care to trade?',
	  x=48,y=39,c=9})
	  
	  ui({s='zŽ:‡+1:$$'..rate()*-1 ..'  ',
	  x=48,y=46,c=8})
	  ui({s='x—:‡-1:$$'..rate()..'  ',
	  x=48,y=53,c=11})
	 elseif ghost.xx==10 then
	 	ui({s="you buy pole:zŽ ",
	  x=40,y=24,c=9})
	  ui({s="go fish:zŽ ",
	  x=40,y=30,c=9})
	  ui({s="i buy fish:x— ",
	  x=40,y=36,c=9})
	  ui({s="eat fish:x— ",
	  x=40,y=42,c=9})
	  
	  if p.bob then
		  ui({s='zŽ:wisdom:free ',
		  x=40,y=49,c=8})
	  else
		  ui({s='zŽ:buy pole:$$-2.99 ',
		  x=40,y=49,c=8})
   end
	  ui({s="x—:sell fish:$$+5 ",
	  x=40,y=56,c=11})
	 elseif ghost.xx==14
	  and not p.free then
	  --big ghost
	 	ui({s='do you ever dream',
	  x=32,y=30,c=7+flr(v.x*v.y)%8})
	  ui({s='of just flying away?',
	  x=32,y=37,c=7+flr(v.x*v.y)%8})
	  
	  ui({s='zŽ:$$-100:freedom ',
	  x=48,y=46,c=8})
	  ui({s="x—:‡-1:i'm lost  ",
	  x=48,y=53,c=11})
	 end
  if not greeted then
   greet(rate())
   greeted=true
  end
 else
  greeted=false
 end
 
	
	--bob
	if p.bob then
  dbob()
	end
 
	palt(0,true)
	drawmsg()
 uid(true) --textreflect
 sl:drawr() --spritereflect
 pal(14,7+flr(v.x*v.y)%8)
 rectfill(0,64,128,128,0)
 water()
	palt(0,false)
	sspr(v.x/65,v.y/65+64,128,64)
 
 circfill(64+v.x/256,32+v.y/256,1,12)

	palt(0,true)
	
	
 sl:draws() -- sprites
 
 if p.bob and bob.b and bob.y!=0 then
	 line(
	  ship.f and ship.dx or
	  ship.dx+ship.dw,
	  ship.dy-ship.b,
	  bob.f and dx+8 or dx,
	  bobs.dy-bobs.b,5)
 end
 if p.bob and bob.b
  and bob.y>=bob.z then
	  splash(bob,bobs,true)
	end
	
	
 splash(p,ship)
 uid(false)
end

menuitem(1,'hard mode',function ()
 resetp()
 sfxlp(3,0)
 p.hp=50
end)
menuitem(2,'impossible',function ()
 resetp()
 sfxlp(3,0)
 p.hp=10
end)
-->8
--update
function _update60()
 
 --sound
 if t()%(8+rnd(2))<0.5 then
  wave()
  _theme()
 end
 local pv = abs(p.dx)+abs(p.dy)
 if (rnd(pv)>3) wake(pv)

 if (dead()) return
 --ctrls
 if (p.dx!=0) p.dx=p.dx*.97
 if (p.dy!=0) p.dy=p.dy*.97
	if btn(0) then
	 if p.dx > -2 then
	  p.dx=p.dx-0.1
	 end
	end
	if btn(1) then
	 if p.dx < 2 then
	  p.dx=p.dx+0.1
	 end
	end
	if btn(2) then
	 if p.dy > -2 then
	  p.dy=p.dy-0.1
	 end
	end
	if btn(3) then
	 if p.dy < 3 then
	  p.dy=p.dy+0.1
	 end
	end
	p.x=p.x+p.dx
 p.y=p.y+p.dy
	if p.x > 96 then
  v.x=v.x+p.x-96
	 p.x=96
 elseif p.x < 6 then
  v.x=v.x+p.x-6
  p.x=6
 end
	if p.y > 100 then
  v.y=v.y+(p.y-100)/1.4
  p.y=100
 elseif p.y < 55 and not p.free then
  v.y=v.y+(p.y-55)/1.4
  p.y=55
 end
 --boundaries
	if (v.x<-64*40) v.x=64*40
	if (v.x>64*40) v.x=-64*40
	if (v.y>64*20) v.y=-64*20
	if (v.y<-64*20) v.y=64*20
	
	if not bob.b and 
	 ghost and near(ghost,ship) then
  if btnp(4) then --z‡
   if ghost.x==0 then
    p.c=p.c-rate()
    if not broke() then
     p.hp=p.hp+1
			 	msgs={s='-'..rate()..'$$ for +‡ ',
				 		x=32}
    end
    warp()
   elseif ghost.xx==10 
    and not p.bob then
     p.c=p.c-2.99
     if not broke() then
      getpole()
				 	msgs={s='got fishing pole! zŽ ',
					 		x=20}
     end
   elseif ghost.xx==10 then
    wise()
   elseif ghost.xx==14 then
    p.c=p.c-100
    if not broke() then
     p.free=true
     happy()
    end
   end
	 elseif btnp(5) then --x$$
	  if ghost.x==0 then
	  	p.c=p.c+rate()
	  	if not broke() then
	  	 p.hp=p.hp-1
	  	 
	    msgs={s=rate()..'$$ for -‡ ',
					 		x=32}
				 warp()
				end
	  elseif ghost.xx==10 then --fish ghost
	   if not zerofish() then
	    p.c=p.c+5
	    p.fp=p.fp-1
	    msgs={s='sold fish +5$$',
					 		x=32}
	   end
	  elseif ghost.xx==14 then --big ghost
	   p.hp=p.hp-1
	   lost()
	   warp()
	  end
	 end
 elseif btnp(4)
  and not bob.b
  and msgs.t<150 then
  wake(7)
  fish()
 elseif btnp(5) then
  if not zerofish() then
	  p.fp=p.fp-1
	  p.hp=p.hp+5
   msgs={s='ate fish +5‡ ',
			 		x=32}
			greet()
		end
 end
 
 if bob.b then
	 if bob.y < bob.z then
	 	bob.x=bob.x+bob.dx
	  if bob.x>120 then
	   bob.x=120
	   bob.dx=0
	  end
	  if bob.x<1 then
	   bob.x=1
	   bob.dx=0
	  end
	  
	  bob.y=bob.y+bob.dy
	  bob.dy=bob.dy+0.2
	 elseif bob.dy!=0 then
	  bob.dx=0
	  bob.dy=-bob.dy/1.37
	  wake(13)
	 elseif _salt()<0.169 or
	  (msgs.t and msgs.t<10 and msgs.t>0) then
	  if bob.n then
	   nofish()
	  else
	   nibfish()
	  end
	 end
	 
	 if bob.dy>=0 and
	   btn() > 0 then
   bob.b=false
   if btn(4) then
    reelfish()
   else
    nofish()
   end
  end
 end
 
 if dollar and near(dollar,ship) then
  warp()
  p.c=p.c+1
 	msgs={s='found currency$$!',
	 		x=24,y=48}
 end

 if start then p.hp=p.hp-0.00237

	if #rocks==0 then
	 p.hp=999
	 p.c=999
	end

 elseif btnp()>0 then
  start=true
  theme()
 end
end
-->8
--sounders
sfx_addr = 0x3200
sfx_len = 68
function write_note(i,n,w,e,v,p)
 n1=(w%0b100)*0b1000000+p
 n2=w/0b100+
    v*0b10+
    e*0b10000	
    //+c*0b10000000
 poke(n*2+sfx_addr+i*sfx_len,n1)
 poke(n*2+1+sfx_addr+i*sfx_len,n2)
 
end

function sfxspd(i,s)
 poke(65+sfx_addr+i*sfx_len,s)
end

function sfxlp(i,l)
 poke(66+sfx_addr+i*sfx_len,0)
 poke(67+sfx_addr+i*sfx_len,l)
end

function wave()
 local p=flr(rnd(64))
 write_note(0,0,6,4,1+flr(rnd(1)),p)
 write_note(0,1,6,5,1+flr(rnd(1)),p)
 
 sfxspd(0,192+flr(rnd(64)))
 sfxlp(0,3)
 sfx(0)
end

function wake(v)
 local p=(8+flr(rnd(v*8)))%32
 write_note(1,0,6,4,1+flr(rnd(2)),p)
 
 sfxspd(1,8+flr(rnd(16)))
 sfx(1)
end

--1,5,8,11,13,
notes={8,21,25,28,31,33,38,41}
function song(s)
 srand(s)
 for i=0,9 do
 local p=notes[1+flr(rnd(#notes))]
 	write_note(2,i,7,4,flr(rnd(8)),p)
 end
 
 sfxspd(2,32)
 sfx(2)
end

function greet(s)
 srand(s)
 for i=0,9 do
 local p=notes[1+flr(rnd(#notes))]
 	write_note(2,i,7,4,1+flr(rnd(7)),p)
 end
 
 sfxspd(2,8)
 sfx(2)
end

function bad()
 for i=0,2 do
  write_note(3,i,5,5,7,24-i)
 end
 sfxspd(3,24)
 sfx(-1,1)
 sfx(3)
end

function sad()
 for i=0,4 do
  write_note(3,i,3,4,7-i,20-i*3)
 end
 sfxspd(3,200)
 sfx(-1,0)
 sfx(-1,1)
 sfx(3)
end

function happy()
 for i=0,32 do
  write_note(3,i,3,5,1+flr(rnd(7)),
   6+notes[1+flr(rnd(#notes))])
 end
 
 sfxspd(3,16)
 sfxlp(3,33)
 sfx(-1,0)
 sfx(-1,1)
 sfx(3)
end

function theme()
 srand(salt)
 for i=0,32 do
  write_note(4,i,flr(rnd(5)),
  (4+flr(rnd(2))),
  flr(rnd(1.9)),
   6+notes[1+flr(rnd(#notes))])
 end
 
 sfxspd(4,20)
 sfxlp(4,30)
 sfx(4)
end
function _theme()
 sfxspd(4,1+flr(rnd(250)))
end
-->8
--helpers
wrp=0
function warp()
 salt=_salt()
	song(salt)
--	v.x=rnd(128*32)-64*32
--	v.y=rnd(128*16)-64*16
	p.dx=rnd(8)-4
	p.dy=rnd(8)-4
	wrp=16
 drawsky(true)
end

function getpole()
 p.bob=true
 for x=16,23 do
  for y=8,15 do
   sset(x,y,sget(x,y+16))
  end
 end
 warp()
end
function fish()
 if (not p.bob) return
 bob.f=ship.f
 bob.b=true
 bob.x=ship.dx+
	  (ship.f and -8 or ship.dw)

	bob.y=ship.dy
	bob.z=ship.dy+ship.dh
 bob.dx=ship.f and -1.4 or 1.4
 bob.dy=-3.3
end
function reelfish()
 bob.x+=0.5*(bob.f and 1 or -1)
 
 if bob.f and bobs.dx+bobs.dw>=
    ship.dx or
    not bob.f and bobs.dx<=
    ship.dx+ship.dw then
	 
	 if bob.n 
	  and not moonrock() then
		 msgs={s='caught a fish!• ',
		 	x=24,t=60*3}
		 p.fp=p.fp+1
	  song(rate())
	 else
	  salt=_salt()
		end
  bob.b=false
  bob.n=false
	else
  bob.b=true
 end
end

mrt='got moonrock of '
function moonrock()
 local s=nil
 if (not ghost) return false
 
 if ghost.xx==8 then
    s=mrt..'life!‡ '
 elseif ghost.xx==9 then
    s=mrt..'fish!• '
 elseif ghost.xx==11 then
    s=mrt..'currency!$$'
	end
	if s then
	 msgs={s=s,x=8,t=60*4}
  del(rocks,ghost.xx)
  warp()
	 return true
	end
 return false
end
function nibfish()
		  bob.n=true
		  msgs={s='reel it in! zŽ ',
		 		x=24,t=60*4}
	   greet(rate())
end
function nofish()
  if bob.n then
		  	msgs={s='it got away',
		 			x=24,t=60*3}
		   bob.n=false
		   bad()
		end
		   bob.b=false
end
function zerofish()
 if p.fp<=0 then
   msgs={s='zero fish',
			 		x=48}
			bad()
			return true
	else
	 return false
	end
end

function rate()
 return min(9.99, abs
  (flr((v.y/v.x)*100)/100))
end
function near(a,b)
 return
  abs((a.dx+a.dw)-(b.dx+b.dw))<16
  and
  abs((a.dy+a.dh)-(b.dy+b.dh))<16
end

