--drawers
msgs={t=0}
function messege(m)
 msgs=m
end

function drawmsg()
 local m=msgs
 if (not m.y) m.y=80
 if (not m.t) m.t=60
 if m.t>0 then
  m.c=7+(m.t/3.3)%8
  ui(m)
		m.t=m.t-1
	end
end
wisdom={
 'lost:grieving:attachment',
 'found:happy:care free',
 'blinky star:’Œ’:go home   ',
 'blue star:you:cat boat',
 'yellow star:me:buy fish',
 'white star:sailors:buy life',
 'moon:sailors:fish for rocks',
 'get rocks:immortal:infinite',
 'go fish:on colors:moon rocks',
 '3 moonrocks:‡•$$:3 colors  ',
 'home:heart:i heart fish',
 'cat:love fish:home',
 'cat:no fish:lost',
 'love:here:home everywhere',
 'hear song:no sailor:moonrock'
}
function wise()
 msgs={s=wisdom[1+flr(rnd(#wisdom))],
		 		x=8,t=100}
end
function lost()
 sad()
 msgs={s="’blue star is you’  ",
 	x=24,t=100}
end

function dead()
 if p.hp <= 0 then
  p.hp=0
  sad()
  p.bob=false
 	msgs={s='you are dead!',
 		x=32,t=60*20}
  return true
 else
  return false
 end
end

function broke()
 if p.c<0 then
  bad()
  p.c=0
 	msgs=
 	 {s='you must acquire more currency!',
 	x=3,t=60*2}
  return true
 else
  return false
 end
end

uis=nil
function ui(u)
 add(uis,u)
end
function uid(r)
 fillp(0x8560)
 foreach(uis,function(u)
	 local y=u.y
  if (r and y>64) y=116-y
  rectfill(u.x-1,y-1,
   u.x-1+#u.s*4,y+5,1)
  ?u.s,u.x,y,u.c
 end)
end

function dbob()
		if bob.b then
		 dx=bob.x
		 dy=bob.y
	 else
	  dx=ship.dx+
		  (ship.f and -8 or ship.dw)
		 dy=ship.dy
		if bob.x!=0 and abs(bob.x-dx)>4 then
	  bob.x=flr((bob.x+dx)/2)
	  dx=bob.x
	 else bob.x=0
	 end
	 
	 
	 if bob.y!=0 and abs(bob.y-dy)>4 then
	  bob.y=flr((bob.y+dy)/2)
	  dy=bob.y
	 else bob.y=0
	 end
		
		end
		
		
		local bh=bob.b and bob.y>=bob.z
		 and 4 or 8
		bobs={
		 x=24,y=8,w=8,
		 h=bh,
		 dx=dx,
			dy=dy,
			dw=8,dh=bh,
			f=ship.f}
		if bob.b then
		 bobs.f=bob.f
		end
		if bob.n then
		 bobs.dy+=1.5*sin(t()*5)
		 bob.dx-=2+2*sin(t()*3)
		 bobs.h-=2+2*sin(t()*4)
		end
		sl:adds(bobs)
end


function newsprl()
 return {
  f=nil,
  adds=addspr,
  draws=drawsprl,
  drawr=drawreflect
 }
end
function addspr(self,s)
 if not self.f then
  self.f=s
  return
 end
 local c=self.f
 local l=nil
 while c do
	 if c.dy+c.dh > s.dy+s.dh then
	  if (self.f==c) self.f=s
	  if (l) l.next=s
   s.next=c
   return
  end
	 if not c.next then
	  c.next=s
	  return
	 end
	 l=c
  c=c.next
 end
end

function drawsprl(self,r)
 local c=self.f
 local b
 local yy
 while c do
  b=sin((v.x-c.dy)/99+t()/3.3)*2
  c.b=b
	 if r and c.dy>54 then
	  yy=129-c.dh*2-c.dy-b
	 else
	  yy=c.dy-b
	 end
  sspr(c.x,c.y,c.w,
   c.h+b,
   c.dx,
   yy,
   c.dw,
   c.dh+b,c.f)
  c=c.next
 end
end

function drawreflect(self)
 self:draws(true)
end

function splash(p,s,r)
 local v=abs(p.dx) + abs(p.dy)
 if v > 0.3 then
	 v=min(2.5,v)
	 local f=s.f
	 if r then
	   v=1/v
	   f=not f
	 end
  for i=0,v*6,.9 do
   pset(
    s.dx+(f and s.dw-v or v)
    +15*(f and -1 or 1)*v/2
     *cos((i/44+t())%0.4),
    min(p.dy+1,2)*rnd(1+i/3)
     *(sin(i/11+t())-1)
     +sin(i/8)
    +s.dy+s.dh-1,
    7+(i+s.dy)%8)
  end
 end
end

function water()
 local x,y,w,z,c
 local s=127
 local q=39
 local tt=t()*30+v.x-v.y
 local of=104
 local ra=100
 local sc=1.61
 srand(salt)
 fillp()
	for y=0,q do
		z=q/(y+1)
		for i=0,z*8 do
	
			x=2+(rnd(s)-2*v.x/z)%s-1
			w=sin((v.y/30)+rnd()+t()/2)*14/z
			if w>0.1 then
			 line(x-w,2.2*sin((y/2+tt+x-w)/ra)+of-q+y*sc,
			  x+w,2.2*sin((y/3+tt+x+w)/ra)+of-q+y*sc,
			  max(1,pget(x,sc*q-y*sc)))
		 end
		end
	end
end
