dpos=1
dstr=""
dstrpos=0
dia_music=false
function init_dialogue()
 pal()
 if (dia_music == false) then
  music(-1)
 end
 dpos=1
 dstrpos=0
 dstr=cur_d[dpos][2]
 dia_music=false
end

function update_dialogue()
 update_fade()

 if (btnp(4) and not fading) then
  if (dstrpos < #dstr) then
   dstrpos = #dstr
  else
   dstrpos = #dstr+99
  end
 end

 dstrpos += 0.4
 if (dstrpos > #dstr+16) then
  dstrpos=0
  dpos = dpos + 1
  dstr=cur_d[dpos][2]
  if (cur_d[dpos][1] == 2) then
   music(0)
   start_fade(0,16,0.5,fade_to_white,cur_d==intro_text and play_state or title_state)
  end
 end

 pos = flr(dstrpos)
 if (pos%2 == 0 and sub(dstr,pos,pos)!="") sfx(3+cur_d[dpos][1])

end

function draw_dialogue() 
 rectfill(0,0,127,127,0)

 str = sub(dstr, 1, flr(dstrpos))
 who = cur_d[dpos][1]
 x=who<1 and 124-#dstr*4 or 4
 y=who<1 and 32 or 88
 c=who<1 and 13 or 7 
 print(str,x,y,c) 
end

dialogue_state = {
 name = "dialogue",
 init = init_dialogue,
 update = update_dialogue,
 draw = draw_dialogue
}

--------------------------------
-- title state 
