endcount=0
prev_id=-1
door_opened = false
music_count = 0
curr_key = nil
keycount=0
keystried=0
fs=0
progress = 0
drop_key = false
ok_to_try=true
gt=-1 -- glitch timer

try_str = {
 "nope.", --1
 "doesn't work.",
 "i'll have to try another key.",
 "wrong key.",
 "it's not the right key.",
 "still locked.",
 "there must be another key.", --7 
 "how do i enter that room?",
 "i must get out!",
 "come on!",
 "hello? anybody there?", --11
 "i can't get out on my own...",
 "there must be a special key.",
 "not these keys...",
 "which is the right key?",
 "there must be an easier way..." --16
}

pickup_str = {
 "a key?", --1
 "maybe this one?",
 "where do they come from?",
 "my head hurts...",
 "*sigh*",
 "this one?",
 "aha!",
 "so many keys!",
 "did i try this one?",
 "don't think so..." --10
}

function say(str)
 saytext=str
 saycount=30+#str*2
end

function close_door()
 mset(7,8,67)
 mset(8,8,141)
 mset(7,9,67)
 mset(8,9,157)
 mset(7,10,67)
 mset(8,10,173)
 mset(7,11,67)
 mset(8,11,189)

 mset(6,9,134)
end


function open_door() 
 menuitem(1)
 mset(7,8,142)
 mset(8,8,143)
 mset(7,9,158)
 mset(8,9,159)
 mset(7,10,174)
 mset(8,10,175)
 mset(7,11,190)
 mset(8,11,191)

 mset(6,9,116)
 say("finally!")
 door_opened = true
 sfx(50)
end


function init_play()
 endcount=0
 prev_id=-1
 door_opened = false
 curr_key = nil
 keycount=0
 keystried=0
 fs=0
 progress = 0
 drop_key = false
 ok_to_try=true
 gt=-1 

 close_door()

 menuitem(1, "open door", open_door)
 fade(16,fade_to_white)
 start_fade(16,0,-1,fade_to_white,nil)
 keys={}
 entities={}
 music_count = 5*30 -- 5s

 pl = make_entity(260,96)
 pl.dir=-1
 pl.w=2
 pl.h=4
 pl.iy=1
 pl.ix=0.2
 pl.ddy=1
 idle()

 say("what is this place?")
end

function jump()
 pl.loc=0 -- in air 
 pl.dy=-5.1
 pl.spr=6
 pl.frame=0
 pl.frames=0
 pl.state=2
 debug_str = "jmp"
 sfx(2)
end

function land()
 idle()
end

function idle()
 if (pl.state != 0) then
  pl.spr=0
  pl.frame=0
  pl.frames=2
  pl.fs=30
  pl.state=0
  debug_str = "idl"
 end
end

function walk()
 if (pl.state == 0) then
  debug_str = "wlk"
  pl.t=0
  pl.spr=2
  pl.frames=4
  pl.fs=4
  pl.state=1
 end
end

function pickup(k)
 debug_str = "dck"
 pl.spr=7
 pl.fs=5
 pl.frame=0
 pl.frames=2
 pl.state=3
 pl.dx=0
 pl.dy=0
 pl.t=1
 curr_key=k

 sfx(6)

 if (keystried==0) say(pickup_str[1])
 if (keystried==1) say(pickup_str[2])
 if (keystried==3) say(pickup_str[3])
 if (keystried==5) say(pickup_str[4])
 if (keystried>8 and rnd(100)>70) then
  r=rnd(100)
  if (r<33) then
   say(pickup_str[5])
  elseif (r<67) then
   say(pickup_str[6])
  else
   say(pickup_str[7])
  end
 end
 if (keystried==11) say(pickup_str[8])
 if (keystried==12) say(pickup_str[9])
 if (keystried==13) say(pickup_str[10])

end

function drop_next_key()
 if (keycount>=32) return
 k=make_entity(248,8)
 k.spr=192+keycount*2
 k.w=2
 k.ddy=0.4+rnd(1)/10
 k.dx=0.6*(rnd(3)-1)
 k.iy=1
 k.ix=1
 keycount += 1
 add(keys,k)
 drop_key=false
end

function play_filler()
  pcs = {3,7,9,11,13,15,17,19,21}
  music(pcs[flr(rnd(#pcs))+1])
  music_count=30*(rnd(8)+8)
end

function get_music_id()
  -- pcs = {2,4,5,6,8,10,12,14,16,18,20,24,25}
  pcs = {}
  -- low intensity
  if (keycount<20) then
    add(pcs,2)
    add(pcs,4)
    add(pcs,5)
    add(pcs,6)
    add(pcs,12)
  end
  -- medium intensity
  if (keycount>10) then
    add(pcs,8)
    add(pcs,10)
    add(pcs,14)
    add(pcs,16)
    add(pcs,18)
  end
  -- high intensity
  if (keycount>20) then
    add(pcs,24)
    add(pcs,25)
  end

  return pcs[flr(rnd(#pcs))+1]
end

function play_music()
  if (endcount>0) return

  new_id = get_music_id()
  while (new_id == prev_id) do 
    new_id = get_music_id()
  end
  
  music(new_id)
  prev_id = new_id
  music_count=30*(rnd(8)+8)
end

function update_music()
 if (endcount>0) return
 
 if (music_count>0) then
  music_count-=1
 else
  play_filler()
 end
end

function play_footstep()
 fs+=1
 if (fs%2==0) then
  sfx(5)
 else
  sfx(7)
 end
end

function start_end()
 endcount+=1
 music(26)
end


function update_play()
 update_music()
 update_fade()

 if (gt<0 and keycount>16) then
  if (rnd(200)<1) then
   gt=rnd(keycount-16)
  end
 else
  gt-=1
 end


 if (endcount > 0) then
  endcount+=1
  debug_str = endcount
  if (gt<0) then
   gt=flr(endcount/300)
   if (endcount>1800) then
   	gt+=flr((endcount-1800)/50)
   end
  end
  if (endcount==end_timer) then
   cur_d = outro_text_2
   dia_music = true
   start_fade(0,16,1,fade_to_black,dialogue_state)
  end
 end

 if (saycount>0) saycount -=1 

 if (btn(0) and pl.state!=3 and not fading) then 
  pl.dx=-1.6
  pl.dir=-1 
  walk()
  if (pl.loc != 0 and pl.t%10==0) play_footstep()
 end
 if (btn(1) and pl.state!=3 and not fading) then 
  pl.dx=1.6
  pl.dir=1 
  walk()
  if (pl.loc != 0 and pl.t%10==0) play_footstep()
 end

 if (pl.loc==1) then
  if (abs(pl.dx)<0.1 and pl.state!=3) then
   idle()
  end
  
  if (btnp(4) and pl.state!=3) then
   jump()
  end
 end

 if (btnp(5)) then
  if (curr_key == nil) then
   if (pl.state<2) then
    for i=1,#keys do
     if (keys[i].dy==0 and abs(keys[i].x+2-pl.x)<8) pickup(keys[i])
    end
   end
  else
   curr_key.dx=pl.dx*2+pl.dir
   -- does this put the key in a wall?
   if (fget(mget(((pl.dir==1 and 16 or 0)+curr_key.x)/8, curr_key.y/8))==1) then
    curr_key.dx=0
   end

   -- drop it
   curr_key.dy=-2
   curr_key.loc=0
   curr_key = nil
  end
 end

 -- update all
 foreach(entities,update_entity)
 update_player_collision(pl)
 foreach(keys,update_key_collision)


 if (curr_key != nil) then
  if (pl.state!=3) then -- not jumping
   -- stick key to player hand
   curr_key.x = pl.x+11*pl.dir+pl.dir*(pl.frame%4-1)
   curr_key.y = pl.y-6+pl.frame%2 
   curr_key.dir = -pl.dir
  end
  -- not leave screen
  if (not door_opened) curr_key.x = max(curr_key.x,65)
  curr_key.x = min(curr_key.x,292)
 end

 -- picked up?
 if (pl.state==3) then
  if (pl.frame==1) idle()
 end


 if (not door_opened and ok_to_try and pl.x<76) then
  -- first test
  if (progress == 0) then
   progress += 1
   say("it's locked.")
   drop_key = true
   sfx(8)
  else
   if (curr_key != nil) then
    keystried += 1
    ok_to_try = false
    say(try_str[flr(rnd(8)+1)])
    drop_key = true
    sfx(8)
    if (keystried==5 or keystried==8) say(try_str[8])
    if (keystried==10) say(try_str[9])
    if (keystried==12) say(try_str[10])
    if (keystried>12 and rnd(100)>50) say(try_str[10+flr(rnd(6)+1)])
   end
  end
 end
 
 if (pl.x>100) ok_to_try=true

 -- drop keys?
 if (not door_opened and drop_key and pl.x>200 and rnd(50)<6) then
  k1 = keycount
  
  if (keycount<32) play_music()
  drop_next_key()
  if (keycount > 2 and rnd(100)<50) drop_next_key()   
  if (keycount > 9 and rnd(100)<50) drop_next_key()
  
  k2 = keycount
  
  if (k1 == k2 and endcount==0) then
   start_end()
  end
 
 end

 -- left screen (won game)
 if (pl.x < -10 and not fading) then
  cur_d = outro_text
  music(23)
  start_fade(0,16,1,fade_to_white,dialogue_state)
 end
end

function draw_play()
 rectfill(0,0,127,127,0)

 -- game
 cx=pl.x-56
 camera(mid(0,cx,191), 0)
 map(0,0,0,0,40,16) 
 foreach(entities,draw_entity)
 rectfill(242,0,269,16,0)
 rectfill(242,18,269,19,1)
 line(242,15,242,17,7)
 line(242,17,269,17,7)
 line(269,15,269,17,7)
 if (pl.x>270) pset(299,21,8)
 if (pl.x<90) pset(84,21,8)
 if (keystried==3 or keystried==8 or keystried==15) spr(68,304,40)

 -- talk the talk
 if (saycount > 0) then
  len = 2*#saytext
  sy = pl.y-50
  print_o(
   saytext, 
   mid(len+2, pl.x+8, 320-len-2), 
   sy, 
   7, 
   true
  )

 end
 
 -- hud
 camera()
 spr(64,0,0)
 spr(65,8,0)
 spr(66,16,0)
 spr(66,24,0)
 gx=70
 print("‹‘ walk", gx, 108, 5)
 print(" Ž  jump", gx, 114, 5)
 print(" —  grab/drop", gx, 120, 5)

 for i=0,gt do
   src = 0x6000 + flr(rnd(7000))
   dst = 0x6000 + flr(rnd(7000))
   memcpy(src, dst, rnd(min(gt,10)*99))
 end
end

function print_c(str,x,y,c)
 len = #str
 print(str,x-#str*2,y,c)
end

function print_o(str,x,y,c,center)
 local pr = (center and print_c or print)
 for px =-1,1 do
  for py =-1,1 do
   pr(str,x+px,y+py,0)
  end
 end
 pr(str,x,y,c)
end 

function update_key_collision(e)
 if ( e.loc == 0 ) then -- in air 
  if (fget(mget((e.x+8)/8,e.y/8)) == 1) then
   e.y=e.y-e.y%8
   e.dy=-e.dy*0.7
   e.dx*=0.8
   sfx(0)
   if (e.dy > -2) then
    e.dy=0
    e.dx=0
    e.loc=1
    sfx(0)
   end
  end
 end

-- collide with walls
 -- left
 if (fget(mget((e.x)/8,(e.y-4)/8)) == 1) then
  e.x=e.x+(8-e.x%8)
  e.dx=-e.dx*0.8
 end
 -- right
 if (fget(mget((e.x+15)/8,(e.y-4)/8)) == 1) then
  e.x=e.x-e.x%8
  e.dx=-e.dx*0.8
 end
end


function update_player_collision(e)
 -- collide with floor/roof
 if ( e.loc == 0 ) then -- in air 
  if (fget(mget((e.x+8)/8,e.y/8)) == 1) then
   e.y=e.y-e.y%8
   e.loc=1
   e.dy=0
   land()
  elseif (fget(mget((e.x+4)/8,(e.y-24)/8)) == 1) then
   e.y=e.y+(8-e.y%8)
   e.dy=0
  elseif (fget(mget((e.x+11)/8,(e.y-24)/8)) == 1) then
   e.y=e.y+(8-e.y%8)
   e.dy=0
  end
 end


 -- collide with walls
 -- left
 if (fget(mget((e.x+2)/8,(e.y-20)/8)) == 1) then
  e.x=e.x+(6-e.x%8)
  e.dx=0
 end
 -- right
 if (fget(mget((e.x+14)/8,(e.y-20)/8)) == 1) then
  e.x=e.x-e.x%8+2
  e.dx=0
 end
end



play_state = {
 name = "play",
 init = init_play,
 update = update_play,
 draw = draw_play
}


--------------------------------
-- entities 
--------------------------------
entities = {}

-- create and add entity
function make_entity(x,y)
 local e={}
 e.x = x
 e.y = y
 e.w = 1
 e.h = 1
 e.dx = 0 -- delta movement
 e.dy = 0
 e.ddy = 0 -- gravity
 e.ix = 0 -- inertia
 e.iy = 0
 e.t = 0 
 e.spr = 0 
 e.frame = 0
 e.frames = 0
 e.fs = 4
 e.visible = true
 e.dir = 1
 e.loc = 0 -- in air
 e.state = 0
 e.life = 0

 e.t = 0

 add(entities,e)

 return e
end

function update_entity(e)
 if (e.dy>4) e.dy=4
 if (e.loc==0) e.dy += e.ddy -- in air

 e.x += e.dx
 e.y += e.dy
 e.dx *= e.ix
 e.dy *= e.iy

 if (e.frames>0) then
  if (e.t % e.fs == 0) e.frame += 1
  if (e.frame==e.frames) e.frame=0
 end 

 e.t += 1
 if (e.life>0 and e.t>e.life) then
  del(entities,e)
 end
end




function draw_entity(e)
 if (e==pl) then
  spr((e.spr+e.frame)*e.w,e.x,e.y-e.h*8,e.w,e.h,e.dir==-1)
 else
  spr(e.spr+e.frame,e.x,e.y-e.h*8,e.w,e.h,e.dir==-1)
 end
end

--------------------------------
-- state swapping 
--------------------------------
state = {}
next_state = {}
change_state = false

function swap_state(s)
 next_state = s
 change_state = true
end

--------------------------------
-- core functions 
--------------------------------
function _update()
 if (change_state) then
  state = next_state
  change_state = false
  entities = {}
  state.init()
 end

 state.update() 
end

function _draw()
 state.draw()
 
 -- debug, 175 tokens
 if (debug) then
  camera()
  
  local str = state.name .. " "
    
  if (btn(0)) str = str .. "‹"
  if (btn(1)) str = str .. "‘"
  if (btn(2)) str = str .. "”"
  if (btn(3)) str = str .. "ƒ"
  if (btn(4)) str = str .. "Ž"
  if (btn(5)) str = str .. "—"  

  str = str .. " " .. debug_str
  
  local mr = stat(0)/1024

  local ypos = 119
  if (debug_at_top) ypos=2
  rectfill(0,ypos,127,ypos+6,0)
  
  line(0, ypos+2, 7, ypos+2, 1)
  line(0, ypos+2, min(7*stat(1),7), ypos+2, (stat(1)>1 and 8 or 12))
  
  line(0, ypos+4, 7, ypos+4, 2)
  line(0, ypos+4, min(7*mr,7), ypos+4, (mr>1 and 8 or 14))
  print(str,9,ypos+1,7)

  debug_str = ""
 end
 
end

-- end of code
