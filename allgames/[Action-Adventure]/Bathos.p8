function init_glitch()
end

count=0
function update_glitch()
 if (count>30) swap_state(title_state)
 count+=1 
end

function draw_glitch()
 src = 0x6000 + flr(rnd(7000))
 dst = 0x6000 + flr(rnd(7000))
 memcpy(src, dst, rnd(min(count,10)*99))
end


glitch_state = {
 name = "glitch",
 init = init_glitch,
 update = update_glitch,
 draw = draw_glitch
}


