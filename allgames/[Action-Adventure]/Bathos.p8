function init_title()
 cls()
 menuitem(1)
 fade(16,fade_to_black)
 start_fade(16,0,-1,fade_to_black,nil)
 -- play menu music
 music(22)
end

t=0
function update_title()
 update_fade()

 if (btnp(4) and not fading) then
  cur_d = intro_text
  sfx(1)
  start_fade(0,16,1,fade_to_black,dialogue_state)
 end 
 t+=0.03
end

function rnd_shake()
 if (rnd(200)<1) then
  camera(rnd(100)-50,rnd(100)-50)
 end
end

function draw_title() 
 camera(0,0)
 rectfill(0,0,127,127,5)
 rectfill(0,32,127,52,0)
 
 camera(0,0)
 rnd_shake()
 
 sspr(104,56,24,8, 29,32,72,24)

 camera(0,0)
 rnd_shake()

 r=7
 spr(110,10+r*cos(t),39+r*sin(t))
 spr( 94,10+r*cos(t-0.1),39+r*sin(t-0.1))
 spr( 94,10+r*cos(t-0.2),39+r*sin(t-0.2))
 spr( 78,10+r*cos(t-0.3),39+r*sin(t-0.3))

 camera(0,0)
 rnd_shake()

 spr(110,110+r*cos(-t+0.5),39+r*sin(-t+0.5))
 spr( 94,110+r*cos(-t+0.6),39+r*sin(-t+0.6))
 spr( 94,110+r*cos(-t+0.7),39+r*sin(-t+0.7))
 spr( 78,110+r*cos(-t+0.8),39+r*sin(-t+0.8))

 camera(0,0)
 rnd_shake()

 print_c("press Ž to play",62,56,7)

 camera(0,0)
 rnd_shake()

 print_c("created by   johanpeitz",64,114,13)
 spr(111,62,113)

 camera(0,0)
 rnd_shake()

 print_c("music by   gruber_music",64,121,13)
 spr(111,54,120)
end

title_state = {
 name = "title",
 init = init_title,
 update = update_title,
 draw = draw_title
}

