-- update functions



-- gamestate functions

function switchscreen()

 if btnp(—) and gamestate == "titlescreen" then
    gamestate = "ingame"
     timer_seconds = 1800
     timer_minutes = 0
     score = 0
  elseif btnp(4) and gamestate == "gameover" then
    gamestate = "titlescreen"
     timer_seconds = 1800
     timer_minutes = 0
     score = 0
     music()
  elseif btnp(4) and gamestate == "times up" then
    gamestate = "titlescreen"
     timer_seconds = 1800
     timer_minutes = 0
     score = 0
     music()
 	elseif btnp(—) and gamestate == "gameover" then
   	gamestate = "ingame"
   	 timer_seconds = 1800
     timer_minutes = 0
     score = 0
     music()
 	elseif btnp(—) and gamestate == "times up" then
  		gamestate = "ingame"
  		 timer_seconds = 1800
     timer_minutes = 0
     score = 0
     music()
 end

end

function wincondition()
 
 if player.x >= 120 and
  player.x <= 126 and
  player.y >= 80 and
  player.y <= 86 and 
  wormstate == 1 then
   score += 1
   blood()
   wormstate = flr(rnd(6) +1)
   timer_seconds += 120
   frame = 0
   lightning = true
 elseif player.x >= 8 and
  player.x <= 16  and
  player.y >= 16  and
  player.y <= 24 and 
  wormstate == 2 then
   score += 1
   blood()
   wormstate = flr(rnd(6) +1)
   timer_seconds += 120
   frame = 0
   lightning = true
 elseif player.x >= 0 and
  player.x <= 8 and
  player.y >= 96 and
  player.y <= 104 and 
  wormstate == 3 then
   score += 1
   blood()
   wormstate = flr(rnd(6) +1)
   timer_seconds += 120
   frame = 0
   lightning = true
 elseif player.x >= 120 and
  player.x <= 126 and
  player.y >= 24 and
  player.y <= 30 and 
  wormstate == 4 then
   blood()
   score += 1
   wormstate = flr(rnd(6) +1)
   timer_seconds += 120
   frame = 0
   lightning = true
 elseif player.x >= 32 and
  player.x <= 40 and
  player.y >= 48 and
  player.y <= 56 and 
  wormstate == 5 then
   score += 1
   blood()
   wormstate = flr(rnd(6) +1)
   timer_seconds += 120
   frame = 0
   lightning = true
 elseif player.x >= 120 and
  player.x <= 126 and
  player.y >= 48 and
  player.y <= 56 and 
  wormstate == 6 then
   score += 1
   blood()
   wormstate = flr(rnd(6) +1)
   timer_seconds += 120
   frame = 0
   lightning = true   
 end

end


--- player updates animation aso
function move_player(d)

 if btn(d) then
  player.x += player.v[d+1].x
  player.y += player.v[d+1].y
  
  player.d = d+1
  player_animation()
  player_mappos()
  
  if fget(player.m, 0) then
   player.x -= player.v[d+1].x
   player.y -= player.v[d+1].y
  end
  return true
 end
 return false
 
end


function player_animation()

 if frame%player.va == 0 then
  player.a += 1
  if player.a > #player.frames[player.d] then
   player.a -= #player.frames[player.d]
  end
 end
 
end


function player_mappos()

 player.m = mget(player.x/8, player.y/8)

end


function checkspot(_x,_y,_flag)

 local tilex=_x/8
 local tiley=_y/8
 local tile=mget(tilex,tiley)
 return fget(tile,_flag)
 
end


function hitwall(_x,_y)

 if (checkspot(_x  ,_y  ,0)) return true
 if (checkspot(_x+7,_y  ,0)) return true
 if (checkspot(_x  ,_y+7,0)) return true
 if (checkspot(_x+7,_y+7,0)) return true
 return false
 
end


function player_border_col()

 if player.x <= 2 then
   player.x =2 end
 if player.x >= 125 then
   player.x =125 end
 if player.y <= 6 then
   player.y =6 end
 if player.y >= 126 then
   player.y =126
 end

end


--- cat update animation aso
function cat_movement()

 for cat in all (cats) do
  cat.x += cat.xv
  cat.y += cat.yv
  
  if cat.brain==1 then
   catai_vert(cat)
  elseif cat.brain==3 then
   catai_chkp(cat)
  end
 end
 
end

function catai_vert(cat)

 if hitwall(cat.x,cat.y) or cat.y<0 then
  cat.yv=-cat.yv
 end
 
end

function catai_vert(cat)

 if hitwall(cat.x,cat.y) or cat.y<0 then
  cat.yv=-cat.yv
 end
 
end

function catai_chkp(cat)

 for chkp in all (cat.chkp) do 
  if cat.x==chkp.x and cat.y==chkp.y then
   cat.xv=chkp.xv
   cat.yv=chkp.yv 
  end
 end
 
end


function cats_animation(cat)

 for cat in all (cats) do 
  if cat.xv == -1 and cat.yv == 0
  then cat.sp = 49
   elseif cat.xv == 1 and cat.yv == 0
   then cat.sp = 33
    elseif cat.xv == 0 and cat.yv == 1
    then cat.sp = 36
     elseif cat.xv == 0 and cat.yv == -1
     then cat.sp = 35
  end
 end

end


--- collision player & cat
function check_for_collision(player, cat, size)
  
--- collision with x coord  
 if col(player.x,player.y-8,cat.x,cat.y) then
  sfx(8)
  return true 
 end  
 return false
 
end


function col(plx,ply,ox,oy)

 if plx<ox then return false end
 if ply+6<oy then return false end
 
 if plx>ox+10 then return false end
 if ply>oy+2  then return false end
 
 return true
 
end


--- timer
function timer_update()

 timer_seconds -= 1
 
  if timer_seconds == 0 then
   timer_minutes -= 1
   timer_seconds = 1800
  end
  
  if timer_minutes == -1 then
    gamestate = "times up"
  end
  
end


function update_worm()

 if wormstate == 1 then
   worm.x = 120
   worm.y = 80
 elseif wormstate == 2 then
   worm.x = 8
   worm.y = 16
 elseif wormstate == 3 then
   worm.x = 0
   worm.y = 96
 elseif wormstate == 4 then
   worm.x = 120
   worm.y = 24
 elseif wormstate == 5 then
   worm.x = 32
   worm.y = 48
 elseif wormstate == 6 then
   worm.x = 120
   worm.y = 48
 end
 
end


function lightningstrike()

 if frame<=15 then
   lightning = true
   sfx(9)
 elseif frame <= 20 then
   lightning = false
 elseif frame <= 25 then
   lightning = true
  else lightning = false
 end
 if lightning == true then
   palt(0, true)
   else palt(0, false)
 end
 
end


function high_score()

 if score >= highscore then
   highscore = score
 end
 
end



