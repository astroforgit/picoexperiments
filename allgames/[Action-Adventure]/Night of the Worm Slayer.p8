-- debugg/help function


function draw_debugg()
 print("player.m")
 print(collision_x)
 print(collision_y,0,10)
 
end

function draw_hitbox(player, size)

local size = 8
  rect(player.x-4,
       player.y-6,
       player.x+4,
       player.y,10)
  rect(cat2.x+size,
       cat2.y+size,
       cat2.x,
       cat2.y)
  rect(cat1.x+size,
       cat1.y+size,
       cat1.x,
       cat1.y,10)
  rect(cat3.x+size,
       cat3.y+size,
       cat3.x,
       cat3.y,10)
  rect(cat4.x+size,
       cat4.y+size,
       cat4.x,
       cat4.y,10)
       
end
