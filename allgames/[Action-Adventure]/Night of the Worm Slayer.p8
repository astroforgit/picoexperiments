pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
-- nina treuberg & florian tamm
-- pico-8 prototyping


function _init()
	
	palt(11, true) -- green color as transparency is true
	palt(0, false) -- black color as transparency is false
	music()
	blood_number=10
	droplets={}
	timer_seconds = 1800
	timer_minutes = 0
	frame = 0
	score = 0
	highscore = 0
	gamestate = "titlescreen"
	
	presstext = {  x = {32,54},
	               y = 139,
	              xv = 1,
	              yv = 1
	            }
	            
	wormslayertext = {
	                  x = 32,
	                  y = -20,
	                 yv =  1
	                 }
	                 
	 player = {
        x = 4,
        y = 7,
        v = { --player movementspeed
             {x = -1, y =  0},
             {x =  1, y =  0},
             {x =  0, y = -1},
             {x =  0, y =  1}
            },
        d = 1,  -- direction
        a = 1,  -- animation
       va = 5,  -- animation speed
   frames = {   -- player sprite
           {17,18},
           { 1, 2},
           { 3,19},
           { 4,20}
            },
       sp = 24, --player start sprite
        m = 0 
                           
	         }
	         
 chkp1={
            {
             x=64,
             y=80,
             xv=0,
             yv=1
            },
            {
             x=64,
             y=112,
             xv=1,
             yv=0
            },
            {
             x=80,
             y=112,
             xv=0,
             yv=-1
            },
            {
             x=80,
             y=80,
             xv=-1,
             yv=0
            }
           }
 
 cats={}  
	   cat1 = {
       x = 24,
       y =  8,
      xv =  0,
      yv =  1,
      sp = 33,
      brain = 1
        }     
 			cat2 = {
       x = 72,
       y = 24,
      xv =  0,
      yv =  1,
      sp = 33,
      brain = 1
        }
 			cat3 = {
       x = 64,
       y = 96,
      xv =  0,
      yv =  1,
      sp = 33,
   brain = 3,
    chkp = chkp1
        }
 			cat4 = {
       x = 80,
       y = 110,
      xv =  0,
      yv =  1,
      sp = 33,
    brain = 3,
    chkp = chkp1
        }
	
	add(cats,cat1)
	add(cats,cat2)
	add(cats,cat3)
	add(cats,cat4)
	
	worm = {
	   x = 120,
	   y = 80,
	  sp = 21
	       }
	wormstate = flr(rnd(5)+1)
	
 rain = {}
 lightning = false
 for i = 1, 64 do
  x=create_raindrop()
  add(rain,x)
 end	
 
 part={} 
 stept=0
 
end


function _update()

 frame += 1
 if frame == 300 then
  frame = 0
 end
 
 -- cart starts in the 
 --titlescreen
 if gamestate == "titlescreen" then
 switchscreen()
 blink_text()
 update_text_up()
 update_text_down()
 score = 0
 for r in all(rain) do
  r.x += r.xv
  r.y += r.yv
  if r.x >= 128 or
     r.y >= 128 then
    del(rain,r)
    add(rain,create_raindrop())
  end
 end
 
 
 -- this section is all about
 -- ingame things
 elseif gamestate == "ingame" then
 
  timer_update()
  update_worm()
  high_score()
  update_blood()
  local moved=false
  for d = 0, 3 do
 	 if move_player(d) then moved=true end
 	end
 	if moved then
 	 stept+=1
 	 if stept>=8 then
 	  stept=0
  	 splash(player.x,player.y+1)
  	end
 	end
 	player_mappos()
 	player_border_col()
 	cat_movement()
 	cats_animation()
  lightningstrike()
  update_part()
 	
 	for r in all(rain) do
   r.x += r.xv
   r.y += r.yv
   if r.x >= 128 or
      r.y >= 128 then
    del(rain,r)
    add(rain,create_raindrop())
   end
  end
 	 
  for cat in all (cats) do
 	 if check_for_collision(player, cat, 8) == true
 	 then gamestate = "gameover"
 	 end
  end
  wincondition()
 
  
  -- this is the section when
  -- u lost
 elseif gamestate == "gameover" then
   switchscreen()
   blink_text()
   player.x = 4
   player.y = 7
   
    
  for r in all(rain) do
   r.x += r.xv
   r.y += r.yv
    if r.x >= 128 or
       r.y >= 128 then
     del(rain,r)
     add(rain,create_raindrop())
    end
  end

 --this section is when ur
 --time is up
 elseif gamestate == "times up" then
  switchscreen()
  player.x = 4
  player.y = 7
	end
		
end


function _draw()

 if gamestate == "titlescreen" then
 	cls()
 	draw_title()
 
 elseif gamestate == "ingame" then
 	cls()
 	sfx(7)
 	map(0,0,0,0) 	
--- worm stuff
		draw_blood()
 	draw_worm() 	
--- draw foorprints
		draw_part()	
--- draw player
		spr(player.frames[player.d][player.a],
	   	 player.x - 4,
	   	 player.y - 7)   	    
  draw_cats()
  draw_rain()
--- draw field of view
 	draw_fov()
 	draw_timer()
 
 elseif gamestate == "times up" then
  draw_times_up()
  blink_text()
 
 elseif gamestate == "gameover" then 
	 draw_gameover()
 end
 
end
