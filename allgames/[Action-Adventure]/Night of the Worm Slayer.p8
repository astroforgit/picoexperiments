-- draw functions

function draw_title()

	cls ()
	sspr(0,75,64,56,0,26,128,110)
 print ("night of the",wormslayertext.x+10,wormslayertext.y-6,1)
 spr(96,wormslayertext.x,wormslayertext.y,9,2)
 print ("press   to start",presstext.x[1],presstext.y,6)
 print ("—",presstext.x[2],presstext.y,blink)
	
	if frame<3 then
		spr(14,90,50)
	else
		spr (30,92,50)
	end

end


function draw_gameover()

		cls()
		music(-1)
		spr (152,30,40,159,40)
  print("oh dayum u lost!",30,20,12)
  print("worms slayed:"..score,32,30,2)
		print ("highscore:"..highscore,40,100,2)
		print("your leftover time:"..flr(timer_seconds/30),20,110,2)
		print("press   to play again",19,120,6)
		print("—",41,120,blink)
		
	if frame<3 then
		spr(46,50,63)
	else
		spr (62,50,63)
	end
	
end


function draw_times_up()

	cls()
	music(-1)
	spr (152,30,40,159,40)
 print("time`s up!",40,20,12)
 print ("highscore:"..highscore,40,100,2)
	print("press   to play again",19,120,6)
	print("—",41,120,blink)
			
	if frame<3 then
		spr(46,50,63)
	else
		spr (62,50,63)
	end

end


--- field of view
function draw_fov() 
	
	if (frame%7<3) then
		spr(10,player.x-17,player.y-17,4,4)
	else
		spr(74,player.x-17,player.y-17,4,4)
	end
	
	 if lightning == false then
  	rectfill(0,0,127,player.y-18,0)    
   rectfill(0,127,127,player.y+15,0) 
   rectfill(0,0,player.x-18,127,0) 
   rectfill(127,0,player.x+15,127,0)
  end

end


function draw_worm()
 
 if frame%7 > 3 then
	   spr(5,worm.x,worm.y)
 elseif wormstate == 1 then
		spr(21,worm.x,worm.y)
		elseif frame%7 > 3 then
	   spr(5,worm.x,worm.y)
	elseif wormstate == 2 then
		spr(21,worm.x,worm.y)
		elseif frame%7 > 3 then
	   spr(5,worm.x,worm.y)
	elseif wormstate == 3 then
	  	spr(21,worm.x,worm.y)
	 elseif frame%7 > 3 then
	   spr(5,worm.x,worm.y)
	elseif wormstate == 4 then
	  	spr(21,worm.x,worm.y)
	  	elseif frame%7 > 3 then
	   spr(5,worm.x,worm.y)
	elseif wormstate == 5 then
	 	spr(21,worm.x,worm.y)
	 	elseif frame%7 > 3 then
	   spr(5,worm.x,worm.y)
	elseif wormstate == 6 then
	 	spr(21,worm.x,worm.y)
 end
 
end



function draw_cats()

 for cat in all (cats) do
  spr(cat.sp,
      cat.x,
      cat.y
     )
 end
   
end


function draw_rain()

 for r in all(rain) do
  line(r.x,r.y,r.x+r.xv,r.y+r.yv,12)
 end

end


function draw_timer()

 print(flr(timer_seconds/30),120,1,8)
 spr(37,110,0)

end



-->8
-- juce

--- text slide
function update_text_up()
    
 presstext.y -= presstext.yv
   
  if presstext.y == 121 then
    presstext.yv = 0
  end

end


function update_text_down()
    
 wormslayertext.y += wormslayertext.yv
   
  if wormslayertext.y == 8 then
   wormslayertext.yv = 0
  end

end


--- blinking text
function blink_text()

	if frame>6 then
		frame=0
		if blink==6 then
			blink=8
		else
			blink=6
		end
	end
	
end


--- rain
function create_raindrop()

  local raindrop = {
               x = rnd(128+64) - 64,
               y =  -rnd(32),
              sp =  0,
              xv =  1+rnd(1),
              yv =  2+rnd(2)
  }
  return raindrop       
end


--- footprints
function splash(sx,sy)

 for i=1,10 do
  local newp={}
  newp.x=sx
  newp.y=sy
  newp.yv=-rnd()*1
  newp.xv=(rnd()-0.5)*0.6
  newp.age=0
  newp.mage=15
  newp.groundy=sy
  add(part,newp) 
 end 

end


function update_part()

 for p in all(part) do
  p.x+=p.xv
  p.y+=p.yv
  p.age+=1
  p.yv+=0.1
  if p.age>=p.mage or p.y>p.groundy then
   del(part,p)
  end
 end
 
end


function draw_part()

 for p in all(part) do
  pset(p.x,p.y,12)
 end
 
end


--- wormblood
function blood ()

	for i=1, blood_number do
		local d = {
				x  = player.x,
				y  = player.y,
				xv = (rnd(8)-4)/6,
				yv = (rnd(4)-4)/6,
				c  = 8
				}
				add(droplets,d)
	end
	
end


function update_blood()

	for b in all(droplets) do
		b.x += b.xv
		b.y += b.yv
		if b.x < (player.x-8) or b.x > (player.x+8)
  or b.y < (player.y-8) or b.y > (player.y+8) then
   del(droplets, b)
  end
 end
 
end 


function draw_blood()

 for b in all(droplets) do
  pset(b.x,b.y,b.c)
 end
 
end


