pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
--lost crown
-- by narque

function _init()
    map_setup()
	make_player()
	make_ghost()
	game_win=false
	game_over=false
end

function _update()
if (not game_over) then
	update_map()
	move_player()
	move_ghost()
	check_win_lose()
else
		if (btn(—)) extcmd("reset")
	end
end

function _draw()
	cls()
	if (not game_over) then

	draw_map()
	draw_player()
	draw_ghost()
	if (btn(—)) show_inventory()
	else
	draw_win_lose()
end
end


-->8
-- map code
function map_setup()
--timers
timer=0
anim_time=30
 --map tile settings
 wall={37,58,105,106,89,90,87,85,73,74,3,19,18,17,53,51,42,12,13,14,28,29,30,44,45,46,65,67,97,99,69,70,86,72}
 key={21}
 door={53}
 door2={51}
	door3={58}
 anim1={24}
 anim2={25}
 lose={24,7}
 win={8}
 gold={49}
	tool={60}
end

function update_map()
	if (timer<0) then
		toggle_tiles()
		timer=anim_time
		end
		timer-=1
end

function draw_map()
	mapx=flr(p.x/16)*16
	mapy=flr(p.y/16)*16
	camera(mapx*8,mapy*8)

	map(0,0,0,0,128,64)
end

function is_tile(tile_type,x,y)
	tile=mget(x,y)
	for i=1,#tile_type do
		if (tile==tile_type[i]) return true
	end
	return false
end

function can_move(x,y)
return not is_tile(wall,x,y)
end


function swap_tile(x,y)
	tile=mget(x,y)
	mset(x,y,tile+1)
end

function unswap_tile(x,y)
	tile=mget(x,y)
	mset(x,y,tile-1)
end

function get_key(x,y)
	p.keys+=1
	swap_tile(x,y)
	sfx(1)
end

function get_gold(x,y)
	p.gold+=1
	swap_tile(x,y)
	sfx(4)
end
function get_tool(x,y)
	p.tool+=1
	swap_tile(x,y)
	sfx(1)
end

function open_door(x,y)
	p.keys-=1
	swap_tile(x,y)
	sfx(2)
	end

function open_gold(x,y)
	p.gold-=1
	swap_tile(x,y)
	sfx(2)
	end
	function open_door3(x,y)
		p.tool-=1
		swap_tile(x,y)
		sfx(2)
		end


-->8
--player code
function make_player()
	p={}
	p.x=7
	p.y=2
	p.sprite=4
	p.keys=0
	p.gold=0
	p.tool=0
end

function draw_player()

	spr(p.sprite,p.x*8,p.y*8)
	end

function move_player()
	newx=p.x
	newy=p.y

	if (btnp(‹)) newx-=1
	if (btnp(‘)) newx+=1
	if (btnp(”)) newy-=1
	if (btnp(ƒ)) newy+=1

	interact(newx,newy)

	if (can_move(newx,newy)) then
	p.x=mid(0,newx,127)
	p.y=mid(0,newy,63)
	else
	sfx(0)
	end
	end

function interact(x,y)
	if (is_tile(key,x,y)) then
			get_key(x,y)
		elseif (is_tile(door,x,y)
		and p.keys>0) then
			open_door(x,y)
			elseif (is_tile(gold,x,y))then
			get_gold(x,y)
			elseif (is_tile(door2,x,y)
		and p.gold>0) then
		open_gold(x,y)
	elseif (is_tile(tool,x,y))then
	get_tool(x,y)
	elseif (is_tile(door3,x,y)
and p.tool>0) then
open_door3(x,y)
		end
end




-->8
-- inventory code
function show_inventory()
	invx=mapx*8+40
	invy=mapy*8+8

	rectfill(invx,invy,invx+62,invy+36,0)
	print("inventory",invx+12,invy+5,7)
	print("tools "..p.tool,invx+12,invy+14,9)
	print("keys "..p.keys,invx+12,invy+20,9)
	print("golden key "..p.gold,invx+12,invy+26,9)
end

-->8
-- animation code

function toggle_tiles()
	for x=mapx,mapx+15 do
		for y=mapy,mapy+15 do
			if (is_tile(anim1,x,y))then
				swap_tile(x,y)
				sfx(3)
			elseif (is_tile(anim2,x,y)) then
				unswap_tile(x,y)
				sfx(3)
			end
		end
	end
end

-->8
--win or lose

function check_win_lose()
	if (is_tile(win,p.x,p.y)) then
		game_win=true
		game_over=true
	elseif (is_tile(lose,p.x,p.y)) then
		game_win=false
		game_over=true
	elseif (g.x == p.x and g.y == p.y) then
		game_win=false
		game_over=true
	end
end

function draw_win_lose()
		camera()
	if (game_win) then
		print("’you win!’",37,64,7)
		else
			print("game over!",42,64,7)
	end
	print("press — to play again",20,72,5)
end

-->8
-- ghost
function make_ghost()
	g={}
	g.x=3
	g.y=13
	g.sprite=7
end
function draw_ghost()
		spr(g.sprite,g.x*8,g.y*8)
	end
	function move_ghost()
		if (p.x > g.x) g.x+=1/32
		if (p.x < g.x) g.x-=1/32
		if (p.y > g.y) g.y+=1/32
		if (p.y < g.y) g.y-=1/32
end
