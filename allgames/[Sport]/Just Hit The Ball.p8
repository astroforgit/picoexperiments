pico-8 cartridge // http://www.pico-8.com
version 15
__lua__
--just hit the ball
--by trasevol_dog

score_to_win=10

cartdata("trasevol_bolley")

title=true
music(0)

function _init()
 colliders={
  {x=64,y=100,w=4,h=24}
 }
 
 if dget(0)==0 then
  mode=0
 else
  mode=dget(0)-2
 end
 change_difficulty(true)

 smoke={}
 shine={}
 
 init_players()
 init_ball()

 won=false
 gamestart=5
 t=0
 
 lwin=flr(rnd(2))
 
 shkx,shky=0,0
end

function _update()
 t+=0.01
 
 update_shake()
 
 if gamestart>-0.6 and not title then
  gamestart-=0.033
  if gamestart<=0 and gamestart>-0.033 then
   ball.vx=(lwin-0.5)*2*2
   ball.vy=-1
  end
  
  if gamestart%1>=1-0.033 then
   if gamestart<0 then
    sfx(6)
   else
    sfx(5)
   end
  end
 end
 
 if gamestart<0 or title then
  update_ball() 
 end
 
 if ball.y>104 and not won and not title then
  flip()
  local k=(flr(ball.x/64)+1)%2
  cls(8+k)
  flip()
  players[k].score+=1
  
  lwin=k
  
  local cols={{8,14},{9,10}}
  for i=0,15 do
   create_smoke(ball.x,ball.y,pick(cols[k+1]))
  end
  
  if players[k].score>=score_to_win then
   won=k
   players[k].score=10
   add_shake(8)
   sfx(4)
   music(0)
  else
   init_ball()
   gamestart=3
   add_shake(2)
   sfx(3)
  end
 end
 
 update_players()
 
 foreach(smoke,update_smoke)
 foreach(shine,update_shine)

 if won then
  local a=t*2
  winx=64.5+sgn(won-0.5)*28-6*4+4*cos(a)
  winy=54+4*sin(a*2)
  create_smoke(winx+rnd(48),winy+rnd(8),7+rnd(9))
  if rnd(2)<1 then
   create_shine(winx+rnd(48),winy+rnd(8))
  end
 end
 
 if won or title then
  if btn(2) and btn(2,1) then
   _draw()
   flip()
   flip()
   flip()
   flip()
   _init()
   music(-1)
   sfx(7)
   
   title=false
  end
 end

 if rnd(8)<1 then 
  create_shine(ball.x+rnd(8)-4,ball.y+rnd(8)-4)
 end
end

function _draw()
 camera(shkx,shky)
 cls()

 palt(0,false)
 for x=8,119,8 do
  for y=16,103,8 do
   spr(72,x,y)
  end
  if x<64 then
   spr(88,x,104)
  else
   spr(89,x,104)
  end
 end
 palt(0,true)
 
 draw_players()

 draw_ball()

 foreach(smoke,draw_smoke)
 foreach(shine,draw_shine)
 
 outlined_spr(20,60,88,1,3)
 
 draw_gameframe()
 
 draw_score()
 
 if title then
  draw_title(32,105,96,72,0)
 end
 
 if won then
  outlined_spr(176,winx,winy+8,6,1,false,false,0)
  
  draw_title(28,108,118)
--[[
   str="press ” together to restart"
   local ofs={0,{0,-1},{-1,0},{1,0},{-1,1},{1,1},{0,2},13,{0,1},7,{0,0}}
   local c
   for o in all(ofs) do
    if type(o)=="table" then
     if t%0.8>=0.2 then
      print(str,64-#str*2+o[1],118+o[2],c)
     end
     
     if btn(2,0) then
      print('”',32+o[1],108+o[2],c)
     end
     
     if btn(2,1) then
      print('”',88+o[1],108+o[2],c)
     end
    else
     c=o
    end
   end
--]]

 end
 
-- debug=true
 if debug then
  for o in all(colliders) do
   rectfill(o.x-o.w/2,o.y-o.h/2,o.x+o.w/2-1,o.y+o.h/2-1,11)
  end
  
  rectfill(0,0,48,8,0)
  print("cpu:"..(stat(1)*100).."%",0,0,7)
 end
 
 if not title then
  if gamestart>0 then
   local n=flr(gamestart+1)
   local y=60-abs(8*sin(gamestart*.5))
   outlined_spr(128+n,60,y,1,1,false,false,0)
  elseif gamestart>-0.2 then
   outlined_spr(139,56+(2+gamestart*10)*cos(gamestart*8),60,2,1,false,false,0)
  end
 end
end


function update_players()
 for k,p in pairs(players) do
--  local k=k-1
  local spd=1
  if btn(0,k) then
   p.vx-=spd
  end
  if btn(1,k) then
   p.vx+=spd
  end
  
  p.x+=p.vx
  p.mt+=p.vx*0.01
  p.vx*=0.5
  
  local sid=k*2-1
  p.x=mid(p.x,64.5+sid*49,64.5+8*sid)

  p.bod.x=p.x
  
  if p.y<=0 then
   if btnp(4,k) or btnp(5,k) then
    local pow=0
    if btnp(4,k) then
     pow=5
     sfx(1)
    elseif btnp(5,k) then
     pow=10
     sfx(2)
    end
   
    local y,d=get_to_ball(p)
    
    p.y=y
    p.vy=0
    p.st=0
    
    if d<=12 then
     local a=atan2(ball.x-p.x,ball.y-96+y)
     local co,si=cos(a),sin(a)
     ball.vx=pow*co
     ball.vy=pow*si
     local l=12-d
     ball.x+=l*co
     ball.y+=l*si
     
     local n=pow*1.6
     cols={{8,14},{9,10}}
     for i=1,n do
      create_smoke((ball.x+p.x)/2,(ball.y+96-p.y)/2,pick(cols[k+1]))
     end
     
     _draw()
     flip()
     
     if pow>8 then
     add_shake(3)
     end
    else
    
    end
   end
  else
   p.y+=p.vy
   p.vy-=0.5
   
   if p.y<=0 then
    p.y=0
    p.vy=0
   end
  end
  
  d=dist(p.x,96-p.y,ball.x,ball.y)
  if d<12 then
   local a=atan2(ball.x-p.x,ball.y-96+p.y)
   local co,si=cos(a),sin(a)
   ball.vx=4*co
   ball.vy=4*si
   local l=12-d
   ball.x+=l*co
   ball.y+=l*si
   sfx(0)
  end
  
  p.t+=0.01
  p.st+=0.01
 end
end

function get_to_ball(p)
 local d
 local yy=70
 for y=0,70 do
  d=sqrdist(p.x,96-y,ball.x,ball.y)
  if d<sqr(12) then
   d=sqrt(d)
   yy=y
   break
  end
 end

 return yy,d
end

function update_ball()
 obx,oby=ball.x,ball.y

 local vk=1+(mode-1)*0.2
 ball.x+=vk*ball.vx
 ball.y+=vk*ball.vy
 ball.vx*=0.99
 ball.vy*=0.99
 
 ball.vy+=0.3

 local coef=-0.6
 local b=ball
 local col=false
 for o in all(colliders) do
  if abs(o.x-b.x)<o.w/2+b.r and abs(o.y-b.y)<o.h/2+b.r then
   local hc=abs(o.x-obx)<o.w/2+b.r
   local vc=abs(o.y-oby)<o.h/2+b.r
   
   if (hc and vc) or not(hc or vc) then
    b.x=o.x+sgn(obx-b.x)*(o.w/2+b.r)
    b.y=o.y+sgn(oby-b.y)*(o.h/2+b.r)
    b.vx*=coef
    b.vy*=coef
    b.vx+=2*sgn(obx-b.x)
    b.vy+=2*sgn(oby-b.y)
   elseif hc then
    b.y=o.y+sgn(oby-b.y)*(o.h/2+b.r)
    b.vy*=coef
    b.vy+=2*sgn(oby-b.y)
   elseif vc then
    b.x=o.x+sgn(obx-b.x)*(o.w/2+b.r)
    b.vx*=coef
    b.vx+=2*sgn(obx-b.x)
   end
   
   col=true
  end
 end
 
 local coef=-0.9
 
 if ball.x<12 then
  ball.x=12
  ball.vx*=coef
  col=true
 end
 
 if ball.x>=116 then
  ball.x=115+0x.ffff
  ball.vx*=coef
  col=true
 end
 
 if ball.y<20 then
  ball.y=20
  ball.vy=abs(ball.vy)
  col=true
 end
 
 if ball.y>=108 then
  ball.y=107+0x.ffff
  ball.vy*=coef
  col=true
 end
 
 if col then
  sfx(0)
 end
end

function update_smoke(s)
 s.x+=s.vx
 s.y+=s.vy
 
 s.vx*=0.9
 s.vy=lerp(s.vy,-1,0.1)
 
 s.y=max(s.y,16)
 
 s.r-=0.08
 if s.r<0 then
  del(smoke,s)
 end
end

function update_shine(s)
 s.t+=0.75
 if s.t>=6 then
  del(shine,s)
 end
end

function change_difficulty(nopause)
 mode=(mode+1)%3
 strs={"easy","norm","hard"}
 menuitem(1,"difficulty: "..strs[mode+1],change_difficulty)
 
 if not nopause then
  dset(0,mode+1)
  extcmd("pause")
 end
end

function add_shake(p)
 local a=rnd(1)
 shkx+=p*cos(a)
 shky+=p*sin(a)
end

function update_shake()
 if abs(shkx)+abs(shky)<0.5 then
  shkx,shky=0,0
 end
 
 shkx*=-0.7-rnd(0.2)
 shky*=-0.7-rnd(0.2)
end


function draw_players()
 for k,p in pairs(players) do
--  local k=k-1
  local y
  if abs(p.vx)>0.1 then
   y=flr(97+sin(p.mt*8))
  else
   y=96
  end
  
  outlined_spr(k*2,p.x-8,y,2,2)
 
  for c=0,15 do
   pal(c,7)
  end

  spr(6,p.x-7,104,2,2)
  spr(6,p.x-9,104,2,2)

  for c=0,15 do
   pal(c,c)
  end
  
  spr(6,p.x-8,104,2,2)
  
  local by
  if p.y>0 then
   by=86-p.y
  else
   by=86+round(cos(p.t*8))
  end
  
  if p.st<0.08 then
   local i=flr(p.st*50)
   local x=flr(p.x)
   local cols={7,7,6,13}
   if i==0 then
    rectfill(x-1,by+8,x,y,7)
   end
   rectfill(x+1+i,by+8,x+1+i,y-2,cols[i+1])
   rectfill(x-2-i,by+8,x-2-i,y-2,cols[i+1])
  end
  
  outlined_spr(4+k,p.x-4,by)
  
  if false and mode==0 then
   local c=14-k*4
   local x=p.x-7
   rectfill(x,20,x,84,c)
   local x=p.x+6
   rectfill(x,20,x,84,c)
  end
 end
end

function draw_ball()
 outlined_spr(21,ball.x-4,ball.y-4)
end

function draw_smoke(s)
 circfill(s.x,s.y,s.r,s.c)
end

function draw_shine(s)
 spr(96+s.typ*16+s.t,s.x-4,s.y-4)
end


function draw_gameframe()
 palt(0,false)
 
 for i=8,119,8 do
  spr(62,i,0,1,2)
  spr(110,i,112,1,2)
 end
 
 for i=16,111,8 do
  spr(93,0,i)
  spr(95,120,i)
 end
 
 spr(61,0,0,1,2)
 spr(63,120,0,1,2)
 spr(109,0,112,1,2)
 spr(111,120,112,1,2)
 palt(0,true)
end

function draw_score()
 pal(5,0)
 spr(144,48,0,4,2)
 pal(5,5)
 
 pal(13,0)
 spr(128+players[0].score,53,4)
 spr(128+players[1].score,67,4)
 spr(156,60,4)
 pal(13,13)
end

function draw_title(y0,y1,y2,y3,y4)
 local str
 if y3 then
  str="press ” together to start "
 else
  str="press ” together to restart "
 end
 
 local ctrl0="‹ ‘ to move  "
 local ctrl1="Ž to hit light "
 local ctrl2="— to hit hard "
 local ctrl3="change difficulty on pause menu"
 local ofs={0,{0,-1},{-1,0},{1,0},{-1,1},{1,1},{0,2},13,{0,1},7,{0,0}}
 local plts={
  [0]={0,0,0,0},
  [13]={2,2,4,4},
  [7]={8,14,9,10}
 }
 local c
 for o in all(ofs) do
  if type(o)=="table" then
   if t%0.6>=0.1 then
    print(str,64-#str*2+o[1],y2+o[2],c)
   end
   
   if btn(2,0) then
    print("p1 ready",20+o[1]+3*cos(t*4),y1+o[2]+2*sin(t*8),c)
   end
   
   if btn(2,1) then
    print("p2 ready",78+o[1]-3*cos(t*4),y1+o[2]+2*sin(t*8),c)
   end
   
   if y3 then
    local x=64.5-#ctrl2*2
    print(ctrl0,x+o[1]+4*cos(t*1.5),y3+o[2]-8,c)
    print(ctrl1,x+o[1]+4*cos(t*1.5+0.3),y3+o[2],c)
    print(ctrl2,x+o[1]+4*cos(t*1.5+0.6),y3+o[2]+8,c)
    
    --local plt={[0]=0,[13]=1,[7]=13}
    --print(ctrl3,64-#ctrl3*2+o[1],122+o[2],plt[c])
    print(ctrl3,65-#ctrl3*2+o[1],114+o[2],c)
   end
   
   if y0 then
    for i=1,4 do
     pal(plts[7][i],plts[c][i])
    end
    
    for i=0,3 do
     local dx=sgn(i%2-0.5)
     local dy=sgn(i-1.9)
     
     local k=3
     if i==1 or i==2 then k=2 end
     for j=0,k do
      local x=64.5+(j-k*.5)*10+dx*28+8*dx*dy*cos(t*2)
      local y=y0+dy*13+4*sin(t*4+dx*dy*j*0.1)
      spr(192+i*4+j,x-4+o[1],y-8+o[2],1,2)
     end
    end
    
    for i=1,4 do
     pal(plts[7][i],plts[7][i])
    end
   end
   
  else
   c=o
  end
 end
 
 if y4 then
  local credits="  ~  ryan malm, joseph white, thomas morison, riccardo straccia, hervan , andreas bretteville, bitzawolf , alan oliver, paul nguyen, dan lewis, christian ostman, dan rees-jones, reza esmaili, brian nicolucci, thomas wright, chris mccluskey, pizza , joel jorgensen, corey o'connor, marty kovach, cole smith, giles graham, tim and alexandra swast, sasha bilton, berkfrei , jearl , dave hoffman, david dresbach, roy fielding, egor dorichev, jakub wasilewski, amaris , brent werness, nick hughes, anne le clech, nanoplink , nate wiesel, sean s. leblanc, matt hughes, c , andrew reist, vaporstack"
  print("‡to:",-1,y4,0)
  print("‡to:",1,y4,0)
  print("‡to:",0,y4-1,0)
  print("‡to:",0,y4+1,0)
  print("‡to:",0,y4,13)
  local stp=(t*50)%((#credits-1)*4)
  --local stp=(t*4)%((#credits)*4)
  local txti=flr(stp/4)+1
  local str
  if txti+25>#credits then
   str=sub(credits,txti,#credits-1)..sub(credits,1,txti+25-#credits)
  else
   str=sub(credits,txti,txti+25)
  end
  
  local x=24-stp%4
  print(str,x-1,y4,0)
  print(str,x+1,y4,0)
  print(str,x,y4-1,0)
  print(str,x,y4+1,0)
  print(str,x,y4,13)
  
  local str="a game by trasevol_dog"
  local x=64-#str*2
  local y=123
  print(str,x-1,y,0)
  print(str,x+1,y,0)
  print(str,x,y-1,0)
  print(str,x,y+1,0)
  print(str,x,y,13)
 end
end

function outlined_spr(s,x,y,w,h,fx,fy,c)
 c=c or 7
 w=w or 1
 h=h or 1

 for i=0,15 do
  pal(i,c)
 end
 
 spr(s,x-1,y,w,h,fx,fy)
 spr(s,x+1,y,w,h,fx,fy)
 spr(s,x,y-1,w,h,fx,fy)
 spr(s,x,y+1,w,h,fx,fy)
 
 for i=0,15 do
  pal(i,i)
 end
 
 spr(s,x,y,w,h,fx,fy)
end


function create_smoke(x,y,c)
 local a=rnd(1)
 local spd=0.5+rnd(2)
 local s={
  x=x,
  y=y,
  vx=spd*cos(a),
  vy=spd*sin(a),
  r=1+rnd(2.5),
  c=c
 }
 
 add(smoke,s)
end

function create_shine(x,y)
 local s={
  x=x,
  y=y,
  t=0,
  typ=flr(rnd(2))
 }
 
 add(shine,s)
end

function init_players()
 players={}
 for i=0,1 do
  local p={
   x=64.5+(i*2-1)*32,
   vx=0,
   vy=0,
   y=0,
   mt=0,
   st=0,
   t=i*0.5/8,
   score=0   
  }
  
  bod={x=p.x,y=104,w=12,h=14}
  p.bod=bod
  add(colliders,bod)
  --hed={x=p.x,y=96-p.y,w=8,h=8}
  players[i]=p
 end
end

function init_ball()
 ball={
  x=64,
  y=32,
  vx=0,
  vy=0,
  r=4
 }
 
 for i=0,11 do
  create_smoke(ball.x,ball.y,6+flr(rnd(2)))
 end
end


function pick(ar) return ar[flr(rnd(#ar))+1] end
function round(a) return flr(a+0.5) end
function lerp(a,b,i) return (1-i)*a+i*b end
function sqr(a) return a*a end
function sqrdist(xa,ya,xb,yb) if xb then xa=xb-xa ya=yb-ya end return sqr(xa)+sqr(ya) end
function dist(xa,ya,xb,yb) return sqrt(sqrdist(xa,ya,xb,yb)) end

