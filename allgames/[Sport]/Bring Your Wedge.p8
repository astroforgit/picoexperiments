pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
--bring your wedge 2
--by papa quark

function restart()
 cw=8 --cell width
 t=0 --time
 c_dgreen=3
 c_green=11
 c_lblue=12
 c_dkblue=1
 music(0)
 
 --golfers
 golfer_nr=1
 
 golfers={} --classic
 local golfer={}
 golfer.shirt=7
 golfer.pants=5
 add(golfers,golfer)
 
 golfer={} --pink
 golfer.shirt=14
 golfer.pants=7
 add(golfers,golfer)
 
 golfer={} --red
 golfer.shirt=2
 golfer.pants=0
 add(golfers,golfer)
 
 golfer={} --gunnar
 golfer.shirt=1
 golfer.pants=0
 add(golfers,golfer)
 
 golfer={} --nude
 golfer.shirt=15
 golfer.pants=15
 add(golfers,golfer)
 
 --game states
  title=0
  game=1
  room=title

 gameover=false
 
 level=1
 flag1_x=36 --48 57 27
 flag1_y=41 --47 41 38 36 31 20 valid

 flag2_x=flag1_x+65 --48 57 27
 flag2_y=flag1_y+32  --47 41 38 36 31 20 valid 
 
 currflag=1  --the flag to evaluate
 
 flags={}
 
 local flag={}
 flag.x=36
 flag.y=41
 
 add(flags, flag)
 
 flag={}
 flag.x=36+65
 flag.y=41+32
 
 add(flags, flag)
 
 index=16
 hio=0
 score=0
 it=2 --the flag who is 2x
 
 bs=3
 g=0.1
 balls={}
 for x=1,10 do make_ball(5,0) end
 currball=1
 balls_left=#balls
 ball_drop_t=0
 bs_t=0
 
 --states
  address=0
  backswing=1
  impact=2
  follow=3
  swing_state=address

  
 clouds={}

 make_cloud(-10,2,0.05,1)
 make_cloud(-20,2,0.10,1)
 make_cloud(-30,2,0.15,2)

 --shake
 shake_x=4
 shake_y=4
 shake_t=0
 shake=false

 --cam left
 camx=0

 coin_index=26
 coin_ani=false
 splash_index=39
	splash_ani=false
	splash_x=-100
	splash_y=-100
 feedb=false
 feedb_txt=""
 offset_l=0
 offset_r=0
end

function _init()
 restart()
end

function make_ball(x,y)
 local b={}
 b.x=x
 b.y=y
 b.f=false
 b.w=false
 add(balls,b)
 return b
end

function make_cloud(x,y,spd,size)
 local c={}
 c.x=x
 c.y=y
 c.dx=spd
 c.size=size
 add(clouds,c)
end

function move_cloud(cloud)
 if(cloud.x<130)then
  cloud.x+=cloud.dx
 else
  cloud.x=-20
 end
end

function move_ball(ball)
 if(swing_state==impact) then
  if(btnp(5)) then 
   index=18 
   ball.f=true 
  end
  --ball flight
  if(ball.f) then
   ball.x+=2*bs_t
   ball.y-=bs
   bs-=g
   --ball landing
   if(ball.x>flags[1].x+32 and bs<0)then --if ball is on its way down but has passed first flag.
   currflag=2
   else
   currflag=1
   end
   
   if(flr(ball.y)>(flags[currflag].y+5) and bs<0)then 
    ball.f=false
    swing_state=address
    index=16 
    evaluate_ball(ball)
    if(currball<#balls) then 
     currball+=1
     balls[currball].y=0
     ball_drop_t=0
    else
     currball=-1 --out of balls
     music(0)
    end
    --new ball
    bs=3
    bs_t=0
--    im_t=0
   end
  end
 end 
end

function evaluate_ball(cball)
scr=0
multiplier=1
if(currflag==it)then multiplier=2 end

 --hio or calc greenscore
 if(flr(cball.x)==flags[currflag].x)then
  sfx(3) hio+=1 coin_ani=true make_ball(5,0) balls_left+=1 scr=10*multiplier
  shake=true shake_t=2
 elseif((cball.x>flags[currflag].x-8) and (cball.x<flags[currflag].x+6))then
  scr=10-abs(flr(cball.x)-flags[currflag].x)

  scr=scr*multiplier
  shake=true shake_t=2
 end
 
 --splash before
 if(cball.x<flags[currflag].x-8) sfx(4) cball.w=true scr=-5 splash_ani=true splash_x=cball.x splash_y=cball.y
 
 --splash after
 if(cball.x>flags[currflag].x+6) sfx(4) cball.w=true scr=-5 splash_ani=true splash_x=cball.x splash_y=cball.y
 
 --feedback show score
 if(scr<0)then
  feedb_txt=scr
 else
  feedb_txt="+"..scr
 end
 
 feedb=true
 score+=scr
 
 it=flr(rnd(2))+1
end

function drop_ball(cball)
 if (cball.y<60) then cball.y+=3
 else
  feedb=false
 end
 if (cball.y==3) then balls_left-=1 end
end

function _update60()
 if(room==game)then
  t+=1
  ball_drop_t+=1

  if(swing_state==backswing) then
   bs_t+=0.02--measure swing tempo
   if(btnp(3) or btnp(4) or btnp(5))then 
    sfx(8)
    index=16 
    swing_state=impact
   end --impact
  end

  if(swing_state==address and currball ~= -1) then
   if(ball_drop_t==2)then
    drop_ball(balls[currball])
    ball_drop_t=0
   end
   if((btnp(5)) and balls[currball].y==60)then 
    index=17 
    swing_state=backswing
   end --backswing
  end
 end 
 

  
  move_ball(balls[currball])
  foreach(clouds, move_cloud)
  
  --goto next room
  if(room==title) then
   if(btnp(4) or btnp(5)) then 
    room=game
   end
   if(btnp(0) and golfer_nr>1) then golfer_nr-=1 offset_l=1 else offset_l=0 end
   if(btnp(1) and golfer_nr<#golfers) then golfer_nr+=1 offset_r=1 else offset_r=0 end
  -- offset_l=0
  -- offset_r=0  
  end
  
  --restart
  if(btnp(5) and currball==-1) then restart() end

 if(swing_state==backswing)then
 camx-=1
 elseif(swing_state==impact)then
 camx+=1
 end

 if(swing_state==backswing)then
	camera(camx,0)
	elseif(swing_state==impact)then
 camera(camx,0)
	elseif(swing_state==follow)then
	camx=0
	camera()
 end
 
 
 
 if(shake and shake_t>0)then
 camera(0,rnd(shake_y)*-1)
 shake_t-=1
 else
 camera()
 shake_t=0
 shake=false
 end
 
end

function zspr(n,w,h,dx,dy,dz)
  sx = 8 * (n % 16)
  sy = 8 * flr(n / 16)
  sw = 8 * w
  sh = 8 * h
  dw = sw * dz
  dh = sh * dz
  sspr(sx,sy,sw,sh, dx,dy,dw,dh)
end
 
function draw_title()
 cls()
 rectfill(0,0*cw,16*cw,10*cw,c_lblue)
 rectfill(0,10*cw,16*cw,16*cw,c_dgreen)
	map(8,2,0,5*cw,24,4) --golfers
 map(8,15,-8,64+6+0,20,8)
 
 pal(7,golfers[golfer_nr].shirt)--shirt
 pal(5,golfers[golfer_nr].pants)--pants 
 zspr(18,1,1,36,60,6)
 --spr(18,64-8,75+8)
 pal()
 
 spr(10,64-16-8,75+8+offset_l)
 spr(12,64+8,75+8+offset_r)
	x=36
	t=time()*0.6--1.4
	s="your wedge"
	for i=1,#s do
		y=cos(t+0.02*i)*2
		c=sub(s,i,i)
		print(c,x+1,28+y+1,3)
		print(c,x,28+y,7)

 spr(64,7+16*1,8+y,2,2)--b
 spr(64+2,7+16*2,8+y,2,2)--r
 spr(64+2+2,7+16*3,8+y,2,2)--i
 spr(64+2+2+2,7+16*4-6,8+y,2,2)--n
 spr(64+2+2+2+2,7+16*5-6,8+y,2,2)--g

	spr(138,4+16*3,38+y,2,2)--2

		x+=5
 
 print("press — to load",3*cw+4,(14*cw)+1,0)
	print("press — to load",3*cw+4,14*cw+offset_r+offset_l,7)
 print("then — to shoot",3*cw+4,(15*cw)+1,0)
	print("then — to shoot",3*cw+4,15*cw+offset_r+offset_l,7)

 spr(58,128-17,128-9,2,1)--papa
	
	foreach(clouds, draw_cloud)
	end
 

end 


function draw_game()
 cls()
 --background
 rectfill(-10,-10*cw,16*cw,16*cw,c_lblue)
 rectfill(-10,3*cw,16*cw,4*cw,c_dgreen)
 map(8,15,-8,64+16+8,20,8)
 spr(51,22,114)--pole
 spr(51,22+20,114)--pole
 map(8,0,-8,0,20,20)
 --/background
 
 spr(013,2,1)
 
 print("balls",12,86,7)
 print(balls_left,46,86,7)
 print("score",12,96,7)
 print(score,46,96,7)
 print("hio",12,106,10)
 print(hio,46,106,10)
 if(feedb and currball!=-1)then
  print(feedb_txt,flags[currflag].x-5,flags[currflag].y-6,10)end
  
 if(feedb!=true and currball!=-1)then
 print("2x",flags[it].x-5,flags[it].y-6,9)end
 
 
 
 if(currball==-1)then 
 	x=38
	t=time()*0.6--1.4
	s="game over"
	for i=1,#s do
		y=cos(t+0.02*i)*2
		c=sub(s,i,i)
		print(c,x+1,22+y+1,3)
		print(c,x,22+y,7)
		x+=5
 end
-- print("game over",16,17,5)
-- print("game over",15,16,9+flr(rnd(2)))
 print("score",12,97,5)
 print("score",12,96,9+flr(rnd(2)))
 print(score,46,97,5)
 print(score,46,96,9+flr(rnd(2)))
 print("restart —",64+8+4,98+9,1)
 print("restart —",64+8+4,98+8,7)

 end
 
 foreach(flags, draw_flag)
 foreach(clouds, draw_cloud)
 
 pal(7,golfers[golfer_nr].shirt)--shirt
 pal(5,golfers[golfer_nr].pants)--pants
 spr(index,1*cw-8,7*cw-4)--golfer
 pal()
 foreach(balls,draw_ball)
 pset(5,0,12)--hide ball
 if(coin_ani) draw_coin()
 if(splash_ani!=false) draw_splash()
end

function draw_ball(ball)
 if(ball.w) then
 pset(ball.x,ball.y,12)
 else
 pset(ball.x,ball.y,7)
 end
end

function draw_flag(flag)
 spr(230,flag.x-8,flag.y+4) --flag
 spr(231,flag.x,flag.y+4) --flag
 spr(32,flag.x,flag.y) --flag
end

function draw_cloud(cloud)
if(cloud.size==1)then
 spr(75,cloud.x,cloud.y) --small cloud
else
  spr(77,cloud.x-8,cloud.y) --left part of cloud
  spr(78,cloud.x,cloud.y) --right part of cloud
end 

end

function draw_coin()
	if(coin_index<31) then
	spr(coin_index,flags[currflag].x-4,flags[currflag].y-16)
	coin_index+=1
	else
	coin_index=26
	coin_ani=false
	end
end

function draw_splash()
	if(splash_index<42) then
	spr(splash_index,splash_x-4,splash_y-4)
	splash_index+=0.5
	else
	splash_index=39
	splash_ani=false
	splash_x=-100
	splash_y=-100
	end 
end

function _draw()
 if(room==title) draw_title()
 if(room==game) draw_game()
end
if(_update60)_update=function()_update60()_update_buttons()_update60()end
