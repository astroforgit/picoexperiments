pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- a breakout mini-golf game
-- by elastiskalinjen

--sorry for game jam code...

levelblock={7,8,4,2,9,26,5,24,2,13,4,9,1,8,3,5,19,2,0}
sp1={72,90}
sp2={170,90}
sp3={265,65}
sp4={448,89}
sp5={536,82}
sp6={705,58}
sp7={816,97}
sp8={936,95}
sp9={24,209}
sp10={179,240}
sp11={312,185}
sp12={440,223}
sp13={543,215}
sp14={688,185}
sp15={777,193}
sp16={920,217}
sp17={56,351}
sp18={184,351}
sp19={286,341}
startpositions = { sp1, sp2, sp3, sp4, sp5, sp6, sp7, sp8, sp9, sp10, sp11,sp12,sp13,sp14,sp15,sp16,sp17,sp18,sp19}

level=1 --change here to jump levels!
menuitem(1, "restart level", function() restartlevel() sfx(1) end)
start = false
score=0
bestscore=0

--stats
restarts=0
timer=0
timercounter=0
shots=0
blocksbreaked=0

function _init()
	cartdata("elastiskalinjen_breakolf")
	mouse.init()

	-- cry me a river, this is terrible, lucky me this is game jam :d 
	if level >= 9 and level < 17 then
		camy = 128
	elseif level >= 17 then
		camy = 128 * 2
	end
	
	if level < 9 then
		camx=(level-1) * 128
	elseif level >= 9 and level < 17 then 
		camx=(level-9) * 128
	else
		camx=(level-17) * 128
	end

	levelx = camx
	levely = camy

	for x=0,127 do
  		for y=0,63 do
		  val = mget(x,y)
		  -- init portal 
		  if fget(val, 5) then --entrence
			initportal(x*8, y*8, false)
			mset(x,y,17)
		  end
		  if fget(val, 6) then --closer
			initportal(x*8, y*8, true)
			mset(x,y,17)
		  end
		end
	end
end

function _update60()
	foreach(particles,updateparticle)
	foreach(trails,updatetrail)
	updateportals()
	foreach(letters, updateletter)
	mouse.update()
	mx,my = pntc()
	updatehand()
	if start == true then 
		if lost == false then
			p1update()
		end
		nextlevel()
		lostlevel()
	else
		initparticle(mx,my+5,1,7,0,0)
		if pressed() then
			start = true
			sfx(10)
			for i=0, 20 do
				initparticle(camx+flr(rnd(128)),camy+flr(rnd(128)),20+flr(rnd(10)),3,0,0)
			end
		end
	end

	if teleported then 
		if teleportedcounter < 7 then
			teleportedcounter+=1
			 initparticle(p1x+center,p1y+center,2+flr(rnd(3)),1,0,0)
		else 
			teleportedcounter = 0
			teleported = false
		end
	end

	updatewater()

	if start == true then --timer
		if timercounter < 60 then 
			timercounter+=1
		else 
			timercounter = 0
			if level ~= 19 then
				timer+=1
			end
		end
	end

	if pntp() or pntr() then
		mouseOff = false
	end
	if mouseOff == false then 
		menuitem(1, "use arrow keys", function() mouseOff = true sfx(15) end)
	else 
		menuitem(1, "use mouse", function() mouseOff = false sfx(15) end)
	end
end

function pressed()
	return (pntp() and not mouseOff) or (btnp(4) and mouseOff)
end

function pressedRight()
	return (pntrp() and not mouseOff) or (btnp(5) and mouseOff)
end

function hold()
	return (pnt() and not mouseOff) or (btn(4) and mouseOff)
end

updatewatercounter=0
watersp = 0
function updatewater()
	if updatewatercounter < 10 then
		updatewatercounter +=1
	else
		watersp +=1
		if watersp >= 6 then 
			watersp = 0
		end
		updatewatercounter=0
		local startx = (camx / 128) * 16
		local starty = (camy / 128) * 16
		
		for x=startx,startx+16 do
	  		for y=starty,starty+16 do
			  val = mget(x,y)
			  if fget(val, 3) then
				mset(x,y,58+watersp)
			  end
			end
		end
	end
end

restart=false
function lostlevel()
	if health <= 0 and won == false and speed == 0 and lost == false then
		lost = true
		initword("failed",camx+34,camy+64,0.025,7,0.2,4,false,8)
		sfx(5)
		dragging=false
		speed=0
		power=0
	end

	if lost then
		if circcoll(camx+mx,camx+106,camy+my,camy+107,4,4) == true then
			restart = true
		else
			restart = false
		end

		if 	restart == true and pressed() then
			restartlevel()
		end
	end
end

function restartlevel()
	p1x = startpositions[level][1]
	p1y = startpositions[level][2]
	bdestroyed=0
	shake = 0.01
	health = 7
	lost = false
	showgoal = false
	letters={}
	dragging = false
	wavelast = false
	speed = 0
	lostcounter = 0
	power = 0
	if(level < 19)restarts+=1
	reload(0x2000, 0x2000, 0x1000)
	if level >= 17 then 
		reload(0x1000, 0x1000, 0x1000)
	end
	sfx(4)
end

dcol=8
wavelast = false
function _draw()
	cls()

	if start == false then
		drawsplashscreen()
	else
		map(0,0,0,0,128,128)
		if level < 19 then 
			print(level, startpositions[level][1]+7, startpositions[level][2], 7)
		end
		camerashake()
		foreach(trails,drawtrail)	
		foreach(portals, drawportal)
		if won == false then
			if playerblink == 0 then 
				spr(p1spr,p1x,p1y)
			else 
				spr(20,p1x,p1y)
			end
		end
		drawdebug()
		
		if dragging == true then
			spr(4,camx+dragx,camy+dragy)
			if power > 90 then
				dcol=8
			else 
				dcol=2
			end
			fillp(0b0011001111001100.1)
			line(camx+mx+center,camy+my+center,camx+dragx+center,camy+dragy+center,dcol)
			fillp(0)
			if power > 3 then
				spr(14,p1x+cos(angle)*8,p1y+sin(angle)*8+1)
				spr(p1spr+1,p1x+cos(angle)*8,p1y+sin(angle)*8)
			end
		end
		foreach(particles,drawparticle)
		drawui()
		if level == 19 then
			rectfill(camx+24,camy+10,camx+104,camy+84,1)
			line(camx+26,camy+19,camx+102,camy+19,7)
			line(camx+26,camy+20,camx+102,camy+20,13)

			rect(camx+24,camy+10,camx+104,camy+84,7)
			print("~ stats ~",camx+44,camy+13,7)
			print("shots: "..shots,camx+42,camy+24,7)
			print("blocks: "..blocksbreaked,camx+42,camy+32,7)
			print("time: "..timer,camx+42,camy+40,7)
			print("restarts: "..restarts, camx+42, camy+48,7)
			spr(3,camx+26, camy+12)
			spr(3,camx+95, camy+12,1,1,true, false)

			if wavelast == false then
				wavelast = true
				initword("thank you for",camx+21,camy+64,0.025,13,0.12,2,false,6)
				initword("playing!",camx+36,camy+76,0.025,13,0.12,2,false,6)
			end
		end
		foreach(letters, drawletter)
		spr(mspr,camx+mx,camy+my)
	end
	fillp(0b0011001111001100.1)
	rect(camx,camy,camx+127,camy+127,7)
	fillp(0)
end

t=0
r=9
s=12
intro="elastiskalinjen presents"
gamename="breakolf"
startcounter=0
blink = false

function drawsplashscreen()
	cls(12)
  	for x=0,128,1 do
  		rectfill(x,128,x,80+s*-sin((x+t)/1080),3)
    	rectfill(x,128,x,90+s*-sin((x+t/5)/360),11)              
  	end
  	spr(43,10,40+s*-sin(((40*5.8)+t)/720))
  	spr(42,113,40+s*-sin(((40*5.8)+t)/720))

  	if blink then
	  	if mouseOff == false then 
			print("click to start", 34, 90, 3)
			print("click to start", 34, 89, 7)
		else 
			print("Ž to start", 43, 90, 3)
			print("Ž to start", 43, 89, 7)
		end
  	end
  	for x=0,128,1 do
    	rectfill(x,128,x,100+s*-sin((x+t)/720),3)              
  	end

  	for i=0,#gamename,1 do 
  		print(sub(gamename,i,i),10+i*12,40+s*-sin(((i*5.8)+t)/720),7)
  	end

  	t+=r
  	rectfill(0,120,128,128, 1)
  	print("by @elastiskalinjen", 51, 121, 7)
	if mouseOff then 
		print("mouse off", 4, 121, 7)
	else 
		print("mouse on", 4, 121, 7)
	end
	print("|", 42, 121, 7)

	foreach(particles, drawparticle)
  	spr(11, mx, my)

  	if startcounter < 30 then
  		startcounter+=1
  	else 
  		startcounter = 0
  		blink = not blink
  	end	
end

p1x = startpositions[level][1]
p1y = startpositions[level][2]
camx = 0
camy = 0

op1x=p1x
op1y=p1y

p1spr=86
p1sprs=p1spr

dragging=false
power=0
angle=0

speed=0
p1angle=0
diry=1
dirx=1
width=8
center = width/2

resist=0.06
mode = true

bdestroyed=0

health = 7

circsmall = 4
won = false
lost = false
wonallgame = false

playerblink = 0
playerblinkcounter = 0
mouseOff = false

function p1update()
	if won == false then
		op1x=p1x
		op1y=p1y
		drag()
		
		if speed > 0.1 then
			speed-=resist 
		else 
			speed=0 
			dirx=1
			diry=1
		end
			
		p1x+=dirx*speed*cos(p1angle)
		p1y+=diry*speed*sin(p1angle)

		inittrail(p1x+width/2,p1y+width/2,4,3)

		-- catastrophe code
		if btnp(5) then
			if msprs < 76 then
				msprs+=2
				p1spr+=2
			else 
				msprs=70
				p1spr=86
			end
		end

		--win
		g = mget((p1x+center)/8,(p1y+center)/8)	
		if speed < 2 and fget(g,1) and won == false then
			if (levelblock[level]-bdestroyed <= 0) then
				won = true
				speed = 0
				shake=0.05
				sfx(8)
				for i=0, 10 do initparticle(p1x,p1y,2+rnd(3),10,0,0) end
				local goalword = ""
				local goalspace = 0
				if health == 6 then
					goalword = "hole in one!"
					goalspace = -8
				else 
					goalword = "cleared"
				end
				initword(goalword,camx+26+goalspace,camy+64,0.025,7,0.2,4,false,8)
			else
				shake=0.1
				p1x = startpositions[level][1]
				p1y = startpositions[level][2]
			end
		end
		
		if fget(g,2) then --grass
			if speed > 0 then
				speed-=0.18
			end
		end

		if fget(g,3) then --water
			if speed > 0 then
				shake=0.1
				speed = 0
				for i=0, 10 do initparticle(p1x+rnd(8),p1y+rnd(8),2+rnd(3),12,0,0) end
				playerblink = 19
				p1y=op1y
				p1x=op1x
				sfx(9)
			end
		end

		if fget(g,4) then --sand
			if speed > 0 then
				speed-=0.5
			end
		end

		--outside of map
		if p1x+4 > camx+128 or p1x+4 < camx or p1y+4 > camy+128 or p1y+4 < camy then
			shake=0.1
			speed = 0
			p1x = startpositions[level][1]
			p1y = startpositions[level][2]
			playerblink = 19
			sfx(7)
		end

		--up
		h=mget((p1x+center)/8,p1y/8)	
		if fget(h,0) then
			mset((p1x+center)/8,p1y/8,25+flr(rnd(3)))
			colis()
			diry*=-1
		end

		--down
		h=mget((p1x+center)/8,(p1y+width)/8)	
		if fget(h,0) then
			mset((p1x+center)/8,(p1y+width)/8,25+flr(rnd(3)))
			colis()
			diry*=-1
		end

		--right
		h=mget(p1x/8,(p1y+center)/8)	
		if fget(h,0) then
			mset(p1x/8,(p1y+center)/8,25+flr(rnd(3)))
			colis()
			dirx*=-1
		end

		--left
		h=mget((p1x+width)/8,(p1y+center)/8)	
		if fget(h,0) then
			mset((p1x+width)/8,(p1y+center)/8,25+flr(rnd(3)))
			colis()
			dirx*=-1
		end
	else
		circsmall = lerp(circsmall, 0, 0.12)
	end

	if playerblink == 19 then 
		if playerblinkcounter < 15 then 
			playerblinkcounter+=1
		else 
			playerblink = 0
			playerblinkcounter = 0
		end
	end
end

hit = false
showgoal = false
function colis() 
	p1x = op1x
	p1y = op1y
	speed = speed*0.9
	shake+=0.01
	bdestroyed+=1
	hit = true
	if (level ~= 19)blocksbreaked+=1
	for i=0, 3 do initparticle(p1x+center,p1y+center,2+flr(rnd(3)),7,0,0) end
	sfx(flr(rnd(3)))
	
	if levelblock[level]-bdestroyed <= 0 and showgoal == false then
		local startx = (camx / 128) * 16
		local starty = (camy / 128) * 16
		
		for x=startx,startx+16 do
	  		for y=starty,starty+16 do
			  val = mget(x,y)
			  if fget(val, 7) then
				mset(x,y,19)
				showgoal = true
				sfx(6)
				for b=0, 4 do 
					initparticle((x*8)+flr(rnd(8)),(y*8)+flr(rnd(8)),2+rnd(3),9+flr(rnd(2)),0,-1-rnd(2))
				end
			  end
			end
		end
	end
end


mx=0
my=0
mspr=70
msprs=mspr
mouse=
{	
	x=0,y=0, 
	b=0,ob=0,
 	rad=4,hit=0,dx=0,dy=0,acc = 0.3,speed= 1.24, 
	init=function()
		poke(0x5f2d,1)
		mouse.x=mid(0,stat(32),127)
		mouse.y=mid(0,stat(33),127)
		mouse.b=band(stat(34),1)				
	end,	
	update=function()
		mouse.ob=mouse.b
		mouse.dx *= 0.85
 		mouse.dy *= 0.85

		if btn(0) or btn(1) or btn(2) or btn(3) or mouseOff == true then
			mouseOff = true
			mouse.dx=min(mouse.dx, mouse.speed)
 			mouse.dx=max(mouse.dx,-mouse.speed)
 			mouse.dy=min(mouse.dy, mouse.speed)
 			mouse.dy=max(mouse.dy,-mouse.speed)
 			mouse.x += mouse.dx
 			mouse.y += mouse.dy
			if btn(0) then mouse.dx-=mouse.acc - (power/350) end
			if btn(1) then mouse.dx+=mouse.acc  - (power/350)  end
			if btn(2) then mouse.dy-=mouse.acc  - (power/350)  end
			if btn(3) then mouse.dy+=mouse.acc  - (power/350) end

			if mouse.x <= 4 or mouse.y <= 4 or mouse.x >= 120 or mouse.y >= 120 then --((space+2) * 8))
				mouse.x = lerp(mouse.x, 64, 0.016)
				mouse.y = lerp(mouse.y, 64, 0.016)
			end
		end

		if mouseOff == false then
			mouse.x=mid(0,stat(32),127)
			mouse.y=mid(0,stat(33),127)
		end

		mouse.b=band(stat(34),1)
	end,
}
-- mouse newly pressed
function pntp() return (mouse.b==1 and mouse.ob==0) end
-- mouse pressed
function pnt() return (mouse.b==1) end
-- mouse right pressed
function pntr()  return (mouse.b==2) end
-- mouse right newly pressed
function pntrp()  return (mouse.b==2 and mouse.ob==0) end

-- mouse newly released
--function pntr() return (mouse.b==0 and mouse.ob==1) end
-- mouse coordinates: x,y=pntc()
function pntc() return mouse.x,mouse.y end

function updatehand()
	if(hold())then
		mspr=msprs+1
	else
		mspr=msprs
	end
end

dragx=0
dragy=0
setpoint=false
function drag()
		if mode == true then
		if hold() then
			dragging=true
			if setpoint==false then
				dragx=mx
				dragy=my
				setpoint=true
			end
		else
			dragging=false
			if speed == 0 then
				if power > 3 then
					if power > 90 then
						power = 90
					end
					sfx(3)
					speed+=power/10
					if (level ~= 19) then 
						health-=1 --hardcoding for life...
						shots+=1
					end
					power=0
				end
				p1angle=angle
				setpoint=false
			end
		end
	else
		dragging=false
	end
	
	if dragging == true then
		power=flr(calcdist(mx,dragx,my,dragy))
		angle=calcangle(dragx,mx,dragy,my)
	end

	if pressedRight() then 
		dragging = false 
		power = 0
		setpoint = false
	end
end

levelx=0
levely=0
newlevel=false
function nextlevel() 
	if won == true then
		if newlevel == false then
			newlevel = true
			if level == 8 or level == 16 then
				levelx=0
				levely+=128
			else 
				levelx+=128
			end
			
			for i=0, 20 do
				initparticle(camx+128+flr(rnd(128)),camy+flr(rnd(128)),20+flr(rnd(30)),7,0,0)
			end
		end

		local oldcamx = camx
		local oldcamy = camy
		camx=lerp(camx,levelx,0.04)
		camy=lerp(camy, levely,0.04)
		
		for l in all(letters) do
			l.x += (camx - oldcamx)
			l.y += (camy - oldcamy)
		end

		if level == 8 or level == 16 then
			if levely - camy <= 0.6 then
				gotonextlevel()
			end 
		else
			if levelx - camx <= 0.6 then
				gotonextlevel()
			end
		end
	end
end

function gotonextlevel()
	camx = levelx
	camy = levely
	won = false
	newlevel = false
	showgoal = false
	level+=1
	if level <= #startpositions then
		bdestroyed=0
		health = 7
		letters={}
		p1x = startpositions[level][1]
		p1y = startpositions[level][2]
		sfx(16)
		for i=0,4 do
			initparticle(p1x + rnd(8), p1y + rnd(8), 1+rnd(3), 7, rnd(2)-1, rnd(2)-1)
		end
	end
end

fliphp=0
flipblock=0
flipblockcounter=0
flipcounter=0
winwidth=55

flipwincounter=0
flipwin = 0
lostcounter=0
function drawui()
	if hit == true then 
		flipblock = 16
		if flipblockcounter <= 4 then 
			flipblockcounter+=1
		else
			flipblock = 0
			flipblockcounter = 0
			hit = false
		end
	end

	if flipcounter <= 60  then
		if health <= 3 then flipcounter+=4 else flipcounter+=2 end
	else
		flipcounter=0
		if fliphp == 16 then fliphp=0 else fliphp=16 end
	end
	if flipwincounter <= 60 then 
		flipwincounter+=1
	else 
		flipwincounter = 0
		if flipwin == 16 then flipwin=0 else flipwin=16 end
	end

	if level < 19 then
		rectfill(camx+4,camy+100,camx+36,camy+120,1)
		rect(camx+4,camy+100,camx+36,camy+120, 7)
		spr(6+flipblock,camx+6,camy+102)

		if levelblock[level]-bdestroyed > 0 then
			print(" > "..levelblock[level]-bdestroyed,camx+14,camy+104, 7)
		else
			print(" = ",camx+14,camy+104, 7)
			spr(8+flipwin,camx+24,camy+102)
		end
		
		spr(7+fliphp, camx+6,camy+111)
		print(" = "..health,camx+14,camy+113,7)
	end

	if won == true or lost == true then
		winwidth = lerp(winwidth, 73, 0.5)
	else
		winwidth = lerp(winwidth, 55, 0.25)
	end

	if (winwidth - 55 > 1) then
		rectfill(camx-10,camy+55,camx+140,camy+winwidth,0)
	end

	if lost == true then
		if (lostcounter < 150)lostcounter +=1
		if restart then
			circfill(camx+110,camy+110, 8, 3)
			spr(9,camx+106,camy+106)
			circ(camx+110,camy+110, 8, 7)
		else
			circfill(camx+110,camy+109, 8, 11)
			spr(10,camx+106,camy+106)
			circ(camx+110,camy+109, 8, 7)
		end
		if (lostcounter >= 140) then 
			print("restart", camx+99, camy+120, 7)
		end
	end
end

function drawdebug()
	--print("drag",0,0,7)
	--if dragging==true then
	--	print("yes",0,0,7)
	--else
	--	print("no",0,0,7)
	--end
		
	--print("power:"..power,camx,camy+24,8)
	--print("camx:"..camx,camx,32,8)
	--print("speed:"..speed,camx,camy+40,8)
end

function circcoll(x1,x2,y1,y2,rad1,rad2)
	return calcdist(x1,x2,y1,y2) < (rad1+rad2)
end

function calcangle(x1,x2,y1,y2)
 return atan2(x1-x2,y1-y2)
end

function calcdist(x1,x2,y1,y2)
	return sqrt(((x2-x1)/10)^2+((y2-y1)/10)^2)*10
end

function lerp(var,target,pow)
	return (var+pow*(target-var))
end

shake=0
function camerashake()
	local shakex=16-rnd(32)
 local shakey=16-rnd(32)
 
	shakex*=shake
	shakey*=shake

	camera(camx+shakex,camy+shakey)
	shake=shake*0.95
	if(shake < 0.02)shake=0
end

glitch = false
portals={}
function initportal(x,y,entrence)
	local p={}
	p.x=x
	p.y=y
	p.ent = entrence
	p.animcounter = 0
	if entrence then p.spr = 64 else p.spr = 80 end
	p.sprs = p.spr
	p.glitch = false
	add(portals,p)
end

function updateportals() 
	for k,p in pairs(portals) do
		updateportal(p)
	end 
end

teleported = false
teleportedcounter = 0
function updateportal(p)
	dist = calcdist(p.x+center,p1x+center,p.y+center,p1y+center)
	if dist <= 9 then 
		p.glitch = true
	else 
		p.glitch = false
	end
	if p.animcounter < 20 then 
		p.animcounter+=1
	else 
		p.animcounter=0
		if (p.spr == p.sprs)then p.spr+=1 else p.spr-=1 end
		initparticle(p.x+flr(rnd(8)),p.y+flr(rnd(8)),2,12,0,1)
	end

	if dist <= 6 and speed > 1 then
		if teleported == false then
			for k,op in pairs(portals) do
				if op ~= p then
					if calcdist(p.x,op.x,p.y,op.y) <= 45 then
						p1x = op.x
						p1y = op.y
						sfx(11)
						for b=0, 4 do 
							initparticle(p.x+flr(rnd(8)),p.y+flr(rnd(8)),2+rnd(3),12,0,0)
						end
						teleported = true
						shake+=0.01
					end
				end
			end
		end
	end
end

function drawportal(p)
	spr(p.spr, p.x, p.y)
	if p.glitch == true then 
		o1 = flr(rnd(0x1f00)) + 0x6040
		o2 = o1 + flr(rnd(0x4)-0x2)
		len = flr(rnd(0x40))
		memcpy(o1,o2,len)
	end
end

particles={}
function initparticle(x,y,rad,col,dx,dy)
	local p={}
	p.x=x
	p.y=y
	p.dx=dx
	p.dy=dy
	-- default parameters
	if(dx == 0)p.dx = rnd(2)-1
	if(dy == 0)p.dy = rnd(2)-1
	p.rad=rad
	p.col=col
	
	add(particles,p)
end

function updateparticle(p)
	p.dx*=0.9
	p.dy*=0.9
 	p.x+=p.dx
 	p.y+=p.dy
 	
 	if p.rad > 6 then
 		p.rad -= 0.75
 	else 
		p.rad -= 0.1
	end
	if p.rad <=0 then 
		del(particles,p)
	end
end

function drawparticle(p)
	circfill(p.x,p.y,p.rad,p.col)
end

trails={}
function inittrail(x,y,rad,col)
	local t={}
	t.x=x
	t.y=y
	t.rad=rad
	t.col=col
	
	add(trails,t)
end

function updatetrail(t)
	t.rad -= 0.25
	if t.rad <= 0 then 
		del(trails,t)
	end
end

function drawtrail(p)
	circfill(p.x,p.y,p.rad,p.col)
end
		
letters={}
function initletter(x,y,speed,colour,offset,wavesize,char,shadow)
	local p={}
	p.x = x
	p.y = y
	p.m = offset 
	p.sp = speed
	p.c = colour
	p.ws = wavesize
	p.t = char
	p.sh = shadow
	 
	add(letters,p)
end 

function updateletter(p)
	p.m += p.sp	
end

function drawletter(p)
	if(p.sh == true)print(p.t,p.x,p.y+sin(p.m)*p.ws,p.c-1)
	print(p.t,p.x,-2 + p.y+sin(p.m)*p.ws,p.c)
end

function initword(word,x,y,speed,colour,offset,wavesize,shadow,space)
	for i=0,#word do 
		initletter(x+i*space,y,speed,colour,i*offset,wavesize,sub(word,i,i),shadow)
	end
end
