--gamestates functions

--game over function
function gameover_draw()
	--draw the background
	rectfill(0,0,128,128,2)
	
	--draw the image
	spr(71,32,12,8,4)
	
	--print "game over"
	--print("game over",46,8,7)
	
	--print your score
	print("score",10,66,10)
	print(ui.score,18,74,7)
	
	--print your max combo
	print("max",56,60,10)
	print("combo",52,66,10)
	print(ui.maxcombo,60,74,7)
	
	--print the number of times
	--the pigeon is shot
	print("pigeon",96,60,10)
	print("shot",100,66,10)
	print(pigeon.shot,106,74,7)
	
	--print hit number
	--from the head
	print("head",6,96,12)
	print(ui.headc,12,104,7)
	
	--print hit number
	--from the foot
	print("foot",30,96,12)
	print(ui.footc,36,104,7)
	
	--print hit number
	--from the knee
	print("knee",54,96,12)
	print(ui.kneec,60,104,7)
	
	--print hit number
	--from the left heel
	print("left",78,90,12)
	print("heel",78,96,12)
	print(ui.lheelc,84,104,7)
	
	--print hit number
	--from the right heel
	print("right",102,90,12)
	print("heel",104,96,12)
	print(ui.rheelc,108,104,7)
	
 --press x to play again
 print("press ƒ and —",
 	6,120,14)
 print("to play again",
		70,120,14)
end

--main title function
function maintitle_draw()
	--draw the background
	rectfill(0,0,128,128,2)
	rectfill(0,24,128,95,12)
	map(16,0)
	
	--print "title"
	--print("eleni foot bag",46,8,7)
	spr(192,4,4,6,2)
	spr(224,60,7,8,2)
	
	--draw eleni
	spr(128,64,32,4,4)
	spr(132,96,32,4,4)
	spr(136,64,64,4,4)
	spr(140,96,64,4,4)
	
	--draw the pigeon
	spr(43,4,26,2,2)
	
	--draw the ball
	spr(16,26,38)
	
	--press x to play
 print(
  "press — to play",
  32,104,14)

 --author credits
 print(
	 "a game by kendar varnor",
	 17,120,13)
end
