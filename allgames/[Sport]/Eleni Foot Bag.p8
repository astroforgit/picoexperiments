pico-8 cartridge // http://www.pico-8.com
version 30
__lua__
--eleni foot bag
--by kendar varnor

function _init()
	gamestate=0
	
	background_init()
	player_init()
	ball_init()
	pigeon_init()
	hitbox_init()
	ui_init()
	music(0)
end

function _update()	
	if gamestate==0
	and btnp(—) then
		gamestate=1
		music(16)
	end
	
	if gamestate==1 then
		background_update()
		player_update()
		ball_update()
		pigeon_update()
		hitbox_update()
		ui_update()
	end
	
	if gamestate==2
	and btnp(—)
	and btn(ƒ) then
		gamestate=0
		player_init()
		ball_init()
		pigeon_init()
		hitbox_init()
		ui_init()
		music(0)
	end
end

function _draw()
	cls(12)
	
	if gamestate==0 then
		maintitle_draw()
	end
	
	if gamestate==1 then
		background_draw()
		player_draw()
		ball_draw()
		pigeon_draw()
		--hitbox_draw()
		ui_draw()
	end
	
	if gamestate==2 then
		gameover_draw()
	end
end
-->8
--player functions

function player_init()
	--player object
	p={}
	--player position
	p.x=48
	p.y=55
	--player size
	p.w=32
	p.h=64
	--player speed
	p.vx=2
	--player time anim
	p.anim=0
	--player state
	p.stand=true
	p.jump=false
	p.walk=false
	p.footup=false
	p.footl=false
	p.footr=false
end

function player_update()
	--player gravity
	if p.y<55 then
		p.y=p.y+2
	end
		
	--reposition the player
	--after jump
	if p.y>55 then
		p.y=55
	end
	
	--move the player to left
	if btn(‹)
	and p.x>0 then
		p.stand=false
		p.walk=true
		p.x=p.x-p.vx
	elseif not btn(‹) then
		p.stand=true
		p.walk=false
	end
	
	--move the player to right
	if btn(‘)
	and p.x<128-p.w then
		p.stand=false
		p.walk=true
		p.x=p.x+p.vx
	elseif not btn(‹) then
		p.stand=true
		p.walk=false
	end
	
	--jump the player
	if btnp(Ž)
	and p.y>50 then
		p.jump=true
		p.y=p.y-15
	end
	
	--the player isn't jump
	if not btnp(Ž) then
		p.jump=false
	end
	
	--anim the player walk
	p.anim=p.anim+1
	if p.anim>15 then
		p.anim=0
	end
	
	--player foot up
	if btn(—)
	and p.stand==true then
		p.stand=false
		p.footup=true
		p.footl=false
		p.footr=false
	end
	
	--player left foot up
	if btn(—)
	and btn(‘) then
		p.footup=false
		p.footl=true
		p.footr=false
	end
	
	--player right foot up
	if btn(—)
	and btn(‹) then
		p.footup=false
		p.footl=false
		p.footr=true
	end
	
	--player not foot
	if not btn(—) then
		p.footup=false
		p.footl=false
		p.footr=false
	end
end

function player_draw()
	--draw the player if standing
	if p.stand==true
	and p.footl==false
	and p.footr==false then
		--head and body
		spr(1,p.x,p.y,2,4)
		spr(1,p.x+16,p.y,2,4,true)
		--legs
		spr(3,p.x,p.y+32,2,4)
		spr(3,p.x+16,p.y+32,2,4,true)
	end
	
	--draw the player if moving
	if p.walk==true
	and p.footl==false
	and p.footr==false then
		if p.anim<=7.5 then
			--head
			spr(1,p.x,p.y,2,2)
			spr(1,p.x+16,p.y,2,2,true)
			--body
			spr(7,p.x,p.y+16,2,2)
			spr(7,p.x+16,p.y+16,2,2,true)
			--legs
			spr(5,p.x,p.y+32,2,4)
			spr(5,p.x+16,p.y+32,2,4,true)
		elseif p.anim>7.5 then
			--head and body
			spr(1,p.x,p.y,2,4)
			spr(1,p.x+16,p.y,2,4,true)
			--legs
			spr(3,p.x,p.y+32,2,4)
			spr(3,p.x+16,p.y+32,2,4,true)
		end
	end
	
	--draw the player if foot up
	if p.footup==true then
		--head
		spr(1,p.x,p.y,2,2)
		spr(1,p.x+16,p.y,2,2,true)
		--body
		spr(33,p.x,p.y+16,2,2)
		spr(7,p.x+16,p.y+16,2,2,true)
		--legs
		spr(41,p.x,p.y+32,2,2)
		spr(11,p.x+16,p.y+32,2,2)
		spr(37,p.x+16,p.y+48,2,2,true)
	end
	
	--draw the player if left foot
	if p.footl==true then
		--head
		spr(1,p.x,p.y,2,2)
		spr(1,p.x+16,p.y,2,2,true)
		--body
		spr(7,p.x,p.y+16,2,2)
		spr(7,p.x+16,p.y+16,2,2,true)
		--legs
		spr(5,p.x,p.y+32,2,4)
		spr(39,p.x+16,p.y+32,2,2)
		spr(9,p.x+16,p.y+48,2,2)
	end
	
	--draw the player if right foot
	if p.footr==true then
		--head
		spr(1,p.x,p.y,2,2)
		spr(1,p.x+16,p.y,2,2,true)
		--body
		spr(7,p.x,p.y+16,2,2)
		spr(7,p.x+16,p.y+16,2,2,true)
		--legs
		spr(39,p.x,p.y+32,2,2,true)
		spr(9,p.x,p.y+48,2,2,true)
		spr(5,p.x+16,p.y+32,2,4,true)
	end
end
