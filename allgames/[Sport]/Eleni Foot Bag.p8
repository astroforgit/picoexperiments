--ball function

function ball_init()
	--ball object
	b={}
	--ball position
	b.x=60
	b.y=111
	--ball size
	b.w=8
	b.h=8
	--ball goes to up
	b.up=false
end

function ball_update()	
	--ball gravity
	b.y=b.y+6
	if b.y<0 then
		b.up=false
	end
	
	--put the ball at the ground
	if b.y>111 then
		b.y=111
		
		--save max combo
		if ui.combo>ui.maxcombo then
			ui.maxcombo=ui.combo
		end	
		
		--put the combo to 0
		ui.combo=0
		
		--put the ball
		--if it's too right
		if b.x>105 then
			b.x=98
		end
	end
	
	--ball goes to up
	if b.up==true then
		b.y=b.y-12
	end
	
	--put the ball
	--if offscreen to left
	if b.x<0 then
		b.x=0
	end
	
	--put the ball
	--if offscreen to right
	if b.x>128 then
		b.x=128-b.w
	end
	
	--collision ball/pigeon
	if collision(
		b.x,b.y,b.w,b.h,
		pigeon.x,pigeon.y,
		pigeon.w,pigeon.w)
	and pigeon.ishit==false then
		--play the sounf effect
		sfx(2)
		
		--pigeon is hit by the ball
		pigeon.ishit=true
		
		--add +1 to the count of
		--pigeon being shot
		pigeon.shot=pigeon.shot+1
		
		--add +8 to the score
		ui.score=ui.score+8
	end
end

function ball_draw()
	--draw the ball
	spr(16,b.x,b.y)
end
-->8
--hitbox functions

function hitbox_init()
	--head hitbox object
	hhead={}
	--head hitbox position
	hhead.x=-128
	hhead.y=0
	--head hitbox size
	hhead.w=9
	hhead.h=10
	
	--foot up hitbox object
	hfootup={}
	--foot up hitbox position
	hfootup.x=-128
	hfootup.y=0
	--foot up hitbox size
	hfootup.w=8
	hfootup.h=4
	
	--knee hitbox object
	hknee={}
	--knee hitbox position
	hknee.x=-128
	hknee.y=0
	--knee hitbox size
	hknee.w=6
	hknee.h=6
	
	--left foot object
	hfootl={}
	--left foot position
	hfootl.x=-128
	hfootl.y=0
	--left foot size
	hfootl.w=8
	hfootl.h=4
	
	--right foot object
	hfootr={}
	--right foot position
	hfootr.x=-128
	hfootr.y=0
	--right foot size
	hfootr.w=8
	hfootr.h=4
end

function hitbox_update()
	--update the head hitbox
	--object position
	hhead.x=p.x+11
	hhead.y=p.y
	
	--collision head hitbox
	--/ball
	if collision(
		b.x,b.y,b.w,b.h,
		hhead.x,hhead.y,
		hhead.w,hhead.h)
	and p.jump==true then
		--play the sound effect
		sfx(0)
		
		--the ball goes to up
		b.up=true
		b.x=b.x+(rnd(12)-6)
		
		--add +3 to the score
		ui.score=ui.score+3
		
		--add +1 to the combo count
		ui.combo=ui.combo+1
		
		--add +1 to the head count
		ui.headc=ui.headc+1
		
		--gain double points if combo
		--is a multiple of 10
		if ui.combo%10==0
		and ui.combo>0 then
			--play the sound effect
			sfx(1)
			
			--add +6 to the score
			ui.score=ui.score+6
		end
	end
	
	--update the foot up hitbox
	--object position
	hfootup.x=p.x+1
	hfootup.y=p.y+59
	
	--collision foot up hitbox
	--/ball
	if collision(
		b.x,b.y,b.w,b.h,
		hfootup.x,hfootup.y,
		hfootup.w,hfootup.h)
	and p.footup==true then
		--play the sound effect
		sfx(0)
		
		--the ball goes to up
		b.up=true
		b.x=b.x+(rnd(12)-6)
		
		--add +1 to the score
		ui.score=ui.score+1
		
		--add +1 to the combo count
		ui.combo=ui.combo+1
		
		--add +1 to the foot count
		ui.footc=ui.footc+1
		
		--gain double points if combo
		--is a multiple of 10
		if ui.combo%10==0
		and ui.combo>0 then
			--play the sound effect
			sfx(1)
			
			--add +2 to the score
			ui.score=ui.score+2
		end
	end
	
	--update the knee hitbox
	--object position
	hknee.x=p.x+9
	hknee.y=p.y+32
	
	--collision knee hitbox
	--/ball
	if collision(
		b.x,b.y,b.w,b.h,
		hknee.x,hknee.y,
		hknee.w,hknee.h)
	and p.footup==true
	and b.y<87 then
		--play the sound effect
		sfx(0)
		
		--the ball goes to up
		b.up=true
		b.x=b.x+(rnd(12)-6)
		
		--add +1 to the score
		ui.score=ui.score+1
		
		--add +1 to the combo count
		ui.combo=ui.combo+1
		
		--add +1 to the knee count
		ui.kneec=ui.kneec+1
		
		--gain double points if combo
		--is a multiple of 10
		if ui.combo%10==0
		and ui.combo>0 then
			--play the sound effect
			sfx(1)
			
			--the ball goes to up
			ui.score=ui.score+2
		end
	end
	
	--update the left foot hitbox
	--object position
	hfootl.x=p.x+23
	hfootl.y=p.y+48
	
	--collision left foot hitbox
	--/ball
	if collision(
		b.x,b.y,b.w,b.h,
		hfootl.x,hfootl.y,
		hfootl.w,hfootl.h)
	and p.footl==true then
		--play the sound effect
		sfx(0)
		
		--the ball goes to up
		b.up=true
		b.x=b.x+(rnd(12)-6)
		
		--add +2 to the score
		ui.score=ui.score+2
		
		--add +1 to the combo count
		ui.combo=ui.combo+1
		
		--add +1 to the left heel
		--count
		ui.lheelc=ui.lheelc+1
		
		--gain double points if combo
		--is a multiple of 10
		if ui.combo%10==0
		and ui.combo>0 then
			--play the sound effect
			sfx(1)
			
			--add +4 to the score
			ui.score=ui.score+4
		end
	end

	--update the right foot hitbox
	--object position
	hfootr.x=p.x
	hfootr.y=p.y+48
	
	--collision right foot hitbox
	--/ball
	if collision(
		b.x,b.y,b.w,b.h,
		hfootr.x,hfootr.y,
		hfootr.w,hfootr.h)
	and p.footr==true then
		--play the sound effect
		sfx(0)
		
		--the ball goes to up
		b.up=true
		b.x=b.x+(rnd(12)-6)
		
		--add +2 to the score
		ui.score=ui.score+2
		
		--add +1 to the combo count
		ui.combo=ui.combo+1
		
		--add +1 to the right heel
		--count
		ui.rheelc=ui.rheelc+1
		
		--gain double points if combo
		--is a multiple of 10
		if ui.combo%10==0
		and ui.combo>0 then
			--play the sound effect
			sfx(1)
			
			--add +4 to the score
			ui.score=ui.score+4
		end
	end
end

function hitbox_draw()
	--draw the head hitbox
	rect(hhead.x,hhead.y,
		hhead.x+hhead.w,
		hhead.y+hhead.h,
		11)
		
	--draw the foot up hitbox
	rect(hfootup.x,hfootup.y,
		hfootup.x+hfootup.w,
		hfootup.y+hfootup.h,
		11)
		
	--draw the knee hitbox
	rect(hknee.x,hknee.y,
		hknee.x+hknee.w,
		hknee.y+hknee.h,
		11)
		
	--draw the left foot hitbox
	rect(hfootl.x,hfootl.y,
		hfootl.x+hfootl.w,
		hfootl.y+hfootl.h,
		11)
		
	--draw the right foot hitbox
	rect(hfootr.x,hfootr.y,
		hfootr.x+hfootr.w,
		hfootr.y+hfootr.h,
		11)
end
