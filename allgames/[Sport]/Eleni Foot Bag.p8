--collision function

function collision(
	x1,y1,w1,h1,
	x2,y2,w2,h2)
	
	return x1<x2+w2
		and x1+w1>x2
		and y1<y2+h2
		and y1+h1>y2
end
-->8
--user interface functions

function ui_init()
	--ui object
	ui={}
	--the score
	ui.score=0
	--the combo
	ui.combo=0
	ui.maxcombo=0
	--the game time
	ui.time=76
	--the counts
	ui.headc=0
	ui.footc=0
	ui.kneec=0
	ui.lheelc=0
	ui.rheelc=0
end

function ui_update()
	--reduce playing time
	ui.time=ui.time-0.03
	
	--if the playing time
	--equal to 0
	if ui.time<=0 then
		--play the sound effect
		sfx(3)
		
		--put the new value of
		--the max combo
		if ui.combo>ui.maxcombo then
			ui.maxcombo=ui.combo
		end
		
		--go to game over screen
		gamestate=2
		
		--stop music
		music(-1)
	end
end

function ui_draw()
	--print the score
	print("score:",2,2,8)
	print(ui.score,28,2,7)
	
	--print the actual combo
	print("combo:",50,2,8)
	print(ui.combo,76,2,7)
	
	--print the playing time
	print("time:",96,2,8)
	print(flr(ui.time),118,2,7)
	
	--print when the actual combo
	--is a multiple of ten
	if ui.combo%10==0
	and ui.combo>0 then
		print(
			ui.combo.." hit combo!",
			40,12,10)
	end
end
-->8
--pigeon functions

function pigeon_init()
	--pigeon object
	pigeon={}
	--pigeon position
	pigeon.x=128
	pigeon.y=16
	--pigeon size
	pigeon.w=16
	pigeon.h=16
	--pigeon ready to enter
	pigeon.wait=0
	pigeon.ready=flr(5+rnd(10))
	--pigeon time anim
	pigeon.anim=0
	--pigeon is hit
	pigeon.ishit=false
	pigeon.shot=0
end

function pigeon_update()
	--pigeon is waiting for coming
	pigeon.wait=pigeon.wait+0.03

	--pigeon is ready to enter
	if pigeon.wait>=pigeon.ready
	then
		pigeon.x=pigeon.x-1
	end
	
	--anim the pigeon
	pigeon.anim=pigeon.anim+1
	if pigeon.anim>15 then
		pigeon.anim=0
	end
	
	--replace pigeon to right
	--if offscreen
	if pigeon.x<-32
	or pigeon.y>128 then
		pigeon.x=128
		pigeon.y=16
		pigeon.ready=flr(5+rnd(10))
		pigeon.wait=0
		pigeon.ishit=false
	end
	
	--pigeon is hit by the ball
	if pigeon.ishit==true then
		pigeon.y=pigeon.y+6
	end
end

function pigeon_draw()	
	--anim the pigeon
	if pigeon.anim<=7.5 then
		spr(43,pigeon.x,pigeon.y,
		2,2)
	elseif pigeon.anim>7.5 then
		spr(45,pigeon.x,pigeon.y,
		2,2)
	end
	
	--if the pigeon is shot
	if pigeon.ishit==true then
		--print when the pigeon
		--is shot
		print("you shot the pigeon!",
		26,20,7)
		
		--dran the pigeon
		spr(13,pigeon.x,pigeon.y,
		2,2)
	end
end
