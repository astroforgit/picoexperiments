--background functions

function background_init()
	--boat object
	boat={}
	--boat position
	boat.x=-8
	boat.y=52
	--boat ready to enter
	boat.wait=0
	boat.ready=flr(3+rnd(6))
end

function background_update()
	--boat is waiting for coming
	boat.wait=boat.wait+0.03
	
	--boat is ready to enter
	if boat.wait>=boat.ready then
		boat.x=boat.x+0.4
	end
	
	--put the boat to left
	--if offscreen
	if boat.x>128 then
		boat.x=-32
		boat.wait=0
		boat.ready=flr(5+rnd(10))
	end
end

function background_draw()
	--draw the background
	map(0,0)
	
	--draw the boat
	spr(86,boat.x,boat.y)
end
