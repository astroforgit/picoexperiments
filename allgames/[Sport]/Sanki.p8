--ui

function dowipein()
 if wipein<=0 and #wipep==0 then return end
 
 local wspd=0.06
 local wgap=wspd*128
 wipein-=wspd
 local wipey=128-flr(wipein*128)
 
 if wipein>0 then
  for i=0,50 do
   local newp={}
   newp.x=flr(rnd(128))
   newp.y=flr(wipey-(wgap*rnd()))
   newp.l=1+rnd(5)
   add(wipep,newp)
  end
 end
 

 rectfill(0,wipey,128,128,7)
 for p in all(wipep) do
  p.l-=1
  if p.l<=0 then
   del(wipep,p)
  else
   circfill(p.x,p.y,10*(p.l/7),7)
  end
 end
 
 
end
