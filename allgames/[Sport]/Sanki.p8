__lua__
-- sanki
-- by lazy devs
-- music by grubermusic

daynumber="18"
::_::
if (btnp()>0) goto donewithintro
cls()
f=4-abs(t()-4)
for z=-3,3 do
 for x=-1,1 do
  for y=-1,1 do
   b=mid(f-rnd(.5),0,1)
   b=3*b*b-2*b*b*b
   a=atan2(x,y)-.25
   c=8+(a*8)%8
   if (x==0 and y==0) c=7
   u=64.5+(x*13)+z
   v=64.5+(y*13)+z
   w=8.5*b-abs(x)*5
   h=8.5*b-abs(y)*5
   if (w>.5) rectfill(u-w,v-h,u+w,v+h,c) rect(u-w,v-h,u+w,v+h,c-1)
  end
 end
end
 
if rnd()<f-.5 then
 ?daynumber,69-#daynumber*2,65,2
end
 
if f>=1 then
 for j=0,1 do
  for i=1,f*50-50 do
   x=cos(i/50)
   y=sin(i/25)-abs(x)*(.5+sin(t()))
   circfill(65+x*8,48+y*3-j,1,2+j*6)
  end
 end
 
 for i=1,20 do
  ?sub("pico-8 advent calendar",i),17+i*4,90,mid(-1-i/20+f,0,1)*7
 end
end
 
if (t()==8) goto donewithintro
 
flip()
goto _
::donewithintro::
---------------------------
function wipeaway()
 wipe=0
 repeat
  wipe+=0.06
  local wipey=flr((128+32)*wipe)-32
  for i=0,1000 do
   local pi=rnd()
   local pr=rnd(10)
   local px=flr(rnd(128))
   local py=flr(wipey+(32*pi*pi*pi))
   if pr<1 then
    spr(flr(1+rnd(2)),px,py)
   else
    pset(px,py,7)
   end
  end
  rectfill(0,0,128,wipey,7)
  flip()
 until wipe>=1
 wipein=1
end
wipeaway()

function _init()
 debug=""
 
 hexchar="0123456789abcdef"

 charhex={}
 for i=1,16 do
  charhex[sub(hexchar,i,i)]=i-1
 end
 vectordata = strtovec("{{{0d0d{5b8e71517f455b8e7f4591465b8e9146a7535b8ea75397665b8e9766978f4c905b8e978f4c90978fb5914c90b591c1b04c90c1b0acc04c90acc04abf4c904abf41a8}}}}")
 vec_tumble = strtovec("{{{0d0d{8841a64e986d986dbd79be9e986dbe9e999a8841986d999a8841999a93b9884193b965c165c142965985884165c15985884159856467884164674068884140683f5088413f505842}}}}")
 vec_floor = strtovec("{{{0d0d{b8acbfa2bebf96acb8acbebf96acbebf6bbe829596ac6bbe7e6982956bbe81447e696bbe81446bbe5dab81445dab4ebd81444ebd3bbe81443bbe548c8144548c636c8144636c5060814450604f4981444f496842}}}}")
 vec_san2 = strtovec("{{{0d0d{a99dc090b3bf419da99db3bf419db3bf4abf}}}}")
 main()
end

function _draw()
 _drw()
 dowipein()
 if debug!="" then
  print(debug,4,22,8)
 end
end

function _update60()
 _upd()
end

function startride()
 music(0)
 
 --shawl={}
 --shawl[1]={x=0,y=0}
 --shawl[2]={x=0,y=-8}
 --shawl[3]={x=4,y=-12}
 endwait=1080
 dopan=false
 muzak=false
 panup=0
 panupd=80
 had=80
 panspd=0
 happyp={}
 has=0
 debug=""
 camx=0
 camy=0
 skyy=6
 san_x=16
 san_air=false
 san_airtime=0
 san_sx=0
 san_sy=0
 san_scpi=2
 san_scp=scape[san_scpi]
 san_y=san_scp.ly
 san_spd=0.1
 san_ang=0
 san_angs=0
 san_rang=0
 san_squish=1
 san_tw=0
 san_tlen=0
 san_tspace=0
 san_tcool=0
 handsoff=true
 
 launch_ang=0
 san2_x=16
 san2_air=false
 san2_sx=0
 san2_sy=0
 san2_scpi=2
 san2_scp=scape[san_scpi]
 san2_y=san_scp.ly
 san2_spd=0.1
 san2_ang=0
 san2_show=false

 san_doha=false

 tumble=false
 
 _drw=draw_game
 _upd=update_game
end

function gameover()
 _drw=draw_gover
 _upd=update_gover
 music(-1)
 san_tw=0
 san_tcool=0
 san_tspace=0
 make_happyp()
end

function main()
 _drw=draw_start
 _upd=update_start
 wipep={}
 camx=0
 camy=0
 shake=0
 skyy=14

 music(25)
 makescape()
end
-->8
--draws

function draw_start()
 doshake()
 rectfill(0,0,128,128,6)
 draw_sky()
 draw_scape()
 draw_parts()
 
 local sx=10.5+sin(time()*0.3)*4
 local sy=25.5+cos(time()*0.2)*2

 pal(8,2)
 sspr(0,8,107,43,sx+1,sy+2)
 pal() 
 sspr(0,8,107,43,sx,sy)

 coprint("press — to ride",63,85,7,13)
 
 cprint("lazydevs presents",63,2,6)
 cprint("music by gruber",63,8,6)

end

function draw_game()
 doshake()
 rectfill(0,0,128,128,6) 
 draw_sky()
 draw_scape()
 draw_san()
 draw_parts()

 --print(camx,4,4,8)
 --print(camy,4,10,8)
 --print(#scape,4,16,8)
end

function draw_gover()
 doshake()
 rectfill(0,0,128,128,6)
 draw_sky()
 draw_scape()
 draw_san()
 draw_parts()
 draw_happyp()

 --sspr(0,51,98,64,15,skyy-75)
 
 oprint("— again",4,118,7,13)
end

function draw_scape()
 
 for scp in all(scape) do
  if scp.rx-camx>=0 then
   render_poly({0.5+scp.lx-camx,0.5+scp.ly-camy,0.5+scp.rx-camx,0.5+scp.ry-camy,0.5+scp.rx-camx,128,0.5+scp.lx-camx,128},7)
  end
  --line(scp.lx,scp.ly,scp.rx,scp.ry,7)
 end
 --rectfill(0,64,128,128,7)
 
end

function draw_san()
 local sx=san_x-1-camx
 local sy=san_y-2-camy
 local vec=vectordata
 
 if tumble then
  if san_spd<0.8 and san_air==false then
   vec=vec_floor
  else
   vec=vec_tumble
  end
 end
 
 sprv(vec,1,sx,sy,0.05,-san_rang-0.25,san_squish)
 
 if san2_show then
  sx=san2_x-1-camx
  sy=san2_y-2-camy
  sprv(vec_san2,1,sx,sy,0.05,-san2_ang-0.25,1)
 end
 --pset(san_x,san_y,8)
end

function draw_parts()
 for p in all(part) do
  local px=0.5+p.x-camx
  local py=0.5+p.y-camy
  if py<=skyy then
   if p.txt!=nil then
    print(p.txt,px,py,6)
   else
    pset(px,py,6)
   end
  else
   if p.txt!=nil then
    print(p.txt,px,py,7)
   else
    if p.snw==0 or p.snw==nil then
     pset(px,py,7)
    else
     spr(p.snw,px-1,py-1)
    end
   end
  end
 end
end

function draw_sky()
 fillp()
 rectfill(-camx,0,128,skyy,13)
 if flr(camx/3)%2==0 then
  fillp(0b0101101001011010.1)
 else
  fillp(0b1010010110100101.1)
 end
 rectfill(0,skyy+1,128,skyy+3,13)
 rectfill(0,skyy+5,128,skyy+5,13)
 if flr(camx/3)%4==0 then
  fillp(0b1101110111011101.1)
 elseif flr(camx/3)%4==1 then
  fillp(0b1011101110111011.1)
 elseif flr(camx/3)%4==2 then
  fillp(0b0111011101110111.1)
 else
  fillp(0b1110111011101110.1)
 end
 rectfill(0,skyy+7,128,skyy+7,13)
 fillp()
end

function draw_happyp()
 local c
 --debug=skyy.." / "..#happyp
 if skyy>60 then
  for p in all(happyp) do
   if p.age>450 then
    if p.age>460 then
     c=7
    else
     c=6
    end
    if sin((time()/p.rm)+p.ro)>-0.5 then
     pset(p.x,skyy+p.y,c)
    end
   end
  end
 end
end
-->8
--updates

function update_start()
 move_parts()
 kill_parts()

 if btnp(5) then
  wipeaway()
  startride()
 end
end

function update_game()
 sanphysics()
 if san2_show then
  sanphysics2()
 end
 --debug=san_spd
 
 while scape[#scape].rx-camx<128 do
  addscp(gen_up,gen_maxdown)
  genchange-=1
  if genchange<=0 then
   change_gen()
   genchange=4
   --debug=gen_maxdown
  end
 end
 if btn(5) then
  
  san_spd*=0.97
  --tumbledown()
 end
 resetscroll()
 move_parts()
 kill_parts()
end

function update_gover()
 
 if panup<90 and dopan then
  if panupd>0 then
   panupd-=1
  else
   local nspd=(90-panup)/15
   if panspd<nspd then
    panspd=panspd+0.01
   else
    panspd=nspd
   end
   panspd=min(panspd,0.7)
   panup=panup+panspd
   skyy=skyy+panspd*0.9
   camy=camy-panspd
  end
 end
 
 update_happyp()
 
 if san2_show then
  sanphysics2()
 end
 
 san_squish+=(1-san_squish)/15
 if san_doha and has<20 then
  if had>0 then
   had-=1
  else
   if san_tw<=0 then
    parttxt(san_x-4,san_y-12,0.1,-0.6,"ha")
    if muzak==false then
     sfx(62)
    end
    dopan=true
    has=has+1
    san_tw=13
    san_squish=0.7
   else
    san_tw-=1
   end
  end
 else
  if san_tw<=0 then
   dopan=false
   parttxt(san_x-4,san_y-12,0.1,-0.6,"aaaw")
   san_tw=1
   sfx(61)
   san_squish=0.7
  end 
 end
 
 if muzak==false and skyy>20 then 
  music(22)
  muzak=true
 end
 
 move_parts()
 kill_parts() 
 if btnp(5) then
  wipeaway()
  makescape()
  startride()
 end
 
 endwait-=1
 if endwait<0 then
  wipeaway()
  main()
 end
end

function sanphysics()
 if san_air then
  airphysics()
 else
  grndphysics()
 end
 if san_x>64 then
  camx=san_x-64
 end
 if san_y>64 then
  camy=san_y-64
 end
 san_squish+=(1-san_squish)/15
 if san_tspace>0 then
  san_tspace-=1
 else
  if san_tcool<=0 then
   san_tspace=240
  end

  if san_spd>1.0 then
   san_doha=true
  end
  
  if san_spd>1.8 and san_tcool>0 then
   if san_tw==-99 then
    san_tw=0
    parttxt(san_x-4,san_y-12,0,0,"w")
    san_tw+=7/san_spd
   elseif san_tw<=0 then
    parttxt(san_x-4,san_y-12,0,0,"o")
    san_tw+=7/san_spd
   else
    san_tw-=1   
   end
   san_tcool-=1
  elseif san_spd<=1.8 then
   san_tspace=120
   san_tw=-99
  end
 end
end

function airphysics()
 san_airtime+=1
 san_sy+=0.015
 san_spd=dist(0,0,san_sx,san_sy)
 san_ang=getang(0,0,san_sx,san_sy)

 san_spd=san_spd*0.9985
 
 san_sx=sin(san_ang)*san_spd
 san_sy=cos(san_ang)*san_spd
 san_x+=san_sx
 san_y+=san_sy
 if tumble then
  san_rang=san_rang+(san_spd/15)
 else
  if btn(0) then
   san_angs-=0.002
   handsoff=false
  end
  if btn(1) then
   san_angs+=0.002
   handsoff=false
  end
  if handsoff then
   san_rang+=(san_ang-san_rang)/30
  end
  san_rang+=san_angs
  san_angs*=0.9
 end
 if san_x>san_scp.rx or san_x<san_scp.lx then
  san_scpi=findscp(san_x)
  san_scp=scape[san_scpi]
 end 
 local ty=groundx(san_x,san_scp)
 if ty<san_y then
  local mult=cos(san_ang-san_scp.ang)
  local str=(1-mult)*san_spd
  local impact_ang=abs((san_rang%1)-san_scp.ang)
  --debug=impact_ang
  --if (ndebug>debug) debug=ndebug
  
  san_squish=1-min(str,0.7)
  if str>0.3 then
   sfx(60)
   shake+=0.1*min(str,0.7)
   partcloud(san_x,san_y,san_sx,-san_sy*0.5,50)
  else
   if san_airtime>30 then
    sfx(59)
   end
  end
  local landingspd=san_spd
  san_spd=san_spd*mult
  san_y=ty
  san_air=false

  if tumble then
   san_spd=san_spd*0.5
  else
   if landingspd<1 or san_airtime<30 then
    if impact_ang>0.25 then
     tumbledown()
     shake+=0.1*min(str,0.7)
    end 
   else
    if impact_ang>0.12 then
     tumbledown()
     shake+=0.1*min(str,0.7)
    end
   end
   if tumble==false then
    if abs(launch_ang-san_rang)>0.75 then
     local turns=flr(abs(launch_ang-san_rang)+0.25)
     turns=turns*360     
     parttxt(san_x-4,san_y-12,0.1,-0.6,turns.."!")
    else
     if impact_ang<0.05 and san_airtime>120 then
      parttxt(san_x-4,san_y-12,0.1,-0.6,"smooth!")
     end
    end
   end
  end
 end

end

function grndphysics()
 san_sx=sin(san_scp.ang)*san_spd
 san_sy=cos(san_scp.ang)*san_spd

 san_x+=san_sx
 san_y+=san_sy
 
 if san_x>san_scp.rx or san_x<san_scp.lx then
  san_scpi=findscp(san_x)
  san_scp=scape[san_scpi]
  local ty=groundx(san_x,san_scp)
  if ty>san_y then
   --airtime
   san_air=true
   handsoff=true
   launch_ang=getang(0,0,san_sx,san_sy)
   san_airtime=0
   san_angs=0
   if san_spd>0.8 then
    partspritz(san_x,san_y,san_sx,san_sy,min(20,flr(20*(san_spd/1.8))))
   end
   if tumble then
    san_spd=san_spd*0.9
   end
   return
  end
 end
  
 san_y=groundx(san_x,san_scp)
 san_ang=san_scp.ang
 
 
 if tumble then
  san_spd=san_spd*0.99
  if san_spd<0.8 then
   san_rang=san_ang
   san_spd=san_spd*0.9
  else
   san_rang=san_rang+(san_spd/15)
   partcloud(san_x,san_y,san_sx,-san_sy*0.5,3)
  end
  if san_spd<0.03 then
   san_spd=0
  end
 else
  san_rang=san_ang
  san_spd=san_spd+san_scp.slp/45
  san_spd=san_spd*0.992
 end
 
 if san_spd<=0 then
   san_spd=0
   if tumble==false then
    had=0
   end
   gameover()
   return 
 end
end

function sanphysics2()
 if san2_air then
  airphysics2()
 else
  grndphysics2()
 end
end

function grndphysics2()
 san2_sx=sin(san2_scp.ang)*san2_spd
 san2_sy=cos(san2_scp.ang)*san2_spd

 san2_x+=san2_sx
 san2_y+=san2_sy
 
 if san2_x>san2_scp.rx or san2_x<san2_scp.lx then
  san2_scpi=findscp(san2_x)
  if san2_scpi==0 then
   san2_show=false
   return
  else
   san2_scp=scape[san2_scpi]
   local ty=groundx(san2_x,san2_scp)
   if ty>san2_y then
    --airtime
    san2_air=true
    return
   end
  end
 end
  
 san2_y=groundx(san2_x,san2_scp)
 san2_ang=san2_scp.ang
 san2_spd=san2_spd+san2_scp.slp/40
 san2_spd=san2_spd*0.999
 
 if san_spd<=0 then
   san_spd=0
 end
end

function airphysics2()
 san2_sy+=0.015
 san2_spd=dist(0,0,san2_sx,san2_sy)
 san2_ang=getang(0,0,san2_sx,san2_sy)

 san2_spd=san2_spd*0.999
 
 san2_sx=sin(san2_ang)*san2_spd
 san2_sy=cos(san2_ang)*san2_spd
 san2_x+=san2_sx
 san2_y+=san2_sy
 
 if san2_x>san2_scp.rx or san2_x<san2_scp.lx then
  san2_scpi=findscp(san2_x)
  if san2_scpi==0 then
   san2_show=false
   return
  else
   san2_scp=scape[san2_scpi]
  end
 end 
 
 local ty=groundx(san2_x,san2_scp)
 if ty<san2_y then
  san2_y=ty
  san2_air=false
 end

end

function groundx(tx,scp)
 return scp.ly+scp.slp*(tx-scp.lx)
end

function findscp(xx)
 for i=1,#scape do
  local scp=scape[i]
  if scp.lx<=xx and scp.rx>=xx then
   return i
  end
 end
 return 0
end

function resetscroll()
 local mx,my,limit=0,0,512
 if (camx>limit) mx=limit
 if (camy>limit) my=limit
 if mx>0 or my>0 then
  camx-=mx
  camy-=my
  san_x-=mx
  san_y-=my
  san2_x-=mx
  san2_y-=my
  lastx-=mx
  lasty-=my
  for scp in all(scape) do
   scp.lx-=mx
   scp.rx-=mx
   scp.ly-=my
   scp.ry-=my
   if scp.rx-camx<0 then
    del(scape,scp)
   end
  end
  san_scpi=findscp(san_x)
  san_scp=scape[san_scpi]
  for p in all(part) do
   p.x-=mx
   p.y-=my
  end
 end
end

function getang(x1,y1,x2,y2)
 return atan2(y2-y1,x2-x1)
end

function dist(x1,y1,x2,y2)
  return sqrt((x2 - x1)^2 + (y2 - y1)^2)
end

function move_parts()
 for p in all(part) do
  if p.grav then
   p.dy+=0.015
   p.dx*=0.995
  end
  p.x+=p.dx
  p.y+=p.dy
 end
end

function kill_parts()
 for p in all(part) do
  if p.x-camx<-16 then
   del(part,p)
  elseif p.y-camy>128 then
   if p.respawn then
    p.y-=128
   elseif p.txt==nil then
    del(part,p)
   end
  elseif p.y-camy<-8 and p.txt!=nil then
   del(part,p)
  end
 end
end

function tumbledown()
 if tumble then return end
 music(-1)
 sfx(63)
 tumble = true
 san_spd*=0.7
 san2_x=san_x
 san2_y=san_y
 san2_air=san_air
 san2_sx=san_sx
 san2_sy=san_sy
 san2_scpi=san_scpi
 san2_scp=san_scp
 san2_spd=san_spd
 san2_ang=san_ang
 san2_show=true
 parttxt(san_x-4,san_y-12,0.1,-0.6,"oof!")
end

function update_happyp()
 for p in all(happyp) do
  p.age+=1  
  if p.age>30000 then p.age=30000 end
 end
end
-->8
--randomgen

function makescape()
 lastx=-16
 lasty=48+flr(rnd(32))
 scape={}
 part={}
 for _x=1,8 do
  if _x==1 then
   addscp(0,0)
  elseif _x==2 then
   addscp(-2,1)
  else
   addscp(-1,20)
  end
 end
 gen_up=2
 gen_maxdown=18
 genchange=4
end

function change_gen()
 repeat
  new_maxdown=gen_maxdown+(rnd(20)-10)
 until new_maxdown>8 and new_maxdown<25
 gen_maxdown=new_maxdown

end

function addscp(up,maxdown)
 if up==nil then up=2 end
 if maxdown==nil then maxdown=18 end
 
 local scp={}
 lastx+=16
 scp.lx=lastx
 scp.rx=scp.lx+16
 scp.ly=lasty
 --lasty=lasty+flr(rnd(20)-6)
 lasty=lasty+flr(rnd(max(maxdown+up,1))-up)
 scp.ry=lasty
 scp.slp=(scp.ry-scp.ly)/16
 scp.ang=getang(scp.lx,scp.ly,scp.rx,scp.ry)
 add(scape,scp)
 --add parts
 makesnow(scp.lx,max(scp.ly,scp.rx)-128,16,128,10)
end

function makesnow(x,y,w,h,n)
 local px,py,_snw
 for i=1,n do
  px=flr(x+rnd(w))
  py=flr(y+rnd(h))
  local tdy=0.2+rnd(0.5)
  if rnd(16)<1 then
   _snw=flr(1+(rnd(2)))
  else
   _snw=0
  end
  add(part,{x=px,y=py,dx=0,dy=tdy,grav=false,respawn=true,snw=_snw})
 end
end

function partspritz(px,py,dx,dy,n)
 local _snw
 for i=1,n do
  local tdx=dx*rnd()
  local tdy=dy*rnd()
  if abs(dy)<0.1 then
   tdy+=rnd(0.1)-0.05
  end
  if rnd(16)<1 then
   _snw=flr(3+(rnd(2)))
  else
   _snw=0
  end
  add(part,{x=px,y=py+flr(rnd(1.99)),dx=tdx,dy=tdy,grav=true,respawn=false,snw=_snw})
 end
end

function partcloud(px,py,sx,sy,n)
 local dang=getang(0,0,sx,sy)
 local dspd=dist(0,0,sx,sy)
 local _snw
 for i=1,n do
  local tang=dang+rnd(0.2)-0.1
  local tspd=dspd*rnd()
  local tdx=sin(tang)*tspd
  local tdy=cos(tang)*tspd
  if rnd(24)<1 then
   _snw=flr(3+(rnd(2)))
  else
   _snw=0
  end
  add(part,{x=px,y=py+flr(rnd(1.99)),dx=tdx,dy=tdy,grav=true,respawn=false,snw=_snw})
 end
end

function parttxt(px,py,sx,sy,t)
 add(part,{x=px,y=py,dx=sx,dy=sy,grav=false,respawn=false,txt=t})
end

