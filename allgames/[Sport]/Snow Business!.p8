pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
--snow business
function _init()
  a=0.0
  rotation=0x0.04
  x=30
  y=0
  s=0
  r=6
  smashed=0
  smash=0
  power=0
  ground=6
  sflag=true
  sfx(0)
  inv=0
  title=true
  trophies=0
  spin=0
  trail={}
  smax=3
  c=6
  st=time()
  et=0
  for i=0,127,1 do
    for j=0,63,1 do
      if (mget(i,j)==39) trophies+=1
    end
  end
end

function _update()
  pa=a
  
  if (btn(‹) and r==ground) a+=rotation
  if (btn(‘) and r==ground) a-=rotation
  if (btn(”) or btn(—)) then 
  smax=6
  else
  smax=3
  end
  if (y>80) title=false 
  --[[if (btn(—) and r==ground and power<7) power+=1
  if (power>0 and (not btn(—) or r>ground)) then
    r+=1
    power-=1
  elseif (power==0 and r>ground) then
   r-=1
  end]]--
  
  if (a<0)     a=0
  if (a>0.5)   a=0.5
  
  if (a>0.4 or a<0.1) then
    if (sflag) then 
     sfx(1)
     sflag=false
    end
  elseif (not btn(ƒ) and not btn(Ž)) then
    sflag=true
  end
  
  tipx=cos(a)*r
  tipy=sin(a)*r
  s-=sin(a)
  s=0.8*s
  
  if (s<0) s=0
  if (s>smax) s=smax
  
  if (btn(ƒ)or btn(Ž)) then
   s=s*.5
   if (sflag) then 
    sfx(5)
    sflag=false
   end
  end
  ptilex=((x-tipx+64)/8)&127
  ptiley=((y-tipy+32)/8)&63
  
  x-=cos(a)*s
  y-=sin(a)*s
  if(x>1024)then
  
  x-=1024
  i=1
  while trail[i] do
   trail[i][1]-=1024
   i+=1
  end
  end
  
  if(x<0)then
   x+=1024
   i=1
   while trail[i] do
   trail[i][1]+=1024
   i+=1
  end
  end 
  
  if (y>512) then
  y-=512
  x-=256
  i=1
  while trail[i] do
   trail[i][1]-=256
   trail[i][2]-=512
   i+=1
  end
  end
  if(y<0)y+=512
  
  tilex=((x-tipx+64)/8)&127
  tiley=((y-tipy+32)/8)&63
  
  flag=fget(mget(tilex,tiley))
  
  if(flag>0) then
   if (inv==0) sfx(2)
   inv=1
   if (flag==1) mset(tilex,tiley,mget(tilex,tiley)+7) smash+=1
   if (fget(mget(ptilex,tiley))>0)then 
    y+=sin(a)*s
    if (btn(‹)or btn(‘)) y-= 0.5
   end
   if (fget(mget(tilex,ptiley))>0) then
    x+=cos(a)*s
    if (btn(‘) and a<0.25)x+=1
    if (btn(‹) and a>0.25)x-=1
   end
    
  else
   inv=0
   if (mget(tilex,tiley)==39) then
    sfx(6)
    trophies-=1
    mset(tilex,tiley,51)
   end
  end
  
  
  if (s>0) then
   add(trail,{x+tipx,y+tipy})
   add(trail,{x-tipx,y-tipy})
  end
end

function _draw()
  cls(0)
  --map((x/4)%64,(y/4)%64,0,0,16,16)
  --map((x/4)%64,(y/4)%64-64,0,0,16,16)
  map(0,0,-x,-y,128,64)
  map(0,0,-x+1024,-y,128,64)
  map(0,0,-x-1024,-y,128,64)
  map(0,0,-x,-y-512,128,64)
  map(0,0,-x+1024,-y-512,128,64)
  map(0,0,-x-1024,-y-512,128,64)
  map(0,0,-x-768,-y+512,128,64)
  map(0,0,-x+256,-y+512,128,64)
  map(0,0,-x+1280,-y+512,128,64)
  
  
  
  --print(fget(mget((x+64)/8,(y+32)/8)))
  i=2
  ploc=trail[1]
  
  while (trail[i]) do
   if (trophies<1) c=6+(i%9)
   loc=trail[i]
   
   dotx=64+loc[1]-x
   doty=32+loc[2]-y
   pdotx=64+ploc[1]-x
   pdoty=32+ploc[2]-y
   line(dotx,doty,pdotx,pdoty,c)
   
   if (doty<0 or doty>128 or i>100) del(trail,loc)
   if (pdoty<0 or pdoty>128 or i>100) del(trail,ploc)
   ploc=loc
   i+=1
   
  end
  
  --foreach(trail, function(loc) 
  --  pset(64+loc[1]-x,32+loc[2]-y,5)
  --end)
  
  
  line(64-tipx,32-tipy,64+tipx,32+tipy,0)
  if (trophies<1) pal(9,(8+(time()*16)%6))
  if (a==0) then
   spr(37,60,27,1,1,true)
  elseif(a<0.1) then
   spr(36,60,27,1,1,true)
  elseif(a<0.15) then
   spr(35,60,27,1,1,true)
  elseif(a<0.2) then
   spr(34,60,27,1,1,true)
  elseif(a<0.3) then
   spr(33,61,27)
  elseif(a<0.35) then
   spr(34,61,27)
  elseif(a<0.4) then
   spr(35,61,27)
  elseif(a<0.5) then
   spr(36,61,27)
  else
   spr(37,61,27)
  end
  pal()
  for i=-4,128,8 do
    for j=-4,128,8 do
     spr(48,(-x/2 -i+time()*1)&127-4,(-y/2-j+time()*8)&127,1,1,i&1)
    end
  end
  
  if (trophies>0) then
   print("trophies remaining:" .. trophies,20,120,9)
  elseif (trophies==0) then
   print("champion!",20,120,9)
   music(4,0)
   et=time()-st
   trophies-=1 
   smashed=smash
  else
  print("champion! time:"..et.."s \nscenery destroyed:"..smashed.." things",15,110,9)
  end
  
  if (title)then
    spr(40,28,56+y,8,6)
    print("‹‘ steer\nƒ/Ž break\n”/—crouch",40,38+y,0)
  end
  
  
end
