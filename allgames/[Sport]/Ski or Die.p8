pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
-- ski or die
-- by @paulrenej and music by curtcool

state = nil
hiscore = 0

function _init()
 cartdata("paulrene_skiordie")
 hiscore = dget(0)
	init_menu()
end

function _update()
 if state == "menu" then
   update_menu()
 elseif state == "game" then
   update_game()
 end
end

function _draw()
  if state == "menu" then
    draw_menu()
  elseif state == "game" then
    draw_game()
  end
end
-->8

function init_menu()
  state = "menu"
  init_snow(200,6)
  music(0)
end


function update_menu()
		update_snow()
  if(btn(5)) then
    sfx(16)
    init_game()
  end
end

a = 10
title = "ski or die"
function draw_menu()
  rectfill(0,0,127,127,1)
  map(0,0,1,0,16,16)
  draw_snow()
  for i=0,#title do
    y = sin(a-(i*0.05)) * 6
    a+=0.001
    print(sub(title,i,i),42+i*4-1,40+y-1,13)
    print(sub(title,i,i),42+i*4,40+y,7)
  end
  print("press — to ski",36,86,9)
  print("hiscore: "..hiscore,40,98,6)
  print("by @paulrenej",40,56,8)
  print("music by frank e. larsen",16,66,8)
  print("v1.2/2019.01.05",68,122,0)
end

-->8

function init_game()
  state = "game"
  music(-1)
  -- init mountain
  mnt = {}
  player = {}
  shots = {}
  rowcount = 0
  timer = 0
  local row = {}
  row.left = 16
  row.right = 128 - 16
  row.middle = 0
  add(mnt,row)
  -- init player
  player.x = 64-8
  player.y = 16
  player.direction = 0
  player.speed = 0
  player.targetspeed = 3
  player.sx = 0
  player.updatedelay = 0
  player.score = 0
  player.col_track = false
  player.col_tree = false
  player.col_stone = false
  player.col_dynamite = false
  player.extratime = 0
  player.time = 30
  player.gameover = false
  player.newhiscore = false
  player.snow = false
  player.dynamite = 3
  player.throw = true
  -- init timer
  timer = 0
  -- force update before draw
  update_game()
	 init_snow(50,7)
end

function update_game()
  timer += 1/30
  if player.gameover then
    if btn(4) then
      init_menu()
    elseif btn(5) then
      init_game()
    end
    return
  end
  update_mountain()
  update_player()
  update_snow()
  update_shots()
end

function update_shots()
  for s in all(shots) do
    s.x+=s.d
    s.y+=2
    s.c+=0.25
    if s.x>128 or s.x<0 or s.y>128 or s.y<0 then
      del(shots,s)
    end
  end
end

function draw_game()
  rectfill(0,0,127,127,6)
  draw_mountain()
  draw_player()
  draw_shots()
  draw_snow()
  draw_hud()
  check_collisions()
end

function draw_shots()
  for s in all(shots) do
    local t = flr(s.c%2)
    if t==0 then
      spr(57,s.x,s.y,1,1,false,false)
--      pset(s.x+1,s.y+2,0)
    else
      spr(57,s.x-4,s.y,1,1,true,false)
--      pset(s.x+1,s.y+2,0)
    end
  end
end

function draw_hud()
  if player.gameover then
    print("game over",48,52,8+(timer*10)%3)
    print("score: "..player.score,44,64,0)
    if player.newhiscore then
      print("new hiscore!",42,72,2)
    end
    print("press — to retry",30,80,0)
    print("or Ž to exit",38,88,0)
  else
    print("score",1,1,7)
    print(player.score,1,8,7)
    print("time",128-16,1,7)
    print(player.time-flr(timer*10)/10,128-16,8,7)
    if player.extratime>0 then
      print("+"..2*ceil(player.extratime/30),128-16,16,9)
    end
    print(hiscore,1,128-13,7)
    print("hiscore",1,128-6,7)
    for n=0,player.dynamite-1 do
      spr(55,128-8-1-(8*n),128-8-1)
    end
  end
end

function check_collisions()
  for n=1,#mnt do
    if n==flr(player.coly)+1 then
      if player.colx<=mnt[n].left then
        player.col_track = true
        player.x+=1
        sfx(15)
      elseif player.colx>=mnt[n].right then
        player.col_track = true
        player.x-=1
        sfx(15)
      end
    end
    if mnt[n].tree!=nil then
      local x0 = mnt[n].tree+1
      local y0 = n-4
      local x1 = x0+4
      local y1 = y0+5
      if isinside(player.colx,player.coly,x0,y0,x1,y1) then
        player.col_tree = true
        sfx(14)
      end
	     for s in all(shots) do
        if isinside(s.x+1,s.y+2,x0,y0,x1,y1) then
          mnt[n].explosion=mnt[n].tree
          mnt[n].tree = nil
          del(shots,s)
          player.score+=250
          sfx(18)
        end
      end
--      rect(x0,y0,x1,y1,0)
    end
    if mnt[n].stone!=nil then
      local x0 = mnt[n].stone
      local y0 = n-5
      local x1 = x0+3
      local y1 = y0+3
      if isinside(player.colx,player.coly,x0,y0,x1,y1) then
        player.col_stone = true
        sfx(13)
      end
--      rect(x0,y0,x1,y1,0)
    end
    if mnt[n].flag!=nil and mnt[n].flag>=0 then
      local x0 = mnt[n].flag
      local y0 = n-6
      local x1 = x0+4
      local y1 = y0+10
      if isinside(player.colx,player.coly,x0,y0,x1,y1) then
        player.time+=2
        mnt[n].flag*=-1
        player.extratime+=30
        sfx(12)
      end
--      rect(x0,y0,x1,y1,0)
    end
    if mnt[n].dynamite!=nil and mnt[n].dynamite>=0 then
      local x0 = mnt[n].dynamite
      local y0 = n-3
      local x1 = x0+5
      local y1 = y0+5
      if isinside(player.colx,player.coly,x0,y0,x1,y1) then
        mnt[n].dynamite=nil
        player.dynamite+=1
        sfx(16)
      end
--      rect(x0,y0,x1,y1,0)
    end
  end
end

function update_player()
  if player.updatedelay==0 then
    if btn(0) and player.direction>-3 then
      player.direction-=1
      player.updatedelay = 4
    elseif btn(1) and player.direction<3 then
      player.direction+=1
      player.updatedelay = 4
    end
  else
    player.updatedelay-=1
  end
  if player.throw==true
    and not btn(5) then
    player.throw = false
  elseif player.throw==false
    and btn(5)
    and player.dynamite>0 then
    player.throw = true
    player.dynamite-=1
    s = {}
    s.x = player.colx
    s.y = player.coly
    s.d = player.direction
    s.c = 0
    add(shots,s)
    sfx(17)
  end
  if player.speed<(player.targetspeed-0.1) then
    player.speed+=1
  elseif player.speed>(player.targetspeed+0.1) then
    player.speed-=0.1
  else
    player.speed = player.targetspeed
  end
  if player.col_track then
    player.speed = 0
  end
  if player.col_tree then
    player.speed = 0
  end
  if player.col_stone then
    player.speed = 0
  end
  if player.extratime>0 then
	   player.extratime-=1
  else
    player.extratime=0
  end
  if player.time-timer<10 and not player.snow then
  	 player.snow = true
  	 init_snow(50,12)
  end
  if player.time-timer<0 then
    player.gameover = true
    if player.score>hiscore then
      hiscore = player.score
      dset(0,hiscore)
      player.newhiscore = true
    end
  end
  player.targetspeed = 2-(0.5*abs(player.direction))
  player.sx = 0.25*player.direction
  player.x+=player.sx
  player.colx = player.x+3
  player.coly = player.y+11+player.speed*3
  player.col_track = false
  player.col_stone = false
  player.col_tree = false
  player.col_dynamite = false
end

function draw_player()
  local y = player.y + player.speed*3
  spr(16+abs(player.direction),player.x,y,1,2,player.direction<0,false)
  pset(player.colx,player.coly,0)
end

function update_mountain()
  rowcount += player.speed
  if #mnt>rowcount
      and rowcount>=1 then
    local num = flr(rowcount)
    for n=1,num do
	     del(mnt,mnt[1])
    end
    rowcount-=num
    player.score+=num
  end
  while #mnt<128 do
  		local row = {}
  		row.left = mnt[#mnt].left + rnd(2) - 1
  		row.left = mid(2,row.left,48)
  		row.right = mnt[#mnt].right + rnd(2) - 1
  		row.right = mid(128-48,row.right,128-2)
  		if #mnt>64 then
    		if rnd(50)<2 then
    		  row.tree = row.left+8+rnd(row.right-row.left-8*2)
    		end
    		if rnd(100)<2 then
    		  row.flag = row.left+8+rnd(row.right-row.left-8*2)
    		end
    		if rnd(100)<2 then
    		  row.stone = row.left+8+rnd(row.right-row.left-8*2)
    		end
    		if player.dynamite<3 and rnd(100)<2 then
    		  row.dynamite = row.left+8+rnd(row.right-row.left-8*2)
    		end
  		end
  		add(mnt,row)
  end
end

function draw_mountain()
  for n=1,#mnt do
    line(0,n-1,mnt[n].left,n-1,1)
    line(mnt[n].right,n-1,127,n-1,1)
    pset(mnt[n].left,n-1,0)
    pset(mnt[n].right,n-1,0)
    if mnt[n].tree!=nil then
      spr(5,mnt[n].tree,n-1-4)
    end
    if mnt[n].stone!=nil then
      spr(38,mnt[n].stone,n-1-4)
    end
    if mnt[n].flag!=nil then
      if mnt[n].flag>=0 then
	       spr(39,mnt[n].flag,n-1-4)
      else
	       spr(40,mnt[n].flag*-1,n-1-4)
      end
    end
    if mnt[n].dynamite!=nil then
      if mnt[n].dynamite>=0 then
	       spr(56,mnt[n].dynamite,n-1-4)
      end
    end
    if mnt[n].explosion!=nil then
      if mnt[n].explosion>0 then
        if flr(timer*100)%2==0 then
          spr(48,mnt[n].explosion,n-1-4)
        else
          spr(49,mnt[n].explosion,n-1-4)
        end
      end
    end
  end
end

function isinside(x,y,x0,y0,x1,y1)
  return x>=x0 and x<=x1 and y>=y0 and y<=y1
end
-->8

function init_snow(num,col)
  snowfall = {}
  snowcolor = col
  for n=0,num do
    snow = {}
    snow.x = rnd(127)
    snow.y = rnd(127)
    snow.t = rnd(2)
    snow.sx = rnd(1) - 0.5
    snow.sy = rnd(0.5) + 0.5
    add(snowfall, snow)
  end
end

function update_snow()
  for s in all(snowfall) do
    s.x += s.sx
    s.y += s.sy
    if (s.y>128) then
      s.y = 0
      s.sx = rnd(1) - 0.5
    end
    if (s.x<0) then s.x = 128 end
    if (s.x>128) then s.x = 0 end
  end
end

function draw_snow()
  for s in all(snowfall) do
    pset(s.x,s.y,snowcolor)
  end
end
