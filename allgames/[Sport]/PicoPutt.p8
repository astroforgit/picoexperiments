cartdata("eggnog_picoputt")

function _init()
	game_vars()
	level_gen()
end

function _update()
	if state==0 then
		move_title_screen()
	elseif state==1 then
		move_player()
	elseif state==2 then
		move_game_over()
	end
	move_swipe()
	move_particles()
end

function _draw()
	cls()
	draw_bg()
	collision()
	draw_player()
	if state==0 or
				state==3 then
		draw_title_screen()
	end
	draw_swipe()
	draw_fg()
	draw_particles()
	if state==3 then
		draw_eggnog_intro()
	end
	draw_game_over()
end
-->8
--levelgen

function game_vars()
 state,hole=3,0
	coursepar,par,shot,score=0,0,0,0
	palette={1,12,13}
	conditions={0b1111111111111111,0b1111111111111111,0b1011011111101101,0b1111011111111101,0b110110010010011}
	q=ceil(rnd(#palette))
	speed=q/10
	c1=palette[q]
	adj={"ancient","shadow","royal","arctic","pungent","crooked","long","old","green","golden","snake","fish","bear","puttputt","dank","dusty","choco","dognose","catpaw","odd","dirt","rocky","cape","deep","mystic","sky","emerald","pumpkin","dry","sandy"}
	noun={"link","hill","creek","island","rock","bluffs","beach","lake","dunes","base","greens","plateau","mountain","farm","castle","plains","valley","county","falls","desert","lagoon","canyon","pier","town","bay","ruins","coast","park"}
	name={a=adj[ceil(rnd(#adj))],n=noun[ceil(rnd(#noun))]}
	winddir={{"no",0,0},{"north",0,-1},{"south",0,1},{"east",1,0},{"west",-1,0}}
	titlestr={"(arrow keys) aim  (z) shoot","press (x) to start"}
	swipe={x=64,y=53,r=120,d=-4}
	gameoverstr={}
	fireworks={}
	blinds={}
	sparkles={}
	sfx(7)
end

function level_gen()
	p={}
	h={}
	trail={}
--add water sparkles
	while #sparkles<30 do
		add(sparkles,{x=rnd(120)+4,y=rnd(90)+4,t=rnd(30)+30,c=6})
	end
--set wind name and dir
	q=ceil(rnd(5))
	wind={
		name=winddir[q][1],
		x=winddir[q][2],
		y=winddir[q][3]
	}
	grass={}
	sand={}
	hole+=1
	coursepar+=par
	tv=ceil(rnd(#conditions))
	rough=conditions[tv]
	tp=flr(tv/4)
	par=0
 for i=1,5 do
 	j=19+i*15
 	k=36+rnd(29)
 	q=14+rnd(12)
 	add(grass,{x=j,y=k,r=q})
 	if i>1 and
 				i<5 then 		
		 add(sand,{x=j+rnd(q)-q/2,y=k+rnd(q)-q/2,r=3+rnd(3)})
 	end
--player + hole
 	if i==1 then
			p={x=j-q/2,y=k,a=.5,xd=0,yd=-5,p=0,v=0,px=j-q/2,py=k}
 	elseif i==5 then
			h={x=j+q/2,y=k}
 	end
		par+=((k-30)/4.1)+(abs((q-17)-10))
 end
	par=flr(par/14)+tp
	score+=shot
	shot=0
end
-->8
--bg + fg

function draw_bg()
	rectfill(2,2,125,98,c1)
	foreach(sparkles,draw_sparkles)
	for v in all(grass) do
 	circfill(v.x,v.y,v.r+3,3)
	end
	fillp(rough)
	for v in all(grass) do
 	circfill(v.x,v.y,v.r,179)
 end
	fillp()
 for v in all(sand) do
 	circfill(v.x,v.y,v.r+2,3)
	end
 for v in all(sand) do
 	circfill(v.x,v.y,v.r,c1)
 end
--hole
 circfill(h.x,h.y,2,0)
end

function draw_fg()
	foreach(blinds,draw_blinds)
--border
	rect(0,0,127,99,7)
	rectfill(0,100,127,127,7)
	rect(1,1,126,99,0)
--bottom ui + power bar
	rectfill(3,103,p.p*30.25+3,106,0)
	if state!=1 then
		pal(0,6)
	end
	rect(3,103,124,106,0)
	print(name.a.." "..name.n.."\nhole "..hole.."/9\npar "..par,3,108,0)
	print(wind.name.." wind\nshot "..shot.."\nscore "..score.."/"..coursepar,73,108,0)
	pal()
end
-->8
--player

function draw_player()
 circfill(p.x,p.y,2,7)
	pset(p.x+p.xd,p.y+p.yd,7)
end

function move_player()
--power bar increase / pause
	if p.v < 0.05 then
 	if p.p != 0 then
 		p.p+=.02+p.p/15
 		if btnp(4) then
 			p.v=p.p+speed
 			p.p=0
				splode()
				sfx(-1)
				sfx(2)
			elseif p.p > 4 then
				p.v=.5
				p.p=0
				splode()
				sfx(-1)
				sfx(2)
 		end
 	else
--stop ball, set prev shot
			p.v=0
			p.px=p.x
			p.py=p.y
--set shot angle to right
   if btnp(5) or
   			btnp(1) then
   	if p.a<.95 then
   		p.a+=.036
   	else 
   		p.a=0
   	end
   	sfx(0)
   	p.xd=sin(p.a)*5
   	p.yd=cos(p.a)*5
   end
--set shot angle to left
   if btnp(0) then
   	if p.a>0 then
   		p.a-=.036
   	else 
   		p.a=.95
   	end
   	sfx(0)
   	p.xd=sin(p.a)*5
   	p.yd=cos(p.a)*5
   end
--set off shot
 		if btnp(4) then
 			p.p+=.02
 			shot+=1
				sfx(1)
 		end
 	end
	end
--apply wind to moving ball
	if p.v > 0.02 then
		p.x+=(wind.x/8)
		p.y+=(wind.y/8)
		if p.v>.6 then
			add(trail,{x=p.x,y=p.y,r=3,s=.7,c=7})
		end
	end
--move ball, apply deceleration
	if swipe.r==2 then
  p.x+=(p.v*p.xd)/4
  p.y+=(p.v*p.yd)/4
  p.v*=.95
	end
end

function collision()
	q=pget(p.x,p.y)
--out of bounds
 if q==c1 then
		splode()
		p.x,p.y,p.v=p.px,p.py,0
		shot+=2
		splode()
		sfx(3)
--rough
	elseif q==3 then
		p.v*=.77
--hole
	elseif q==0 and
								swipe.r==2 then
		sfx(9)
		p.v=0
		trail={}	
		swipe.x=p.x
		swipe.y=p.y
		swipe.r=3
	end
end
-->8
--particles

function draw_particles()
	foreach(trail,draw_trail)
end

function move_particles()
	foreach(sparkles,move_sparkles)
	foreach(trail,move_trail)
	foreach(fireworks,move_fireworks)
	foreach(blinds,move_blinds)
end

function draw_sparkles(v)
	pset(v.x,v.y,v.c)
end

function move_sparkles(v)
	if v.t>0 then
		v.t-=1
	else
		v.x,v.y,v.t=rnd(120)+4,rnd(90)+4,rnd(30)+30
	end
end

function scan_blinds()
-- set starting point (adjust when imported)
	x,y,w,xlimit,ylimit = 2,35,1,125,69
	while y < ylimit do
		while x < xlimit do
--set line's color
			c = pget(x,y)
--increase length of line while colored line is the same
			while pget(x+w,y) == c do
				w += 1
			end
--when next color is reached, add line to table, and start a new line.
			add(blinds,{x=x,y=y,w=x+w,c=c,s=y/15,q=0-w})
			x = x+w
			w = 0
		end
		y+=1
		x=2
	end
end

function draw_blinds(v)
	line(v.x,v.y,v.w,v.y,v.c)
end

function move_blinds(v)
	if v.x > v.q then
		v.x -= v.s
	else
		if #blinds==1 then
			if dget(1)==0 then
				music(10)
			end
		end
		del(blinds,v)
	end
end

function draw_fireworks(v)
	line(v.x,v.y,v.x-5,v.y-5,7)
end

function move_fireworks(v)
	if v.x>130 then
		v.x=3
	end
	if v.y>104 then
		v.y=2
	end
	v.x+=1
	v.y+=1
end

function splode()
	for i=1,5 do
		add(trail,{x=p.x+rnd(2)-2,y=p.y+rnd(4)-2,r=4,s=.35,c=7})
	end
end

function draw_trail(v)
	circfill(v.x,v.y,v.r,v.c)
end

function move_trail(v)
	if v.r>1 then
		v.r-=v.s
	else
		del(trail,v)
	end
end
-->8
--state functions

function pal_fade(tr)
	local j={0,5,6,7}
	local k={50,40,30,-10}
	q=4
	for i=1,3 do
		if tr>k[i] then
			q=i
			break
		end
	end
	return j[q]
end

function draw_eggnog_intro()
	pal(7,pal_fade(swipe.r))
	if swipe.r>30 then
		spr(33,50,45,4,2)
	end
	pal()
end

function move_game_over()
--set string if first frame
	if #gameoverstr==0 then
		level_gen()
		hole-=1
		k=ceil(rnd(10))
		q=ceil(rnd(6))+3
		if score<coursepar+1 then
			i="you win!"
		else
			i="try again!"
		end
		gameoverstr={"thank you for attending","the "..k..q.."th annual",name.a.." "..name.n.." classic!","","","",i,"par was "..coursepar..", and","you finished in "..score.." shots.","","(x) to continue"}
	end
	if btn(5) then
		music(-1)
		_init()
	end
--make bg rainy effect
	while #fireworks < 40 do
		add(fireworks,{x=rnd(110)+9,y=rnd(96)+2})
	end
end

function draw_game_over()
	if state==2 then
		rectfill(2,2,125,98,c1)
		foreach(fireworks,draw_fireworks)
--banner
 	pal(8,0)
 	spr(9,3,16,2,3)
 	spr(9,109,16,2,3,true)
 	rectfill(19,17,108,37,7)
 	line(19,16,108,16,0)
 	line(19,38,108,38,0)
 	pal()
--box at bottom
 	rectfill(1,52,126,86,7)
 	rect(1,52,126,86,0)
 	for i=1,#gameoverstr do
 		print(gameoverstr[i],65-#gameoverstr[i]*2,13+i*6,0)
 	end
 	draw_swipe()
		draw_fg()
	end
end

function draw_swipe()
	circfill(swipe.x,swipe.y,swipe.r,7)
end

function move_swipe()
	if swipe.r>2 then
		swipe.r+=swipe.d
	end
	if swipe.r>128 then
		if hole<9 then
 		swipe.d*=-1
 		state=1
 		level_gen()
 		swipe.x,swipe.y=h.x,h.y
		else
 		swipe.d*=-1
			swipe.x,swipe.y=64,45
			state=2
		end
	end
	if swipe.r<2 then
		swipe={x=-10,y=5,r=2,d=8}
		if state==3 then
			if dget(1)==0 then
				music(2)
			end
			state=0
		end
	end
end

function draw_title_screen()
--ball and hole mask
	circfill(p.x,p.y,5,11)
	circfill(h.x,h.y,5,11)
--title and text
	rectfill(1,35,126,68,7)
	pal(7,0)
	spr(1,33,38,8,2)
	pal()
	for i=1,#titlestr do
		print(titlestr[i],65-#titlestr[i]*2,49+i*6,0)
	end
end

function move_title_screen()
	if btn(5) then
		scan_blinds()
		music(-1)
		sfx(8)
		state=1
	end
end

function get_index(v,table)
	for k in all(table) do
		if table[k]==v then
			return k
		end
	end
end
-->8
--menu functions

menuitem(1,"quit to menu", function() _init() end)
menuitem(2,"toggle music", function() toggle_music() end)

function toggle_music()
	if dget(1)==0 then
		dset(1,1)
		music(-1)
	else
		dset(1,0)
		if state==0 then
			music(2)
		else
			music(10)
		end
	end
end
