--game over loop
function gameover_init()
	_update60=gameover_update60
	_draw=gameover_draw
	time = 0
end

function gameover_update60()

	if (btnp(4)) then
		
		menu_init() --back to menu
	end
	
    menu_time()
end

function gameover_draw()
	cls(0)
	palr()
	draw_logo()
	        print("score:",40,70,10)
        print(flr(player.score),72,70)


    if (level_won == true) then
        if(level >= 4) then
			win_init()
		end
		
		printd("level completed!",30,62,5,9)

        
        print("      play next level!",16,96,(flr(time/2%2))*5+10) --menu draw code
        	
        spr((flr(time/2/2%4)*2),16,94,2,1)
    else
        printd("game over!",44,62,5,10)

        
        print("      jump to try again!",16,96,(flr(time/2/2%2))*5+10) --menu draw code
	
        spr((flr(time/2/2%4)*2),16,94,2,1)
    end
end

function printd(string,posx,posy,col1,col2)
	x = posx y = posy
	print (string,x+1,y+1,col1)
	print (string,x,y,col2)
end
