pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
--skateboard iv
--a tiny game by @zuggamasta
player={
	xpos = 64,
	ypos = 64,
	w = 16,
	h = 8,
	charge = 5,
	jump = 1,
	score = 0,
	feet = false,
	fakie = false,
	state = {air,ground,rail},
 	board = 96,
	dx = 0,
 	dy = 0,
 	trick = "",
 	jumpforce = -4.4,
	combo = 0
}

--helper
coin = 224
tape = 232

--global variable
gravity = 0.33
drift = 0.1/2
speed =0.33
time = 0
timer = 0
pos = 0

--leveldata
level = 0
level_won = false
level_selected = 0
level_name = {"allyway","rooftop","skate plaza","skate park","credits"}
tape_collected = {false,false,false,false}


--menudata
entry = level+1

--trick animations
kickflip = {64,64,132,132,68,68,136,136,72,72,140,140,76,76,160,160}
flip_helper = {206,207,222,223}
popshovit = {64,64,64,64,164,164,164,164,168,168,168,168,172,172,172,172}


-->8
--game loop
function game_init()
	--reset values
    pos = 0
 	time = 0
    timer = 0
    level_won = false
    player.board = 96
    player.feet = false
    player.score = 0
	player.charge = 0
	player.xpos = 32
	player.ypos = 64
	player.dx = 0
	player.dy = 0
	player.combo = 0
    speed = 0
	
    --main music
    if(level <= 1) then
        music(0)
    else 
        music(16)
    end
    --switch state
 	_update60=game_update60
 	_draw=game_draw

end


function game_update60()
    menuitem(1, "back to menu ", function() menu_init() sfx(0) end)
	
	--update the backgroundpos + loop it
    move_background()
    board_physics(player)
    
    --game time
    time+=1

    --game timer
    timer = 60-flr(time/60)

    --ramp speed
    rampspeed()

    --conditions
    if (timer <= 0) then
        if player.score >= 4000 then
            level_won = true
            level= level +1
        end
        gameover_init()
    end

end

function game_draw()

	--render background
	sky()
	palr()
		

	background(pos,level_selected)
	
	
	-- render player
    draw_player(player)
	
	
	--render ui	
	print_ui()

end

function draw_player(obj)

    if obj.board then
		
		longspr(obj,obj.board,obj.fakie)
	end
	if obj.feet then
		spr(24,obj.xpos+1,obj.ypos-19,4,1,obj.fakie)
	end

	if(obj.state == "rail") then
		spr((flr(time/2/2%6)+196),obj.xpos,obj.ypos,1,1)
	end
end


function board_jump(obj)
    if (btnp(4)) then -- action button
        obj.state = "air"
        obj.dy = obj.jumpforce
        --obj.ypos=obj.ypos-24
        obj.board = 128

        add_score(obj,10)
        sfx(0)
        obj.trick = "ollie"
    end
end

function board_drift(obj)
	if (btn(0)) then -- back
		--obj.xpos=obj.xpos-2
		obj.dx = obj.dx-drift
		if (obj.dx < -2) obj.dx = -2
	end
	
	if (btn(1)) then -- forward
		--obj.xpos=obj.xpos+1
		obj.dx = obj.dx+drift
		if (obj.dx > 2) obj.dx = 2
	end
end

function board_physics(obj)
    --check board state
    obj.state = "air"
    if(col_map(obj,3,0)) 
	or (col_map(obj,4,0))then
        obj.state = "ground"
    elseif (col_map(obj,3,1))
	or (col_map(obj,4,1)) then
        obj.state = "rail"
    end
    if(obj.ypos<=64) or (obj.dy<0)then
        obj.state = "air"
    end

    --check stance
    if obj.fakie and (btnp(5)) then
		obj.fakie = false
	elseif not obj.fakie and (btnp(5)) then
		obj.fakie = true
	end

	--check screen bounds
	if (obj.ypos > 119) 
	or (obj.xpos < -32) 
	or (obj.xpos > 128) then
		gameover_init()
        sfx(2)
	end

    if (obj.state=="ground") then
		obj.dx= obj.dx-0.0025
        --update feet movement
        obj.board = ((flr(time/2/30))%2)*4+96
        obj.feet = false
        obj.trick = ""

		obj.dy = 0
        board_jump(obj)
		board_drift(obj)
		charging(obj)
    end


	if (obj.state=="rail") then

		obj.dx= obj.dx+0.0025

		if (obj.board == 96)
		or (obj.board == 100) then
			sfx(4)
			obj.trick = "fs 50-50"
			add_score(obj,5)
		elseif (obj.board == 104)
		or (obj.board == 108)
		or (obj.board == 128) then
			
			sfx(4)
			if(obj.charge > 0)then
			obj.trick = "fs five-o"
			add_score(obj,10)
			else
				obj.board = 64
			end

		elseif (obj.board == 164)
		or (obj.board == 168)
		or (obj.board == 192)  
		or (obj.board == 172)  then 
			sfx(4)
			obj.board = 192
			obj.feet = false

			obj.trick = "fs boardslide"
			add_score(obj,10)
		elseif (obj.board == 64)
		or (obj.board == 132)
		or (obj.board == 160) then
			sfx(4)
			obj.board = 96
			obj.feet =false
			obj.trick = "fs 50-50"
			add_score(obj,5)
		else
			gameover_init()
			sfx(2)
		end
		obj.dy = 0
		board_drift(obj)
		board_jump(obj)
		charging(obj)
    end

    --air time
	if (obj.state=="air") then
        
        obj.dy = obj.dy +gravity
		obj.ypos= obj.ypos+obj.dy


 	    if (btn(2)) then
			obj.board = do_trick(obj,obj.jump,kickflip)
			add_score(obj,10)
			sfx(3)
            obj.trick = "kickflip"
			
		elseif (btn(1))
		or (btn(0)) then
			obj.board = do_trick(obj,obj.jump,popshovit)
			add_score(obj,5)
			sfx(5)
            obj.trick = "pop shov-it"
		end
    end
	
	if (obj.charge < 0.1) and (obj.state == "ground") then
		obj.combo= obj.combo-0.5
	end
	if (obj.combo > 5) obj.combo = 5
	if (obj.combo < 0) obj.combo = 0
	
	obj.xpos= obj.xpos+obj.dx

end
--unused function (for now)
function collectible (item,available,xpos,ypos)
	 x = xpos*8 + pos*-8
		 y = ypos*8-64*level + 64
		local px = player.xpos
		local py = player.ypos
    
    if(level == available)
	and not tape_collected[level+1] then
		
		spr((flr(time/2%4)*2+item),x,y,2,2)
		spr((flr(time/2%4)*2+item),x+112*8,y,2,2)
		

		if ((px<x) or (px+32>x+16)) then
            tape_collected[level+1] = true
        else
            tape_collected[level+1] = false
        end
        --debug hitbox
		print(x,32,32)
		print(y,32,37)

		print(player.xpos,72,32,11)
		print(player.ypos,72,37,11)
		
        rect(x,y,x+16,y+16)
		rect(px,py-8,px+32,py+8)
	end
    	
end


function charging(obj)
    char_max = 16
	if(obj.charge < char_max) then
		if (btn(3)) then
			obj.charge = obj.charge+0.3
		else
			obj.charge = obj.charge-0.3
		end
	end

	if(obj.charge <0 ) then
		obj.charge = 0
		return
	end

	if(obj.charge >= char_max)then
		sfx(2)
		gameover_init()
	end

	if (obj.charge > 0) then -- manual 
		obj.board = 108
		add_score(obj,5)
		if (obj.trick == "") then
			obj.trick = "manual"
		end
	end
	if (obj.charge > 9 ) then
		obj.board = 104
		add_score(obj,5)
		if (obj.trick == "") then
			obj.trick = "manual"
		end
	end
end

function move_background()
	pos = pos+speed/2
	if pos > 112 then
		pos = 0
	end
end

function do_trick(obj,frame,trick)
	if (obj.jump > #trick ) then
		obj.jump = 1
		player.feet = false
	else
		obj.jump = obj.jump + 0.75
		player.feet = true
	end
	return trick[flr(frame)]
end

function sky()
 cls(12)
end

	

-->8
--ui code


function print_ui()
   
	print("score:",8,8,1)
	print(flr(player.score),35,8,1)
    draw_trick(player)

	combo_str = "combo"
	printd(combo_str ,100,8,1,5)
	printd(sub(combo_str,0,flr(player.combo)),100,8,1,11)


    draw_bar(player)
    if(timer>=10)then
        printd("00:"..timer,54,24,0,8)
    else
        printd("00:0"..timer,54,24,0,8+(flr((time/2/4)%2)))
    end
end

function draw_bar(obj)
 	local x = obj.xpos
 	local y = obj.ypos-32
--	local x = 64
--	local y = 8
	local charge = obj.charge
	local color = 10

	if (charge > 5) then
		color = 11
	end

	if (charge > 13) then
		color = 8
	end

	if (charge >2) then
		rectfill(x+charge*2-1,y,x+charge*2,y+2,color)
		rect(x-1,y-1,x+16*2,y+3,1)
	end
end

function add_score(obj,amount)
	if (flr((time/2)%4) == 1) then
		if (obj.combo > 4) then
			obj.score = obj.score + amount *2
		else
			obj.score = obj.score + amount
		end
	end
	obj.combo= obj.combo+0.0125
end

function draw_trick (obj)
	local currenttrick = obj.trick
	if (obj.combo > 4) then
		currenttrick = currenttrick.." 2X"
	end
    printd(currenttrick,8,16,1,9)
end
-->8
--initial menu state
function _init()
    menu_init()
end

function menu_init()
	_update60=menu_update60
	_draw=menu_draw
	time=0
	cls()
	--music(8)
end

function menu_update60()

    menu_time()
	
	if (btnp(4)) then  --play the game
		if (entry<=level+1) then
			if(entry>=5) then
				sfx(0)
				win_init()
				return
			end
			level_selected = entry-1
			load_init()
			sfx(0)
		else
			sfx(11)
		end
	end	

	if(btnp(2)) then
		entry = entry -1
		sfx(1)
	elseif(btnp(3)) then
		entry = entry +1
		sfx(1)
	end
	if (entry > #level_name) entry =1
	if (entry < 1) entry = #level_name

end

function menu_draw()
	cls(0)
	--sky()
	--background(0,level)
	palr()

	draw_logo()
	
	draw_level_select(44,70)

	cursor(35,114)
	color(5)
	print("”/ƒ to select")
	print("—/Ž to play")
	cursor(2,2)

end

function draw_logo()
	--game logo
	print("pico",37,clerp((time/10),32,28),2)
	spr(38,44,clerp((time/10),28,32),5,2)
	--tape sprite
	spr((flr(time/2/4%4)*4+64),25,32,2,2)
	spr(202,25+8,32,1,2)
	spr((flr(time/2/4%4)*4+66),83,32,2,2)
	spr(202,83,32,1,2,true,false)
end

function draw_level_select(xpos,ypos)
	cursor(xpos,ypos)
	for i=1, #level_name  do
		if (i<=level+1) then
			color(9)
			if( entry == i) color(10)
		else
			color(5)
		end
		
		print(level_name[i])
	end

	--draw menu cursor
	cursor(xpos-8+sin(time/8),ypos+((entry-1)*6))
	if (entry<=level+1) then
		color(10)
	else
		color(5)
	end
	print("")

	cursor(5,5)
	--print(entry)
end


