-- load screen
function load_init()
	_update60=load_update60
	_draw=load_draw
	time = 0
	
end

function load_update60()
	menu_time()
	music(63)	
	if(time/2 > 24) game_init()

end

function load_draw()
	cls(0)

	printd("traveling to "..level_name[level_selected+1],20,32,2,8)

	cursor(34,62)
	color(5)
	print("get 4000 points")
	print("do not crash")
	print("hidden tape")
	cursor(34-8+sin(time/8),62)
	print("")print("")print("")

	--main load bar
	bary = 110
	rectfill(16,bary,16+time/2*4,bary+4,8)
	rect(16-1,bary-1,128-15,bary+5,5)
	print("loading...",48,bary,15)

	
end

function win_init()
	_update60=win_update60
 	_draw=win_draw
end


function win_update60()
	menu_time()
	if(btnp(4)) or (btn(5)) then
		menu_init()
		sfx(0)
	end
end


function win_draw()
	cls(0)
	palr()
	spr((flr(time/2/2%4)*2+tape),52,78,2,2)
	crazy_colors()
	draw_logo()
	cursor(13,64)
	color(3)
    print("congratulations skater",9)
	print("you found the secret tape",9)
	print("")
	print("")
	print("")
	print("")
	
	print("pico skate iv is made by",9)
	print("by @zuggamasta with ‡",9)

	cursor(41,114)
	color(5)
	print("")
	print("—/Ž back")
    --print(flr(player.score),72,70)
end

