--help and math functions

function lerp(t, a, b)
	return a + t * (b - a)
end

function clerp(t, a, b)
	if (t>1) then t=1 end
	if (t<0) then t=0 end
	return a + t * (b - a)
end

function palr()
	pal()
	palt(0,false)
	palt(1,true)
end

function longspr(obj,sprite,flipx)
	
	spr(sprite,obj.xpos,obj.ypos-8,4,2,flipx,false)
end

function col_map(obj,aim,flag)
	--obj = table needs xpos,ypos,w,h
	--aim = left,right, up, down 
    --aim -1 is checks on obj.pos
	local x = obj.xpos/8+pos
	local y = obj.ypos/8+8*level_selected-8
	local w = obj.w
	local h = obj.h
    local tile = 0

    if (aim == 0) then
		tile = mget(x-1,y)
	elseif (aim == 1) then
		tile = mget(x+1,y)
	elseif (aim == 2) then
		tile = mget(x,y-1)
	elseif (aim == 3) then
		tile = mget(x+1,y+1)
	elseif (aim == 4) then
        tile = mget(x+3,y+1)
    end
	return fget(tile,flag)

end

function menu_time()
    time = time +speed
	if(time < 1) then 
		time = 1
	end
end

function background(mypos,lvl)
	map(0,8*lvl-8,mypos*-1*8,0)
	rectfill(0,0,128,64,12)
end

function rampspeed()
    if (speed < 0.33) then
  	    speed+=0.005
    else
  	    speed = 0.33
    end
end

function crazy_colors()
	
	for i=2,15 do
	pal(i,i+flr((time/3)%7))
	end
end

