pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- surfin' challenge
-- by peter bickhofe
-- music by cloudriver.org
-- 2019, cologne
		
sta=""
hlp=false
hlppage=1
i=0
grv=-.04
tme=0
score=0
hscore=0
jumps=0

//jump tables
ang=0 //jump out angle
stp=0

//spritelist wave
emp={232,234,236,238}
wat={200,202,204,206}
wav={192,194,196,198}
top={224,226,228,230}

//wave pattern
pat={
{2,0,0,0},
{3,2,0,0},
{3,1,2,0},
{3,1,1,2},

{3,1,1,2},
{3,1,1,2},
{3,1,1,2},
{3,1,1,2},

{3,1,1,2},
{3,1,1,2},
{3,1,1,2},
{3,1,1,2}}

//time
stm=0  //starttime
now=0  //current time
gtm=60 //gametime

//msg
msg={}
msg.x=25
msg.y=32
msg.str=""

//player
p={}
p.vis=true
p.init=true
p.cnt=0
p.initid=0
p.sprinit={64,66,68,70}
p.sprlst={0,2,4,6,8,10,12,14,32,34,36,38,40,42,44,46}
p.vspd={0,-1,-2,-3,-2,-1,0,1,2,3,2,1}
p.hspd={4,4,2,0,-2,-4,-4,-4,-6,0,6,4}
p.lstid=1
p.x=0
p.y=0
p.vx=0
p.hx=0
p.spr=0
p.jmp=false
p.spd=1
p.tme=0
p.frm=0
p.ani=1

//wave
w={}
w.x=-64
w.y=64
w.spd=.75
w.tme=0
w.ani=4
w.cnt=1
w.stp=1 //4step for wave sprite count

//visible score
sc={}
sc.val=0
sc.vis=false
sc.col={7,14,11,10,9,8}
sc.c=sc.col[1]
sc.txt=""
sc.x=64
sc.y=64

//map
m={}
m.x=0

//ripples
r={}
r.x=100
r.y=72
r.spr=136
r.tme=0
r.ani=4

//bird
b={}
b.cnt=0
b.tme=0
b.spd=10


// ripples
sr={}
sr.cnt=0
sr.spd=0

function _init()
 cartdata("bonasurf")
	hscore=dget(0)
	intro()
end

function _update()
	
	if sta=="intro" then
		
		//toggle help
		if btnp(4) then
		 sfx(4,1)
	 	if hlp==false then hlp=true
	 	else hlp=false end
		end
		
		if hlp then
		 if btnp(0) or btnp(1) then
		  sfx(5,1)
		  if hlppage==1 then hlppage=2
		  elseif hlppage==2 then hlppage=3
		  else hlppage=1 end
		 end
		
		else 
		 if btnp(5) then start() end
		end
	
	elseif sta=="game" then
 	
 	//timer
 	now=flr(time()-stm)
		
		if now<10 then nowstr="0"..now
		else nowstr=""..now end 
		
		//check time
		tme=now
		if now>=gtm then sta="fall" end
		
		movebg()
 	move()
 	wave()
 	
 elseif sta=="fall" then 
  movebg()
  wave()
  fallani()
  
	elseif sta=="result" then
	 	if btnp(5) then intro() end
	 	if btnp(4) then clrscore() end
	end

end

function intro()
 sfx(6,1)
 music(10)
 sta="intro"
 msg.str="<press fire to start>"
end

function start()
	sta="game"
	score=0
	jumps=0
	tne=0
	now=0
	nowstr=""
	msg.str="" 
	stm=time()
	newplr()
	w.x=-64
	sfx(6,1)
	sfx(0,2) //wave
	music(0,500,12)
end

function gameover()
	p.vis=false
	
	if score>hscore then
	 dset(0,score)
	 hscore=score
	end
	
	sfx(-1,2) //wave snd stop
	music(-1)
	
	result()
end

function result()
 sta="result"
 music(10)
end

function newplr()
	p.lstid=1
	p.spr=64
	p.vx=0
	p.vy=0
	p.vis=true
 p.x=30
 p.y=65
	p.jmp=false
end

function move()

 if p.init then
  if p.cnt<5 then p.cnt+=1
  else
   p.cnt=1
   if p.initid<3 then p.initid+=1
   else p.initid=1 end
   p.spr=p.sprinit[p.initid]
  end 
  
  p.vx=p.spd
  p.vy=p.spd
  p.x+=p.vx
  p.y+=p.vy
  
  if p.y>90 then p.init=false end
  
 else
 
  //rotate
	 if btnp(0) then p.lstid+=1 end
	 if btnp(1) then p.lstid-=1 end
	
	 if p.lstid<=0 then p.lstid=12 end
	 if p.lstid>12 then p.lstid=1 end
	
	 p.spr=p.sprlst[p.lstid]	

  //jump detect
  if (p.y<48) then
   if p.jmp==false then
  	 //check wave dist before jump
  	 if w.x>p.x then sta="fall" end
  	
 	  p.jmp=true
 	  ang=p.spr
 	  stp=0
 	  sfx(1,1)

   end
  
   //count rotation steps
   if btnp(0) then stp-=1 end
	  if btnp(1) then stp+=1 end
 
  else 
  
   //dive back in
   if p.jmp then
  
  	 //check wave dist
  	 if w.x>p.x then
  	  sta="fall"
  	  return
  	 end
  	
   	//angle dive
    if p.spr<14 then sta="fall" end
  	
   	//get opposite angle
   	if ang==2 then div=38
   	elseif ang==4 then div=36
   	elseif ang==6 then div=34
   	elseif ang==8 then div=32
   	elseif ang==10 then div=14
   	end 
  	
   	if div==p.spr then
  	 	
  	 	addscore=0
  	 	
  	 	//add score
  	 	if stp==2 then addscore=25
  	 	elseif stp==4 then addscore=50
  	  elseif stp==-6 or stp==6 then addscore=100
  	  elseif stp==-4 then addscore=75
  	  elseif stp==-8 or stp==8 then addscore=125
  	  elseif stp==-18 or stp==18 then addscore=150
  	  end
  	  
  	  score+=addscore
  	  showscore(addscore)
  	  jumps+=1
  	  sfx(2,1)
  	 
   	else sta="fall" end
  	
   	p.jmp=false
   	
   end
  end
 
  //velocity
  if p.jmp==false then
   p.vx=p.hspd[p.lstid]*p.spd/5
   p.vy=p.vspd[p.lstid]*p.spd/2
  else
   p.vy-=grv
  end
 
  //stop movin forward
  if p.x<100-p.vx then p.x+=p.vx end
  p.y+=p.vy
 
  //border
  if p.x<0 or p.y>112 then sta="fall" end
	
 end

end

function fallani()
	//play sound once
 if p.frm==0 then sfx(3,1) end
 
 //play fall ani
 p.tme+=1
 p.y+=.5
 
 if p.tme>4 then 
    
  if p.frm<4 then
   p.spr=p.sprlst[13+p.frm]
   p.frm+=1
  else
   p.frm=0
   gameover()
  end
  
   p.tme=0
 end
 
end

function wave()
 
 //wave sprite ani
 w.tme+=1
 
 if w.tme>w.ani then
  if w.cnt<4 then w.cnt+=1
  else w.cnt=1 end
  
  w.tme=0
 end
 
 //move wave right
 w.x+=w.spd
 //push wave back left
 if w.x>=-64 and p.vx>0 then w.x-=p.vx*1.5 end

 //gameover wave
 if w.x>160 then sta="fall" end
end

function showscore(val)
 sc.vis=true
 sc.txt="+"..val
 sc.x=p.x
 sc.y=64
 sc.c=sc.col[val/25]
end

function clrscore()
 sfx(7,1)
 dset(0,0)
 hscore=0
end

function movebg()
 //map repeat
 if m.x>-126 then
 	m.x-=.25
  if p.vx>0 then m.x-=p.vx end
 else m.x=0
 end
 
 //ripples
 r.tme+=1
 if r.tme==4 then
  r.spr=138
 elseif r.tme==8 then
 	r.spr=136
  r.tme=0
 end
 
 if r.x>0 then 
 	r.x-=.5
  
  if p.vx>0 then r.x-=p.vx*.5 end
 else r.x=128
 end
 
end

function sun()
 if sr.spd<6 then sr.spd+=1 
 else 
  if sr.cnt<4 then sr.cnt+=1
  else sr.cnt=0 end
  sr.spd=0
 end
  
 spr(112+sr.cnt,56,88)
 spr(112+sr.cnt,64,88)
end

function write(t,tpos,l,c,o)
   print(t,63-#t*2,tpos+0+l*8,o)
   print(t,64-#t*2,tpos+0+l*8,o)
   print(t,65-#t*2,tpos+0+l*8,o)
   print(t,63-#t*2,tpos+1+l*8,o)
   print(t,65-#t*2,tpos+1+l*8,o)
   print(t,63-#t*2,tpos+2+l*8,o)
   print(t,64-#t*2,tpos+2+l*8,o)
   print(t,65-#t*2,tpos+2+l*8,o)
   print(t,64-#t*2,tpos+1+l*8,c)  
end

function bird(x,y)
 spr(100+b.cnt,x,y)
 
 if (b.tme < b.spd) then b.tme+=1
 else
  b.tme = 0
  if (b.cnt<3) then b.cnt+=1
  else b.cnt=0 end
 end

end

function board(px,py,w,h)
 s=96
 fh=false
 fv=false

 for i=1,w do
   for j=1,h do
    
    //first and last line
    if j==1 or j==h then    
     if i==1 or i==w then s=96
     else s=97 end
     
     //corner flip
     if i==1 then fh=false end
     if i==w then fh=true end
     if j==1then fv=false end
     if j==h then fv=true end
    
    //between
    else
     if i==1 or i==w then s=98
     else s=99 end
     
     //side flip
     if i==1 then fh=false end
     if i==w then fh=true end
    end
  
    spr(s,px+i*8,py+j*8,1,1,fh,fv)
   end
  end

end

function _draw()
	cls()
	
 if sta=="intro" then
 
  mapdraw(0,16,0,0,32,16)
    
  //palmen
  spr(140,2,75,2,4)
  spr(142,12,80,2,4)
  spr(140,105,76,2,4,1) 
  spr(142,115,81,2,4,1)  
  
  //boards
  spr(111,94,94,1,2)
  spr(79,90,94,1,2)
  spr(79,80,94,1,2)
  
  //people
  spr(160,25,99,1,2)
  spr(161,30,99,1,2)
  spr(162,42,99,1,2)
  spr(163,47,99,1,2) 
  
  bird(20,62)
  bird(100,47)  
  
  sun()
  
  //show instructions
  if hlp then
   wdt=12
   hgt=10
   px=56-wdt*8/2
   py=56-hgt*8/2
   board(px,py,wdt,hgt)
   
   wdt=8
   hgt=2
   px=56-wdt*8/2
   py=18-hgt*8/2
   board(px,py,wdt,hgt)
   
   wdt=3
   hgt=2
   px=85-wdt*8/2
   py=94-hgt*8/2
   board(px,py,wdt,hgt)
   
   //page
   print(hlppage.."/3",87,100,10,4)
   
   if hlppage==1 then
   
    //title
    t="instructions"
    write(t,22,0,10,4)
   
    //text
    t={
    "press left/right",
    "to turn"
    }
   
    for i=1,2 do
     write(t[i],38,i-1,7,0)
    end
   
    t= {
    "you can jump out in",
    "any angle.",
    "dive back only in",
    "the exact opposite",
    "angle!"
    }
  
    for i=1,5 do
     write(t[i],58,i-1,7,0)
    end
    
   elseif hlppage==2 then 
   
    //title
    t="scoreboard"
    write(t,22,0,10,4)
    
    t={
    "small hop   25 pts",
    "45 degree   50 pts",
    "backwards   75 pts",
    "180        100 pts",
    "45 reverse	125 pts",
    "full 360   150 pts"
    }
  
    for i=1,6 do
     write(t[i],40,i-1,7,0)
    end
    
   elseif hlppage==3 then
   	
   	//title
    t="credits"
    write(t,22,0,10,4)
   	    
   	t={
    "art & code",
    "by peter bickhofe",
    "bickhofe.de"
    }
    
    for i=1,3 do
     write(t[i],40,i-1,7,0)
    end
    
    t={
    "music by",
    "cloudriver.org"
    }
    
    for i=1,2 do
     write(t[i],72,i-1,7,0)
    end
    
   end
   
   t="[ c=exit / lft/rgt=page ]"
    write(t,116,0,7,1) 
   
  else 
  
   //titleboard
   wdt=13
   hgt=4
   px=56-wdt*8/2
   py=11-hgt*8/2
   board(px,py,wdt,hgt)
  
   wdt=10
   hgt=2
   px=56-wdt*8/2
   py=26-hgt*8/2
   board(px,py,wdt,hgt)
  
   //text
   t={
   "the bona ona",
   "playa de can pastilla"
   }
  
   for i=1,2 do
    write(t[i],9,i-1,7,0)
   end
  
   t="surfin' challenge"
   write(t,31,0,10,4)
  
   t="[ x=start / c=help ]"
   write(t,116,0,7,1)
  
   //logo
   spr(72,40,48,7,4)
  
  end
  
 end
 
 
 if sta=="game" or sta=="fall" then
	 mapdraw(0,0,m.x,0,32,16)
	 
	 //ripple
  spr(r.spr,r.x,r.y,2,4)
	 
  //player
 	if p.vis then	
  	spr(p.spr,p.x,p.y,2,2) 
 	end
	
  //wave
  for i=1,12 do //columns
  
    if w.stp<4 then w.stp+=1
    else w.stp=1 end
  
    for j=1,4 do //rows
     val=pat[i][j]   
     off=w.stp+w.cnt
   
     if w.stp+w.cnt>4 then
     off=w.stp+w.cnt-4 end
      
     if val==0 then id=emp[off] end
     if val==1 then id=wat[off] end
     if val==2 then id=wav[off] end
     if val==3 then id=top[off] end   
     spr(id,w.x-16*(i-1),64+16*(j-1),2,2)
    end 
   end
   
  wdt=3
  hgt=2
  px=-4
  py=5-hgt*8/2
  board(px,py,wdt,hgt)
  //clock
	 print(nowstr,12,11,7)
  
  wdt=3
  hgt=2
  px=120-wdt*9
  py=5-hgt*8/2
  board(px,py,wdt,hgt)
  //score
	 scrstr=""..score
	 scrx=113-(#scrstr/2)*3
	 print(scrstr,scrx,11,7)

  if sc.vis and sc.y > 0 then
   print(sc.txt,sc.x,sc.y,sc.c)
   sc.y-=1
  else
   sc.vis=false
  end

 end
 
 if sta=="result" then
  mapdraw(0,16,0,0,32,16)
  
  sun()
  
    
  //palmen
  spr(140,2,75,2,4)
  spr(142,12,80,2,4)
  spr(140,105,76,2,4,1) 
  spr(142,115,81,2,4,1)  
  
  //boards
  spr(11,94,94,1,2)
  spr(79,90,94,1,2)
  spr(79,80,94,1,2)
  
  //people
  spr(160,25,99,1,2)
  spr(161,30,99,1,2)
  spr(162,42,99,1,2)
  spr(163,47,99,1,2)
  
  bird(15,60)
  bird(105,45)
  
  //scoreboard
  wdt=9
  hgt=5
  px=56-wdt*8/2
  py=39-hgt*8/2
  board(px,py,wdt,hgt)
  
  t={"highscore:"..hscore,
     "points:"..score,
     "jumps:"..jumps}
  
  for i=1,3 do
   write(t[i],39,i-1,7,4)
  end
  
  //head
  wdt=7
  hgt=2
  px=56-wdt*8/2
  py=21-hgt*8/2
  board(px,py,wdt,hgt)
  write("scoreboard",9,2,10,4)
  
  t="[ x=back / c=clear score ]"
  write(t,116,0,7,1)
  
 end

end
