pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- spaceball
-- by connorses

--updated 05/1/2017

debug=true
debug=debug==false --(not actually a paradox)

--run game or menu or what?
state="main"
--default map=0
level=0
actors = {} --all actors in world
red,blue=0,0--points
p1={}--players 1 and 2
p2={}
ball={}--da ball
sparks={} --particle effects
trails={} --temporary sprites
wait_time=0 --pause timer
shkx,shky=0,0 --screenshake
sfx_wait=0 --ear rape prevention
--how fast to accelerate players
 accel = 0.07
 kick_force = .65 --power shot~
 push_force =.12 --dribble
--how long between power shots
push_wait=40
init_bool=true
	
t=0

-- make an actor
-- and add to global collection
-- x,y means center of the actor
-- in map tiles (not pixels)
function make_actor(x, y)
 a={}
 a.x = x
 a.y = y
 a.dx = 0
 a.dy = 0
 a.spr = 16
 a.frame = 0
 a.t = 0
 a.inertia = 0.75
 a.bounce  = 1
 a.frames=2
 a.col_a=false
 a.life=-1
 -- half-width and half-height
 -- slightly less than 0.5 so
 -- that will fit through 1-wide
 -- holes.
 a.w = 0.4
 a.h = 0.4
 
 add(actors,a)
 
 return a
end

c1,c2=9,11
function _init()
	local intro=300
	init_bool=true
	while intro>0 and btn()==0 do
	cls()
 local i=cos(intro/80)*1.2
 circfill(64,64,21,1)
 circfill(64,64,11,12)
 
 sspr(16,32*3, 16,24, 57,59+i, 16,24)

 line(56,75,70,75,1)
 print("loneship",49,44,3)
 print("games",55,80,3)
	intro-=1
	flip""
	end
 music(0)
end

function init_color()
	pal(12,c1)
	pal(8,c2)
	palt(14,true)
	palt(0,false)
end

function init_game(lvl)
	init_color()
	score_bool=false
	
	actors={}
	trails={}
	sparks={}
	
	if lvl==0 then
		cam_x,cam_y=0,0
		bound_w=.5
		bound_e=16
 	p1 = make_actor(14,7.5)
 	p2 = make_actor(2,7.5)
 	ball = make_actor(8,7.5)
 	ball.dy=(rnd(2)-1)*.2
 	shakemx,shakemy=8,0
	elseif lvl==1 then
		bound_w=16
		bound_e=32
		cam_x,cam_y=128,0
		p1 = make_actor(14+16,7.5)
 	p2 = make_actor(18,7.5)
 	ball = make_actor(8+16,12.5)
 	shakemx,shakemy=8,2
 	ball.y-=flr(rnd(2))*10
	elseif lvl==2 then
		bound_w=31
		bound_e=49
		cam_x,cam_y=256,0
		cam_x+=4
		p1 = make_actor(15+32,10)
		p2 = make_actor(18+16,10)
		ball=make_actor(8.5+32,3+rnd(3))
		shakemx,shakemy=3,6
	elseif lvl==3 then
		bound_w=32+14
		bound_e=48+19
		cam_x,cam_y=128*3,0
		cam_x+=4
		p1 = make_actor(12+32+16.5,10)
		p2 = make_actor(20+32.5,10)
		ball=make_actor(8+32+16.5,3 )
		shakemx,shakemy=0,8
	elseif lvl==4 then
		bound_w=42
		bound_e=513.27
		cam_x,cam_y=128*4,0
 	p1 = make_actor(14+(16*4),8)
 	p2 = make_actor(2+(16*4),8)
 	ball = make_actor(8+(16*4),8)
 	ball.dy=(rnd(2)-1)*.2
 	shakemx,shakemy=0,8 
 	shakemx,shakemy=0,8 
	end
-- player 1 blue
 p1.spr = 5
 p1.inertia=0.8
 p1.bounce=.2
 p1.frames=4
 p1.push=0
 
 -- player 2 red
 
 p2.spr=17
 p2.frames=4
 p2.inertia=0.8
 p2.bounce=.2
 p2.push=0
 
  -- make a bouncy ball
 ball.spr = 9
 ball.frames=3
 ball.inertia=0.99
 ball.bounce=.98
 ball.col_a=true--doesn't collide w/actors normally
 ball.w=.3
 ball.h=.3
 --(v for basketball level v)
 if lvl==2 then
 ball.frames=2 ball.spr=49
 elseif lvl==3 then
 ball.frames=2 ball.spr=90 end
end

-- for any given point on the
-- map, true if there is wall
-- there.

function solid(x, y)	
 -- grab the cell value
 val=mget(x, y)
 
 -- check if flag 1 is set (the
 -- orange toggle button in the 
 -- sprite editor)
 return fget(val, 1)
 
end

-- solid_area
-- check if a rectangle overlaps
-- with any walls

--(this version only works for
--actors less than one tile big)

function solid_area(x,y,w,h)

 return 
  solid(x-w,y-h) or
  solid(x+w,y-h) or
  solid(x-w,y+h) or
  solid(x+w,y+h)
end


-- true if a will hit another
-- actor after moving dx,dy
function solid_actor(a, dx, dy)
	if (true) return false
	if not a.col_a then
 for a2 in all(actors) do
  if a2 != a and not a2.col_a then
   local x=(a.x+dx) - a2.x
   local y=(a.y+dy) - a2.y
   if ((abs(x) < (a.w+a2.w)) and
      (abs(y) < (a.h+a2.h)))
   then 
    
    -- moving together?
    -- this allows actors to
    -- overlap initially 
    -- without sticking together    

    if (dx != 0 and abs(x) <
        abs(a.x-a2.x)) then
     v=a.dx + a2.dy
     a.dx = v/2
     a2.dx = v/2
     return true 
    end
    
    if (dy != 0 and abs(y) <
        abs(a.y-a2.y)) then
     v=a.dy + a2.dy
     a.dy=v/2
     a2.dy=v/2
     return true 
    end
    
    --return true
    
   end
  end
 end
 return false
 end
end


-- checks both walls and actors
function solid_a(a, dx, dy)
	if (a.x+a.dx<bound_w or a.x+a.dx>bound_e) then
		if not a.col_a then
	return true else return false end end
 if solid_area(a.x+dx,a.y+dy,
    a.w,a.h) then
    return true end
 return solid_actor(a, dx, dy)
end

function move_actor(a)
	
 -- only move actor along x
 -- if the resulting position
 -- will not overlap with a wall
	if a.life~=0 then
 if not solid_a(a, a.dx, 0)
 then
  a.x += a.dx
 else   
  -- otherwise bounce
  a.dx *= -a.bounce
  if wait_time<1 and sfx_wait==0 then
  sfx(16) sfx_wait=5 end
 end
 val=mget(a.x,a.y)
 --5: block completely (bottof of bball nets)
	if (fget(val,5) and a.dy<0) a.dy=0
	--arrow force on ball
	if (fget(val,4) ) a.dy+=.033
	--arrow force on players
	if (fget(val,4) and not a.col_a) a.dy+=.2

 -- ditto for y

 if not solid_a(a, 0, a.dy) then
  a.y += a.dy
 else
  a.dy *= -a.bounce
  if (wait_time<1) and sfx_wait==0 then
  sfx(0) sfx_wait=5 end
 end
 
 -- apply inertia
 -- set dx,dy to zero if you
 -- don't want inertia
 
 a.dx *= a.inertia
 a.dy *= a.inertia
 
 -- advance one frame every
 -- time actor moves 1/4 of
 -- a tile
 if a.col_a then
 a.frame += abs(a.dx) * 4
 a.frame += abs(a.dy) * 4
	else
	a.frame+=0.1
	end
 a.frame %= a.frames
 a.t += 1
 end
 
 if a.life>0 then
 	a.life-=1
 end
 
end

function control_players()
 if btn(0,0) then
 	p1.dx -= accel
 end
 if btn(1,0) then
  p1.dx += accel
 end 
 if btn(2,0) then
  p1.dy -= accel
 end
 if btn(3,0) then
  p1.dy += accel
 end
 if btn(4,0) or btn(5,0) then
 	if p1.push==0 then
 		if push_ball(p1,2.5,kick_force) then
 			for x=1,3 do
					local a=spark(ball.x,ball.y,28,10)
 				a.col_a=true
 			end
 			wait(4)
 			sfx(1,1)
 		else
 			sfx(6,2)
 		end
 		p1.push=push_wait
 	end
 end
 
 if btn(0,1) then
 	p2.dx -= accel
 end
 if btn(1,1) then
  p2.dx += accel
 end 
 if btn(2,1) then
  p2.dy -= accel
 end
 if btn(3,1) then
  p2.dy += accel
 end
 
 if btn(4,1) or btn(5,1) then
 	if p2.push==0 then
 		if push_ball(p2,2.5,kick_force) then
			for x=1,3 do
				local a=spark(ball.x,ball.y,27,10)
 				a.col_a=true
 			end
 			wait(4)
 			sfx(1,1)
 		else
				sfx(6,2)
			end
 		p2.push=push_wait
 	end
 end

 -- play a sound if moving
 -- (every 4 ticks)
 
 if (abs(p1.dx)+abs(p1.dy) > 0.1
    	and (p1.t%4) == 0) then
  add_trail(p1.x,p1.y,12)
 end
 if (abs(p2.dx)+abs(p2.dy) > 0.1
     and (p2.t%4) == 0) then
  add_trail(p2.x,p2.y,8)
 end


 push_ball(p1,1.1,push_force,true)
 push_ball(p2,1.1,push_force,true)
 if (p1.push>0) p1.push-=1
 if (p2.push>0) p2.push-=1
 
 
 val=mget(ball.x,ball.y)
 if (fget(val,3) and not score_bool) score(1)
 if (fget(val,2) and not score_bool) score(2)
	if (not score_bool and level==0 and ball.x+ball.dx<0) score(1) 
	if (not score_bool and level==0 and ball.x+ball.dx>16)score(2)
	
end

function _update()
	if (btn()==0) init_bool=false
	if state=="game" then
 control_players()
 repel(p1,p2,1,.05)
 add_trail(ball.x,ball.y)
 foreach(actors, move_actor)

	actors = remove_dead(actors)
	trails = remove_dead(trails)
	sparks = remove_dead(sparks)
	
 elseif state=="select" then
 	control_select""
 elseif state=="main" then
 	if btn()~=0 and not init_bool then
 		sfx(1,3)
 		wait(20)
 		init_game(level)
 		state="select"
 	end
 	if debug then
 		state="game"
 		init_game(0)
 		music(-1)
 	end
 end
 
 if (sfx_wait>0) sfx_wait-=1

end

function remove_dead(table)
 	local new = {}
 	if table~=nil then
 		for v in all(table) do
 			if (v.life == -1 or v.life > 0.1) then
 				add(new,v)
 			end
 		end
 	end
 	return new
end
 
function draw_actor(a)
 if (a == nil) return
 local sx = (a.x * 8) - 3.5
 local sy = (a.y * 8) - 3.5
 spr(a.spr + a.frame, sx, sy)
end

function _draw()
	if state=="game" then
		draw_game""
	elseif	state=="select" then
		draw_select""
	else
		draw_title""
	end
 if debug then
		print(stat(0),0,0,9)
	end
end

function draw_game()
	cls()
 camera(cam_x+shkx,cam_y+shky)
  
 c=1
 if (p1.push==0) c=12
 circ(p1.x*8,p1.y*8,16,c)
 c=1
 if (p2.push==0) c=8
 circ(p2.x*8,p2.y*8,16,c)
 mcx=0
	if level==3 or level==2 then mcx=4 end
 map(cam_x/8,cam_y/8,cam_x-mcx,cam_y,17,16)
 
 if (state == "game") then
 	foreach(trails,draw_trail)
 end
 
 foreach(actors,draw_actor)
 
 camera(0,0)
 print(blue,72-3,121,12)
 print(red ,68-15,121,8)
end

function draw_title()
	cls""
	pal""
 palt""
	rectfill(0,0,127,127,1)
	rectfill(30,21,33+64,30+75,0)
	rect(28,19,35+64,32+75,3)
	sspr(0,32,78,64,27,28)
	if (t%30<20)	print("press any button",32,99,7)
	t+=1
end

function get_dist(x1,y1,x2,y2)
	return sqrt( (x2-x1)^2 + (y2-y1)^2 )
end

function repel(a,b,dist,pow)
 --push 2 objects apart at pow when within dist
	local d = get_dist(a.x,a.y,b.x,b.y)
	if d < dist then
		cx=a.x-b.x
		cy=a.y-b.y
		mag=magnitude(cx,cy)
		a.dx+=cx/mag*pow
		a.dy+=cx/mag*pow
		b.dx-=cx/mag*pow
		b.dy-=cy/mag*pow
	end
end

function push_ball(a,dist,pow,add_bool)
	local add = add_bool or false
	--'a' is an actor
	--pow is the resulting speed (power)
	--dist is the radius the push can affect
	--add is wether to apply extra details
	local d = get_dist(a.x,a.y,ball.x,ball.y)
	if d < dist then
		cx=ball.x-a.x
		cy=ball.y-a.y
		
		old_dx=ball.dx
		old_dy=ball.dy
		
		mag=magnitude(cx,cy)
		ball.dx=cx/mag*pow
		ball.dy=cy/mag*pow
		
		if add then
			ball.dx+=old_dx/2
			ball.dy+=old_dy/2
			ball.dx+=a.dx/2
			ball.dy+=a.dy/2
		end
		
		if (add) sfx(2)
		return true
	end
end

function score(plr)
	if plr==1 then s=33
	red+=1 end
	
	if plr==2 then s=34
	blue+=1 end
	
	for x=0,20 do
		l = rnd(10)+25
		spark(ball.x,ball.y,s,l)
	end
	
	sfx(3)
	score_bool=true
	
	wait_round(100)
	
	init_game(level)

	if red<5 and blue<5 then
		wait(30)
	else
		red,blue=0,0
		music(0)
		state="main"
	end
end


function spark(x,y,s,l)
	local s=s
	local a=make_actor(x,y)
	local life=l
	a.spr=s
	a.dx=rnd(1)-.5
	a.dx+=ball.dx
	a.dy=rnd(1)-.5
	a.dy+=ball.dy
	a.w=.2
	a.h=.2
	a.inertia=.9
	a.frames=1
	a.life=life
	a.bounce=1
	add(sparks,a)
	return a
end

function wait_round(wt)--how long to pause
	wait_time=wt
	while wait_time>0 do
		if wait_time%2==0 then
			foreach(sparks,move_actor)
			actors = remove_dead(actors)
			trails = remove_dead(trails)
			sparks = remove_dead(sparks)
			move_actor(ball)
			for i, t in pairs(trails) do
				if t.life>0 then
					t.life+=1
				end
			end
		end
		wait_time-=1
		shkx=0
		shky=0
		if wait_time>wt-20 then
			local shake=wait_time-(wt-20)
			shake/=20
			shkx=rnd(shakemx*shake)-0.5*shakemx*shake
			shky=rnd(shakemy*shake)-0.5*shakemy*shake
		end
		draw_game""
		flip""
	end
end

function wait(wt)--how long to pause
	wait_time=wt
	while wait_time>0 do
		wait_time-=1
		--draw_game""
		flip""
	end
end
--euclidian magnitude calculation
function magnitude(x, y)
 return sqrt(x*x + y*y)
end

function add_trail(xpos,ypos,c)
	local t={}
	t.life=20
	t.x=xpos*8
	t.y=ypos*8
	t.c=c or 7
	n = 0
	add(trails,t)
end

function draw_trail(t)
	if t~=nil and t.life>0 then
		r=2.5*(t.life/20)
		circfill(t.x,t.y,r,t.c)
		t.life-=1
	end
end

function control_select()
		if btnp(0,0) then
 		level-=1
 		level%=5
 		init_bool=true
 		sfx(11,3)
 		init_game(level)
 	end
 	if btnp(1,0) then
 		level+=1
 		level%=5
 		init_bool=true
 		sfx(11,3)
 		init_game(level)
 	end
 	if btnp(4,0) or btnp(5,0) then
 		state="game"
 		music(-1)
 		init_color()
 		wait(7)
 		shky=0
 		draw_game""
 		countdown""
 	end
 	
 if btnp(2,0) then
 	c1=add_c(c1,1)
 	if (c1==c2 or c1==6) c1=add_c(c1,1)
	init_color()
 end
 if btnp(3,0) then
 	c1=add_c(c1,-1)
 	if (c1==c2 or c1==6) c1=add_c(c1,-1)
	init_color()
 end
 
 if btnp(2,1) then
 	c2=add_c(c2,1)
 	if (c2==c1 or c2==6) c2=add_c(c2,1)
	init_color()
 end
 if btnp(3,1) then
 	c2=add_c(c2,-1)
 	if (c2==c1 or c2==6) c2=add_c(c2,-1)
	init_color()
 end

end

function draw_select()
	cls()
	shky=4
 draw_game()
 camera(0,0)
 rectfill(52,99,76,105,0)
 rect(51,98,77,106,9)
	print("map: "..level+1,53,100,7)
	rectfill(0,111,127,127,0)
	rect(0,110,127,127,7)
	sspr(0,32*3,8,16, 34,112)
	
	print("select map",44,114,5)
	print("change color",44,121)
	
	--print("select map",45,114)
	--print("change color",45,121)
	
	print("select map",45,113,9)
	print("change color",45,120)
end

function add_c(c,n)
	local c=c
	local n=n
	sfx(2,3)
	c-=3
	c+=n
	c%=12
	c+=3
	return c
end

function countdown()
	local t=90
	local sfx_bool=true
	while t>0 do
		rectfill(50,50,77,77,0)
		rect(50,50,77,77,9)
		if t>60 then
			sspr(80,64,8,8,59,57,16,16)
		elseif t>30 then
			sspr(88,64,8,8,59,57,16,16)
		else
			sspr(96,64,8,8,59,57,16,16)
		end
		
		if (t==90) sfx(14)
		if (t==60) sfx(14)
		if (t==30) sfx(14)
		if (t==1) sfx(10)
		flip""
		t-=1
	end
end
