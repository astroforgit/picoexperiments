pico-8 cartridge // http://www.pico-8.com
version 15
__lua__
--battlebone
--by tom brinton
--2018

enemies={}
skeleton={
{10,100},{50,60},{90,100},{50,60},
{50,20},{10,40},{50,20},{90,40},{50,20},
{30,10},{50,0},{70,10},{50,20},{50,60}}

coins={}
coinshape={
{50,60},{60,50},{50,40},{40,50},
{50,60},{50,70},{40,70},{30,60},{30,40},
{40,30},{60,30},{70,40},{70,60},{60,70},{50,70}}
pscore=0
score=0
scorecol=7

pl={}
pl.x = 8
pl.y = 8
pl.d = 0.25
pl.col=11
pl.health=100
pl.attacking = false
pl.hit=0
pl.phealth=100

difficulty=1
maxenemies=6

showbuttons=0
timer=0
gtimer=0
--1 title
--2 game
--3 game over
gamemode=1

function _init()
 skeleton=modshape(skeleton)
 coinshape=modshape(coinshape)
 makeenemy(5,5)
 makecoin(13,12)
 music(0)
end

function _update()
if gamemode==1 then
 if (btnp(3)) showbuttons += 1
 if showbuttons > 5 then
  if btnp(4) or btnp(5) then
   gamemode=2
  end
 end
elseif gamemode==2 then
 updateplayer()
 foreach(enemies,updateenemy)
 foreach(coins,updatecoins)
 
 if #enemies < maxenemies then
  if (rnd(1000) <difficulty) or #enemies==0 then
   ::pick::
   ex=flr(rnd(10)+3)
   ey=flr(rnd(10)+3)
   if not playintheway(ex,ey) and not botintheway(ex,ey) and mget(ex,ey)==0 then
    makeenemy(ex,ey)
   else
    goto pick
   end
  end
 end
 
 if #coins < 1 then
  cx=flr(rnd(12)+2)
  cy=flr(rnd(12)+2)
  if not playintheway(cx,cy) and not botintheway(cx,cy) and mget(cx,cy)==0 then
    makecoin(cx,cy)
  end 
 end
elseif gamemode==3 then
 gtimer+=1
 if gtimer >30 and (btnp(4) or btnp(5)) then
  resetgame()
  gamemode=1
 end
end
end

function _draw()
 
if gamemode==1 then
 cls()
 timer+=1
 if (timer > 30) timer=0;showbuttons+=1
 if timer<15 then
 	drawtitle(7)
 else
 	drawtitle(11)
 end
 
 if (showbuttons>1) print("”ƒ‹‘ to move",30,64,6)
 if (showbuttons>2) print("— to use sword",30,72,6)
 if (showbuttons>3) print("kill skeletons",30,80,6)
 if (showbuttons>4) print("get gold",30,88,6)
 if (showbuttons>5) print("press any key to start",18,100,11)  

elseif gamemode==2 then
 cls()
 --draw background
 drawwall()
 --draw skeletons
 castenemies()
 --draw sword
 drawsword()
 --draw hud
 drawmap()
 drawscore()
 drawhealth()
 screenshake()
 
elseif gamemode==3 then
 rectfill(17,44,111,89,0)
 rect(18,45,110,88,3)
 print("you died",48,54,7)
 if (gtimer>15) print("final score:"..score,32,65,7)
 if (gtimer>30) print("press — to try again",24,76,11)
end
end


-->8
--update
--functions

function updateplayer()
 if (pl.hit>0) pl.hit+=1
 if (pl.hit>8) pl.hit=0
 if (pl.health>100) pl.health=100
 if (pl.health<1) gameovereffect();gamemode=3
 if (pl.col == 8) pl.col= 11
 if btnp(5) or btnp(4) then
  pl.attacking=true
  sfx(4)
  swingsword()
 else
  pl.attacking=false
 end
 if btn(0) then
  pl.d -= .015
  if (pl.d < 0) pl.d = 1+pl.d
 end
 if btn(1) then
  pl.d += .015
  if (pl.d > 1) pl.d = -1+pl.d
 end
 if btn(2) then
  nx =pl.x + cos(pl.d)/5
  ny =pl.y - sin(pl.d)/5
  if botintheway(nx,ny) or mget(flr(nx),flr(ny)) > 0 then
  else
   pl.x=nx
   pl.y=ny
  end
 end
 if btn(3) then
 moveback()
 end
end

function updateenemy(e)
 for i=1,e.aggression do
  if (rnd(100) < 10) moveenemy(e)
  if (neartoplayer(e) and rnd(100) < 5) attackplayer(e)
 end 
  
 if e.justhit>0 then
  e.justhit+=1
  if (e.justhit>5) e.justhit=0
 end
 if e.health <= 0 then
  del(enemies,e)
  score+=100
  scorecol=8
  sfx(2)
 end
 
end

function moveenemy(e)
  if (pl.x < e.x) nx =e.x -.1
  if (pl.x > e.x) nx=e.x +.1
  if (pl.y < e.y) ny=e.y -.1
  if (pl.y > e.y) ny=e.y +.1
  if playintheway(nx,ny) or botintheway(nx,ny) then
  else
   e.x=nx
   e.y=ny
  end
end

function updatecoins(c)
 if abs(pl.x-c.x)<1 and abs(pl.y-c.y)<1 then
  del(coins,c)
  sfx(3)
  score+=200
  pl.health += 15
  scorecol=10
  difficulty+=1
 end
end
-->8
--draw 
--functions

function drawmap()
 for i= 0,17 do
  for j= 0,17 do
   if (mget(i,j)==1) pset(i,j,3)
  end
 end
 pset(pl.x,pl.y,11)
 for e in all(enemies) do
 	pset(e.x,e.y,8)
 end
 for c in all(coins) do
  pset(c.x,c.y,10)
 end
end

function drawwall()
 --find distances to wall, 5 points
 dist1=castwall(pl.d-.1)*2
 dist2=castwall(pl.d-.05)*2
 dist3=castwall(pl.d)*2
 dist4=castwall(pl.d+.05)*2
 dist5=castwall(pl.d+.1)*2
 
 --draw wall top
 line(0,32+dist1,32,32+dist2,3)
 line(32,32+dist2,64,32+dist3,3)
 line(64,32+dist3,96,32+dist4,3)
 line(96,32+dist4,128,32+dist5,3)
 --draw wall bottom
 line(0,96-dist1,32,96-dist2,3)
 line(32,96-dist2,64,96-dist3,3)
 line(64,96-dist3,96,96-dist4,3)
 line(96,96-dist4,128,96-dist5,3)
 
 rectfill(0,0,17,17,0)
end

function drawsword()
 if pl.attacking then
  line(64,64,96,128,pl.col)
  line(80,128,104,118,pl.col) 
 else
  line(84,84,116,148,pl.col)
 end
end

function drawenemy(scale,e,x)
 print(e.name,24,4,5)
 print(e.name,24,3,7)
 col=5
 if (scale<9 and scale>3) col=6
 if (scale<4) col = 7
 if (e.justhit>0) col = 8
 local s=e.shape
 scale=1.2-(scale/10)
 
 for v =1,#s do
  x1=(64-x)+(s[v][1])*scale
  y1=64+(s[v][2])*scale
  if v < #s then
   x2=(64-x)+(s[v+1][1])*scale
   y2=64+(s[v+1][2])*scale
  else
   x1=(64-x)+(s[1][1])*scale
   y1=64+(s[1][2])*scale
  end
  line(x1,y1,x2,y2,col)
 end
  
end

function drawcoin(scale,c,x)
 print("gold",24,11,4)
 print("gold",24,10,10)
 col=4
 if (scale<9 and scale>3) col=9
 if (scale<4) col = 10
 local s=c.shape
 scale=1.2-(scale/10)
 
 for v =1,#s do
  x1=(64-x)+(s[v][1])*scale
  y1=64+(s[v][2])*scale
  if v < #s then
   x2=(64-x)+(s[v+1][1])*scale
   y2=64+(s[v+1][2])*scale
  else
   x1=(64-x)+(s[1][1])*scale
   y1=64+(s[1][2])*scale
  end
  line(x1,y1,x2,y2,col)
 end
  
end


function drawscore()
 if pscore >= score then
  pscore=score
 	scorecol=7
 elseif pscore<score then
 	pscore+=10
 	sfx(0)
 end
 print ("score:",100,2,scorecol)
 print (pscore,100,9,scorecol)
 
end

function drawhealth()
 hcol=11
 if (abs(pl.phealth-pl.health) <2) pl.phealth=pl.health
 if pl.phealth < pl.health then
  pl.phealth+=abs((pl.phealth-pl.health)/5)
  hcol=10
 elseif pl.phealth > pl.health then
  pl.phealth-=abs((pl.phealth-pl.health)/5)
  hcol=8
 end 

 if (pl.hit>0) hcol=7
 if (pl.health<20) hcol=8
 rect(24,0,92,1,5)
 rect(24,0,24+ceil(pl.phealth*(68/100)),1,hcol)
end

function drawtitle(col)
 --b
 line(10,10,10,50,col)
 line(10,10,20,20,col)
 line(20,20,10,30,col)
 line(10,30,20,40,col)
 line(20,40,10,50,col)
 --a
 line(20,50,25,10,col)
 line(25,10,30,50,col)
 line(22,30,28,30,col)
 --t's
 line(30,10,50,10,col)
 line(35,10,35,50,col)
 line(45,10,45,50,col)
 --l
 line(55,10,50,50,col)
 line(50,50,55,50,col)
 --e
 line(60,10,60,50,col)
 line(60,10,65,10,col)
 line(60,30,65,30,col)
 line(60,50,70,50,col)
 --b
 line(70,10,70,50,col)
 line(70,10,80,20,col)
 line(80,20,70,30,col)
 line(70,30,80,40,col)
 line(80,40,70,50,col)
 --o
 line(80,30,85,10,col)
 line(85,10,90,30,col)
 line(90,30,85,50,col)
 line(85,50,80,30,col)
 --n
 line(92,50,92,10,col)
 line(92,10,100,50,col)
 line(100,50,100,10,col)
 --e
 line(105,10,102,50,col)
 line(102,50,110,50,col)
 line(105,10,110,10,col)
 line(105,30,110,30,col)
end

function screenshake()
 if pl.hit>0 then
  camera(flr(rnd(6)-3),flr(rnd(6)-3))
 else
  camera()
 end
end
-->8
--other
--functions

function castenemies()
 sens=.6
 local enemyfound={}
 local coinfound={}
 for angle = pl.d-.125,pl.d+.125,.005 do
  if (angle < 0) angle=1+angle
  if (angle > 1) angle=-1+angle
  rx=pl.x
  ry=pl.y
  dist=-1
  while dist < 17 do
   dist +=1
   rx+=cos(angle)
   ry-=sin(angle)
   pset(rx,ry,5)
   
    --check for coins
   for i=1,#coins do
    if abs(rx-coins[i].x)<sens and abs(ry-coins[i].y)<sens then
     if not coinfound[i] then
      drawcoin(dist,coins[i],((pl.d-angle)*100)*8)
      coinfound[i]=true
     end
    end
   end
   
   --check for enemies
   for i=1,#enemies do
    if abs(rx-enemies[i].x)<sens and abs(ry-enemies[i].y)<sens then
     if not enemyfound[i] then
      drawenemy(dist,enemies[i],((pl.d-angle)*100)*8)
      enemyfound[i]=true
     end
    end
   end
   
   --if (rx < 1 or ry < 1) break
   --if (rx > 17 or ry > 17) break
   if mget(flr(rx),flr(ry)) >0 then
    break
   end
  end
 end

 
end



function castwall(angle)
if (angle < 0) angle=1+angle
if (angle > 1) angle=-1+angle
 rx=pl.x
 ry=pl.y
 dist=0
 found=false
 while not found do
 
  dist +=1
  rx+=cos(angle)
  ry-=sin(angle)
  if (rx < 1 or ry < 1) found=true;break
  if (rx > 16 or ry > 16) found=true;break
  if mget(flr(rx),flr(ry)) >0 then
   found=true
  end
 end
 
 return dist
end

function makeenemy(x,y)
 local e={}
 e.x=x
 e.y=y
 e.shape=skeleton
 e.name="skeleton"
 e.health=3
 e.justhit=0
 e.strength=flr(rnd(difficulty)+2)
 e.aggression=flr(rnd(difficulty)+3)
 add(enemies,e)
end

function makecoin(x,y)
 local c={}
 c.x=x
 c.y=y
 c.shape=coinshape
 add(coins,c)
end
function modshape(shape)
for i=1,#shape do
 shape[i][1]-=50
 shape[i][2]-=50
end
return shape
end



function botintheway(x,y)
for e in all(enemies) do
 if abs(e.x-x)<.1 and abs(e.y-y)<.1 then
  return true
 end
end
return false
end

function playintheway(x,y)
if abs(pl.x-x)<.5 and abs(pl.y-y)<.5 then
  return true
end
return false
end

function swingsword()
 px =pl.x + (cos(pl.d)*1.2)
 py =pl.y - (sin(pl.d)*1.2)
 for e in all(enemies) do
  if abs(e.x-px) <1.2 and abs(e.y-py) <1.2 then
   e.health -=1
   e.justhit=1
   score+=10
   sfx(1)
  end
 end
end

function neartoplayer(e)
 if abs(e.x - pl.x)<1 and abs(e.y - pl.y)<1 then
  return true
 end
 return false
end

function attackplayer(e)
 pl.health-=e.strength
 sfx(8)
 pl.col=8
 for i=1,3 do
  moveback()
 end
 pl.hit=1
end

function moveback()
  nx=pl.x - cos(pl.d)/5
  ny=pl.y + sin(pl.d)/5
  if botintheway(nx,ny) or mget(flr(nx),flr(ny)) > 0 then
  else
   pl.x=nx
   pl.y=ny
  end
end

function gameovereffect()
for r =1,15 do
 for i=0,128 do
  for j=0,128,2 do
   c=pget(i,j)
   pset(i,j+flr(rnd(2)+1),c)
  end
 end
 flip()
end
end

function resetgame()
pscore=0
score=0
scorecol=7

pl.x = 8
pl.y = 8
pl.d = 0.25
pl.col=11
pl.health=100
pl.attacking = false
pl.hit=0
pl.phealth=100

difficulty=1
maxenemies=6

timer=0
deleteenemies()
makeenemy(5,5)
end

function deleteenemies()
 for e in all(enemies) do
  del(enemies,e)
 end
end
