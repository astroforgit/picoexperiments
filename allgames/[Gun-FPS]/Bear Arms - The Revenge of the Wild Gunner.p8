pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
gametime=1
gamestate=0
px=64
py=100
pmirror=false
highscore=0
score=0
enemies={}
enemyrate=30
enemyi=1
level=0
bgxi=0
bgyi=0
levels={}

function initlevels()
	levels={
	lvl1(),
	lvl2(),
	lvl3(),
	lvl4()}
end

function init()
	score=0
	gametime=1
	gamestate=0
	px=64
	py=100
	pmirror=false
	enemies={}
	enemyrate=30
	enemyi=1
	level=0
	bgxi=0
	bgyi=0
	initlevels()
end

function grass(x,y,rep)
	local i=0
	while i < rep do
		spr(67,x+(i*8),y)
		i=i+1
	end
end

function bg1()
	grass(45,74,4)
	map(bgxi+6,bgyi+0,47,43,4,1)
	map(bgxi+0,bgyi+0,47,74,4,1)
end

function bg2()
	grass(37,84,7)
 map(bgxi+7,bgyi+1,38,33,8,1)
	map(bgxi+0,bgyi+1,39,76,6,2)
end

function bg3()
	grass(20,99,11)
	map(bgxi+7,bgyi+2,18,18,9,2)
 map(bgxi+0,bgyi+3,20,75,3,4)
 map(bgxi+4,bgyi+3,91,75,3,4)
end

function grid()
	rect(0,0,127,127,11)
	rect(20,20,107,107,11)
	rect(35,35,92,92,3)
	rect(45,45,82,82,3)
	--rect(50,50,77,77,5)
	----rect(57,57,70,70,5)
	line(0,0,35,35,11)
	line(35,35,45,45,3)
	line(127,0,92,35,11)
	line(92,35,82,45,3)
	line(0,127,35,92,11)
	line(35,92,45,82,3)
 line(127,127,92,92,11)
 line(92,92,82,82,3)
 --line(45,45,50,50,5)
 --line(82,45,77,50,5)
 --line(45,82,50,77,5)
 --line(82,82,77,77,5)
end


function drawpicnic(x,y)
	spr(22,x,y)
	spr(22,x+2,y)
	spr(22,x+2,y+4)
	spr(22,x+8,y)
	spr(22,x,y+4)
	spr(22,x+8,y+4)
	spr(21,x+10,y-2)
end

function drawxhair()
	spr(20,px-4,py-4)
end

function drawbear(x,y,mirror)
	local leg=px%10 < 5 and 34 or 33
	spr(1,x,y-8,1,2,mirror,false)
	spr(16,x-8,y,3,1,mirror,false)
	spr(leg,x,y+8,1,1,mirror,false)
end

actor={}
actor.x=-1
actor.y=-1
actor.active=true
actor.anitmr=0
actor.hp=10
actor.sprite={}
actor.hittmr=0

function actor:new(o)
	o = o or {}
	setmetatable(o, self)
	self.__index=self
	return o
end


function actor:upd()
		if(self.hittmr > 0) then
			self.hittmr = self.hittmr - 1
		end
		if(self.hp > 0) then	
			if(self.y < 110) then
				self.update(self)
			else
				self.x=self.x+1.2
				if(self.x > 120)then
					score = score-(self.hp)
					self.active=false
					self.hp=0
					sfx(5)	
				end
			end
		elseif(self.hittmr < 1) then
				self.active=false
				sfx(2)
		end 
end

function actor:drw()
	if(self.hittmr > 0) then
		self.drawhit(self)
	end
	if(self.hp>0) then
		self.draw(self)
	else
		self.drawblood(self)
	end
end

function actor:drawblood()
	local mx=1/self.hittmr
	local nx=self.hittmr/10
	circfill(self.x,self.y,4,8)
	circfill(self.x+4*mx,self.y+5*mx,3*nx,2)	
	circfill(self.x-2*mx,self.y+3*mx,4*nx,8)
	circfill(self.x-6*mx,self.y-6*mx,2*nx,2)	
	
end

function actor:hit()
if(self.hp>0)then
	score=score+flr(self.hp/10+(128-self.y))
	self.hp=self.hp-10
	self.hittmr=15
	sfx(1)
end
end

function actor:drawhit()
	if(self.hp > -10)then
		print(flr(self.hp/10+(128-self.y)),self.x,self.y-4-(10/self.hittmr),7)
	end
end

function bat(x,y)
	local b = actor:new()
	b.sprite={4,5}
	b.x=x
	b.y=y
	b.modtime=1
	b.dirc=1
	b.update=function(s)
		b.modtime=(b.modtime+1)
		if(b.modtime%15 == 0) then
			b.modtime=0
			b.dirc=b.dirc*-1
		end
		s.y=s.y+0.2
		s.x=s.x+(b.dirc/2)
	end
	b.draw=function(s)
		local i=s.dirc==1 and 1 or 2
		spr(s.sprite[i],s.x,s.y)
	end
	return b
end

function ninja(x,y)
	local b = actor:new()
	b.sprite={6,7}
	b.x=x
	b.y=y
	b.hp=20
	b.modtime=1
	b.mode=1
	b.dirc=1
	b.update=function(s)
		s.modtime=s.modtime+1
		if(s.modtime%30 == 0) then
			if(s.mode==-1)then 
				s.dirc=b.dirc*-1
			end
			s.modtime=0
			s.mode=s.mode*-1
		end
		if(s.mode==1)then
			s.y=s.y+0.3
			s.x=s.x+(b.dirc*1.2)
		end
	end
	b.draw=function(s)
		local i=s.mode==-1 and 1 or 2
		spr(s.sprite[i],s.x,s.y,1,1,s.dirc==1,false)
	end
	return b
end


function skel(x,y)
	local a=actor:new()
	a.sprite={8,9,10}
	a.x=x
	a.y=y
	a.hp=30
	a.modtime=0
	a.update=function(s)
		a.y=a.y+0.2
		a.modtime=(a.modtime+1)%15
	end
	a.draw=function(s)
		local i=1
		if(s.modtime>5)then i=2 end
		if(s.modtime>10)then i=3 end
		spr(s.sprite[i],s.x,s.y)
	end
	return a
end

function snek(x,y)
	local a=actor:new()
	a.sprite={11,12,13}
	a.x=x
	a.y=y
	a.hp=10
	a.modtime=0
	a.dirc=1
	a.update=function(s)
		if(a.x>80)then a.dirc=-1 end
		if(a.x<40)then a.dirc=1 end
		a.y=a.y+0.1
		a.x=a.x+a.dirc
		a.modtime=(a.modtime+1)%15
	end
	a.draw=function(s)
		local i=1
		if(s.modtime>5)then i=2 end
		if(s.modtime>10)then i=3 end
		spr(s.sprite[i],s.x,s.y)
	end
	return a
end



actors={}

bear = {}
bear.x=0
bear.y=0


shot={}
shot.x=-1
shot.y=-1
shot.tx=-1
shot.ty=-1
shot.active=false
shot.anim=0

function shoot()
	if (shot.active == false and shot.anim==0) then
		shot.active=true
		shot.y=bear.y
		shot.x=px
		shot.tx=px
		shot.ty=py
		shot.anim=0
		sfx(0)
	end
end

function updateshot()
	if(shot.active==true) then
		if(shot.y > shot.ty) then
			shot.y = shot.y-3
		else
			shot.anim=3
			shot.active=false
		end
	end
end

function drawshot() 
	 if(shot.active == true) then
			circfill(shot.x,shot.y,(5*(shot.y*0.5/bear.y)),7) 
			circfill(shot.x,shot.y,(5*(shot.y*0.5/bear.y)),7) 
	 end
	 if(shot.anim>0) then
	 	local ani=shot.anim-1
	 	spr(35+ani,shot.tx-4, shot.ty-4)
	 	shot.anim=shot.anim-1
	 end
end

function drawactors(ymin, ymax)
	foreach(actors, function(a)
		if(a.y > ymin and a.y < ymax )then
			a.drw(a)
		end
	end)
end

function updateactors()
	foreach(actors, function(a)
		a.upd(a)
		if(a.active==false)then
			del(actors, a)
		end
	end)
end

function checkcoll()
	if(shot.anim > 0) then
		foreach(actors, function(a) 
			if(a.active and
						a.x < shot.tx+6 and
						a.x > shot.tx-6 and
						a.y > shot.ty-6 and
						a.y < shot.ty+6) then
				a.hit(a)
				shot.anim=0
			end
		end)
	end
end

function drawscore()
	print("score: "..score, 10,10,7)
end

function drawgame()
	cls(0)
	grid()
	drawactors(0,74)
	bg1()
	drawactors(75,84)
	bg2()
	drawactors(85,120)
	bg3()
	drawpicnic(88,110)
	drawactors(100,128)
	drawxhair()
	drawshot()
	drawbear(bear.x,bear.y,pmirror)
	drawscore()
	print("enemies:"..count(enemies)-enemyi+1,80,10,7)
end

function _draw()
	if(gamestate==0)then
		drawtitle()
	elseif(gamestate==1)then
		drawgame()
	elseif(gamestate==2)then
		drawcut()
	elseif(gamestate==9)then
		drawend()
	end
end

function updategame()
	loadnextlevel()
	gametime=gametime+1
	loadenemies()
	local mod=0
	if(btn(5)) then
		mod=2
	end
	if(btn(2) and py > 0) then
		py = py-1-mod
	elseif (btn(3) and py < 128) then
		py = py+1+mod
	end
	
	if(btn(0) and px > 0) then
		px=px-1-mod
		pmirror=true
	elseif(btn(1) and px < 128) then
		px=px+1+mod
		pmirror=false
	end
	
	if(btn(4)) then
	 shoot()
	end
	bear.x=30+px/2
	bear.y=116
	updateshot()
	checkcoll()
	updateactors()

end

function _update()
	if(gamestate==0)then
		updatetitle()
	elseif(gamestate==1) then
		updategame()
	elseif(gamestate==2) then
		gametime=gametime+1
		if(gametime>60)then
		 gametime=1
		 gamestate=1
		end
	elseif(gamestate==9)then
		gametime=gametime+1
		if(gametime>100)then
		 gametime=1
		 gamestate=0
		 highscore = (score>highscore) and score or highscore
		end
	end
end

function updatetitle()
	if(btn(4) or btn(5))then
		init()
		gamestate=2
		loadnextlevel()
	end
end

function drawcut()
	cls(0)
	print("level "..level, 50,50,7)
	print("get ready!", 45,60,10)
end

function drawend()
	cls(0)
	print("final score: "..score, 25,55,7)
end

function drawtitle()
	cls(0)
	print("gymcrash.com presents",23,5,10)
	rectfill(18,13,106,53,3)
	rectfill(20,15,108,55,11)
	rect(25,20,103,50,3)
	print("bear arms:", 45,25,0)
	print("bear arms:", 44,25,10)
	print("revenge of the", 38,33,0)
	print("wild gunner",44,41,15)
	print("wild gunner",43,41,4)
	rect(28,60,102,82,5)
	print("”ƒ‹‘ = aim gun", 30,62,6)
	print("— = shoot", 30, 69, 6)
	print("hold Ž = fast aim", 30, 76, 6)

	px=67
	py=95
	drawpicnic(110,95)
	drawxhair()
	drawbear(5,95,false)
	print("highscore:"..highscore,30,103,7)
	print("protect the picnic",30,112,10)
	print("press Ž or — to start", 20, 120,7)
end

function loadenemies()
	if(enemyi-1 < count(enemies) 
		and gametime%enemyrate==0) then
		add(actors,enemies[enemyi])
		enemyi=enemyi+1	
	end
end

function loadnextlevel()
	if(enemyi > count(enemies)
	and count(actors)==0)then
		level=level+1
		if(level > count(levels))then
			gametime=1
			gamestate=9
			sfx(4)
		else
				local lvl=levels[level]
				gametime=1
				enemies=lvl.enemies
				enemyrate=lvl.enemyrate
				enemyi=1
				bgxi=lvl.bgxi
				bgyi=lvl.bgyi
				gamestate=2
				sfx(3)
			end
	end
end

