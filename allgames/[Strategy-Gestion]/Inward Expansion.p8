-- train ----------------------
function train_init()
 switch_state=0
 train={
  {64 ,8,1},--x,y,dir
  {72 ,8,1},
  {80 ,8,1},
  {88 ,8,1}, 
  {96 ,8,1}, 
  {104,8,1}
 }
 tsprites={
  {29, 28, 27},
  {62, 46, 30},
  {43, 44, 45},
  {31, 47, 63}
 }
 tinc=0--movement incrementer
 tmov=0--pts to move
 tmom=1--movement scalar
 trev=flase--train reversed
 tvel=0--scalar for accel
 tspri = 1
 tctr = 0
 smoke={}
 smoke_max = 11
 smoke_fill = 0
 for i=0,smoke_max do
  smoke[i]={-8,-8,0}
 end
 trackswitch={
  [8]=9,--cross
  [9]=8,
  [32]=48,--down t
  --[33]=48,
  [48]=32,
  [53]=54,--up t
  [54]=53,
  --[55]=53,
  [39]=40,--right t
  [40]=39,
  --[56]=39,
  [42]=41,--left t
  [41]=42,
  --[57]=42,
  [18]=2,--track stop
  [2]=18
 }
 stops={}--city info for stops
 stop_clock=0
 psngrs=0
 psngr_max=50
 laststop=0
end

function move_segment(s, dir)
 local spd=tmov
 local d=s[3]
 if(tvel==0)return
 -- reacting to tracks
 local fx = flr(s[1]) -- rounding for floating point
 local fy = flr(s[2])
 if fx%8==0 and fy%8==0 then
  fx/=8
  fy/=8
  -- tile on top of 
  local tile = mget(fx, fy)
  --turning
  if tile==6 or tile==40 or tile==53 then
   if(d==1)s[3]=2
   if(d==4)s[3]=3
  end
  if tile==38 or tile==48 or tile==39 then
   if(d==2)s[3]=3
   if(d==1)s[3]=4
  end
  if tile==36 or tile==32 or tile==42 then
   if(d==3)s[3]=4
   if(d==2)s[3]=1
  end
  if tile==4 or tile==41 or tile==54 then
   if(d==4)s[3]=1
   if(d==3)s[3]=2
  end
  d=s[3]
  -- tile in front of you
  local dx = 0
  if(d==1)dx=1
  if(d==3)dx=-1
  local dy = 0
  if(d==2)dy=1
  if(d==4)dy=-1
  local tilef= mget(fx+dx, fy+dy)
  --stop for station gate
  if tilef==2 then
   tvel=0
   adv_switch()
   stop_check(fx+dx,fy+dy)
   return
  end
  --stopping from conflicting tracks
  if fget(tilef,0)==false then
   --can't move on non-tracks
   tvel=0
   adv_switch()
   return
  else
   -- ensure there's no directional conflicts
   if d==1 and not fget(tilef,1) then
    tvel=0
    adv_switch()
    return
   elseif d==2 and not fget(tilef,2) then
    tvel=0
    adv_switch()
    return
   elseif d==3 and not fget(tilef,3) then
    tvel=0
    adv_switch()
    return
   elseif d==4 and not fget(tilef,4) then
    tvel=0
    adv_switch()
    return
   end
  end
 end
 -- moving
 if d==1 then
  s[1]+=spd
 elseif d==2 then
  s[2]+=spd
 elseif d==3 then
  s[1]-=spd
 elseif d==4 then
  s[2]-=spd
 end
end

function train_reverse()
 trev=not trev
 for t in all(train) do
  local d=t[3]
  if(d==1)t[3]=3 else
  if(d==2)t[3]=4 else
  if(d==3)t[3]=1 else
  if(d==4)t[3]=2
 end
end

function adv_switch()
 if(switch_state<1)
 then
  switch_state+=1
  music(0, 0, 1)
 else
  switch_state=0
  music(-1)
  sfx(1)
 end
end

function track_switch(x,y)
 --make sure train's not over
 for trn in all(train) do
  if inrect(trn[1],trn[2],trn[1]+7,trn[2]+7,x*8,y*8)then
   return
  end
 end
 --switch track at [x,y]
 local t=mget(x,y)
 local to=trackswitch[t]
 if to ~= nil then
  mset(x,y,to)
 end
end

function move_train()
 --velocity
 if switch_state==1 then
  tvel=min(tvel+0.015,1)
 else
  tvel=max(tvel-0.015,0)
 end
 --speed incrementor
 tmov=0
 tinc+=tmom*0.5*tvel
 while tinc >= 1 do
  tinc-=1
  tmov+=1
 end
 --moving segments
 for t in all(train) do
  move_segment(t,switch_state)
 end
 -- blowing smoke
 tctr-=1
 if(tctr<=0 and switch_state==1)then
  tctr=4
  smoke_puff(train[#train][1],train[#train][2]-3)
 end
 -- switch on and off with cursor
 if cur_on and btnp(4) then
  local t = train[#train]
  if(inrect(t[1],t[2],t[1]+7,t[2]+7,ptr_x,ptr_y))then
   adv_switch()
   tmom=1
   if(trev)train_reverse()
  end
  t = train[1]
  if(inrect(t[1],t[2],t[1]+7,t[2]+7,ptr_x,ptr_y))then
   adv_switch()
   tmom=0.5
   if(not trev)train_reverse()
  end
 end
end

function smoke_puff(x,y)
 smoke[smoke_fill][1]=x
 smoke[smoke_fill][2]=y
 smoke[smoke_fill][3]=0
 smoke_fill = (smoke_fill+1)%smoke_max
end

function smoke_update()
 for s in all(smoke) do
  s[2]-=0.32
  s[3]+=0.12
  if s[3] >= 4 then
   s[1]=-8
   s[2]=-8
  end
 end
end

function draw_train()
 local len=count(train)
 for t=1,len do
  local trn=train[t]
  local d=trn[3]
  if trev then
   if(d==1)then d=3 
   elseif(d==2)then d=4 
   elseif(d==3)then d=1
   elseif(d==4)then d=2 end
  end
  
  if(t==1) then
   sprite=tsprites[d][3]
  elseif(t==len) then
   sprite=tsprites[d][1]
  else
   sprite=tsprites[d][2]
  end
 	spr(sprite,trn[1],trn[2])
 end
end

function smoke_draw()
 for s in all(smoke) do
  spr(58+flr(s[3]), s[1], s[2])
 end
end
-------------------------------
-- stops ----------------------
function stop_index(x,y)
 return (y*map_w+x)/8
end

function stop_coord(i)
 return i-flr(i/map_w),flr(i/map_w)
end

function stop_check(x,y)
 stop_make(x,y)
 local stop=stops[stop_index(x,y)]
 --make sure they're not repeat stopping
 if(stop==laststop)return
 laststop=stop
 --passengers exit
 local off=flr(rnd(min(psngrs/2,stop[2])))
 psngrs-=off
 stop[1]+=psngrs
 message("unloaded "..off.." passengers.")
 --passengers board
 local on=min(psngr_max-psngrs,1+flr(rnd(stop[1]/3)))
 psngrs+=on
 stop[1]-=psngrs
 message(on.." boarded the train.")
 --ma gets some lumber
 res+=on+off+1+flr(rnd(5))
 message("ma:^li picked up some nice junk^lfer buildin with.")
 --overhear passengers
 if rnd(10)<3.5 then
  message("you overhear the smalltalk^lof passengers as they^lexit the train.")
  message(psngr_lines[flr(rnd(#psngr_lines-0.001))])
 end
end

function stop_refresh()
 stop_clock-=1
 if stop_clock<=0 then
  stop_clock=150
  for stop in all(stops) do
   stop[1]+=1
  end
 end
end

function stop_make(x,y)
 local i = stop_index(x,y)
 if stops[i]==nil then
  local pop=0
  for xx=x-6,x+6 do
  for yy=y-6,y+6 do
   local t = mget(xx,yy)
   if(t==10)pop+=2--house
   if(t==64)pop+=5--big building
   if(t==13)pop+=1--broken down hosue
  end
  end
  stops[i]={pop,pop}
  --[1]=available passengers
  --[2]=maximum passengers
 end
end
