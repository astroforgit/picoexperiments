-- title screen ---------------
function title()
 for i=0,15 do
  rectfill(0,0,127,127,7)
  flip()
 end
 music(2,-1,1+2)
 local st=64
 local e1=1
 local e2=126
 for exp=0,60 do
  local p=exp/60
  rectfill(0,0,127,127,7)
  rectfill(
   st-63*p,
   st-63*p,
   st+62*p,
   st+62*p,
   0
  )
  sspr(16,32,7*8,2*8,
   64-28*p,
   64-29*p,
   7*8*p,
   2*8*p
  )
  flip()
 end
 rectfill(0,0,127,127,0)
 rect(0,0,127,127,7)
 spr(66,64-28,35,7,2)
 print("press btn to play",30,80,15)
 print("* by lulu blue *",32,120,2)
 flip()
 while not btnp(4) do
 end
 flip()
end
