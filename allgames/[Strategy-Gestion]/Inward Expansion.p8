-- dynamite -------------------
function dynamite(x,y)
 camera(camera_x,camera_y)
 sfx(10)
 for xx=max(0,x-1),min(x+1,128) do
 for yy=max(0,y-1),min(y+1,64) do
  local t = mget(xx,yy)
  local to = 19
  if(t==10)to=13
  mset(xx,yy,to)
  spr(14,xx*8,yy*8)
  flip()
  flip()
 end
 end
end
