-- water ----------------------
function water_init()
 wtr_time = 0
 wtr_at = false
end

function water_update()
 wtr_time-=1
 if wtr_time<0 then
  wtr_time=20
  wtr_at=not wtr_at
 end
end

function water_pal()
 if wtr_at then
  pal(10, 12)
  pal(3, 7)
 else
  pal(10, 7)
  pal(3, 12)
 end
end
