-- yeti -----------------------
function yeti_init()
 yeti_x=123*8
 yeti_y=13*8
 yeti_run=false
 yeti_i=0
 yeti_c=0
end

function yeti_update()
 if -- yeti runs away (also click)
 abs(yeti_x-train[#train][1]) < 32 and
 abs(yeti_y-train[#train][2]) < 32 then
  yeti_run = true
 end
 -- yeti running
 if yeti_run then
  yeti_x+=1
  if(yeti_x>map_w)yeti_run=false
 end
 -- yeti animate
 yeti_c-=1
 if yeti_c <=0 then
  yeti_c=30
  yeti_i=(yeti_i+2)%4
 end
end

function yeti_draw()
 spr(96+yeti_i,yeti_x,yeti_y,2,2)
end
-------------------------------
-- tumbleweed -----------------
function tweed_init() -- dank
 tweed_x=-8
 tweed_y=0
 tweed_c=0
 tweed_fx=false
 tweed_fy=false
end

function tweed_update()
 --moving
 tweed_x-=1
 if tweed_x<-8 then
  tweed_y=flr(rnd(map_h))
  tweed_x=map_w
 end
 --animating
 tweed_c-=1
 if tweed_c <=0 then
  tweed_c=5
  if(not tweed_fx and not tweed_fy)then
   tweed_fx=true
  elseif(not tweed_fy)then
   tweed_fy=true
  elseif(tweed_fx)then
   tweed_fx=false
  else
   tweed_fy=false
  end
 end
end

function tweed_draw()
 spr(116,tweed_x,tweed_y,1,1,tweed_fx,tweed_fy)
end
-------------------------------
function _init()
 cls()
 train_init()
 cursor_init()
 camera_init()
 water_init()
 build_init()
 yeti_init()
 tweed_init()
 
 intro=35
 
 title()
end

function _update()
 move_train()
 smoke_update()
 --cursur interactions
 if(cur_on and btnp(4) and not buymenu)then
  local tile=mget(cur_x,cur_y)
  --track on/off
  if(tile==7)adv_switch()
  --cactus conversation
  if(tile==24)message("move along,^lthere is nothing suspicious about this.")
  --track cycling
  if(tile==25 or tile==26)then
   if(tile==25)mset(cur_x,cur_y,26)
   if(tile==26)mset(cur_x,cur_y,25)
   track_switch(cur_x-1,cur_y)
   track_switch(cur_x+1,cur_y)
   track_switch(cur_x,cur_y-1)
   track_switch(cur_x,cur_y+1)
   track_switch(cur_x+1,cur_y+1)
   track_switch(cur_x+1,cur_y-1)
   track_switch(cur_x-1,cur_y-1)
   track_switch(cur_x-1,cur_y+1)
  end
  --water
  if(tile==34)message("the water...^lit's gorgeous.")
  --berry bush
  if(tile==49)message("those look yummy!")
  --death tower
  if(tile==73 or tile==89 or tile==105)message("ma:^lwe best not be futzin^lwith that. let's go.")
  --yeti
  if(inrect(yeti_x,yeti_y,yeti_x+16,yeti_y+16,ptr_x,ptr_y))yeti_run=true
  --cow
  if(tile==56)message("moo..")
  --sfx
  if(not fget(tile,6))sfx(2)
  --dynamite
  if(tile==12)dynamite(cur_x,cur_y)
 end
 if not buymenu then
  cursor_update()
  build_repo()
  camera_update()
 else
  build_update()
 end
 water_update()
 yeti_update()
 tweed_update()
 stop_refresh()--train stops
 
 --intro text
 if intro>0 and true then
  intro-=1
  if intro<=0 then
   dlg_intro()
  end
 end
end

function _draw()
 camera(flr(camera_x),flr(camera_y))
 local cx=flr(camera_x/8)
 local cy=flr(camera_y/8)
 map(cx,cy,cx*8,cy*8,18,18)
 water_pal()
 map(cx,cy,cx*8,cy*8,18,18,2^7)
 pal()
 yeti_draw()
 draw_train()
 tweed_draw()
 smoke_draw()
 cursor_draw()
 build_draw()
 camera(0,0)
 
 if false then
  rectfill(0,0,127,8,1)
  print("mem:"..stat(0),2,2,7)
  print("cpu:"..stat(1),50,2,7)
 end
end

