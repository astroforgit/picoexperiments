-- build screen ---------------
function build_init()
 buylist={
  4,--top left corner
  5,--top
  6,--top right corner
  20,--left
  36,--bottom left corner
  38,--bottom right corner
  26,--track switch
  8,--cross piece
  32,--bottom t
  53,--top t
  39,--right t
  41,--left t
  3,--station pad
  18,--station gate
  12,--dynamite
  50--grass
 } -- 16 things total, 4x4 display
 buymenu=false
 buylayout={
  {32, 32},
  {48, 32},
  {64, 32},
  {80, 32},
  {32, 48},
  {48, 48},
  {64, 48},
  {80, 48},
  {32, 64},
  {48, 64},
  {64, 64},
  {80, 64},
  {32, 80},
  {48, 80},
  {64, 80},
  {80, 80}
 }
 placex=0
 placey=0
 res=10
 bcx=0--buy cursor x/y
 bcy=0
 bci=1--cursor to index
end

function build_update()
 --navigating menu
 if(btnp(0))bcx-=1 sfx(4)
 if(btnp(1))bcx+=1 sfx(4)
 if(btnp(2))bcy-=1 sfx(4)
 if(btnp(3))bcy+=1 sfx(4)
 bcx=bcx%4
 bcy=bcy%4
 bci=bcy*4+bcx+1
 --closing menu
 if btnp(5) then
  buymenu=false
  sfx(7)
  cur_on=true
  return
 end
 --selecting to build
 if btnp(4) and res>=1 then
  mset(placex,placey,buylist[bci])
  res-=1
  sfx(2)
  buymenu=false
  return
 end
end

-- repo material(lol)
function build_repo()
 if btnp(5) and fget(mget(cur_x,cur_y),5) then
  res+=1
  mset(cur_x,cur_y,19)--dirt
  cur_on=true
  sfx(5)
 end
end

-- activate build menu
-- t his is called from cursor
function build_open()
 local t=mget(cur_x,cur_y)
 if fget(t,6) then
  buymenu=true
  placex=cur_x
  placey=cur_y
  sfx(6)
 end
end

function build_draw()
 if(not buymenu)return
 camera(0,0)
 rectfill(24,12,96,112,2)
 rectfill(24,22,96,94,1)
 print("build",32,14,15)
 line(30,21,88,21,15)
 printc("cost^lhave",32,98,15)
 print("1",88-3,98,15)
 print(res,89-4*#(res..""),104,15)
 for i=1,16 do
  local xx=buylayout[i][1]
  local yy=buylayout[i][2]
  spr(buylist[i],xx,yy)
  if(bci==i)rect(xx-2,yy-2,xx+9,yy+9,15)
 end
 --passengers
 rectfill(0,120,127,127,1)
 local t=psngrs.."/"..psngr_max
 spr(17,49,120)
 spr(17,49-4,120)
 print(t,61,122,15)
 camera(camera_x,camera_y)
end
