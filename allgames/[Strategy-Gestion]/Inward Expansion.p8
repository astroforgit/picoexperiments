pico-8 cartridge // http://www.pico-8.com
version 1
__lua__
--        interior expansion
--     a quiet exploration game
-- printc(text,x,y)
-- by yellowafterlife
-- introduces a function with
-- formatting. supports:
-- ^0..^f: set color
-- ^l: linebreak
function printc(t,x,y,col)
 local l=x
 local s=col
 local o=1
 local i=1
 local n=#t+1
 while i<=n do
  local c=sub(t,i,i)
  if c=="^" or c=="" then
   i+=1
   local p=sub(t,o,i-2)
   print(p,l,y,s)
   l+=4*#p
   o=i+1
   c=sub(t,i,i)
   if c=="l" then
    l=x
    y+=6
   else
    for k=1,16 do
     if c==sub("0123456789abcdef",k,k) then
      s=k-1
      break
     end
    end
   end
  end
  i+=1
 end
end
-------------------------------
-- mchk -----------------------
function mchk(x, y)
 return mget(mapx+flr(x/8),mapy+flr(y/8))
end
-- inside rect ----------------
function inrect(x, y, x2, y2, px, py)
 if(px>x2)return false
 if(py>y2)return false
 if(px<x) return false
 if(py<y) return false
 return true
end
-------------------------------
-- cursor ---------------------
function cursor_init()
  cur_x=6
  cur_y=6
  cur_on=false--active cursor
  cur_s=1--sprite
  
  ptr_x=cur_x*8
  ptr_y=cur_y*8
  ptr_s=16--sprite
  ptr_xv=0--x+y velocity
  ptr_yv=0
  ptr_xl=0.5--acceleration
  ptr_fr=0.5--friction
  ptr_mx=2--max speed
end

function cursor_update()

 if(btnp(5)and not buymenu)cur_on=false sfx(14)

 if(not cur_on)then
  if(btnp(4))then
   cur_on=true
   sfx(15)
  else
   ptr_xv=0
   ptr_yv=0
   return
  end
 else
  --activate buy menu
  if(btnp(4))build_open()
 end
 
 local movex=false
 local movey=false
 if(btn(0))ptr_xv-=ptr_xl movex=true
 if(btn(1))ptr_xv+=ptr_xl movex=true
 if(btn(2))ptr_yv-=ptr_xl movey=true
 if(btn(3))ptr_yv+=ptr_xl movey=true
 
 if(abs(ptr_xv)>ptr_mx)ptr_xv=ptr_mx*sgn(ptr_xv)
 if(abs(ptr_yv)>ptr_mx)ptr_yv=ptr_mx*sgn(ptr_yv)
 
 -- clip inside camera
 if(ptr_x<camera_x)ptr_x=camera_x
 if(ptr_y<camera_y)ptr_y=camera_y
 if(ptr_x>camera_x+128)ptr_x=camera_x+128
 if(ptr_y>camera_y+128)ptr_y=camera_y+128
 -- camera move
 local margin=20
 if(ptr_x>camera_x+128-margin and ptr_xv>0)camera_x+=ptr_xv
 if(ptr_y>camera_y+128-margin and ptr_yv>0)camera_y+=ptr_yv
 if(ptr_x<camera_x+margin and ptr_xv<0)camera_x+=ptr_xv
 if(ptr_y<camera_y+margin and ptr_yv<0)camera_y+=ptr_yv
 -- pointer move
 ptr_x+=ptr_xv
 ptr_y+=ptr_yv
 local xvp=sgn(ptr_xv)
 local yvp=sgn(ptr_yv)
 if(not movex)ptr_xv-=ptr_fr*xvp
 if(not movey)ptr_yv-=ptr_fr*yvp
 if(sgn(ptr_xv)!=xvp)ptr_xv=0
 if(sgn(ptr_yv)!=yvp)ptr_yv=0
 
 cur_x = flr(ptr_x/8)
 cur_y = flr(ptr_y/8)
end

function cursor_draw()
 if(not cur_on)return
 spr(cur_s,cur_x*8,cur_y*8)
 spr(ptr_s,ptr_x,ptr_y)
end
-------------------------------
-- camera ---------------------
function camera_init()
 camera_x=0
 camera_y=0
 camera_free=false
 map_w=128*8
 map_h=128*4
end

function camera_update()
 -- lock to train
 if not camera_free then
 if cur_on then
  local tx_min,tx_max,ty_min,ty_max
  for t in all(train) do
   tx_min=min(tx_min or t[1], t[1])
   tx_max=max(tx_max or t[1], t[1])
   ty_min=min(ty_min or t[2], t[2])
   ty_max=max(ty_max or t[2], t[2])
  end
  if(tx_max<camera_x+10)camera_x=tx_max-10
  if(ty_max<camera_y+10)camera_y=ty_max-10
  if(tx_min>camera_x+118)camera_x=tx_min-118
  if(ty_min>camera_y+118)camera_y=ty_min-118
 else
  local rate=tmov
  for t in all(train) do
   if(t[1]<camera_x+30)camera_x-=rate
   if(t[2]<camera_y+30)camera_y-=rate
   if(t[1]>camera_x+98)camera_x+=rate
   if(t[2]>camera_y+98)camera_y+=rate
  end
 end
 end
 -- lock to map boundaries
 if(camera_x<0)camera_x=0
 if(camera_y<0)camera_y=0
 if(camera_x>map_w-128)camera_x=map_w-128
 if(camera_y>map_h-128)camera_y=map_h-128
end
-------------------------------
-- message --------------------
function message(txt)
 txt = txt or "..?"
 -- text scroll
 for i=1,15 do
  rectfill(0, 96, 127, 127, 2)
  flip()
 end
 for i=1,#txt do
  sfx(9)
  rectfill(0, 96, 127, 127, 2)
  printc(sub(txt, 1, i), 5, 100,15)
  flip()
 end
 -- loop until done
 local n = 15
 while(not btn(4))do
  -- chilllll
  if n == 15 then
   --rectfill(122, 122,126,126,15)
   circfill(124,124,2,15)
  end
  if n == 30 then
   rectfill(122, 122,126,126,2)
   n=0
  end
  flip()
  n+=1
 end
 sfx(8)
 flip()
end
