-- inventory

function _draw_honey()
 
 local d= box_dims(97,2,124,10)
 
 ui_box(d)
 
 spr(23,d.x0+2,d.y0+3)
 local temp = inv.honey
 local offs = 
         #tostr(inv.honey)*-4
 print(inv.honey, 
       d.x0+26+offs,d.y0+2,10)
end

function box_dims(x0,y0,x1,y1)
 local d = {}
 d.x0 =  x0 + camworld[1]
 d.y0 =  y0 + camworld[2]
 d.x1 =  x1 + camworld[1]
 d.y1 =  y1 + camworld[2]
 return d
end

function ui_box(d)
 rectfill(d.x0,d.y0,d.x1,d.y1,4)
 fillp(Å)
 rectfill
 (d.x0+1,d.y0+1,d.x1-1,d.y1-1,2)
 rect(d.x0,d.y0,d.x1,d.y1,10)
 fillp()
end
-->8
-- spaces

-- instantiates a tile at
-- pos, with sp_type
-- (random gen by default)
-- 
function new_space
   (pos,sp_type,cost,is_starter)
 local key = pos_to_key(pos)
 
-- get rid of this
-- 
 if(sp_type!=beehive and
   (all_spaces[key] == null or 
   all_spaces[key].bg!=hl_col))
   then return
 end
 
 if(not try_charge(cost))
 then return end
-- 
 local h = {}
 h.pos = {}
 h.pos[1]=pos[1]
 h.pos[2]=pos[2]
 apply_sprite(h,sp_type)
 space_bg(h)
 all_spaces[key] = h
 highlight_around(h.pos)
 space_events(h,cost,is_starter)
 return h
end

function apply_sprite(h,sp_type)
 if(sp_type != nil) then
  h.sprite = sp_type
 else
  h.sprite = rand_space()
 end
end

function space_bg(h)
 if(h.sprite == water)then
  h.bg = water_col
 else
  h.bg = grass_col
 end
end

function try_charge(cost)
 if(cost != nil) then
	 if(inv.honey < cost) then
	  return false
	 else
	  inv.honey -= cost
	  return true
	 end
 end
 return true
end

function space_events(h, cost,
                   is_starter)
 -- if beehive, new bee
 if(h.sprite == beehive)then
  new_bee(h.pos, h)
 else
  sfx(1)
 end
 if((h.sprite == 3 or
     h.sprite == 6 and not
     is_starter) 
     and not 
     events.revealed[h.sprite])
 then
  tutorial(h.pos)
 end
end

function highlight(pos)
 local key = pos_to_key(pos)
 if(all_spaces[key] != null)then
  return
 end
 local h = {}
 h.pos = {}
 h.pos[1]=pos[1]
 h.pos[2]=pos[2]
 h.sprite = blank
 h.bg = hl_col
 all_spaces[key] = h
 --all_spaces[#all_space+1] = h
 return h
end

function rend_space(b)
 local p = pos_to_world(b.pos)
 pal(curs_col, b.bg)
 spr(35,p[1],p[2],2,2)
 pal()
 p = obj_pos_to_world(b.pos)
 spr(b.sprite,p[1],p[2])
 
 
end

function rend_all_spaces()
 for k,v in pairs(all_spaces)do
  rend_space(v)
 end
end

function pos_to_key(p)
 return p[1]..","..p[2]
end

function rand_space()
 roll = rnd(100)
 for i=1,#space_chance do
  if(roll<space_chance[i])then
   return i
  end
 end 
end

function get_neigh_pos(pos)
 local n = {}
 n[#n+1] = {pos[1]+1,pos[2]}
 n[#n+1] = {pos[1]-1,pos[2]}
 n[#n+1] = {pos[1],pos[2]+1}
 n[#n+1] = {pos[1],pos[2]-1}
 
 if(pos[1]%2==1)then
  n[#n+1] = {pos[1]+1,pos[2]+1}
  n[#n+1] = {pos[1]-1,pos[2]+1}
 else
  n[#n+1] = {pos[1]+1,pos[2]-1}
  n[#n+1] = {pos[1]-1,pos[2]-1}
 end
 return n
end

function get_space_at(pos)
 local key = pos_to_key(pos)
 return all_spaces[key]
end

function get_neigh_space(pos)
 local n = {}
 
 local 
 check = {pos[1],pos[2]+1}
 check = pos_to_key(check)
 if(all_spaces[check] !=nil)then
  n[#n+1] = all_spaces[check]
 end
 return n
end

function get_free(pos)
 local free = {}
 local all_n=
          get_neigh_pos(pos)
 for i=1,#all_n do
  if(get_space_at(all_n[i])
                  == nil) then
   free[#free+1] = all_n[i]
  end
 end
 return free
end

function highlight_around(pos)
 local free = get_free(pos)
 foreach(free, highlight)
end

-- guaranteed flower check
-- false if no flower needed
--[[
function gfc() 
 gf -= 1
 if(gf == 0) then
  for k,v in pairs(all_space)
  do
   if(v.sprite == flower)then
    return false
   end
  end
  return true
 end
 return false
end
--]]
function 
check_for_neigh_bees(pos)
 local n = get_neigh_pos(pos)
 for i=1,#n do
  local key = pos_to_key(n[i])
  if(all_spaces[key]!=nil and 
     all_spaces[key].sprite
     == beehive)then
   return true
  end
 end
 return false
end
-->8
-- bees

function new_bee(pos, hive)
 local b = {}
 b.pos = pos
 
 b.hive = hive
 b.target = hive.pos
 b.arrival_time = t()+2
 b.anim_speed = 0.1
 b.anim_stamp = t()+
              rnd(b.anim_speed)
 b.dist_left = flr(rnd(2))+2
 b.frame = 1
 all_bees[pos_to_key(b.pos)]=b
 return b
end

function rend_all_bees()
 for k,v in pairs(all_bees) do
  rend_bee(v)
 end
end

function anim_bee(b)
 if(t() - b.anim_stamp
    >= b.anim_speed) then
  b.anim_stamp = t()
  if(b.frame >= 
               #bee_anim) then
   b.frame = 1
  else
   b.frame += 1
  end
 end
end

function rend_bee(cur_bee)
 
 anim_bee(cur_bee)
 local w = obj_pos_to_world
                (cur_bee.pos)
 if(cur_bee.target == nil)then
  spr(bee_anim[cur_bee.frame],
    w[1],w[2],1,1,
    cur_bee.mirror)      
 elseif(cur_bee.arrival_time
        <=t())then
  cur_bee.arrival_time = t()+2
  cur_bee.pos = cur_bee.target
  local all_n = 
     get_neigh_pos(
     cur_bee.target)
  if(cur_bee.dist_left<=0)then
   cur_bee.target= 
       cur_bee.hive.pos
   cur_bee.dist_left = 
                 flr(rnd(2))+2
  else
   cur_bee.dist_left -= 1
   cur_bee.target = 
      all_n[flr(rnd(6))+1]
  end
  w = obj_pos_to_world
                (cur_bee.pos)

  
  
  land(cur_bee)
  if(cur_bee.pos[1] <
     cur_bee.target[1]) then
     cur_bee.mirror = true
  elseif(cur_bee.pos[1] >
     cur_bee.target[1]) then
     cur_bee.mirror = false
  end
  
  if(cur_bee.has_honey)then
   spr(24,w[1]+1, w[2]-3)
  end
  spr(bee_anim[cur_bee.frame],
    w[1], w[2],1,1,
    cur_bee.mirror)
 else
  local prc=
    (100-
    (cur_bee.arrival_time-t())
    * 100 / 2)
  w_tar = obj_pos_to_world(
            cur_bee.target)
  local lrp = lerp2d(w,  
        w_tar, prc)
  
  
  if(cur_bee.has_honey)then
   spr(24,lrp[1]+1, lrp[2]-4)
  end
  
  spr(bee_anim[cur_bee.frame],
    lrp[1],lrp[2],1,1,
    cur_bee.mirror)
 end
end

function land(b)
 local key = pos_to_key(b.pos)
 if(all_spaces[key].bg==hl_col)
 then
  new_space(b.pos,nil)
 end
 if(all_spaces[key].sprite
                == flower) then
  b.target = b.hive.pos
  b.has_honey = true
  sfx(2)
 elseif(b.has_honey and 
    all_spaces[key]==b.hive)then
  b.has_honey = nil
  inv.honey += 1
  sfx(3)
 end
end


-->8
-- camera

function _cam()
	if(not msg_on) then
		if(t()%0.5>0.25)then
	  p = pos_to_world(campos)
	  spr(39,p[1],p[2],2,2)
	 else
	  p = pos_to_world(campos)
	  spr(35,p[1],p[2],2,2)
	 end
 end
	
	local temp = cam_pos_to_world
	                     (campos)
	camworld[1] = lerp
	    (camworld[1], temp[1], 5)
	camworld[2] = lerp
	    (camworld[2], temp[2], 5)
 camera(camworld[1],camworld[2])
end
-->8
-- controls

btn_held = {}
btn_last_upd = t()

function input()
 

 if(not msg_on) then
	 if(t()-cam_t>0.125)then
	 	if(btn(î))then 
	 	 cam_t = t() 
	 		campos[2]-=1end
	 	if(btn(É))then 
	 	 cam_t = t() 
	 		campos[2]+=1end
	 	if(btn(ã))then
	 	 cam_t = t()  
	 		campos[1]-=1end
	 	if(btn(ë))then
	 	 cam_t = t()  
	 		campos[1]+=1end
		end
	end
	
	if(btn_down(é)) then
	 disp_next_msg()
	end
	
	if(btn_down(ó))then

	 local key = pos_to_key(campos)
  --if cursor not on empty space
  --and the occupant is a tree
  --and player has enoug money
  --for a beehive, and there
  --are no beehives nearby
	 if(can_build_hive(key,campos))
	 then
	  all_spaces[key] = nil
	  new_space(campos,beehive)
	  inv.honey -= cost.beehive
	  sfx(0)
	 elseif(all_spaces[key]!=nil
	 and inv.honey>=cost.explore)
	 then
		 new_space(campos,nil,
		                cost.explore)
		end
	end
end

function can_build_hive(key,pos)
 --if cursor not on empty space
 --and the occupant is a tree
 --and player has enoug money
 --for a beehive, and there
 --are no beehives nearby
 --then yes
 --otherwise no
 
 --!!hive thats too close should
 --be highlighted later!!
 if(all_spaces[key] != nil and
 all_spaces[key].sprite==tree
 and inv.honey>=cost.beehive
 and not 
 check_for_neigh_bees(pos))
	then
	 return true
	end
	return false
end

function btn_down(b)
 if(btn(b)) then
  if(not btn_held[b] or
  btn_last_upd == t()) then
  	btn_held[b] = true
  	return true
  else 
   return false
  end
 else
  if(btn_held[b]) then
  	btn_held[b] = false
  end
  return false
 end
end
-->8
-- message

msg_lines = {} --3
msg_on = false
msg_queue = {}
msg_sp = nil

-- max characters per msg line
msg_mx_ch = 10

function queue_msg(ln1,ln2,ln3)
 msg_queue[#msg_queue+1] =
               {ln1,ln2,ln3}
 if(not msg_on) then
  msg_on = true
  disp_next_msg()
 end
end

function disp_next_msg()
 if(#msg_queue == 0) then
  msg_on = false
  return 
 end
 local c = msg_queue[1]
 set_msg(c[1],c[2],c[3])
 deli(msg_queue, 1)
end

function set_msg(ln1,ln2,ln3)
 msg_lines[1] = ln1
 msg_lines[2] = ln2
 msg_lines[3] = ln3
 msg_on = true
end

function tutorial(pos)
 local k = pos_to_key(pos)
 local s = all_spaces[k]
 events.revealed[s.sprite]=true
 if(s.sprite == tree)then 
  event_tree(pos)
 elseif(sp==rock)then 
  event_rock(pos)
 elseif(sp==beehive)then 
  event_beehive(pos)
 end
end

function rend_msg()
 if(not msg_on) 
 then return end
 if(msg_sp != nil) then
  draw_msg_pos(msg_sp)
 end
 local d = 
 box_dims(4,101,123,123)
 ui_box(d)
 
 print(msg_lines[1],
            d.x0+3,d.y0+3,10)
 print(msg_lines[2],
            d.x0+3,d.y0+9,10)
 print(msg_lines[3],
            d.x0+3,d.y0+15,10)
 if(t()%1 > 0.5)then
  circfill(d.x1-1,d.y1-1,4,2)
  print("é",d.x1-4,d.y1-3,10)
 end
end

function draw_msg_sp
               (sp,w,h,sc,pos)
 local sx = sp%16 * 8
 local sy = flr(sp/16)*8
 local sw = w * 8
 local sh = h * 8
 
 local w = pos_to_world(pos)
 local dx = w[1]-4*sc+8
 local dy = w[2]-4*sc+8
 local dw = 8*sc
 local dh = 8*sc
 sspr(sx,sy,sw,sh,dx,dy,dw,dh)
end

function draw_msg_pos(pos)
 local w = pos_to_world(pos)
 local k = pos_to_key(pos)
 if(all_spaces[k] == nil)
 then return end
 local s = all_spaces[k].sprite
 pal(7, all_spaces[k].bg)
 draw_msg_sp(41,2,2,(cos(t())/4
                    +2)*2,pos)
 pal()
 draw_msg_sp(s,1,1,(cos(t())/4
                      +2),pos)
end
