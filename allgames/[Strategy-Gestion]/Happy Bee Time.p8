-- gameplay

function _init()
 --[[
 queue_msg(
 "move|buy hives|open |close",
 "îÉ|on trees |tile |message",
 "ãë|è10ó   |è1ó|é"
 )  
 --]]
 queue_msg(
 "welcome to happy bee time!",
 "move with îÉãë",
 "see next message with é(z)"
 )
 queue_msg(
 "your bees can explore tiles",
 "on their own,but you can also",
 "buy tiles with ó for è1"
 )
 queue_msg(
 "how many bees is too many",
 "bees?",
 ""
 )
 queue_msg(
 "no such thing",
 "",
 ""
 )
 queue_msg(
 "good luck!","",""
 )
 
 new_space({0,0},beehive,
                nil,true)
 new_space({1,-1},flower,
                nil,true)
 new_space({-1,-1},flower,
                nil,true)
 new_space({0,1},flower,
                nil,true)
 campos = {0,0}
end

function _draw()
 cls(4)
 offset = {-camworld[1]%24
 +camworld[1]-40,
 -camworld[2]%16
 +camworld[2]-24}
 
 input()	
 map(0,0,
    offset[1],offset[2],
    22,19)
 rend_all_spaces()
 _cam()
 
 rend_all_bees()
 --print(debug, 8)
 
 --print(debug2, 8)
 
 --print(debug3, 8)
 _draw_honey()
 rend_msg()
end

--[[
function t()
 if(btn(é))then return time()*0
 else
 return time()
 end
end
--]]
function _update()
 
end


function lerp(a, b, percent)
 local dif = b-a
 dif *= percent
 dif /= 100
 return a+dif
end

function lerp2d(a, b, percent)
 local dif = {}
 dif[1]=lerp(a[1],b[1],percent)
 dif[2]=lerp(a[2],b[2],percent)
 return dif
end

function pos_to_world(p)
 w = {}
 w[1] = p[1] * 12
 w[2] = p[2] * 16 + 
              (p[1] % 2 * 8)
 return w
end

function obj_pos_to_world(p)
 local w = pos_to_world(p)
 w[1] += 4
 w[2] += 4
 return w
end

function cam_pos_to_world(p)
 local w = pos_to_world(p)
 w[1] -= 56
 w[2] -= 56
 return w
end
