all_spaces = {}
test_space = {}

-- spaces
hl_col = 15
grass_col = 10
water_col = 13
curs_col = 6
-- space id's correspond to
-- sprites
space_chance = {}
blank = 1
 space_chance[blank] = 40--40%
flower = 2
 space_chance[flower] = 60--20%
tree = 3
 space_chance[tree] = 75--15%
rock = 4
 space_chance[rock] = 80--5%
water = 5
 space_chance[water] = 100--20%
beehive = 6
-- demolish levels
dem_none = 1
dem_axe = 2
dem_pick = 3
dem_dirt = 4
dem_shovel = 5

testbee = {}

campos = {0,0}
camworld = {-60,-60}

inv = {}
inv.honey = 20

-- bees

all_bees = {}
-- animation frames
bee_anim = {16,17,18,19}

-- camera
cam_t = 0
cam_zoom = 1
cam_target_zoom = 1

-- controls
x_down = false

-- honey costs
cost = {}
cost.explore = 1
cost.beehive = 10

events = {}
events.revealed = {}


