-- events

function event_tree(pos)
 queue_msg(
"you can build beehives on",
"trees for 10è using ó. they",
"can't be next to other hives" 
 )
 test_scale = t()
 msg_sp = pos
 campos = {pos[1],pos[2]}
end

function event_rock(pos)
 
 queue_msg(
"this is a rock. you will need",
"to find a way to break it",
"if you want to build here."
 )
 
 test_scale = t()
 msg_sp = pos
 campos = {pos[1],pos[2]}
end

function event_beehive(pos)
 queue_msg(
"congrats! now you have a new",
"bee to help you gather honey.",
"build these next to flowers."
 )
 
 test_scale = t()
 msg_sp = pos
 campos = {pos[1],pos[2]}
end
