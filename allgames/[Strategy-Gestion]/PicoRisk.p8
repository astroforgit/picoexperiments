cartdata("picorisk_savetype_0")

max_units = 999 -- changing this will mess up save/load
function save_c()
  for i,v in pairs(c) do
    for j,w in pairs(v) do
      dset(w.index,(w.owner or 0)*1000+(w.units or 0))
      --printh("save "..w.name..":"..dget(w.index),"debug.txt")
    end
  end
end

function load_c()
  for i,v in pairs(c) do
    for j,w in pairs(v) do
      w.units = dget(w.index)%1000
      w.owner = (dget(w.index)-w.units)/1000
      --printh("load "..w.name..":"..dget(w.index).."::"..w.owner.."|"..w.units,"debug.txt")
      if w.units == 0 then
        w.units = nil
      end
      if w.owner == 0 then
        w.owner = nil
      end
    end
  end
end

c.na.aa.c = {c.as.k,c.na.n,nil,c.na.ab}
