current = c.na.aa

function roll_dice()
  dice = {}
  for i = 1,5 do
    add(dice,flr(rnd(6))+1)
  end
  dice.ticks = 15
end

function dice_face(n,x,y)
  -- center dot
  if n == 1 or n == 3 or n == 5 then
    rectfill(x+7,y+7,x+8,y+8)
  end
  -- upper left and lower right
  if n == 2 or n == 3 or n == 4 or n == 6 then
    rectfill(x+4,y+4,x+5,y+5)
    rectfill(x+10,y+10,x+11,y+11)
  end
  -- lower left and upper right
  if n == 4 or n == 5 or n == 6 then
    rectfill(x+10,y+4,x+11,y+5)
    rectfill(x+4,y+10,x+5,y+11)
  end
  -- top mid and bottom mid
  if n == 6 then
    rectfill(x+7,y+4,x+8,y+5)
    rectfill(x+7,y+10,x+8,y+11)
  end
end

function flood_fill(x,y,c,sc)
  sc=sc or 15
  if pget(x,y)==sc then
    pset(x,y,c)
    flood_fill(x-1,y,c,sc)
    flood_fill(x+1,y,c,sc)
    flood_fill(x,y-1,c,sc)
    flood_fill(x,y+1,c,sc)
  end
end

player_colors = {0,12,11,14,8,10}
player_colors_alt = {5,1,3,2,4,9}

function _draw()
  cls()
  spr(0,0,0,16,16)
  for _,continent in pairs(c) do
    for _,country in pairs(continent) do
      if country == current and ticks%15 > 7 then
        flood_fill(country.x,country.y,
          country.owner and player_colors_alt[country.owner] or 7)
      elseif country.x and country.y and country.owner then
        flood_fill(country.x,country.y,player_colors[country.owner])
      end
      if country.units and country.units > 1 then
        sspr(-5+4*min(9,country.units),84,5,5,country.x-3,country.y-3)
      end
    end
  end
  color(15)
  rectfill(3,84,35,88)
  rectfill(16,96+8,16+32,96+8+16)
  color(6)
  cursor((128-#current.name*4)/2+1,86)
  print(current.name)
  color(0)
  cursor((128-#current.name*4)/2,85)
  print(current.name)
  cursor(18,98)
  color(mode_owner and 11 or 0)
  print("Ž+‹/‘ owner ("..(current.owner or "none")..")")
  print("Ž+”/ƒ clear")
  color(mode_unit and 11 or 0)
  print("—+‹/‘ units+1 ("..(current.units or "none")..")")
  print("—+”/ƒ units+5")
  if dice then
    color(11)
    rect(23,23,105,81)
    color(3)
    rectfill(24,24,104,80)--64+16)
    local show_dice = dice
    if dice.ticks > 0 then
      show_dice = {}
      for i = 1,5 do
        show_dice[i] = flr(rnd(6))+1
      end
    end
    spr(210,32,32,2,2)
    spr(210,56,32,2,2)
    spr(210,80,32,2,2)
    spr(212,40,56,2,2)
    spr(212,72,56,2,2)
    color(0)
    dice_face(show_dice[1],32,32)
    dice_face(show_dice[2],56,32)
    dice_face(show_dice[3],80,32)
    dice_face(show_dice[4],40,56)
    dice_face(show_dice[5],72,56)
  end
  color(7)
end

ticks = 0

menuitem(1,"roll dice",roll_dice)
menuitem(2,"setup new game",function()
  local owners = {}
  -- 6*7=42 countries
  for i = 1,7 do
    for j = 1,6 do
      add(owners,j)
    end
  end
  --shuffle
  for i = 1,#owners do
    local swap = flr(rnd(#owners))+1
    owners[i],owners[swap]=owners[swap],owners[i]
  end
  local index = 1
  for _,continent in pairs(c) do
    for _,country in pairs(continent) do
      country.owner = owners[index]
      index+=1
      country.units = 1
    end
  end
end)

menuitem(3,"reset board",function()
  for _,continent in pairs(c) do
    for _,country in pairs(continent) do
      country.owner = nil
      country.units = nil
    end
  end
end)

menuitem(4,"save map",save_c)
menuitem(5,"load map",load_c)

function _update()
  if dice then
    dice.ticks -= 1
  end
  ticks+=1
  mode_unit,mode_owner = nil,nil
  if btn(4) and btn(5) then
    roll_dice()
  elseif btn(4) then
    mode_owner = true
    if dice and dice.ticks < 0 then
      dice = nil
    end
  elseif btn(5) then
    mode_unit = true
    if dice and dice.ticks < 0 then
      dice = nil
    end
  end
  if mode_owner then
    if btnp(0) then
      current.owner = (current.owner or 0) - 1
      if current.owner == 0 then
        current.owner = nil
        current.units = nil
      elseif current.owner == -1 then
        current.owner = 6
        current.units = current.units or 1
      end
    elseif btnp(1) then
      current.owner = (current.owner or 0) + 1
      current.units = current.units or 1
      if current.owner > 6 then
        current.owner = nil
        current.units = nil
      end
    elseif btnp(2) or btnp(3) then
      current.owner = nil
      current.units = nil
    end
  elseif mode_unit then
    if btnp(0) then
      current.units = (current.units or 0) - 1
      if current.units < 1 then
        current.units = nil
        current.owner = nil
      end
    elseif btnp(1) then
      current.units = min(max_units,(current.units or 0) + 1)
      current.owner = current.owner or flr(rnd(6))+1
    elseif btnp(2) then
      current.owner = current.owner or flr(rnd(6))+1
      current.units = min(max_units,(current.units or 0) + 5)
    elseif btnp(3) then
      current.units = (current.units or 0) - 5
      if current.units < 1 then
        current.units = nil
        current.owner = nil
      end
    end
  else
    for i = 1,4 do
      if btnp(i-1) and current.c[i] then
        current = current.c[i]
      end
    end
  end
end

load_c()
