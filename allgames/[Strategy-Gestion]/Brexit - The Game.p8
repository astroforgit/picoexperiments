__lua__
--brexit: the game
--by albert lahat

function _init()
	sfx(2,1)
	tick=0
	splashscreen={
	'',
	''
	}
	mode='splashscreen'
	pause=false
end


game_mode={splashscreen={},
											game={}}
game_mode.game.update=function()
	pm.update()
	missions.update()
	camera_.update()
	effects.update()
end
game_mode.game.drw=function()
	cls()
	map(0,0,0,0,128,128)
	camera_.drw()
	borders.drw()
	cities.drw()
	pm.drw()
	missions.drw()
	hud.drw()
	effects.drw()
	camera_.show_message()
	if debug!=nil then 
		pprint(debug,camera_.x,camera_.y+64,7)
	end
end
game_mode.game.init=function()
	effects.effects.eu_stars.t=1
	sfx(2,1)
	missions.init()
	pm.init()
	camera_.init()
	hud.init()
	mode=	'game'
	tick=0
	camera_.make_message("referendum done.\nmake a brexit deal\nbefore deadline")
end
game_mode.splashscreen.update=function()
	if btn(0) or btn (1) or btn(2) or btn(3) then
		game_mode.game.init()
	end
end
game_mode.splashscreen.drw=function()
	cls()
	camera(0,0)
	txt_to_pic(splashscreen[flr((tick/10)%2+1)])
	if (tick/15)%2<1 then
		pprint('press any key\n for brexit',
	40,
	69,10)
	end
	if	prev_record!=nil then
		pprint('you accomplished\nbrexit by '..prev_record,32,16+4*sin(tick/20),(tick/20)%14+1)
	end
end
function _update()
	if btn(5) and pause then
			pause=false
	end
	if not pause then
		game_mode[mode].update()
		tick+=1
	end
end
function _draw()
	game_mode[mode].drw()
end
