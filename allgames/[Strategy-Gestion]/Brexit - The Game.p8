--camera
camera_={}
camera_.init=function()
	camera_.x=344-64
	camera_.y=300
	camera_.border=10
	camera_.shake=0
	camera_.message_time=0
	camera_.message=''
end									
									
camera_.update=function()
	if btn(5) then
		camera_.message_time=false
	end
	local dx=camera_.x-pm.x+64
	local dy=camera_.y-pm.y+64
	if abs(dx)>camera_.border then
		camera_.x-=dx/10
	end
	if abs(dy)>camera_.border then
		camera_.y-=dy/10
	end
	if camera_.shake>0 then 
		camera_.shake-=1/30
		camera_.x+=rnd(3)-1
		camera_.y+=rnd(3)-1
	end
end
camera_.drw=function()
	camera(camera_.x,camera_.y)
end

camera_.make_message=function(txt,t)
	if t==nil then t=2 end
	camera_.message_time=true
	camera_.message=txt..'\n\n   press (—)'
end

camera_.show_message=function()
	if camera_.message_time then
		pprint(camera_.message,
					camera_.x+32,
					camera_.y+50,8)	
		pause=true
	end
end
