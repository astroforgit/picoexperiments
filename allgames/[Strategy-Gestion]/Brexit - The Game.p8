cities.drw=function()
	cities.drw_roads()
	cities.drw_markers()
	cities.drw_names()
end
cities.drw_names=function()
	for city,xy in pairs(cities.cities) do
		for i=-1,1 do for j=-1,1 do
		print(city,xy[1]+i,xy[2]+j-xy[3]-3,0)
		end end
		print(city,xy[1],xy[2]-xy[3]-3,10)
	end
end
cities.drw_roads=function()
	for connection in all(cities.connections) do
		local a=cities.cities[connection[1]]
		local b=cities.cities[connection[2]]
		for i=-1,1 do for j=-1,1 do
			line(a[1]+i,a[2]+j,
								b[1]+i,b[2]+j,0)
		end end
	end
end
cities.drw_markers=function()
	for city,xy in pairs(cities.cities) do

		circfill(xy[1],xy[2],xy[3],7)
		circ(xy[1],xy[2],xy[3],0)
	end
 for monument in all(monuments) do
		if monument.alt != nil then
			for a in all(monument.alt) do
				pal(a[1],a[2])
			end
		end
		_reset_transparency()
		palt(monument.t,true)
		spr(monument.s,
						monument.x,
						monument.y,
						monument.w,
						monument.h)
		palt()
		pal()
	end
end
