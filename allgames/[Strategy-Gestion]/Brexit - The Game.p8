--missions
missions={}
missions.init=function ()
	missions.time_left=12
	missions.completion=0
	missions.missions={}
	missions.extension_n=1
	missions.extension={
		"  an extension,\n  you'll finish \n   this soon",
		"  brussels gives\nyou another extension\nbetter wrap this up\nquick",
		"  another one?",
		"do you schedule\nextension requests?",
		"    extension, \n as is tradition",
		"    when did \n   this began?",
		"cat wants to get out\nthe door has been opened\nthe cat just sits there\n\nthe british haiku", 	
		" last extension!",
		"   last last\n   extension!",
		"    are you\n   still here?",
		"the eu is now\npart of the\ninterstellar federation\nuk is still here",
		"'brexit' is now\nthe most used word\nin english",
		"the brexit extension\nis an ancient tradition\nwith unknown origin",
		}
	ode_to_joy=5
	overture=2
	scott=6
	france=7
	missions.missions={
		{desc='go to belfast\nto negociate a\nbackstop',	
			obj='belfast',t=1},
		{desc='negociate new \ndeal with\nbrussels',
			obj='brussels',t=1,tune=ode_to_joy},
		{desc='stop a scottish \nreferendum',
			obj='edinburgh',t=1,tune=6},
		{desc='stop immigrants \nin dover',
			obj='dover',t=1},
		{desc='debte the\neu parliament',
			obj='brussels',t=1,tune=ode_to_joy},
		{desc='shake hands\nwith diplomats\nin london',
			obj='london',t=1},
		{desc='wwii ceremony \nin dunkirk',
			obj='dunkirk',t=1,tune=france},
		{desc='console workers\nhurt by brexit\nin newcastle',
			obj='newcastle',t=1},
		{desc='ignore welsh eu\nfarm subsidies \nin cardiff',
			obj='cardiff',t=1},
		{desc='vacation in\namsterdam\nbefore its\ntoo late',
			obj='amsterdam',t=1},
		{desc='climb the\neiffel tower\nvisa free',
			obj='paris',t=1,tune=france},
		{desc='have a croissant\nbefore tariffs\nin calais',
			obj='calais',t=1,tune=france},
		{desc='go to hamburg\nto see where\nour scientist\nare escaping to',
			obj='hamburg',t=1},
		{desc='check conjestion\nfrom imports\nin portsmouth',
			obj='portsmouth',t=1},
		{desc='renew driving\nlicense at dvla\nswansea',
			obj='swansea',t=1},
		{desc="close nhs \nhospitals in \nbirmingham \n(ignore that\nred bus)",
			obj='birmingham',t=1},
		{desc="steal france's\nwifi password\nfrom calais",
			obj='calais',t=1,tune=france},
		{desc="brown nose\nmike pence\nat trump resort\naberdeen",
			obj='aberdeen',t=1},
		{desc="pretend this\nisn't happening\nin durham",
			obj="durham",t=1},
		{desc="learn european\nlaw in cambridge",
			obj="cambridge",t=1},
			}
	missions.total=#missions.missions
	missions.to_d0=missions.missions
	n=ceil(rnd(#missions.missions))
	missions.curr=missions.to_d0[n]
	missions.curr.n=n
	missions.curr.orig_time=missions.curr.t
	del(missions.to_d0,missions.to_d0[n])
end
missions.drw=function()
	local x = cities.cities[missions.curr.obj][1]
	local y = cities.cities[missions.curr.obj][2]
	local s = cities.cities[missions.curr.obj][3]
 s*=sin(tick/40)+1
	circfill(x,y,s,8)
	circ(x,y,s,0)
	cities.drw_names()
	--print rescription
	local x = camera_.x
	local y = camera_.y
	pprint(missions.curr.desc,
		x+64,y+2,9)
	--print mission progression bar
	local obj_x=cities.cities[missions.curr.obj][1]
	local obj_y=cities.cities[missions.curr.obj][2]
	
	if missions.curr.t!=missions.curr.orig_time then
		rectfill(obj_x-8,obj_y+8,
							obj_x-8-32*((missions.curr.t-missions.curr.orig_time)/missions.curr.orig_time),
							obj_y+8+6,
							11)
	
		rect(obj_x-8,obj_y+8,
							obj_x-8+32,obj_y+8+6,0)
	end
	--print brexit completion
	rectfill(
		x+16,y+119,
		x+16+96*(missions.completion/missions.total),
		y+124,11
		)
	rect(x+16,y+119,x+128-16,y+124,0)
	rect(x+17,y+120,x+128-17,y+123,7)
	--show time
	pprint(flr(missions.time_left)..' months till brexit',x+16,y+112)
	--show direction
	local x1=pm.x
	local y1=pm.y
	local obj=missions.curr.obj
	local x2=cities.cities[obj][1]
	local y2=cities.cities[obj][2]
	local dx=x1-x2
	local dy=y1-y2
	local d=sqrt((dx/1000)^2+(dy/1000)^2)*1000
	local m1=20
	local m2=30
	dx/=d
	dy/=d
	if d>64 then
		for i=-1,1 do for j=-1,1 do
			line(x1+i-m1*dx,y1+j-m1*dy,
								x1+i-m2*dx,y1+j-m2*dy,
								0)
		end end
		line(x1-m1*dx,y1-m1*dy,
							x1-m2*dx,y1-m2*dy,
							15)
	end
end
missions.quest_completed= function()
	missions.completion+=1
	if missions.completion==missions.total then
 	 missions.game_finished()
	else
		camera_.shake=1
		local tune=2
		if missions.curr.tune!=nil then
			tune=missions.curr.tune
		end
		sfx(missions.curr.tune)
		n=ceil(rnd(#missions.missions))
		missions.curr=missions.to_d0[n]
		missions.curr.n=n
		missions.curr.t=1
		missions.curr.orig_time=missions.curr.t
		del(missions.to_d0,missions.to_d0[n])
	end	
end
missions.update=function()
	missions.time_left-=1/(30*3)
	if missions.time_left<0 then
		missions.brexit_extention()
		hud.year+=1
		hud.new_pm()
	end
	if missions.curr.t<0 then
		missions.quest_completed()
	end
	local obj_x=cities.cities[missions.curr.obj][1]
	local obj_y=cities.cities[missions.curr.obj][2]
	local obj_s=cities.cities[missions.curr.obj][3]
	local x=pm.x
	local y=pm.y
	local dx=obj_x-x
	local dy=obj_y-y
	local obj_dist=1000
	if abs(dy)<120 and abs(dx)<120 then
		obj_dist=sqrt((dx)^2+(dy)^2)-16
	end
	if obj_dist<0 then
		sfx(3)
		missions.curr.t-=1/30
	end
end

missions.brexit_extention=function()
	missions.time_left=12
	local n = missions.extension_n
	if missions.extension_n>#missions.extension then
		n=ceil(#missions.extension)
	end
	local msg=missions.extension[n]
	camera_.make_message(msg,4)
	effects.effects.eu_stars.t=1
	missions.extension_n+=1
	sfx(5)
end

missions.game_finished=function()
		prev_record=hud.year
		_init()
end
-->8
--functions+ effects
function pprint(str,x,y,c)
	if c==nil then c=7 end
	for i=-1,1 do for j=-1,1 do
		print(str,x+i,y+j,0)
	end end
	print(str,x,y,c)
end
function _reset_transparency()
	for i=0,15 do palt(i,false) end
end
effects={}
effects.effects={}
effects.effects.eu_stars={t=2}
effects.effects.eu_stars.drw=function()
	local x=camera_.x+64
	local y=camera_.y+64
	local s=effects.effects.eu_stars.t
	if s>1 then s=1 end
	local r=30
	circfill(x,y,r*s+3,1)
	circ(x,y,r*s+3,0)
	for n=0,12 do 
		print('’',
			x+s*r*sin(n/12+tick/300)-3,
			y+s*r*cos(n/12+tick/300)-2,
			10)
	end
end
effects.update=function()
	for name,effect in pairs(effects.effects) do
		if effect.t>0 then effect.t-=1/30 end
	end
end
effects.drw=function()
	for name,effect in pairs(effects.effects) do
		if effect.t>0 then effect.drw() end
	end
end
function txt_to_pic(txt)
 local d={
 a=10,
 b=11,
 c=12,
 d=13,
 e=14,
 f=15
 }
 d['0']=0
 d['1']=1
 d['2']=2
 d['3']=3
 d['4']=4
 d['5']=5
 d['6']=6
 d['7']=7
 d['8']=8
 d['9']=9
	local x=0
	local y=0
	for i=0,#txt do
		if x>128 then 
			x=0
			y+=1
		end
 c=d[sub(txt,i,i)]
 pset(x,y,c)
 x+=1
	end
end
-->8
--other hud
hud={}
hud.init=function()
	hud.year=2016
	hud.pm=1
	hud.xdev=0
	hud.ydev=0
	hud.pms={
		{s=24,b=11,
											motto='david done\nus like\nthat one\npig',inv=true},
		{s=26,b=2,
							motto='the may\nor may\nnot be',inv=true},
		{s=28,b=1,
									motto="not a good\nstart boris",inv=true},				
		{s=28,b=1,
									motto="bojo's \nbizzare \nadventures",inv=true},				
		{s=14,b=7,
									motto="it'll be a\ns**t-show",inv=true}				
		}
end
hud.drw = function()
	local x=camera_.x
	local y=camera_.y
	x+=1
	y+=1
	_reset_transparency()
	rectfill(x,y,x+16,y+16,hud.pms[hud.pm].b)
	spr(hud.pms[hud.pm].s,
					x+hud.xdev,y+hud.xdev,2,2,hud.pms[hud.pm].inv)
	if rnd(20)<1 then	hud.xdev+=rnd(3)-1	end
	if rnd(20)<1 then	hud.ydev+=rnd(3)-1	end
	if rnd(20)<1 then	hud.pms[hud.pm].inv=not hud.pms[hud.pm].inv	end
	if abs(hud.xdev)>1.2 then hud.xdev=1 end
	if abs(hud.ydev)>1.2 then hud.ydev=1 end
	rect(x-1,y-1,x+17,y+17,0)
	rect(x,y,x+16,y+16,0)
	pprint(hud.pms[hud.pm].motto,x+19,y+1,12)
	pprint(hud.year,x+1,y+16,10)
end
hud.new_pm=function()
	if hud.pm<#hud.pms then
		hud.pm+=1
	else
		hud.year+=(hud.year-2019)
	end
end
