--pm
pm={}
pm.init=function()
	pm.x=344
	pm.y=364
	pm.angle=1
	pm.v=0
	pm.vmax=3
	pm.acc=0.2
	pm.dec=1
	pm.turn=0.01
	pm.terrain='land'
	pm.sfx_=0
	end
pm.update=function()
	if btn(2) then sfx(pm.sfx_) end
	if btn(2) and pm.v<pm.vmax then pm.v+=pm.acc 
	elseif pm.v<0.5 then pm.v=0 
	else pm.v-=pm.dec end

	if btn(3) then sfx(pm.sfx_) end
	if btn(3) and pm.v>-pm.vmax/2 then pm.v-=2  end
		
	if btn(0) then pm.angle+=pm.turn end
	if btn(1) then pm.angle-=pm.turn end
	pm.x+=pm.v*cos(pm.angle)	
	pm.y+=pm.v*sin(pm.angle)	
	if pm.x<0 then pm.x=0 end
	if pm.y<0 then pm.y=0 end
	if pm.x>1024 then pm.x=1024 end
	if pm.y>512 then pm.y=512 end
 if fget(mget(pm.x/8,pm.y/8),0) then 
 	pm.terrain='water'
 	pm.sfx_=4
 else pm.terrain='land'
					 pm.sfx_=0
  end
end				

pm.drw=function()
  local r=flr(pm.angle*50)/50
  local s=sin(r)
  local c=cos(r)
  local b=s*s+c*c
  local v
  if pm.terrain=='land' then
	  v=0
	 end
	 if pm.terrain=='water' then
	 	v=16
	 end
  for y=-5,5 do for x=-5,5 do
    local ox=( s*y+c*x)/b
    local oy=(-s*x+c*y)/b
    local col=sget(ox+4,oy+4+v)
    if col>0 then 
      pset(pm.x+x+1,pm.y+y+2,0)
      pset(pm.x+x,pm.y+y,col)
    end
  end end
end

