borders.drw=function()
	local c=1
	for name,border in pairs(borders.lines) do
		for i=1,#border-1 do
			for j=-1,1 do for k =-1,1 do
				line(border[i][1]+j,
									border[i][2]+k,
									border[i+1][1]+j,
									border[i+1][2]+k,
									0)
				end end
		end
	end
	for name,border in pairs(borders.lines) do
		for i=1,#border-1 do
				line(border[i][1],
									border[i][2],
									border[i+1][1],
									border[i+1][2],
									c)
		end
	c+=1
	c=c%12+2
	end
end
