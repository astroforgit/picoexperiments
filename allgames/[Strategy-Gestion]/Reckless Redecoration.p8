pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- reckless redecoration
-- by qbicfeet, for ld37
function _init()
	-- essentials
	tt = -1
	palt(0, false)
	palt(15, true)

	-- state
	state = "title"
	substate = ""
	client = "smokey"

	-- etc
	floor_colors = { 15, 14, 1, 6, 3, 2 }
	wall_colors = { 4, 2, 3, 5, 1, 1 }
	color_index = flr(rnd(6)) + 1

	-- cursor and props
	cursor_x = 4
	cursor_y = 4
	cursor_ox = 0
	cursor_oy = 0
	props = {}

	-- active prop
	active_prop = nil
	infobox_flip_x = 0
	infobox_flip_y = 0

	-- catalog
	catalog = {}
	select_x = 1
	select_y = 1
	local styles = {
		{ 8, 2, 7, 6, 13, name = "crimson" },
		{ 11, 3, 7, 6, 13, name = "lime" },
		{ 9, 4, 7, 6, 13, name = "citric" },
		{ 12, 3, 7, 7, 6, name = "cozy" },
		{ 1, 0, 13, 5, 1, name = "obsidian" } }
	add(catalog, new_catalog_item(2, 1, 0, 0, 12, 0, styles, "bed", "humans sleep in\nthese"))
	-- "1234567890123456"
	-- "comes with an\n"
	-- "optional sink"
	styles = {
		{ 14, 8, 15, name = "pink" },
		{ 10, 9, 7, name = "yellow" },
		{ 11, 3, 10, name = "green" },
		{ 9, 4, 7, name = "caramel" },
		{ 6, 13, 7, name = "ashen" } }
	add(catalog, new_catalog_item(1, 1, 0, 12, 12, 0, styles, "cushion", "because chairs\nare hard to draw"))
	styles = {
	 	{ 4, 2, 3, 6, 3, 6, name = "diamond" },
		{ 4, 2, 12, 7, 7, 12, name = "chess" },
		{ 7, 6, 8, 14, 8, 14, name = "rose" },
		{ 15, 9, 3, 10, 8, 9, name = "amigo" } }
	add(catalog, new_catalog_item(2, 2, 24, 0, 24, 0, styles, "table", "witty flavor\ntext"))
	styles = {
		{ 6, 13, 5, 1, name = "grayish" },
		{ 13, 1, 4, 2, name = "brownish" } }
	add(catalog, new_catalog_item(1, 1, 12, 12, 12, 0, styles, "tv set", "state-approved\nmind control"))
	styles = {
		{ 6, 5, 8, 2, 11, 3, 9, 4, name = "dusty" },
		{ 6, 5, 9, 4, 8, 2, 11, 3, name = "dustier" },
		{ 15, 4,  8, 2, 11, 3, 9, 4, name = "wooden" },
		{ 7, 6, 8, 2, 2, 8, 2, 8, name = "pearl" } }
	add(catalog, new_catalog_item(1, 2, 48, 0, 24, 0, styles, "bookcase", "it cases books,\nduh"))
	styles = {
		{ 7, 6, 13, 0, 0, 1, name = "classic"},
		{ 0, 7, 6, 2, 8, 5, name = "modern"}
	}
	add(catalog, new_catalog_item(1, 1, 60, 0, 12, 0, styles, "stove", "gives food that\nnice crisp"))
	styles = {
		{ 7, 6, 5, 7, 6, 7, 5, name = "double"},
		{ 7, 6, 6, 6, 5, 5, 5, name = "single"}
	}
	add(catalog, new_catalog_item(1, 2, 72, 0, 24, 0, styles, "refrigerator", "not quite as\ncool as ice"))
	styles = {
		{ 7, 6, 13, 6, 6, 13, 6, 7, 7, 7, name = "clean" },
		{ 7, 6, 13, 13, 8, 8, 8, 12, 0, 13, name = "watery" },
		{ 15, 4, 1, 1, 6, 6, 6, 15, 15, 15, name = "beige" },
		{ 15, 4, 1, 4, 4, 1, 4, 12, 13, 2, name = "aquatic" },
	}
	add(catalog, new_catalog_item(1, 1, 60, 12, 12, 0, styles, "counter", "comes with an\noptional sink"))

	-- client introductions
	smokey = {
		intro = "i have to get away from my\ntroubled past... all i need is\nsomeplace to eat and sleep...\n\ncan you fix that for me?"
	}
	jimbo = {
		intro = "eyyyy, friend! you gonna help\nme with a spankin' new flat\nfor my wife and kids, right?\n\nbadda bing badda boom. gotcha?"
	}

	-- appraisal
	app_sx = 0
	app_sy = 0
	app_col = 0
	app_c1 = false
	app_c2 = false
	app_c3 = false
	app_c4 = false
	app_str1 = ""
	app_str2 = ""
	app_str3 = ""
	app_str4 = ""
	app_total_amount = 0

	-- temp
end

function _update60()
	tt += 1

	-- infinite code spaghetti machine
	if state == "title" then
		-- title screen
		if btnp(4) then
			state = "introducing"
			substate = "jimbo"
			tt2 = tt

		-- temp
		elseif btnp(5) then
			state = "introducing"
			substate = "smokey"
			tt2 = tt
		end

	elseif state == "introducing" then
		-- client introduction
		if btnp(4) then
			state = "decorating"
			substate = "viewing"
		end

	elseif state == "decorating" then
		-- while decorating room

		if substate == "viewing" then
			-- while not holding or buying
			-- update cursor
			prev_cursor_x = cursor_x
			prev_cursor_y = cursor_y
			if (btnp(0)) cursor_x -= 1
			if (btnp(1)) cursor_x += 1
			if (btnp(2)) cursor_y -= 1
			if (btnp(3)) cursor_y += 1
			cursor_x = min(max(cursor_x, 0), 8)
			cursor_y = min(max(cursor_y, 0), 8)
			-- update active prop
			if cursor_x != last_cursor_x or cursor_y != last_cursor_y then
				active_prop = nil
				for p in all(props) do
					if cursor_check(cursor_x, cursor_y, p.x, p.y, p.w, p.h) then
						active_prop = p
					end
				end
			end
			-- button press
			if btnp(4) then
				if not active_prop then
					substate = "shopping"
				else
					cursor_ox = cursor_x - active_prop.x
					cursor_oy = cursor_y - active_prop.y
					del(props, active_prop)
					substate = "holding"
				end
			elseif btnp(5) then
				substate = "ending"
			end

		elseif substate == "holding" then
			-- while holding a prop
			-- update prop position
			if (btnp(0)) active_prop.x -= 1
			if (btnp(1)) active_prop.x += 1
			if (btnp(2)) active_prop.y -= 1
			if (btnp(3)) active_prop.y += 1
			active_prop.x = min(max(active_prop.x, 0), 9 - active_prop.w)
			active_prop.y = min(max(active_prop.y, 1 - active_prop.h), 9 - active_prop.h)
			if (active_prop.w > 1) active_prop.y = min(max(active_prop.y, 0), 9 - active_prop.h)
			-- button press
			if btnp(4) then
				local is_placeable = true
				for y = 0, active_prop.h - 1 do
					for x = 0, active_prop.w - 1 do
						for p in all(props) do
							if cursor_check(active_prop.x + x, active_prop.y + y, p.x, p.y, p.w, p.h) then
								is_placeable = false
								break
								-- play sfx?
							end
						end
					end
				end
				if is_placeable then
					cursor_x = active_prop.x + cursor_ox
					cursor_y = active_prop.y + cursor_oy
					cursor_ox = 0
					cursor_oy = 0
					cursor_x = min(max(cursor_x, 0), 8)
					cursor_y = min(max(cursor_y, 0), 8)
					add(props, active_prop)
					substate = "viewing"
				end
			elseif btnp(5) then
				cursor_x = active_prop.x + cursor_ox
				cursor_y = active_prop.y + cursor_oy
				cursor_ox = 0
				cursor_oy = 0
				cursor_x = min(max(cursor_x, 0), 8)
				cursor_y = min(max(cursor_y, 0), 8)
				active_prop = nil
				substate = "viewing"
			end

		elseif substate == "shopping" then
			-- while browsing the catalog
			if (btnp(0)) select_x -= 1
			if (btnp(1)) select_x += 1
			if (btnp(2)) select_y -= 1 select_x = 1
			if (btnp(3)) select_y += 1 select_x = 1
			select_y = (select_y - 1) % #catalog + 1
			select_x = (select_x - 1) % #catalog[select_y].styles + 1
			-- button press
			if btnp(4) then
				local p = catalog[select_y]
				active_prop = new_prop(cursor_x, cursor_y, p.w, p.h, p.sx, p.sy, p.sh, p.soy, p.styles[select_x], p.name, p.desc)
				active_prop.x = min(max(active_prop.x, 0), 9 - active_prop.w)
				active_prop.y = min(max(active_prop.y, 0), 9 - active_prop.h)
				if (active_prop.w < 2) active_prop.y = min(max(active_prop.y, 1 - active_prop.h), 9 - active_prop.h)
				substate = "holding"
			elseif btnp(5) then
				substate = "viewing"
			end

		elseif substate == "ending" then
			if btnp(4) then
				state = "appraisal"
				appraise()
			elseif btnp(5) then
				substate = "viewing"
				tt2 = tt
			end
		end

		-- update infobox position
		if active_prop then
			if (active_prop.x < 3) infobox_flip_x = true
			if (active_prop.x + active_prop.w >= 7) infobox_flip_x = false
			if (active_prop.y < 3) infobox_flip_y = true
			if (active_prop.y + active_prop.h >= 7) infobox_flip_y = false
		end

	elseif state == "appraisal" then
		if btnp(4) then
			state = "introducing"
			tt2 = tt
		end
	end
end

function _draw()
	cls()

	-- more spaghetti
	if state == "title" then
		-- title screen
		print("\n reckless redecoration", 0, 0, 10)
		print("\n\n\n\n instructions:\n\n listen to your clients' demands\n and give them the room of their\n dreams!\n\n press \142 to continue", 0, 0, 6)

	elseif state == "introducing" then
		-- draw client + background
		palt(15, false)
		palt(12, true)
		local sx, sy, col, col2, str
		if client == "smokey" then
			sx = 0
			sy = 64
			col = 5
			col2 = 13
			str = smokey.intro
		elseif client == "jimbo" then
			sx = 32
			sy = 64
			col = 10
			col2 = 11
			str = jimbo.intro
		end
		for y = 0, 2 do
			for x = 0, 3 do
				circfill(2 + 48 * x, 12 + 48 * y, 48 + sin(abs(tt - tt2 - 0.5) / 192 + (-x + y) / 8) * 16, (x + y) % 2 == 0 and col or col2)
			end
		end
		sspr(sx, sy, 32, 32, 64, 34 - abs(sin(abs(tt - tt2 - 0.5) / 48) * 5), 64, 64)
		palt(15, true)
		palt(12, false)

		-- draw messagebox
		rectfill(0, 93, 127, 127, 0)
		rect(1, 94, 126, 126, 2)
		print(sub(str, 1, abs(tt - tt2) / 2), 3, 96, 6)

	elseif state == "decorating" then
		-- draw "floor" and "walls"
		rectfill(10, 0, 117, 19, wall_colors[color_index])
		rectfill(10, 20, 117, 127, floor_colors[color_index])

		-- draw props
		for p in all(props) do
			for i = 1, #p.style do
				pal(i, p.style[i])
			end
			sspr(p.sx, p.sy, 12 * p.w, p.sh, 12 * p.x + 10, 12 * p.y - p.soy + 20)
			pal()
			palt(0, false)
			palt(15, true)
		end

		if substate == "viewing" then
			-- draw cursor
			local col = 8
			if (tt % 24 < 12) col = 10
			rect(12 * cursor_x + 10, 12 * cursor_y + 20, 12 * cursor_x + 21, 12 * cursor_y + 31, col)

		elseif substate == "holding" then
			-- draw marker
			for y = 0, active_prop.h - 1 do
				for x = 0, active_prop.w - 1 do
					pal(0, 11)
					for p in all(props) do
						if cursor_check(active_prop.x + x, active_prop.y + y, p.x, p.y, p.w, p.h) then
							pal(0, 8)
							break
						end
					end
					sspr(0, 96, 12, 12, 12 * (active_prop.x + x) + 10, 12 * (active_prop.y + y) + 20, 12, 12, tt % 2 < 1)
					pal(0, 0)
				end
			end
			-- draw held prop
			for i = 1, #active_prop.style do
				pal(i, active_prop.style[i])
			end
			sspr(active_prop.sx, active_prop.sy, 12 * active_prop.w, active_prop.sh, 12 * active_prop.x + 10, 12 * active_prop.y - active_prop.soy + 14)
			pal()
			palt(0, false)
			palt(15, true)

		elseif substate == "shopping" then
			-- draw catalog list
			rectfill(0, 0, 80, 6 * #catalog + 4, 0)
			rect(1, 1, 79, 6 * #catalog + 3, 2)
			for i = 1, #catalog do
				local str = " "
				local col = 6
				if (i == select_y) str = "> " col = 10
				print(str..catalog[i].name, 3, 6 * i - 3, col)
			end
			-- draw preview box
			rectfill(96, 12, 127, 43, 0)
			rect(97, 13, 126, 42, 2)
			rectfill(99, 15, 124, 40, 7)
			local p = catalog[select_y]
			for i = 1, #p.styles[select_x] do
				pal(i, p.styles[select_x][i])
			end
			sspr(p.sx, p.sy, 12 * p.w, p.sh, 112 - 6 * p.w, 28 - p.sh / 2)
			pal()
			palt(0, false)
			palt(15, true)
			-- draw adjective
			rectfill(87, 0, 127, 10, 0)
			rect(88, 1, 126, 9, 2)
			print(p.styles[select_x].name, 90, 3, 7)

		elseif substate == "ending" then
			rectfill(23, 46, 104, 81, 0)
			rect(24, 47, 103, 80, 2)
			print("are we done here?\n\n\142 ok\n\151 cancel", 30, 52, 6)
		end

		-- draw active prop info
		if active_prop then
			local str = active_prop.style.name.." "..active_prop.name
			local x, y
			local w = max(4 * #str + 8, 72)
			if (not infobox_flip_x) x = 0
			if (infobox_flip_x) x = 127 - w
			if (not infobox_flip_y) y = 0
			if (infobox_flip_y) y = 99
			rectfill(x, y, x + w, y + 28, 0)
			rect(x + 1, y + 1, x + w - 1, y + 27, 2)
			print(str, x + 3, y + 3, 7)
			print(active_prop.desc, x + 3, y + 15, 13)
		end

	elseif state == "appraisal" then
		-- draw sprite
		palt(15, false)
		palt(12, true)
		rect(91, 1, 126, 36, 2)
		rectfill(93, 3, 124, 34, app_col)
		sspr(app_sx, app_sy, 32, 32, 93, 3)
		palt(15, true)
		palt(12, false)

		-- print judgment
		print(app_str1, 6, 8, app_c1 and 11 or 8)
		print(app_str2, 6, 32, app_c2 and 11 or 8)
		print(app_str3, 6, 56, app_c3 and 11 or 8)
		print(app_str4, 6, 80, app_c4 and 11 or 8)
	end
end

--------

function new_prop(x, y, w, h, sx, sy, sh, soy, style, name, desc)
	return {
		x = x,
		y = y,
		w = w,
		h = h,
		sx = sx,
		sy = sy,
		sh = sh,
		soy = soy,
		style = style,
		name = name,
		desc = desc }
end

function new_catalog_item(w, h, sx, sy, sh, soy, styles, name, desc)
	return {
		w = w,
		h = h,
		sx = sx,
		sy = sy,
		sh = sh,
		soy = soy,
		styles = styles,
		name = name,
		desc = desc,
		amount = 0}
end

function cursor_check(cx, cy, x, y, w, h)
	return cx >= x and cx < x + w and cy >= y and cy < y + h
end

function appraise()
	color_index = flr(rnd(6)) + 1
	app_c1 = false
	app_c2 = false
	app_c3 = false
	app_c4 = false
	-- count all furniture
	for i in all(catalog) do
		for p in all(props) do
			if i.name == p.name then
				i.amount += 1
				app_total_amount += 1
			end
		end
	end
	-- client specific
	if client == "smokey" then
		-- next client
		client = "jimbo"
		-- sprite
		app_sx = 0
		app_sy = 64
		app_col = 4
		-- c1: bed
		if catalog[1].amount >= 1 then
			app_c1 = true
			app_str1 = "my very own bed,\ngreat!"
		else
			app_str1 = "i could use a\nbed, y'know."
		end
		-- c2: foodstuff
		if catalog[6].amount >= 1 and catalog[7].amount >= 1 then
			app_c2 = true
			app_str2 = "i'm going to be\na master chef!"
		else
			app_str2 = "...what am i\nsupposed to eat?"
		end
		-- c3: entertainment
		if catalog[4].amount >= 1 or catalog[5].amount >= 1 then
			app_c3 = true
			app_str3 = "perfect for\nchilling!"
		else
			app_str3 = "really, no\nentertainment?"
		end
		-- c4: too expensive
		if app_total_amount < 12 then
			app_c4 = true
			app_str4 = "just the budget\ni had in mind."
		else
			app_str4 = "i'm not sure i\ncan afford this."
		end
	elseif client == "jimbo" then
		-- next client
		client = "smokey"
		-- sprite
		app_sx = 32
		app_sy = 64
		app_col = 2
		-- c1: at least 3 beds
		if catalog[1].amount >= 3 then
			app_c1 = true
			-- "1234567890123456"
			-- "do i look like"
			-- "i'm poor?"
			app_str1 = "we are gonna\nsleep well here!"
		else
			app_str1 = "i have a family,\ny'know..."
		end
		-- c2: table and four cushions
		if catalog[2].amount >= 4 and catalog[3].amount >= 1 then
			app_c2 = true
			app_str2 = "love the dining\narea!"
		else
			app_str2 = "where are we\ngonna dine, huh?"
		end
		-- c3: pink/white furniture
		local found = false
		for p in all(props) do
			if p.style.name == "rose" or p.style.name == "pearl" then
				found = true
				break
			end
		end
		if found then
			app_c3 = true
			app_str3 = "my wife says she\nloves it!"
		else
			app_str3 = "my wife says she\ndoesn't like it."
		end
		-- c4: lots of furniture
		if app_total_amount >= 16 then
			app_c4 = true
			app_str4 = "oh baby, love me\nsome luxury!"
		else
			app_str4 = "do i look like\ni'm poor?!"
		end
	end

	-- reset catalog count
	for i in all(catalog) do
		i.amount = 0
	end
	app_total_amount = 0
	-- reset everything
	props = {}
	cursor_x = 4
	cursor_y = 4
	cursor_ox = 0
	cursor_oy = 0
	active_prop = nil
	infobox_flip_x = 0
	infobox_flip_y = 0
	select_x = 1
	select_y = 1
end
if(_update60)_update=function()_update60()_update_buttons()_update60()end␀
