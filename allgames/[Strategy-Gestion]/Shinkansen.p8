pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
-- shinkansen 1.3
-- by fuchikoma71

function _init()
 cls()
 trgt=0
 fast_time=1
 slow_time=5
 fast_cost=5
 slow_cost=1
 lid=2
 sales=0
 costs=0
 profit=0
 money=5016
 year=63
 total=0
 biz=0
 solution=false
 while not solution do
  init_s1()
  init_s2()
  init_s3()
 end
 col={}
 col[1]=5
 col[2]=8
 col[3]=3
 col[4]=1
 col[5]=9
 col[6]=2
 col[7]=7
 col[8]=15
 col[9]=11
 col[10]=12
 col[11]=10
 col[12]=14
 open={}
 open[1]=true
 for k=2,6 do
  open[k]=false
 end
 the_end=false
 started=false
 ptrn={}
 for i=0,7 do
  ptrn[i]=flr(rnd()*4)
 end
end

function init_s1()
 solution=false
 while not solution do
  grid={}
  for i=0,7 do
   grid[i]={}
   for j=0,7 do
    grid[i][j]={}
    grid[i][j].hub=false
    grid[i][j].cnx=false
    grid[i][j].empty=true
    grid[i][j].block=false
    grid[i][j].nbase=false
    grid[i][j].nline=0
    grid[i][j].sbase=false
    grid[i][j].sline=0
    grid[i][j].ebase=false
    grid[i][j].eline=0
    grid[i][j].wbase=false
    grid[i][j].wline=0
    grid[i][j].x=i
    grid[i][j].y=j
    grid[i][j].trvl={}
    grid[i][j].trvl["slow"]={}
    grid[i][j].trvl["fast"]={}
    grid[i][j].trk={}
    for k=1,6 do
     grid[i][j].trk[k]=0
    end
   end
  end
  city={}
  for i=1,9 do
   city[i]={}
   city[i].id=i
   ok=false
   while not ok do
    city[i].x=flr(rnd()*8)
    city[i].y=flr(rnd()*8)
    ok=true
    j=1
    while ok and (j<i) do
     dx=city[i].x-city[j].x
     dy=city[i].y-city[j].y
     ok=abs(dx)+abs(dy)>2
     j+=1
    end
   end
   grid[city[i].x][city[i].y].hub=true
  end
  for i=1,#city do
   j=i+1
   if(j>#city) then j=1 end
   x=city[i].x
   y=city[i].y
   grid[x][y].empty=false
   dx=city[j].x-x
   dy=city[j].y-y
   while(x!=city[j].x) do
    if(dx>0) then
     if(grid[x][y].eline==0) then
      grid[x][y].eline=1
      grid[x][y].ebase=true
      grid[x][y].empty=false
      grid[x][y].trk[1]+=1
      grid[x+1][y].wline=1
      grid[x+1][y].wbase=true
      grid[x+1][y].trk[1]+=1
     end
     x+=1
    else
     if(grid[x][y].wline==0) then
      grid[x][y].wline=1
      grid[x][y].wbase=true
      grid[x][y].empty=false
      grid[x][y].trk[1]+=1
      grid[x-1][y].eline=1
      grid[x-1][y].ebase=true
      grid[x-1][y].trk[1]+=1
     end
      x-=1
    end
   end
   while(y!=city[j].y) do
    if(dy>0) then
     if(grid[x][y].sline==0) then
      grid[x][y].sline=1
      grid[x][y].sbase=true
      grid[x][y].empty=false
      grid[x][y].trk[1]+=1
      grid[x][y+1].nline=1
      grid[x][y+1].nbase=true
      grid[x][y+1].trk[1]+=1
     end
     y+=1
    else
     if(grid[x][y].nline==0) then
      grid[x][y].nline=1
      grid[x][y].nbase=true
      grid[x][y].empty=false
      grid[x][y].trk[1]+=1
      grid[x][y-1].sline=1
      grid[x][y-1].sbase=true
      grid[x][y-1].trk[1]+=1
     end
     y-=1
    end
   end
  end
  hubs()
  solution=(#city==16)
 end
end

function init_s2()
 ranges("slow")
 ranges("fast")
 user={}
 for i=2,#city do
  city[i].lvl=1
  j=i+1
  if(j>#city) then
   j=1
  end
  if(i!=j) then
   new_user(i,j)
  end 
 end
 crs={}
 crsx=4
 crsy=4
 newx=4
 newy=4
 path={}
 t=0
end

function init_s3()
 solution=false
 i=0
 j=0
 while not solution and (j*7+i<42) do
  if(grid[i][j].empty) then
   solution=grid[i+1][j].empty and
            grid[i+1][j+1].empty and
            grid[i][j+1].empty
  end
  if solution then
   datx=i
   daty=j
   for i=0,1 do
    for j=0,1 do
     grid[datx+i][daty+j].block=true
    end
   end
  else
   i=(i+1)%6
   if(i==0) then
    j=j+1
   end
  end
 end
end

function new_user(i,j)
 k=#user+1
 user[k]={}
 user[k].one=city[i]
 user[k].two=city[j]
 user[k].x=city[i].x*16
 user[k].y=city[i].y*16
 user[k].hdg="x"
 if(k<=#city) then
  user[k].class="slow"
 else
  user[k].class=user[k-#city].class
 end
 user[k].speed=user[k].class
 user[k].lid=1
end

function ranges(var)
 for i=0,7 do
  for j=0,7 do
   if((grid[i][j].nline>0) and (grid[i][j].sline>0)) and
    ((grid[i][j].eline>0) or (grid[i][j].wline>0)) then
    grid[i][j].cnx=not grid[i][j].hub
   end
  	if((grid[i][j].eline>0) and (grid[i][j].wline>0)) and
    ((grid[i][j].nline>0) or (grid[i][j].sline>0)) then
    grid[i][j].cnx=not grid[i][j].hub
   end
   for k=1,#city do
    grid[i][j].trvl[var][k]=256
   end
  end
 end
 for i=1,#city do
  x=city[i].x
  y=city[i].y
		grid[x][y].trvl[var][i]=0
  shell={}
  add(shell,grid[x][y])
  while(#shell>0) do
   next={}
   while(#shell>0) do
    step=shell[1]
    del(shell,step)
    x=step.x
    y=step.y
    if(step.nline>0) then
     trvl=slow_time
     if(step.nline>1) and (var=="fast") then
      trvl=fast_time
     end
     if(grid[x][y-1].trvl[var][i]>step.trvl[var][i]+trvl) then
      grid[x][y-1].trvl[var][i]=step.trvl[var][i]+trvl
      add(next,grid[x][y-1])
     end
    end
    if(step.sline>0) then
     trvl=slow_time
     if(step.sline>1) and (var=="fast") then
      trvl=fast_time
     end
     if(grid[x][y+1].trvl[var][i]>step.trvl[var][i]+trvl) then
      grid[x][y+1].trvl[var][i]=step.trvl[var][i]+trvl
      add(next,grid[x][y+1])
     end
    end
    if(step.eline>0) then
     trvl=slow_time
     if(step.eline>1) and (var=="fast") then
      trvl=fast_time
     end
     if(grid[x+1][y].trvl[var][i]>step.trvl[var][i]+trvl) then
      grid[x+1][y].trvl[var][i]=step.trvl[var][i]+trvl
      add(next,grid[x+1][y])
     end
    end
    if(step.wline>0) then
     trvl=slow_time
     if(step.wline>1) and (var=="fast") then
      trvl=fast_time
     end
     if(grid[x-1][y].trvl[var][i]>step.trvl[var][i]+trvl) then
      grid[x-1][y].trvl[var][i]=step.trvl[var][i]+trvl     
      add(next,grid[x-1][y])
     end
    end
   end
   while(#next>0) do
    step=next[1]
    add(shell,step)
    del(next,step)
   end
  end
 end
end

function hubs()
 for i=0,7 do
  for j=0,7 do
   if not grid[i][j].hub then
    if((grid[i][j].nline>0) and (grid[i][j].sline>0)) and
    ((grid[i][j].eline>0) or (grid[i][j].wline>0)) then
     grid[i][j].hub=true
    end
   	if((grid[i][j].eline>0) and (grid[i][j].wline>0)) and
    ((grid[i][j].nline>0) or (grid[i][j].sline>0)) then
     grid[i][j].hub=true
    end
    if grid[i][j].hub then
     k=#city+1
     city[k]={}
     city[k].x=i
     city[k].y=j
     city[k].id=k
    end 
   end
  end
 end
end

function interface()
 if not started then
  if btn(4) then
   started=true
   draw_base()
   t=0
  end
 else
  if btnp(0) then
   if not btn(5) then
    newx=max(0,crsx-1)
   else
    if not btn(4)  then
     lid-=1
     if(lid==1) then
      lid=6
     end
    end
   end
  end
  if btnp(1) then
   if not btn(5) then
    newx=min(7,crsx+1)
   else
    if not btn(4) then
     lid+=1
     if(lid==7) then
      lid=2
     end
    end
   end
  end
  if btnp(2) then
   if not btn(5) then
    newy=max(0,crsy-1)
   else
    fast_cost=min(fast_cost+0.1,5)
    ranges("fast")
   end
  end
  if btnp(3) then
   if not btn(5) then
    newy=min(7,crsy+1)
   else
    fast_cost=max(fast_cost-0.1,1)
    ranges("fast")
   end
  end
  if(newx!=crsx) and (newy!=crsy) then
   newy=crsy
  end
  ok=not btn(4) or ((crsx==newx) and (crsy==newy))
  if not ok then
   if(crsx==newx) then
    if(crsy>newy) then
     ok=grid[crsx][crsy].nline<2
    else
     ok=grid[crsx][crsy].sline<2
    end
   else
    if(crsx<newx) then
     ok=grid[crsx][crsy].eline<2
    else
     ok=grid[crsx][crsy].wline<2
    end
   end
  end
  ok=ok and ((#path>0) or (grid[newx][newy].trk[lid]==1) or not open[lid])
  ok=ok and (grid[newx][newy].trk[lid]<2)
  ok=(ok or not btn(4)) and not grid[newx][newy].block
  if ok then
   if(btn(4)) then
    if(newx!=crsx) or (newy!=crsy) or (#path==0) then
     add(path,grid[newx][newy])
    end
    back=false
    i=1
    while(i<#path) do
     back=back or (path[i]==path[#path])
     if(back) then
      del(path,path[i])
     else
      i+=1
     end
    end
   else
    if(#path>1) and (path[1].hub or path[1].cnx)
    and (path[#path].hub or path[#path].cnx)
    and ((#path-1)*1000<=money) then
     open[lid]=true
     i=1
     path[i].trk[lid]+=1
     while(i<#path) do
      path[i].empty=false
      money-=1000
      j=i+1
      if(path[i].x==path[j].x) then
       if(path[i].y>path[j].y) then
        path[i].nline=lid
        path[j].sline=lid
       else
        path[i].sline=lid
        path[j].nline=lid
       end
      else
       if(path[i].x<path[j].x) then
        path[i].eline=lid
        path[j].wline=lid
       else
        path[i].wline=lid
        path[j].eline=lid
       end
      end
      i+=1
      if(i<#path) then
       path[i].trk[lid]+=2
      else
       path[i].trk[lid]+=1
      end
     end
     ranges("fast")
    end    
    while(#path>0) do
     del(path,path[#path]) 
    end
   end  
   crsx=newx
   crsy=newy
  else
   newx=crsx
   newy=crsy
  end
 end
end

function _update()
 if not the_end then
  interface()
 end
 if started then
  if(t==1) then
   if not the_end then
    year=(year+1)%100
    i=(year-63)%(#city+1)
    if(i==0) then
     i=1
    end
    j=i+1
    if(j>#city) then
     j=1
    end
    new_user(i,j)
    if(year<89) then
     sales=0
     costs=0
    else
     the_end=true
    end
   end
  end
  for i=1,#user do
   if(t%slow_time==0) or (user[i].speed=="fast") then
    x=user[i].x
    y=user[i].y
    if(x%16==0) and (y%16==0) then
  		 x=x/16
  		 y=y/16
  		 if(year!=0) then
      costs+=1
      if(money>-32000) then
       money-=1
      end
     end
     if(x==user[i].two.x) and
      (y==user[i].two.y) then
      swap=user[i].one
      user[i].one=user[i].two
      user[i].two=swap
      id=user[i].two.id
      actual=abs(x-user[i].two.x)+abs(y-user[i].two.y)
      cost_ratio=fast_cost/slow_cost
      trvl_ratio=grid[x][y].trvl["slow"][id]/grid[x][y].trvl["fast"][id]
      trvl_ratio*=trvl_ratio
      if(cost_ratio<=trvl_ratio) and (trvl_ratio>1) then
       user[i].class="fast"
       sales+=actual*fast_cost
       money=min(32000,money+actual*fast_cost)
      else
       user[i].class="slow"
      end
     end
     id=user[i].two.id
     var=user[i].class
     trvl_min=grid[x][y].trvl[var][id]
     options={}
     if(grid[x][y].nline>0) then
      if(grid[x][y].nline>1) and (var=="fast") then
       delta=fast_time
      else
       delta=slow_time
      end
      if(grid[x][y-1].trvl[var][id]+delta<=trvl_min) then
       if(var=="fast") or grid[x][y].nbase then
        trvl_min=grid[x][y-1].trvl[var][id]+delta
        add(options,"n")
       end
      end
     end
     if(grid[x][y].sline>0) then
      if(grid[x][y].sline>1) and (var=="fast") then
       delta=fast_time
      else
       delta=slow_time
      end
      if(grid[x][y+1].trvl[var][id]+delta<=trvl_min) then
       if(var=="fast") or grid[x][y].sbase then
        trvl_min=grid[x][y+1].trvl[var][id]+delta
        add(options,"s")    
       end
      end
     end
     if(grid[x][y].eline>0) then
      if(grid[x][y].eline>1) and (var=="fast") then
       delta=fast_time
      else
       delta=slow_time
      end
      if(grid[x+1][y].trvl[var][id]+delta<=trvl_min) then
       if(var=="fast") or grid[x][y].ebase then
        trvl_min=grid[x+1][y].trvl[var][id]+delta
        add(options,"e")
       end
      end
     end
     if(grid[x][y].wline>0) then
      if(grid[x][y].wline>1) and (var=="fast") then
       delta=fast_time
      else
       delta=slow_time
      end
      if(grid[x-1][y].trvl[var][id]+delta<=trvl_min) then
       if(var=="fast") or grid[x][y].wbase then
        trvl_min=grid[x-1][y].trvl[var][id]+delta
        add(options,"w")
       end
      end
     end
     user[i].hdg=options[1]
     user[i].speed="slow"
     user[i].lid=1
     if(#options>1) then
      if(options[2]=="e") and (grid[x][y].eline>1) and (var=="fast") then
       user[i].hdg="e"
      end
      if(options[2]=="w") and (grid[x][y].wline>1) and (var=="fast") then
       user[i].hdg="w"
      end
     end
     if(var=="fast") then
      if(user[i].hdg=="n") and (grid[x][y].nline>1) then
       user[i].speed="fast"
       user[i].lid=grid[x][y].nline
      end
      if(user[i].hdg=="s") and (grid[x][y].sline>1) then
       user[i].speed="fast"
       user[i].lid=grid[x][y].sline
      end
      if(user[i].hdg=="e") and (grid[x][y].eline>1) then
       user[i].speed="fast"
       user[i].lid=grid[x][y].eline
      end
      if(user[i].hdg=="w") and (grid[x][y].wline>1) then
       user[i].speed="fast"
       user[i].lid=grid[x][y].wline
      end
     end
    end
    if(user[i].hdg=="n") then
     user[i].y-=1
     if(t==0) then
      user[i].y-=(i%8)*2
     end
    end
    if(user[i].hdg=="s") then
     user[i].y+=1
     if(t==0) then
      user[i].y+=(i%8)*2
     end
    end
    if(user[i].hdg=="e") then
     user[i].x+=1
     if(t==0) then
      user[i].x+=(i%8)*2
     end
    end
    if(user[i].hdg=="w") then
     user[i].x-=1
     if(t==0) then
      user[i].x-=(i%8)*2
     end
    end
   end
  end
  market()
  if not the_end then
   profit=sales-costs
  end
  t=t+1
  if(t==1001) then
   t=1
  end
 end 
end

function market()
 biz=0
 for i=1,#user do
  if(user[i].speed=="fast") then
   biz+=1
  end
 end
end

function print_data()
 x=datx*16
 y=daty*16
 camera(-x,-y)
 if(year<10) then
  print("0"..year,1,1,8)
 else
  print(year,1,1,8)
 end
 x=24
 y=2
 biz=flr(100*biz/#user)
 if(biz>9) then
  x-=4
  if(biz>99) then
   x-=4
  end
 end
 print(biz.."%",x,y,0)
 x=28
 y=9
 val=abs(flr(profit))
 repeat
  print(val%10,x,y,0)
  val=flr(val/10)
  x-=4
 until(val==0)
 if(profit>0) then
  print("+",x,y,0)
 else
  print("-",x,y,0)
 end
 x=28
 y=16
 val=abs(flr(money))
 repeat
  print(val%10,x,y,0)
  val=flr(val/10)
  x-=4
 until(val==0)
 if(money<0) then
  print("-",x,y)
 end
 print(flr(fast_cost*1000),15,25,0)
end

function draw_base()
 camera(0,0)
 rectfill(0,0,127,127,15)
 for i=0,7 do
  for j=0,7 do
   x=i*16
   y=j*16
   camera(-10,-6)
   if(grid[i][j].nbase) then
    line(x,y,x,y-16,5)
   end
   if(grid[i][j].wbase) then
    line(x,y,x-16,y,5)
   end
   camera(-9,-7)
   if(grid[i][j].sbase) then
    line(x,y,x,y+16,5)
   end
   if(grid[i][j].ebase) then
    line(x,y,x+16,y,5)
   end
  end
 end
 spiral()
 rect(0,0,127,127,12)
 pset(1,1,12)
 pset(126,1,12)
 pset(1,126,12)
 pset(126,126,12)
 for i=0,7 do
  if grid[i][0].empty then
   rectfill(i*16,0,i*16+15,15,12)
   grid[i][0].block=true  
  end
  if grid[7][i].empty then
   rectfill(112,i*16,127,i*16+15,12)
   grid[7][i].block=true
  end
  if grid[i][7].empty then
   rectfill(i*16,112,i*16+15,127,12)
   grid[i][7].block=true
  end
  if grid[0][i].empty then
   rectfill(0,i*16,15,i*16+15,12)
   grid[0][i].block=true
  end
 end
 x=datx*16
 y=daty*16
 camera(-x,-y)
 rectfill(0,0,31,31,10)
 line(0,7,8,7,8)
 line(8,7,10,5,8)
 line(10,5,10,1,8)
 line(10,1,9,0,8)
 for x=1,30 do
  for y=23,30 do
   if((x+y)%3==0) then
    pset(x,y,7)
   else
    pset(x,y,11)
   end
  end
 end
 line(9,24,11,26,0)
 line(11,26,13,24,0)
 line(11,26,11,30,0)
 line(10,27,12,27,0)
 camera(0,0)
 for x=1,126 do
  for y=1,126 do
   land=0
   sea=0
   for dx=-1,1 do
    for dy=-1,1 do
     if(pget(x+dx,y+dy)==15) then
      land+=1
     else
      if(pget(x+dx,y+dy)==12) then
       sea+=1
      end
     end
    end
    if(land+sea==9) then
     if(sea==4) and (pget(x,y)==12) then
      pset(x,y,15)
     end
     if(land==4) and (pget(x,y)==15) then
      pset(x,y,12)
     end
    end
   end
  end
 end
 for x=0,127 do
  for y=0,127 do
   sset(x,y,pget(x,y))
  end
 end
end

function spiral()
 camera(0,0)
 x=3
 y=3
 leg=0
 r=1
 i=0
 j=0
 k=0
 while (x>0) and (x<7) and (y>0) and (y<7) and (k<6) do
  i+=1
  j+=1
  if grid[x][y].empty and not grid[x][y].block then
   sspr(k*16,0,16,16,x*16,y*16)
   grid[x-1][y].empty=false
   grid[x+1][y].empty=false
   grid[x][y-1].empty=false
   grid[x][y+1].empty=false
   grid[x][y].block=true
   k+=1
  else
   if(grid[crsx][crsy].block) then
	   crsx=x
    crsy=y
   end
  end
  if(leg%4==0) then
   x+=1
  else
   if(leg%4==1) then
    y+=1
   else
    if(leg%4==2) then
     x-=1
    else
     y-=1
    end
   end
  end
  if(j==r) then
   leg+=1
   j=0
   if(leg%2==0) then
    r+=1
   end
  end
 end
end

function _draw()
 if started then
  draw_game()
 else
  draw_intro()
 end
end

function draw_intro()
 cls()
 sspr(0,32,128,16,2,8)
 print("by fuchikoma71",36,32,7)
 rectfill(0,48,127,78,12)
 rectfill(0,79,127,95,11)
 line(0,95,127,95,4)
 print("press 'z' to start...",24,112,7)
 for i=0,7 do
  sspr(48,0,16,16,i*16,78,16,16,flr(ptrn[i]%2)==0)
  if(i!=4) then
   sspr(64+flr(ptrn[i]/2)*16,16,16,16,i*16,64,16,16,flr(ptrn[i]%2)==0)
  end 
 end
 sspr(0,0,16,16,64,64)
 if(t>0) and (t%250==0) then
  x=-flr(rnd()*500)
  t=0
  hdg=flr(rnd()*2)
 end
 if(hdg==0) then
  sspr(0,16,32,16,128-x,80,32,16)
  for i=1,7 do
   sspr(32,16,32,16,128+i*32-x,80,32,16)
  end
  sspr(0,16,32,16,384-x,80,32,16,true)
 else
  sspr(0,16,32,16,x,80,32,16,true)
  for i=1,7 do
   sspr(32,16,32,16,x-i*32,80,32,16)
  end
  sspr(0,16,32,16,x-256,80,32,16)
 end
 x+=4
 t+=1
end

function draw_game()
 cls()
 camera(0,0)
 sspr(0,0,128,128,0,0)
 for i=0,7 do
  for j=0,7 do
   x=i*16
   y=j*16
   camera(-6,-10)
   if(grid[i][j].nline>1) then
    line(x,y,x,y-16,col[grid[i][j].nline])
   end
   if(grid[i][j].wline>1) then
    line(x,y,x-16,y,col[grid[i][j].wline])
   end
   camera(-7,-9)
   if(grid[i][j].sline>1) then
    line(x,y,x,y+16,col[grid[i][j].sline])
   end
   if(grid[i][j].eline>1) then
    line(x,y,x+16,y,col[grid[i][j].eline])
   end
  end
 end
 for i=1,#user do
  if(user[i].hdg=="n") or (user[i].hdg=="w") then
   if(user[i].speed=="slow") then
    camera(-10,-6)
   else
    camera(-6,-10)
   end
  else
   if(user[i].speed=="slow") then
    camera(-9,-7)
   else
    camera(-7,-9)
    clr=12
   end
  end
  pset(user[i].x,user[i].y,col[user[i].lid+6])
 end
 camera(-8,-8)
 for i=0,7 do
  for j=0,7 do
   x=i*16
   y=j*16
   if grid[i][j].cnx then
    rectfill(x-2,y-2,x+2,y+2,7)
    rect(x-2,y-2,x+2,y+2,0)      
   end
  end
 end  
 found=nil
 for i=1,#city do
  x=city[i].x*16
  y=city[i].y*16
  if(crsx==city[i].x) and (crsy==city[i].y) and not btn(4) then
   found=city[i]
--   circfill(x,y,5,10)
--	 else
	 end
	 circfill(x,y,5,7)
	 circ(x,y,5,0)
  if(i<10) then
   print(i,x-1,y-2,0)
  else
   print(i,x-3,y-2,0)
  end
 end
 if(found!=nil) then
  i=found.id+1
  if(i>#city) then
   i=1
  end
  x=city[i].x*16
  y=city[i].y*16
  circfill(x,y,5,0)
--  circ(x,y,5,7)
  if(i<10) then
   print(i,x-1,y-2,7)
  else
   print(i,x-3,y-2,7)
  end
  i=found.id-1
  if(i==0) then
   i=#city
  end
  x=city[i].x*16
  y=city[i].y*16
  circfill(x,y,5,0)
--  circ(x,y,5,0)
  if(i<10) then
   print(i,x-1,y-2,7)
  else
   print(i,x-3,y-2,7)
  end
 end 
 for i=1,#path do
  x=path[i].x*16-3
  y=path[i].y*16+1
  if(i>1) then
   x2=path[i-1].x*16-3
   y2=path[i-1].y*16+1
   if((i-1)*1000<=money) then
    line(x+1,y+1,x2+1,y2+1,col[lid])
   else
    line(x+1,y+1,(x*3/4+x2/4)+1,(y*3/4+y2/4)+1,col[lid])
    line((x+x2)/2+1,(y+y2)/2+1,(x/4+x2*3/4)+1,(y/4+y2*3/4)+1,col[lid])
   end
  end  
  circ(x+1,y+1,1,col[lid])
 end
 x=crsx*16
 y=crsy*16
 line(x-5,y-7,x+5,y-7,col[lid])
 line(x-5,y+7,x+5,y+7,col[lid])
 line(x-7,y-5,x-7,y+5,col[lid])
 line(x+7,y-5,x+7,y+5,col[lid])
 pset(x-6,y-6,col[lid])
 pset(x-6,y+6,col[lid])
 pset(x+6,y+6,col[lid])
 pset(x+6,y-6,col[lid])
 x=datx*16
 y=daty*16
 print_data()
end
