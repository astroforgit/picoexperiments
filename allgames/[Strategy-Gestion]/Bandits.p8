pico-8 cartridge // http://www.pico-8.com
version 30
__lua__
-- bandits
-- 2019 lostcadesoft by bgelais
cartdata("bandits_lostcadesoft")

lives=3
score=0


function game_init()
shoot=false
moves=0
pal(2,2+rnd(14))
bombs_init()
bandits_init()
player_init()
amo=1+flr(rnd(#bandits))
state="game"
end

function _init()
high=dget(0)
game_init()
intro_init()
end

function _update60()
if (state=="title") title_update()
if (state=="intro") intro_update()

if state=="game" then
if (dead) dead_update()
if (not shoot and not dead) player_update()
if (shoot) shoot_update()
foreach(bandits,bandits_update)
foreach(ball,ball_update)
foreach(explodes,update_explodes)
end--game state

if (state=="win") win_update()
if (state=="gameover") over_update()
end

function _draw()
cls()
if (state=="title") title_draw()
if (state=="intro") intro_draw()

if state=="game" then
map(0)
foreach(bombs,bombs_draw)
if (not dead) player_draw()
foreach(bandits,bandits_draw)
foreach(ball,ball_draw)
foreach(explodes,draw_explodes)
if (shoot) spr(6,pl.x-4,pl.y-4,2,2)
if dead then
oprint("busted in "..moves..
" moves!",30,64,7+rnd(7)) end
end--game state

if (state=="win") win_draw()
if (state=="gameover") over_draw()

draw_hud()
end



-->8
--player

function player_init()
pl={
x=8+(8*flr(rnd(13)+1)),
y=112,
xsp=0,
ysp=0,
spr=34,
frm=0,
flp=false}
dead=false
end

function player_update()

if (btnp(Ž) and amo!=0) shoot=true moves+=1
if (btnp(‹)) pl.xsp=-1 pl.spr=2 pl.flp=true moves+=1 pl.frm+=1 sfx(0)
if (btnp(‘)) pl.xsp=1 pl.spr=2 pl.flp=false pl.frm+=1 moves+=1 sfx(0) 
if (btnp(”)) pl.ysp=-1 pl.spr=34 pl.flp=false pl.frm+=1 sfx(0) moves+=1
if (btnp(ƒ)) pl.ysp=1 pl.spr=18 pl.flp=false pl.frm+=1 sfx(0) moves+=1 

pl.x+=pl.xsp
pl.y+=pl.ysp
if (pl.x%8==0) pl.xsp=0 
if (pl.y%8==0) pl.ysp=0
 
pl.frm=pl.frm%2
pl.x=mid(0,pl.x,120)
pl.y=mid(24,pl.y,112)

if pl.x>=56 and pl.x<=64 
   and pl.y==24 then 
   win_init() end
   
if bandits_col(pl.x,pl.y) then 
sfx(5)
dead=true
restart=time()+3
lives-=1 end

if bombs_col(pl.x,pl.y) then
explode(pl.x,pl.y)
sfx(5)
restart=time()+3
lives-=1 
dead=true end

end

function player_draw()
spr(pl.spr+pl.frm,pl.x,pl.y,1,1,pl.flp)
end

function shoot_init(_xsp,_ysp)
ball={}
sfx(1)
add (ball,{
x=pl.x,
y=pl.y,
xsp=_xsp,
ysp=_ysp})
amo-=1
shoot=false
end

function shoot_update()
if (btnp(‹)) shoot_init(-2,0) 
if (btnp(‘)) shoot_init(2,0) 
if (btnp(”)) shoot_init(0,-2)
if (btnp(ƒ)) shoot_init(0,2)
end

function ball_update(o)
o.x+=o.xsp
o.y+=o.ysp

if (o.x<0 or o.x>128) del(ball,o)
if (o.y<24 or o.y>112) del(ball,o)

for i in all(bandits) do
	if o.x+4==i.x+4	
	and o.y+4==i.y+4 then
	sfx(3)
	score+=5
	del(bandits,i)
	del(ball,o) end   
end

end

function ball_draw(o)
pset(o.x+4,o.y+4,7)
end

function dead_update()
	if time()==restart then
		if (lives==0) over_init()
		if (lives!=0) dead=false game_init()
	end
end







-->8
--bandits and bombs

function bandits_init()
bandits={}
for i=1,5+flr(rnd(5)) do
add(bandits,{
x=8*flr(rnd(13)+1),
y=24+(8*flr(rnd(8)+1)),
xsp=0,
ysp=0,
frm=0,
flp=false,
spr=20}) end
end 

function bandits_update(o)

if pl.xsp!=0 or pl.ysp!=0 then
	if (pl.y>o.y) o.ysp=1 o.spr=20 sfx(0) 
	if (pl.y<o.y) o.ysp=-1 o.spr=36 sfx(0)
	if (pl.x>o.x and pl.xsp!=0) o.xsp=1 o.spr=4 o.flp=false sfx(0)
	if (pl.x<o.x and pl.xsp!=0) o.xsp=-1 o.spr=4 o.flp=true sfx(0)
end
	o.x+=o.xsp
	o.y+=o.ysp
	if (o.ysp!=0 or o.xsp!=0) o.frm+=0.2 o.frm=o.frm%2
	if (o.x%8==0) o.xsp=0 
 if (o.y%8==0) o.ysp=0 
	o.x=mid(0,o.x,120)
	o.y=mid(24,o.y,112)
	if bombs_col(o.x,o.y) then
	explode(o.x,o.y)
	score+=15
	del(bandits,o) end

end

function bandits_draw(o)
spr(o.spr+o.frm,o.x,o.y,1,1,o.flp)
end

function bandits_col(x,y)
	for i in all(bandits) do
		if (i.x==x and i.y==y) return true
	end
end

--bombs

function bombs_init()
bombs={}	
f=0
	for b=1,10 do
		b={}
		repeat
		b.x=8*flr(rnd(13)+1)
		b.y=24+(8*flr(rnd(10)+1))
		until not bandits_col(b.x,b.y)	add(bombs,b) 
	end
end

function bombs_draw(o)
spr(16,o.x,o.y)
end

function bombs_col(x,y)
	for o in all(bombs) do
if (o.x==x and o.y==y) del(bombs,o) return true
	end
end

-->8
--explodes / oprint

explodes={}

function explode(_x,_y)
sfx(2)
add(explodes,{
x=_x, 
y=_y,
frame=0
})
end

function update_explodes(o)
o.frame+=1
o.y-=0.4
if (o.frame>=10) camera() del(explodes,o)

end

function draw_explodes(o)
camera(-1+rnd(2),-1+rnd(2))

circfill (o.x-4+rnd(8),
o.y-8+rnd(8),rnd(16),10)

circfill (o.x-4+rnd(8),
o.y-8+rnd(8),rnd(10),9)

circfill (o.x-8+rnd(16),
o.y-8+rnd(8),rnd(10),8)

circfill (o.x-8+rnd(16),
o.y-16+rnd(8),rnd(16),5)

end

function oprint(str,_x,_y,col)
local x=_x
local y=_y
local col=col

for r=y-1,y+1 do
	for c=x-1,x+1 do
	print(str,c,r,0)
	end
end
print(str,x,y,col)
end
-->8
--display hud/win/gameover

function draw_hud() 
if (score>high) high=score dset(0,high)

print("amo="..amo,104,10,12)
print("score",0,0,9)
print(sub("00000"..score,-6),0,6,7)
print("high score",48,0,8)
print(sub("00000"..high,-6),56,6,7)

for i=13,13+lives-1 do
spr(2,i*8,0) end
	
end

function win_init()
timeout=time()+4
state="win"
sfx(4)
end

function win_update()
if (time()>=timeout) score+=100+(amo*10) game_init() 
end

function win_draw()
print([[level completed
 in ]]..moves..[[ moves!]],32,60,7)
print("bonus score 100 pts",24,85,11)
if (amo>0) print(amo.." amo left x 10 pts",24,95,12)
end

function over_init()
sfx(6)
state="gameover"
timeout=time()+5
end

function over_update()
if (time()>=timeout) title_init()
end

function over_draw()
print("game over",44,65,7)
end
-->8
--title / intro

function title_init()
state="title"
pal()
ty=10
bx=0
bf=0
frame=0
timeout=time()+10
lives=3
score=0
end

function title_update()
if (time()>=timeout) intro_init()
frame+=1 frame=frame%60
ty+=1 ty=min(ty,42)
if (btnp(—)) sfx(7) game_init()
pal(2,rnd(6))
bx+=1
bf+=0.1 bf=bf%2
end

function title_draw()
spr(2+bf,bx,80)
spr(4+bf,bx-16,80)
spr(4+bf,bx-32,80)
spr(4+bf,bx-64,80)


spr(64,16,ty,12,4)
print("(c)2019 lostcadesoft by bgelais",0,120,12)
if frame<30 then
print("push — to start",32,95,7)
end

end

function intro_init()

state="intro"
timeout=time()+10
frame=0
end

function intro_update()
if (time()>=timeout) title_init()
frame+=0.1 frame=frame%2
if (btnp(—)) title_init()
pal()
end

function intro_draw()
map()
oprint([[
escape from bandits who run 
after you and reach the 
exit on top.
	
you got limited amo gun on 
each levels to kill them.
push Ž for fire mode and 
then ”ƒ‹‘ for shot's
direction.
		
mine bombs are invisible to
bandits! trick'em by make'em
folowing thru it then boom!
	
]],17,30,6)

spr(34+frame,64,111)
spr(20+frame,0,32)
spr(6,0,64,2,2)
spr(16,0,96)
end
