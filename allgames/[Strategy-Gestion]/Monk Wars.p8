--mobs

function addmob(m,x,y)
	return {
		typ=m,
		x=x,
		y=y,
		tx=x,
		ty=y,
		task=ai_wait,
		hp=2
	}
end

function ai_wait(m)
	for i=1,8 do
		local dx=dirx[i]
		local dy=diry[i]
		local tx,ty=m.x+dx,m.y+dy
		
		for s in all(struct) do
			if s.x==tx and s.y==ty then
				if m.typ==1 then
					s.val+=1
				else
					s.val-=1
				end
			end
		end
	end
	ai_attac(m)
end

function ai_move(m) 
 if m.x==m.tx and m.y==m.ty then
  addfloat("done",m.x*8,m.y*8,7)
 	sfx(4)
 	m.task=ai_wait
 	m:task()
 else
  local bdst,cand=999,{}
  calcdist(m.tx,m.ty)
  for i=1,4 do
   local dx,dy=dirx[i],diry[i]
   local tx,ty=m.x+dx,m.y+dy
   if iswalkable(tx,ty,"checkmobs") then
    local dst=distmap[tx][ty]
    if dst<bdst then
     cand={}
     bdst=dst
    end
    if dst==bdst then
     add(cand,{x=tx,y=ty})
    end
  	elseif tx==m.tx and ty==m.ty then
   	m.task=ai_wait
  		addfloat("done",m.x*8,m.y*8,7)
   end
  end
  if #cand>0 then
   local c=getrnd(cand)
   m.x=c.x
   m.y=c.y
   ai_attac(m)
  end 
  --todo: re-aquire target?
 end
end

function ai_attac(m)
	for i=1,4 do
  local dx,dy=dirx[i],diry[i]
  local tx,ty=m.x+dx,m.y+dy
  local mb=getmob(tx,ty)
		if mb and mb.typ!=m.typ then
			print(m.hp.." "..mb.hp)
			mb.hp-=1
			sfx(1)
			if mb.hp<=0 then
			sfx(5)
				del(mob,mb)
			end
		end
 end
end
-->8
--tools

function blankmap(_dflt)
 local ret={} 
 if (_dflt==nil) _dflt=0
 
 for x=0,31 do
  ret[x]={}
  for y=0,31 do
   ret[x][y]=_dflt
  end
 end
 return ret
end

function getrnd(arr)
 return arr[1+flr(rnd(#arr))]
end

function iswalkable(x,y,mode)
 local mode = mode or "test"
 
 --sight
 if inbounds(x,y) then
  local tle=mget(x,y)
  if not fget(tle,0) then
   if mode=="checkmobs" then
   	return not getmob(x,y)
   end
   return true
  end
 end
 return false
end

function getmob(x,y)
 for m in all(mob) do
  if m.x==x and m.y==y then
   return m
  end
 end
 return false
end

function inbounds(x,y)
 return not (x<0 or y<0 or x>31 or y>31)
end

function calcdist(tx,ty)
 local cand,step={},0
 distmap=blankmap(-1)
 add(cand,{x=tx,y=ty})
 distmap[tx][ty]=0
 repeat
  step+=1
  candnew={} 
  for c in all(cand) do
   for d=1,4 do
    local dx=c.x+dirx[d]
    local dy=c.y+diry[d]
    if inbounds(dx,dy) and distmap[dx][dy]==-1 then
     distmap[dx][dy]=step
     if iswalkable(dx,dy) then
      add(candnew,{x=dx,y=dy})
     end
    end
   end
  end
  cand=candnew
 until #cand==0
end

function oprint8(_t,_x,_y,_c,_c2)
 for i=1,8 do
  print(_t,_x+dirx[i],_y+diry[i],_c2)
 end 
 print(_t,_x,_y,_c)
end
-->8
--gameplay


function reset_buildings(begin)
	struct_total=0
	struct_black=0
	struct_white=0
	for x=0,15 do
		for y=0,15 do
			if fget(mget(x,y),1) then
				struct[#struct+1]={x=x,y=y,val=0,typ=0}
				struct_total+=1
			end
			
			local val=house_val
			if fget(mget(x,y),2) then
			 val=castle_val
			 struct[#struct].typ=1
			end
			
			if fget(mget(x,y),3) then
				struct[#struct].val=val
				struct_black+=1
				if begin then
					struct[#struct].summon=summontime_blk
					struct[#struct].summob=1
				end
			elseif fget(mget(x,y),4) then
				struct[#struct].val=-val
				struct_white+=1
				if begin then
					struct[#struct].summon=summontime_wht
					struct[#struct].summob=2
				end
			end
		end
	end
end

function update_buildings()
	for s in all(struct) do
		if s.typ==0 then
			if s.val==house_val and mget(s.x,s.y)!=30 then
				addfloat("blk",s.x*8,s.y*8,7)
				mset(s.x,s.y,30)
				sfx(2)
			elseif s.val==-house_val and mget(s.x,s.y)!=46 then
				addfloat("wht",s.x*8,s.y*8,7)
				mset(s.x,s.y,46)
				sfx(2)
			end
		else
			if s.val==castle_val and mget(s.x,s.y)!=31 then
				addfloat("blk",s.x*8,s.y*8,7)
				sfx(2)
				mset(s.x,s.y,31)
				s.summon=5
				s.summob=1
			elseif s.val==-castle_val and mget(s.x,s.y)!=47 then
				addfloat("wht",s.x*8,s.y*8,7)
				mset(s.x,s.y,47)
				s.summon=5
				s.summob=2
				sfx(2)
			end
		end
	end
	reset_buildings(false)
end

function summons()

for s in all(struct) do
				if s.typ==1 and s.summon then
					s.summon-=1
					if s.summon==0 then
						if s.summob==1 then
							s.summon=summontime_wht
						else
							s.summon=summontime_blk
						end
						
						local dx,dy
						for i=1,4 do
							if iswalkable(dirx[i]+s.x,diry[i]+s.y, "checkmobs") then
								dx,dy=dirx[i]+s.x,diry[i]+s.y
							end
						end
						if dx then
						local mb=addmob(s.summob,dx,dy)
						add(mob,mb)
						addfloat("new",mb.x*8,mb.y*8,7)
						sfx(3)
						end
					end
				end
			end
			
end

function gen_summon_time()
	local wht=struct_white/struct_total
	local blk=struct_black/struct_total
	summontime_wht=flr(5+15*(1-wht))
	summontime_blk=flr(5+15*(1-blk))
end
-->8
--ui
function addfloat(_txt,_x,_y,_c)
 add(float,{txt=_txt,x=_x,y=_y,c=_c,ty=_y-10,t=0})
end

function dofloats()
 for f in all(float) do
  f.y+=(f.ty-f.y)/10
  f.t+=1
  if f.t>30 then
   del(float,f)
  end
 end
end
