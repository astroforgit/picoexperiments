function draw_game()
	cls()
	map(0,0)
	palt(0,false)
	for m in all(mob) do
		local wht
		if m.typ==1 then
			if m.hp==2 then
			spr(64,m.x*8,m.y*8)
			else
			spr(80,m.x*8,m.y*8)
			end
			wht=true
		else
			if m.hp==2 then
			spr(65,m.x*8,m.y*8)
			else
			spr(81,m.x*8,m.y*8)
			end
			wht=false
		end
		if not sel_mob and turn!=wht then
			--if sin(time())>0 then
				if m.task==ai_move then
					rect(m.x*8,m.y*8,m.x*8+6,m.y*8+6,11)
				else
					rect(m.x*8,m.y*8,m.x*8+6,m.y*8+6,8)			
				end
			--end
		end
	end
	
	if sin(time()*2)>0 then
		rect(sel_x*8,sel_y*8,sel_x*8+6,sel_y*8+6,7)
	end
	if sel_mob then
		rect(sel_mob.x*8,sel_mob.y*8,sel_mob.x*8+6,sel_mob.y*8+6,9)			
	end
	if sel_sx then
		rect(sel_sx*8,sel_sy*8,sel_sx*8+6,sel_sy*8+6,9)			
	end
	local tmb=getmob(sel_x,sel_y)
	if sin(time()*4)>0 and tmb and tmb.task==ai_move then		
		rect(tmb.tx*8,tmb.ty*8,tmb.tx*8+6,tmb.ty*8+6,10)			
	end
	
	--ui
	local bpct=struct_black/struct_total*160-8
	local wpct=struct_white/struct_total*160-8
	rectfill(0,15*8,16*8-2,16*8,0)
	if bpct>0 then
	rectfill(0,15*8,bpct,16*8,5)
	end
	rectfill(16*8-wpct,15*8,16*8,16*8,7)

	for f in all(float) do
  oprint8(f.txt,f.x,f.y,f.c,0)
 end
 
 if mouse then
 palt(0,true)
 spr(0,stat(32)-1,stat(33)-1)
	
 end
 
end

function draw_start()
	cls()
	map(16,0)
	print("monk wars",46,10,7)

	print("” 1 controller",2,82,onecon and 10 or 7)
	print("ƒ 2 controllers (esdf wq)",2,88,onecon and 7 or 10)

	print("‹ mouse",2,100,mouse and 10 or 7)
	print("‘ controlller",2,106,mouse and 7 or 10)

	print("— to start",2,118,7)
end
