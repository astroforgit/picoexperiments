pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
--monk wars
--by thedestoryer
house_val=2
castle_val=5
mouse=true

function _init()
	
	distmap=nil
	dirx={-1,1,0,0,1,1,-1,-1}
 diry={0,0,-1,1,-1,1,1,-1}
	
	--startgame()
	_upd=update_start
	_drw=draw_start
	
	onecon=true
	askip=true
end

function _update()
	_upd()
end

function _draw()
	_drw()
end

function startgame()
	if mouse then	
		poke(0x5f2d,1)
	end
	turn=true

	_upd=update_game
	_drw=draw_game
	mob={}
	
	struct={}
	
	mob[1]=addmob(1,3,3)
	mob[2]=addmob(2,12,12)
	
	sel_mob=nil
	sel_on=true
	sel_x=7
	sel_y=7
	sel_sx=nil
	sel_sy=nil
	
	summontime_wht=20
	summontime_blk=20
	
	struct_total=0
	struct_black=0
	struct_white=0
	
	float={}
	
	reset_buildings(true)
	gen_summon_time()
end

-->8
--updates

function update_game()
	if (btnp(—,0) and turn) or (btnp(—,1) and not turn) or (onecon and (btnp(—,0) or btnp(—,1))) then
		if sel_mob then
			select_square()
		else
			select_mob()
		end
	end
	if (btnp(Ž,0) and turn) or (btnp(Ž,1) and not turn) or (askip and (btnp(Ž,0) or btnp(Ž,1))) or (onecon and (btnp(Ž,0) or btnp(Ž,1))) then
		if sel_mob then
			sel_mob=nil
			sel_sx=nil
			sel_sy=nil
		else
			doturn()
		end
	end
	
	if onecon then
		if btnp(”) and sel_y>0 then
			sel_y-=1
		elseif btnp(ƒ) and sel_y<14 then
			sel_y+=1
		elseif btnp(‹) and sel_x>0 then
			sel_x-=1
		elseif btnp(‘) and sel_x<15 then
			sel_x+=1
		end
	else
	if turn then
		if btnp(”,0) and sel_y>0 then
			sel_y-=1
		elseif btnp(ƒ,0) and sel_y<14 then
			sel_y+=1
		elseif btnp(‹,0) and sel_x>0 then
			sel_x-=1
		elseif btnp(‘,0) and sel_x<15 then
			sel_x+=1
		end
	else
		if btnp(”,1) and sel_y>0 then
			sel_y-=1
		elseif btnp(ƒ,1) and sel_y<14 then
			sel_y+=1
		elseif btnp(‹,1) and sel_x>0 then
			sel_x-=1
		elseif btnp(‘,1) and sel_x<15 then
			sel_x+=1
		end
	end
	end
	
	if mouse then
		sel_x=flr((stat(32)-0.5)/8)
		sel_y=flr((stat(33)-0.5)/8)
		
		if stat(34)==1 then
			if not click then
				select_mob()
			end
			select_square()
			click=true
		else
			if sel_mob then
				sel_mob=nil
				sel_sx=nil
				sel_sy=nil
			end
			click=false
		end
		
		if stat(34)==2 then
			if not click2 then
				doturn()
			end
			click2=true
		else
			click2=false
		end
	end
	
	dofloats()
end

function update_start()
	if btnp(”) then
			onecon=true
		elseif btnp(ƒ) then
			onecon=false
		elseif btnp(‹) then
			mouse=true
		elseif btnp(‘) then
			mouse=false
		end

	if btnp(—) then
		startgame()
	end
end

function select_mob()

	local mb=getmob(sel_x,sel_y)
	if mb and turn!=(mb.typ==1) then
		sel_mob=mb
		sel_sx=nil
		sel_sy=nil
	end
end

function select_square()
	if sel_mob then
	if sel_x==sel_mob.x and sel_y==sel_mob.y then
		sel_mob.tx=sel_x
		sel_mob.ty=sel_y
		sel_sx=sel_x
		sel_sy=sel_y
		sel_mob.task=ai_wait
	else
		sel_mob.tx=sel_x
		sel_mob.ty=sel_y
		sel_sx=sel_x
		sel_sy=sel_y
		sel_mob.task=ai_move
		local mb=getmob(sel_x,sel_y)
		if mb and mb.typ!=sel_mob.typ then
			sel_mob.tmob=mb
		end
	end
	end
end

function doturn()
	turn=not turn
	sfx(0)
	for m in all(mob) do
		
		if m.typ==1 and turn then
			m:task()
		elseif m.typ==2 and not turn then
			m:task()
		end
	end
	update_buildings()
	summons()
	gen_summon_time()
	if struct_black==struct_total then
		_upd=update_endscreen
	elseif struct_white==struct_total then 
		_upd=update_endscreen
	end
end
