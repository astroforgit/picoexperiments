x = 0  y = 0
actualx = 0
actualy = 0
woodqt = 0
stoneqt = 0
coalqt = 0
ironqt = 0
emeraldqt = 0
goldqt = 0
diamondqt = 0
timerh = 12
timerm = 0
picklevel = 0
axelevel = 0
ismenu = 6
menuselection = 0
currenttile = 0
hunger = 100
thirst = 100

	function _update()
		-- get key input, move, sfx,
		-- activate other turns
		if hunger > 99 then hunger = 99 end
		if thirst > 99 then thirst = 99 end
	 if hunger < 0 then ismenu = 8 end
	 if thirst < 0 then ismenu = 8 end
	 if ismenu == 0 then
	 currenttile = mget(x, y)
	 if (btnp(0)) then 
	 x=x-1 
	 sfx(0)
	 timerm = timerm + 1
	 hunger = hunger - 1
	 thirst = thirst - 1
	 end
	 if (btnp(1)) then 
	 x=x+1 
	 sfx(0)
	 timerm = timerm + 1
	 hunger = hunger - 1
	 thirst = thirst - 1
	 end
	 if (btnp(2)) then
	 y=y-1 
	 sfx(0)
	 timerm = timerm + 1
	 hunger = hunger - 1
	 thirst = thirst - 1
	 end
	 if (btnp(3)) then 
	 y=y+1
	 sfx(0)
	 timerm = timerm + 1
	 hunger = hunger - 1
	 thirst = thirst - 1
	 end
	 if (btnp(5)) then
	 ismenu = 1
	 end
	 if (btnp(4)) then
	 if currenttile == 8 then
	 ismenu = 3
	 end
	 if currenttile == 9 then
	 ismenu = 3
	 end
	 if currenttile == 10 then
	 ismenu = 3
	 end
	 if currenttile == 27 then
	 ismenu = 4
	 end
	 if currenttile == 28 then
	 ismenu = 4
	 end
	 if currenttile == 29 then
	 ismenu = 4
	 end
	 end 
	 if timerm > 59 then
	 	timerh = timerh + 1
	 	timerm = 0
	 end
	 if timerh > 23 then
	 	timerh = 0
	 end
	 if x < 0 then x = 0 end
	 if x > 32 then x = 32 end
	 if y < 0 then y = 0 end
	 if y > 32 then y = 32 end
	end
	if ismenu == 2 then
	if (btnp(2)) then menuselection = menuselection - 1 end
	if (btnp(3)) then menuselection = menuselection + 1 end
	if menuselection < 0 then
		if ismenu == 2 then
	 menuselection = 0 end
	 end
	if menuselection > 8 then
	if ismenu == 2 then
	 menuselection = 8 end
	 end
	if (btnp(4)) then
		if ismenu == 2 then
			if menuselection == 0 then
				if woodqt >= 10 then
					if stoneqt >= 0 then
						if ironqt >= 0 then
							if currenttile == 0 then
					woodqt = woodqt - 10
					stoneqt = stoneqt - 0
					ironqt = ironqt - 0
					mset(x, y, 8)
					end
					end
					end	
				end
				ismenu = 0
			end
			if menuselection == 1 then
				if woodqt >= 10 then
					if stoneqt >= 20 then
						if ironqt >= 0 then
							if currenttile == 0 then
					woodqt = woodqt - 10
					stoneqt = stoneqt - 20
					ironqt = ironqt - 0
					mset(x, y, 27)
					end
					end
					end	
				end
				ismenu = 0
			end
			if menuselection == 2 then
				if woodqt >= 40 then
					if stoneqt >= 40 then
						if ironqt >= 0 then
							if currenttile == 0 then
					woodqt = woodqt - 40
					stoneqt = stoneqt - 40
					ironqt = ironqt - 0
					mset(x, y, 13)
					end
					end
					end	
				end
				ismenu = 0
			end
			if menuselection == 3 then
				if woodqt >= 40 then
					if stoneqt >= 40 then
						if ironqt >= 0 then
							if currenttile == 0 then
					woodqt = woodqt - 40
					stoneqt = stoneqt - 40
					ironqt = ironqt - 0
					mset(x, y, 14)
					end
					end
					end	
				end
				ismenu = 0
			end
			if menuselection == 4 then
				if woodqt >= 40 then
					if stoneqt >= 40 then
						if ironqt >= 0 then
							if currenttile == 0 then
					woodqt = woodqt - 40
					stoneqt = stoneqt - 40
					ironqt = ironqt - 0
					mset(x, y, 15)
					end
					end
					end	
				end
				ismenu = 0
			end
			if menuselection == 5 then
				if woodqt >= 10 then
					if stoneqt >= 30 then
						if ironqt >= 10 then
							if currenttile == 0 then
					woodqt = woodqt - 10
					stoneqt = stoneqt - 30
					ironqt = ironqt - 10
					mset(x, y, 16)
					end
					end
					end	
				end
				ismenu = 0
			end
			if menuselection == 6 then
				if woodqt >= 10 then
					if stoneqt >= 20 then
						if ironqt >= 0 then
							if currenttile == 0 then
					woodqt = woodqt - 10
					stoneqt = stoneqt - 20
					ironqt = ironqt - 0
					mset(x, y, 17)
					end
					end
					end	
				end
				ismenu = 0
			end
			if menuselection == 7 then
				if woodqt >= 20 then
					if stoneqt >= 10 then
						if ironqt >= 10 then
							if currenttile == 0 then
					woodqt = woodqt - 20
					stoneqt = stoneqt - 10
					ironqt = ironqt - 10
					mset(x, y, 26)
					end
					end
					end	
				end
				ismenu = 0
			end
			if menuselection == 8 then
				if woodqt >= 20 then
					if stoneqt >= 0 then
						if ironqt >= 0 then
							if currenttile == 0 then
					woodqt = woodqt - 20
					stoneqt = stoneqt - 0
					ironqt = ironqt - 0
					mset(x, y, 30)
					end
					end
					end	
				end
				ismenu = 0
			end
			menuselection = 0
	end
	end
	end
	
	if ismenu == 3 then
	if (btnp(2)) then menuselection = menuselection - 1 end
	if (btnp(3)) then menuselection = menuselection + 1 end
	if menuselection < 0 then
		if ismenu == 3 then
	 menuselection = 0 end
	 end
	if menuselection > 2 then
	if ismenu == 3 then
	 menuselection = 2 end
	 end
	if (btnp(4)) then
		if ismenu == 3 then
			if menuselection == 2 then
			menuselection = 0
			ismenu = 0
			end
			if menuselection == 0 then
						timerh = timerh + (-3 + currenttile - 4)
						for mapx = 0, 32, 1 do
	 		for mapy = 0, 32, 1 do
	 			if mget(mapx, mapy) == 17 then
	 				mset(mapx, mapy, 18)
	 			end
	 			if mget(mapx, mapy) == 18 then
	 				mset(mapx, mapy, 19)
	 			end
	 			if mget(mapx, mapy) == 19 then
	 				mset(mapx, mapy, 20)
	 			end 
	 		end
	 	end
						if timerh > 23 then timerh = 0 end				
	  end
			if menuselection == 1 then
				if currenttile < 10 then
						if ironqt >= 20 then
							ironqt = ironqt - 20
							mset(x, y, currenttile+1)
							currenttile = currenttile + 1
						end
						end
		 end
	 end
	end
	end
	if ismenu == 4 then
	if (btnp(2)) then menuselection = menuselection - 1 end
	if (btnp(3)) then menuselection = menuselection + 1 end
	if menuselection < 0 then
		if ismenu == 4 then
	 menuselection = 0 end
	 end
	if menuselection > 2 then
	if ismenu == 4 then
	 menuselection = 2 end
	 end
	if (btnp(5)) then
		if ismenu == 4 then
			if menuselection == 2 then
			ismenu = 0
			end
			if menuselection == 0 then
			ismenu = 5
			end
			if menuselection == 1 then
			if currenttile < 29 then
						if ironqt >= 50 then
							ironqt = ironqt - 50
							mset(x, y, currenttile+1)
							currenttile = currenttile + 1
						end
						end
						end
		end
	end
	end
	if ismenu == 5 then
	if (btnp(2)) then menuselection = menuselection - 1 end
	if (btnp(3)) then menuselection = menuselection + 1 end
	if menuselection < 0 then
		if ismenu == 5 then
	 menuselection = 0 end
	 end
	if menuselection > 2 then
	if ismenu == 5 then
	 menuselection = 2 end
	 end
	if (btnp(4)) then
		if menuselection == 2 then
		ismenu = 0
		end
		if menuselection == 0 then
			if picklevel == 0 then
				if stoneqt >= 20 then
					if currenttile >= 27 then
						stoneqt = stoneqt - 20
						picklevel = picklevel + 1
					end
				end
			end
			if picklevel == 1 then
				if ironqt >= 20 then
					if currenttile >= 27 then
						ironqt = ironqt - 20
						picklevel = picklevel + 1
					end
				end
			end
			if picklevel == 2 then
				if goldqt >= 20 then
					if currenttile >= 28 then
						goldqt = goldqt - 20
						picklevel = picklevel + 1
					end
				end
			end
			if picklevel == 3 then
				if diamondqt >= 20 then
					if currenttile >= 29 then
						diamondqt = diamondqt - 20
						picklevel = picklevel + 1
					end
				end
			end
		end
				if menuselection == 1 then
			if axelevel == 0 then
				if stoneqt >= 20 then
					if currenttile >= 27 then
						stoneqt = stoneqt - 20
						axelevel = axelevel + 1
					end
				end
			end
			if axelevel == 1 then
				if ironqt >= 20 then
					if currenttile >= 27 then
						ironqt = ironqt - 20
						axelevel = axelevel + 1
					end
				end
			end
			if axelevel == 2 then
				if goldqt >= 20 then
					if currenttile >= 28 then
						goldqt = goldqt - 20
						axelevel = axelevel + 1
					end
				end
			end
			if axelevel == 3 then
				if diamondqt >= 20 then
					if currenttile >= 29 then
						diamondqt = diamondqt - 20
						axelevel = axelevel + 1
					end
				end
			end
		end
		end
	 end
	
	if ismenu == 6 then
	if (btnp(2)) then menuselection = menuselection - 1 end
	if (btnp(3)) then menuselection = menuselection + 1 end end
	if menuselection < 0 then
		if ismenu == 6 then
	 menuselection = 0 end
	 end
	if menuselection > 1 then
	if ismenu == 6 then
	 menuselection = 1 end
	end
	if (btnp(5)) then
		if ismenu == 6 then
		if menuselection == 0 then
				ismenu = 0
	 end
	 if menuselection == 1 then
	 		ismenu = 7
	 end
	 end
	end
	
	if ismenu == 1 then
	if (btnp(2)) then menuselection = menuselection - 1 end
	if (btnp(3)) then menuselection = menuselection + 1 end end
	if menuselection < 0 then
		if ismenu == 1 then
	 menuselection = 0 end
	 end
	if menuselection > 2 then
	if ismenu == 1 then
	 menuselection = 2 end
	 end
	if (btnp(4)) then
		if menuselection == 0 then
		if ismenu == 1 then
		ismenu = 0
		menuselection = 0
		ismenu = 2
		end
		end
		if menuselection == 2 then
		if ismenu == 1 then
		menuselection = 0
		ismenu = 0
		end
		end
	 if menuselection == 1 then
	 if ismenu == 1 then
			if currenttile == 1 then
			woodqt = woodqt + 5 * (axelevel + 1)
			mset(x, y, 0)
			timerm = timerm + 10
			ismenu = 0
			sfx(1)
			end
			if currenttile == 2 then
			stoneqt = stoneqt + 5 * (picklevel + 1)
			mset(x, y, 0)
			timerm = timerm + 10
			ismenu = 0
			sfx(1)
			end
			if currenttile == 3 then
			stoneqt = stoneqt + 3 * (picklevel + 1)
			mset(x, y, 0)
			timerm = timerm + 5
			ismenu = 0
			sfx(1)
			end
			if currenttile == 4 then
			stoneqt = stoneqt + 1 * (picklevel + 1)
			mset(x, y, 0)
			timerm = timerm + 2
			ismenu = 0
			sfx(1)
			end
			if currenttile == 5 then
			hunger = hunger + 10
			mset(x, y, 0)
			timerm = timerm + 5
			ismenu = 0
			sfx(3)
			end
			if currenttile == 21 then
			coalqt = coalqt + 5 * (picklevel + 1)
			mset(x, y, 0)
			timerm = timerm + 5
			ismenu = 0
			sfx(1)
			end
			if currenttile == 22 then
			if picklevel > 0 then
			ironqt = ironqt + 5 * (picklevel)
			mset(x, y, 0)
			timerm = timerm + 10
			ismenu = 0
			sfx(1)
			end
			end
			if currenttile == 23 then
			if picklevel > 1 then
			emeraldqt = emeraldqt + 5 * (picklevel - 1)
			mset(x, y, 0)
			timerm = timerm + 15
			ismenu = 0
			sfx(1)
			end
			end
			if currenttile == 24 then
			if picklevel > 1 then
			goldqt = goldqt + 5 * (picklevel - 1)
			mset(x, y, 0)
			timerm = timerm + 20
			ismenu = 0
			sfx(1)
			end
			end
			if currenttile == 25 then
			if picklevel > 2 then
			diamondqt = diamondqt + 5 * (picklevel - 2)
			mset(x, y, 0)
			timerm = timerm + 30
			ismenu = 0
			sfx(1)
			end
			end
			if currenttile == 20 then
			hunger = hunger + 50
			mset(x, y, 17)
			timerm = timerm + 30
			ismenu = 0
			sfx(3)
			end
			if currenttile == 13 then
			hunger = hunger + 2
			timerm = timerm + 30
			ismenu = 0
			sfx(3)
			end
			if currenttile == 14 then
			hunger = hunger + 2
			timerm = timerm + 30
			ismenu = 0
			sfx(3)
			end
			if currenttile == 15 then
			hunger = hunger + 2
			timerm = timerm + 30
			ismenu = 0
			sfx(3)
			end
			if currenttile == 16 then
			thirst = thirst + 2
			timerm = timerm + 30
			ismenu = 0
			sfx(3)
			end
			if currenttile == 6 then
			thirst = thirst + 20
			timerm = timerm + 40
			mset(x, y, 7)
			ismenu = 0
			sfx(3)
			end
	 end
	end
	end
	end

	function _draw()
		-- draw the screen
	 local drawtile
	 cls()
	 for mapx = 0, 32, 1 do
	 	for mapy = 0, 32, 1 do
	 		spr(mget(mapx + x - 8, mapy + y - 8), mapx * 8, mapy * 8)
			end
		end
		spr(32, 8 * 8, 8 * 8)
		spr(37, 0, 112)
		print(woodqt, 8, 113, 0)
		spr(36, 24, 112)
		print(stoneqt, 32, 113, 0)
  spr(38, 48, 112)
		print(coalqt, 56, 113, 0)
		spr(39, 72, 112)
		print(ironqt, 80, 113, 0)
		spr(40, 0, 120)
		print(emeraldqt, 8, 121, 0)
		spr(41, 24, 120)
		print(goldqt, 32, 121, 0)
		spr(42, 48, 120)
		print(diamondqt, 56, 121, 0)
		print(timerh, 72, 121, 0)
		print(":", 80, 121, 0)
		print(timerm, 84, 121, 0)
		spr(44 + picklevel, 112, 120)
	 spr(49 + axelevel, 120, 120)
	 if hunger < 11 then
	 print ("hungry!", 100, 112, 8)
	 end
	 if hunger > 10 then
	 print (hunger, 118, 112, 8)
	 end
	 if thirst > 10 then
	 print (thirst, 112, 104, 1)
	 end
	 if thirst < 11 then
	 print ("thirsty!", 96, 104, 1)
	 end
	 if ismenu == 1 then
	 rectfill(0, 0, 128, 32, 4)
	 print("build", 8, 4, 0)
	 print("collect", 8, 12, 0)
	 print("cancel", 8, 20, 0)
	 if menuselection == 0 then spr(55, 0, 4) end
	 if menuselection == 1 then spr(55, 0, 12) end
	 if menuselection == 2 then spr(55, 0, 20) end
	 end
	 if ismenu == 2 then
	 rectfill(0, 0, 128, 32, 4)
	 print("house", 8, 4, 0)
	 print("factory", 8, 12, 0)
	 print("pigsty", 8, 20, 0)
	 print("cowhouse", 50, 4, 0)
	 print("henhouse", 50, 12, 0)
	 print("well", 50, 20, 0)
	 print("farm", 96, 4, 0)
	 print("light", 96, 12, 0)
	 print("road", 96, 20, 0)
	 if menuselection == 0 then spr(55, 0, 4) end
	 if menuselection == 1 then spr(55, 0, 12) end
	 if menuselection == 2 then spr(55, 0, 20) end
	 if menuselection == 3 then spr(55, 40, 4) end
	 if menuselection == 4 then spr(55, 40, 12) end
	 if menuselection == 5 then spr(55, 40, 20) end
	 if menuselection == 6 then spr(55, 85, 4) end
	 if menuselection == 7 then spr(55, 85, 12) end
	 if menuselection == 8 then spr(55, 85, 20) end
	 end
	 if ismenu == 3 then
	 rectfill(0, 0, 128, 32, 4)
	 print("rest", 8, 4, 0)
	 print("upgrade", 8, 12, 0)
	 print("cancel", 8, 20, 0)
	 if menuselection == 0 then spr(55, 0, 4) end
	 if menuselection == 1 then spr(55, 0, 12) end
	 if menuselection == 2 then spr(55, 0, 20) end
	 end
	 if ismenu == 4 then
	 rectfill(0, 0, 128, 32, 4)
	 print("craft", 8, 4, 0)
	 print("upgrade", 8, 12, 0)
	 print("cancel", 8, 20, 0)
	 if menuselection == 0 then spr(55, 0, 4) end
	 if menuselection == 1 then spr(55, 0, 12) end
	 if menuselection == 2 then spr(55, 0, 20) end
	 end
	 if ismenu == 5 then
	 rectfill(0, 0, 128, 32, 4)
	 print("pickaxe", 8, 4, 0)
	 print("axe", 8, 12, 0)
	 print("cancel", 8, 20, 0)
	 if menuselection == 0 then spr(55, 0, 4) end
	 if menuselection == 1 then spr(55, 0, 12) end
	 if menuselection == 2 then spr(55, 0, 20) end
	 end
	 if ismenu == 6 then
	 rectfill(0, 0, 128, 128, 0)
	 rectfill(16, 66, 112, 112, 4)
	 print("start", 52, 80, 0)
	 print("end", 56, 90, 0)
	 print("by adrian09_01 (c) 2016", 18, 106, 0)
	 spr(60, 48, 20)
	 spr(61, 56, 20)
	 spr(62, 64, 20)
	 print("craft", 60, 28, 2)
	 if menuselection == 0 then spr(55, 42, 80) end
	 if menuselection == 1 then spr(55, 42, 90) end
	 end
	 if ismenu == 7 then
	 rectfill(0, 0, 128, 128, 0)
	 print ("thanks for playing", 24, 48, 7)
	 print ("picocraft", 40, 56, rnd(15))
	 print ("by adrian09_01 (c) 2016", 14, 64, 7)
	 end
	 if ismenu == 8 then
	 rectfill(0, 0, 128, 128, 8)
	 print ("you died", 46, 56, 10)
	 end
	end
	

	function _init()
		-- plot random map from pieces
		local map
		for mapx = 1, 32, 1 do
			for mapy = 1, 32, 1 do
    map = flr(rnd(55))
    if map == 0 then mset(mapx, mapy, 0) end
    if map == 1 then mset(mapx, mapy, 0) end
    if map == 2 then mset(mapx, mapy, 0) end
    if map == 3 then mset(mapx, mapy, 0) end
    if map == 4 then mset(mapx, mapy, 0) end
    if map == 5 then mset(mapx, mapy, 0) end
    if map == 6 then mset(mapx, mapy, 0) end
    if map == 7 then mset(mapx, mapy, 0) end
    if map == 8 then mset(mapx, mapy, 0) end
    if map == 9 then mset(mapx, mapy, 0) end
				if map == 10 then mset(mapx, mapy, 1) end
				if map == 11 then mset(mapx, mapy, 1) end
				if map == 12 then mset(mapx, mapy, 1) end
				if map == 13 then mset(mapx, mapy, 2) end
				if map == 14 then mset(mapx, mapy, 2) end
				if map == 15 then mset(mapx, mapy, 3) end
				if map == 16 then mset(mapx, mapy, 3) end
				if map == 17 then mset(mapx, mapy, 4) end
				if map == 18 then mset(mapx, mapy, 5) end
				if map == 19 then mset(mapx, mapy, 6) end
				if map == 20 then mset(mapx, mapy, 7) end
				if map == 50 then mset(mapx, mapy, 21) end
				if map == 51 then mset(mapx, mapy, 22) end
				if map == 52 then mset(mapx, mapy, 23) end
				if map == 53 then mset(mapx, mapy, 24) end
				if map == 54 then mset(mapx, mapy, 25) end
			end
		end
	end
