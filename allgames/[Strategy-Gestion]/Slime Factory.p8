pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
--          slime factory
--             by vann
function _init()
 music(0)
 --make beige transparent
 palt(15,true)
 palt(0,false)
 _update=_update_title
 _draw=_draw_title
 -- err message globals
 err_pos=nil
 err_msgs={
 "sorry, you need more room",
 "you've got enough slimes",
 "um, i don't have any more",
 "i need to cook some more",
 "err, you can't afford it",
 "sorry, you need more coin",
 "sorry, end of the road",
 "nope, this is the end",
 "sorry, last area",
 }
 err_msg=nil
 err_time=nil
 err_dur=3.5
 -- other globals
 frame=0
 coins=0
 coin_production=0
 coin_time=time()
 coin_a_time=coin_time
 coin_freq=3--sec between coin spawns
 coin_a_dur=.75
 
 gravity=1.4
 
 food={}
 -- slime related tables
 slimes={}
 sizes={8,9,11,13,15,17,19}--slime sizes
 sl_color=0--default slime color
 
 -- definitions for map areas
 -- units are map cels
 areas={
	 {x1=0,x2=16,y1=0,y2=16,l_cap=2,sl_cap=2},
	 {x1=16,x2=32,y1=0,y2=16,l_cap=3,sl_cap=3},
  {x1=32,x2=56,y1=0,y2=21,l_cap=4,sl_cap=6},
  {x1=56,x2=91,y1=0,y2=27,l_cap=5,sl_cap=9},
  {x1=91,x2=128,y1=0,y2=33,l_cap=7,sl_cap=15},
 }
 shop_area={x1=0,x2=16,y1=16,y2=32}
 title_area={x1=16,x2=32,y1=16,y2=32}
 -- camera parameters
 cmra={
	 x=0,
	 y=0,
	 x_lbound=0,--x lower bound
	 y_lbound=0,
	 x_ubound=0,--x upper bound
	 y_ubound=0,
	 spd=2,
 }
 -- shop inventory table
 stock={
   {name="new slime",price=60,action=0},
   {name="slime food",price=20,action=1},
   {name="bigger area",price=200,action=2},
 }
 -- spawn locations
 spawns={}
 curr_spawn=1
 -- initiallizing first area
 move_error()
 curr_area=0
 slime_cap=0
 next_area()
 -- moving to title screen
 show_title()
 
end

-------- title screen ----------
function show_title()
 change_area(title_area)
 move_camera(title_area)
 spawn_slime()
 spawn_slime()
end

function start_game()
 _update=_update_game
 _draw=_draw_game
 local area = areas[curr_area]
 change_area(area)
 move_camera(area)
 for sl in all(slimes) do
  del(slimes,sl)
 end
 coin_production=0
 spawn_slime()
end

function _update_title()
 frame=(frame+1)%64
 frame_time = abs(time())%64
 move_food()
 move_slimes()
 eat()
 if btnp(4) then
  start_game()
 end
 if btnp(5) then
  start_game()
 end
end

function _draw_title()
 cls()
 camera(cmra.x,cmra.y)
 map(0,0,0,0,128,33)
 draw_food()
 draw_slimes()
 print("slime",cmra.x+52,cmra.y+26,11)
 print("factory",cmra.x+48,cmra.y+42,9)
 print("controls",cmra.x+48,cmra.y+58,6)
 print("arrows to move camera",cmra.x+22,cmra.y+74)
 print("Ž:open shop",cmra.x+14,cmra.y+90)
 print("—:get coins",cmra.x+68,cmra.y+90)
 print("press Ž or — to start",cmra.x+18,cmra.y+106)
end

------------ game ----------------
function spawn_slime(sl)
 local pos=spawns[curr_spawn]
 local x,y=pos[1],pos[2]
 if sl==nil then
  if #slimes >= slime_cap then
   return false
  end
	 local sl = {
	 x=x+4,
	 y=y,
	 size=sizes[1],
	 b_sprt=sl_color,
	 max_spd=1,
	 curr_spd=1,
	 on_ground=false,
	 dx=0,
	 j_height=0,
	 m_height=16,
	 level=1
	 }
	 if flr(rnd(10))==0 then
	  sl.b_sprt=72
	 else
	  sl_color=(sl_color+24)%72
	 end
	 add(slimes,sl)
	else
	 sl.x=x+4
	 sl.y=y
	end
 curr_spawn+=1
 if curr_spawn>#spawns then
  curr_spawn=1
 end
 coin_production+=1
 return true
end
--find spawn tile 
--start x, start y, end x, end y
--args units are map cels
function find_spawns(sx,sy,ex,ey)
 for sp in all(spawns) do
  del(spawns,sp)
 end
 local x=sx
 local y=sy
 while y<=ey do
  if fget(mget(x,y),1) then
   add(spawns,{x*8,y*8+8})
  end
  x+=1
  if x>=ex then
   x=sx
   y+=1
  end
 end
end
--- move to the next area
-- move slimes and remove food
function next_area()
 if curr_area < #areas then
  curr_area+=1
	 local area=areas[curr_area]
	 change_area(area)
	 for sl in all(slimes) do
	  spawn_slime(sl)
	 end
	 for fd in all(food) do
	  del(food,fd)
	 end
	 slime_cap = area.sl_cap
	 level_cap = area.l_cap
	 return true
	else
	 return false
	end
end

function change_area(area)
 local x1,x2=area.x1,area.x2
 local y1,y2=area.y1,area.y2
 find_spawns(x1,y1,x2,y2)
end

-- drops food from the first
-- available spawner
function spawn_food()
 for pos in all(spawns) do
 local pos_busy=false
	 local x,y = pos[1],pos[2]
	 for fd in all(food) do
	  if fd.x == x then
	   pos_busy = true
	  end
	 end
	 if not pos_busy then
		local fd={
		 x=x,
		 y=y,
		 on_ground=false,
		 sprt=2,
		 }
		 add(food,fd)
		 curr_spawn+=1
		 if curr_spawn>#spawns then
		  curr_spawn=1
		 end
		 return true
		end
	end
 return false
end

-- make a slime bigger and increase coin production
function embiggen(sl)
 if sl.level<level_cap then
	 sl.level+=1
	 sl.size=sizes[sl.level]
	 sl.m_height+=2
	 coin_production+=1
	 return true
 else
  return false
 end
end

function collision(direction,sl)
 x=sl.x
 y=sl.y
 size=sl.size
 --left
 if direction==-1 then
  if fget(mget((x-size/2)/8,(y+size/2-1)/8),0)
  or fget(mget((x-size/2)/8,(y-size/2+1)/8),0) then
   return true
  end
 --right
 elseif direction==1 then
  if fget(mget((x+size/2-1)/8,(y+size/2-1)/8),0)
  or fget(mget((x+size/2-1)/8,(y-size/2+1)/8),0) then
   return true
  end
 --up
 elseif direction==2 then
  if (fget(mget((x+size/2)/8,(y-size/2)/8),0)
  and fget(mget((x-size/2)/8,(y-size/2)/8),0))
  or fget(mget(x/8,(y-size/2-1)/8),0) then
   return true
  end
 --down
 elseif direction==3 then
  if fget(mget((x+size/2-1)/8,(y+size/2)/8),0)
  or fget(mget((x-size/2)/8,(y+size/2)/8),0) 
  or fget(mget(x/8,(y+size/2)/8),0)then
   return true
  end
 end
 
 return false
end

-- slimes eat food if their center
-- pixel is in the same map cel as the food
function eat()
 for sl in all(slimes) do
  for fd in all(food) do
   if flr(sl.x/8)==flr(fd.x/8)
   and flr(sl.y/8)==flr(fd.y/8)  then
    embiggen(sl)
    sfx(7)
    coin_production+=1
    del(food,fd)
   end
  end
 end 
end

-- food falling from spawner
function move_food()
 for fd in all(food) do
  if not fd.on_ground and
  not fget(mget(fd.x/8,fd.y/8+1),0) then
   fd.y+=1
  else
   fd.on_ground=true
  end
 end 
end

-- not very good movement code
function move_slimes()
 for sl in all(slimes) do
	 -- left and right
	 if frame==0  then
	 -- pick direction
	  -- -1 or 1
	  local dx=flr(rnd(1.9999))
	  sl.dx = -1+2*dx-- -1 or 1
	 end
	 -- moves small distance at a time and checks for collision each time
	 local dist=0
	 if not sl.jumping then
	  sl.curr_spd=rnd(sl.max_spd*.5)+sl.max_spd*.5
	 end
	 local to_move=sl.curr_spd
	 local step=to_move/2
	 while dist<=to_move do
		 if not collision(sl.dx,sl) then
		  sl.x+=sl.dx*(step)
		 end
		 dist+=step
		end
		if not collision(3,sl) then
		 sl.on_ground=false
		end
		 -- jump
		if (sl.on_ground 
		 and flr(rnd(9.9999))==0
		 and not collision(2,sl))
	 or sl.jumping then
		 dist=0
		 while dist<=to_move do
		  if not collision(2,sl) then
		   sl.y-=step
		  end
		  sl.j_height+=step
		  sl.on_ground=false
		  sl.jumping=true
		  if sl.j_height >= sl.m_height*to_move then
		   sl.jumping=false
		  end
		  dist+=step
		 end
		end
	 -- gravity
	 if not sl.jumping then
		 dist = 0
		 while dist < gravity do
		  if not sl.on_ground then
		   sl.y+=step
		   dist+=step
		   if collision(3,sl) then
		    sl.on_ground=true
		    sl.j_height=0
		   end
		  else
		    break
		  end
		 end
	 end
	end
end

--move camera in the large areas
function control_camera()
 --left
 if btn(0) then
  if cmra.x > cmra.x_lbound then
   cmra.x-=cmra.spd
  end
 end
 --right
 if btn(1) then
  if cmra.x < cmra.x_ubound then
   cmra.x+=cmra.spd
  end
 end
 --up
 if btn(2) then
  if cmra.y > cmra.y_lbound then
   cmra.y-=cmra.spd
  end
 end
 --down
 if btn(3) then
  if cmra.y < cmra.y_ubound then
   cmra.y+=cmra.spd
  end
 end
 move_error()
end

-- repositions the error message display location
-- messages only happen in shop menue so this really isnt needed
function move_error()
 err_pos={cmra.x+14,cmra.y+98}
end

function _update_game()
 frame=(frame+1)%64
 frame_time = abs(time())%64
 -- slimes spawn coins every few seconds
 if abs(frame_time-coin_time) > coin_freq then
  coins+=coin_production
  sfx(4)
  if (coins < 0) coins=32767
  coin_time=frame_time
  coin_a_time=frame_time
 end
 move_food()
 move_slimes()
 control_camera()
 eat()
 if btnp(4) then
  open_shop()
 end
 if btnp(5) then
  coins+=1+flr(#slimes/2)
  if (coins < 0) coins=32767
  sfx(6)
 end
end

function draw_slimes()
-- get the slimes sprite and stretch it to the correct size
 for sl in all(slimes) do
  local rect_x = sl.b_sprt
  local rect_y = 24
  if sl.on_ground then
   rect_x+=0
  elseif sl.jumping then
   rect_x+=8
  else
   rect_x+=16
  end
  sspr(rect_x,rect_y,8,8,sl.x-sl.size/2,sl.y-sl.size/2,sl.size,sl.size)
-- show pixels being checked for collision
--[[pset(sl.x,sl.y,8)
  pset(sl.x-sl.size/2,sl.y,8)
  pset(sl.x+sl.size/2,sl.y,8)
  pset(sl.x,sl.y-sl.size/2,8)
  pset(sl.x,sl.y+sl.size/2,8)
  pset(sl.x-sl.size/2,sl.y+sl.size/2,8)
  pset(sl.x+sl.size/2,sl.y+sl.size/2,8)
  pset(sl.x+sl.size/2,sl.y-sl.size/2,8)
  pset(sl.x-sl.size/2,sl.y-sl.size/2,8)
--]]
 end
end
-- show coins above slimes for a bit
function draw_coins()
 if abs(frame_time-coin_a_time) < coin_a_dur then
  for sl in all(slimes) do
   sspr(24,0,8,8,sl.x-sl.size/2,sl.y-sl.size*1.5,sl.size,sl.size)
  end
 end
end

function draw_food()
 for fd in all(food) do
  spr(fd.sprt,fd.x,fd.y)
 end
end

--shows coins, coin production, and #slimes
function draw_gui()
 local x, y = cmra.x, cmra.y
 rectfill(x,y,x+128,y+7,0)
 spr(3,x,y)
 print(coins,x+8,y+2,9)
 spr(26,x+32,y)
 print(coin_production,x+42,y+2)
 spr(4,x+92,y)
 print(#slimes,x+104,y+2,7)
 print("/",x+112,y+2,7)
 print(slime_cap,x+120,y+2,7)
end

function _draw_game()
 cls()
 camera(cmra.x,cmra.y)
 map(0,0,0,0,128,33)
 draw_food()
 draw_slimes()
 draw_coins()
 draw_gui(cmra)
 --print(frame_time,cmra.x+48,cmra.y,7)
--show coliision info
--[[ for sl in all(slimes) do
 print(collision(2,sl),sl.x,sl.y-12,8)
 print(collision(3,sl),sl.x,sl.y+12,8)
 print(collision(-1,sl),sl.x-24,sl.y,8)
 print(collision(1,sl),sl.x+18,sl.y,8)
 end--]]
end

----------- shop ----------------
function open_shop()
 _update = _update_shop
 _draw = _draw_shop
 prv_pos={cmra.x,cmra.y}
 move_camera(shop_area)
 selection=0
end

function close_shop()
 _update = _update_game
 _draw = _draw_game
 move_camera(areas[curr_area])
 if cmra.x<prv_pos[1] then
  cmra.x=prv_pos[1]
 end
 if cmra.y<prv_pos[2] then
  cmra.y=prv_pos[2]
 end
end

function move_camera(area)
 local x1,x2=area.x1,area.x2
 local y1,y2=area.y1,area.y2
 cmra.x, cmra.y = x1*8,y1*8
 cmra.x_lbound = x1*8
 cmra.y_lbound = y1*8
 cmra.x_ubound = x2*8-128
 cmra.y_ubound = y2*8-128
 move_error()
end

function buy(sel)
 sel+=1
 local item=stock[sel]
 local price=item.price
 local action=item.action
 if coins>=price then
	 if action==0 then
	  if spawn_slime() then
	   coins-=price
	   item.price=flr(price*1.5)
	   close_shop()
	  else
	   err_msg=err_msgs[flr(rnd(2.99))+1]
	   err_time=time()
	  end
	 elseif action==1 then
	  if spawn_food() then
	   coins-=price
	   item.price+=5
	   close_shop()
	  else
	   err_msg=err_msgs[4]
	   err_time=time()
	  end
	 elseif action==2 then
	  if next_area() then
	   coins-=price
	   item.price*=3
	   close_shop()
	  else
	   err_msg=err_msgs[flr(rnd(2.99))+7]
	   err_time=time()
	  end
	 end
	else
	   err_msg=err_msgs[flr(rnd(1.99))+5]
	   err_time=time()
	end
end

-- print the appropriate error message onto the screen
function draw_err()
 if err_time!=nil and abs(frame_time-err_time) < err_dur then
  print(err_msg,err_pos[1],err_pos[2],7)
 end
end

function _update_shop()
 frame_time = time()
 -- move cursor up
 if btnp(2) then
  selection-=1
  sfx(5)
  if (selection<0) selection=0
 -- move cursor down
 elseif btnp(3) then
  selection+=1
  sfx(5)
  if (selection>#stock-1) selection=#stock-1
 -- leave shop
 elseif btnp(4) then
  close_shop()
 -- buy something
 elseif btnp(5) then
  buy(selection)
 end
 
end

function _draw_shop()
 cls()
 camera(0,128)
 map(0,0,0,0,128,32)
 draw_gui()
 draw_err()
 local x,y = 16,154
 local offset=0
 for each in all(stock) do
  print(each.name,x,y+offset,7)
  print(each.price,x+80,y+offset)
  offset+=16
 end
 offset=selection*16
 rect(x-4,y-4+offset,x+99,y+offset+8)
end
