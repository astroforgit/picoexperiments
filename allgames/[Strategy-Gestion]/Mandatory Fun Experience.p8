pico-8 cartridge // http://www.pico-8.com
version 1
__lua__
--mandatory fun experience 
--by mozz
menu = {"raise","charm","blank","end"}
menu2 = {"place","crash","manor","condo","goback"}
tickerlist = {"your humors are our pleasure your humors are our pleasure","bloop","six-niner-zero-oblique-five-four","look up at the shining worm and see her red scales and feel the enjoyment","have you seen to your children today?","hahahahahahahoaposduhhahahahah238382hahaa"}
randalph = {"a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z","1","2","3","4","5","6","7","8","9","0","!","@","#","$","%","^"}
prices = {10,25,100,999}

function make_spark(k,x,y,col,life)
local s = {}
s.kind = k
s.x = x
s.y = y
s.col = col
s.destx = x
s.desty = y
s.dx = .2+rnd(2)-1
s.dy = .2+rnd(2)-.5
s.life = life
add(spark,s)
return s
end

function make_tile(x,y,number,k)
local t = {}
t.x = x
t.y = y
t.kind = k
t.number = number
t.corruption =20
t.building = 0
t.timer = 0
t.cchold = 0
t.life = 10
if k == 1 then
t.sprite = 2 + flr(rnd(8))
end
add(tile,t)
return t
end

function make_actor(x,y,k)
local pl = {}
pl.x = x pl.y = y
pl.kind = k
pl.life = 10
pl.destx = x
pl.desty = y
pl.dest = 0
pl.dx = .2
pl.dy = .2
pl.f0 = 0 
pl.timer = 20 +rnd(10)
if k == 1 then
pl.sprite = 59
end
if k == 2 then
pl.sprite = 68
pl.speed =.1
end
if count(actor) <9 or k==1 then
add(actor,pl)
end
return pl
end

function update_tile(ti)

if ti.corruption < 10 then
	for a1 in all(tile) do
		if a1.number == ti.number-1 then
			a1.corruption = min(ti.corruption+3,a1.corruption )
		end
		if a1.number == ti.number+1 then
			a1.corruption = min(ti.corruption+3,a1.corruption )
		end
		if a1.number == ti.number+12 then
			a1.corruption = min(ti.corruption+3,a1.corruption )
		end
		if a1.number == ti.number-12 then
			a1.corruption = min(ti.corruption+3,a1.corruption )
		end
	end

end
end

function _init()
gameover=false
respawn=0
blankstring = ""
pressed=false
intro = 2 
t=0
spark = {}
tile = {}
actor = {}
cursor ={}
cursor.x = 9
cursor.y = 1
cursor.dx = 0
cursor.dy = 0
cursor.destx = 9
cursor.desty = 1
cursor.menu = 1
cursor.state = 1
globalbuild = 0 
player = make_actor(9,7,1)
level=1
player.state=1
buildingexists=false
randstart = flr(rnd(36)+11)
randstart2 = randstart+(flr(rnd(4))+1)+12*flr(rnd(2))
randbuilding = {flr(rnd(36)+100),flr(rnd(36)+100),flr(rnd(36)+100),flr(rnd(36)+100),flr(rnd(36)+100)}

tickernum = 1
cc = 0
for y=0,11 do
	for x=0,11 do
		ti_temp = make_tile(x,y,x+(12*y),1)
		for i=1,5 do
			if randbuilding[i] == ti_temp.number then
			ti_temp.building = 6
			ti_temp.timer = 150 + rnd(50)
			ti_temp.rndbld = flr(rnd(4))
			end
		end
		if ti_temp.number == randstart then
			ti_temp.corruption = 0
		end
		if ti_temp.number == randstart2 then
			ti_temp.corruption = 6
		end
		
end end
 foreach(tile,update_tile)
 foreach(tile,update_tile)
 foreach(tile,update_tile)
end

function build(cur,building)
	for a1 in all(tile) do
		if a1.x == cur.x and a1.y == cur.y then
			if a1.building == 0 then
				buildingexists = true
				if globalbuild == 3 then
					level =2
				end
				a1.building = building
				a1.corruption = min(a1.corruption,9)
				foreach(tile,update_tile)
				return true
			else
				return false
			end
		end
	end
end

function draw_aggro()
for a1 in all(actor) do
	if a1.kind == 2 then
		a1.dest = 1
		a1.destxoffset = rnd(3)
		a1.destyoffset = rnd(3)
	end
end
end
function get_target(army)
	for a1 in all(tile) do
		if a1.building > 0 and a1.building < 6 and rnd(10)>5 then
			army.destx1 = a1.x
			army.desty1 = a1.y
			army.dest = 2
			return						
		end
	end
end
function leech_building(a1,a2)
if a1.number == a2.number-1 or a1.number == a2.number+1 or a1.number == a2.number-12 or a1.number == a2.number+12 then 
if a2.cchold < 4  then a2.corruption -=.5 a2.cchold +=1 end
end
end
function update_building()
	for a1 in all(tile) do
	if a1.life < 0 then
		a1.building = 0
		a1.life = 10
	end
	if anytargeting(a1,2) and a1.building !=0 and a1.building !=6 then
		a1.life -=.05
	end
	a1.timer -=1
		if a1.timer < 0 then
			if a1.building ==6 then
				a1.timer = 200
				army = make_actor(a1.x,a1.y,2)
				army.destx1 = a1.x + rnd(3)-1.5
				army.desty1 = a1.y + rnd(3)-1.5
			

			end
			if a1.building ==1 then
				
				a1.timer = 100
				for a2 in all(tile) do
					leech_building(a1,a2)
				end
				foreach(tile,update_tile)
				foreach(tile,update_tile)
				foreach(tile,update_tile)
			end
			if a1.building ==2 then
				level = min(level+.05,4)
			end
			if a1.building ==3 then
				player.life = min(player.life+.05,10)
			end
			if a1.building ==4 then
				gameover = true
			end
		end
	end
end
function harvest()
cctemp = 0
for a1 in all(tile) do
cctemp += a1.cchold
a1.cchold=0
end
cc += cctemp
end

function move_cursor(cur)

if cursor.state == 1 then
if cursor.x == cursor.destx and cursor.y == cursor.desty then 	
		if btnp(0) then
			cursor.destx -=1
		end
		
		if btnp(1) then
			cursor.destx +=1
		end
		
		if cursor.destx < 0 then
			cursor.destx = 11
		end
		if cursor.destx > 11 then
			cursor.destx = 0
		end
		if btnp(2) then
			cursor.desty -=1
		end
		
		if btnp(3) then
			cursor.desty +=1
		end
		if cursor.desty > 11 then
			cursor.desty = 0
		end
		if cursor.desty < 0 then
			cursor.desty = 11
		end
		cursor.dx = (cursor.destx- cursor.x)/4
		cursor.dy = (cursor.desty- cursor.y)/4
	else
		cursor.x += cursor.dx
		cursor.y += cursor.dy
	end

	if btnp(4) then
		player.destx = cursor.destx
		player.desty = cursor.desty
	end
	
	if btnp(5) then
		cursor.state=2
		blankstring = ''
		for i=1,6 do
			tempchar = randalph[flr(1+rnd(42))]
			blankstring = blankstring.. tempchar
		end
		menu[3]=blankstring
	end
else

if cursor.state == 3 then
	if btnp(2) then
		cursor.menu = cursor.menu-1
			if cursor.menu > level and cursor.menu < 5 then
				cursor.menu = level
			end
	end
	if btnp(3) then
		cursor.menu = cursor.menu+1
			if cursor.menu > level and cursor.menu < 5 then
				cursor.menu =5
			end
	end

	if cursor.menu > 5 then cursor.menu = 1 end
	if cursor.menu < 1 then cursor.menu = 5 end
	
	if btnp(5) then
		if cursor.menu == 1 and level>=1 then
			if cc >= 10 then
				if build(cursor,1) then
					cc -= 10
					globalbuild +=1
					cursor.state = 1
					cursor.menu = 1
				end
			end
		end
		if cursor.menu == 2 and level>=2 then
			if  cc >= 25 then
				if build(cursor,2)   then
					cc -= 25
					cursor.state = 1
					cursor.menu = 1
				end
			end
		end
		if cursor.menu == 3 and level>=3 then
			if  cc >= 100 then
				if build(cursor,3)  then
					cc -= 100
					cursor.state = 1
					cursor.menu = 1
				end
			end
		end
		if cursor.menu == 4 and level>=4 then
			if  cc >= 999 then
				if build(cursor,4)  then
					cc -= 999
					cursor.state = 1
					cursor.menu = 1
				end
			end
		end
		if cursor.menu == 5 then
			cursor.state = 2
			cursor.menu = 1
		end
	end
else

if cursor.state == 2 then
	if btnp(2) then
		cursor.menu = cursor.menu-1
	end
	if btnp(3) then
		cursor.menu = cursor.menu+1
	end
	
	if cursor.menu > 4 then cursor.menu = 1 end
	if cursor.menu < 1 then cursor.menu = 4 end
	
	if btnp(5) then
		if cursor.menu == 1 then
			cursor.state = 3
			cursor.menu = 1
		end
		if cursor.menu == 2 then
			cursor.state = 1
			player.state=2
			player.sprite=56
		end
		if cursor.menu == 3 then
			cursor.state = 1
			player.state=3
			player.sprite=71
			draw_aggro()
			harvest()
		end
		if cursor.menu == 4 then
			cursor.state = 1
			cursor.menu = 1
		end
	end
end

end end

end
function move_spark(s)
s.life -=1
if s.kind == 1 then
	if s.x == mid(s.destx-.2,s.x,s.destx+.2) and s.y == mid(s.desty-.2,s.y,s.desty+.2) then
	s.destx += (.3-rnd(.6))
	s.desty += (.3-rnd(.6))
	s.dx = s.destx - s.x
	s.dy = s.desty - s.y
	end
	s.x += s.dx
	s.y += s.dy
end
if s.kind == 2 then
	s.x -= s.dx
	s.y += s.dy	
end	
	if s.life <0 then
	del(spark,s)
	return
	end
end
function anytargeting(pl,check)
for a1 in all(actor) do
	if a1.kind == 2 then
		if (a1.x <= pl.x+.5 and a1.x >= pl.x-.5) and (a1.y <= pl.y+.5 and a1.y >= pl.y-.5)  and a1.dest == check then
		return true
		end
	end
end
return false
end
function charm(pl)
	if pl.kind == 2 and (pl.x > player.x-2 and pl.x < player.x+2 and pl.y > player.y-2 and pl.y < player.y+2) then
		pl.life -= 2
		if pl.life < 0 then
			cc += 5
		end
	end
end
function move_player(pl)
	if anytargeting(pl,1) and t%6>3 then
	player.life -=.05
	else
	player.life =min(player.life+.005,10)
	end
	pl.f0 += .2
	if pl.f0 > 3 then
		pl.f0 = 0
	end
if player.state == 1 then
	if player.x != player.destx or player.y != player.desty then
		pl.x += pl.dx*sgn(player.destx-player.x)
		pl.y += pl.dy*sgn(player.desty-player.y)
	end
	if abs(player.x - player.destx) <= player.dx then
		player.x = player.destx
	end
	if abs(player.y - player.desty) <= player.dy then
		player.y = player.desty
	end
end
if player.state == 2 then
	player.life -=.15
	if t%5 == 0 then
		foreach(actor,charm)
	end
	if btnp(4) or btnp(5) then
		player.state = 1
		player.sprite = 59
	end
end
if player.state == 3 then
	if btnp(4) or btnp(5) then
		player.state = 1
		player.sprite = 59
	end
end
	if pl.life < 0 then
		for i=0,20 do
			make_spark(2,pl.x*8+32,pl.y*8+21,10,10)
		end
		respawn = 100
		del(actor,player)
		return
	end

end
function move_army(pl)
	
	if pl.life < 0 then
		for i=0,20 do
			make_spark(2,pl.x*8+32,pl.y*8+21,8,10)
		end
		del(actor,pl)
		return
	end
	pl.f0 += .2
	pl.timer -=1
	if pl.f0 > 3 then
		pl.f0 = 0
	end
	if pl.timer<0 then
		pl.destxoffset = rnd(3)
		pl.destyoffset = rnd(3)
		pl.destx = mid(0,pl.destx1+ pl.destxoffset-1.5, 11)
		pl.desty = mid(0,pl.desty1+ pl.destyoffset-1.5, 11)
		pl.timer=30
	end
	
	if pl.x != pl.destx or pl.y != pl.desty then
		pl.x += pl.dx*sgn(pl.destx-pl.x)
		pl.y += pl.dy*sgn(pl.desty-pl.y)
	end
	pl.dx = pl.speed
	pl.dy = pl.speed
	if abs(pl.x - pl.destx) <= pl.dx then
		pl.dx = 0
	end
	if abs(pl.y - pl.desty) <= pl.dy then
		pl.dy = 0
	end
	if pl.dest == 1 then
		pl.destx1 = player.x
		pl.desty1 = player.y
	end
	if pl.dest == 0 then
		get_target(pl)
	end
end

function move_actor(pl)
 if pl.kind == 1 then
	move_player(pl)
 end
  if pl.kind == 2 then
	move_army(pl)
 end
 end

function _update()
 foreach(spark,move_spark)
if intro == 2 then
	if t%500 == 0 and count(spark) < 10 then
	 make_spark(1,48+rnd(32),35+rnd(24),5+flr(rnd(3)),100)
	end
	 if btnp(0) or  btnp(1)or  btnp(2)or  btnp(3)or  btnp(4)or  btnp(5) and t >5 then
		intro -= 2
	 end
end
if intro == 0 then
if respawn >0 then
	respawn -=1
	if respawn <1 then
		player = make_actor(randstart%12,flr(randstart/12+.1),1)
		player.state = 1
		
		for i=0,20 do
			make_spark(1,player.x*8+28+rnd(8),player.y*8+20+rnd(8),5+flr(rnd(3)),50+rnd(50))
			make_spark(2,player.x*8+32,player.y*8+21,8,10)
		end
	end
end

 foreach(actor,move_actor)
 if player.life > 0 then move_cursor(cursor) end

update_building()

 t += 1
 end
end

function draw_tile(ti)
		
		if ti.corruption <=10 then
			ti.sprite = 22
		end
		if ti.corruption < 9 then
			ti.sprite = 23
		end
	

	if ti.building == 6 then
		sspr(16+ti.rndbld*8,16,8,16,ti.x*8+32,ti.y*8+16)
	else
		spr(ti.sprite,ti.x*8+32,ti.y*8+24)
	end
	if ti.corruption < 1 and ti.building == 0 then
			sspr(48,16,8,16,ti.x*8+32,ti.y*8+16)
	end
	if ti.building == 1 then
		spr(41,ti.x*8+32,ti.y*8+24)
	end
	if ti.building == 2 then
		spr(24,ti.x*8+32,ti.y*8+24)
	end
	if ti.building == 3 then
		spr(25,ti.x*8+32,ti.y*8+24)
	end
	if ti.building == 4 then
		spr(55,ti.x*8+32,ti.y*8+24)
	end
	--print (ti.corruption,ti.x*8+32,ti.y*8+24)
	if ti.life < 10 then
		rectfill(ti.x*8+31,ti.y*8+32,ti.x*8+31+ti.life,ti.y*8+32,14)
	end
end

function draw_spark(s)
circfill( s.x, s.y,0,s.col)
end

function draw_actor(pl)
if pl.kind == 1 then
	pal(11,0)
	spr(pl.sprite+flr(pl.f0),pl.x*8+32,pl.y*8+21)
	pal()
else
	spr(pl.sprite+flr(pl.f0),pl.x*8+32,pl.y*8+25)

end
if pl.life < 10 then
rectfill(pl.x*8+31,pl.y*8+18,pl.x*8+31+pl.life,pl.y*8+20,14)
end
end
function draw_cursor(pl)
	if pl.state == 1 then
		pal(7,2)
		spr(48,pl.x*8+32,pl.y*8+24)
		pal()
		spr(48,pl.x*8+31,pl.y*8+23)
	else
		spr(48,pl.x*8+32,pl.y*8+24)
	end

	if pl.state == 2 then
	rect(-1,22+pl.menu*16,26,31+pl.menu*16,0)
	rectfill(0,23+pl.menu*16,26,30+pl.menu*16,1)
	
		for x=1,4 do
			print (menu[x],2,25+x*16,6)
			print (menu[x],2,24+x*16,0)
			print (menu[pl.menu],2,25+pl.menu*16,0)
			print (menu[pl.menu],2,24+pl.menu*16,9)
		end
	end
	
	if pl.state == 3 then
	rect(-1,18+pl.menu*16,26,27+pl.menu*16,0)
	rectfill(0,19+pl.menu*16,26,26+pl.menu*16,1)
	
		for x=1,5 do
			if x > level and x < 5  then
				for x1=0,26 do
					for y1=0,8 do
						pset(x1,y1+18+x*16,5+flr(rnd(3)))
					end 
				end
			else
				print (menu2[x],2,21+x*16,6)
				print (menu2[x],2,20+x*16,0)
				print (menu2[pl.menu],2,21+pl.menu*16,0)
				print (menu2[pl.menu],2,20+pl.menu*16,9)
			end
		end
	end	
	
end
function draw_logo()
	print("sovereign",46,66,5)
	print("sovereign",46,65,6)
	sspr(0,0,16,24,56,40)
end

function ticker(str)
 print(str,t%(130+#str*4)-#str*4,122,5)
 print(str,t%(130+#str*4)-#str*4,121,6)


end

function _draw()
 cls()

 if gameover == false then
	 ticker(tickerlist[tickernum])
	   if t%400>0 and t%400<10 then
		tickernum = flr(rnd(6)+1)
		rectfill(0,121,127,127,10)
	end
	 if intro == 2 then
		draw_logo()
	 end

	 if intro == 0 then
		foreach(tile,draw_tile)
		foreach(actor,draw_actor)
		if player.life > 0 then draw_actor(player) end
		
		map(0,0,0,0,16,16)
		draw_cursor(cursor)
		pal()
		cc1 = flr(cc/100)
		cc2 = flr(cc/10)%10
		cc3 = cc%10
		ccprint = {cc1,cc2,cc3}
		for j=1,3 do
			print(ccprint[j],91+j*8,10,9)
		end
		if respawn > 0 then
			rectfill(0,5,respawn*1.28,7,8)
		end
		if cursor.state == 3 and cursor.menu < 5 then
			cc1 = flr(prices[cursor.menu]/100)
			cc2 = flr(prices[cursor.menu]/10)%10
			cc3 = prices[cursor.menu]%10
			ccprint = {cc1,cc2,cc3}
			for j=1,3 do
				print(ccprint[j],j*8-5,10,9)
			end
			--print(prices[cursor.menu],19,10,9)
		end
	end
	else
		print("the prince has arrived",25,50,9)
	end
	 foreach(spark,draw_spark)
end
