pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
--picoteras
--v 1.0

function _init()
 t=0
 year=0
 phase=0
 opt=0
 cls()
 size=60
 print("choose scale...",0,0,7)
 print("(press Ž to select)",0,42,7)
 rectfill(0,13,28,19,7)  
 print("60x60",1,14,0)
 print("80x80",1,21,7)
 print("100x100",1,28,7)
 while phase<1 do
  init_params()
 end
 n=16+opt*16
 max_hive=4+opt*4
 max_wasp=16
 scale=16
 nrst={}
 range={}
 phys=size*scale
 posx=phys/2
 posy=phys/2
 target=nil
 vx=0
 vy=0
 spd=0
 hdg=0
 swarm=0
 threat=0
 allies=0
 mad=false
 hud=true
 intro=true
 the_end=false
 biome=100
 enrgy=100
 score=0
 xplre=0
 kills=0
 cltrl=0
 war=false
 exp=false
 con=false
 ext=false
 dip=false
 pac=false
 sur=false
 genocide=false
 vic=0
 obj=1
 cls()
 init_intro()
 init_suns(n)
 init_swarm(swarm)
 init_wasps(2)
 draw_back()
 print("loading...",0,96,13)
 draw_orbital()
 init_plots()
 draw_back()
 print("pressŽ",0,96,13)
 print("to launch...",0,103,13)
end

function init_params()
 if btn(3) then
  rectfill(0,(opt+2)*7-1,28,(opt+3)*7-2,0)  
  print(size.."x"..size,1,(opt+2)*7,7)   
  opt=(opt+1)%3
  size=60+opt*20
  rectfill(0,(opt+2)*7-1,28,(opt+3)*7-2,7)  
  print(size.."x"..size,1,(opt+2)*7,0)   
  while btn(3) do
  end
 end
 if btn(2) then
  rectfill(0,(opt+2)*7-1,28,(opt+3)*7-2,0)  
  print(size.."x"..size,1,(opt+2)*7,7)   
  opt=(opt+2)%3
  size=60+opt*20
  rectfill(0,(opt+2)*7-1,28,(opt+3)*7-2,7)  
  print(size.."x"..size,1,(opt+2)*7,0)   
  while btn(2) do
  end
 end
 if btnp(5) then
  phase=1
 end 
end

function init_intro()
 for y=0,127 do
  for x=96,127 do 
   if y%16==0 then
    sset(x,y,1)
   else
    sset(x,y,1)
   end
  end
 end
 local land={}
 for i=1,64 do
  land[i]={}
  ok=false
  land[i].y=flr(rnd()*128)  
  while not ok do
   land[i].x=96+flr(rnd()*32)
   ok=sget(land[i].x,land[i].y)==1
  end
  sset(land[i].x,land[i].y,4)
 end
 for i=1,#land do
  x=land[i].x
  y=land[i].y
  cloud=rnd()<0.33
  for j=1,96 do
   if rnd()<0.5 then
    if rnd()<0.5 then
     x=(x+127)%128
    else
     x=(x+1)%128
    end
   else
    if rnd()<0.5 then
     y=(y+127)%128
    else
     y=(y+1)%128
    end
   end
   if(x>64) then
    if cloud then
     sset(x,y,6+flr(rnd()*2))
    else
     sset(x,y,3+flr(rnd()*3))
    end
   end
  end
 end
 for y=0,127 do
  for x=96,127 do
   if sget(x,y)==1 then
    z=0
    if sget(x-1,y)>2 and sget(x-1,y)<6 then
     z+=1
    end
    if sget((x+1)%128,y)>2 and sget((x+1)%128,y)<6 then
     z+=1
    end
    if sget(x,(y+1)%128)>2 and sget(x,(y+1)%128)<6 then
     z+=1
    end
    if sget(x,(y+127)%128)>2 and sget(x,(y+127)%128)<6 then
     z+=1
    end
    if z>2 then
     sset(x,y,3)
    else
     if z>0 then
      sset(x,y,12)
     end
    end
   end
  end
 end
 sun1=flr(rnd()*3)
 sun2=sun1
 while sun2==sun1 do
  sun2=flr(rnd()*3)
 end
 sun3=sun2
 while sun3==sun2 or sun3==sun1 do
  sun3=flr(rnd()*3)
 end
 dot={}
 for i=1,100 do
  dot[i]={}
  dot[i].x=flr(rnd()*128)
  dot[i].y=flr(rnd()*128)
 end
end

function init_suns(n)
 sun={}
 red=0
 yel=0
 blu=0
 for i=1,n do
  sun[i]={}
  if i<4 then
   if i==1 then
    test=0
   else
    if i==2 then
     test=2
    else
     test=3
    end
   end
  else
   test=rnd()*7
  end
  if test<1 then
   sun[i].c=3
   blu+=1
  else
   if test<3 then
    sun[i].c=2
    yel+=1
   else
    sun[i].c=1
    red+=1
   end
  end
  sun[i].m=2^sun[i].c
  sun[i].found=false
  sun[i].display=false
  ok=false
  while not ok do
   sun[i].x=flr(rnd()*size)*scale
   sun[i].y=flr(rnd()*size)*scale
   ok=true
   j=1
   while ok and j<i do
    dx=sun[i].x-sun[j].x
    dy=sun[i].y-sun[j].y
    torus()
    ok=abs(dx)>5*scale or abs(dy)>5*scale
    j+=1
   end
  end
  if sun[i].c==2 then
   posx=sun[i].x+16
   posy=sun[i].y
   vx=0
   vy=-6
  end
 end
end

function init_plots()
 plot={}
 for i=0,size do
  plot[i]={}
  for j=0,size do
   plot[i][j]={}
   plot[i][j].sun=nil
   plot[i][j].x=0
   plot[i][j].y=0
   for k=1,#sun do
    dx=sun[k].x/scale-i
    if abs(dx)>size/2 then
     dx-=sgn(dx)*size
    end
    dy=sun[k].y/scale-j
    if abs(dy)>size/2 then
     dy-=sgn(dy)*size
    end
    r=sqrt(dx*dx+dy*dy)
    if r==0 then
     plot[i][j].sun=sun[k]
    else
     if r<5 then
      plot[i][j].x=sun[k].m/r*dx/r
      plot[i][j].y=sun[k].m/r*dy/r
     end
    end
   end
  end
 end
end

function launch_bee()
 i=#bee+1
 bee[i]={}
 bee[i].x=posx-1+rnd()*2
 bee[i].y=posy-1+rnd()*2
 bee[i].trgt=nil
 bee[i].vx=rnd()*2-1
 bee[i].vy=rnd()*2-1
 r=sqrt(bee[i].vx*bee[i].vx+bee[i].vy*bee[i].vy)
 bee[i].vx/=r
 bee[i].vy/=r
end

function attack()
 short=1024
 j=nil
 for i=1,#bee do
  if bee[i].trgt==nil then
   dx=target.x-bee[i].x
   dy=target.y-bee[i].y
   if abs(dx)+abs(dy)<short then
    short=abs(dx)+abs(dy)
    j=i
   end
  end
 end
 if j!=nil then
  bee[j].trgt=target
 end
end

function launch_wasp(hive)
 j=#hive.wasp+1
 nwasps+=1
 hive.wasp[j]={}
 hive.wasp[j].hive=hive
 hive.wasp[j].x=hive.x-1+rnd()*2
 hive.wasp[j].y=hive.y-1+rnd()*2
 hive.wasp[j].vx=rnd()*2-1
 hive.wasp[j].vy=rnd()*2-1
 r=sqrt(hive.wasp[j].vx^2+hive.wasp[j].vy^2)
 hive.wasp[j].vx/=r
 hive.wasp[j].vy/=r
 hive.wasp[j].mad=false
 hive.wasp[j].alert=false
end


function init_swarm(n)
 bee={}
 for i=1,n do
  launch_bee()  
 end
end

function init_wasps()
 nwasps=0
 hive={}
 for i=1,2 do
  hive[i]={}
  hive[i].known=false
  hive[i].hostile=i==1
  if hive[i].hostile then
   threat+=1
  end
  hive[i].mad=hive[i].hostile
  hive[i].wasp={}
  ok=false
  while not ok do
   hive[i].home=sun[1+flr(rnd()*#sun)]
   ok=hive[i].home.c==1
   j=1
   while ok and j<i do
    ok=hive[i].home!=hive[j].home
    j+=1
   end
  end
  hive[i].x=hive[j].home.x
  hive[i].y=hive[j].home.y
  hive[i].vx=0
  hive[i].vy=0
  hive[i].swarm=4
  for j=1,hive[i].swarm do
   launch_wasp(hive[i])
  end
 end
end

function budding(parent)
 k=#hive+1
 if k<=max_hive then
  hive[k]={}
  hive[k].ignore=false
  hive[k].hostile=rnd()<0.5
  if hive[k].hostile then
   threat+=1
  end
  hive[k].mad=hive[k].hostile
  hive[k].home=parent.home
  hive[k].x=parent.x
  hive[k].y=parent.y
  hive[k].vx=parent.vx
  hive[k].vy=parent.vy
  parent.swarm/=2
  hive[k].swarm=parent.swarm
  hive[k].wasp={}
  while #hive[k].wasp<#parent.wasp do
   transfer=parent.wasp[1]
   transfer.hive=hive[k]
   del(parent.wasp,transfer)
   add(hive[k].wasp,transfer)
  end
 end
end
  
function round(num,dec)
 sign=sgn(num)
 num=abs(num)
 num*=10^dec
 if num-flr(num)>0.5 then
  num=flr(num)+1
 else
  num=flr(num)
 end
 num/=10^dec
 return sign*num
end

function torus()
 if abs(dx)>phys/2 then
  dx-=sgn(dx)*phys
 end
 if abs(dy)>phys/2 then
  dy-=sgn(dy)*phys
 end
end
 
function controls()
 if not the_end then
  if enrgy>0 then
   if btn(0) then
    vx-=0.2
    enrgy-=0.05
   end
   if btn(1) then
    vx+=0.2
    enrgy-=0.05
   end
   if btn(2) then
    vy-=0.2
    enrgy-=0.05
   end
   if btn(3) then
    vy+=0.2
    enrgy-=0.05
   end
  end
  enrgy=max(0,enrgy)
  mad=btn(4)
 end
 if btnp(5) then
  if started then
   if not the_end and vic<obj then
    hud=not hud
   else
    if not the_end then
     obj=vic+1
    end
   end
  else
   started=true
   intro=false
   t=0
  end
 end
end 
 
function _update()
 controls()
 if started and not the_end and vic<obj then
  victory()
  if vic<obj then
   t=(t+1)%1920
   if t%30==0 then
    year+=1
   end
   if mad and t%30==0 and #bee>0 and target!=nil then
    attack()
   end 
   biome=max(0,biome-0.01)
   if biome<=0 then
    the_end=true
   end
   gravity()
   if #bee<flr(swarm) then
    launch_bee()
   else
    while #bee>flr(swarm) do
     del(bee,bee[#bee])
    end
   end
   move_home()
   for i=1,2 do
    move_bees()
   end
   move_wasps()
  end
 end
end 

function gravity()
 nrst={}
 for i=1,3 do
  range[i]=size*scale
 end
 for i=1,#sun do
  dx=sun[i].x-posx
  dy=sun[i].y-posy
  torus()
  dx/=scale
  dy/=scale
  r2=dx*dx+dy*dy
  r=sqrt(r2)
  if sun[i].found and r<range[sun[i].c] then
   nrst[sun[i].c]=sun[i]
   range[sun[i].c]=r
  end
  if abs(dx)<5 and abs(dy)<5 then
   if not sun[i].found then
    xplre+=1
    score+=4
    sun[i].found=true
   end
   dx*=scale
   dy*=scale 
   r*=scale
   r2*=scale^2
   if r<sun[i].c then
    the_end=true
   else
    vx+=dx/r*10*sun[i].m/r2
    vy+=dy/r*10*sun[i].m/r2
    if sun[i].c==1 then
     swarm=min(32,swarm+2/r2)
    else 
     if sun[i].c==2 then
      biome=min(100,biome+8/r2)
     else
      enrgy=min(100,enrgy+8/r2)
     end
    end
   end
  end
  if sun[i].c==1 then
   for j=1,#hive do
    if hive[j].home==sun[i] then
     if hive[j].vx==0 and hive[j].vy==0 then
      hive[j].swarm=min(max_wasp,hive[j].swarm+0.01)
      if hive[j].swarm==max_wasp then
       budding(hive[j])
      end
      if flr(hive[j].swarm)>#hive[j].wasp and nwasps<128 then
       launch_wasp(hive[j])
      end
     end
    end
   end
  end
 end
end
  
function move_home()
 vx=min(64,max(-64,vx))
 vy=min(64,max(-64,vy))
 spd=sqrt(vx*vx+vy*vy)
 hdg=atan2(vx,vy)
 if abs(spd)>16 then
  r=16/abs(spd)
  vx*=r
  vy*=r
  spd*=r
 end
 posx=(posx+phys+vx/16)%phys
 posy=(posy+phys+vy/16)%phys
end

function move_bees()
 i=1
 while i<=#bee do
  x=bee[i].x
  y=bee[i].y
  if not btn(4) then
   bee[i].trgt=nil
  end
  if bee[i].trgt==nil then
   dx=posx-x
   dy=posy-y
  else
   dx=bee[i].trgt.x-x
   dy=bee[i].trgt.y-y
  end
  torus()
  r=sqrt(dx*dx+dy*dy)  
  if bee[i].trgt!=nil and r<1 then
   for j=1,#bee do
    if i!=j and bee[j].trgt==bee[i].trgt then
     bee[j].trgt=nil
    end
   end
   if target==bee[i].trgt then
    target=nil
   end
   del(bee[i].trgt.hive.wasp,bee[i].trgt)
   nwasps-=1
   bee[i].trgt.hive.swarm-=1
   if bee[i].trgt.hive.hostile then
    score+=1
    kills+=1
   else
    score-=1
    cltrl+=1
   end
   if #bee[i].trgt.hive.wasp<1 then
    del(hive,bee[i].trgt.hive)
    if bee[i].trgt.hive.hostile then
     score+=10
     threat-=1
    else
     score-=10
     genocide=true
    end
   else
    bee[i].trgt.hive.mad=true
   end
   del(bee,bee[i])
   swarm-=1
  else
   if r>0 then
    bee[i].vx+=0.2*dx/r
    bee[i].vy+=0.2*dy/r
   end 
   r=sqrt(bee[i].vx^2+bee[i].vy^2)
   bee[i].vx/=r
   bee[i].vy/=r
   bee[i].x=(x+bee[i].vx+phys)%phys
   bee[i].y=(y+bee[i].vy+phys)%phys
   i+=1
  end
 end
end

function move_wasps()
 short=128
 target=nil
 i=1
 while i<=#hive do
  if hive[i].vx==0 and hive[i].vy==0 then
   if rnd()<0.001 then
    ok=false
    hive[i].mad=hive[i].hostile
    while not ok do
     hive[i].home=sun[1+flr(rnd()*#sun)]
     dx=hive[i].home.x-hive[i].x
     dy=hive[i].home.y-hive[i].y
     torus()
     ok=abs(dx)>scale or abs(dy)>scale
    end
    alpha=atan2(dx,dy)
    hive[i].vx=cos(alpha)/4
    hive[i].vy=sin(alpha)/4
   end
  else
   hive[i].x=(hive[i].x+hive[i].vx+phys)%phys
   hive[i].y=(hive[i].y+hive[i].vy+phys)%phys 
   dx=hive[i].home.x-hive[i].x
   dy=hive[i].home.y-hive[i].y
   torus()
   if abs(dx)+abs(dy)<1 then
    hive[i].vx=0
    hive[i].vy=0
    hive[i].x=hive[i].home.x
    hive[i].y=hive[i].home.y
   end
  end
  j=1
  while j<=#hive[i].wasp do
   x=hive[i].wasp[j].x
   y=hive[i].wasp[j].y
   if not hive[i].wasp[j].mad then
    dx=hive[i].x-x
    dy=hive[i].y-y
   else
    dx=posx-x
    dy=posy-y
   end
			torus()
			if abs(dx)<64 and abs(dy)<64 then
    r=sqrt(dx*dx+dy*dy)
    if r<1 and hive[i].wasp[j].mad then
     biome/=2
     del(hive[i].wasp,hive[i].wasp[j])
     hive[i].swarm-=1
     nwasps-=1
    else
     hive[i].wasp[j].alert=false
     hive[i].wasp[j].mad=false
     if r>0 then
      hive[i].wasp[j].vx+=0.2*dx/r
      hive[i].wasp[j].vy+=0.2*dy/r
     end
     r=sqrt(hive[i].wasp[j].vx^2+hive[i].wasp[j].vy^2)
     hive[i].wasp[j].vx/=r
     hive[i].wasp[j].vy/=r
     hive[i].wasp[j].x=(x+hive[i].wasp[j].vx+phys)%phys
     hive[i].wasp[j].y=(y+hive[i].wasp[j].vy+phys)%phys
     dx=posx-hive[i].wasp[j].x
     dy=posy-hive[i].wasp[j].y
     torus()
     if abs(dx)<48 and abs(dy)<48 then
      hive[i].wasp[j].alert=hive[i].mad
      if not hive[i].known and 
       not hive[i].hostile and
       not hive[i].mad then
       allies+=1
      end
      hive[i].known=true
      if abs(dx)<32 and abs(dy)<32 then   
       hive[i].wasp[j].mad=hive[i].mad
      end
     end
     if abs(dx)+abs(dy)<short then
      short=abs(dx)+abs(dy)
      target=hive[i].wasp[j]
     end
    end
   else
    del(hive[i].wasp,hive[i].wasp[j])
    launch_wasp(hive[i])
   end
   j+=1
  end
  if #hive[i].wasp<1 then
   if hive[i].hostile then
    threat-=1
   end
   del(hive,hive[i])
  else
   i+=1
  end
 end
end

function victory()
 if threat==0 then
  if #hive==max_hive then
   war=true
  end
 end
 ext=#hive==0
 exp=xplre==#sun
 con=exp and war and not ext
 dip=war and not genocide and allies==#hive
 pac=exp and kills==0
 sur=year>1999
 phi=(dip or pac) and sur
 vic=0
 if war then vic=1 end
 if ext then vic=2 end
 if exp then vic=3 end
 if con then vic=4 end
 if dip then vic=5 end
 if pac then vic=6 end
 if sur then vic=7 end
 if phi then vic=8 end
 if obj<vic then
  obj=vic
 end
end

function draw_back()
 cls()
 for i=1,#dot do
  pset(dot[i].x,dot[i].y,7)
 end
 rectfill(0,19,38,28,0)
 rectfill(0,29,55,35,0)
 sspr(0,16,38,9,0,20)
 print("by fuchikoma71",0,30,13)
 rectfill(15,63,25,73,0)
 rectfill(99,89,109,99,0)
 rectfill(118,0,127,10,0)
 sspr(sun1*16,0,9,9,16,64)
 sspr(sun2*16,0,9,9,100,90)
 sspr(sun3*16,0,9,9,119,0)
end

function draw_orbital() 
 t=(t+1/6)%1920
 for y=0,127 do
  dx=4
  if y>64 then
   dx=4*(2+(sin(y/255)))^4
  else
   if y<65 then
    dx=4*(2+(sin(y/255)))^2
   end
  end
  sspr(96,(y+128-t)%128,31,1,63-dx+y/8,y,2*dx+1,1)
 end
end

function draw_map()
 clip(93,93,127,127)
 rectfill(93,93,127,127,0)
 for i=1,#sun do
  star=sun[i]
  star.display=false
  dx=star.x-posx
  dy=star.y-posy
  torus()
  dx/=scale
  dy/=scale
  if abs(dx)<16 and abs(dy)<16 then
   x=111+dx
   y=111+dy
   if star.found then
    star.display=true
    sspr((star.c-1)*16,11,5,5,x-2,y-2)
   else
    sspr(48,11,5,5,x-2,y-2)   
   end
  end
 end
 for i=1,#hive do
  dx=hive[i].x-posx
  dy=hive[i].y-posy
  torus()
  dx/=scale
  dy/=scale
  if abs(dx)<16 and abs(dy)<16 then
   x=111+dx
   y=111+dy
   if not hive[i].known then
    col=10
   else
    if hive[i].mad or hive[i].hostile then
     col=8
    else
     col=2
    end
   end
   circ(x,y,(t/2)%8,col)
  end
 end
 for i=1,3 do
  if nrst[i]!=nil and not nrst[i].display then
   if i==1 then
    col=8
   else
    if i==2 then
     col=10
    else
     col=12
    end
   end
   dx=nrst[i].x-posx
   dy=nrst[i].y-posy
   torus()
   ratio=abs(dx/dy)
   if abs(dx)<abs(dy) then
    if dy<0 then
     y=94
     x=111+16*sgn(dx)*ratio
     pset(x,y,col)
     line(x-1,y+1,x+1,y+1,col)
    else
     y=126
     x=111+16*sgn(dx)*ratio
     pset(x,y,col)
     line(x-1,y-1,x+1,y-1,col)
    end
   else
    if dx<0 then
     x=94
     y=111+16*sgn(dy)/ratio
     pset(x,y,col)
     line(x+1,y-1,x+1,y+1,col)
    else
     x=126
     y=111+16*sgn(dy)/ratio
     pset(x,y,col)
     line(x-1,y-1,x-1,y+1,col)
    end
   end
  end
 end
 rect(93,93,127,127,3)
 line(110,93,110,103,3)
 line(110,117,110,127,3)
 line(93,110,103,110,3)
 line(117,110,127,110,3)
 clip()
end    

function draw_game()
 cls()
 camera(0,0)
 zero={}
 i0=flr(posx/scale)
 j0=flr(posy/scale)
 shift_x=posx%scale
 shift_y=posy%scale
 camera(-63+shift_x,-63+shift_y)
 for dx=-4,5 do
  for dy=-4,5 do
   i=(i0+dx+size)%size
   j=(j0+dy+size)%size
   x=dx*scale+plot[i][j].x
   y=dy*scale+plot[i][j].y
   if dx<5 then
    x2=(dx+1)*scale+plot[(i+1)%size][j].x
    y2=dy*scale+plot[(i+1)%size][j].y
    line(x,y,x2,y2,1)
   end
   if dy<5 then
    x2=dx*scale+plot[i][(j+1)%size].x
    y2=(dy+1)*scale+plot[i][(j+1)%size].y
    line(x,y,x2,y2,1)
   end
   if plot[i][j].sun!=nil then
    star=plot[i][j].sun
    sspr(3+(star.c-1)*16-star.c,3-star.c,1+2*(star.c+1),1+2*(star.c+1), 
         x-1-star.c,y-1-star.c)
   end
  end
 end
 if mad then
  friend=11
 else
  friend=3
 end
 for i=1,#bee do
  dx=bee[i].x-posx
  dy=bee[i].y-posy
	 torus()
  pset(shift_x+dx,shift_y+dy,friend)
 end
 local aggressors=0
 local neutrals=0
 for i=1,#hive do
  if hive[i].hostile then
   aggressors+=#hive[i].wasp
  else
   neutrals+=#hive[i].wasp
  end
  for j=1,#hive[i].wasp do
   dx=hive[i].wasp[j].x-posx
   dy=hive[i].wasp[j].y-posy
   torus()
   if hive[i].known and not hive[i].hostile then
    if not hive[i].mad then
     foe=2
    else
     foe=9
    end
   else
    if hive[i].wasp[j].alert then
     if hive[i].wasp[j].mad then
      foe=8
     else
      foe=9
     end
    else
     foe=10
    end
   end
   pset(shift_x+dx,shift_y+dy,foe)
  end
 end
 spr(48+(t/5)%3,shift_x-3,shift_y-3)
 if btn(0) then
  spr(64,shift_x+1,shift_y-3)        
 end
 if btn(1) then
  spr(65,shift_x-7,shift_y-3)        
 end
 if btn(2) then
  spr(66,shift_x-3,shift_y+1)        
 end
 if btn(3) then
  spr(67,shift_x-3,shift_y-7)        
 end
 camera(0,0)
 if hud then
  draw_map()
 end
 if hud or biome<25 or enrgy<25 then
  print("swr:"..round(#bee/32*100,0).."%",0,0,3)
  if biome>25 or t%20<10 then
   print("bio:"..round(biome,0).."%",0,6,3)
  else
   print("bio:"..round(biome,0).."%",0,6,11)
  end 
  if enrgy>25 or t%20<10 then
   print("enr:"..round(enrgy,0).."%",0,12,3)
  else
   print("enr:"..round(enrgy,0).."%",0,12,11)
  end
  print("yrs:"..year,0,111,3)  
  print("xpl:"..round(100*xplre/#sun,0).."%",0,117,3)
  print("scr:"..score,0,123,3)
 end
end

function draw_end()
 rectfill(16,60,112,96,0)
 rect(16,60,112,96,7)
 rectfill(16,32,112,47,0)
 rect(16,32,112,47,7)
 camera(-18,-34)
 final=score
 if the_end then
  print("your civilisation met",0,0,7)
  print("an unfortunate end...",0,7,7)
 else
  final*=2
  if vic>4 then
   final*=2
   if vic==8 then
    final*=2
   end
  end
  if vic==1 then
   print("warrior victory!",14,3,7)
  end
  if vic==2 then
   print("exterminator victory!",4,3,7)
  end  
  if vic==3 then
   print("explorer victory!",12,3,7)
  end
  if vic==4 then
   print("conqueror victory!",10,3,7)
  end
  if vic==5 then
   print("diplomat victory!",12,3,7)
  end
  if vic==6 then
   print("pacifist victory!",12,3,7)
  end
  if vic==7 then
   print("survivor victory!",12,3,7)
  end
  if vic==8 then
   print("philosopher victory!",6,3.7)
  end 
  if vic<8 then
   print("press Ž to continue...",0,17,13)
   if btn(5) then
    obj=3
   end
  end
 end
 print("kills: "..kills,0,28,7)
 print("collaterals: "..cltrl,0,35,7)
 print("explored: "..round(100*xplre/#sun,1).."%",0,42,7)
	print("journey: "..year.." years",0,49,7)
 print("final score: "..final,0,56,7)
 camera(0,0)
end 

function _draw()
 if intro then
  draw_orbital()
 else
  if not the_end and vic<obj then
   draw_game()
  else
   draw_end()
  end
 end
end
