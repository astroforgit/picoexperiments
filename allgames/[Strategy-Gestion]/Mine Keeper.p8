-- variables init

gold = 4
gems = 0
lord = false
gamemode = 0

n=1

timer = 0

bosstimer = 1
bossgold = 0
bossshare = 0
bossanger = 0
bosstext = "faster !"
bosscolor = 10
bossrequest = 3

bossanim = 0
whipanim = 0
healanim = 0
hasteanim = 0
vortexanim = 0

spritehelp1 = {0,0,148,153,158,201,206,196,228,185,176,178,179,180}
spritehelp2 = {0,0,164,169,174,217,222,212,244,186,181,182,183,184}

helpline1 = "- the minekeeper (you)"
helpline2 = "manage workers."
helpline3 = "no need to talk."

helpselec = 1

player = {}
--player stats
player.x = 64

--player gfx
player.sprite = 0
player.selec = 1

selec = {}

selec.x = 47
selec.y = 72
selec.sprite = 33
selec.value = 1
selec.string = "dwarf"

-- boss

function boss_draw(x,y)
	if bossanim > 0 then
	 if timer > 15 then spr (18,x,y,1,2) end
	 if timer <= 15 then spr (19,x,y,1,2) end
	 
	 print (bosstext,10,120,bosscolor)
	end
end

-- workers

worker = {}

function worker_make(x,work,speed,pvmax,sprite0)
 o = {}
 o.x = x
 o.y = 96
 o.pos = 0
 o.infront = 0
 o.work = work
 o.wait = 0
 o.dir = -1
 o.speed = speed
 o.pvmax = pvmax
 o.pv = pvmax
 o.charge = 0
 o.sprite0 = sprite0
 o.sprite = sprite0
 add(worker,o)
end

function worker_buy(type,goldprice,gemprice)
	if (gold >= goldprice and gems >= gemprice) then
		--dwarf
		if type == 1 then 
		 worker_make(player.x,flr(rnd(3))+1,0.7,3,144)
		 sfx (17)
		end
		--lizard
		if type == 3 then 
		 worker_make(player.x,flr(rnd(3))+2,1.2,2,149)
		 sfx (26)
		end
		--goblin
		if type == 4 then 
		 worker_make(player.x,flr(rnd(4))+2,0.6,4,154)
		 sfx (27)
		end
		--taurus
		if type == 5 then 
		 worker_make(player.x,flr(rnd(5))+3,0.3,5,197)
		 sfx (28)
		end
		--blob
		if type == 7 then 
		 worker_make(player.x,flr(rnd(2))+1,0.2,2,202)
		 sfx (29)
		end
		--rock
		if type == 9 then 
		 worker_make(player.x,flr(rnd(3))+2,0.5,3,192)
		 sfx (30)
		end
		
		gold -= goldprice
		gems -= gemprice
		achat = true
		
		--lord
		if (type == 11 and lord == true) then
		 gold += goldprice
		 gems += gemprice
		 achat = false
		end
		
		if (type == 11 and lord == false) then
		 worker_make(player.x,1,0.2,1,224)
		 lord = true
		 sfx (31)
		end
		
				
	end
end

function worker_draw()
 for i=1,#worker do
  if timer > 15 then spr (worker[i].sprite, worker[i].x, worker[i].y) end
  if timer <= 15 then spr (worker[i].sprite+16, worker[i].x, worker[i].y) end
 end
end

------------
dead = {}

function dead_make(x,y,t)
 o = {}
 o.x = x
 o.y = y
 o.t = t
 add (dead,o)
end

function dead_draw()
	for i=#dead,1,-1 do
	
		dead[i].t -= 1
		
		spr(191,dead[i].x,dead[i].y)
		
		if dead[i].t == 0 then del (dead, dead[i]) end
	end
end

------------
bomb = {}

function bomb_make(x)
 o = {}
 o.x = x
 o.y = 96
 o.pos = 0
 o.infront = 0
 o.sprite = 176
 add(bomb,o)
end

function bomb_draw()
 for i=1,#bomb do
  spr (bomb[i].sprite, bomb[i].x, bomb[i].y)
 end
end

------------

function spell_draw()
	


	if (healanim > 0) then
		healanim -= 1
		for i=1,#worker do
			spr (178, worker[i].x,worker[i].y)
		end
	end
	
	if (hasteanim > 0) then
		hasteanim -=1
		for i=1,#worker do
			spr (179, worker[i].x,worker[i].y)
		end
	end
	
	if (vortexanim > 0) then
		vortexanim -= 1
		circfill(64,64,vortexanim*4,1)
		circfill(64,64,vortexanim*3.5,13)
		circfill(64,64,vortexanim*3,6)
		circfill(64,64,vortexanim*2.5,7)
	end
end

------------
--threadmill

function threadmill_draw()
	for i=0,112,8 do
		if timer > 15 then spr (47,i,104) end
		if timer <= 15 then spr (63,i,104) end
	end
	
	if timer > 15 then spr (15,120,104) end
	if timer <= 15 then spr (31,120,104) end
end

------------
-- ressources
ress = {}

function ress_make(x,type,sprite)
 o ={}
 o.x = x
 o.y = 101
 o.type = type
 o.sprite = sprite
 add(ress,o)
end

function ress_draw()
 for i=1,#ress do
  spr (ress[i].sprite, ress[i].x, ress[i].y)
 end
end

------------
-- terrain generation 
terrain = {}

function terrain_clean()
	for i = 182,1,-1 do
		del (terrain, terrain[i])
	end
end

function terrain_make()
	for i=1,13 do
	 for j=1,14 do
	  o = {}
	  o.pos = i
	  o.x = j*8
	  o.y = i*8
	  r = rnd(100)
	  if (0<=r and r<30)then o.type = 0 end
	  if (30<=r and r<35)then o.type = 1 end
	  if (35<=r and r<40)then o.type = 2 end
	  if (40<=r and r<45)then o.type = 3 end
	  if (45<=r and r<50)then o.type = 4 end
	  if (50<=r and r<60)then o.type = 5 end
	  if (60<=r and r<70)then o.type = 6 end
	  if (70<=r and r<95)then o.type = 7 end
	  if (95<=r and r<=100)then o.type = 8 end
	
	  if i >= 12 then o.type = 0 end
	
	  add(terrain,o)
	 end
	end
end

terrain_make()

function terrain_draw()
 for i=1,154 do
	terrain[i].sprite = terrain[i].type+128
	spr (terrain[i].sprite,terrain[i].x,terrain[i].y)	
 end
end

function plate_draw(y)

	spr (51,40,y,6,1)
	spr (42,56,y+8)
	spr (42,64,y+8) 
	spr (22,56,96,2,2)

end

function gold_draw(t,y)

 if t < bossgold then sfx (22) end
 
 if t <= bossgold then
	
	for i = 0,t-1 do
		
		b = y + 4 - 3*flr(i/15)
		a = 42 + i*3 - 45 * flr(i/15) + flr(i/15)%2
		rect (a,b,a+1,b+1,10)
		rect (a,b+1,a,b+1,9)
	end	
	
	print (t,59,102,10)
	
 end
end



--------------------------------------------
function _update()

if gamemode == 4 then

	timer +=1
	
	if (btnp(2) and selec.y > 73)then
		sfx(39)
		helpselec -= 7
		selec.y -= 24
	end
	
	if (btnp(3) and selec.y < 97)then
		sfx(39)
		helpselec += 7
		selec.y += 24
	end
	
	if (btnp(0) and selec.x > 6)then
		helpselec -= 1
		selec.x -= 16
		sfx(39)
	end
	
	if (btnp(1) and selec.x < 102)then
		helpselec += 1
		selec.x += 16
		sfx(39)
	end
	
	if helpselec == 1 then
		helpline1 = "- the minekeeper (you)"
		helpline2 = "manage workers."
		helpline3 = "no need to talk."
	end
	
	if helpselec == 2 then
		helpline1 = "- the boss (not you)"
		helpline2 = "needs money."
		helpline3 = "takes money."
	end
	
	if helpselec == 3 then
		helpline1 = "- dwarf"
		helpline2 = "basic miner."
		helpline3 = "kinda basic."
	end
	
	if helpselec == 4 then
		helpline1 = "- lizard"
		helpline2 = "fast."
		helpline3 = "but weak."
	end
	
	if helpselec == 5 then
		helpline1 = "- goblin"
		helpline2 = "tough worker."
		helpline3 = "stubborn."
	end
	
	if helpselec == 6 then
		helpline1 = "- taurus"
		helpline2 = "very tough worker."
		helpline3 = "quite slow."
	end
	
	if helpselec == 7 then
		helpline1 = "- blob"
		helpline2 = "made of jelly."
		helpline3 = "sometimes splits."
	end
	
	if helpselec == 8 then
		helpline1 = "- rock eater"
		helpline2 = "some kind of bug."
		helpline3 = "eats rocks."
	end
	
	if helpselec == 9 then
		helpline1 = "- lazy lord (unique)"
		helpline2 = "does nothing."
		helpline3 = "earns money this way."
	end
	
	if helpselec == 10 then
		helpline1 = "- gem"
		helpline2 = "used to buy stuff."
		helpline3 = "can be bought."
	end
	
	if helpselec == 11 then
		helpline1 = "- bomb"
		helpline2 = "destroys block."
		helpline3 = "explosion."
	end
	
	if helpselec == 12 then
		helpline1 = "- heal"
		helpline2 = "heal all workers."
		helpline3 = "like new."
	end
	
	if helpselec == 13 then
		helpline1 = "- haste"
		helpline2 = "speed up."
		helpline3 = "permanent."
	end
	
	if helpselec == 14 then
		helpline1 = "- vortex"
		helpline2 = "fresh start."
		helpline3 = ""
	end
	
	if (btnp(5)) then
		gamemode = 0
		selec.x = 47
		selec.y = 72
		player.selec = 1
		n=1
		timer = 0
		sfx(11)
	end
	
	if timer == 31 then timer = 0 end
end

if gamemode == 0 then
	
	if timer > 0 then timer +=1 end
	
	if (btnp(2) or btnp (3)) then
		
		sfx (39)
		
		selec.y += n*8
		player.selec += n*1
		n*=-1
		
	end
	
	if (btnp(4) and player.selec == 1) then
		timer = 1
		sfx(11)
	end
	
	if (btnp(4) and player.selec == 2) then
		gamemode = 4
		helpline1 = "- the minekeeper (you)"
		helpline2 = "manage workers."
		helpline3 = "no need to talk."

		helpselec = 1
		selec.x = 6
		selec.y = 73
		sfx(11)
	end
	
	if timer == 33 then
		gamemode = 1
		selec.x = 0
		selec.y = 8
		selec.sprite = 2
		timer = 1
		music (0,0,3)
	end
end

if gamemode == 1 then

-- player & selector	
	 if (btnp(0)) 
	 then player.x -= 8
		if (player.x < 8)
		then
		player.x = 8
		end
	 end
	 
	 if (btnp(1)) 
	 then player.x += 8
		if (player.x >112)
		then
		player.x = 112
		end
	 end


	if (btnp(2))
	 then selec.y -= 16
		
		sfx(39)
		
		selec.value -= 1
		if selec.value < 1 then selec.value = 12 end
		
		if (selec.y < 8 and selec.x == 0) then
			selec.x = 120
			selec.y = 88
		end
		if (selec.y < 8 and selec.x == 120) then
			selec.x = 0
			selec.y = 88
		end
		
	end
	
	if (btnp(3))
	 then selec.y += 16
	 
		sfx(39)
		
		selec.value += 1
		if selec.value > 12 then selec.value = 1 end
			
		if (selec.y > 88 and selec.x == 0) then
			selec.x = 120
			selec.y = 8
		end
		if (selec.y > 88 and selec.x == 120) then
			selec.x = 0
			selec.y = 8
		end
		
	end
	
-- selection name
	if selec.value == 1 then selec.string = "dwarf" end
	if selec.value == 2 then selec.string = "bomb" end
	if selec.value == 3 then selec.string = "lizard" end
	if selec.value == 4 then selec.string = "goblin" end
	if selec.value == 5 then selec.string = "taurus" end
	if selec.value == 6 then selec.string = "buy 1 gem" end
	if selec.value == 7 then selec.string = "blob" end
	if selec.value == 8 then selec.string = "heal" end
	if selec.value == 9 then selec.string = "rock eater" end
	if selec.value == 10 then selec.string = "haste" end
	if selec.value == 11 then selec.string = "lazy lord" end
	if selec.value == 12 then selec.string = "vortex" end

--------------------------------------------	
--buy stuff	
	if (btnp(4)) then
		
		achat = false
		
	if (selec.value == 1 or selec.value == 3 or selec.value == 4 or selec.value == 5 or selec.value == 7 or selec.value == 9 or selec.value == 11) then
		if selec.value == 1 then goldprice = 2 gemprice = 0 end
		if selec.value == 3 then goldprice = 2 gemprice = 0 end
		if selec.value == 4 then goldprice = 3 gemprice = 0 end
		if selec.value == 5 then goldprice = 4 gemprice = 0 end
		if selec.value == 7 then goldprice = 1 gemprice = 1 end
		if selec.value == 9 then goldprice = 2 gemprice = 2 end
		if selec.value == 11 then goldprice = 3 gemprice = 3 end
		worker_buy (selec.value,goldprice,gemprice)
	end
		
	--bomb
		if (selec.value == 2 and gold >= 1) then
			gold -=1
		bomb_make(player.x)
		achat = true
		sfx (18)
		end
		
	--buy gem	
		if (selec.value == 6 and gold >= 4) then
			gold -=4
			gems += 1
			sfx (20)
			achat = true			
		end
	
	--heal	
		if (selec.value == 8 and gold >=2 and gems >= 1) then
			for i=#worker,1,-1 do
				worker[i].pv = worker[i].pvmax
			end
			gold -= 2
			gems -= 1
			
			healanim = 20
			sfx (24)
			achat = true			
		end
		
	--haste
		if (selec.value == 10 and gems >= 2) then
			for i=#worker,1,-1 do
				worker[i].speed *= 1.8
				if worker[i].speed > 8 then worker[i].speed = 8 end
			end
			gems -= 2
			
			hasteanim = 20
			sfx (25)
			achat = true			
		end
	
	--vortex
		if (selec.value == 12 and gold >= 4 and gems >= 4) then
			for i=#worker,1,-1 do
				--lord reset
				if (worker[i].sprite0 == 224) then lord = false end
				del(worker, worker[i])
			end
			terrain_clean()
			terrain_make()
			sfx(33)
			gold -=4
			gems -=4
			vortexanim = 20
			achat = true
		end
		
	--no buy
		if (achat == false) then
			sfx (19)
		end
	end
	

--------------------------------------------
-- mobs & terrain update
	timer += 1
	
--whip	
	if (btnp(5)) then
		
		player.sprite = 1
		whipanim= 10
		sfx (16)
		
		for i=#worker,1,-1 do
			if (worker[i].x == player.x and worker[i].y == 96) then
				
				worker[i].sprite = worker[i].sprite0
				worker[i].work += flr(rnd(3))+1 
				worker[i].dir = -1
				worker[i].pv -= 1
				
				if worker[i].sprite0 == 154 then
					r = flr(rnd(3))-1
					worker[i].x += 8*r
					if worker[i].x < 8 then worker[i].x = 8 end
					if worker[i].x > 112 then worker[i].x = 112 end
				end	
				
				if worker[i].sprite0 == 202 then
					r = rnd(3)
					if r >= 1.3 then 
						r = flr(rnd(2))
						if (worker[i].x > 16 and r == 0) then worker_make(player.x-8,flr(rnd(2))+1,0.2,2,202) sfx(29) end
						if (worker[i].x < 104 and r == 1) then worker_make(player.x+8,flr(rnd(2))+1,0.2,2,202) sfx(29) end
					end
				end	
				
				if worker[i].pv == 0 then 
					--lord reset
					if worker[i].sprite0 == 224 then lord = false end
					dead_make(worker[i].x,worker[i].y,30)
					del(worker, worker[i]) 
					sfx (21)
				end
			end
		end
	end
	
--worker
	
		
		for i=#worker,1,-1 do
		
		 if (worker[i].work > 0) then
			
			worker[i].pos = (worker[i].x)/8 + flr((worker[i].y)/8)*14
			worker[i].infront = terrain[worker[i].pos + worker[i].dir*14].type
			worker[i].wait -= 1
			if worker[i].wait <= 0 then worker[i].wait = 0 end
			 
			if (worker[i].infront != 0) then
			 worker[i].wait = 20
			 sfx (32)
			end
			
			if (worker[i].infront == 0 and worker[i].wait == 0) then
			 worker[i].y += worker[i].dir*worker[i].speed
			end
			
			--gold
			if (worker[i].infront >= 1 and worker[i].infront <= 4) then
			 terrain[worker[i].pos + worker[i].dir*14].type = terrain[worker[i].pos + worker[i].dir*14].type-1
			 worker[i].charge = 2
			 worker[i].sprite = worker[i].sprite0 + 2
			 worker[i].dir *= -1
			end
			
			--rock
			if (worker[i].sprite0 == 192 and (worker[i].infront == 5 or worker[i].infront == 6 or worker[i].infront == 7)) then
			 terrain[worker[i].pos + worker[i].dir*14].type = 0
			end
			
			worker[i].infront = terrain[worker[i].pos + worker[i].dir*14].type
			
			if (worker[i].infront >= 6 and worker[i].infront <= 7) then
			 terrain[worker[i].pos + worker[i].dir*14].type = terrain[worker[i].pos + worker[i].dir*14].type-1
			 worker[i].charge = 1
			 worker[i].sprite = worker[i].sprite0 +1
			 worker[i].dir *= -1
			end
			
			if (worker[i].infront == 5) then
			 terrain[worker[i].pos + worker[i].dir*14].type = 0
			 worker[i].charge = 1
			 worker[i].sprite = worker[i].sprite0 +1
			 worker[i].dir *= -1
			end
			
			--gem
			if (worker[i].infront == 8) then
			 terrain[worker[i].pos + worker[i].dir*14].type = 6
			 worker[i].charge = 3
			 worker[i].sprite = worker[i].sprite0 + 3
			 worker[i].dir *= -1
			end
			
			if worker[i].y <= 8 then 
			 worker[i].y = 8
			 worker[i].dir *= -1 
			 worker[i].sprite = worker[i].sprite0 + 4 
			end
			
			if worker[i].y >= 96 then
			 worker[i].y = 96
			 worker[i].dir *= -1
			 worker[i].work -= 1
			 if worker[i].work == 0 then worker[i].sprite = worker[i].sprite0 + 4 else worker[i].sprite = worker[i].sprite0 end
			 if worker[i].charge != 0 then
			  ress_make(worker[i].x-2,worker[i].charge,worker[i].charge+47)
			  worker[i].charge = 0
			 end
			end
		 end	
		end
		
-- lazy lord
		
		if timer == 30 then
		 for i=1,#worker do
			if worker[i].sprite0 == 224 then gold += flr(rnd(2)) end
		 end
		end
-- bomb

		for i=#bomb,1,-1 do
		    
			d = false
			
			bomb[i].y -= 2
			
			bomb[i].pos = (bomb[i].x)/8 + flr((bomb[i].y)/8)*14
			bomb[i].infront = terrain[bomb[i].pos-14].type
			
			if (bomb[i].y < 16) then 
			d = true 
			sfx(23) 
			end	
			
			if (bomb[i].infront != 0) then
			 sfx (23)
			 terrain[bomb[i].pos-14].type = 0
			 d = true
			end

			if d == true then del (bomb, bomb[i]) end
			
		end	
	

-- ressources

		for i=#ress,1,-1 do
			ress[i].x += 1
			if ress[i].x >120 then 
				if ress[i].type == 2 then gold +=1 
				sfx (22) end
				if ress[i].type == 3 then gems +=1 
				sfx (20) end
			del(ress, ress[i]) end
		end
	
	
	whipanim -=1
	if whipanim == 0 then player.sprite = 0 end
	
	

-- boss !
	
	bossanim -=1
	
	
	if (timer == 1 or timer == 11 or timer == 21) then
		bosstimer += 1
		if bossshare > 0 then
		 bossshare-=1
		 gold -=1
		 bossgold +=1
		 sfx (38)
		 
		 if gold < 0 then 
		 gamemode = 2 
		 music (-1,0,3)
		 sfx (10)
		 timer = 0
		 end
		 
		end
	end
	
-- bosstimer/3 = time in seconds

	if bosstimer == 45 then
		
		bossanim = 90
		bosscolor = 10
		bossanger +=1
		
		if bossanger < 3 then
		
		 r = flr(rnd(3))+34
		 sfx(r)
		
		 r = flr(rnd(6))+1
		 if r == 1 then bosstext = "- faster !" end
		 if r == 2 then bosstext = "- work harder !" end
		 if r == 3 then bosstext = "- you're worthless !" end
		 if r == 4 then bosstext = "- you call that mining ?!" end
		 if r == 5 then bosstext = "- where is my gold ?!" end
		 if r == 6 then bosstext = "- work work work !" end
		end

		if bossanger >= 3 then 
		 sfx (37)
		 bossrequest = (flr(bossrequest *(rnd(1)+1)))+1
		 bosscolor = 8
		 bosstext = "-i want "..bossrequest.." gold now!"
		 bossshare = bossrequest
		 bossanger = 0
		end
		
		bosstimer = 0
		
		
	end
	
	if timer == 31 then 
	timer = 0 
	end
	

--gamemode 1 end
end

if gamemode == 2 then
	timer += 1
	if timer == 60 then
		gamemode = 3
		timer = 0
		timery = 0
	end
	platy = 80
end

if gamemode == 3 then
	timer += 1
	timery += 1
	if timery == 30 then 
	 platy += 1 
	 if platy > 88 then platy = 88 end
	 timery = 0
	end
	
	if (timer >= bossgold) then 
	timer = bossgold 
	timery = 0
	end
	
	if (btnp(5)) then
		run (goldmine)
	end
end

-- update end
end
---------------------------------------------
function _draw()

if gamemode == 4 then

	cls ()
	map (48,0,0,0,16,16)
	
	if timer<15 then
		spr(0,16,63,1,2)
		spr(18,32,63,1,2)
		for i =3,14 do
			spr(spritehelp1[i],i*16 - (flr(i/8))*112,71+24*(flr(i/8)))
		end
	end
	
	if timer>=15 then
		spr(1,16,63,1,2)
		spr(19,32,63,1,2)
		for i =3,14 do
			spr(spritehelp2[i],i*16 - (flr(i/8))*112,71+24*(flr(i/8)))
		end
	end
	
	spr (selec.sprite,selec.x,selec.y)
	
	print (helpline1,16,16,8)
	print (helpline2,16,24,10)
	print (helpline3,16,32,10)
	
	
end

if gamemode == 0 then

	cls ()
	map (32,0,0,0,16,16)
	
	print ("play",57,72,10)
	print ("help",57,80,10)
	
	spr (selec.sprite,selec.x,selec.y)
	spr (70,40,8,6,4)
	
	if (timer > 0 and timer <=8) then circfill (64,64,timer*3,7) end
	if (timer > 8 and timer <=16) then circfill (64,64,timer*3,6) end
	if (timer > 16 and timer <=24) then circfill (64,64,timer*3,13) end
	if (timer > 24) then circfill (64,64,timer*3,1) end

	
end

if gamemode == 1 then
--clear screen
	cls ()

--map
	map (0,0,0,0,16,16)
	
-- terrain draw	
	terrain_draw()
	threadmill_draw()
	
-- mobs draw
	worker_draw()
	bomb_draw()
	dead_draw()
	boss_draw(0,110)
	
-- ressources draw
	ress_draw()

--selecteur
	spr (selec.sprite, selec.x, selec.y)
	print (selec.value.."."..selec.string, 2, 2, 9)
	
--compteur
	print ("="..gold, 72, 2, 9)
	print ("="..gems, 112, 2, 11)
	
--player
	spr (player.sprite, player.x, 101,1,2)
	
--spell	
	spell_draw()
	
end

if gamemode == 2 then	
	print ("game over", 45,30,8)	
end

if gamemode == 3 then

	cls ()
	map (16,0,0,0,16,16)
	if bossgold <= 15 then bosstext = "- ... pathetic" bosscolor = 8 end
	if (bossgold <= 30 and bossgold > 15) then bosstext = "- miserable" bosscolor = 8 end
	if (bossgold <= 45 and bossgold > 30) then bosstext = "- feeble" bosscolor = 9 end
	if (bossgold <= 60 and bossgold > 45) then bosstext = "- you're weak" bosscolor = 9 end
	if (bossgold <= 75 and bossgold > 60) then bosstext = "- mediocre" bosscolor = 10 end
	if (bossgold <= 90 and bossgold > 75) then bosstext = "- not acceptable" bosscolor = 10 end
	if (bossgold <= 105 and bossgold > 90) then bosstext = "- mmmh not so bad" bosscolor = 11 end
	if (bossgold > 105) then bosstext = "- not useless" bosscolor = 11 end
	
	print ("game over", 45,30,8)
	print (bosstext,28,16,bosscolor)
	rect (2,2,126,56,bosscolor)
	rect(4,4,124,54,bosscolor)
	
	plate_draw(platy)
	gold_draw (timer,platy)
	
	
end

	
	
end
