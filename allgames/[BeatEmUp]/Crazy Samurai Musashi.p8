pico-8 cartridge // http://www.pico-8.com
version 32
__lua__
-- crazy samurai musashi
-- by donswelt.de

 cartdata("donswelt_musashi") 
 hiscore=dget(0)
 
	---------------------------- !

 function _init()

  i=0
  music(1)
  titleinit() 

 end

	---------------------------- !

 function _update60()
  if (mode==0) then
   titleupdate()
   elseif (mode==2) then
    endupdate()
   elseif (mode==3) then
    howtoupdate()
   elseif (mode==4) then
    pawupdate()
   else
    gameupdate()
  end
 end

	---------------------------- !

 function titleupdate()
 
  if btnp(4) and startbutton==0 then
 	 startbutton=1
 	  sfx(4)
 	end
 	
  if btnp(3) then
   pawinit()
  end

  if startbutton==1 then
   countdown-=1
    if countdown<=0 then
     zeit=time()
   	 howtoinit()
    end
  end
  
  i+=1
   if i>=36-(startbutton*30) then
    i=0
    pressfire+=128
     if pressfire>128 then
      pressfire=0
     end
   end
   
 end

	---------------------------- !

 function gameupdate()
 
  daytime+=gameon
   if daytime>1800 then
    daytime=0
    speed=0

     -- lounge on!
     level+=1
      if level>2 and maxspeed<3 then
       maxspeed+=1
      end
      if level>3 and maxenemies<32 then
       maxenemies+=1
      end

    if sky==12 then
     sky=0
     sunnew=128
     moonnew=36
     ground=5
     dir=1
    else
     sky=12
     sunnew=36
     moonnew=128
     ground=3
     dir=1
     day+=1
    end
   end 
   
  if sun<sunnew then
   sun+=4
  elseif sun>sunnew then
   sun-=4
  end
  
  if moon<moonnew then
   moon+=4
  elseif moon>moonnew then
   moon-=4
  end
   
  anim+=1
   if anim==2 then
    slash=0
   end
   
   if anim==10 and animp>13 then
    anim=0
    animp=0
    slashactive=0
   end
   
   if anim>15 then
    anim=0
    animp+=4
     if animp>13 then
      animp=0
     end
   end
   
  eanim+=1
   if eanim>5 then
    eanim=0
    anime+=4
     if anime>7 then
      anime=0
     end
   end

  if btnp(5) or btnp(3) then
   if slashactive==0 then
    slash=1
    slashactive=1
    animp=64
    anim=0
    sfx(0)
   end
  elseif btnp(2) or btnp(4) then
   if slashactive==0 then
    slash=2
    slashactive=1
    animp=68
    anim=0
    sfx(0)
   end
  end
  
  -- attacke!
  pause-=gameon
   if pause<=0 then
    pause=0
   
    i+=1
     if i>attacke then
      i=0
      addenemy()
      welle+=1
      
       if welle>maxenemies then
        attacke-=30
         if attacke<36 then
          attacke=36
         end
        welle=0
        pause=100
       end
    end
  end
   
  for b in all(bloods) do
   b.x+=b.speedx
    if b.dir==1 then
     b.speedy-=.1
     b.y-=b.speedy
      if b.speedy<=0 then
       b.speedy=0
       b.dir=2
      end
    else
     if b.y<100+b.bloodrnd then
      b.speedy+=.1
      b.y+=b.speedy
     else
      b.speedx=0
      b.sizex+=.1
      b.i+=1
      if b.i>800 then
   				del(bloods,b)
      end
     end
    end
   
  end
    
  for e in all(enemies) do

 	  if e.x<64 and e.speed<maxspeed and e.active==1 then
 	   e.speed+=.1
 	  end
 	   
 	 e.x-=e.speed
 	 
 	  if e.x<playerx and e.x>playerx-11 and e.active==1 then
 	   if slash==1 and e.etype==136 then
 	    e.etype=72
 	    e.active=0
 	    e.speed=1
      anim=4
      kills+=1
      sfx(1)
       if kills>hiscore then
        hiscore=kills
        dset(0,hiscore)
       end
       if kills==6 then
        tutorial=128
       end
      addblood(e.x+10,e.y+10)
      addblood(e.x+10,e.y+10)
      addblood(e.x+10,e.y+10)      
 	   elseif slash==2 and e.etype==128 then
 	    e.etype=72
 	    e.active=0
 	    e.speed=1
      anim=4
      sfx(1)
      kills+=1
       if kills>hiscore then
        hiscore=kills
        dset(0,hiscore)
       end
       if kills==6 then
        tutorial=128
       end
      addblood(e.x+10,e.y+10)
      addblood(e.x+10,e.y+10)
      addblood(e.x+10,e.y+10)      
 	   end
 	  end

	  if e.x<playerx-11 and e.active==1 then
    e.active=0
    slashactive=0
    animp=192
    anim=0
    life-=1
    sfx(2)
    addblood(playerx-10,e.y+10)
    addblood(playerx-10,e.y+10)
    addblood(playerx-10,e.y+10)      
     if life==2 then
      lifeshow="    ‡"
     elseif life==1 then
      lifeshow="      "
     else
      lifeshow="      "
     end
   end
 	   
 			if e.x<-32 then
     if kills>=400 then
      gameover="congratulations!"
      music(-1)
       --pawchievements
       if kills>=25 then dset(11,1) end
       if kills>=50 then dset(12,1) end
       if kills>=66 then dset(13,1) end
       if kills==23 then dset(14,1) end
       if kills==1 then dset(15,1) end
       --
      endinit()
     elseif life<=0 then
      gameover="game over!"
      sfx(3)
      music(-1)
       --pawchievements
       if kills>=25 then dset(11,1) end
       if kills>=50 then dset(12,1) end
       if kills>=66 then dset(13,1) end
       if kills==23 then dset(14,1) end
       if kills==1 then dset(15,1) end
       --
      endinit()
     end
 				del(enemies,e)
 			end
	 end

  if gameon==0 then
   if playery==64 then
     manim=204
     ii+=1
      if ii>2 then
       ii=0
       matax+=.5
       mata=128
      else
       mata=0
      end
     iii+=1
     if iii==2 then
      addblood(38,80)
      addblood(38,80)
      addblood(38,80)
      sfx(1)      
     end
     if iii>60 then
      mata=128
      kills+=1
      gameon=1
     end
    end
   animp=64    
   if playery<64 then
    playery+=16
   else
    playery=64
   end
  end
     
  butterfly()
  
 end

	---------------------------- !

 function endupdate()

  butterfly()
  
  if btnp(5) and startbutton==0 then
 	 startbutton=1
 	 sfx(5)
 	end
  
  if startbutton==1 then
   countdown-=1
    if countdown<=0 then
     music(1)
   	 titleinit()
    end
  end
  
  i+=1
   if i>=36-(startbutton*30) then
    i=0
    pressfire+=128
     if pressfire>128 then
      pressfire=0
     end
   end
 
 end

	---------------------------- !
	
 function howtoupdate()
 
  butterfly()

  if btnp(4) and startbutton==0 then
 	 startbutton=1
 	  if time()-zeit>=300 then dset(16,1) end
 	 sfx(6)
 	end
  
  if startbutton==1 then
   countdown-=1
    if countdown<=0 then
    sfx(0)
   	 gameinit()
    end
  end
  
  i+=1
   if i>=36-(startbutton*30) then
    i=0
    pressfire+=128
     if pressfire>128 then
      pressfire=0
     end
   end
   
 end
	
	---------------------------- !

 function _draw()
  if (mode==0) then
    titledraw()
  elseif (mode==2) then
    enddraw()
  elseif (mode==3) then
    howtodraw()
  elseif (mode==4) then
    pawdraw()
  else
    gamedraw()
  end
 end

	---------------------------- !

 function titledraw()

	 cls()
	 
	 -- sky
  rectfill(0,0,128,95,sky)
   
  -- moon
  circfill(63,moon,33,7)
  
  -- title
	 spr(197,38,21,7,4)
	 print("…",hcenter("…")-2,10,8)
	 print("…",hcenter("…")-2,58,8)
	 
	 print("miyamoto musashi",hcenter("miyamoto musashi"),77,7)
	 print("versus 400",hcenter("versus 400")-1,86,7)
	 print("yoshioka swordsmen",hcenter("yoshioka swordsmen"),95,7)
	 print("press Ž to play!",hcenter("press Ž to play!")-2,107+pressfire,8)
	 print("2021 ‡ donswelt.de … hi: "..hiscore.."",hcenter("2021 ‡ donswelt.de … hi: "..hiscore.."")-4,119,7)
 end

	---------------------------- !

 function gamedraw()

  cls()
  
  -- sky
  rectfill(0,0,128,95,sky)
  
  -- sun
  circfill(63,sun,24,9)
  
  -- moon
  circfill(63,moon,24,7)

  -- a cute little butterfly
  spr(228+banim,bx,by)
   
  -- sad matashichiro
  spr(manim,37+matax,80+mata,1,2)
  
  -- earth
  rectfill(0,96,128,128,ground)
    
  for e in all(enemies) do
		 spr(e.etype+anime,e.x,e.y,4,4)
	 end

  for b in all(bloods) do
		 ovalfill(b.x-(b.sizex/2),b.y,b.x+(b.sizex/2),b.y+b.sizey,8)
	 end
	 	
  spr(animp,playerx-21,playery,4,4)

  print(kills,5,3,7)
  print("day "..day.."",hcenter("day "..day..""),3,7)
  print(lifeshow,100,3,7)
  
	 print("” high attack",hcenter("” high attack")-2,105+tutorial,7)
	 print("ƒ low attack",hcenter("ƒ low attack")-2,114+tutorial,7)

 end
 
	---------------------------- !

 function enddraw()
 
	 cls()
	    
  -- moon
  circfill(63,36,33,7)

  -- title
	 spr(197,38,21,7,4)
	 print("…",hcenter("…")-2,10,8)
	 print("…",hcenter("…")-2,58,8)
	 
  print(""..gameover.."",hcenter(""..gameover..""),77,7)
	 print("you defeated "..kills.."",hcenter("you defeated "..kills..""),86,7)
	 print("yoshioka swordsmen",hcenter("yoshioka swordsmen"),95,7)

	 print("press — to rest!",hcenter("press — to rest!")-2,107+pressfire,8)

  -- a cute little butterfly
  spr(228+banim,bx,by)

 end
 
 ---------------------------- !
 
 function howtodraw()

  cls()
  
  -- sky
  rectfill(0,0,128,95,sky)
  
  -- sun
  circfill(63,sun,24,9)
  
  -- moon
  circfill(63,moon,24,7)
  
  -- a cute little butterfly
  spr(228+banim,bx,by)
  
  -- sad matashichiro
  spr(manim,37,80+mata,1,2)
  
  -- earth
  rectfill(0,96,128,128,ground)

  print("poor matashichiro is waiting",8,100,7)
  print("for miyamoto musashi.",8,109,7)
	 print("press Ž to kill him!",8,118+pressfire,7)

 end
 
	-------- functions --------- !
 
 function titleinit()
  mode=0
  startbutton=0
  pressedfire=0
  pressfire=0
  countdown=50
  sky=0
  sun=128
  moon=36
  sunnew=128
  ground=5
  moonnew=36
  mata=0
  matax=0
  gameover="game over!"
  i=0
 end

 function gameinit()
  mode=1
  anim=0
  anime=0
  eanim=0
  etype=128
  welle=0
  attacke=202
  playerx=31
  playery=-128
   slash=0
   slashactive=0
   animp=0
  lifeshow="  ‡‡"
  life=3
  maxenemies=4
  daytime=1800
  kills=0
  maxspeed=1
  day=0
  pause=1
  level=0
  gameon=0
  bloods={}
  enemies={}
  tutorial=0
  i=0
  ii=-20
  iii=0
 end

 function endinit()
  mode=2
  startbutton=0
  pressedfire=0
  pressfire=0
  countdown=50
  i=0
 end

 function howtoinit()
  mode=3
  startbutton=0
  pressedfire=0
  pressfire=0
  countdown=50
  bx=32
  by=64
  banim=0
  butter=0
  bmove=0
  bdirx=flr(rnd(3))
  bdiry=flr(rnd(3))
  manim=196
 end

 function hcenter(s)
  -- screen center minus the
  -- string length times the 
  -- pixels in a char's width,
  -- cut in half
  return 64-#s*2
 end
  
 function addenemy(x,y)
	 local e={
		 x=128,
		 y=64,
		 active=1,
		 speed=1,
		 etype=128+(flr(rnd(2))*8)
  }
  add(enemies,e)
 end
 
 function addblood(x,y)
	 local b={
		 x=x,
		 y=y+flr(rnd(4)),
		 dir=1,
		 speedy=1+flr(rnd(3)),
		 speedx=-1+rnd(3),
			sizex=flr(rnd(3))+2,
			sizey=flr(rnd(3))+2,
			bloodrnd=flr(rnd(20)),
			i=0,
			}
  add(bloods,b)
 end
 
 function butterfly()
  butter+=1
   if butter>5 then
    butter=0
    banim+=16
     if banim>16 then
      banim=0
     end
     
   bmove+=1
    if bmove>=20 then
     bdirx=flr(rnd(3))
     bdiry=flr(rnd(3))
     bmove=0-flr(rnd(10))
    end
    
   if bdirx==1 then
    bx+=1
     if bx>128 then
      bx=0
     end
   elseif bdirx==2 then
    bx-=1
     if bx<-8 then
      bx=128
     end
   else
   end
   
   if bdiry==1 then
    by+=1
     if by>70 then
      by=70
     end
   elseif bdiry==2 then
    by-=1
     if by<12 then
      by=12
     end
   else
   end
     
  end

 end
 
-- pawchievements 
 
 function pawinit()
  mode=4
  paw1=dget(11) paw2=dget(12) paw3=dget(13) paw4=dget(14) paw5=dget(15) paw6=dget(16)
  paws1="--" paws2="--" paws3="--" paws4="--" paws5="--" paws6="--"
  pawc1=0 pawc2=0 pawc3=0 pawc4=0 pawc5=0 pawc6=0
 end
 
 function pawupdate()
  if paw1==1 then paws1="‡" pawc1=3 end
  if paw2==1 then paws2="‡" pawc2=3 end
  if paw3==1 then paws3="‡" pawc3=3 end
  if paw4==1 then paws4="‡" pawc4=3 end
  if paw5==1 then paws5="‡" pawc5=3 end
  if paw6==1 then paws6="‡" pawc6=3 end 
  if btnp(3) then titleinit()	end
 end
 
 function pawdraw()
  cls(0)
  print("pawchievements!",10,15,9)
  print(paws1.." kill 25 swordsmen",10,35,6+pawc1)
  print(paws2.." kill 50 swordsmen",10,45,6+pawc2)
  print(paws3.." kill 66 swordsmen",10,55,6+pawc3)
  print(paws4.." nothing is what it seems",10,65,6+pawc4)
  print(paws5.." he's the one!",10,75,6+pawc5)
  print(paws6.." he's late again",10,85,6+pawc6)
  print("press ƒ to return!",10,105,9)
 end
