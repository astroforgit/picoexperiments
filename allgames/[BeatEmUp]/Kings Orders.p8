pico-8 cartridge // http://www.pico-8.com
version 19
__lua__
function _init()
	music(30)
	
	mode="start"
	
	grav=0.3
	
	plyr={
	x=30,
	dx=0,
	y=90,
	dy=0,
	w=6,
	h=13,
	spd=1,
	move=false,
	sp=3,
	}
	
	srd={
	 x=5,
	 y=3,
	 dx=0,
	 w=8,
	 h=3,
	}
	
	health=100
	
	kgt_x={}
	kgt_y={}
	kgt_dy={}
	kgt_v={}
	kgt_w=6
	kgt_h=13
	kgt_spd=0.5
	kgt_sp=23
	kgt_j=0
	kgt_d={}
	
	bat_x={}
	bat_y={}
	bat_dy={}
	bat_v={}
	bat_w=6
	bat_h=6
	bat_spd=0.7
	wing=33
	bat_d={}
	
	pes_x={}
	pes_y={}
	pes_dy={}
	pes_v={}
	pes_w=6
	pes_h=13
	pes_spd=0.3
	pes_j=0
	pes_d={}
	
	bats=false
	peasants=false
	pspawn=0
	
	kgtkills=0
	batkills=0
	peskills=0
	
	--particles
 hpartx={}
 hparty={}
 hpartdy={}
 hpartv={}
 
 spartx={}
 spartdx={}
 sparty={}
 spartdy={}
 spartv={}
 spartp={}
 spartg={}
 
 cloudx={}
 cloudy={}
 cloudr={}
 clouddx={}
	
	cloudx2={}
 cloudy2={}
 cloudr2={}
 clouddx2={}
	
	kg_x=7
	kg_h=false
	
	gorx=-1
	gordx=5
	
	p_timer=0
	b_timer=0
	k_timer=0
	kg_timer=0
	kh_timer=0
	ps_timer=0
	t_timer=0
	
	stab=false
	
	hard=false
	
	bar_y=0
	bar_up=false
	
	kg_tlk="protect me!"
	kg_tlkv=0
	kg_tlkp=false
	
	make_clouds()
	make_clouds2()
end

function make_clouds()
 local i
 
 for i=1,40 do
  add(cloudx,i*5-50)
  add(cloudy,120)
  add(cloudr,flr(rnd(20))+10)
  add(clouddx,rnd(0.1))
 end
end
function make_clouds2()
 local i
 
 for i=1,40 do
  add(cloudx2,i*5-50)
  add(cloudy2,0)
  add(cloudr2,flr(rnd(20))+10)
  add(clouddx2,rnd(0.1))
 end
end


function reset()
 health=100
 score=0
 kgtkills=0
 batkills=0
 peskills=0
 plyr.x=30
 plyr.y=90
 bats=false
 peasants=false
 kgt_spd=0.5
 bat_spd=0.7
 gorx=-1
 gordx=5
 kg_tlkp=false
 t_timer=0
 tip="‹‘/move"
 tip1=false
end

function make_kgts()
 local i
 
 for i=1,4 do
  if hard then
   add (kgt_x,(rnd(50)+i*50)+128)
  else
   add (kgt_x,(rnd(100)+i*100)+128)
  end
  add (kgt_y,91)
  add (kgt_v,true)
  add (kgt_dy,0)
  add (kgt_d,false)
 end
end

function update_kgts()
 local i
 
 for i=1,#kgt_x do
  if kgt_v[i] and not kgt_d[i] then
   if stab and collide_box(srd.x+plyr.x,srd.y+plyr.y,srd.w,srd.h,kgt_x[i],kgt_y[i],kgt_w,kgt_h) then
    kgt_dy[i]=-3
    kgt_d[i]=true
    sfx(3)
    kgtkills+=1
    score+=5
    s_plus()
   else
    kgt_x[i]-=kgt_spd
    if kgt_x[i]<35 then
     kgt_stairs()
    end
   end
  end
 end
 
 kgt_death()
 
 if kgtkills==4 then
  make_kgts()
  kgtkills=0
  if not (bats) then
   make_bats()
   bats=true
   kg_timer=0
   kg_tlk="watch out for bats!!"
   tip="z/jump"
   t_timer=0
  end
 end
 
end

function kgt_stairs()
 local i
 
 for i=1,#kgt_x do
  if kgt_v[i] and kgt_x[i]<35 then
   if kgt_x[i]<13 then
    health-=20
    kgt_v[i]=false
    score-=1
    sfx(7)
    sfx(8)
    ow()
    kgtkills+=1
    s_minus()
   elseif kgt_x[i]<19 then
    
   else
    kgt_y[i]-=kgt_spd
   end
  end
 end
end

function anim_kgts()
 if (k_timer<5) then
  k_timer+=1
 else
  k_timer=0
  if (kgt_sp==23) then
   kgt_sp=22
   kgt_j=-1
  else
   kgt_sp=23
   kgt_j=0
  end
 end
end

function kgt_death()
 local i 
 
 for i=1,#kgt_x do
  if kgt_d[i] and kgt_v[i] then
   if kgt_y[i]>130 then
    kgt_v[i]=false
    kgt_d[i]=false
   else
    kgt_x[i]+=2
    kgt_dy[i]+=grav
    kgt_y[i]+=kgt_dy[i]
   end
  end 
 end
end

function make_bats()
 local i
 
 for i=1,6 do
  if hard then
   add(bat_x,(rnd(50)+i*50)+128)
  else
   add(bat_x,(rnd(100)+i*100)+128)
  end
  add(bat_y,75)
  add(bat_v,true)
  add(bat_d,false)
  add(bat_dy,0)
 end
end

function update_bats()
 local i
 
 for i=1,#bat_x do
  if bat_v[i] and not bat_d[i] then
   if stab and collide_box(srd.x+plyr.x,srd.y+plyr.y,srd.w,srd.h,bat_x[i],bat_y[i],bat_w,bat_h) then
    bat_d[i]=true
    bat_dy[i]=-3
    sfx(3)
    batkills+=1
    score+=5
    s_plus()
   else
    bat_x[i]-=bat_spd
    if bat_x[i]<13 then
     health-=10
     bat_v[i]=false
     batkills+=1
     score-=1
     sfx(7)
     sfx(8)
     ow()
     s_minus()
    end
   end
  end
 end
 
 bat_death()
 
 if batkills==6 then
  batkills=0
  make_bats()
  pspawn+=1
  if not (peasants) and pspawn<2 then
   make_pes()
   peasants=true
   kg_timer=0
   kg_tlk="spare the peasants"
  end
 end
 
end

function bat_anim()
 local i

 if (b_timer<5) then
  b_timer+=1
 else
  b_timer=0
  if (wing<36) then
   wing+=1
  else
   wing=33
  end
 end
 
 for i=1,#bat_x do
  if bat_v[i] and not bat_d[i] then
   if wing==33 then
    bat_y[i]=75
   elseif wing==34 or wing==36 then
    bat_y[i]=74
   elseif wing==35 then
    bat_y[i]=73
   end 
  end
 end
end

function bat_death()
 local i 
 
 for i=1,#bat_x do
  if bat_d[i] and bat_v[i] then
   if bat_y[i]>130 then
    bat_v[i]=false
    bat_d[i]=false
   else
    bat_x[i]+=2
    bat_dy[i]+=grav
    bat_y[i]+=bat_dy[i]
   end
  end 
 end
end

function make_pes()
 local i
 
 for i=1,4 do
  add(pes_x,(rnd(100)+i*100)+128)
  add(pes_y,91)
  add(pes_v,true)
  add(pes_d,false)
  add(pes_dy,0)
 end
end

function update_pes()
 local i
 for i=1,#pes_x do
  if pes_v[i] and not pes_d[i] then
   if stab and collide_box(srd.x+plyr.x,srd.y+plyr.y,srd.w,srd.h,pes_x[i],pes_y[i],pes_w,pes_h) then
    pes_d[i]=true
    pes_dy[i]=-3
    sfx(7)
    sfx(8)
    health-=5
    peskills+=1
    if kg_tlkp then
     kg_tlk="my gold!!"
    else
     kg_tlkp=true
     kg_tlk="i said spare them!!"
    end
    kg_timer=0
    score-=1
    ow2()
    s_minus()
   else
    pes_x[i]-=pes_spd
    if pes_x[i]<35 then
     pes_stairs()
    end
   end
  end
 end
 
 pes_death()
 
 if peskills==4 then
  make_pes()
  peskills=0
 end
 
end

function pes_stairs()
 local i
 
 for i=1,#pes_x do
  if pes_v[i] and pes_x[i]<35 then
   if pes_x[i]<13 then
    if health<100 then
      health+=1
     end
     pes_v[i]=false
     peskills+=1
     s_gold()
     sfx(9)
   elseif pes_x[i]<19 then
    pes_y[i]=pes_y[i]
   else
    pes_y[i]-=pes_spd
   end
  end
 end
end

function pes_anim()
	if (ps_timer<5) then
  ps_timer+=1
 else
  ps_timer=0
  if (pes_sp==26) then
   pes_sp=25
   pes_j=-1
  else
   pes_sp=26
   pes_j=0
  end
 end
end

function pes_death()
 local i
 
 for i=1,#pes_x do
  if pes_d[i] and pes_v[i] then
   if pes_y[i]>130 then
    pes_v[i]=false
    pes_d[i]=false
   else
    pes_x[i]+=2
    pes_dy[i]+=grav
    pes_y[i]+=pes_dy[i]
   end
  end
 end 
end

function plyr_anim()
 if plyr.move==true then
  if p_timer<5 then
   p_timer+=1
   plyr.sp=18
   plyr.y-=1
  else
   if p_timer<10 then
    plyr.sp=3
    p_timer+=1
   else
    sfx(0)
    p_timer=0
   end
  end
 else
  timer=0
  plyr.sp=3
 end
end

function _update60()
	if mode=="start" then
	 updatestart()
	elseif mode=="starting" then
	 updatestarting()
	elseif mode=="game" then
	 updategame()
	elseif mode=="dead" then
	 updatedead()
	elseif mode=="over" then
	 updateover()
	end
end

function updatestart()
	local i
	
	if btn(—) then
	 mode="starting"
	 music(-1)
	 sfx(9)
	end
	
	for i=1,#cloudx do
	 cloudx[i]+=clouddx[i]
	 if cloudx[i]>200 then
	  cloudx[i]=-50
	 end
	end
	
	for i=1,#cloudx2 do
	 cloudx2[i]-=clouddx2[i]
	 if cloudx2[i]<-50 then
	  cloudx2[i]=200
	 end
	end
end

function updatestarting()
 
 if bar_y<150 and mode=="starting" then
  bar_y+=5
 else
  mode="game"
  music(0)
  reset()
 end
end

function updategame()
 local btpress
	
	if btn(‘) then
	 plyr.dx=plyr.spd
	 plyr.move=true
	elseif btn(‹) then
	 plyr.dx=-plyr.spd
	 plyr.move=true
	else
  plyr.dx=plyr.dx/1.15
  plyr.move=false
 end
	
	if btn(Ž) and plyr.y==91 then
	 plyr.dy=-4
	 sfx(2)
	end
	
	if btn(—) and srd.x==5 then
	 srd.dx=3.5
	 srd.x+=1
	 sfx(1)
	 stab=true
	end
	
	plyr.dy+=grav
	
	if not (srd.x<6) then
	 srd.dx-=0.5
	else
	 srd.dx=0
	 stab=false
	end
	
	plyr.x+=plyr.dx
	plyr.x=mid(39,plyr.x,120)
	plyr.y+=plyr.dy
	plyr.y=mid(0,plyr.y,91)
	
	if (plyr.y<90) then
		plyr.sp=18
	else
	 plyr_anim()
	end
	
	srd.x+=srd.dx
	srd.x=mid(5,srd.x,50)
	
	update_kgts()
	anim_kgts()
	update_bats()
	bat_anim()
	update_pes()
	pes_anim()
	
	updatehpart()
	updatespart()
	
	king_talk()
	king_hurt()
	tips()
	
	if bar_y>-5 then
	 bar_y-=5
	end
	
	if health<1 then
	 mode="dead"
	 music(-1)
	 kg_timer=0
	end
	
	if not hard2 and score>500 then
	 hard2=true
	 kg_tlk="they're speeding up!"
	 kgtimer=0
	 
	 bat_spd=0.8
	 kgt_spd=0.7
	end
	
	if not hard and score>200 then
	 hard=true
	 kg_tlk="uh oh, there's more of 'em"
  kg_timer=0
	end
	
end

function ow()
 local i
 
 kg_tlk="ow"
 kg_timer=0
 
 kg_h=true
 kh_timer=0
 
 for i=1,10 do
  add(hpartx,(health+20)+flr(rnd(10)))
  add(hparty,flr(rnd(5)+3))
  add(hpartdy,flr(rnd(5)))
  add(hpartv,true)
 end
end

function ow2()
 local i
 
 kg_h=true
 kh_timer=0
 
 for i=1,10 do
  add(hpartx,(health+20)+flr(rnd(10)))
  add(hparty,flr(rnd(5)+3))
  add(hpartdy,flr(rnd(5)))
  add(hpartv,true)
 end
end

function s_plus()
  add(spartx,64)
  add(spartdx,0.5)
  add(sparty,122)
  add(spartdy,-3)
  add(spartv,true)
  add(spartp,true)
  add(spartg,false)
end

function s_minus()
  add(spartx,64)
  add(spartdx,0.5)
  add(sparty,122)
  add(spartdy,-3)
  add(spartv,true)
  add(spartp,false)
  add(spartg,false)
end

function s_gold()
  add(spartx,7)
  add(spartdx,0.5)
  add(sparty,70)
  add(spartdy,-3)
  add(spartv,true)
  add(spartp,true)
  add(spartg,true)
end

function king_hurt()
	if kg_h and kh_timer<20 then
	 kg_x=6
	 kg_crown=93
	 kh_timer+=1
	else
	 kg_x=7
	 kg_crown=92
	 kg_h=false
	end
	
	
end

function updatehpart()
 local i
 for i=1,#hpartx do
  if hpartv[i] then
   hpartx[i]+=1
   hpartdy[i]+=grav
   hparty[i]+=hpartdy[i]
   if hparty[i]>128 then
    hpartv[i]=false
   end
  end
 end
end

function updatespart()
 local i
 for i=1,#spartx do
  if spartv[i] then
   spartx[i]+=spartdx[i]
   spartdy[i]+=grav/2
   sparty[i]+=spartdy[i]
   if sparty[i]>128 then
    spartv[i]=false
   end
  end
 end
end


function king_talk()
 if kg_timer<240 then
  kg_timer+=1
 else
  kg_tlk=""
 end
end

function tips()
 if t_timer<300 then
  t_timer+=1
 elseif not tip1 then
 make_kgts()
  tip="x/attack"
  tip1=true
  t_timer=0
 else
  tip=""
 end
end

function updatedead()
  despawn()

 plyr.dy+=grav

 plyr.y+=plyr.dy
	plyr.y=mid(0,plyr.y,91)
	
	if kg_timer<120 then
	 kg_timer+=1
	else
	 mode= "over"
	 kg_timer=0
	 sfx(12)
	end
end

function updateover()
  
 if kg_timer<120 then
  kg_timer+=1
 else
  if gorx<128 then
   if gorx>100 then
    gordx=gordx/1.2
   end
   gorx+=gordx
  else
   if btn(—) then
    mode="starting"
    kg_tlk="protect me!"
    kg_timer=0
   end
  end
 end
end

function despawn()
 local i
 
 for i=1,#kgt_x do
  if kgt_v[i] then
   kgt_v[i]=false
  end
 end
 
 for i=1,#bat_x do
  if bat_v[i] then
   bat_v[i]=false
  end
 end
 
 for i=1,#pes_x do
  if pes_v[i] then
   pes_v[i]=false
  end
 end
 
 for i=1,#hpartx do
  if hpartv[i] then
   hpartv[i]=false
  end
 end
 
 for i=1,#spartx do
  if spartv[i] then
   spartv[i]=false
  end
 end
end

function _draw()
	if mode=="start" then
	 drawstart()
	elseif mode=="starting" then
	 drawstarting()
	elseif mode=="game" then
	 drawgame()
	 --drawdebug()
	elseif mode=="dead" then
	 drawdead()
	elseif mode=="over" then
	 drawover()
	end 
end



function drawstart()
 local i
 
 cls(12)
 pal(11,0)
 map(16,0)
 pal(11,11)
 --print("kings orders",41,40,7)
 print("press x to start",32,81,1)
 print("press x to start",32,80,7)

 for i=1,#cloudx do
  circfill(cloudx[i],cloudy[i],cloudr[i],7)
 end
 for i=1,#cloudx2 do
  circfill(cloudx2[i],cloudy2[i],cloudr2[i],7)
 end

 print("a ludumdare 46 game",27,106,1)
 --print("a ludumdare 46 game",27,100,9)

 
 print("by bookerbluejay",33,116,1)
 --print("by bookerbluejay",27,110,9)

end

function drawstarting()
	rectfill(0,0,127,bar_y,0)
end

function drawgame()
	local i
	cls()
	map(0,0)
	--king
	spr(108,kg_x,73)
	spr(kg_crown,kg_x,65)
	print(kg_tlk,20,61,1)
	print(kg_tlk,20,60,7)
	--spr(109,16,78)
	--plyr
	spr(2,plyr.x,plyr.y)
	spr(plyr.sp,plyr.x-1,plyr.y+8)
	spr(5,plyr.x-2,plyr.y-8)
	spr(4,plyr.x+srd.x,plyr.y+srd.y)

 print(tip,plyr.x-10,plyr.y-10,13)

 --topbar
 print("king",1,2,1)
 print("king",1,1,7)
 rectfill(20,1,120,6,1)
 rectfill(20,6,health+20,6,2)
 rectfill(20,1,health+20,5,8)
 
 --bottom bar
 print("’ score "..score,30,121,1)
 print("’ score "..score,30,120,7)


 rectfill(0,0,127,bar_y,0)

 for i=1,#bat_x do
  if bat_v[i] then
   if bat_d[i] then
    spr(35,bat_x[i]-6,bat_y[i]-1,1,1,true)
    spr(48,bat_x[i],bat_y[i])
    spr(35,bat_x[i]+5,bat_y[i]-1)
   else
    spr(wing,bat_x[i]-6,bat_y[i]-1,1,1,true)
    spr(32,bat_x[i],bat_y[i])
    spr(wing,bat_x[i]+5,bat_y[i]-1)
   end
  end
 end
 
 for i=1,#kgt_x do
  if kgt_v[i] then
   if kgt_d[i] then
    spr(39,kgt_x[i],kgt_y[i])
    spr(38,kgt_x[i]-8,kgt_y[i])
    spr(40,kgt_x[i]+8,kgt_y[i])
    spr(7,kgt_x[i]-10,kgt_y[i]-5)
   else
    spr(6,kgt_x[i],kgt_y[i]+kgt_j)
    spr(7,kgt_x[i]-5,kgt_y[i]+3+kgt_j)
    spr(8,kgt_x[i]+2,kgt_y[i]-8+kgt_j)
    spr(kgt_sp,kgt_x[i]+1,kgt_y[i]+8+kgt_j)
   end
  end
 end
 
 for i=1,#pes_x do
  if pes_v[i] then
   if pes_d[i] then
    spr(42,pes_x[i],pes_y[i])
    spr(41,pes_x[i]-8,pes_y[i])
    spr(10,pes_x[i]-10,pes_y[i]-5)
   else
    spr(9,pes_x[i],pes_y[i]+pes_j)
    spr(10,pes_x[i]-3,pes_y[i]+2-pes_j)
    spr(pes_sp,pes_x[i]+1,pes_y[i]+8+pes_j)
   end
  end
 end
 

 draw_hpart()
 draw_spart()

end

function draw_hpart()
 local i
 
 for i=1,#hpartx do
  if hpartv[i] then
   pset(hpartx[i],hparty[i],8)
  end
 end 
end

function draw_spart()
 local i
 
 for i=1,#spartx do
  if spartv[i] then
   if spartp[i] then
    if spartg[i]then
     print("+1",spartx[i],sparty[i]+1,9)
     print("+1",spartx[i],sparty[i],10)
    else
     print("+5",spartx[i],sparty[i]+1,3)
     print("+5",spartx[i],sparty[i],11)
    end
   else
    print("-1",spartx[i],sparty[i]+1,2)
    print("-1",spartx[i],sparty[i],8)
   end
  end
 end 
end


function drawdead()
 	cls()
	map(0,0)
	--king
	spr(108,7,73)
	spr(92,7,65)
	--spr(109,16,78)
	--plyr
	spr(2,plyr.x-2,plyr.y,1,1,true)
	spr(3,plyr.x-1,plyr.y+8,1,1,true)
	spr(5,plyr.x,plyr.y-8,1,1,true)
	spr(4,plyr.x-srd.x-2,plyr.y+srd.y,1,1,true)

 --topbar
 print("king",1,2,1)
 print("king",1,1,7)
 rectfill(20,1,120,6,1)
 
 print("’ score "..score,30,121,1)
 print("’ score "..score,30,120,7)

 rectfill(0,0,127,bar_y,0)
end

function drawover()
 cls()
	map(0,0)
	--king
	spr(110,6,73)
	spr(94,6,65)
	spr(111,14,73)
	spr(95,14,65)
	--spr(109,16,78)
	--plyr
	spr(2,plyr.x-2,plyr.y,1,1,true)
	spr(3,plyr.x-1,plyr.y+8,1,1,true)
	spr(5,plyr.x,plyr.y-8,1,1,true)
	spr(4,plyr.x-srd.x-2,plyr.y+srd.y,1,1,true)

 --topbar
 print("king",1,2,1)
 print("king",1,1,7)
 rectfill(20,1,120,6,1)
 
 print("’ score "..score,30,121,1)
 print("’ score "..score,30,120,7)

 rectfill(-1,54,gorx,75,1)
 rectfill(-1,55,gorx,73,12)
 
 --rectfill(0,49,gorx,49,1)
 print("game over",gorx-85,58,1)
 print("game over",gorx-85,57,7)
 print("press x to retry",gorx-100,67,1)
 print("press x to retry",gorx-100,66,7)


 rectfill(0,0,127,bar_y,0)
 
end

function drawdebug()
 print(cloudx[1],1,1,7)
	--print(plyr.y,1,7,7)
	--print(stab,1,13,7)
	--print(test,1,19,7)
	--rect(rx,ry,rx+rw,ry+rh,14)
end

function collide_box(px,py,pw,ph,ex,ey,ew,eh)
 
 if px+pw>ex and ex+ew>px then
  if py+ph>ey and ey+eh>py then
   return true
  end
 else
  return false
 end
end
