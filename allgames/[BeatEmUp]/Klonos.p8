pico-8 cartridge // http://www.pico-8.com
version 1
__lua__
win=false

function rndint(a,b)
	return flr(rnd()*(b-a+1))+a
end

screen=0
splshx = 48

f=0 -- frame
s=1 -- speed
p={x=1,y=0,vy=0,j=false,crouch=false,a=0,c=0,ca=0,hp=3} -- player (x,animation,charge)
ts=0 -- textstart (frame)
txt='i am the monster'
txtim=0 -- text timeout

msgs={'i am my own enemy','my inner demons','why me?'}
msgsp=1
msgsd=0

memories={'ludum dare 33','kittens','a potato','a ld participant','pico-8','life','our ancestors','a friend','a loving pet','the kraken','loch ness','cerberus','frankenstein','dracula','wolf man','jaws','the birds','godzilla','bigfoot','the phoenix'}
mmm=false

deco={}
decoffset = 0 --deco offset
enemies={}

ddd=64

function adddeco()
	mx=rndint(0,15)*8
	my=rndint(0,0)
	for i=0,7 do
		add(deco,mget(mx+i,my))
	end
end

for i=0,2 do
	adddeco()
end

disb=100 -- distance to next boss
bossdistances={0,1000,1000}
bossfight=nil
nextboss=1

boss=nil
bossmaxhp=0

bossoffset=0

camerashake=0 -- this is great

function getmonsters()
	return {
			{t=0,x=p.x+128,a=0,hp=1,s=0.6}, -- basic walker
			{t=1,x=p.x+128,a=0,hp=2,s=0.3}, -- heavy walker (more hp)
			{t=2,x=p.x+128,a=0,hp=1,s=1.6}, -- runner
			{t=3,x=p.x+128,y=0,hp=1,s=1}, -- hopper
		}
end

function _update()
	f+=1
	
	if p.dead==nil and win==false and screen == 1 then
	
	txtim+=1
	
	p.vy=min(p.vy+s,5)
	pjj = (btn(2) or btn(5))
	if pjj and p.y==0 then
		p.j=true
	end
	
	p.crouch = false
	if btn(3) then
		p.crouch = true
	end
	
	if btn(1) then
		p.x+=s
		if boss != nil then
			bossoffset+=s
		end
		p.a+=s
		p.j=false
		p.crouch=false
	else
		p.a=0
	end
	
	cdeco=deco[flr((p.x+20-decoffset)/8)]
	if mmm==false and p.crouch and (cdeco == 53 or cdeco == 54) then
		mmm=true
		ts=f
		txt='in memory of '..memories[rndint(1,count(memories))]
	elseif not p.crouch then
		mmm=false
	end
	
	if p.j==true and not pjj then
		p.j=false
		p.vy=-s*6
		sfx(1)
	end
	p.y=min(p.y+p.vy,0)
	
	if p.c < 0.1 then
		p.c=0
	end
	
	if p.c == 0 then
		ca=0
	end
	
	if btn(4) and ca==0 then
		p.c+=(10-p.c)/40
		if f%flr(15-p.c)==0 then
			sfx(4)
		end
	end
	
	if f%200==0 and bossfight==nil then
		eee=getmonsters()
		r=1
		if p.x>333 then r+=1 end
		if p.x>666 then r+=1 end
		if p.x>1333 then r+=1 end
		add(enemies,eee[rndint(1,r)])
	end
	
	if p.x%150==0 then
		if msgsp < count(msgs)+1 then
		txt=msgs[msgsp]
		msgsp+=1
		ts=f
		p.x+=1
		end
	end
	
	if nextboss==bossfight and bossfight!=nil then
		nextboss+=1
		bbb={
			{t=10,x=p.x+128,a=0,hp=5,s=0.2},
			{t=11,x=p.x+128,y=0,hp=6,s=0.2},
		}
		boss=bbb[bossfight]
		if boss!=nil then
			bossmaxhp=boss.hp
		end
		add(enemies,boss)
	end
	
	if boss!=nil and boss.hp==0 then
		bossfight=nil
		boss=nil
	end
	
	if p.x>ddd then
		ddd+=64
		adddeco()
	end
	
	end -- end p.dead==nil
end

function _draw()
	cls()

	if screen==0 then
		if f > 30 then
			spr(64,splshx,48,4,4)
		end
		if f > 50 then
			splshx = max(splshx-1,30)
		end
		if f > 80 then
			print("ludum",53,56,9)
		end
		if f > 90 then
			print("dare",57,64,10)
		end
		if f > 100 then
			spr(84,73,56,2,2)
		end
		if f > 160 then
			screen = 1
			f=0
		end
	end
	if screen==1 then
	
	camera(0,0)
	--background
	rectfill(0,0,128,128,1)
	
	--moon
	circfill(40,60,30,7)
	
	camx=rndint(0,camerashake)
	camy=rndint(0,camerashake)
	camera(camx,camy)	
	if camerashake != 0 then
		if flr(camerashake)==camerashake and p.dead==nil and win==false then
			sfx(7)
		end
		camerashake/=1.5
	end
	
	if camerashake < 0.1 then
		camera(0,0)
	end
	
	--ground
	for x=0,17 do
		spr(33,x*8-p.x%8/1,80)
		spr(34,x*8-p.x%8/1,88)
		for y=0,4 do
			spr(49,x*8,96+y*8)
		end
	end
	--deco
	num=0
	for i in all(deco) do
		num+=1
		spr(i,decoffset-p.x+num*8,72)
	end
	--player
	palt(0,false) -- black is visible
	palt(10,true) -- yellow is transparent
	
	soff=0
	if ca==0 and p.c > 0 and f%(14-p.c)<(12-p.c) then
		pal(0,9)
	end
	if (not btn(4) or ca==1) and p.c>0 then
		if ca==0 then
			sfx(0)
			attack=f
		end
		if attack!= nil and f-attack>4 then
			attack=nil
		end
		ca=1
		p.c/=1.1
		soff=flr(p.c*10)
		--line(22+p.c,71,22+soff,71,9)
		--line(24+p.c,72,22+soff,72,9)
	end
	if p.c>2 and ca==1 then
		spr(6,20+soff+soff/10,64+p.y)
		spr(22,20+soff,72+p.y)
	elseif p.j or p.crouch and p.y==0 then
		spr(1,20+soff,67+(f*s)%15/7.5)
		spr(23,20+soff,72)
	elseif p.y != 0 then
		spr(1,20+soff,64+p.y)
		spr(22,20+soff,72+p.y)
	else
		spr(1,20+soff,64+(f*s)%15/7.5)
		spr(17+p.a%10/2,20+soff,72)
	end
	--enemies
	for i in all(enemies) do
		pal(0,0)
		if i.x-p.x < 28 and i.d==nil and (i.t==0 or i.t==1 or i.t==2 or i.t==3) then
			i.d=f
			i.hp-=1
		end
		if i.d==nil and attack!=nil and 28+p.c*10 > i.x-p.x and (i.x-p.x > 28 or i.t==11) and (i.y==nil or (p.y<i.y+16)) then
			i.d=f
			i.hp-=1
		end
		
		if i.t==1 then pal(0,8) end
		
		if i.d!=nil then
			i.x+=(max(10-(f-i.d),0))/10
			if f%4<2 then
				pal(0,7)
			end
			if (f-i.d)>10 then
				if i.hp<=0 then
					del(enemies,i)	
					if ca==0 then
						p.hp-=1
						sfx(3)
					else
						if p.dead==nil or win==false then
							sfx(2)
						end
					end
				end
				if (f-i.d)>20 then
					i.d=nil
				end
			end
		end
		if i.t==0 or i.t==1 or i.t==2 then
			i.x-=i.s
			i.a+=i.s
			topsp=1
			offs=0
			if i.t==2 and f%8<4 then topsp=6 offs=-3 end
			spr(topsp,i.x-p.x+offs,64,1,1,true)
			spr(17+i.a%10/2,i.x-p.x,72,1,1,true)
		end
		if i.t==3 then -- hopper
			if i.y==0 and i.g==nil then
				i.g=f
			elseif i.y!=0 then
				i.x-=i.s
			end
			if i.g!=nil and f-i.g > 15 then
				i.g=nil
				i.vy=-5
				if p.dead==nil and win==false then
					sfx(1)
				end
			end
			if i.vy!= nil then 
				i.vy=min(i.vy+0.5,5)
				i.y=min(i.y+i.vy,0)
			end
			if i.g!=nil then
				spr(1,i.x-p.x,67+i.y,1,1,true)
				spr(22,i.x-p.x,72+i.y,1,1,true)
			else
				spr(1,i.x-p.x,64+i.y,1,1,true)
				spr(22,i.x-p.x,72+i.y,1,1,true)
			end
		end
		
		--bosses
		if i.t==10 then
			i.x-=i.s
			i.a+=i.s
			anim=flr(i.a%10/2)
			if anim==0 and i.noise==nil then
				camerashake=2
				i.noise='boom'
			elseif anim!=0 then
				i.noise=nil
			end
			if i.x-p.x < 20 and i.h==nil and i.h!='splat' then 
				i.h='splat'
				p.hp-=1
				sfx(3)
			end
			if i.x-p.x < -32 then
				i.x=p.x+128
				i.h=nil
			end
			sspr(8,0,8,8,i.x-p.x,32,24,24,true)
			sspr(8+anim*8,8,8,8,i.x-p.x,56,24,24,true)
		end
		if i.t==11 then
			if i.state==nil then
				i.state='fly'
				i.oof=f
			end
			if f-i.oof > 60 then
				i.oof=f
				if i.state!='fly' then
					i.state='fly'
				else
					states={'attack','beam'}
					i.state=states[rndint(1,2)]
				end
			end
			xpos=64
			shipy=0
			if i.state=='fly' then
				i.y=max(i.y-1,-30)
				shipy=i.y+sin(f/40)*10
			elseif i.state=='attack' then
				xpos=20
				if i.oof+40<f then
					i.y=min(i.y+5,0)
					if i.y==0 and i.damage==nil then
						i.damage='ouch'
						camerashake=4
						if ca==0 then
							p.hp-=1
							if p.dead == nil and win == false then
								sfx(3)
							end
						end
						--i.state='fly'
						--i.oof=f
					end
					shipy=i.y
				else
					if i.damage != nil then i.damage=nil end
					shipy=i.y+sin(f/40)*((40+i.oof-f)/4)
				end
			elseif i.state == 'beam' then
				if i.oof+40<f then
					something=(f-i.oof-40)/20
					line(i.x-p.x+28,i.y+80,i.x-p.x+28-16*something,50+30*something,10)
					line(i.x-p.x+36,i.y+80,i.x-p.x+36+16*something,50+30*something,10)
					if p.dead == nil and win==false and i.pew==nil then
						i.pew='pow'
						sfx(9)
					end
					if i.pew=='pow' and i.oof+50<f then
						i.pew='zap'
						eee=getmonsters()
						monster=eee[rndint(1,count(eee))]
						monster.x=i.x+28
						add(enemies,monster)
					end
					shipy=i.y
				else
					if i.pew!=nil then i.pew = nil end
					shipy=i.y+sin(f/40)*((40+i.oof-f)/4)
				end
			end
			i.x+=((p.x+xpos)-i.x)/20
			camera(0,0)
			sspr(72+flr(f%10/5)*16,0,16,16,i.x-p.x,44+shipy,64,64)
			spr(1,28+i.x-p.x,49+shipy,1,1,true)
			spr(17,28+i.x-p.x,56+shipy,1,1,true)
			camera(camx,camy)
		end
	end
	
	camera(0,0)
	
	--hp
	for i=0,p.hp-1 do
		spr(16,8+i*8,112)
	end
	
	pal()
	palt()
	
	--bossbar
	nb=bossdistances[nextboss]+bossoffset
	disb=bossdistances[nextboss+1]
	if (disb!=nil and nb!= nil) or (boss != nil) then
		if disb!=nil and (p.x-nb)>disb and (bossfight==nil) then
			txt='boss fight'
			ts=f
			bossfight=nextboss
		end
		if bossfight== nil and not (flr(disb/(p.x-1)) >= 128) then
			rectfill(0,0,128/(disb/(p.x-nb)),2,2)
		elseif boss!=nil and not (flr(bossmaxhp/boss.hp) >= 128) then
			rectfill(0,0,128/(bossmaxhp/boss.hp),2,8)
		end
	elseif boss==nil and win==false then
		win=f+20
	end
	
	--text
	if f-ts < 80 then
		c={2,13,6,7,7,7,7,6,13,2}
		print(txt,(72.3-#txt*2)-(f-ts)/5,10,c[flr((f-ts)/8+1)])
	end
	
	-- dieeeeee
	if p.hp<=0 and p.dead==nil then
		p.dead=f+20
		sfx(6)
	end
	an=f
	msg='you '
	if p.dead!=nil then
		an=p.dead
		msg=msg..'died'
	end
	if win!=false then
		an=win
		msg=msg..'win'
		if f==win+1 then sfx(8) end
	end
	if an!=f then
		circfill(40,60,min((f-an)*5+cos(f/40)*20,200),7)
		if f-an > 25 then
			print(msg,28,60,0)
		end
	end
	
	end
end
__gfx__
