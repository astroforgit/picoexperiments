pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
function _init()
 music(0,0,1)
 global={}
 global.zdown = false
 global.zup = false
 global.zpressed = false
 global.shaketimer = 0
 global.timer = 0
 global.enemies = 5
 global.enemiespunched = 0
 global.fadeintimer = 24
 player={}
 player.x = 58
 player.y = 64
 player.isplayer = true
 player.facingleft = false
 player.sprite = 0
 player.speed = 2
 player.defaultspeed = 2
 player.chargespeed = .5
 player.punchspeed = 8
 player.punchtimer = 0
 player.moving = false
 player.charging = false
 player.punching = false
 player.life = 3
 player.ishurt = false
 player.hurttimer = 0
 player.recoiltimer = 0
 player.isdead = false
 player.deadtimer = 11
 enemies={}
 genenemy(1,28,64)
 genenemy(2,90,64)
end
-->8
function move(o)
	if not o.isplayer then
		return
	end
	player.moving = true
	// dont do walking anim if punch
	if (player.punching == false and
		player.charging == false) then
	 if player.sprite == 0 then
 		if player.ishurt then
 			player.sprite = 14 // dirty hack
 		else
 			player.sprite = 1
			end
		elseif player.sprite != 0 then
			player.sprite = 0
		end
 end
end

function movex(o,v)
	if v == 0 then return end
	move(o)
	o.x += v

 local collisions = cmap(o)
 if (collisions.l or collisions.r) then
 	o.x -= v
 	movex(o,v/2)
 	if (o.isenemy == true and
 		o.ispunched == true) then
 		o.ispunched = false
			killenemy(o)
 	end
 end
 	
 local enemiescollided = cenemies(o)
 if #enemiescollided > 0 then
 	// todo let enemies stack on each other dead
 	if o.punching == true then
 		for i=1,#enemiescollided do
 			punched(enemiescollided[i],v)
 		end
 	elseif o.isplayer then
 		for enemy in all(enemiescollided) do
 			if enemy.isdead == false then
 				hurtplayer(v)
 			end
 		end
 	end
 end
 
 if o.isenemy and o.isdead == false and
 	cobjects(o,player) == true then
 	hurtplayer(v)
 end 
end


function movey(o,v)
	if v == 0 then return end
	move(o)
	o.y += v
	
 local collisions = cmap(o)
 if (collisions.t or collisions.b) then
 	o.y -= v
 	movey(o,v/2)
 end
 	
 local enemiescollided = cenemies(o)
 if #enemiescollided > 0 then
 	if o.isplayer then
 		for enemy in all(enemiescollided) do
 			if enemy.isdead == false then
 				hurtplayer(v)
 			end
 		end
 	end
 end
	
 if o.isenemy and o.isdead == false and
 	cobjects(o,player) == true then
 	hurtplayer(v)
 end 
end

function charge()
	player.charging = true
	player.sprite = 3
	player.punchspeed = 3
	sfx(3,2)
end

function updatecharge()
 if player.punchspeed < 12 then
 	player.punchspeed += .25
	end
	if player.punchspeed == 8 then
	 sfx(7,2)
	elseif player.punchspeed == 11 then
		sfx(8,2)
	end
	player.sprite += 1
	if player.sprite > 6 then
		player.sprite = 3
	end
end

function punch()
	global.start = true
	player.punching = true
	player.sprite = 7
	player.punchtimer = 0
	sfx(4,2)
end

function updatepunch()
	if (player.punching == true) then
		player.punchtimer += 1
		if player.sprite < 13 then
			player.sprite += 1
		end
		
 	// punchmovement
 	local prevx = player.x
 	local prevy = player.y
 	local movespeed = player.punchspeed
 	if (player.punchtimer > 8) then
 		movespeed = player.chargespeed
 	end
 	if player.facingleft then
 		movex(player,-movespeed)
 	else
  	movex(player,movespeed)
  end
	end
	// cooldown
	if (player.punchtimer > 16) then
		player.punching = false
		player.sprite = 0
		player.punchtimer = 0
	end
end

function hurtplayer(v)
	if player.hurttimer <= 0 and
		player.punching == false then
		player.ishurt = true
  player.life -= 1
  player.hurttimer = 48
  player.sprite = 14
  player.recoiltimer = 10
  player.recoilspeed = v
  global.shaketimer = 10
  sfx(6,2)
 end
end

function updatehurt()
	if player.life == 0 and player.isdead == false then
		player.isdead = true
		music(2)
		return
	end
	if player.ishurt == false then
		return
	end
	if player.recoiltimer > 0 then
		player.x += player.recoilspeed
		player.recoiltimer -= 1
		player.x = max(16,
			min(player.x,114))
	end
	player.hurttimer -= 1
	if player.sprite == 14 then
 	player.sprite = 15
	elseif player.sprite == 15 then
		player.sprite = 14
	end
	
	if player.hurttimer == 0 then
		player.ishurt = false
		player.sprite = 1
	end
end
-->8
function _update()
	if global.start then
		global.timer += 1
	else
		fade_scr(global.fadeintimer/24)
		global.fadeintimer -= 1
	end
	
	player.moving = false
	player.speed = player.defaultspeed
	if player.charging == true then
		player.speed = player.chargespeed
	end
	if player.punching == false and
		player.recoiltimer == 0 then
 	if (btn(0)) then
 		player.facingleft = true
 		movex(player,-player.speed)
 	end
 	if (btn(1)) then 
 		player.facingleft = false
 		movex(player,player.speed)
 	end
 	if (btn(2)) then
 		movey(player,-player.speed)
 	end
 	if (btn(3)) then
 		movey(player,player.speed)
 	end

 end
	
	updatebtnz()
	updatepunch()
	if player.punching == false then
 	if global.zdown == true then
 		player.charging = true
 		charge()
 	elseif player.charging == true then
 		updatecharge()
 	end
 	if (global.zup == true and
 	player.charging == true) then
 		player.charging = false
 		punch()
 	end
	end
	
	updateenemies()
	
	updatehurt()
end
function updatebtnz()
 if global.zup == true then
  global.zup = false
 end
	if (btn(4)) then
		if global.zpressed == false then
			global.zpressed = true
			global.zdown = true
		else
			global.zdown = false
		end
	else
		if global.zpressed == true then
			global.zup = true
			global.zpressed = false
		end
	end
end
-->8
function _draw()
	cls()
	map(0,0,0,0,16,16)
	if not global.start then
		drawlogo()
	end
	drawplayer()
	foreach(enemies,drawenemy)
	drawui()
	if global.shaketimer > 0 then
 	camera(cos(global.shaketimer/3),
 		cos(global.shaketimer/2))
 	global.shaketimer -= 1
 else
 	camera(0,0)
 end
end

function drawlogo()
	spr(192,
		28,
		24,
		9,4)
	print("\t\thold z to charge...\nlet go to punch ghosts!",
			18,84,7)
		
	print("by julius tarng",
		32,110,14)
end

function drawplayer()
	if player.isdead then
		player.sprite = 138 - player.deadtimer
		if player.deadtimer > 0 then
			player.deadtimer -= 1
			global.resettimer = 100
		end
		if player.deadtimer == 0 then
			global.resettimer -= 1
			fade_scr((100-global.resettimer)/100)
			if global.resettimer == 0 then
				_init()
			end
		end
	end
	spr(player.sprite,
		player.x,
		player.y,
		1,1,player.facingleft)
end

function drawui()
	local lifespr = 16
	for i=1,3 do
		if (i>player.life) then
			lifespr = 17
		else lifespr = 16
		end 
		spr(lifespr, (8*i)+2,3)
	end
	rectfill(98,4,116,10,1)
	local p = global.enemiespunched
	if p < 10 then p = "0"..p end
	print(""..p.."‚", 100, 4, 7)
end

function drawenemy(o)
	drawenemybirth(o)
	spr(o.sprite,
		o.x,
		o.y,
		1,1,o.facingleft)
end

function drawenemybirth(o)
	o.birthtimer -= 1
	if o.birthtimer > 0 then
		o.sprite = 100 - o.birthtimer
	elseif o.birthtimer == 0 then
		o.sprite = 64
	end
end
-->8
function genenemy(i,x,y)
 local o = {}
 // avoid spawn on player
 local plusminusx = 1
 local plusminusy = 1
 if (rnd(1) > .5) then plusminusx = -1 end
 if (rnd(1) > .5) then plusminusy = -1 end
	o.x = 60 + (flr(rnd(36) + 8) * plusminusx)
	o.y = 60 + (flr(rnd(36) + 8) * plusminusy)
	o.x = x or o.x
	o.y = y or o.y
	o.sprite = 64
	o.speed = 3
	o.facingleft = false
	o.isenemy = true
	o.index = i
	o.ispunched = false
	o.punchedtimer = 0
	o.movedir = -1
	o.movetimer = 0
	o.isdead = false
	o.isdeadtimer = 10
	o.birthtimer = 6
	add(enemies,o)
end

function punched(o,v)
	player.punchspeed = 1
	o.ispunched = true
	o.punchedtimer = 12
	o.speed = v
	if v > 0 then o.facingleft = false
	elseif v < 0 then o.facingleft = true end
	o.movetimer = 0 // stop random movement
	
 global.shaketimer = 5
end

function updatepunched(o)
	if o.punchedtimer == 0 then
		o.ispunched = false
		o.speed = 0
		return
	end
	movex(o,o.speed)
	o.punchedtimer -= 1
end

function updateenemies()
	if global.timer == 24 then	
		for i=#enemies, #enemies + global.enemies do
			genenemy(i) end
	end
	
	for enemy in all(enemies) do
		if enemy.isdead == true then
			updatedead(enemy)
		elseif enemy.ispunched == true then
			updatepunched(enemy)
		else
			if global.timer > 48 then
 		// move randomly
 			if(enemy.movetimer <= 0) then
  	 	enemy.movedir = flr(rnd(4))
  	 	enemy.movetimer = flr(rnd(10)+10)
  	 	enemy.speed = flr(rnd(1)+1)
   	end
   end
  	moveenemy(enemy)
 	end
	end
end

function moveenemy(o)
	o.movetimer -= 1
	o.sprite += 1
 if o.sprite > 65 then
 	o.sprite = 64
 end
	if o.movetimer > 0 then 
 	if o.movedir == 0 then
 		movex(o,o.speed)
 		o.facingleft = true
 	elseif o.movedir == 1 then
 		movex(o,-o.speed)
 		o.facingleft = false
 	elseif o.movedir ==	2 then
 		movey(o,-o.speed)
 	elseif o.movedir == 3 then
 		movey(o,o.speed)
 	end
 end
end

function killenemy(o)
	o.isdead = true
	o.sprite = 65
	global.shaketimer = 10
	global.enemiespunched += 1
	sfx(5,2)
	if #enemies == global.enemiespunched then
		for i=#enemies, #enemies + global.enemies do
			genenemy(i) end
	end
end

function updatedead(o)
	o.isdeadtimer -= 1
	if o.sprite <= 80 then
		o.sprite += 1
	end
end
-->8
// collisions
function cmap(o)
	local x1=o.x/8
	local y1=o.y/8
	local x2=(o.x+7)/8
	local y2=(o.y+7)/8
	local a=fget(mget(x1,y1),0)
	local b=fget(mget(x1,y2),0)
	local c=fget(mget(x2,y2),0)
	local d=fget(mget(x2,y1),0)	
	
	local collisions = {}
	collisions.l = a and b
	collisions.r = c and d
	collisions.t = a and d
	collisions.b = b and c
	
	return collisions
end

function cenemies(o)
	local collided = {}
	for i=1,#enemies do
		// skip check if it is itself
		if not (o.isenemy == true and
			o.index == i) then
 	 if cobjects(o,enemies[i]) then
 	 	add(collided,enemies[i])
 	 end
 	end
	end
	return collided
end

function cobjects(o1,o2)
	return not (o2.x > (o1.x+7) or
									 (o2.x+7) < o1.x or
									 o2.y > (o1.y+7) or
									 (o2.y+7) < o1.y)
end
-->8
-- "fa" is a number ranging from 0 to 1
-- 1 = 100% faded out
-- 0 = 0% faded out
-- 0.5 = 50% faded out, etc.

function fade_scr(fa)
	fa=max(min(1,fa),0)
	local fn=8
	local pn=15
	local fc=1/fn
	local fi=flr(fa/fc)+1
	local fades={
		{1,1,1,1,0,0,0,0},
		{2,2,2,1,1,0,0,0},
		{3,3,4,5,2,1,1,0},
		{4,4,2,2,1,1,1,0},
		{5,5,2,2,1,1,1,0},
		{6,6,13,5,2,1,1,0},
		{7,7,6,13,5,2,1,0},
		{8,9,4,5,2,1,1,0},
		{9,9,4,5,2,1,1,0},
		{10,15,9,4,5,2,1,0},
		{11,11,3,4,5,2,1,0},
		{12,12,13,5,5,2,1,0},
		{13,13,5,5,2,1,1,0},
		{14,9,9,4,5,2,1,0},
		{15,14,9,4,5,2,1,0}
	}
	
	for n=1,pn do
		pal(n,fades[n][fi],0)
	end
end
