pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- karate - single bout
-- by gamplym

-- game loop

function _init()
 game_start()
 
 music(0)
 
 delay=0
 
 _upd=menu_update
 _drw=menu_draw
end

function _update()
 t+=1
 _upd()
end

function _draw()
 _drw()
 display_msg()
end

function game_start()
 text_setup()
 
 write_text({"let the battle","commence!","may the best","one win!"},4*8,1*8,7,240)
 
 player_data()
 enemy_data()
 
 t=0
 
 victory=false
end
-->8
-- drawing

function draw_screen()
 cls()
 map()
 
 camera(0,0)
 
 -- player draw
 spr(e._spr,e.x,e.y,e._sprx,e._spry,e._flip)
 
 -- enemy draw
 spr(p._spr,p.x,p.y,p._sprx,p._spry,p._flip)
 
 print("player",1*8,4*8,7)
 print(" "..p.hp,1*8,5*8,7)
 
 print("enemy",11*8,4*8,7)
 print(" "..e.hp,11*8,5*8,7)
end
-->8
-- updating

function game_update()
 player_control()
 enemy_control()
 
 buffermov()
 
end

-- any technical data
-- player movement etc.

function player_data()
 p={
  w_anim={97,64},
  hp=10,
  x=2*8,
  y=9*8,
  _spr=64,
  _sprx=1,
  _spry=2,
  _flip=false,
  state=0,
  atk_dur=15,
  buffer=0,
  wait=0
 }
 
 -- state 1 = low kick
 -- state 2 = punch
 -- state 3 = defence
 -- state 4 = hurt
 -- state 5 = dead
 -- state 6 = win
 
end

-- player movement

function player_control()
 attack()
 player_state()
 
 newx=p.x
 
 if p.state==0 then
  if (btn(‘)) then
    newx+=1
   elseif (btn(‹)) then
    newx-=1
   else
  end
 
  newx=mid(0,newx,15*8)
 
  p.x=newx
 end
 
end

-- attacking!
-- and other moves apparently

function attack()

 if p.wait==0 then
 
  if (btnp(—)) and p.state==0 then
   p.state=1
   p.buffer=p.atk_dur
   p.wait=5
   sfx(0)
   if box_hit(p.x+8,p.y+8,8,8,e.x+8,e.y,8,16) then
    -- you have hit! do damage
    sfx(2)
    enemy_dmg()
   end
   
  elseif (btnp(Ž)) and p.state==0 then
   p.state=2
   p.buffer=p.atk_dur
   p.wait=5
   sfx(0)
   if box_hit(p.x+8,p.y+8,8,8,e.x+8,e.y,8,16) then
    -- you have hit! do damage
    sfx(2)
    enemy_dmg()
   end
   
  elseif (btnp(ƒ)) and p.state==0 then
   p.state=3
   p.buffer=p.atk_dur
   p.wait=5
   sfx(1)
   
  end
 end
 
end

-- player state
-- am i attacking or not?
-- has animations too i guess

function player_state()
 
 if p.state==0 then
  -- regular pose, can walk
  player_anim()
  p._sprx=1
 
 elseif p.state==1 then
  -- low kick
   p._spr=65
   p._sprx=2
   
 elseif p.state==2 then
  -- punch
  p._spr=67
  p._sprx=2
  
 elseif p.state==3 then
  -- defend
  p._spr=96
  p._sprx=1
  
 elseif p.state==4 then
  -- stunned
  p._spr=98
  p._sprx=1
  
 elseif p.state==5 then
  -- dead
  p._spr=77
  p._sprx=2
 
 end

end

function player_anim()
 if (btn(‘)) or (btn(‹)) then
  p._spr=p.w_anim[flr(t/4)%2+1]
 else
  p._spr=64
 end
end

-- delay player attack inputs

function buffermov()

 if p.hp>0 then
 
  if p.buffer>0 then
   p.buffer-=1
  end
  
  if p.buffer<=0 and p.wait>0 then
   p.state=0
   p.wait-=1
   if p.wait<=0 then
    p.buffer=0
    p.wait=0
    p.state=0
   end
  end
 end
 
 enemy_buffer() 

end

-- delay enemy attack inputs

function enemy_buffer()
 
 if e.buffer>0 then
  e.buffer-=1
 end
 
 if e.buffer<=0 and e.wait>0 then 
  
  e.state=0
  e.wait-=1
  
  if e.wait<=0 then
   e.buffer=0
   e.wait=0
   e.state=0
  end
 end
 
end

 -- what happens when the
 -- player is hit
 
function player_hit()
 
  if p.state!=3 then
   if p.state!=4 then
    sfx(3)
    p.x-=13
    p.buffer=p.atk_dur
    p.wait=p.atk_dur/2
    p.state=4
    p.hp-=1
    
    if p.hp<=0 then
     -- player loses the match
     music(-1)
     p.hp=0
     victory=false
     delay=100
    _upd=endgame_update
    sfx(7)
    end
   else
    
   end
  else 
   e.buffer=e.atk_dur*2
   p.buffer=p.atk_dur/2
   p.wait=p.atk_dur/2
  end

end


 -- a check for attacking
 -- maybe this will work
 -- i hope so :(
 
function box_hit(
  x1,y1,w1,h1,
  x2,y2,w2,h2
  )
  
  local hit=false
  
  local xs=w1*0.5+w2*0.5
  local ys=h1*0.5+h2*0.5
  
  local xd=abs((x1+(w1/2))-(x2+(w2/2)))
  local yd=abs((y1+(h1/2))-(y2+(h2/2)))

  if xd<xs and yd<ys then
   hit=true
  end
  
  return hit

end
-->8
-- enemy

function enemy_data()
 e={
  w_anim={103,69},
  hp=10,
  x=12*8,
  y=9*8,
  _spr=69,
  _sprx=2,
  _spry=2,
  _flip=true,
  state=0,
  atk_dur=18,
  buffer=0,
  wait=0,
  roll=3,
  mindist=2,
  maxdist=4
 }
 
  -- state 0 = stand still
  -- state 1 = move toward
  -- state 2 = move away
  -- state 3 = low kick
  -- state 4 = punch
  -- state 5 = defence
  -- state 6 = hurt
  -- state 7 = dead
end

 -- this is where the enemy
 -- battles and stuff
 -- all very cool

function enemy_control()
 statemachine()
 enemy_anim()
 
 if e.hp>0 then
 
  if e.buffer==0 and e.wait==0 then
  
   if e.state==0 then
    -- stand still
   
   elseif e.state==1 then
    -- walk forward 
    e.x-=1
   
   elseif e.state==2 then
    -- walk backward
    e.x+=1
   
   elseif e.state==3 then
    -- low kick
    e.wait=rnd(40)
    e.buffer=e.atk_dur
    sfx(0)
    if box_hit(e.x,e.y,8,16,p.x,p.y,8,16) then
     -- enemy hits u
     sfx(2)
     player_hit()
    end
    
   elseif e.state==4 then
    -- punch
    e.wait=e.atk_dur/2
    e.buffer=e.atk_dur
     sfx(0)
     if box_hit(e.x,e.y,8,16,p.x,p.y,8,16) then
      -- enemy hits u
      sfx(2)
      player_hit()
     end
  
   elseif e.state==5 then
    -- defence
    e.wait=e.atk_dur/2
    e.buffer=e.atk_dur
    sfx(1)
    
   elseif e.state==7 then
    -- dead
   
   end
 end
 
end
 
end

function statemachine()

 -- how do you ckeck if a 
 -- number is inbetween a
 -- certain range?
 if e.hp>0 then
  if e.buffer==0 then
  
   if (e.x>p.x+e.mindist) and (e.x<p.x+e.maxdist) then
    e.state=0
   end
   
   if (e.x>p.x+e.maxdist) then
    e.state=1
   end
   
   if (e.x<p.x+e.mindist) then
    e.state=2
   end
  
  end
  -- decide to attack or defend
  
  if (e.state==0) then
   if (e.wait<=0) then
    
    e.roll=flr(rnd(3)+3)
    
    e.state=e.roll
   end
  end
 end
   
end

-- enemy animations here

function enemy_anim()
 
 if e.state==0 then
  e._spr=69
 end
 
 if e.wait==0 then
  if e.state==1 or e.state==2 then
   e._spr=e.w_anim[flr(t/4)%2+1]
  end
 else
   e._spr=69
  end
 
 if e.state==3 then
  e._spr=71
 end
 
 if e.state==4 then
  e._spr=73
 end
 
 if e.state==5 then
  e._spr=101
 end
 
 if e.state==6 then
  e._spr=105
 end
 
 if e.state==7 then
  e._spr=109
 end 

end

 -- what happens when
 -- enemy is hit
 -- also must do dmg

function enemy_dmg()
 if e.state!=5 then
  if e.state!=6 then
   e.x+=13
   e.buffer=e.atk_dur
   e.wait=1
   e.state=6
   sfx(4)
   e.hp-=1
   
   if e.hp<=0 then
    -- enemy loses, player wins
    music(-1)
    e.hp=0
    victory=true
    delay=100
    _upd=endgame_update
    sfx(6)
   end 
  else
   -- nothing - just can't hit
   -- during stun!
  end
 else
  p.buffer=p.atk_dur*2
  e.buffer=e.atk_dur/2
  e.wait=1
 end
end
-->8
-- hud and text

function text_setup(_txt)
 msg={}
 
 _x=1
 _y=1
end

function write_text(_txt,_x,_y,_c,_d)
  
  local m={
   txt=_txt,
   c=_c,
   startx=_x,
   starty=_y,
   dur=_d
  }
  
  add(msg,m)
  return m
end

function display_msg()
 for m in all(msg) do
 
  local sy=m.starty
 
   for i=1,#m.txt do
    local txt=m.txt[i]
    print(txt,m.startx,sy,m.c)
    sy+=6
    if m.dur>0 then
     m.dur-=1
     if m.dur<=0 then
      del(msg,m)
     end
    end
   end
 end
end
-->8
-- control game state

function endgame_update(_delay)

 if victory==false then
  p._spr=77
  p._sprx=2
  e._spr=107
 else
  p._spr=99
  e._spr=109
 end
 
 if delay>0 then
  delay-=1
 end
 
  if delay==0 then
   -- go to final screen
   if victory then
    music(2)
   else
    music(7)
   end
   
   _upd=end_update
   _draw=end_draw
  end
 
end

function menu_update()
 if (btnp(—)) then
  delay=120
  music(-1,1500)

  _upd=before_update
  _draw=before_draw
  
 end 
end

function menu_draw()
 cls()
 map()
 
 camera(112*8,0)
 
 spr(71,121*8,5*8,2,2,true)
 
 print("single bout",117*8,4*8,8)
 print("use Ž to kick",116*8,8*8,7)
 print("use — to punch",116*8,9*8,7)
 print("use ƒ to defend",116*8,10*8,7)
 print("press — to begin the battle!",113*8,12*8,10)

end

-- quick delay before switching
-- to game view

function before_update()
 
 if delay>0 then
  delay-=1
 end
 
 if delay<=0 then
  game_start()
  _upd=game_update
  _draw=draw_screen
  music(9)
 end
 
end

function before_draw()
 cls()
 map()
 
 camera(96*8,0)
 
 print("  get ready to karate!",98*8,4*8,10)
end

-- final screen: win or lose?

function end_update()
 -- nothing happens in here
 -- i guess
end

function end_draw()
 cls()
 map()
 
 camera(96*8,0)
 
 local _x1=103*8
 local _y1=7*8
 
 local _x2=107*8
 local _y2=9*8
 
 if victory then
  -- show player with cup
  spr(99,_x1,_y1,1,2)
  spr(105,_x2,_y2,1,2,true)
  spr(6,_x1+(1*8),_y1-(1*8))
  
  print("what an astonishing victory!",97*8,4*8,7)
    print("congratulations!",97*8,5*8,7)
 else
  -- show enemy with cup :(
  spr(107,_x1,_y1,1,2,false)
  spr(98,_x2,_y2,1,2,true)
  spr(6,_x1+(1*8),_y1-(1*8))
  
  print("don't be too sad, it was",97*8,4*8,7)
  print("a good fight!",97*8,5*8,7)
 end
 
 print("reset the cart",97*8,14*8,10)
 print("to try again",97*8,15*8,10)
 
end
