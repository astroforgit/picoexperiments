pico-8 cartridge // http://www.pico-8.com
version 5
__lua__
--bashbash by lemmo
--a 64x64 lowrezjam2016 entry

--------------------------------
--welcome to bashbash!
--controls:
--left/right to move
--up to up-thrust
--down to block
--z to jump
--x to attack
--
--how to win:
--knock your opponent off the
--pedastal seven times.
--
--written in 48 hours by lemmo
--on twitter at @lemmo
--
--special thanks to:
--camp wanameka and picocity
--my first "finished" game ever!
--------------------------------


game = {}
 game.intro = false
 game.scroll = false
 game.gameon = false
 game.live = false
 game.victory = false
 game.blink = 7
 
player = {}

active_attacks = {}

cloud = {}
 cloud.h = 32
 cloud.hn = 96
 cloud.m = 32
 cloud.mn = 96
 cloud.l = 32
 cloud.ln = 96
 cloud.w = 32
 cloud.wn = 96

function _init()
 game.intro = true
 game_intro()
end

function game_intro()
 cls()
 if btnp() > 0 then
  game.intro = false
  game.gameon = true
 end
end

function game_scroll()
--at some point i plan to have an opening scroll.
end

function game_victory()
 if btnp() > 0 then
  if game.live then
   for b in all(player) do
    del(player, b)
   end
   game.live = false
   game.victory = false
   game.intro = true
  end
 end
end

function game_gameon()
 cls()
 make_player(0,48,74,false,8,14,2,15,4,9,80,87) --player 1
 make_player(1,72,74,true,9,10,3,4,6,13,45,87) --player 2
 --make_platform(40,88,88) --big platform
 --make_platform(56,72,70) --middle pillar
 --make_platform(80,88,56) --right pillar
 --make_platform(40,48,51) --left pillar
 music(0,0,3)
 game.gameon = false
 game.live = true
end

function make_player(id,x,y,flip,pal_h,pal_hs,pal_sh,pal_sk,pal_sd,pal_sf,scorex,scorey)
 local a = {}
 a.id=id
 a.x=x
 a.y=y
 a.flip=flip
 a.pal_h=pal_h
 a.pal_hs=pal_hs
 a.pal_sh=pal_sh
 a.pal_sk=pal_sk
 a.pal_sd=pal_sd
 a.pal_sf=pal_sf
 a.frame=1
 a.swordframe=0
 a.pace=2
 a.step=0
 a.push=0
 a.speed=1
 a.swordx=0
 a.swordy=0
 -- vertical velocity
 a.vv=0
 a.hv=0
 a.block=false
 a.swing=false
 a.swinglock=false
 a.hit=false
 a.hitflip=false
 a.damage=0
 a.grounded=true
 a.jump=false
 a.djump=false
 a.dead=false
 a.ground=74
 a.gl=40
 a.gr=88
 a.score=0
 a.scorex=scorex
 a.scorey=scorey
 a.gameover=false
 add(player, a)
 return a
end

function make_platform(lx,rx,y)
 local a = {}
 a.rx=lx
 a.rx=lx
 a.y=y
 add(platform, a)
 return a
end

function move_player(pl)
 pl.walk=false
 pl.block=false
 
 if not btn(2,pl.id) then
   pl.upthrust=false
 end
 
 --check for actions 
 if not pl.hit and not pl.swinglock then
  if btn(5,pl.id) then --x
   if pl.grounded then
    pl.swing=true
    pl.swinglock=true
    sfx(20)
    pl.frame = 8        --frame 1
    pl.swordframe=12
    pl.swordy = pl.y-2
    if pl.flip then
     pl.swordx = pl.x-1
    else
     pl.swordx = pl.x+1
    end
   end
  end
  if btn(3,pl.id) then --down
   if pl.grounded and not pl.swing and not pl.hit then
    pl.block=true
   end
  end
  if btn(2,pl.id) then --up
   if pl.grounded and not pl.swing and not pl.hit then
    pl.upthrust=true
   end
  end
  if btn(4,pl.id) then --z
   if not pl.block and not pl.swing and not pl.hit then
    if pl.grounded then
     pl.grounded=false
     pl.jump=true
     pl.vv = 3
    end
   end
  end 
  if btn(1,pl.id) then --right
   if not pl.block and not pl.swing and not pl.hit and not pl.upthrust then
    pl.walk=true
    pl.flip=false
   end
  end
  if btn(0,pl.id) then --left
   if not pl.block and not pl.swing and not pl.hit and not pl.upthrust then
    pl.walk=true
    pl.flip=true
   end
  end
 end
 --has the player turned?
 if pl.flip then
  pl.push =-pl.speed
 end
 if not pl.flip then
  pl.push = pl.speed
 end
  
 --are we walking?
 if pl.walk then
  pl.step += 1
  if pl.step == pl.pace then
   pl.step = 0
   pl.x += pl.push
   if pl.x < pl.gl-7 or pl.x > pl.gr then
    pl.grounded=false
    pl.walk=false
   end
   pl.frame += 1
   if pl.frame > 5 then
    pl.frame = 1
   end
  end 
 end
 
 --are we in the air?
 if not pl.grounded then
  pl.swinglock = false
  pl.swing = false
  --are we still hit?
  if pl.hit then
   pl.frame=7
   pl.x += pl.hv
   if pl.hitflip then
    pl.hv = -pl.damage
    pl.flip=true
   else
    pl.hv = pl.damage
    pl.flip=false
   end
  else
   pl.frame=5   
  end
  
  --we're airborne! let's use gravity!
  pl.y -= pl.vv  

  --the following is a hack, remove after platform table works
  
  --big platform 40-88@88
  if pl.y > 79 and pl.y < 80-pl.vv then
   if pl.x > 40-7 and pl.x < 88 then
    pl.ground=88
    pl.gl=40
    pl.gr=88
    sfx(21)
    pl.y = pl.ground-14
    pl.grounded=true
    pl.jump=false
    pl.djump=false
    pl.hit=false
   end
  end 
  
  --middle pillar56-72@70
  if pl.y > 61 and pl.y < 62-pl.vv then
   if pl.x > 56-7 and pl.x < 72 then
    pl.ground=70
    pl.gl=56
    pl.gr=72
    sfx(21)
    pl.y = pl.ground-14
    pl.grounded=true
    pl.jump=false
    pl.djump=false
    pl.hit=false
   end
  end

  -- end hack ass shit code that needs to go
  
  --using sprite flags seems easy, but there's some unchecked issues.
  --if mapcheck(pl.x,pl.y+8) == 0 or mapcheck(pl.x+7,pl.y+8) == 0 then
  -- print(correct)
  --end

  if pl.y > 96 then
   pl.dead = true
   pl.frame = 7
   sfx(22)
   pl.score += 1
   if pl.score > 6 then
    music(0,0,0)
    sfx(25)
    pl.gameover = true
   end
   pl.x=flr(rnd(40))+40
   pl.y=48
   pl.grounded=false
   pl.vv=0
   pl.hv=0
   pl.damage=0
  end
  
  pl.vv -= .25
  --terminal velocity = -4
  if pl.vv < -4 then
   pl.vv =-4
  end
 end
 
 --if player is boring, then stand
 if pl.grounded and not pl.swing and not pl.walk and not pl.block then
  pl.frame = 1
  pl.vv=0
 end
 
 --are we swinging?
 if pl.swing then
  pl.step += 1
  if pl.step == pl.pace then
   pl.step = 0
   if pl.frame == 10 then
    pl.frame = 1
    pl.swordframe = 0
    pl.swordx = 0
    pl.swordy = 0
    pl.swing=false
    pl.swinglock=false
   end
   if pl.frame == 9 then
    pl.frame = 10        --frame 3
    pl.swordframe=14
    pl.swordy = pl.y+4
    if pl.flip then
     pl.swordx = pl.x-7
    else
     pl.swordx = pl.x+7
    end
   end
   if pl.frame == 8 then
    pl.frame = 9         --frame 2
    pl.swordframe=13
    pl.swordy = pl.y-1
    if pl.flip then
     pl.swordx = pl.x-1
    else
     pl.swordx = pl.x+1
    end
   end
  end
  create_attack(pl.swordx,pl.swordy,pl.flip,3)
 end
 
 --are we blocking?
 if pl.block then
  pl.frame=11
 end
 
 --are we upthrusting?
 if pl.upthrust then
  if pl.grounded then
   pl.frame=8
  else
   pl.frame=21
  end
  pl.swordframe=12
  pl.swordy = pl.y-2
  if pl.flip then
   pl.swordx = pl.x-1
  else
   pl.swordx = pl.x+1
  end
  create_attack(pl.swordx,pl.swordy,pl.flip,2)
 end
 
 --lastly, are we hit?
 for b in all(active_attacks) do
  b.speed -= 1
  --clean up expired swings
  if b.speed == 0 then
   del(active_attacks,b)
  end 
  if b.y > pl.y and b.y < pl.y+8 then
   if b.x > pl.x-4 and b.x < pl.x+4 then 
    pl.hitflip=b.hitflip   
    --are we blocking?
    if pl.block then
     sfx(23)
     if pl.hitflip then
      pl.x-=1
     else
      pl.x+=1
     end
     if pl.x < pl.gl-7 or pl.x > pl.gr then
      pl.grounded=false
      pl.block=false
     end
    else
     sfx(24)
     pl.hit = true
     pl.frame = 6
     pl.damage +=.1
     pl.grounded = false
     pl.vv=1
     if pl.hitflip then
      pl.flip = true
     else
      pl.flip = false
     end
    end
   end
  end
 end
end

function move_clouds()
 cloud.h -= .3
 cloud.hn -= .3
 cloud.m -= .1
 cloud.mn -= .1
 cloud.l -= .03
 cloud.ln -= .03
 cloud.w -= 0 --animate water at some point
 cloud.wn -= 0 --animate water at some point
 if cloud.hn < 33 then
  cloud.h = 32
  cloud.hn = 96
 end
 if cloud.mn < 33 then
  cloud.m = 32
  cloud.mn = 96
 end
 if cloud.ln < 33 then
  cloud.l = 32
  cloud.ln = 96
 end
 if cloud.wn < 33 then
  cloud.w = 32
  cloud.wn = 96
 end
end

function draw_clouds()
 map(8,4,cloud.l,54,8,1)
 map(8,4,cloud.ln,54,8,1)
 map(8,3,cloud.m,50,8,1)
 map(8,3,cloud.mn,50,8,1)
 map(8,0,cloud.h,32,8,3)
 map(8,0,cloud.hn,32,8,3)
 --map(8,5,cloud.w,88,8,3)
 --map(8,5,cloud.wn,88,8,3)
 end

function mapcheck(x,y)
 local mapx, mapy, maps
 mapx = flr((x-32)/8)
 mapy = flr((y-32)/8)
 maps = mget(mapx,mapy)
 return maps
end
   
function create_attack(x,y,hitflip,speed)
 local newattack = {}
 newattack.x=x
 newattack.y=y
 newattack.hitflip=hitflip
 newattack.speed=speed
 add(active_attacks,newattack)
end

function _update()
 if game.intro then
  game_intro()
 end
 if game.scroll then
  game_scroll()
 end
 if game.gameon then
  game_gameon()
 end
 if game.victory then
  game_victory()
 end
 if game.live then
  move_clouds()
  foreach(player, move_player)
 end  
end

function draw_intro()
 --fix the palette
 pal(8,8)
 pal(14,14)
 pal(2,2)
 pal(15,15)
 pal(4,4)
 pal(9,9)
 --redbash
 -- b
 rectfill(37,38,77,50,2)
 circfill(43,42,4,8)
 circfill(43,52,6,8)
 circfill(43,42,2,2)
 circfill(43,50,2,2)
 rectfill(37,38,41,52,8)
 -- a
 circfill(53,42,4,8)
 circfill(53,42,2,2)
 rectfill(49,44,57,50,8)
 rectfill(51,46,55,50,2)
 -- s
 circfill(63,42,4,8)
 circfill(63,46,4,8)
 rectfill(64,41,67,43,2)
 rectfill(59,45,62,47,2)
 -- h
 rectfill(69,38,77,50,8)
 rectfill(72,38,74,42,2)
 rectfill(72,46,74,50,2)
 --greenbash
 -- b
 rectfill(50,51,90,63,3)
 circfill(56,55,4,11)
 circfill(56,65,6,11)
 circfill(56,55,2,3)
 circfill(56,63,2,3)
 rectfill(50,51,54,65,11)
 -- a
 circfill(66,55,4,11)
 circfill(66,55,2,3)
 rectfill(62,57,70,63,11)
 rectfill(64,59,68,63,3)
 -- s
 circfill(76,55,4,11)
 circfill(76,59,4,11)
 rectfill(77,54,80,56,3)
 rectfill(72,58,75,60,3)
 -- h
 rectfill(82,51,90,63,11)
 rectfill(85,51,87,55,3)
 rectfill(85,59,87,63,3)
 --by lemmo
 rectfill(63,64,95,70,5)
 print("by lemmo",64,65,15)
 if game.blink == 10 then
  game.blink = 7
 else
  game.blink = 10
 end
 print("hit a button!",40,90,game.blink)
end

function draw_player(pl)
 pal(8,pl.pal_h)
 pal(14,pl.pal_hs)
 pal(2,pl.pal_sh)
 pal(15,pl.pal_sk)
 pal(4,pl.pal_sd)
 pal(9,pl.pal_sf)
 if pl.swinglock then
  spr(pl.swordframe,pl.swordx,pl.swordy,1,1,pl.flip)
 end
 if pl.upthrust then
  spr(pl.swordframe,pl.swordx,pl.swordy,1,1,pl.flip)
 end  
 spr(pl.frame,pl.x,pl.y,1,1,pl.flip)
 if pl.gameover then
  print("win!",pl.scorex-7,pl.scorey,1)
  game.victory = true
 else
  print(pl.score,pl.scorex,pl.scorey,1)
 end
end

function _draw()
 cls()
 rectfill(32,32,95,95,12)
 draw_clouds()
 map(0,0,32,32,16,16)
 foreach(player, draw_player)
 if game.intro then
  draw_intro()
 end
 --64x64 border
 rectfill(0,0,127,31,0)
 rectfill(0,0,31,127,0)
 rectfill(96,0,127,127,0)
 rectfill(0,96,127,127,0)
end
