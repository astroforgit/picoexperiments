pico-8 cartridge // http://www.pico-8.com
version 7
__lua__
-- isohopes
-- by leon spencer (@alazoral)
root2 = sqrt(2)
debug = false
reactor = {
  cash = 0,
  width = 12,
  height = 12,

  mediator = 0.5,
  max_heat_sync = 0.5,
  evap = 5,
  removed_heat = 0,
  max_heat = 0,

  was_warning = false,
  warning_thresh = 8,
  meltdown_thresh = 10,

  fuelcost = 40,
  sparkcost = 200,
  mediatorcost = 100,

  max_neutrons = 3000,

  rods = {},
  neutrons = {},
  temps = {},


  heat_colours = {[0] = 1, [0.25] = 13, [0.5] = 12, [2] = 9},
  last_temp = 2,

  setup = function (me)

    me.cash = 0
    me.rods = {}
    me.neutrons = {}

    me.marginwidth = (128 - (me.width * 8)) / 2
    me.marginheight = (128 - (me.height * 8)) / 2
    me.rods[me.width] = waterpump:create(me:rodx(me.width), me:rody(me.width))

    me.medigaguex = 127 - me.marginwidth/2
    me.tempgaguex = me.medigaguex + 2

    me.temps = {}
    for i=1,(me.width * me.height) do
      add(me.temps, 0.0)
    end
  end,

  rodx = function(me, rod)
    return me.marginwidth + ((rod - 1) % me.width) * 8
  end,

  rody = function(me, rod)
    return me.marginheight + flr((rod - 1) / me.width) * 8
  end,

  rodat = function(me, x, y)
    return me.rods[me:rodn(x,y)]
  end,

  rodn = function(me, x, y)
    return me.width * flr((y - me.marginheight) / 8) + flr((x - me.marginwidth) / 8) + 1
  end,

  draw = function (me)
    for n,temp in pairs(me.temps) do
      n -= 1
      local startx = (n % me.width) * 8 + me.marginwidth
      local starty = (flr(n / me.height) * 8) + me.marginheight

      if temp >= me.last_temp then
        rectfill(startx, starty, startx + 7, starty + 7, me.heat_colours[me.last_temp])
      else
        local lasttemp
        local cmin
        local cmax = 0
        local norm_temp = temp
        local max_norm_temp = 0

        for thresh, threshc in pairs(me.heat_colours) do
          cmin = cmax
          cmax = threshc
          max_norm_temp = thresh - max_norm_temp
          if thresh > temp then break end
          norm_temp = temp - thresh
        end

        local flipchance = norm_temp / max_norm_temp

        for y = starty, starty + 7 do
          for x = startx, startx + 7 do
            local c = cmin
            if rnd() < flipchance then c = cmax end
            pset(x, y, c)
          end
        end
      end
    end

    for n,rod in pairs(me.rods) do
      rod:draw()
    end
    foreach(me.neutrons, neutron.draw)
    pset(me.marginwidth, me.marginheight, 0)
    pset(127 - me.marginwidth, me.marginheight, 0)
    pset(me.marginwidth, 127 - me.marginheight, 0)
    pset(127 - me.marginwidth, 127 - me.marginheight, 0)

    -- money display

    local moneycol = 11
    if me.cash < 0 then moneycol = 8 end
    spr(33, 0, 0)
    print(me.cash .. " mil", 10, 2, moneycol)

    -- mediator gague
    line(me.medigaguex,me.marginheight, me.medigaguex,127-me.marginheight, 5)
    if me.mediator > 0 then
      line(me.medigaguex,127-me.marginheight,
           me.medigaguex,(127 - me.marginheight) - (127 - 2 * me.marginheight) * me.mediator, 12)
    end

    -- temperature gague
    line(me.tempgaguex,me.marginheight, me.tempgaguex,127-me.marginheight, 5)
    if me.max_heat > 0 then
      line(me.tempgaguex,127-me.marginheight,
           me.tempgaguex,(127 - me.marginheight) - (127 - 2 * me.marginheight) * min(1, me.max_heat / me.meltdown_thresh), 8)
    end
  end,

  update = function (me)
    local newtemps = {}
    local evaps = 0
    me.max_heat = 0
    for n,temp in pairs(me.temps) do
      local nx = (n - 1) % me.width
      local ny = flr((n - 1) / me.height)
      local totaltemp = temp
      me.max_heat = max(me.max_heat, temp)
      if temp > me.evap then
        evaps += 1
      end

      local totalcount = 1

      for iy=max(0, ny-1),min(me.height-1, ny+1) do
        for ix=max(0, nx-1),min(me.width-1, nx+1) do
          local t = me.temps[ix + 1 + (iy * me.width)]
          local dt = t - temp
          if ix != nx or iy != ny then
            totalcount += 1
            if ix != nx and iy != ny then -- diagonal
              totaltemp += temp + (me.mediator * dt * 1/root2)
            else -- adjacent
              totaltemp += temp + (me.mediator * dt)
            end
          end
        end
      end
      add(newtemps, totaltemp/totalcount)
    end

    if me.max_heat > me.meltdown_thresh then
      meltdown:start()
    else
      if me.max_heat > me.warning_thresh then
        if not me.was_warning then
          music(0)
          me.was_warning = true
        end
      else
        if me.was_warning then
          music(-1)
          me.was_warning = false
        end
      end
    end

    me.temps = newtemps
    if evaps > 0 then
      if me.mediator > 0.05 then
        sfx(2)
        me.mediator -= me.mediator / #me.temps
      else
        me.mediator = 0
      end
    end

    me.removed_heat = min(me.max_heat_sync, me.temps[me.width])
    me.cash += me.removed_heat / me.max_heat_sync

    me.temps[me.width] -= me.removed_heat

    for n,rod in pairs(me.rods) do
      rod:update()
    end

    foreach(me.neutrons, neutron.update)
    if me.explosion then
      sfx(0)
      me.explosion = false
    end
  end,

  addfuel = function(me, n)
    me.rods[n] = fuel:create(me:rodx(n), me:rody(n))
    me.cash -= me.fuelcost
  end,

  addcontrol = function(me, n)
    me.rods[n] = control:create(me:rodx(n), me:rody(n))
  end

}

waterpump = {
  sprite = 36,
  maxrate = 10,
  lastchange = 0,

  draw = function (me)
    rectfill(127 - reactor.marginwidth - 4, 2, 127 - reactor.marginwidth - 3, reactor.marginheight, 6)
    spr(34, me.x, me.y)
    palt(0, false)
    palt(7, true)
    spr(me.sprite, 127 - reactor.marginwidth - 8, 2)
    palt()
  end,

  update = function (me)
    me.lastchange += 1
    if me.lastchange > (reactor.removed_heat / reactor.max_heat_sync) * me.maxrate then
      me.lastchange = 0
      if me.sprite == 35 then
        me.sprite = 36
      else
        me.sprite = 35
      end
    end
  end,

  create = function (me, x, y)
    return setmetatable({x = x, y = y}, me)
  end,

  hit = function ()
  end,

  xbutton_desc = "retire",
  xbutton = function ()
    retire:start()
  end
}
waterpump.__index = waterpump



neutron = {
  color = 7,
  fastcolor = 8,
  medfact = 0.02,
  maxlife = 50,
  hitfact = 0.5,
  emitv = 3,
  minv = 0.2,
  bouncechance = 1,

  create = function (me, x, y)
    return setmetatable({x = x, y = y, v = me.emitv, dir = rnd(1)}, me)
  end,

  produce = function (me)
    local n = me:create(127 - reactor.marginwidth, 127 - reactor.marginheight)
    n.dir = rnd(0.25) + 0.25
    return n
  end,

  update = function (me)
    -- me.t += 1
    if me.v < me.minv then
      return del(reactor.neutrons, me)
    end

    me.v -= me.v * reactor.mediator * me.medfact

    me.lastx = me.x
    me.lasty = me.y
    me.x += me.v * cos(me.dir)
    me.y += me.v * sin(me.dir)
    local bounce = false
    if me.x < reactor.marginwidth or me.x > 127 - reactor.marginwidth then
      me.dir = (0.5 - me.dir) % 1
      bounce = true
    end
    if me.y < reactor.marginheight or me.y > 127 - reactor.marginheight then
      me.dir = 1 - me.dir
      bounce = true
    end

    if bounce then
      if rnd(1) < me.bouncechance then
        me.x = me.lastx
        me.y = me.lasty
      else
        return del(reactor.neutrons, me)
      end
      return
    end

    local n = reactor:rodn(me.x, me.y)
    local rod = reactor.rods[n]
    if rod then
      if me.x < rod.x + 2 or me.x > rod.x + 8 - 2 or
         me.y < rod.y + 2 or me.y > rod.y + 8 - 2 then
          return
      end
      if rod:hit(me) then
        reactor.explosion = true
        return del(reactor.neutrons, me)
      end
    end
  end,

  draw = function (me)
    local c = me.color
    if me.v > me.emitv * me.hitfact then
      c = me.fastcolor
    end
    if me.lastx then
      line(me.lastx, me.lasty, me.x, me.y, c)
    else
      pset(me.x, me.y, c)
    end
  end
}
neutron.__index = neutron

fuel = {
  normal = 0,
  boom = 4,
  emit = 1,
  temp = 1.0,
  max_qty = 100,
  create = function (me, x, y)
    f = {
      x = x, y = y,
      qty = me.max_qty,
      n = reactor:rodn(x, y),
      state = me.normal}
    setmetatable(f, me)
    return f
  end,

  xbutton_desc = "emit neutrons",
  xbutton_cost = reactor.sparkcost,

  xbutton = function (me)
    me:spark(4)
    reactor.cash -= reactor.sparkcost
  end,

  -- returns false if neutron should continue to exist, true if not
  hit = function (me, particle)
    if #reactor.neutrons > reactor.max_neutrons then return false end
    if particle.v > particle.emitv * particle.hitfact then
      return false
    end

    if me.state > me.normal then
      return false
    end
    if me.qty == 0 then
      return false
    end
    me.state = me.boom
    -- me.qty = max(0, me.qty - 1)
    reactor.temps[me.n] += me.temp
    return true
  end,

  spark = function (me, n)
    for i=0,n do
      add(reactor.neutrons, neutron:create(me.x + 4, me.y + 4))
    end
  end,

  update = function (me)
    if me.state == me.emit then me:spark(flr(rnd(4))) end

    if me.state > me.normal then
      me.state = max(me.normal, me.state - 1)
    end
  end,

	draw = function (me)
    local sprite = 2 - flr(me.qty / me.max_qty * 2) + 2
    if me.state > me.normal then
      sprite = 3 - me.state + 5
    end
    spr(sprite, me.x, me.y)
	end
}

fuel.__index = fuel

control = {
  create = function (me, x, y)
    return setmetatable({x = x, y = y}, me)
  end,
  update = function () end,
  draw = function (me)
    spr(18, me.x, me.y)
  end,
  hit = function ()
    return true
  end,
  xbutton_desc = "+ coolant",
  xbutton_cost = reactor.mediatorcost,
  xbutton = function (me)
    local n = reactor:rodn(me.x, me.y)
    local t = reactor.temps[n]
    reactor.temps[n] = max(0, t - 0.1)
    reactor.mediator = min(reactor.mediator + 0.1, 1)
    reactor.cash -= reactor.mediatorcost
  end,

  obutton_desc = "- coolant",
  obutton = function ()
    reactor.mediator = max(reactor.mediator - 0.1, 0)
  end
}

control.__index = control

cursor = {
  n = 1,
  update = function (me)
    local x = (me.n - 1) % reactor.width
    local y = flr((me.n - 1) / reactor.width)
    if btnp(0) then
      x = (x - 1) % reactor.width
    end

    if btnp(1) then
      x = (x + 1) % reactor.width
    end

    if btnp(2) then
      y = (y - 1) % reactor.height
    end

    if btnp(3) then
      y = (y + 1) % reactor.height
    end

    me.n = 1 + y * reactor.width + x

    local rod = reactor.rods[me.n]

    if btnp(4) then
      if rod then
        if rod.obutton then rod:obutton() end
      else
        me:obutton()
      end
    end

    if btnp(5) then
      if rod then
        if rod.xbutton then rod:xbutton() end
      else
        me:xbutton()
      end
    end
  end,

  draw = function (me)
    spr(1, reactor:rodx(me.n), reactor:rody(me.n))
    -- print(reactor.max_heat .. " c", 2, 100, 11)
    local subj = me
    if reactor.rods[me.n] then
      subj = reactor.rods[me.n]
    end
    if subj.obutton_desc then
      print("\142 " .. subj.obutton_desc, 2, 120, 11)
    end
    if subj.xbutton_desc then
      rprint( subj.xbutton_desc ..  " \151 ", 126, 120, 11)
    end
  end,

  obutton_desc = "fuel rod",
  obutton_cost = reactor.fuelcost,
  obutton = function (me)
    reactor:addfuel(me.n)
  end,

  xbutton_desc = "control rod",
  xbutton = function (me)
    reactor:addcontrol(me.n)
  end,
}

function rprint(str, x, y, col)
  print(str, x - ( 4 * #str), y, col)
end

function cprint(str, y, col)
  print(str, 64 - (#str/2*4), y, col)
end

title = {
  look = 0,
  lookv = 0,
  draw = function (me)
    cls()
    camera(0, me.look)
    if me.look == 0 then
      rectfill(0,109, 127,115, 5)
      print("start", 3, 110, 7)
      print("help", 3, 118, 5)
    else
      rectfill(0,109+8, 127,115+8, 5)
      print("start", 3, 110, 5)
      print("help", 3, 118, 7)
    end

    palt(0, false)
    palt(7, true)

    spr(64, 2,2, 6,2)
    spr(70, 2,19, 6,2)

    rprint("a chain reaction", 127, 12, 5)
    rprint("by leon spencer", 127, 19, 7)

    rectfill(0,127, 80,400, 15)
    print(
        "make $ with atoms:\n" ..
        "+ fuel & ctrl rods\n\n" ..
        "emit neutrons from\n" ..
        "fuel rod to start\n"..
        "your chain reaction\n\n"..
        "coolant moves heat\n"..
        "and slows neutrons:\n"..
        "fast neutrons can't\n" ..
        "split atoms\n\n" ..
        "coolant boils away\n"..
        "if it gets too hot,\n" ..
        "coolant meter on\n" ..
        "right side\n\n" ..
        "add coolant through\n" ..
        "control rods\n\n" ..
        "z - fuel rod\n" ..
        "  when struck they\n" ..
        "  emit neutrons\n" ..
        "  and heat\n\n" ..
        "x - control rod\n" ..
        "  they absorb\n" ..
        "  all neutrons\n\n" ..
        "spend $ 2 make $\n" ..
        "", 3, 130, 0)

    palt()
    camera()
    local mov = mid(0, me.look, 127) / 127
    local atom_s = flr(16 * (3 - mov * 2))
    local atom_x = flr(30 + mov * (127 - 60 - (atom_s/2)))
    local atom_y = flr(30 - mov * 30)

    sspr(96,32, 16,16, atom_x,         atom_y,          atom_s,atom_s, false, false)
    sspr(96,32, 16,16, atom_x + atom_s,atom_y,          atom_s,atom_s, true, false)
    sspr(96,32, 16,16, atom_x,         atom_y + atom_s, atom_s,atom_s, false, true)
    sspr(96,32, 16,16, atom_x + atom_s,atom_y + atom_s, atom_s,atom_s, true, true)
  end,

  update = function (me)

    if btn(2) then
      me.lookv -= 0.5
    else
      if btn(3) then
        me.lookv += 0.5
      else
        me.lookv = me.lookv * 2 / 3
      end
    end

    me.look = max(me.look + me.lookv, 0)
    if me.look == 0 then
      me.lookv = 0
    end

    if debug and btnp(5) then
      meltdown:start()
    end

    if btnp(4) and me.look == 0 then
      reactor:setup()
      mode = game
    end
  end
}

retire = {
  start = function(me)
    me.time = 0
    mode = me
  end,

  draw = function (me)
    camera(0, min(me.time-127, 0))
    rectfill(0,0, 127, 127, 3)
    sspr(8, 16, 8,8, 0, 0, 32,32)
    print("bank of cash", 40, 16, 7)
    print("statement", 40, 23, 7)
    rectfill(20, 40, 107, 110, 7)
    cprint("closing balance", 50, 0)
    cprint("$" .. reactor.cash .. " million", 60, 8)
    cprint("\142 to retry", 120, 7)
  end,

  update = function (me)
    me.time += 1
    if btnp(4) then run() end
  end
}

meltdown = {
  start = function(me)
    music(-1)
    sfx(4)
    me.time = 0
    mode = me
  end,

  draw = function (me)
    if me.time < 25 then
      circfill(64, 64, me.time^2 / 4, 7)
    else
      rectfill(0, 0, 127, 127, 8)
      if me.time > 50 then
        cprint("nice meltdown", 50, 7)
        if me.time > 80 then
          cprint("idiot", 60, 7)
          if me.time > 90 then
            cprint("\142 to retry", 120, 7)
          end
        end
      end
    end
  end,

  update = function (me)
    me.time += 1
    if btnp(4) then run() end
  end
}
game = {
  draw = function ()
    cls()
    reactor:draw()
    cursor:draw()
  end,

  update = function ()
    reactor:update()
    cursor:update()
  end
}

mode = title

function _draw()
  mode:draw()
end

function _update()
  mode:update()
end
