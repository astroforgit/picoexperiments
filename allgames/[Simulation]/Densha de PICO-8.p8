pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- densha de pico-8
-- by antillese
-- (C) andrew dausman 2019
-- 2020-01-29 - Multiple levels

cartdata("denshadepico8")

local train			-- train object and controls
local moon			-- moon object and behavior.
local hud			-- object to draw hud and UI	
local level			-- table of level data indexes
local gameover		-- logic value to end the game mode
local tilescreen	-- Logic value to call the attract screen
local intro			-- Attract screen object


function _init() -- runs first before the loop
	gameover = false
	titlescreen = true
	loadlevel = 1
	
	level={ -- level data
		number={1},
		mapx={0, 0, 0},
		mapy={0, 8, 16},
		trackleft={900, 806, 500},
		timelimit={30, 23, 17},
	}
	
	timer = { -- timer object
		reinit = function(self)
			timer.timelimit = level.timelimit[loadlevel]
			timer.timerrunning = false
			timer.timerstart = 0
			timer.timeleft = level.timelimit[loadlevel]
		end,
		
		update = function(self)  -- only call this in the main loop.
			if (self.timerrunning == false) and (btnp(4)) then -- start the timer the first time the brake is released
				print('stopping at timer timer start setting')
				-- stop()
				self.timerrunning = true
				self.timerstart = time()
				timer.timeleft = timer.timelimit - (time() - timer.timerstart)
			else
			timer.timeleft = timer.timelimit - (time() - timer.timerstart)
			end
		end,
	}
	
	-- create a train object
	train={
		reinit=function(self)
			train.pos = 0
			train.vel = 0
			train.accel = 0
			train.x = 32
			train.y = 30
			train.throttle = 0
			train.brake = 3
			
			train.maxspeed = 2
			train.throttletable = {0.002, 0.007, 0.010}
			train.braketable = {-0.004, -0.009, -0.010}	-- brake values should be always be negative.
			
			train.coasttable = {-0.002}
			train.convert = 20
			train.mph = 0
			train.clickdistance=75						-- number of pixels to call the click sfx
			train.clickcheck=0							-- clicker position accumulator
			train.panxoffset = {-24, 16}
			train.panyoffset = -15

		end,
		
		update=function(self)
			
			-- all the code that moves (updates) the train
			
			if btnp(2) then  -- Up D-pad: Throttle increase.
				if (self.throttle < 3) then -- Check to make sure throttle position is never above 3
					self.throttle+=1
				else				
				end
			end
			
			if btnp(3) then  -- Down D-pad: Throttle decrease
				if (self.throttle > 0) then -- Check to make sure throttle position is never below 0
					self.throttle-=1
				else
				end
			end
			
			if btnp(5) then  -- X button: brake increase (PS4 Square)
				if (self.brake < 3) then -- Check to make sure brake position is never above 3
					self.brake+=1
				else				
				end
			end
			
			if btnp(4) then  -- Z button: brake decrease (PS4 X)
				if (self.brake > 0) then -- Check to make sure brake position is never below 0
					self.brake-=1
				else
				end
			end
					
			-- Honk horn here
			if btnp(1) then  -- Right D-pad
				 -- stop()
				 sfx(0)
			end
			
			-- if btnp(0) then  -- Left D-pad
				--sfx(1)
			-- end
			
			-- Acceleration control block.
			if ((self.brake == 0) and (self.throttle == 0)) then  --  if both brake and throttle are set to zero
				self.accel= self.coasttable[1]  -- assign accel to the coast table value.
				elseif self.brake ~=0 then -- if the break is non-zero
					self.accel = self.braketable[self.brake] -- assign the brake value based on the table.
					self.throttle = 0 -- set the throttle to zero if there is any brake input.
				elseif self.throttle ~= 0 then -- accel is non-zero
					self.accel = self.throttletable[self.throttle] -- assign the throttle value based on the table.
			end -- if both values are non-zero, the brake will apply first and override the throttle position for safety.
			
			-- Update the velocity of the train based on the acceleration
			if (self.vel == 0) and (self.accel > 0) then -- check to see if the train is stopped and has positive accel
				self.vel += self.accel 		-- always additive for sign.
				elseif (self.vel > 0) and (self.vel <= self.maxspeed) then
					if (self.vel + self.accel > self.maxspeed) then -- check to see if the increase would exceed the max speed value.
						self.vel = self.maxspeed	-- set the velocity to max speed.
					else
						self.vel += self.accel 		-- always additive for sign.
					end
				elseif (self.vel < 0) then -- if the velocity drops below zero, set it to zero
					self.vel = 0
				elseif (self.vel > self.maxspeed) then -- check to see if the train is exceeding max speed.
					self.vel = self.maxspeed
			
				else
			end
			
			-- finally update the position based on velocity.
			self.pos += self.vel		-- always additive for sign.
			self.mph = flr((self.vel * self.convert))
			
			-- Click clack position accumulator
			if self.vel > 0 then			-- Check to see if the train is moving.
				if (self.pos > self.clickcheck) then 	-- check to see if we've crossed a click distance
					if (self.vel > (self.maxspeed * .60)) then		-- if you're going fast
						sfx(4)										--play the fast sfx
						self.clickcheck += self.clickdistance		-- add the full increment
					else											-- Otherwise...
						sfx(5)										-- play the slow one.
						self.clickcheck += flr(self.clickdistance * 0.7)	-- add less of the increment
					end
				else
				end
			else
			end

		end,
		
		draw=function(self)
		-- Draw the train
		-- -- Mini-sprite version
		-- spr(1,self.x, self.y) 
		-- spr(1,self.x-8, self.y, 1, 1, true, false) -- Draw the train flipped behind.
		-- -- print(self.name, self.x-3, self.y-7, 7)
		
		
		-- big sprite version
		spr(96,self.x-32, self.y-8, 8, 2) -- draw the large max
		--pantographs
		spr(71,self.x+self.panxoffset[1], self.y+self.panyoffset) 
		spr(71,self.x+16, self.y+self.panyoffset, 1, 1, true, false) 
		end

	}
	
	-- create a moon object
	bkg={
		moonx=8,
		moony=8,
						
		update=function(self)	-- Code that updates the moon.
			self.moonx+=.05  
			self.moony+=.01
		end,
		
		draw=function(self)		-- Code that draws the moon.
			rectfill(0, 0, 127, 63, 12) -- sky blue flood
			rectfill(0, 31, 127, 63, 3) -- grass flood
			
			-- koin center call
			--spr(128, 16, 1, 3, 4) 
			
			-- Sprite moon
			spr(2, self.moonx, self.moony) -- 1 sprite moon
			-- spr(76, self.x, self.y, 2, 2) -- 2 sprite full moon
			-- print(self.name, self.x, self.y+8)	
			
			-- Circle fill moon.
			-- circfill(self.x, self.y, 8, 7)
			-- circfill(self.x+4, self.y+4, 8, 12)
		end
	}
	
	-- create the ui/hud object
	hud={
		controlstring = " controls: \n throttle up ”   honk horn ‘ \n throttle down ƒ  \n \n apply brake   x/— \n release brake z/Ž",
		hudspritex = 50,
		hudspritey = 68,
		draw=function(self)
			rectfill(0, 64, 127, 127, 5) -- fill bottom gray
				
			print(' throttle: '..train.throttle, 0, 71, 7)	-- Throttle UI text setting
				
				if train.brake == 0 then					-- Throttle sprite HUD
					if train.throttle == 0 then
						spr(37, self.hudspritex , self.hudspritey)
					elseif train.throttle == 1 then
						spr(38, self.hudspritex , self.hudspritey)
					elseif train.throttle == 2 then
						spr(39, self.hudspritex , self.hudspritey)
					elseif train.throttle == 3 then
						spr(40, self.hudspritex , self.hudspritey)
					else
					end
				else
					if train.brake == 3 then
						spr(55, self.hudspritex , self.hudspritey+8)
					elseif train.brake == 2 then
						spr(54, self.hudspritex , self.hudspritey+8)
					elseif train.brake == 1 then
						spr(53, self.hudspritex , self.hudspritey+8)
					else
					end
				end
				
			--print('score: '..score, 0, 120, 8) -- print syntax example		
			-- pico-8 characters are 5 tall and 3 wide.		
			-- UI prints
			print('    brake: '..train.brake, 0, 77, 7)		-- Brake setting
			
			print('to station: '..flr(level.trackleft[loadlevel]-train.pos), 65, 71, 7) -- display the amount of track left to the station.
			print('       mph: '..train.mph, 65, 77, 7)
			
			print(' time left: ', 65, 83, 7)
									
			if timer.timerrunning == true then
				print(flr(timer.timeleft),113, 83, 7)
				else
				print(timer.timelimit,113, 83, 7)
			end
			
			
			print(self.controlstring, 0, 90, 7)  -- String for the controls UI.
			
			
			
			-- Debug prints
			--[[
			print('position: '..train.pos, 0, 83, 7)			-- train position
			
			print(' train x: '..train.x, 0, 95, 7)				-- train draw location
			print(' train y: '..train.y, 0, 101, 7) 
			print('   accel: '..train.accel, 0, 107, 7)			-- acceleration
			print('velocity: '..train.vel, 0, 113, 7)			-- velocity
			print('clickdis: '..train.clickcheck, 0, 119, 7)	-- sfx train click countdown.
			print(gameover, 58, 77, 7)							-- Game over condition
			print(titlescreen, 64, 113, 7)  					-- titlescreen variable
			print('cpu: '..stat(1), 64, 119, 7)  				-- CPU
			
			print(timer.timerrunning, 0, 0, 7)					-- is the timer running
			print(timer.timerstart,113, 89, 7)					-- when the timer was started.
			
			--]]
		end
		
	}
	
	intro = {	-- title screen behavior
		x = 60,
		y = 90,
		musicplaying = false,
		
		update=function(self)
			-- music [n [fade_len [channel_mask]]]
			if self.musicplaying == false then 	-- if the music isn't playing
				self.musicplaying=true		-- start playing the music
				music(0, 1500)
			else
			end
			
			-- Level selector
			if btnp(1) and (loadlevel < 3) then
				loadlevel+=1
			elseif btnp(0) and (loadlevel > 1) then
				loadlevel-=1
			else
			end
			
			
			if (btnp(4) or btnp(5))  then 	-- wait for a button press on the main screen then...
				train:reinit()				-- reset the train conditions
				timer:reinit()
				self.musicplaying = false
				music(-1)					-- kill the music
				sfx(0)						-- play the horn.
				-- print('densha de debug', 8, 75, 7)
				-- stop()
				titlescreen = false			-- leave the title screen.
				-- print('densha de problem', 8, 55, 7)
				-- stop()
			else
				--titlescreen = true
			end
		end,
	
		draw=function(self) -- Draw the intro screen.
			cls()
			print('densha de pico-8!', 8, 29, 7)
			spr(51, 75, 26)
			
			print('play level: ', 8, 41, 7)
			print(loadlevel, 55, 41, 7)
			
			print('use ‹ and ‘ to select', 8, 52, 7)
			print('press Ž/z or —/x to start!', 8, 58, 7)
			
			spr(96,intro.x-32, intro.y-8, 8, 2) 	-- sprite call to the large max
			-- Pantographs
			spr(71,intro.x+train.panxoffset[1], intro.y+train.panyoffset) 
			spr(71,intro.x+16, intro.y+train.panyoffset, 1, 1, true, false)
			-- map( map celx, map cely, screen x, screen y, map cell width, map cell height, [layer] )
			-- map(2, 28, 0, 68, 128, 3) -- intro screen powerlines
		
		
			--[[	
			-- big sprite version
			spr(96,self.x-32, self.y-8, 8, 2) -- draw the large max
			--pantographs
			spr(71,self.x+self.panxoffset[1], self.y+self.panyoffset) 
			spr(71,self.x+16, self.y+self.panyoffset, 1, 1, true, false) 
			]]--

		end,
	
	}
	
	endgame ={
		gameoverstring = "            game over \n \n    press z or x to play again!",
	
		update = function(self)
			if (btnp(4) or btnp(5))  then	-- wait for a button press
				titlescreen = true			-- Reset the title screen
				gameover = false			-- Reset the game over sensor
				train:reinit()
				timer:reinit()
			else
			end
		end,
		
		draw = function(self)						-- Display the game over screen
			rectfill(0, 41, 128, 64, 1)				-- BKG fill
			print(self.gameoverstring, 0, 44, 8)	-- Game over string
			print(endconditionstring, 40, 50, 8)	-- endcondition
			
			if endconditionstring == "you crashsed!" then 	-- if you crashed
				spr(52, 64, 24)								-- Show the crash sprite
			else
			end
			
		end
	
	}
	
	powerlines ={
		powercounter = 0,
		
		-- map( map celx, map cely, screen x, screen y, map cell width, map cell height, [layer] )
		draw = function(self)
			map(0, 28, 0-train.pos, 8, 128, 3)
			--map(level.mapx[level.number[1]], level.mapy[level.number[1]], 0-train.pos, 0, 128, 64)
		end
	}

	timer:reinit()
	train:reinit()
	

end

function _update()
	if titlescreen == true then
		intro:update()
	elseif gameover == true then
		endgame:update()
	
	else				-- main train game loop starts here
		train:update()	--every time we go through the loop, update the train
		bkg:update()	--every time we go through the loop, move the moon
		timer:update()	-- update the timer
		
		--check for game over condition
		if ((flr(level.trackleft[loadlevel]-train.pos) <= -29)) then
		
			gameover = true
			endconditionstring = "you crashsed!"
			
		elseif ( ((abs(level.trackleft[loadlevel]-train.pos) < 29) and train.vel == 0)) then
			
			gameover = true
			endconditionstring = "  nice stop!"
			
		elseif (timer.timerrunning == true) and (time() - timer.timerstart >= (timer.timelimit)) then -- check to see if the time has run out.
			gameover = true
			endconditionstring = "out of time!"
			
		else
		end
		
	end
	
end

function _draw()
	if titlescreen == true then		-- Draw the title screen
		intro:draw()
		--stop()
	
	elseif gameover == true then		-- if game is over draw the end screen
		endgame:draw()
	
	else
		-- draw the background
		bkg:draw()
		
		-- Map call to draw the background
		-- map( map celx, map cely, screen x, screen y, map cell width, map cell height, [layer] )
		map(level.mapx[loadlevel], level.mapy[loadlevel], 0-train.pos, 0, 128, 64)
		powerlines:draw()
		train:draw()
		-- Draw the UI.
		hud:draw()
	end


end


__gfx__
