pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
--code by puffpastryprince

--main
function _init()
 fcount = 0
 logoanim=1
 logostop=31
 logofr=70
 t=0
 tok=false
 debug={}
 locations()
 morseframe=0
 _upd=update_logo
 _drw=draw_logo
 button=false
 startgame(0)
 dirx={-1,1,0,0,1,1,-1,-1}
 diry={0,0,-1,1,-1,1,1,-1}
 _char ={".-","-...","-.-.","-..",".","..-.","--.","....","..",".---","-.-",".-..","--","-.","---",".--.","--.-",".-.","...","-","..-","...-",".--","-..-","-.--","--..",".----","..---","...--","....-",".....","-....","--...","---..","----.","-----"}
 _charv={"a" ,   "b",   "c",  "d","e",   "f",  "g",   "h", "i",   "j",  "k",   "l", "m", "n", "o",    "p",   "q",  "r",  "s","t",  "u",   "v",  "w",   "x",   "y",   "z",    "1",    "2",    "3",    "4",    "5",    "6",    "7",    "8",    "9",    "0"}
 output={}
 maxprint=8
 pick_spr=42
 gun_spr=41
 oct_spr=43
 mapx=0
 mapy=5

end

function _update() 
 _upd()
end

function _draw()
 _drw()

 cursor(4,4)
 color(8)
 for txt in all(debug) do
  print(txt)
 end
 

end

function startgame(l)
 level=l
 buttbuff = -1
-- p_mob=addmob(1,1,1)
 p_x=0
 p_y=0
 nextlevel()
 spawnplayer(level)
 p_spr=11
 p_dir=3
 frame=0
 pframe=0
 word={}
 eframe=0
 mchar=""
 dx={}
 dy={}
 _dir=4
 pct=0
 p_pick,p_gun=false,false
end

function spawnplayer(l)
 p_x=lvx[l]
 p_y=lvy[l]
end

function locations()
 btx={1 ,22,39,54, 0, 0,99}
 bty={6 ,12,14,13, 0, 0,7}
 otx={14,30,46,54, 0, 0,105}
 oty={6 ,6 ,14,10, 0, 0,7}
 lvx={2 ,17,34,49,65,82,97}
 lvy={13,14,13,14,14,12,14}
end
-->8
--update
function update_game()
 pframe=frame
 frame=checkbutton()


 if frame>0 then
  sfx(0)
 end
 if eframe>12 then
 add(word,"*")
 eframe=0
 clearchara()
 end

 if #word>maxprint then
	  local d=word[1]
	  del(word,d)
	end
 
end

function update_gameover()

end

function checkbutton()
 
 if btn(5) then
  button=true
  morseframe+=1
  eframe=0
 else
  button=false
  morseframe=0
  eframe+=1
 end
 
 
 return morseframe
end

function update_logo()
 fcount+=1
 if fcount>80 then
  _upd=update_title
  _drw=draw_title
 end
end 
function update_title()

 if btnp(5) then
  sfx(0)
  _upd=update_splash
  _drw=draw_splash
 end
end

function update_splash()
 if btnp(5) then
  _upd=update_game
  _drw=draw_game
 end
end

function update_gameover()
 if btnp(5) then
 resetmap()
 _init()
 _upd=update_logo
 _drw=draw_logo
 end
end

-->8
--draw

function draw_game()
 local locx,locy,fcheck,prnt=0,0,0,0
 cls(0)
 map(0,0,0,0,15,5)
 drawlevel()
 drawcode()
 drawtools()
 for txt in all(word) do
	  print(txt,10+locx,18+locy,7)
	  locx+=6
	  prnt+=1
	  if prnt>maxprint then
	   prnt=0
	   locx=0
	  end
	end
	locx=0
	locy=0
 for txt in all(output) do
  rectfill(46-1,10-1,46+3,10+5,5)
  print(txt,46+locx,10+locy,7)
	 locx+=6
	end
 if button==false then
  spr(1,10,3,4,2,false,false)
 else
  spr(5,10,3,4,2,false,false)
 end
 if frame-pframe<0 then
	 
	 -- for i=1,5 do
	 --  word[i]=word[i+1]
	 -- end
	
	 if pframe>=2 and pframe<6 then
	  add(word,".")
	  morsechara(".")
	 elseif pframe>=6 then
	  add(word,"-")
	  morsechara("-")
	 end
 end
 drawp_y=p_y*8
 drawp_x=(p_x-((level-1)*16))*8

 drawspr(p_spr,drawp_x,drawp_y,14,false)
end

function drawspr(_spr,_x,_y,_c,_flip)
 palt(_c,true)
 spr(_spr,_x,_y,1,1,_flip)
 pal()
end

function drawcode()
 line(57,6,57,42,6)
 line(5,42,16*8-7,42,6)
 print('   "a"gain:.-  ',60,6*1,6)
 print('"f"ordward:..-.',60,6*2,6)
 print('    "b"ack:-...',60,6*3,6)
 print('   "r"ight:.-.',60,6*4,6)
 print('    "l"eft:.-..',60,6*5,6)
 print('   retr"y":-.--',60,6*6,6)
end

function drawlevel()
 local mx,my=mapx+(level-1)*16,mapy
 local x,y=0,5*8
 map(mx,my,x,y,16,11)

end

function drawtools()
 local x,y=10,25
 pal(14,0)
 if p_pick then
  spr(66,x,y,2,2)
 end
 if p_gun then
  spr(68,x+20,y,2,2)
 end
 pal()
end

function draw_logo()
 cls()
 logo()
end

function draw_title()
 cls()
 
 print("press — to start",6*8,5,6)
 --drawing
 spr(128,1*8,8*8,20,20)
 spr(100,5*8,6*8,10,2)
 --telegraph
 spr(1,10,3,4,2,false,false)
 line(5*8+1,2*8-1,5*8-1+10*8,2*8-1,6)
 --morse
 spr(72,1*8,4*8,4,2)
 spr(76,3*8+8,4*8,4,2)
 --course
-- spr(64)
-- spr(65)
 spr(96,8*8+8,4*8,4,2)
 spr(76,11*8+7,4*8,4,2)
 --morse u
 spr(64,10*8+8,5*8+4)
 spr(64,10*8+11,5*8+4)
 spr(65,10*8+14,5*8+4)
 --morse o
 spr(65,10*8-2,4*8)
 spr(65,10*8+2,4*8)
 spr(65,10*8+6,4*8)
 --morse c
 spr(65,8*8+3,5*8+4)
 spr(64,8*8+7,5*8+4)
 spr(65,8*8+10,5*8+4)
 spr(64,8*8+14,5*8+4)
 
 
end

function draw_splash()
 local y=10
 cls()
 rectfill(0,0,15*8,15*8,2)
 print("this is a submission for ",10,y+6*1,7)
 print("the 2019  gmtk game{jam} ",10,y+6*2,7)
 print("with the theme 'onlyone' ",10,y+6*3,7)
 print(".........................",10,y+6*4,7)
 print("only one button works:— ",10,y+6*5,7)
 print("use it to give commands  ",10,y+6*6,7)
 print("to your comrade in morse ",10,y+6*7,7)
 print("code to reach the goal:Š",10,y+6*8,7)
 print("tap for . and hold for - ",10,y+6*9,7)
 print(".........................",10,y+6*10,7)
 print("mind where they face as  ",10,y+6*11,7)
 print("they will follow your    ",10,y+6*12,7)
 print("commands literally Œ    ",10,y+6*13,7)
 print("good --. --- --- -..     ",10,y+6*15,7)
 print("luck .-.. ..- -.-. -.-   ",10,y+6*16,7)

end

function draw_gameover()
  local y,x=5,5
 cls()
 rectfill(0,0,15*8,15*8,2)
 print("congratulations you won !",x,y+6*1,7)
 print("thank you for playing!   ",x,y+6*2,7)
 print("credits                  ",x,y+6*4,7)
 print("--------                 ",x,y+6*5,7)
 print("code and art:            ",x,y+6*6,7)
 print("  puffpastryprince       ",x,y+6*7,7)
 print("level & game design:     ",x,y+6*8,7)
 print("  puffpastryprince       ",x,y+6*9,7)
 print("  corgi pepper           ",x,y+6*10,7)
 print("logo animation code:     ",x,y+6*12,7)
 print("lexaloffle.com/bbs/?tid=2213",x,y+6*13,7)
 print("special thanks to the pico8 ",x,y+6*15,7)
 print("community and wiki          ",x,y+6*16,7)
 print("press — to restart the game",x,y+6*17,7)

end
