--logo
-- logo animation code:
-- www.lexaloffle.com/bbs/?tid=2213
function logo()
 
 local cx = 55
 local cy = 45
 local frx=logofr%16*8
 local fry=flr(logofr/16)*8
 for s=0,logoanim do
  for x=0,15 do
   camera(rnd(30/fcount),
          rnd(30/fcount))
   for y=0,15 do
    if(x+y==s) then 
     pset(cx+x,cy+y,7)
    elseif(x+y == s-1) then
     pset(cx+x,cy+y,6)
    elseif(x+y<s-1) then
     pset(cx+x,cy+y,
      sget(frx+x,fry+y))
    end
   end
  end
 end
 if(logoanim<=logostop) logoanim+=1
 if fcount==1 then
  sfx(10)
 end
 if(fcount > 35) then
  if fcount==36 then
   sfx(11)
  end
  print("  ppp ",49,cy+20,9)
  print("carts",53,cy+26,7)
 end
end
