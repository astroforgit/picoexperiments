--morse

function getchar(v)
 char="abcdefghijklmnopqrstuvxyz1234567890"
 return sub(chars,v,v)
end

function clearchara()
 checkchara()
 mchar=""
end

function morsechara(txt)
 mchar=mchar..txt
end

function checkchara()
 local ad=false
 if mchar!="" then
	 for i=1,#_char do
	  if mchar==_char[i] then
	   mchar=_charv[i]
	   output={}
	   add(output,_charv[i])
	   ad=true
	  end
	 end
	 if not ad then
	  output={}
	  add(output,"?")
	 else   
	  movechara(mchar)
	 end
	end
end


