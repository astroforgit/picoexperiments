pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- gunther o'brian pitching sim
-- by @joshmillard 2020

-- gunther o'brian is a pitcher
-- for the charleston shoe
-- thieves, and a penguin, and
-- not very good at pitching.
-- help him throw good!

floory = 105 -- the ground
frame = 0 -- frame counter

-- physics constants
bounce_decel_x = 0.6
bounce_decel_y = 0.57

armp = ƒ -- g's arm position
energy = 0

-- gunther's body object
g = {}
g.x = 20
g.y = 80
g.sp = 1
g.blink = false -- is he blinking

-- g's arm object
arm = {}
arm.x = 2 -- arm offset from
arm.y = 5 --  g's body

arm[ƒ] = {}
arm[ƒ].sp = 9 -- sprite
arm[ƒ].ball_x = 6 -- offset
arm[ƒ].ball_y = 10 -- offset

arm[‹] = {}
arm[‹].sp = 11
arm[‹].ball_x = 0
arm[‹].ball_y = 10

arm[‘] = {}
arm[‘].sp = 43
arm[‘].ball_x = 10
arm[‘].ball_y = 5

arm[”] = {}
arm[”].sp = 41
arm[”].ball_x = 4
arm[”].ball_y = 0

-- ball object
ball = {}
ball.x = 0
ball.y = 0
ball.sp = 37 -- sprite
ball.held = true
ball.dead = false
ball.vx = 0
ball.vy = 0

distance = 0 -- current ball d
bestdist = -999 -- record distance

targets = {} -- target inputs

mode = "title"
submode = "splash"

function _init()
 music(0)
 reset()
end

-- reset the pitching setup
function reset()
 -- reset ball
 ball.x = 0
 ball.y = 0
 ball.sp = 37 -- sprite
 ball.held = true
 ball.dead = false
 ball.vx = 0
 ball.vy = 0
 
 -- reset target inputs
 targets = {}
 dirs = {‹,”,‘,ƒ}
 for i=1,10 do
  targets[i] = dirs[flr(rnd(4)+1)]
 end
 
 -- reset input record
 inputs = {}

 -- reset energy
 energy = 0
 
 -- reset distance
 distance = 0

end


function _update()

 frame+=1 -- simple frame count

 if(mode == "title") then
  update_title()
 elseif(mode == "play") then
  update_play()
 end
end


-- updates for title screen
function update_title()

 -- make gunther blink
 if(not g.blink) then
  if(rnd(1) < 0.01) then
   g.blink = true
  end
 else
  if(rnd(1) < 0.1) then
   g.blink = false
  end
 end

 if(btnp() != 0) then
  if(submode == "splash") then
   submode = "text"
  elseif(submode == "text") then
   mode = "play"
  end
 end
end


-- updates for main play mode
function update_play()
 -- button input handling
 if(ball.held) then

  if(btnp(ƒ)) then
   do_input(ƒ)
  elseif(btnp(‹)) then
   do_input(‹)
  elseif(btnp(‘)) then
   do_input(‘)
  elseif(btnp(”)) then 
   do_input(”)
  end
 
  -- did we finish input?
  if(#inputs == #targets) then
   do_throw()
  end
 
 end
 
 if(ball.held) then
  tire()
 end
 
 rotate_ball()
 
 grav()
 move()
 
 if(btnp() != 0 and ball.dead) then
  reset()
 end
 
 -- make gunther blink
 if(not g.blink) then
  if(rnd(1) < 0.01) then
   g.blink = true
  end
 else
  if(rnd(1) < 0.1) then
   g.blink = false
  end
 end
  
end

-- gunther gets tired over time
function tire()
 energy -= 0.03
 if(energy < 0) energy = 0
end

-- process an input value
function do_input(d)
 armp = d
 add(inputs, d)
 if(armp==targets[#inputs]) then
  energy += 1
  sfx(0)
 else
  energy /= 2
  sfx(1)
 end
end


-- rotate ball randomly
function rotate_ball()
 if(not ball.held and
  not ball.dead) then
  if(frame%3==0) then
   ball.sp = 37 + flr(rnd(4))
  end
 end
end

-- apply gravitational pull
function grav()
 if(not ball.held and
  not ball.dead) then
  ball.vy += 0.1
 end
end

-- move the ball
function move()
 if(not ball.held) then
  ball.x += ball.vx
  ball.y += ball.vy
  
  if(not ball.dead) then 
  if(ball.y > floory) then
   ball.vy *= -bounce_decel_y
   ball.y = floory
   ball.vx *= bounce_decel_x
   sfx(2)
  end
  end
  
  if(abs(ball.vx) < 0.1 and
     abs(ball.vy) < 0.1 and
     abs(ball.y - floory)
      < 0.1) then
   ball.vx = 0
   ball.vy = 0
   ball.dead = true
   if(distance > bestdist) then
    bestdist = distance
   end
  end
  
  distance=flr((ball.x-28) / 4)
 end
end

-- attempt to throw the ball
function do_throw()
 -- first off do we still have
 -- the ball? if so, let's do
 -- this
 if(ball.held) then
  -- update held state
  ball.held = false
  
  -- update ball position at
  -- moment of release
  ball.x = g.x + arm.x + 
   arm[armp].ball_x
  ball.y = g.y + arm.y +
   arm[armp].ball_y
  
  -- lets use trig why not
  local theta = rnd(1)
  ball.vx = cos(theta)*energy/3 + energy/8
  ball.vy = sin(theta)*energy/3 - energy/8

 end  
end

function _draw()
 if(mode == "title") then
  draw_title()
 elseif(mode == "play") then
  draw_play()
 end
end

-- draw title scenes
function draw_title()
 cls()  
 rectfill(0,0,127,127,1)

 palt(11, true)
 palt(0, false)
 
 if(submode == "splash") then

  print("gunther o'brian's",
   30,30,15)
  print("pitching simulator",
   28,90,15)
  print("(any key)",
   46, 110) 
  spr(g.sp+1,56,56,2,2) -- gunth body
  -- sometimes he blinks
  if(g.blink) then
   pset(56+8, 56+5, 0)
  end

  rect(53,55,74,72,15)
 elseif(submode == "text") then
  t = {
"gunther o'brian is a pitcher",
"for the charleston shoe",
"thieves blaseball team.",
"",
"he's also a penguin. and he",
"doesn't know anything about",
"blaseball. like, anything.",
"",
"but he's doing his best.",
"",
"help gunther build up his",
"energy by making the right",
"pitching movements as quickly",
"as possible.",
"",
"(any key)"}
 
  for i=1,#t do
   s = t[i]
   print(s, 64-(#s*2),i*7,15)
  end
  
 end 
 

 palt()
end

-- draw gameplay scenes
function draw_play()
 cls()
 
 -- draw the field
 rectfill(0,0,127,95,12)
 rectfill(0,96,127,127,3)
 palt(11, true)
 palt(0, false)
 spr(128,0,75,16,8)
 
 -- fielder
 if(frame%40 > 19) then
  spr(68,54,93,2,2)
 else
  spr(70,54,93,2,2)
 end

 spr(5,20,102,4,2) -- mound

 -- draw gunther
 spr(g.sp,g.x,g.y,4,4) -- gunth body
 -- sometimes he blinks
 if(g.blink) then
  pset(g.x+16, g.y+5, 0)
 end
 
 
 if(ball.held) then
  -- g has the ball, draw it
  -- relative to him
  spr(37,
   g.x + arm.x + 
    arm[armp].ball_x,
   g.y + arm.y + 
    arm[armp].ball_y) -- ball
 end
 
 spr(arm[armp].sp,
  g.x + arm.x,
  g.y + arm.y,2,2) -- gunth arm

 -- draw the ball if it is
 -- in motion
 if(not ball.held) then
  spr(ball.sp, ball.x, ball.y)
 end

 -- print its ok if ball dead
 if(ball.dead) then
  local xoff = 40
  local yoff = 55
  
  if(ball.x > 90) then
   -- good throw!
   print("great job",
    xoff-25, yoff, 9)
   spr(45,xoff+12,yoff-6,2,2)
   print("gunther!",
    xoff+32,yoff,9)
   print("(any key)", 
    xoff+5,yoff+12)

  else
   print("it's",xoff,yoff,9)
   spr(13,xoff+19,yoff-6,2,2)
   print("ok",xoff+40,yoff,9)
   print("(any key)", 
    xoff+5,yoff+12)
  end
 end

 local ex = 3
 local ey = 120
 print("energy",ex,ey,9)
 local w=energy*5
 rect(ex+27,ey-1,ex+77,ey+5, 1)
 rectfill(ex+28,ey,
   ex+28+w,ey+4,9)

 if(not ball.held) then
  print("distance: " .. 
   distance .. " feet",
   32,35, 4)
 end
 
 if(bestdist != -999) then
  print("best: " ..
   bestdist .. " feet",
   2,2,4)
 end
 fillp(0b0101101001011010.1)
 rectfill(108,0,127,90,13)
 fillp()
 rect(107,-1,128,91,0)
 -- draw target commands
 for i=1,10 do
  spr(targets[i]+64, 
   109,-8+(i*9))
 end
 
 -- and actual inputs
 for i=1,10 do
  if(inputs[i]) then
   local sp = 80
   if(inputs[i] != targets[i]) then
    sp = 96
   end
   spr(inputs[i]+sp,
    119,-8+(i*9))
  end
 end 
 
 palt()
 
end
__gfx__
