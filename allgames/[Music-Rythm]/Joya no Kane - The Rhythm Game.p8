-- consts
dt = 1.0/30
g = 9.8

world_ratio = 16 -- world -> render
camera_center_x = 2.8
camera_center_y = 3.0

bell_x = 3.4
bell_y = 1.6
bell_size = 2.2
shumoku_x = 1.0
shumoku_y = 1.6
shumoku_w = 2.0
shumoku_length = 1.4

shoro_x = -0.2
shoro_y = 0.0
shoro_w = 7.2
shoro_h = 5.7

bell_mass = 100
shumoku_mass = 10
bell_com = 0.6

full_tick = 15 * 60 * 30
ring_count = 108

timings = {
  {1,  2.00,  9, 0},
  {6,  1.50,  8, 8},
  {15, 1.00,  4, 16},
  {90, 0.50,  2, 24},
  {nil,0.00,  6, 32},
}

max_timing_zone = 90

dither_matrix = {
  0, 8, 2, 10,
  12, 4, 14, 6,
  3, 11, 1, 9,
  15, 7, 13, 5
}

title_fadein_state = "title_fadein"
title_state = "title"
starting_state = "starting"
playing_state = "playing"
ending_state = "ending"
result_state = "result"
result_fadeout_state = "result_fadeout"

function reset_data()
  zoom_level = 2.0

  bell_r = 0
  shumoku_r = 0

  bell_vr = 0.0
  shumoku_vr = 0.0

  collision_cooldown = 0

  score = 0
  
  playing_tick = 0

  last_timing_rate = nil
  last_timing_tick = nil

  notes = {}
  for i=1,ring_count do
    notes[i]=full_tick/ring_count*i
  end

  next_note_idx = 1

  state_tick = 0
  next_state = title_fadein_state
end

function _init()
  reset_data()
end

function _update()
  local shumoku_force_dir = ""

  if next_state != nil then
    state = next_state
    next_state = nil
    state_tick = 0
  else
    state_tick += 1
  end

  if state == title_fadein_state then
    if (btn(4)) then
      sfx(4)
      next_state = starting_state
    end

    if state_tick >= 30 then
      next_state = title_state
    end

  elseif state == title_state then
    if(btn(4)) then
      sfx(4)
      next_state = starting_state
    end
  
  elseif state == starting_state then
    if state_tick >= 30 then
      next_state = playing_state
    end

  elseif state == playing_state then
    if(btn(0)) then
      shumoku_force_dir = "left"
    elseif(btn(1)) then
      shumoku_force_dir = "right"
    end

  elseif state == ending_state then
    if state_tick >= 30 then
      next_state = result_state
    end

  elseif state == result_state then
    if(btn(4)) then
      sfx(4)
      next_state = result_fadeout_state
    end

  elseif state == result_fadeout_state then
    if state_tick >= 30 then
      reset_data()
      next_state = title_state
    end
  else

  end

  update_physics(shumoku_force_dir)
  local collided_fg = process_collision()
  
  if collided_fg then
    music(0)
  end

  if state == playing_state then
    if next_note_idx <= #notes then
      if collided_fg then
        for i=1,#timings do
          local v = timings[i]
          if v[1] != nil and abs(playing_tick - notes[next_note_idx]) <= v[1] then
            last_timing_rate = i
            last_timing_tick = playing_tick
            score += v[2]
            next_note_idx += 1
            break
          end
        end
      elseif playing_tick > notes[next_note_idx]+max_timing_zone then
        last_timing_rate = 5
        last_timing_tick = playing_tick
        next_note_idx += 1
      end

      if next_note_idx > #notes then
        next_state = ending_state
      end
    end
    
    playing_tick += 1
  end
end

function update_physics(shumoku_force_dir)
  local shumoku_ar=0
  if(shumoku_force_dir == "left") then
    shumoku_ar=-0.36
  elseif(shumoku_force_dir == "right") then
    shumoku_ar=0.36
  end
  bell_vr, bell_r = pendulum_runge_kutta(
    bell_size * bell_com,
    bell_r,
    bell_vr,
    0,
    0.05
  )
  shumoku_vr, shumoku_r = pendulum_runge_kutta(
    shumoku_length,
    shumoku_r,
    shumoku_vr,
    shumoku_ar,
    0.1
  )
end

function _draw()
  cls(0)
  if playing_tick < 30 * 30 then
    zoom_level = 1.4
  else
    zoom_level = (1.4-1.0*sin((playing_tick - 30 * 30)/(full_tick - 30 * 30)))
  end
  zoom_level = zoom_level * zoom_level
  -- world
  -- bg
  camera()
  draw_bg()
  -- objects
  camera(ra(camera_center_x) - 64, ra(camera_center_y) - 72)
  draw_shumoku()
  draw_bell()
  -- fg
  camera(ra(camera_center_x) - 64, ra(camera_center_y) - 72)
  draw_shoro()
  draw_base()
  camera()

  -- ui
  draw_ui_bg()
  draw_score_graph()
  draw_score()
  draw_rate_score()
  draw_time()
  draw_notes()
  draw_rate()
  draw_title()
  draw_manual()
  draw_greeting()

  draw_fade_black()
end

function pendulum_runge_kutta(l,r,vr,ar,drag)
  ar = ar or 0
  drag = drag or 0
  local k1=dt*dvr_dt(l,r,vr,ar,drag)
  local m1=dt*dr_dt(vr)
  
  local k2=dt*dvr_dt(l,r+m1/2,vr+k1/2,ar,drag)
  local m2=dt*dr_dt(vr+k1/2)
  
  local k3=dt*dvr_dt(l,r+m2/2,vr+k2/2,ar,drag)
  local m3=dt*dr_dt(vr+k2/2)
  
  local k4=dt*dvr_dt(l,r+m3,vr+k3,ar,drag)
  local m4=dt*dr_dt(vr+k3)
  
  local k=(k1+2*k2+2*k3+k4)/6
  local m=(m1+2*m2+2*m3+m4)/6
  
  return vr+k, r+m
end

function dvr_dt(l,r,vr,ar,drag)
  return (-g/l*(sin_m(r)))-vr*drag+ar
end

function dr_dt(vr)
  return vr
end

function process_collision()
  if collision_cooldown < 20 then
    collision_cooldown += 1
    return
  end

  local shumoku_point_x=shumoku_x+shumoku_w/2+shumoku_length*cos_m(shumoku_r-pi/2)
  local shumoku_point_y=shumoku_length*sin_m(shumoku_r+pi/2)
  
  local bell_rect_xs={
    -bell_size/2, bell_size/2,
    bell_size/2, -bell_size/2
  }
  local bell_rect_ys={
    0, 0,
    bell_size, bell_size
  }
  
  for i=1,4 do
    bell_rect_xs[i]=bell_rect_xs[i]*cos_m(-bell_r)
      -bell_rect_ys[i]*sin_m(-bell_r)
    bell_rect_ys[i]=bell_rect_xs[i]*sin_m(-bell_r)
      +bell_rect_ys[i]*cos_m(-bell_r)
    bell_rect_xs[i]+=bell_x
  end
  
  local collided_fg=true
  
  for i=1,4 do
    local vx1=bell_rect_xs[i%4+1]-bell_rect_xs[i]
    local vy1=bell_rect_ys[i%4+1]-bell_rect_ys[i]
    local vx2=shumoku_point_x-bell_rect_xs[i]
    local vy2=shumoku_point_y-bell_rect_ys[i]
    
    if vx1*vy2-vx2*vy1 < 0 then
      collided_fg=false
    end
  end
  
  if collided_fg then
    local bell_vr_next = (
      (bell_mass - shumoku_mass)*bell_vr
        +2*shumoku_mass*shumoku_vr
      ) / (bell_mass + shumoku_mass)
    
    local shumoku_vr_next = (
      (shumoku_mass - bell_mass)*shumoku_vr
        +2*bell_mass*bell_vr
      ) / (bell_mass + shumoku_mass)
    
    bell_r += bell_vr_next * dt * 2
    shumoku_r += shumoku_vr_next * dt * 2
    
    bell_vr = bell_vr_next
    shumoku_vr = shumoku_vr_next

    collision_cooldown = 0
  end
  
  return collided_fg
end

function draw_bg()
  for i=0,127 do
    local g=sky_gradient(i)
    g=flr(g*16)
    local fp=0
    for j=1,16 do
      fp=shl(fp,1)
      if dither_matrix[j]>=g then
        fp+=1
      end
    end
    fillp(fp)
    line(0,i,128,i,0x01)
    fillp(0)
  end

  circfill(28+playing_tick/full_tick*16.0,28-playing_tick/full_tick*12.0,10,7)
end

function sky_gradient(y)
  return mid(0,1,(y-32)/96)
end

function draw_shumoku()
  line(
    ra(shumoku_x+shumoku_w/2*0.6),
    ra(shumoku_y),
    ra(shumoku_x+shumoku_w/2*0.6+shumoku_length*cos_m(shumoku_r-pi/2)),
    ra(shumoku_y-shumoku_length*sin_m(shumoku_r-pi/2)),
    5
  )
  line(
    ra(shumoku_x-shumoku_w/2*0.6),
    ra(shumoku_y),
    ra(shumoku_x-shumoku_w/2*0.6+shumoku_length*cos_m(shumoku_r-pi/2)),
    ra(shumoku_y-shumoku_length*sin_m(shumoku_r-pi/2)),
    5
  )
  sspr(
    8,0,8,8,
    ra(shumoku_x-shumoku_w/2+shumoku_length*cos_m(shumoku_r-pi/2)),
    ra(shumoku_y-shumoku_length*sin_m(shumoku_r-pi/2)),
    ra(shumoku_w),ra(0.25)
  )
  sspr(16,0,3,8,
    ra(shumoku_x+shumoku_w/2+shumoku_length*cos_m(shumoku_r-pi/2))-3*zoom_level/2,
    ra(shumoku_y-shumoku_length*sin_m(shumoku_r-pi/2)),
    3*zoom_level,ra(0.25)
  )
  sspr(19,0,3,8,
    ra(shumoku_x-shumoku_w/2+shumoku_length*cos_m(shumoku_r-pi/2))-3*zoom_level/2,
    ra(shumoku_y-shumoku_length*sin_m(shumoku_r-pi/2)),
    3*zoom_level,ra(0.25)
  )
end

function draw_bell()
  local support_x=ra(bell_x)
  local support_y=ra(bell_y)
  
  local draw_res = mid(0.5,2,zoom_level+1)
  
  for drawx=0,flr(16*draw_res-1) do
    for drawy=0,flr(16*draw_res-1) do
      local c=sget(drawx/draw_res+112,drawy/draw_res+0)
      local theta=bell_r
      local obj_x=(drawx/draw_res-8)*cos_m(-theta)
        -(drawy/draw_res)*sin_m(-theta)
      local obj_y=(drawx/draw_res-8)*sin_m(-theta)
        +(drawy/draw_res)*cos_m(-theta)
      local disp_x=flr(obj_x/16*ra(bell_size))+support_x
      local disp_y=flr(obj_y/16*ra(bell_size))+support_y
      if c!=0 then
        rectfill(disp_x,disp_y,disp_x+ra(bell_size/16/draw_res),disp_y+ra(bell_size/16/draw_res),c)
      end
    end
  end
end

function draw_shoro()
  sspr(64,0,40,32,ra(shoro_x),ra(shoro_y),ra(shoro_w),ra(shoro_h))
end

function draw_base()
  circfill(ra(bell_x),ra(shoro_y+shoro_h+60.0-0.4),ra(60.0),5)
  circfill(ra(bell_x),ra(shoro_y+shoro_h+60.0-0.4),ra(58.0),1)
  circfill(ra(bell_x),ra(shoro_y+shoro_h+60.0-0.4),ra(56.0),0)
end

function draw_ui_bg()
  local a, y
  if state == starting_state then
    a = remap(state_tick, 0, 30, 0.0, 1.0)
    y = 120
  elseif state == playing_state then
    a = 1
    y = 120
  elseif state == ending_state then
    a = 1.0
    if state_tick < 10 then
      y = 120
    else
      y = sinoid(remap(state_tick, 10, 30), 120, 80)
    end
  elseif state == result_state then
    a = 1.0
    y = 80
  elseif state == result_fadeout_state then
    a = 1.0
    y = 80
  else
    return
  end

  for i=0,20 do
    local g=ui_bg_gradient(i)*a
    g=flr(g*16)
    local fp=0
    for j=1,16 do
      fp=shl(fp,1)
      if dither_matrix[j]>=g then
        fp+=1
      end
    end
    fillp(fp+0.5)
    line(0,i+y-10,128,i+y-10,13)
    fillp(0)
  end
end

function ui_bg_gradient(x)
  local m = 10
  local d = abs(x-m)
  return mid(0,1,(m-d)/5)
end

function draw_notes()
  local a, y
  if state == starting_state then
    a = remap(state_tick, 0, 30, 0.0, 1.0)
    y = remap(state_tick, 0, 30, 160, 120)
  elseif state == playing_state then
    a = 1
    y = 120
  elseif state == ending_state then
    a = 1.0
    if state_tick < 10 then
      y = 120
    else
      y = sinoid(remap(state_tick, 10, 30), 120, 160)
    end
  elseif state == result_state then
    a = 1.0
    y = 160
  elseif state == result_fadeout_state then
    a = 1.0
    y = 160
  else
    return
  end

  local circle_r = 16
  
  circfill(64, y, circle_r + 1, 6)
  circfill(64, y, circle_r - 1, 0)
  
  if next_note_idx <= #notes then
    local timing_diff = (playing_tick - notes[next_note_idx])
  
    for i=1,#timings do
      local v = timings[i]
      if v[1] != nil and abs(timing_diff) <= v[1] then
        local c = v[3]
        circ(64, y, circle_r - sin(atan2(1,timing_diff/90/2))*64, c)
        break
      end
    end
  end
end

function draw_score_graph()
  local a, y
  if state == starting_state then
    a = remap(state_tick, 0, 30, 0.0, 1.0)
    y = remap(state_tick, 0, 30, 160, 120)
  elseif state == playing_state then
    a = 1
    y = 120
  elseif state == ending_state then
    a = 1.0
    if state_tick < 10 then
      y = 120
    else
      y = sinoid(remap(state_tick, 10, 30), 120, 80)
    end
  elseif state == result_state then
    a = 1.0
    y = 80
  elseif state == result_fadeout_state then
    a = 1.0
    y = 80
  else
    return
  end

  rectfill(15,y-4,41,y+4,1)
  local score_rate=max(remap(score,0,ring_count,0.0,1.0),0.0)
  if flr(lerp(score_rate,0,40-16)) > 0 then
    local color
    if score_rate > 0.66 then
      color=12
    elseif score_rate > 0.33 then
      color=12
    else
      color=5
    end
    rectfill(16,y-4,16+lerp(mid(score_rate,0.0,1.0),0,40-16),y+4,color)
  end
  if flr(lerp(score_rate-1.0,0,40-16)) > 0 then
    local color
    if score_rate-1.0 > 0.66 then
      color=8
    elseif score_rate-1.0 > 0.33 then
      color=9
    else
      color=10
    end
    rectfill(16,y-4,16+lerp(mid(score_rate-1.0,0.0,1.0),0,40-16),y+4,color)
  end
  rect(15,y-4,41,y+4,6)

  pal(7,6)
  sspr(48,24,8,8,7,y-3)
  pal()
end

function draw_score()
  local a, y
  if state == starting_state then
    a = remap(state_tick, 0, 30, 0.0, 1.0)
    y = remap(state_tick, 0, 30, 160, 120)
  elseif state == playing_state then
    a = 1
    y = 120
  elseif state == ending_state then
    a = 1.0
    if state_tick < 10 then
      y = 120
    else
      y = sinoid(remap(state_tick, 10, 30), 120, 80)
    end
  elseif state == result_state then
    a = 1.0
    y = 80
  elseif state == result_fadeout_state then
    a = 1.0
    y = 80
  else
    return
  end

  local score_text = tostr(score)
  if flr(score) == score then
    score_text = score_text .. ".0"
  end

  print(score_text, 40 - 4 * #score_text, y-2, 6)
end

function draw_time()
  local a, y
  if state == starting_state then
    a = remap(state_tick, 0, 30, 0.0, 1.0)
    y = remap(state_tick, 0, 30, 160, 120)
  elseif state == playing_state then
    a = 1
    y = 120
  elseif state == ending_state then
    a = 1.0
    if state_tick < 10 then
      y = 120
    else
      y = sinoid(remap(state_tick, 10, 30), 120, 80)
    end
  elseif state == result_state then
    a = 1.0
    y = 80
  elseif state == result_fadeout_state then
    a = 1.0
    y = 80
  else
    return
  end

  local sec = flr(playing_tick / 30) % 60
  local minute = (flr(playing_tick / 30 / 60) + 45) % 60
  local hour = (flr(playing_tick / 30 / 60 / 60) + 23) % 24
  
  if sec < 10 then
    sec = "0" .. sec
  end
  
  if minute < 10 then
    minute = "0" .. minute
  end
  
  if hour < 10 then
    hour = "0" .. hour
  end
  
  local delimiter = " "
  if playing_tick % 30 < 15 then
    delimiter = ":"
  end
  
  local text = hour .. delimiter .. minute .. delimiter .. sec
  print(text, 88, y-2, 6)
end

function draw_rate()
  local a, y
  if state == starting_state then
    a = remap(state_tick, 0, 30, 0.0, 1.0)
    y = remap(state_tick, 0, 30, 160, 120)
  elseif state == playing_state then
    a = 1
    y = 120
  elseif state == ending_state then
    a = 1.0
    if state_tick < 10 then
      y = 120
    else
      y = sinoid(remap(state_tick, 10, 30), 120, 160)
    end
  elseif state == result_state then
    a = 1.0
    y = 160
  elseif state == result_fadeout_state then
    a = 1.0
    y = 160
  else
    return
  end

  if last_timing_rate == nil then
    return
  end
  
  if playing_tick < last_timing_tick + 3 * 30 then
    pal(7,5)
    sspr(timings[last_timing_rate][4],24,8,8,64-8+1,y-8+1,16,16)
    pal(7,timings[last_timing_rate][3])
    sspr(timings[last_timing_rate][4],24,8,8,64-8,y-8,16,16)
    pal()
  end
end

function draw_rate_score()
  local a, y
  if state == starting_state then
    a = remap(state_tick, 0, 30, 0.0, 1.0)
    y = remap(state_tick, 0, 30, 160, 120)
  elseif state == playing_state then
    a = 1
    y = 120
  elseif state == ending_state then
    a = 1.0
    if state_tick < 10 then
      y = 120
    else
      y = sinoid(remap(state_tick, 10, 30), 120, 64)
    end
  else
    return
  end

  if last_timing_rate == nil then
    return
  end

  if playing_tick < last_timing_tick + 30 then
    local anim = sinoid(remap(playing_tick - last_timing_tick, 0, 30))
    local score_text = "+" .. tostr(timings[last_timing_rate][2])
    if flr(timings[last_timing_rate][2]) == timings[last_timing_rate][2] then
      score_text = score_text .. ".0"
    end
    print(score_text, 40 - 4 * #score_text, y - 2 - 8 * anim, timings[last_timing_rate][3])
  end
end

function draw_title()
  local size
  if state == title_fadein_state then
    size = 1.0
  elseif state == title_state then
    size = 1.0
  elseif state == starting_state then
    size = sinoid(remap(state_tick, 0, 30), 1.0, 20.0)
  else
    return
  end

  sspr(0,16,8,8,
    64-52*size,
    64-30*size,
    32*size,
    32*size
  )
  sspr(8,16,8,8,
    64-38*size,
    64+2*size,
    32*size,
    32*size
  )
  sspr(16,16,8,8,
    64-12*size,
    64-12*size,
    24*size,
    24*size
  )
  sspr(24,16,8,8,
    64+14*size,
    64-18*size,
    40*size,
    40*size
  )
end

function draw_manual()
  local blink_1, blink_all = false
  if state == title_fadein_state then
    blink = flr(state_tick / 15) % 2
  elseif state == title_state then
    blink = flr(state_tick / 15) % 2
  elseif state == starting_state then
    if state_tick < 20 then
      blink = flr(state_tick / 2) % 2
      blink_all = true
    else
      return
    end
  else
    return
  end

  if not blink_all or blink == 0 then
    print("‹‘ : move shumoku", 26, 100, 7)
  end
  if blink == 0 then
    print("press Ž to start", 30, 108, 7)
  end
end

function draw_greeting()
  local h
  if state == result_state then
    if state_tick < 60.0 then
      h = sinoid(remap(state_tick, 0, 60.0))
    else
      h = 1
    end
  elseif state == result_fadeout_state then
    h = 1
  else
    return
  end

  pal(7,9)
  sspr(32,16,32,8,18,40-h*11,96,24*h)
  pal()
end

function draw_fade_black()
  local alpha
  if state == title_fadein_state then
    alpha = remap(state_tick, 0, 30, 1.0, 0.0)
  elseif state == result_fadeout_state then
    alpha = remap(state_tick, 0, 30, 0.0, 1.0)
  else
    return
  end

  local g=alpha
  g=flr(g*16)
  local fp=0
  for j=1,16 do
    fp=shl(fp,1)
    if dither_matrix[j]>=g then
      fp+=1
    end
  end
  fillp(fp+0.5)
  rectfill(0,0,128,128,0)
  fillp(0)
end

pi=3.1415

function sin_m(angle)
  return -sin(angle/(pi*2))
end

function cos_m(angle)
  return cos(angle/(pi*2))
end

function ra(x)
  return x*world_ratio*zoom_level
end

function lerp(t, a, b)
  if a == nil then
    a = 0.0
    b = 1.0
  elseif b == nil then
    a = 0.0
    b = a
  end

  return (b-a)*t+a
end

function sinoid(t, a, b)
  return remap(sin(lerp(t, 0.25, -0.25)), -1, 1, a, b)
end

function remap(value, from1, to1, from2, to2)
  return lerp((value - from1) / (to1 - from1), from2, to2)
end
