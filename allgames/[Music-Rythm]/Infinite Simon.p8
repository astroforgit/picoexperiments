pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
-- infinite simon
-- by sadfloppy
function _init()
	menu_countdown=-1
	blink_frame=0
	blink_speed=8
	blink_color=7
	blink_color_idx=1

	mtext_x=128
	mtext_xedge=-40
	
	startx=128
	
	sprite_frame=-1
	buttonpushed=false
	
	init_game()
	
	_update60 = update_menu
	_draw = draw_menu
	
end

function init_game()
	menu_countdown=-1
	
	music(0)
	interval=2
	sequence={}
	add(sequence, flr(rnd(4)+1))
	playerturn=false
	result=false
	
	turn=0
	
	time_since_inc=0
	c_time_since_inc=0
	countdown=3

	uspr=2
	dspr=14
	lspr=6
	rspr=10

	stage="simons turn"
end
-->8
--updates
function update_menu()
	do_blink()
	if menu_countdown<0 then
		if btnp(—) then
			menu_countdown=30
			sfx(00)
			music(-1,500)
			//init_game()
		end
	else
		menu_countdown-=1
		do_blink()
		do_blink()
		do_blink()
		do_blink()
		do_blink()
		do_blink()
		do_blink()
		if menu_countdown<=0 then
			menu_countdown=-1
			--different for difficulty
			_update60 = update_game
			_draw = draw_game
		end
	end
end

function update_game()
	pushbutton()
	if playerturn==true then
		player_turn()
		stage="your turn"
	else
		simon_turn()
		stage="simons turn"
	end
end

function update_gameover()
	do_blink()
	if menu_countdown<0 then
		if btnp(—) then
			sfx(00)
			menu_countdown=30
		end
	else
		menu_countdown-=1
		do_blink()
		do_blink()
		do_blink()
		do_blink()
		do_blink()
		do_blink()
		do_blink()
		if menu_countdown<=0 then
			menu_countdown=-1
			init_game()
			_update60=update_menu
			_draw=draw_menu
		end
	end
end
-->8
--draws
function draw_menu()
	cls()
	if mtext_x>=-128 then
		mtext_x-=1
	else
		mtext_xedge=-40
		mtext_x=128
	end
	
	print("mini jam 62:color submission",mtext_x,2,8)
	
	spr(34,10,32,13,2)
	spr(78,63,47,2,1)
	spr(64,10,56,14,2)
	print("press — to start",32,80,blink_color)
	print("made by sadfloppy",32,120,13)
end

function draw_game()
	cls()
	
	--background
	rectfill(0,0,127,87,15)
	for u=0,64 do 
		spr(96,u*8,88,1,2)
	end
	spr(uspr,58,41,2,2)
	spr(lspr,42,57,2,2)
	spr(rspr,74,57,2,2)
	spr(dspr,58,73,2,2)
	
	--lines
	pset(16,16,5)
	line(18,16,19,16,5)
	line(21,16,22,16,5)	
	line(24,16,103,16,5)	
	line(105,16,106,16,5)
	line(108,16,109,16,5)
	pset(111,16,5)
	pset(16,31,5)
	line(18,31,19,31,5)
	line(21,31,22,31,5)	
	line(24,31,103,31,5)	
	line(105,31,106,31,5)
	line(108,31,109,31,5)
	pset(111,31,5)
		
	print("‹",58,113,11)
	print("”",63,107,10)
	print("ƒ",63,119,13)
	print("‘",68,113,14)
	draw_text_info()
end

function draw_text_info()
	if playerturn==true then
		print(stage,64-(#stage*2),22,5)
	else
		if countdown != 0 then
			print(stage .." in ".. tostr(countdown),64-(#(stage .." in ".. tostr(countdown))*2),22,5)
		else
			print(stage,64-(#stage*2),22,5)
		end
	end
end

function draw_gameover()
	cls()
	spr(97,10,32,12,2)
	spr(128,25,50,12,2)
	print("your score is: "..tostr(#sequence),64-(#("your score is: "..tostr(#sequence)))*2,70,7)
	print("press — to restart",64-(#"press — to restart")*2,88,blink_color)
end
-->8
--custom function
function do_blink()
	local blink_map={9,10,7,10}
	blink_frame+=1
	if blink_frame>blink_speed then
		blink_frame=0
		blink_color_idx+=1
		if blink_color_idx > #blink_map then
			blink_color_idx=1
		end
		blink_color=blink_map[blink_color_idx]
	end
end


function simon_turn()
	if countdown !=0 then
		if time() - c_time_since_inc>1 then
			countdown-=1
			c_time_since_inc=time()
		end
	else
		if time() - time_since_inc>interval then
			if turn < #sequence then	
				turn+=1
				sfx(sequence[turn])
				if sequence[turn] == 1 then
					lspr=8
					buttonpushed=true
					sprite_frame=5
				elseif sequence[turn] == 2 then
					rspr=12
					buttonpushed=true
					sprite_frame=5
				elseif sequence[turn] == 3 then
					uspr=4
					buttonpushed=true
					sprite_frame=5
				elseif sequence[turn] == 4 then
					dspr=32
					buttonpushed=true
					sprite_frame=5
				end
			else
				uspr=2
				dspr=14
				lspr=6
				rspr=10
				playerturn=true
				turn=1
			end
			time_since_inc=time()
		end
	end
end

function player_turn()
	if btnp(0) or btnp(1) or btnp(2) or btnp(3) then
		buttonpushed=true
		sprite_frame=5
	end
	if turn <= #sequence then
		--left
		if btnp(0) then
			lspr=8
			buttonpushed=true
			sprite_frame=5
			if sequence[turn] == 1 then
				sfx(1)
				turn+=1
			else
				gameover()
			end
			--right
		elseif btnp(1) then
			rspr=12
			if sequence[turn] == 2 then
				sfx(2)
				turn+=1
			else
				gameover()
			end
		--up
		elseif btnp(2) then
			uspr=4
			if sequence[turn] == 3 then
				sfx(3)
				turn+=1
			else
				gameover()
			end
		--down
		elseif btnp(3) then
			dspr=32
			if sequence[turn] == 4 then
				sfx(4)
				turn+=1
			else
				gameover()
			end
		end
	else
		playerturn=false
		turn=0
		countdown=3
		add(sequence, flr(rnd(4)+1))
		interval-=0.2
	end
end

function gameover()
	sfx(5)
	_update60=update_gameover
	_draw=draw_gameover
end

function pushbutton()
	if sprite_frame>0 and buttonpushed==true then
	 sprite_frame-=1
 else
 	uspr=2
		dspr=14
		lspr=6
		rspr=10
		sprite_frame=-1
		buttonpushed=false
	end
end
