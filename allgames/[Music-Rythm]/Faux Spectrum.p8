pico-8 cartridge // http://www.pico-8.com
version 32
__lua__
-- faux spectrum - botious
-- by bitwise creative

-- 31 chars max label line length!

f=0
songs={0,16,36,52}
song=1
songf=0

pspec=nil
speccolmode=2
speccolm1=9

-- lrudox
btnchars={'‹','‘','”','ƒ','Ž','—'}

function _draw()
  f=f+1
  if f>32000 then f=0 end
  --printh(tdump(f))
  cls(0)
  -- title
  -- rectfill(0,100,127,106,1)
  -- print('faux spectrum',2,101,0)
  -- print('botious.net',83,101,0)
  print('faux spectrum',2,117,1)
  print('botious.net',83,117,1)
  --
  local csfx=cursfx()
  draw_csfx_table(csfx)
  local v=cursfxvel(csfx)
  draw_piano(v,124,2,0,2,1)
  draw_piano(v,127,1,0,2,3)
  -- faux spectrum...
  local spec=soundspec(csfx,pspec)
  draw_spectrum(spec)
  pspec=spec
  -- song start delay handling
  if fdiff(f,songf)==15 then
    music(songs[song])
  end
  -- change colors
  if btnp(4) then
    speccolm1=speccolm1-1
    if speccolm1<1 then speccolm1=15 end
  end
  if btnp(5) then
    speccolm1=speccolm1+1
    if speccolm1>15 then speccolm1=1 end
  end
  -- change mode
  if btnp(3) then
    speccolmode=speccolmode-1
    if speccolmode<1 then speccolmode=4 end
  end
  if btnp(2) then
    speccolmode=speccolmode+1
    if speccolmode>4 then speccolmode=1 end
  end
  -- change song
  if btnp(0) then
    song=song-1
    if song<1 then song=#songs end
    songf=f
    --music(songs[song])
    music(-1)
  end
  if btnp(1) then
    song=song+1
    if song>#songs then song=1 end
    songf=f
    --music(songs[song])
    music(-1)
  end
  -- info
  print(btnchars[1]..btnchars[2],82,2,5)
  print('song '..song,100,2,14)
  print(btnchars[3]..btnchars[4],82,8,5)
  print('mode '..speccolmode,100,8,15)
  print(btnchars[5]..btnchars[6],82,14,5)
  print('color',100,14,speccolm1)
  -- cpu
  print(cpup()..'% cpu',100,20,5)
  -- mem
  print(memp()..'% mem',100,26,5)
end

function cursfx()
  local n={{},{},{},{}}
  for i=1,4 do
    local s=stat(i+15)
    local ni=stat(i+19)
    local b=peek2(0x3200 + 68*s + 2*ni)
    n[i]['sfx']=s
    n[i]['index']=ni
    n[i]['bin']=b
    n[i]['pitch']=bits(b,0,6); -- note
    n[i]['waveform']=bits(b,6,3); -- instrument
    n[i]['volume']=bits(b,9,3);
    n[i]['effect']=bits(b,12,3);
    n[i]['iscustom']=bits(b,15,1);
  end
  return n
end

function draw_csfx_table(csfx)
  local x=2
  local y=2
  local c={8,11,12,10} -- rgby
  -- header
  print(' s. i. p. w. v. e',x,y,5)
  -- table
  for i=1,#csfx do
    y=y+6
    if csfx[i]['sfx']<0 then
      print(' -. -. -. -. -. -',x,y,c[i])
    else
      local lp={'sfx','index','pitch','waveform','volume','effect'}
      local row=''
      for j=1,#lp do
        local t=tostr(csfx[i][lp[j]])
        if #t<2 then t=' '..t end
        row=row..t..'.'
      end
      row=sub(row,0,#row-1)
      print(row,x,y,c[i])
    end
  end
end

-- csfx = cursfx() output
function cursfxvel(csfx)
  local v={}
  for i=0,63 do
    v[i]=0
  end
  for i=1,#csfx do
    if csfx[i]['sfx']>-1 then
      v[csfx[i]['pitch']]=v[csfx[i]['pitch']]+csfx[i]['volume']
    end
  end
  return v
end

-- v=cursfxvel() output, y=y pos, palette=(1 [piano] or 2 [colorful]), downward=(1 [yes]), amp=multiply note height
function draw_piano(v,y,palette,downward,amp,key_height)
  key_height=key_height or 1
  key_height=key_height-1
  local vc={6,13,6,13,6,6,13,6,13,6,13,6} -- piano
  if palette==2 then
    vc={8,2,9,4,10,11,3,12,1,15,5,14} -- colorful
  end
  for i=0,63 do
    local col=vc[i%12+1]
    local y2=0
    local vamp=ceil(v[i]*amp)
    if downward==1 then
      y2=y+vamp+key_height
    else
      y2=y-vamp-key_height
    end
    rectfill(i*2,y,i*2+1,y2,col)
  end
end

-- pspec is the previous spectrum
function soundspec(csfx,pspec)
  local spec={csfx=csfx,spec={}}
  -- fill 0
  for i=0,63 do
    spec.spec[i]=0
  end
  -- set spec
  for i=1,#csfx do
    if csfx[i]['sfx']>-1 then
      local pitch=csfx[i]['pitch']
      -- default vel
      spec.spec[pitch]=spec.spec[pitch]+csfx[i]['volume']
    end
  end
  -- spike
  if pspec~=nil then
    for i=1,#csfx do
      if csfx[i]['volume']>0 then
        if csfx[i]['index']~=pspec.csfx[i]['index'] then
          if csfx[i]['effect']==5 then
            local pitch=csfx[i]['pitch']
            spec.spec[pitch]=spec.spec[pitch]+1
          end
        end
      end
    end
  end
  -- amp
  for i=0,63 do
    spec.spec[i]=spec.spec[i]*5
  end
  -- spill
  local spills={}
  for i=0,63 do
    spills[i]=0
  end
  for i=0,63 do
    local v=spec.spec[i]
    if v>0 then
      local sc=1
      while v>0 do
        v=flr(v/3)
        if spec.spec[i+sc]~=nil then spills[i+sc]=spills[i+sc]+v end
        if spec.spec[i-sc]~=nil then spills[i-sc]=spills[i-sc]+v end
        sc=sc+1
      end
    end
  end
  for i=0,63 do
    spec.spec[i]=spec.spec[i]+spills[i]
  end
  -- max
  for i=0,63 do
    if spec.spec[i]>64 then spec.spec[i]=64 end
  end
  -- reduction
  if pspec~=nil then
    for i=0,63 do
      if (pspec.spec[i]-1>spec.spec[i]) or spec.spec[i]==0 and pspec.spec[i]>1 then
        spec.spec[i]=pspec.spec[i]-2
      end
    end
  end
  -- spec32 (1-indexed)
  spec.spec32={}
  local s32=0
  for i=0,63 do
    s32=s32+spec.spec[i]
    if (i+1)%2==0 then
      add(spec.spec32,s32)
      s32=0
    end
  end
  -- spec16 (1-indexed)
  spec.spec16={}
  local s16=0
  for i=1,32 do
    s16=s16+spec.spec32[i]
    if i%2==0 then
      add(spec.spec16,s16)
      s16=0
    end
  end
  --
  return spec
end

function draw_spectrum(spec)
  local col2={8,9,10,11,12,13,14,15}
  local col3={5,6,7}
  local col4={0,5,speccolm1,6,7}
  for i=1,16 do
    local col=speccolm1
    if speccolmode==2 then
      local c=i
      if c>8 then c=c-8 end
      col=col2[c]
    end
    if speccolmode==3 then
      col=col3[1]
      if spec.spec16[i]>0 then col=col3[2] end
      if spec.spec16[i]>24 then col=col3[3] end
    end
    if speccolmode==4 then
      col=col4[1]
      if spec.spec16[i]>7 then col=col4[2] end
      if spec.spec16[i]>14 then col=col4[3] end
      if spec.spec16[i]>21 then col=col4[4] end
      if spec.spec16[i]>28 then col=col4[5] end
    end
    local y2=64-ceil(spec.spec16[i]/4)
    local x1=i*2*2+60
    local x2=i*2*2+1+60
    rectfill(x1,64,x2,y2,col)
    y3=64+ceil(spec.spec16[i]/4)
    rectfill(x1,64,x2,y3,col)
    x1=66-(i*2*2)
    x2=66-(i*2*2-1)
    rectfill(x1,64,x2,y2,col)
    rectfill(x1,64,x2,y3,col)
  end
end

function bits(b,start,len)
  local m=2^len-1
  return (b>>>start)&m;
end

function cpup()
  -- resets to 0 after 2.0 (200%)
  return ceil(stat(1)*100)
end

function memp()
  return ceil(stat(0)/2048*100)
end

function fdiff(cur,prev)
  local p=0
  if cur<prev then p=32000 end
  return cur-prev+p
end

function tdump(t)
  local out=''
  for k,v in pairs(t) do
    out=out..k..':'..v..', '
  end
  out=sub(out,0,#out-2)
  return out
end


