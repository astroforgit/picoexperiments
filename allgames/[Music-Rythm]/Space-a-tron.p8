pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- game space-a-tron
-- by author log0

-- key helper
---------------------------

keys = { btns={}, ct={} }
function keys:update()
 for i=0,13 do
  if band(btn(),shl(1,i))==shl(1,i) then
   if keys:held(i) then
    keys.btns[i]=2
    keys.ct[i]=(keys.ct[i]+1) % 30
   else
    keys.btns[i]=3
   end
  else
   if keys:held(i) then 
    keys.btns[i]=4
	  else
    keys.btns[i]=0
    keys.ct[i]=0
   end
  end
 end
end

function keys:held(b) return band(keys.btns[b],2) == 2 end
function keys:down(b) return band(keys.btns[b],1) == 1 end
function keys:up(b) return band(keys.btns[b],4) == 4 end
function keys:pulse(b,r) return (keys:held(b) and keys.ct[b]%r==0) end

-- game loop
---------------------------------------

ship = {
 x = 50, y = 100, -- position
 fh = false,      -- horizontal flip
 s = 0,           -- sprite
 g = 4            -- gun shift
 } 
shots = {}
anims = {}
t = 0

function _init()
	cls()
	music(0)
	t = 0
	stage = 0
	completion = 1
	intro_y = 150
	intro = true
	screen = screens[#screens]
	enemies = screen.enemies
	--str = enemies[#enemies].str
	current_time = 0
	score = 0
end

function gen(size)
	local s = ''
	for i=1,size do
		idx = flr(rnd(#inputs))		
		s = s..inputs[idx+1]
	end
	return s
end

function pattern1(tsh, ra)
	local tt = t / 150
	local sh = sin(tt) * 40
	local x = 60 + cos(tt+tsh)*ra + sh
	local y = 50 + sin(tt+tsh)*ra
	return x, y - intro_y
end

function pattern2(x, pshift)
	local tt = t / 150
	local y = 50 + sin(tt+pshift)*30
	return x, y - intro_y
end

function circle(pshift, cx, cy, r)
	local r = r or 20
	local cx = cx or 56
	local cy = cy or 42
	local tt = t / 150
	local x = cx + cos(tt+pshift)*r
	local y = cy + sin(tt+pshift)*r
	return x, y - intro_y
end

function update_end()
	current_time += 0.1
end

function _update60()
	if stage == 0 then
		update_menu()
	elseif stage == 1 then
		update_game()
	else
		update_end()
	end
	
	update_anims()
	keys:update()
	t += 1
end

function _draw()
	if stage == 0 then
		draw_menu()
	elseif stage == 1 then
		draw_game()
	else
		draw_end()
	end
end

function update_menu()
	if keys:down(5) then
		music(-1)
		music(5)
		stage = 1
		-- play sound for first dialog
		sfx(11)
		-- kill anims
		anims = {}
	end
	if t % 50 == 0 then
		local yd = 70
		dance = {sp={{32,25}, {34,25}},
			x=15, y=yd, w=2, h=2}
		add(anims, dance)
		dance = {sp={{34,25}, {32,25}},
			x=55, y=yd, w=2, h=2}
		add(anims, dance)
		dance = {sp={{32,25}, {34,25}},
			x=95, y=yd, w=2, h=2}
		add(anims, dance)
	end
	
	if t % 50 == 0 then
		local yd = 70
		dance = {sp={{32,25}, {34,25}},
			x=15, y=yd, w=2, h=2}
		add(anims, dance)
		dance = {sp={{34,25}, {32,25}},
			x=55, y=yd, w=2, h=2}
		add(anims, dance)
		dance = {sp={{32,25}, {34,25}},
			x=95, y=yd, w=2, h=2}
		add(anims, dance)
	end
end

function draw_menu()
	-- draw background
	--map(0, 0, 0, -16+t/2.0%16, 16, 18)
	draw_bg()
	
	-- logo
	map(16, 0, 2, 35, 16, 2)
	print('a spaceship dance competition',
		  9, 50, 7)
		  
	-- menu
	local y = 60
	rectfill(26, y-1, 116, y+5, 14)
	print('press x to start', 40, y, 7)
	
	-- tutorial
	local y = 100
	pal(12,7)
	print('left ', 5, y, 7)
	spr(glyphs['‹'], 23, y-2, 1, 1)
	
	print('   right', 43, y, 7)
	spr(glyphs['‘'], 43, y-2, 1, 1)
	
	print('   up', 33, y-12, 7)
	spr(glyphs['”'], 33, y-12, 1, 1)
	
	print('   down', 33, y+11, 7)
	spr(glyphs['ƒ'], 33, y+8, 1, 1)
	
	print('   x or v', 85, y, 7)
	spr(glyphs['—'], 85, y-2, 1, 1)
	pal()
	--inputs={'ƒ','”','‹','‘','—'}
		
	-- draw anims
	for a in all(anims) do
		spr(a.sp[#a.sp][1], a.x, a.y,
			a.w, a.h, a.hr, a.vr)
	end
end

function destroy()
	sfx(9)
	en = enemies[#enemies]
	xe, ye = en.pos()
	explosion = {sp={{96,10},
	   {98,10}, {96,10}},
	   x=xe, y=ye, w=2, h=2}
	add(anims, explosion)
	enemies[#enemies] = nil
end

function next_screen()
	screens[#screens] = nil
	if #screens != 0 then
		screen = screens[#screens]
		enemies = screen.enemies
	end
	intro_y = 100
	intro = true
	current_time = 0
	if (#screen.messages != 0) sfx(11)
	if #screens == 1 then
		music(-1)
	end
end

function quizit()
	if #enemies == 0 then
		next_screen()
		if #screens == 0 then
			-- game over
			sfx(7)
			music(-1)
			stage = 2
		end
		return
	end
	if current_time > screen.timer then
		-- when we reach timer
		if intro_y == 0 then
			intro_y = -1
			-- stop enemies from moving
			for e in all(enemies) do
				local x,y = e.pos()
				e.pos = function() return x, y - intro_y end
			end
			-- fail song
			sfx(10)
			completion = 1
		end
		-- skip quiz if timer reached
		return
	end
	
	-- quiz on last enemy
	local str = enemies[#enemies].str
	n = sub(str, completion, completion)
	local ok = (keys:down(0,4) and n == '‹') or
		(keys:down(1) and n == '‘') or
		(keys:down(2) and n == '”') or
		(keys:down(3) and n == 'ƒ') or
		(keys:down(4) and n == 'Ž') or
		(keys:down(5) and n == '—')
	if ok then
		completion += 1
		sfx(7)
		-- impressed one ship
		if completion == #str+1 then
			completion = 1
			destroy()
			add(anims, {sp={{106, 30}}, x=ship.x+5, y=ship.y, w=3, h=1})
			score += 100
		end
		-- bonus for completing wave
		if #enemies == 0 then
			add(anims, {sp={{122, 30}}, x=ship.x+5, y=ship.y, w=3, h=1})
			score += 300
			-- add bonus based on nb of remaining seconds in timer
			timer_bonus = screen.timer - current_time
			for i=1,flr(timer_bonus/60) do
				local d = rnd(5)
				add(anims, {sp={{125, 30}}, x=10+d, y=110+d, w=3, h=1})
				score += 100
			end
		end
	else
		if keys:down(0) or
		keys:down(1) or
		keys:down(2) or
		keys:down(3) or
		keys:down(4) or
		keys:down(5) then
			if completion != 1 then
				sfx(10)
				completion = 1
				score -= 100
				add(anims, {sp={{110, 30}}, x=ship.x+5, y=ship.y, w=2, h=1})
			end
		end
	end
end

function pixel_collide(x, y, e)
	local ex, ey = e.pos()
	local h = e.h or 2
	local w = e.w or 2
	if ey <= y and y <= ey + h*8 and
	   ex <= x and x <= ex + w*8 then
		-- coordinates inside the sprite
		local xsp = x - ex
		local ysp = y - ey
		-- coordinate on the sprite sheet
		local sx = e.sprite * 8 % 128  + xsp
		local sy = flr(e.sprite / 16) * 8 + ysp
		v = sget(sx, sy)
		if (v != 0) return true
	end
	return false
end

function move_shots()
	for s in all(shots) do
		s.y -= 3
		-- out of screen
		if s.y < 0 then
			del(shots, s)
		end
		-- hit enemy
		for e in all(enemies) do
			local x, y = e.pos()
			if pixel_collide(s.x, s.y, e) then
				explosion = {sp={{16,10}},
				  x=s.x-2, y=s.y-2, w=1, h=1}
				add(anims, explosion)
				del(shots, s)
				score -= 1
			end
		end
	end
end

function update_anims()
	for a in all(anims) do
		a.sp[#a.sp][2] -= 1
		if a.sp[#a.sp][2] == 0 then
			a.sp[#a.sp] = nil
			if #a.sp == 0 then
				del(anims, a)
			end
		end
	end
end

function move_ship()
	ship.s = 0
	if keys:held(0) then
		if (ship.x > 2) then
			ship.x -= 2
		end
		ship.s = 2
		ship.fh = true
	end
	if keys:held(1) then
		if (ship.x < 108) then
			ship.x += 2
		end
		ship.s = 2
		ship.fh = false
	end
end

function update_game()
	move_ship()
	move_shots()

	if #screen.messages != 0 then
		if keys:down(5) then
			screen.messages[#screen.messages] = nil
			if (#screen.messages != 0) sfx(11)
		end
		return
	end

	current_time += 1
	
	if keys:pulse(2,5) then 
		shoot()
	end
	
	if intro_y < -160 then
		enemies = {}
	end
	
	quizit()
end

function shoot()
	sfx(0)
	if (ship.g == 4) then ship.g = -5
	else ship.g = 4 end
	add(shots, {x=ship.x+ship.g, y=100})
	score += 1
end

function draw_transition()
    -- display dialog box
	map(16, 2, 12, 40, 16, 4)
	spr(screen.perso, 20, 48, 2, 2)
	print(screen.perso_name..":", 39, 48, 14)
	print(screen.messages[#screen.messages], 39, 57, 1)
	if screen.name == "intro" and #screen.messages == 1 then
		spr(141, 20, 48, 2, 2)
		if flr(t/10) % 2 == 0 then
			spr(171, 20, 48, 2, 2)
			print(screen.messages[#screen.messages], 39, 57, 12)
		end
	end
	if screen.name == "end" and #screen.messages == 1 then
		if flr(t/10) % 2 == 0 then
			spr(169, 20, 48, 2, 2)
			print(screen.messages[#screen.messages], 39, 57, 12)
		end
	end
end

function draw_string(s, xs, ys)
	local x = xs
	for i=1,#s do
		c = sub(s, i, i)
		local sprite = glyphs[c]
		spr(sprite, x, ys, 1, 1)
		x += 9
	end
end

function draw_quiz(e)
	local str = "too late"
	local w = 28
	if current_time <= screen.timer then
		str = e.str
		w = #str*7 + (#str*2-2) - 1
	end
	
	local x, y = e.pos()
	local h = 6
	local x = x - w / 2 + 8 
	local y = y - 10

	rectfill(x, y-h, x+w, y+h, 7)
	circfill(x, y, h, 7)
	circfill(x+w-1, y, h, 7)

	-- draw mini timer
	local ratio = current_time / screen.timer
	w = w+4
	local tw = w - flr(ratio * w)
	if tw > 0 then
		rectfill(x-2, y+h-1, x-2+tw, y+h, 12)
	end

	-- draw string
	if str == "too late" then
		print(str, x-2, y-2, 14)
	else
		pal(7,14)
		draw_string(str, x-1, y-4)
		pal(7,12)
		draw_string(sub(str,1, completion-1), x-1, y-4)
		pal()
	end
	--print(sub(str,1, completion-1), x-2, y-2, 12)
end

function draw_scene()
	if intro_y != 0 then
		intro_y -= 2
	end

	-- draw anims
	for a in all(anims) do
		spr(a.sp[#a.sp][1], a.x, a.y,
			a.w, a.h, a.hr, a.vr)
	end
	
	-- draw bad guys
	-- hack to no shift the mother ship
	local sh = ship.s
	if #screens == 2 or #screens == 3 or #screens == 4 then
		sh = 0
	end
	for e in all(enemies) do
		x, y = e.pos()
		local w, h, vr = 2, 2, true
		if (e.w != nil) w = e.w
		if (e.h != nil) h = e.h
		if (e.vr != nil) vr = e.vr
		spr(e.sprite+sh, x, y, w, h, false, vr)
	end

	if #screen.messages != 0 then
		draw_transition()
		return
	end
	
	-- draw quiz on top of next enemy
	e = enemies[#enemies]
	if (e) draw_quiz(e)
end

function draw_ship()
	s1 = sin(t/100*2+0.3)*2
	spr(32+ship.s, ship.x+s1, 100-s1, 2, 2, ship.fh)
end

function draw_timer()
	local ratio = current_time / screen.timer
	local w = 5
	if ratio > 0.7 then 
		color = 8
	elseif ratio > 0.5 then
		color = 9
	else
		color = 12
	end
	rectfill(0, 0, w, 128, 13)
	rectfill(0, ratio*128, w, 128, color)
	rectfill(128-w, 0, 128, 128, 13)
	rectfill(128-w, ratio*128, 128, 128, color)
end

function draw_bg()
	for i=0,17 do
		map(0, 0, 0, i*16-16+t/2.0%16, 16, 2)
	end
end

function draw_game()
	cls()

	-- draw background
	draw_bg()
	
	rectfill(0, 119, 128, 125, 7)
	print("score:"..score, 5, 120, 14)

	draw_ship()
	
	-- draw shots
	for s in all(shots) do
		spr(0, s.x+8, s.y)
	end

	draw_scene()
end

function draw_end()
	cls()
	
	-- high score
	map(0, 2, 0, 0, 16, 2)
	print("highscore:"..score, 30, 6, 14)
	
	h = 8
	i = 0
	for l in all(end_credits) do
		y = 16+h*i - current_time
		if y > 17 and y < 128 then
			print(l, 0, y, 14)
		end
		i += 1
	end
end

