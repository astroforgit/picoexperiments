pico-8 cartridge // http://www.pico-8.com
version 5
__lua__
--the opera of erich zann
--2016 simon hutchinson


scrn = {}

player = {} -- set up the player

melody_length = 6

melody = {4,5,0,1,2,3}

melod = true

wait_time = 5 -- number of frames between notes
waiting = 0 -- countdown between notes


function _init()
 player.sprite = 48
 t = 0
 score = 0
 melod_note = 1
 chaos_progress = 0
 start = true
 scrn.upd = start_update
 scrn.drw = start_draw
 cls()
end

function _update()
 scrn.upd()
end

function _draw()
 scrn.drw()
end

--start "menu"
function start_update()
 t += 1
 if (waiting <= 0) then
  player.moving = false -- reset the state
  if btnp(0) then --left
   sfx(1,3)
   if (melody[melod_note] == 0) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(1) then --right
   sfx(2,3)
   if (melody[melod_note] == 1) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(2) then --up
   sfx(3,3)
   if (melody[melod_note] == 2) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(3) then --down
   sfx(4,3)
   if (melody[melod_note] == 3) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(4) then --z
   sfx(5,3)
   if (melody[melod_note] == 4) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(5) then --x
   sfx(6,3)
   if (melody[melod_note] == 5) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
 end
 if not player.moving then -- update the sprite if not moving
  player.sprite = 48
 end
 
 if (waiting > 0) then
  waiting -= 1
 end
end

function start_draw()
 rectfill(0,0,127,127,0) 
 spr(player.sprite,60,60)
 if (t > 25) then
 	print("the opera of erich zann",16,8,8)
 end
 if (t > 50) then
  print("a game by simon hutchinson",10,16,7)
 end
 if (t > 75) then
  print("inspired by the short story",8,28,2) 
  print("the music of erich zann" ,16,36,2)
  print("by h.p.lovecraft",30,44,2)
 end
 if (t > 100) then
  show_melody()
 end
end


function run_backstory()
 cls()
 t = 0
 scrn.upd = update_back
 scrn.drw = draw_back
end

function draw_back()
 if (t == 46) then
  music(0,1)
 end
	if (t > 45) then
	 print("erich zann...",8,23,7)
	end
 spr(58,90,110)
 print("to skip",100,111,7)
 if t > 90 then
  print("a musician cursed with the",8,39,7)
  print("power to hold back the chaos",8,47,7)
  print("of the void with his voice",8,55,7)
 end
 if t > 180 then
  print("each night he must sing these",8,71,7)
  print("otherworldy melodies or all",8,79,7)
  print("will be lost...",8,87,7)
 end
end

function update_back()
 t += 1
 if (btnp(4)) then
  sfx(5,3)
  run_game()
 end
end


function run_game()

 score = 0
 overtime = 0
 
 player.x = 61
 player.y = 88

	t = 0 -- time

 --the void
 chaos_progress = -150
 
 chaos = {} -- martix for chaos sprites
 for i=1,17 do -- initialize matrix
  chaos[i] = {}
  for j=1,16 do
   chaos[i][j] = (rnd(3)+96)
  end
 end
 for j=1,16 do
  chaos[17][j] = (rnd(3)+80) --edge of chaos
 end

 rain_rate = 3 -- 30/this = rain times per second
 rain_counter = 0

 --array for outdoor sprites
 rain = {} --empty array for rain sprites
 for i=1,6 do -- initialize matrix
  rain[i] = {}
  for j=1,16 do
   rain[i][j] = rnd(5)
  end
 end

 --arrays for windows
 windowa = {} -- left window
 windowb = {} -- right window
 for i = 1,2 do--initialize both rain matrices
  windowa[i] = {}
  windowb[i] = {}
  for j=1,2 do
   windowa[i][j] = (rnd(4)+9)
   windowb[i][j] = (rnd(4)+9)
  end
 end

 --setting up the target melody

 melod_note = 1
 melody_length = 3
 make_melody()
 
 scrn.upd = update_game
 scrn.drw = draw_game
end

function draw_game()
 cls()
 map(0,0,0,0,128,128)

	spr(player.sprite,player.x,player.y)

 -- draw rain on screen left 
 for i=0,4 do 
  for j=0,15 do
   spr(rain[i+1][j+1],i*8,j*8)
  end
 end
 -- draw rain in windows
 for i = 0,1 do
  for j=0,1 do
   spr(windowa[i+1][j+1],(i*8)+64,(j*8)+64)
   spr(windowb[i+1][j+1],(i*8)+104,(j*8)+64)
  end
 end
 
 show_melody()
 
 print("score",85,9,7)
 print(score,108,9,7)
 
 -- draw the void
 for i=0,16 do
  for j=0,15 do
   spr(chaos[i+1][j+1],(i*8+chaos_progress),(j*8))
  end
 end 
 
end

function update_game()
	t += 1

	pulse = 20
	if chaos_progress > -110 then
	 pulse = 16
	end
	if chaos_progress > -90 then
	 pulse = 12
	end
	if chaos_progress > -70 then
	 pulse = 8
	end
	if chaos_progress > -64 then
	 pulse = 1000
	 t=0
	end
	
	if t >= pulse then
  sfx(10,2)
	 t = 0
	end

 if melod == false then
  make_melody()
 end

 if (chaos_progress < -64) then -- if alive
  if (waiting <= 0) then
   player.moving = false -- reset the state
   if btnp(0) then --left
    sfx(1,3)
    if (melody[melod_note] == 0) then
     melod_move()
    else
     melod_reset()
    end
    sing()
   end
   if btnp(1) then --right
    sfx(2,3)
    if (melody[melod_note] == 1) then
     melod_move()
    else
     melod_reset()
    end
    sing()
   end
   if btnp(2) then --up
    sfx(3,3)
    if (melody[melod_note] == 2) then
     melod_move()
    else
     melod_reset()
    end
    sing()
   end
   if btnp(3) then --down
    sfx(4,3)
    if (melody[melod_note] == 3) then
     melod_move()
    else
     melod_reset()
    end
    sing()
   end
   if btnp(4) then --z
    sfx(5,3)
    if (melody[melod_note] == 4) then
     melod_move()
    else
     melod_reset()
    end
    sing()
   end
   if btnp(5) then --x
    sfx(6,3)
    if (melody[melod_note] == 5) then
     melod_move()
    else
     melod_reset()
    end
    sing()
   end
  end
 end

 if not player.moving then -- update the sprite if not moving
  player.sprite = 48
 end
 
 if (waiting > 0) then
  waiting -= 1
 end

	if (rain_counter >= rain_rate) then
	 rain_counter = 0
	 rain_update()
	 chaos_update()
 else
  rain_counter += 1
 end
end

function game_over()
 player.sprite = 51
 t= 0
 melod_note = 1
 melody_length = 6
 melody = {4,5,0,1,2,3}
 start = true
 melod = true
 scrn.upd = over_update
 scrn.drw = over_draw
end

function over_update()
 t += 1
 if (waiting <= 0) then
  player.moving = false -- reset the state
  if btnp(0) then --left
   sfx(1,3)
   if (melody[melod_note] == 0) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(1) then --right
   sfx(2,3)
   if (melody[melod_note] == 1) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(2) then --up
   sfx(3,3)
   if (melody[melod_note] == 2) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(3) then --down
   sfx(4,3)
   if (melody[melod_note] == 3) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(4) then --z
   sfx(5,3)
   if (melody[melod_note] == 4) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
  if btnp(5) then --x
   sfx(6,3)
   if (melody[melod_note] == 5) then
    melod_move()
   else
    melod_reset()
   end
   sing()
  end
 end
 
 if waiting > 0 then
  waiting -= 1
 end

end

function over_draw()
 cls()
 
 if t > 35 and t < 45 then
  if (t == 36) then
   sfx(11)
  end
  map(0,0,0,0,128,128)

	 spr(player.sprite,player.x,player.y)

	 spr(39,54,96)
	 spr(40,62,96)
	 spr(41,70,96)
	
	 spr(42,69,86)
	 
	 for i=0,4 do -- update left
   for j=0,15 do
    spr(16,i*8,j*8)
   end
  end
  
  for i = 0,1 do -- update windows
   for j=0,1 do
    spr(25,(i*8)+64,(j*8)+64)
    spr(25,(i*8)+104,(j*8)+64)
   end
  end
	end
	
 if t > 55 and t < 80 then
  map(0,0,0,0,128,128)
  if (t == 56) then
   sfx(12)
  end

	 spr(player.sprite,player.x,player.y)

	 spr(39,54,96)
	 spr(40,62,96)
	 spr(41,70,96)
	
	 spr(42,69,86)
	 
	 for i=0,4 do -- update left
   for j=0,15 do
    spr(16,i*8,j*8)
   end
  end
  
  for i = 0,1 do -- update windows
   for j=0,1 do
    spr(25,(i*8)+64,(j*8)+64)
    spr(25,(i*8)+104,(j*8)+64)
   end
  end
	end

	if t > 115 then
	 if t == 131 then
	  music(0,1)
	 end
	 print("total score:",40,58,7)
	 print(score,58,64,7)
	 show_melody()
	end

end


function rain_update()
	sfx(7,0) -- rain sound
 for i=1,6 do -- update left
  for j=1,16 do
   rain[i][j] = rnd(5)
  end
 end

 for i = 1,2 do -- update windows
  for j=1,2 do
   windowa[i][j] = (rnd(4)+9)
   windowb[i][j] = (rnd(4)+9)
  end
 end

 if (rnd(100) > 98) do -- lightning
  sfx(0,1)
  for i=1,6 do -- update left
   for j=1,16 do
    rain[i][j] = 16
   end
  end
  
  for i = 1,2 do -- update windows
   for j=1,2 do
    windowa[i][j] = 25
    windowb[i][j] = 25
   end
  end
 end
end 

function chaos_update()
 if chaos_progress < 0 then
  chaos_progress += 1
 else
  overtime += 1
  if overtime > 20 then
   game_over()
  end
 end
 
 for i=1,16 do -- update left
  for j=1,16 do
   chaos[i][j] = (rnd(3)+96)
  end
 end
 for j=1,16 do
 	chaos[17][j] = (rnd(3)+80)
 end
end

function sing()
  player.moving = true
  player.sprite = 49
  waiting = wait_time
end

function make_melody()
 for i=1,melody_length do
  melody[i] = flr(rnd(6))
 end
 melod = true
end

function show_melody()
  melody_start = (56-(melody_length*4))
 for i=1,melody_length do
  spr(melody[i]+54,(melody_start+i*8),108)
 end
end

function melod_move()
 melody[melod_note] += 64
 melod_note += 1
 if start == false then
  score += 10
 end
 if melod_note > melody_length then
  sfx(8,0)
  if start == true then
   music(-1,1)
   start = false
   run_backstory()
  else
   score += 500
   chaos_progress -= 15
   if (score > 5000) then
    chaos_progress -= 5
   end
   if (score > 10000) then
    chaos_progress -= 10
   end
   if chaos_progress < -150 then
    chaos_progress = -150
   end
   melod_note = 1
   melod = false 
   if score > 5000 then
    if score > 10000 then
     melody_length = 5
     rain_rate = 1
    else
     melody_length = 4
     rain_rate = 2
    end
   end
  end
 end
end

function melod_reset()
 if start == false then
  sfx(9,2)
 end
 chaos_progress += 2
 while melod_note > 1 do
  melod_note -= 1
  melody[melod_note] -= 64
 end
end
  
