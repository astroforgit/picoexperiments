pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--stack-o-presents
--tom brinton
--for pico8 christmas project

--todo:
--x score
--x presents move horizontally? 
--  like stack game
--x move faster with time?
--x snow
--x dust particle system
--x present zoom in when "die"
--x better background
--x doom flakes!

--weird glitch with new presents
--high score
cartdata("stackopresents")
hiscore=dget(1)

--touch support
poke(0x5f2d, 1)
down=true
touch=false

presents={}

snow={}

dust={}

flk={}

shake=0


function _init()
 logo()
 reset()
end

function _update60()
 timer+=1
 if shake>0 then shake-=1 end
 if timer>19 then timer=0 end
 if stacky-camdist<camy then
  camy-=1
 end
 if #snow<50 then
    createsnow()
 end
 touch=false
 if stat(34)!=0 and not down then
  touch=true
  down=true
 end
 if stat(34)==0 then
  down=false
 end
 gamespeed=(2+stacked/12)/2
 foreach(presents,updatepresent)
 if newpres then
  createpresent()
  newpres=false
 end
 updateflake()
 
end



function _draw()
 if shake>0 then
  camera(-2+rnd(4),camy+(-2+rnd(4)))
 else
  camera(0,camy)
 end
 cls()
 drawback()
 rectfill(0,0,127,127,7)
 line(0,0,127,0,4)
 line(0,1,127,1,13)
 line(0,2,127,2,6)
 spr(128,0,-32,16,4)
 foreach(dust,drawdust)
 drawflake()
 foreach(presents,drawpresent)
 foreach(snow,drawsnow)
 candynum(stacked,4,4)
 print("† stack-o-presents †",20,16,8)
 print("  press [z] to stack  ",20,24,3)
 print(" avoid the saw-flakes ",20,32,13)
 if hiscore>0 then
 print("     hi-score: "..hiscore,20,40,9)
  end
 --print(stat(0),1,camy)
end

function reset()
 pal()
 clear(presents)
 clear(flakes)
 stacky=0
 stackx=64
 stackt=0
 stackdir=true
 camdist=72
 camy=stacky
 
 timer=0
 gamespeed=2
 stacked=0
 
 createflake()
 createpresent()
 music(0)
end

function clear(a)
 for aa in all(a) do
  del(a,aa)
 end
end
-->8
--presents
function createpresent()
 local p={}
 p.control=true
 p.width=ceil(rnd(24))+8
 p.height=ceil(rnd(24))+8
 p.col1=ceil(rnd(15))
 ::again::
 p.col2=ceil(rnd(15))
 if p.col2==p.col1 then goto again end
 p.x=stackx-(p.width/2)
 p.y=stacky-p.height
 p.speed=gamespeed
 p.left=stackdir
 p.t=stackt
 add(presents,p)
end

function updatepresent(p)
 if p.control then
  if btnp(Ž) or touch then
   if not landed(p) then
    music(6)
    pause(15)
    for i=1,64 do
     p.x-=2
     p.y-=2
     p.width+=4
     p.height+=4
     drawpresent(p)
     flip()
    end
    circfill(64,camy+68,37,4)
    circfill(64,camy+68,36,9)
    circfill(64,camy+68,35,10)
    circfill(64,camy+68,34,9)
    circfill(64,camy+68,33,4)
    circfill(64,camy+68,32,0)
    print("you stacked",43,camy+56,6)
    if stacked<10 then
     candynum(stacked,60,64)
    elseif stacked>9 and stacked<100 then
     candynum(stacked,56,64)
    else
     candynum(stacked,52,64)
    end
    print("presents",49,camy+75,6)
    if stacked>hiscore then
     hiscore=stacked
     dset(1,hiscore)
     print("new hi-score!",40,camy+82,10)
    end
    pause(90)
    reset()
   else
    sfx(0)
    for i=1,30 do
     createdust(p.x+p.width/2,p.y+p.height/2)
    end
    shake=15
    stacky=p.y
    stackx=p.x
    stackt=p.t
    stackdir=p.left
    stacked+=1
    p.control=false
    newpres=true
    return
   end
  end
  p.t+=.02
  p.x=(64-p.width/2)+(cos(t()*gamespeed/3)*50)
  --if p.left then
  -- p.x-=p.speed
  -- if p.x<9 then p.left=false end
  --else
  -- p.x+=p.speed
  -- if p.x>120-p.width then p.left=true end
  --end
 end
end

function drawpresent(p)
 blink=false
 bgc=0
 if p.control and timer<10 then
  blink=true
  --temp1=p.col1
  --temp2=p.col2
  --p.col1=temp2
  --p.col2=temp1
  bgc=7
 end

 bow=p.width/12
 bx=p.x+(p.width/2)
 by=p.y+(p.height/2)
 
 rectfill(p.x+1,p.y-1,p.x+p.width-1,p.y+p.height+1,bgc)
 rectfill(p.x-1,p.y+1,p.x+p.width+1,p.y+p.height-1,bgc)
 circfill(bx-bow,p.y-bow,bow+1,bgc)
 circfill(bx+bow,p.y-bow,bow+1,bgc)

 rectfill(p.x,p.y,p.x+p.width,p.y+p.height,p.col1)

 circ(bx-bow,p.y-bow,bow,p.col2)
 circ(bx+bow,p.y-bow,bow,p.col2)
 rectfill(bx-bow,p.y,bx+bow,p.y+p.height,p.col2)
 
 rectfill(p.x,by-bow,p.x+p.width,by+bow,p.col2)
 pset(p.x,p.y,bgc) 
 pset(p.x,p.y+p.height,bgc) 
 pset(p.x+p.width,p.y,bgc) 
 pset(p.x+p.width,p.y+p.height,bgc) 
 
 if blink then
 -- p.col1=temp1
 -- p.col2=temp2
 end
 
end

function landed(p1)
 if #presents == 1 then return true end
 p2=presents[#presents-1]
 p1l=p1.x-1
 p1r=p1.x+p1.width+1
 p2l=p2.x-1
 p2r=p2.x+p2.width+1
 --check for snowflake first
 if (p1.y >flk.y and p1.y<flk.y+32) or (p1.y+p1.height >flk.y and p1.y+p1.height<flk.y+32) then
  if p1l<flk.x+32 and p1l>flk.x then
   return false
  end
  if p1r<flk.x+32 and p1r>flk.x then
   return false
  end
 end
 --now check if stacked
 if (p1l >= p2l and p1l <= p2r) or (p1r >=p2l and p1r<=p2r) then
  return true
 end
 if p1l<=p2l and p1r>=p2r then
  return true
 end
 
 return false
end

function pause(p)
 for i=1,p do
  flip()
 end
end
-->8
--snow
function createsnow()
 local s={}
 s.bx=flr(rnd(127))
 s.x=s.bx
 s.y=0
 s.ys=(.5+rnd(2))/2
 s.col=5+ceil(rnd(2))
 s.c=rnd()
 add(snow,s)
end

function drawsnow(s)
 s.x=s.bx+4*cos((s.y+s.c)/31)
 s.y+=s.ys
 if s.y>127 then 
  del(snow,s)
  createsnow()
 end
 pset(s.x,camy+s.y,s.col)
end
-->8
--candy canes
function candynum(n,x,y)
 sn=""..n
 len=#sn
 for i=1,len do
  ssn=sub(sn,i,i)
  nn=ssn+1
  pal(7,0)
  pal(8,0)
  spr(nn,x+((i-1)*8-1),camy+y-1)
  spr(nn,x+((i-1)*8-1),camy+y+1)
  spr(nn,x+((i-1)*8+1),camy+y-1)
  spr(nn,x+((i-1)*8+1),camy+y+1)
  spr(nn,x+((i-1)*8-1),camy+y)
  spr(nn,x+((i-1)*8+1),camy+y)
  pal()
  spr(nn,x+((i-1)*8),camy+y)
 end
end
-->8
--dust
function createdust(dx,dy)
local d={}
d.x=dx
d.y=dy
d.size=rnd(4)
d.col=9+flr(rnd(2))
d.xs=-3+rnd(6)
d.ys=-3+rnd(6)
add(dust,d)
end

function drawdust(d)
circfill(d.x,d.y,d.size,d.col)
d.x+=d.xs
d.y+=d.ys
d.xs*=.95
d.ys*=.95
d.size-=.1
if(d.size<1)del(dust,d)
end
-->8
--background
function drawback()
brect(0,13)
fillp(0x401)
brect(-64,45)
fillp(0xa5a5)
brect(-128,45)
fillp(0x401)
brect(-128-64,210)
fillp()
brect(-256,2)
fillp(0x401)
brect(-256-64,18)
fillp(0xa5a5)
brect(-256-128,18)
fillp(0x401)
brect(-256-128-64,33)
fillp()
brect(-512,1)
fillp(0x401)
brect(-512-64,1)
fillp(0xa5a5)
brect(-512-128,1)
fillp(0x401)
brect(-512-128-64,16)
fillp()
end



function brect(ry,rc)
rectfill (0,ry,127,ry-64,rc)
end
-->8
--snowflakes
function createflake()
 flk.x=flr(rnd(3))
 flk.x*=64
 flk.x-=16
 flk.y=-80
 flk.a=0
end

function updateflake()
 if abs(flk.y-camy)>128 then
  flk.x=flr(rnd(3))
 	flk.x*=64
 	flk.x-=16
 	flk.y=camy-32
 end
end

function drawflake()
 flk.a+=.005
 rspr(88,0,0,32,flk.a,4)
 spr(64,flk.x,flk.y,4,4)
end


function rspr(sx,sy,x,y,a,w)
 local rspr_clear_col=0
	local ca,sa=cos(a),sin(a)
	local srcx,srcy,addr,pixel_pair
	local ddx0,ddy0=ca,sa
	local mask=shl(0xfff8,(w-1))
	w*=4
	ca*=w-0.5
	sa*=w-0.5
	local dx0,dy0=sa-ca+w,-ca-sa+w
	w=2*w-1
	for ix=0,w do
		srcx,srcy=dx0,dy0
		for iy=0,w do
			if band(bor(srcx,srcy),mask)==0 then
				local c=sget(sx+srcx,sy+srcy)
				sset(x+ix,y+iy,c)
			else
				sset(x+ix,y+iy,rspr_clear_col)
			end
			srcx-=ddy0
			srcy+=ddx0
		end
		dx0+=ddx0
		dy0+=ddy0
	end
end
-->8
--advent logo
function logo()
daynumber="16"
::_::
if (btnp()>0) goto donewithintro
cls()
f=4-abs(t()-4)
for z=-3,3 do
 for x=-1,1 do
  for y=-1,1 do
   b=mid(f-rnd(.5),0,1)
   b=3*b*b-2*b*b*b
   a=atan2(x,y)-.25
   c=8+(a*8)%8
   if (x==0 and y==0) c=7
   u=64.5+(x*13)+z
   v=64.5+(y*13)+z
   w=8.5*b-abs(x)*5
   h=8.5*b-abs(y)*5
   if (w>.5) rectfill(u-w,v-h,u+w,v+h,c) rect(u-w,v-h,u+w,v+h,c-1)
  end
 end
end

if rnd()<f-.5 then
 ?daynumber,69-#daynumber*2,65,2
end
 
if f>=1 then
 for j=0,1 do
  for i=1,f*50-50 do
   x=cos(i/50)
   y=sin(i/25)-abs(x)*(.5+sin(t()))
   circfill(65+x*8,48+y*3-j,1,2+j*6)
  end
 end
  
 for i=1,20 do
  ?sub("pico-8 advent calendar",i),17+i*4,90,mid(-1-i/20+f,0,1)*7
 end
end
 
if (t()==8) goto donewithintro

flip()
goto _
::donewithintro::

end
