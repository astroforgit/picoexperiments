function _init()

 anims={}
 particles={}
 level=1
 
 cartdata("solo_on_gamepad")
 hiscores0=dget(0)
 hiscores1=dget(1)
 controller=dget(2)
 if controller==nil then
  controller=0
 end
 
 wrlda=0
 stars={}
 for i=1,100 do
  add(stars,{a=rnd(1),r=64+rnd(192)})
 end
 
 frwrks={}

	startmenu()
 
end

function startmenu()

 anims={}

	mode="start"
	newanim(0,0,-48,128)
	timer=-16
	padx=0
 
end

function credits()

 anims={}
 
 mode="credits"
 timer=-16
 
end

function getready()
 
 anims={}
 
 mode="get ready"
 timer=-16
 
end

function startgame()

 anims={}
 
	mode="game"
	timer=0

 scores0=0
 scores1=0
 lives=5
 level=1
 gunlevel=1
 clearbtns=0

 btns={}
 if controller==2 then
	 add(btns, {n=‹,i=10,x=9,y=14,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=‘,i=11,x=11,y=14,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=”,i=12,x=10,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=ƒ,i=13,x=10,y=14,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=Ž,i=8,x=3,y=14,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=—,i=9,x=4,y=14,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	elseif controller==1 then
	 add(btns, {n=‹,i=10,x=3,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=‘,i=11,x=5,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=”,i=12,x=4,y=12,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=ƒ,i=13,x=4,y=14,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=—,i=14,x=9,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=Ž,i=15,x=11,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	else 
	 add(btns, {n=‹,i=10,x=3,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=‘,i=11,x=5,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=”,i=12,x=4,y=12,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=ƒ,i=13,x=4,y=14,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=—,i=14,x=11,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	 add(btns, {n=Ž,i=15,x=9,y=13,prssd=0,bbls=0,hits=0,lsses=0,shots=0})
	end
 
 enms={}
 bnss={}
 bllts={}
 lvlup()
 
 if hiscores0==0 and hiscores1==1 then
  blinkscores=-2
 else
  blinkscores=0
 end
 
end

function gameover()

	mode="game over"
	timer=-32
	
	if (scores1>hiscores1)
	 or (scores1==hiscores1 and scores0>hiscores0) then
	 hiscores0=scores0
	 hiscores1=scores1
	end
	dset(0,hiscores0)
	dset(1,hiscores1)
 
end

function _update60()

 for s in all(stars) do
  s.r=s.r+1
  if s.r>255 then
   s.r=64
  end
 end

	for b in all(bllts) do
	 b.y=b.y-b.s
	 if b.y<-8 then
	  del(bllts,b)
	 end
	end

 if mode=="start" then
 
	 timer=timer+1
	 if timer>=600 then
	  credits()
	 end
	 
  if padx<0 then
   padx=padx+16
  elseif padx>0 then
   padx=padx-16
  end
  
	 if timer>=0 then
	 
	  if btn(—) or btn(Ž) then
	   getready()
	   sfx(9)
	  end
	  
		 if btn(‘) then
		  timer=-16
		  padx=-112
		  controller=controller+1
		  if controller>2 then
		   controller=0
		  end
   	dset(2,controller)
		 end
		 
		 if btn(‹) then
		  timer=-16
		  padx=112
		  controller=controller-1
		  if controller<0 then
		   controller=2
		  end
   	dset(2,controller)
		 end
		 
	 end
	 
	 
 elseif mode=="credits" then
  
  timer=timer+0.5
	 if timer>=0 then
	  if btn()>0 then
	   startmenu()
	  end
	 end
		
		--if timer%32==0 then
		-- firework(rnd(128))
		--end
  
	 if timer>=600 then
	  startmenu()
	 end
  
 elseif mode=="get ready" then
 
	 timer=timer+1
	 if timer>=64 then
	  startgame()
	  music(0)
	 end
	 
 elseif mode=="game" then
 
  gameupdate()
  
 elseif mode=="game over" then
 
	 timer=timer+1
	 if timer>=128 then
	  timer=0
	 end
	 if timer>=0 then
	  if btn()>0 then
	   startmenu()
	  end
	 end
	 
 end

 -- animations 
	for a in all(anims) do
	
	 if a.i==0 then
	  if a.t<64 then
 	  a.y=a.t-56
 	 else
 	  a.t=64
 	 end
	 elseif a.i==1 then
	  if a.t<32 then
		  a.x=a.x+1
		 	a.y=a.y+1
		 end
	 elseif a.i==2 then
	  if a.t<32 then
		  a.x=a.x-1
		 	a.y=a.y+1
		 end
	 elseif a.i==3 then
	  if a.t<32 then
		  a.x=a.x+1
		 	a.y=a.y-1
		 end
	 elseif a.i==4 then
	  if a.t<32 then
		  a.x=a.x-1
		 	a.y=a.y-1
		 end
	 elseif a.i==84 then
	 	a.y=a.y+0.2
	 elseif a.i==96 then
	 	a.y=a.y+0.2
	 elseif a.i==100 then
	 	a.x=a.x+0.2
	 	a.y=a.y-0.2
	 elseif a.i==112 then
	 	a.x=a.x+0.2
	 	a.y=a.y-0.2
	 elseif a.i==116 then
	 	a.y=a.y-0.5
	 end
	 
	 a.t=a.t+1
	 if a.t>=(4*a.s) then
	  del(anims,a)
	 end
	 
	end
	
	-- fireworks
	for f in all(frwrks) do
	 if f.t<=0 then
	  firework(f.x)
	  del(frwrks,f)
	 else
	  f.t=f.t-1
	 end
	end
	
	-- particles
	for p in all(particles) do
	 p.x=p.x+p.sx
	 p.y=p.y+p.sy
	 p.sy=p.sy+1/4
	 if p.sy>0 and p.y>128 then
	  del(particles,p)
	 end
	end
	
end

function gameupdate()
 
	for b in all(btns) do
	 if btn(b.n) then
	  b.prssd=1
	  b.shots=b.shots+newbllt(b.n,b.x*8+4,128)
	 else
	  b.prssd=0
	 end
	end
	
	for e in all(enms) do
	
	 e.y=e.y+e.s
	 
		for b in all(btns) do
		 if b.n==e.n then
		  bt=b
		 end
		end
		
		
		for b in all(bllts) do
	  if (b.n==e.n) and (b.y<=(e.y+4)) then
	   --bubble burst
	   newanim(100,e.x,e.y,5)
	   del(enms,e)
	   add(enms,newenmy())
	   sfx(2)
	   bt.hits=bt.hits+1
	   
	   --scores
	   scores0=scores0+1
	   if scores0>=10000 then
	    scores1=scores1+1
	    scores0=scores0-10000
	   end
	   if blinkscores==0 then
	    if (scores1>hiscores1)
	     or (scores1==hiscores1 and scores0>hiscores0) then
 	    blinkscores=32
	     sfx(0)
	    end
	   end
	   
	   clearbtns=clearbtns+1
 	  lvlup()
 	  
	  end
	 end
	 
	 if e.y>=128 then
	  --bubble hit bottom
	  newanim(116,e.x-4,120,20)
   b.lsses=b.lsses+1
	  del(enms,e)
	  add(enms,newenmy())
   newanim(96,min(120,lives*8-4),4,5)
   sfx(4)
	  lives=lives-1
	  clearbtns=0
	  if lives<0 then
	   music(-1)
	   sfx(8)
	   gameover()
	  end
	 end
	end
	
	for bon in all(bnss) do
	 bon.o=bon.o+1
	 if bon.o>31 then
	 	bon.o=0
	 end
	 bon.x=bon.x-0.5
	 if bon.x<-8 then
   del(bnss,bon)
  else
   x=bon.x
   y=bon.y+16*cos(bon.o/32)
			for b in all(bllts) do
		  if (x-6)<(b.x+6)
		   and (x+6)>(b.x+2)
		   and (y-6)<(b.y+6)
		   and (y+6)>(b.y+2) then
		   --take bonus
		   gunlevel=gunlevel+1
		   newanim(112,x,y,5)
		   sfx(5)
		   del(bnss,bon)
		  end
	  end
	 end
	end
	
end

function _draw()

 cls()
 
 --stars
 x=64+128*cos(1-wrlda)
 y=64+128*sin(1-wrlda)
 c=starcolors[1+(level-1)%8]
 for s in all(stars) do
  if s.r>128 then
   pset(x+s.r*cos(s.a+wrlda),y+s.r*sin(s.a+wrlda),c[2])
  else
   pset(x+s.r*cos(s.a+wrlda),y+s.r*sin(s.a+wrlda),c[1])
  end
 end
 wrlda=wrlda-0.001-0.000125*sqrt(sqrt(scores0))
 if wrlda<0 then
  wrlda=1
 end
 
 if mode=="start" then
 
  drawpad(controller,16+padx,80,false)
  if padx<0 then
   drawpad((controller-1)%3,16+128+padx,80,false)
  elseif padx>0 then
   drawpad((controller+1)%3,16-128+padx,80,false)
  end
  
  if timer%64<32 then
   text(64,74,"press x to start","c")
  end
  text(64,120,"* 2020  shakhov's inc","c")
  
  pal(8,7)
  spr(42,8+4*sin(timer%64/64),96)
  spr(43,112-4*sin(timer%64/64),96)
  pal()
  
		--score
		prntnum(hiscores0,hiscores1,128,0)
  
 elseif mode=="credits" then
  
  for i=1,#creditstext do
   y=128-timer+i*8
   if (y>-8) and (y<128) then
	   t=creditstext[i]
	   if type(t)=="string" then
	    text(64,y,t,"c")
	   else
	    text(32,y,t[1],"r")
	    text(32,y,t[2],"l")
	   end
	  end
  end
  
  if (timer>240)and(timer<408) then
 	 map(12,0,48,128-timer+240,4,4)
 	end
 	
 elseif mode=="get ready" then
 
  if timer%32<16 then
   text(64,60,"get ready","c")
  end
  
 elseif mode=="game" then
 
	 --gmaepad
		drawpad()
		
		--enemies
	 palt(0,true)
	 pal(8,starcolors[8-(level-1)%8][2])
		for e in all(enms) do
		 spr(e.i,e.x-4,e.y-4)
		 map(0,5,e.x-8,e.y-8,2,2)
		end
		pal()
		
		--bonuses
		for b in all(bnss) do
   x=b.x
   y=b.y+16*cos(b.o/32)
		 spr(49,x-4,y-4)
		 map(0,7,x-8,y-8,2,2)
		end
		
		--lives
		for i=1,lives do
	  spr(48,i*8-8,0)
		end
		
		--score
		if (blinkscores%2)==0 then
 		prntnum(scores0,scores1,128,0)
 	end
 	if blinkscores>0 then
 	 blinkscores=blinkscores-1
 	 if blinkscores==0 then
 	  blinkscores=-2
 	 end
 	end
		
	elseif mode=="game over" then
	
 	palt(0,true)
 	palt(11,false)
	 map(2,5,48,96,4,2)
	 
	 if timer<64 then
	  x=timer/2
	 else
	  x=64-timer/2
	 end
  map(0,5,32-x,0,2,2)
  spr(100,68-x,4)
 	palt(0,false)
 	palt(11,true)
  spr(116,100-x,4)
 	palt(0,true)
 	palt(11,false)
  spr(49,132-x,4)
  
	 y=16
	 for b in all(btns) do
	  prntnum(b.bbls,0,48-x,y)
	  prntnum(b.hits,0,80-x,y)
	  prntnum(b.lsses,0,112-x,y)
	  prntnum(b.shots,0,144-x,y)
 	 spr(b.i+32,8,y)
	  map(0,5,4,y-4,2,2)
	  y=y+12
	 end
	 
	end
	
	--bullets
	for b in all(bllts) do
  spr(49,b.x-4,b.y-4)
 end
  
	--animations
	for a in all(anims) do
	 if a.i==0 then
		 	palt()
		 	map(0,23,a.x,a.y,16,7)
		 	map(6,7,a.x+34,a.y+48,8,2)
	 elseif a.i==1 then
		 	palt(0,false)
		 	palt(11,true)
		 	map(0,9,a.x,a.y,4,4)
	 elseif a.i==1 then
		 	palt(0,false)
		 	palt(11,true)
		 	map(0,9,a.x,a.y,4,4)
	 elseif a.i==2 then
		 	palt(0,false)
		 	palt(11,true)
		 	map(4,9,a.x,a.y,4,4)
	 elseif a.i==3 then
		 	palt(0,false)
		 	palt(11,true)
		 	map(8,9,a.x,a.y,4,4)
	 elseif a.i==4 then
		 	palt(0,false)
		 	palt(11,true)
		 	map(12,9,a.x,a.y,4,4)
	 else
	 
		 if a.i==116 then
		 	palt(0,false)
		 	palt(11,true)
		 else
		 	palt()
		 end
		 spr(a.i+a.t/a.s,a.x,a.y)
		 
		end
		
	end
	
	for p in all(particles) do
	 pset(p.x,p.y,p.c)
	end
	
end

function drawpad(ctrl,x,y,drawbtns)
 
 if ctrl==nil then
  ctrl=controller
 end
 if x==nil then
  x=16
 end
 if y==nil then
  y=88
 end
 if drawbtns==nil then
  drawbtns=true
 end
 
 palt(0,false)
 if ctrl==2 then
		map(0,13,x,y,12,5)
 elseif ctrl==1 then
		map(0,18,x,y,12,5)
 else
		map(0,0,x,y,12,5)
	end
	if drawbtns then
		for b in all(btns) do
			spr(b.i+b.prssd*16,b.x*8,b.y*8)
		end
	end
 
end

function lvlup()

 if clearbtns>=100 then
  lives=lives+1
  clearbtns=0
  newanim(68,lives*8-8,0,10)
  newanim(84,min(120,lives*8-4),4,5)
  sfx(3)
 end
 
 if scores1==0 then
	 if scores0==50 then
	  level=2
	  celebration(level-1)
	  add(bnss,newbonus())
	 elseif scores0==100 then
	  level=3
	  celebration(level-1)
	  add(bnss,newbonus())
	 elseif scores0==200 then
	  level=4
	  celebration(level-1)
	  add(bnss,newbonus())
	 elseif scores0==500 then
	  level=5
	  celebration(level-1)
	  add(bnss,newbonus())
	 elseif scores0==1000 then
	  level=6
	  celebration(level-1)
	  add(bnss,newbonus())
	 elseif scores0==2000 then
	  level=7
	  celebration(level-1)
	  add(bnss,newbonus())
	 elseif scores0==5000 then
	  level=8
	  celebration(level-1)
	  add(bnss,newbonus())
	 end
	elseif scores0==0 then
  level=level+1
  celebration(level-1)
  add(bnss,newbonus())
 end
 
 enmycount=flr((level+1)/2)
 
 while enmycount>#enms do
  add(enms, newenmy())
 end
 
end

function newenmy()
 
 b=btns[flr(rnd(#btns))+1]
 
 speed=0.4+level/5
 
 b.bbls=b.bbls+1
 return {x=b.x*8+4,y=-16,i=b.i+32,n=b.n,s=speed}
 
end

function newbonus()
 return {x=128,y=64,o=0}
end

function newbllt(n,x,y)

	for b in all(bllts) do
  if b.n==n then
   return 0
  end
 end
 
 speed=4+flr(gunlevel/2)
 speed=min(speed,12)
 
 blltlmt=flr((gunlevel+1)/2)
 blltlmt=min(5,blltlmt)
 
 if #bllts<blltlmt then
  add(bllts,{n=n,x=x,y=y,s=speed})
  sfx(1)
  return 1
 end
 
 return 0
 
end

function newanim(i,x,y,s)
	-- s - speed, ticks per frame
 add(anims,{i=i,x=x,y=y,s=s,t=0})
end

function prntnum(num0,num1,x,y)

	s=num0
	n=1
	while (s>0) or (n==1) do
	 spr(54+s%10,x-n*8,y)
	 s=flr(s/10)
	 n=n+1
	end
	
	if num1>0 then
	 
	 while n<5 do
 	 spr(54,x-n*8,y)
 	 n=n+1
	 end

		s=num1
		while s>0 do
		 spr(54+s%10,x-n*8,y)
		 s=flr(s/10)
		 n=n+1
		end

	end
end

function celebration(n)
 
 if n==1 then
  newanim(1,-32,-32,40)
 elseif n==2 then
  newanim(2,128,-32,40)
 elseif n==3 then
  newanim(1,-32,-32,40)
  newanim(2,128,-32,40)
 elseif n==4 then
  newanim(3,-32,96,40)
 elseif n==5 then
  newanim(1,-32,-32,40)
  newanim(3,-32,96,40)
 elseif n==6 then
  newanim(2,128,-32,40)
  newanim(3,-32,96,40)
 elseif n==7 then
  newanim(1,-32,-32,40)
  newanim(2,128,-32,40)
  newanim(3,-32,96,40)
 elseif n==8 then
  newanim(4,128,96,40)
 elseif n==9 then
  newanim(1,-32,-32,40)
  newanim(4,128,96,40)
 elseif n==10 then
  newanim(2,128,-32,40)
  newanim(4,128,96,40)
 elseif n==11 then
  newanim(1,-32,-32,40)
  newanim(2,128,-32,40)
  newanim(4,128,96,40)
 elseif n==12 then
  newanim(3,-32,96,40)
  newanim(4,128,96,40)
 elseif n==13 then
  newanim(1,-32,-32,40)
  newanim(3,-32,96,40)
  newanim(4,128,96,40)
 elseif n==14 then
  newanim(2,128,-32,40)
  newanim(3,-32,96,40)
  newanim(4,128,96,40)
 else
  newanim(1,-32,-32,40)
  newanim(2,128,-32,40)
  newanim(3,-32,96,40)
  newanim(4,128,96,40)
 end
 
 if n%2==1 then
  l=128/(n+1)
 else
  l=128/n
 end
 for i=1,n do
	 if n%2==1 then
	  x=l*i
	 else
	  x=l*(i-0.5)
	 end
	 add(frwrks,{x=x,t=16*rnd(n)})
 end
 
end

function firework(x)
 for i=1,100 do
  add(particles,{x=x,y=128+rnd(32),sx=(rnd(2)-1),sy=-4-rnd(4),c=rnd(16)})
 end
 sfx(6)
 sfx(7)
end

function text(fx,fy,string,align)
 local x=fx
 local y=fy
 
 if align=="l" then
  x=x
 elseif align=="r" then
  x=x-textlength(string)
 elseif align=="c" then
  x=x-textlength(string)/2
 end
 
 palt(0)
 
 for i=1,#string do
 
  leter=sub(string,i,i)
  symbol=symbols[leter]
  
  if symbol.spr>0 then
   spr(symbol.spr,x,y)
  end
  x+=symbol.length
  
 end
 
end

function textlength(string)

 result=0
 for i=1,#string do
 
  leter=sub(string,i,i)
  sym=symbols[leter]
  
  result+=sym.length
  
 end
 
 return result

end
