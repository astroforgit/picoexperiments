 pal()
 map(80,9,0,0,16,16)
 print("press",34,66,5)
 print("—",40,72,5)
 print("to",72,66,5)
 print("begin",66,72,5)
 
end

function _init()
 titleinit()
end

function gameinit()
 game_state = "s_game"
 
 fade(15,"out")
 -- make player
 cls()
 pl = make_actor(5.5,11.5)
 
 map(map_x,map_y,0,0,16,16)
 pl.spr = 49
 
 
 fade(15,"in")
 
 pal()
 
 
end

-- for any given point on the
-- map, true if there is wall
-- there.

function solid(x, y)

 -- grab the cell value
 -- sect_x and sect_y added
 -- by david
 -- #map sector system
 val=mget(x+sect_x, y+sect_y)

 
 -- check if flag 1 is set (the
 -- orange toggle button in the 
 -- sprite editor)
 return fget(val, 1)
 
end

-- solid_area
-- check if a rectangle overlaps
-- with any walls

--(this version only works for
--actors less than one tile big)

function solid_area(x,y,w,h)

 return 
  solid(x-w,y-h) or
  solid(x+w,y-h) or
  solid(x-w,y+h) or
  solid(x+w,y+h)
end


-- true if a will hit another
-- actor after moving dx,dy
function solid_actor(a, dx, dy)
 for a2 in all(actor) do
  if a2 != a then
   local x=(a.x+dx) - a2.x
   local y=(a.y+dy) - a2.y
   if ((abs(x) < (a.w+a2.w)) and
      (abs(y) < (a.h+a2.h)))
   then 
    
    -- moving together?
    -- this allows actors to
    -- overlap initially 
    -- without sticking together    
    if (dx != 0 and abs(x) <
        abs(a.x-a2.x)) then
     v=a.dx + a2.dy
     a.dx = v/2
     a2.dx = v/2
     return true 
    end
    
    if (dy != 0 and abs(y) <
        abs(a.y-a2.y)) then
     v=a.dy + a2.dy
     a.dy=v/2
     a2.dy=v/2
     return true 
    end
    
    --return true
    
   end
  end
 end
 return false
end


-- checks both walls and actors
function solid_a(a, dx, dy)
 if solid_area(a.x+dx,a.y+dy,
    a.w,a.h) then
    return true end
 return solid_actor(a, dx, dy) 
end

function move_actor(a)

 -- only move actor along x
 -- if the resulting position
 -- will not overlap with a wall
 
 -- if collide with fire ball
 if ball then
  if solid_a(ball, ball.dx, 0) then
   if shield then
    ball.frame=0
    ball.spr=17
    cls()
    rectfill(0,0,128,128,0)
    foreach(actor,draw_actor)
    sfx(3)
    wait(5)
    del(actor,ball)
    ball=nil
    wait(5)
   else
    
    cls()
    rectfill(0,0,128,128,0)
    foreach(actor,draw_actor)
    sfx(4)
    fade(15,"out")
    gameoverinit()
    
   end
  end
 end
 
 if not solid_a(a, a.dx, 0) 
 then
  a.x += a.dx
 else   
  -- otherwise bounce
  a.dx *= -a.bounce
  --a.d = a.d * -1
  sfx(2)
 end
 

 -- ditto for y

 if not solid_a(a, 0, a.dy) then
  a.y += a.dy
 else
  a.dy *= -a.bounce
  sfx(2)
 end
 
 -- apply inertia
 -- set dx,dy to zero if you
 -- don't want inertia
 
 a.dx *= a.inertia
 a.dy *= a.inertia
 
 -- advance one frame every
 -- time actor moves 1/4 of
 -- a tile
 
 a.frame += abs(a.dx) * 4
 a.frame += abs(a.dy) * 4
 a.frame %= a.frames

 a.t += 1
 
end

function sector_limit_detection(sect,x,y)

-- #map sector management
-- by david
-- limit detection and sector change
-- game logic

if sect == 4 then
 -- sector 4 to sector 3
 if x < 1 then
  map_x=0
  map_y=16
  sect_x=0
  sect_y=16
  pl.x=15
  map_section=3
 -- sector 4 to sector 2 
 elseif y < 1 then
  map_x=16
  map_y=0
  sect_x=16
  sect_y=0
  pl.y=13
  map_section=2
 -- sector 4 to desert
 elseif y > 11.5 and x > 12.5 then 
  map_x=64
  map_y=0
  sect_x=64
  sect_y=0
  pl.dy=0
  pl.x=1
  pl.y=13.13
  map_section=9
  if boots == nil then
   boots = make_actor(12.5,13.13)
   boots.spr = 48
   boots.frames=1
  end
 end
elseif sect == 3 then
 -- sector 3 to sector 4
 if x > 15 then 
  map_x=16
  map_y=16
  sect_x=16
  sect_y=16
  pl.x=1
  map_section=4
 elseif y < 5.7 and boots == nil then
  dialoginit(9)
  
 -- from waterfall to cave
 elseif y < 5 then 
  -- todo validate the position of the boot sprite
  if boots then
   map_x=48
   map_y=16
   sect_x=48
   sect_y=16
   pl.x=7.5
   pl.y=13
   map_section=5
   if door then
    --
   else
    -- draw locked door
 
    door = make_actor(3,8.5)
    door.spr = 63
    door.frames=1

   end
  else
   -- todo message that need boots
   -- fait plus haut, verifier ce todo
   
  end 
 end
elseif sect == 5 then
 
 -- from cave to sector 1
 if y < 1 then --
  map_x=0
  map_y=0
  sect_x=0
  sect_y=0
  pl.x=11.5
  pl.y=6.5
  map_section=1
  del(actor,door)
  door = nil
 
 -- from cave to waterfall
 elseif y > 13.3 then
  map_x=0
  map_y=16
  sect_x=0
  sect_y=16
  pl.x=7.5
  pl.y=6.1
  map_section=3
  del(actor,door)
  door = nil
 elseif x < 4 and door then
  if key then
   cls()
   
   foreach(actor,draw_actor)
   sfx(3)
   wait(5)
  
   del(actor,door)
   door = nil
  else
   dialoginit(6)
  end
 elseif x < 1 then
  
  endgameinit()
 end
 
elseif sect == 2 then
 -- sector 2 to moutain
 if y > 13 then 
  map_x=32
  map_y=16
  sect_x=32
  sect_y=16
  pl.dy=0
  pl.x=1
  pl.y=13.13
  map_section=8
  
  if ball then
  --
  else
   ball = make_actor(12,11,5)
   ball.spr = 51
   ball.dx=-0.2
   --ball.dy=0.15
   ball.x=15
   ball.y=13.13
   ball.dy=0
   ball.inertia=1
   ball.bounce = 0.8
   ball.danger=1
  end
 -- from sector 2 to quay
 elseif y > 7 and x < 2.3 then
  map_x=96
  map_y=0
  sect_x=96
  sect_y=0
  pl.dy=0
  pl.x=15
  pl.y=14.13
  map_section=11
 -- from sector 2 to village
 elseif y < 3 and x > 11 then 
  map_x=32
  map_y=0
  sect_x=32
  sect_y=0
  pl.dy=0
  pl.x=1
  pl.y=13.13
  map_section=10
 --from sector 2 to small cave 1
 elseif y < 1 then 
  map_x=64
  map_y=16
  sect_x=64
  sect_y=16
  pl.x=7.5
  pl.y=13.5
  map_section=6
 --from sector 2 to small cave 2
 elseif y < 9.2 and x > 14.4 then 
  map_x=64
  map_y=16
  sect_x=64
  sect_y=16
  pl.x=7.5
  pl.y=13.5
  map_section=6
  map_sub_section=2
 end
elseif sect == 6 then
 -- dialog in old man cave
 if y < 12 then
  if map_sub_section == 2 and shield then
   dialoginit(4)
  elseif map_sub_section == 2 then  
   dialoginit(3)
  else
   dialoginit(1)
  end 
 elseif y > 13.7 then
  map_x=16
  map_y=0
  sect_x=16
  sect_y=0
  if map_sub_section == 2 then
   pl.x=14.5
   pl.y=9.5
   map_section=2
   map_sub_section=0
  else
   pl.x=0.5
   pl.y=1.5
   map_section=2
  end
 end
elseif sect == 1 then
 -- from sector 1 to waterfall cave
 if x > 12 and y < 6.5 then 
   map_x=48
   map_y=16
   sect_x=48
   sect_y=16
   pl.x=7.5
   pl.y=1.5
   map_section=5
   if door then
    --
   else
    -- draw locked door
 
    door = make_actor(3,8.5)
    door.spr = 63
    door.frames=1

   end
 -- from sector 1 to castle
 elseif x < 9 and y < 8 then
  map_x=48
  map_y=0
  sect_x=48
  sect_y=0
  pl.x=7.5
  pl.y=13.13
  pl.dy=0
  map_sub_section=3
  map_section=7
  -- anita key
  anita = make_actor(13,13.2)
  anita.spr=31
  anita.frames=1
  --a.dx=1/8
  anita.inertia=0.8
 end
elseif sect == 10 then
 -- from village to house
 if x > 6.5 and x < 7.5 then 
  map_x=48
  map_y=0
  sect_x=48
  sect_y=0
  pl.x=7
  pl.y=13.13
  map_section=7
  -- tiny guy
  a = make_actor(13,13.2)
  a.spr=35
  a.frames=1
  --a.dx=1/8
  a.inertia=0.8
  
 -- from village to sector 2
 elseif x < 0.6 then 
  map_x=16
  map_y=0
  sect_x=16
  sect_y=0
  pl.x=11.5
  pl.y=3.5
  map_section=2
 end
elseif sect == 11 then
 if x > 15.5 then
  map_x=16
  map_y=0
  sect_x=16
  sect_y=0
  pl.x=2.5
  pl.y=7.5
  map_section=2
 elseif x < 4 then
 cinematicinit()
 
 end
 

elseif sect == 7 then
 if map_sub_section == 3 then
  if x > 10.5 then
   if key then
    dialoginit(8)
   else
    
    dialoginit(7)
   end
  -- from castle to sector 1
  elseif x < 6.4 then
  map_x=0
  map_y=0
  sect_x=0
  sect_y=0
  pl.x=9
  pl.y=8
  map_section=1
  map_subsection=0
  del(actor,anita)
  anita = nil
  end
 -- from house to village
 elseif x < 6.5 then 
  map_x=32
  map_y=0
  sect_x=32
  sect_y=0
  pl.x=6.5
  pl.y=13.13
  map_section=10
  
  del(actor,a)
 -- dialogue in house
 elseif x > 10.5 then
  dialoginit(2)
 end
elseif sect == 8 then
 -- from mountain to sector 4
 if x > 15.5 then 
  map_x=16
  map_y=16
  sect_x=16
  sect_y=16
  pl.x=6.5
  pl.y=1.5
  map_section=4
  del(actor,ball)
  ball = nil
 -- from mountain to sector 2
 elseif x < 0.5 then
  map_x=16
  map_y=0
  sect_x=16
  sect_y=0
  pl.x=6.5
  pl.y=12.7
  map_section=2
  del(actor,ball)
  ball = nil
 end
elseif sect == 9 then
 -- from desert to sector 4
 if x < 1 then
  map_x=16
  map_y=16
  sect_x=16
  sect_y=16
  pl.x=11
  pl.y=12
  map_section=4
  if boots.y > 1 then
   del(actor,boots)
   boots = nil
  end
 -- get the rubber boots
 elseif x > 11.5 then
  if boots.y < 1 then
   --
  else
   dialoginit(5)
  end
 end
end
-- #/map sector management

end

function control_player(pl)

-- sect_x and sect_y added
-- by david
-- #map sector system
val = mget(pl.x+sect_x,pl.y+sect_y)

-- #speed management system
-- by david
-- using flags 6,5,4
if fget(val,6) then
 speed=10
elseif fget(val,5) then
 speed = 7.5
elseif fget(val,4) then
 speed = 6
else
 speed = 12
end

-- #map sector management
sector_limit_detection(map_section,pl.x,pl.y)

 -- how fast to accelerate
 -- #speed management system
 -- speed mutiplier added by david
 accel = 0.005*speed
 if btn(0) then 
  pl.dx -= accel 
  --#sprite flip
  --added by david
  pl.d = -1
 end
 if btn(1) then
  pl.dx += accel
  --#sprite flip
  --added by david
  pl.d = 1
 end
 
 -- #map sector system
 -- y axis disable in village mode 
 if map_section <= 6 then
  if (btn(2)) pl.dy -= accel 
  if (btn(3)) pl.dy += accel 
 end
 -- play a sound if moving
 -- (every 4 ticks)
 
 if (abs(pl.dx)+abs(pl.dy) > 0.05
     and (pl.t%(60/speed)) == 0) then
  sfx(1)
 end
 
end

function _update()
 
 if game_state == "s_title" then
  updatetitle()
 elseif game_state == "s_dialog" then
  updatedialog()
 elseif game_state == "s_cinematic" then
  updatecinematic()
 elseif game_state == "s_gameover" then
  updategameover()
 elseif game_state == "s_endgame" then
  updateendgame()
 else
  control_player(pl)
  foreach(actor, move_actor)
 end
end

function draw_actor(a)
 local sx = (a.x * 8) - 4
 local sy = (a.y * 8) - 4
 
 spr(a.spr + a.frame, sx, sy, 1, 1, a.d < 0)
end

function _draw()
 
 if game_state == "s_game" then
  cls()
  map(map_x,map_y,0,0,16,16)
  foreach(actor,draw_actor)
 
  --print("x "..pl.x,0,121,7)
  --print("y "..pl.y,68,121,7)
  --print("speed "..speed,32,121,7)
  --print("a.t="..a.t,32,121,7)
  --print("sfx "..60/speed,68,121,7) 
 end
end
