 dialog_frame()
 
 dialog = "you've completed go west! let's"
 dialog2 = "see what's in this chest!" 
  
 print(dialog,hcenter(dialog),114,7)
 print(dialog2,hcenter(dialog2),121,7)
 
 
 
end

