function cinematicinit()
 game_state = "s_cinematic"
 
 fade(15,"out")
 cls()
 map(14,0,0,0,16,16)
 
 y = 1
 
 fade(15,"in") 
 cls()
 pal()
 for i=14,0,-1 do
  cls()
  
  y-=0.1
  map(i,0,0,0,16,16)
  
  wait(2)
  
 end
 
 
 dialog_frame()
 
 
 dialog = "great castle ! hint: there"
 dialog2 = " is no ship in the game." 
 
 
 print(dialog,hcenter(dialog),114,7)
 print(dialog2,hcenter(dialog2),121,7)
 
 pl.dx=0.2

end

function gameoverinit()
 game_state="s_gameover"
 
 dialog_frame()
 
 dialog = "fire is dangerous. check"
 dialog2 = "smoke detectors batteries." 
 
 
 print(dialog,hcenter(dialog),114,7)
 print(dialog2,hcenter(dialog2),121,7)
 fade(15,"in")

end

function dialog_frame()
 spr(25,0,112)
 spr(25,120,120,1,1,1,0)
 spr(26,120,112,1,1,1,1)
 for i=8,112,8 do
  spr(27,i,112)
 end
 spr(26,0,120)
 for i=8,112,8 do
  spr(27,i,120,1,1,0,1)
 end
end

function dialoginit(d)
 game_state = "s_dialog"
 
 dialog_frame()
 
 if d == 1 then
  dialog = "i am an error."
  dialog2 = ""
  pl.dy =0.2
 elseif d== 2 then
  dialog = "there is an old man in the"
  dialog2 = "cave. his name is daniel." 
  pl.dx = -0.2
 elseif d == 3 then
  dialog = "here is a shield. it is so"
  dialog2 = "hot you will dodge fire." 
  sfx(5)
  pl.dy = 0.2
  shield = make_actor(pl.x+0.51,pl.y-0.59)
  shield.spr = 32
  
  
  map(map_x,map_y,0,0,16,16)
  foreach(actor,draw_actor)
  
 elseif d == 4 then
  dialog = "i am claude. daniel"
  dialog2 = "is the other old guy."  
  pl.dy = 0.2
 elseif d == 5 then
  dialog = "rubber boots in the desert? got"
  dialog2 = "to find water to jump in." 
  sfx(5)
  pl.dx = -0.2
  boots.x = pl.x+0.7
  boots.y =pl.y-0.59
  --boots.spr = 48
  map(map_x,map_y,0,0,16,16)
  foreach(actor,draw_actor)
  rectfill(0,112,128,128,0)
  dialog_frame()
 elseif d== 6 then
  dialog = "locked door. i wonder who could"
  dialog2 = "help me. maybe anita key!" 
  sfx(6)
  pl.dx = 0.2
 elseif d == 7 then
  dialog = "hi, i am anita key. maybe a"
  dialog2 = "a key is what you need." 
  sfx(5)
  pl.dx = -0.2
  key = make_actor(pl.x+0.47,pl.y-0.59)
  key.spr = 28
  
  
  map(map_x,map_y,0,0,16,16)
  foreach(actor,draw_actor)
 elseif d== 8 then
  dialog = "now get out! anita drink !"
  dialog2 = "" 
  pl.dx = -0.2
 elseif d== 9 then
  dialog = "arg! water!! i don't want"
  dialog2 = "my socks to get all wet!" 
  sfx(6)
  pl.dy = 0.2
  
  
 end
 print(dialog,hcenter(dialog),114,7)
 print(dialog2,hcenter(dialog2),121,7)
 
end

