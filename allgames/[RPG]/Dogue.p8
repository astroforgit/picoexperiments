pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
--dogue | #7drl by program_ix
--explore a dungeon as a dog
function _init()
	debug=true
	state=0
	floors={}
	d={x=0,y=1,lives=3,stamina=30}
	messages={}
	rm_base_w=3
	rm_base_h=3
	rm_var_w=3
	rm_var_h=3
	flr_rm_base=4
	flr_rm_var=2
	max_enemies=1
	max_items=3
	gen_floor()
	process_cooldown=5
	process_timer=0
	cf=1 --current floor
	cr=1 --current room
	d.y=floors[cf][cr].ent
	sfx(0)
end

--

function c_print(txt,y,c)
	txt=""..txt
	print(txt,64-(#txt*2),y,c)
end

--

function spawn_enemy(x,y)
	return{x=x,y=y,name="skeleton"}
end

--

function spawn_heart(x,y)
	return{x=x,y=y,name="heart",
		health=1,moves=0,s=32}
end

--

function spawn_food(x,y)
	return{x=x,y=y,name="food",
		health=0,moves=5,s=33}
end

--
function gen_floor()
	max_enemies+=.5
	floor={}
	for i=1,flr(rnd(flr_rm_base)+
		flr_rm_var)
	do
		room={}
		room.w=flr(rnd(rm_base_w))+
			rm_var_w
		room.h=flr(rnd(rm_base_h))+
		 rm_var_h
		room.enemies={}
		room.items={}
		for i=0,room.h
		do
			row={}
			for j=0,room.w
			do
				tile={}
				tile.t=flr(rnd(6))+1
				--don't want a brown tile
				if(tile.t==4)
				then
					tile.t=7
					if(#room.enemies<max_enemies)
					then
						enemy=spawn_enemy(j,i)
						add(room.enemies,enemy)
					end
				else
					if(tile.t==3)
					then
						if(#room.items<max_items)
						then
						 heart=spawn_heart(j,i)
						 add(room.items,heart)
						end
					end
					if(tile.t==2)
					then
						if(#room.items<max_items)
						then
							food=spawn_food(j,i)
							add(room.items,food)
						end
					end
				end
				add(row,tile)
			end
			add(room,row)
		end
		room.ent=flr(rnd(room.h))
		room.ext=flr(rnd(room.h))
		add(floor,room)
	end
	add(floors,floor)
end

--

function update_title()
	if(btnp(4))
	then
		state=1
	end
end

--

function player_move()
	if(process_timer>=0)
	then
		process_timer-=1
		return false
	end
	rm=floors[cf][cr]
	if(btnp(0))
	then
		if(d.x>0)
		then
			d.x-=1
			return true
		else
			if(d.y==rm.ent)
			then
			 if(cr>1)
			 then
			 	cr-=1
			 	rm=floors[cf][cr]
			 	d.x=rm.w
			 	d.y=rm.ext
			 	return true
			 else
			 	if(cf>1)
			 	then
			 		cf-=1
			 		cr=#floors[cf]
			 		rm=floors[cf][cr]
			 		d.x=rm.w
			 		d.y=rm.ext
			 	end
			 end
			end
		end
	end
	if(btnp(1))
	then
	 if(d.x<rm.w)
		then
			d.x+=1
			return true
		else
			if(d.y==rm.ext)
			then
			 if(cr<#floors[cf])
			 then
			 	cr+=1
			 	rm=floors[cf][cr]
			 	d.x=0
			 	d.y=rm.ent
			 	return true
			 else
			 	if(cf>=#floors)
			 	then
			 		gen_floor()
			 	end
			 	cf+=1
			 	cr=1
			 	rm=floors[cf][cr]
			 	d.x=0
			 	d.y=rm.ent	
			 end
			end
		end
	end
	if(btnp(2) and d.y>0)
	then
		d.y-=1
		return true
	end
	if(btnp(3) and d.y<rm.h)
	then
		d.y+=1
		return true
	end
end

--

function player_collide()
 rm=floors[cf][cr]
 for e in all(rm.enemies)
	do
		if(e.x==d.x and e.y==d.y)
		then
			add(messages,"killed "..e.name)
			--d.lives+=1
			del(rm.enemies,e)
		end
	end
	for i in all(rm.items)
	do
		if(i.x==d.x and i.y==d.y)
		then
			add(messages,"picked up "..i.name)
			d.lives+=i.health
			d.stamina+=i.moves
			del(rm.items,i)
		end
	end
end

--

function others_move()
	room=floors[cf][cr]
	for e in all(room.enemies)
	do
		if((e.x==d.x-1 and e.y==d.y)
  or (e.x==d.x and e.y==d.y-1)
  or (e.x==d.x+1 and e.y==d.y)
  or (e.x==d.x and e.y==d.y+1))
  then
  	add(messages,"hurt by "..e.name)
   d.lives-=1
  else
  	xd=abs(d.x-e.x)
  	yd=abs(d.y-e.y)
  	if(xd>yd)
  	then
  		if(d.x>e.x)
  		then
  		 e.x+=1
  		else
  			if(d.x<e.x)
  			then
  				e.x-=1
  			end
  		end
  	else
  		if(d.y>e.y)
  		then
  		 e.y+=1
  		else
  			if(d.y<e.y)
  			then
  				e.y-=1
  			end
  		end
  	end
  end
	end
end

--

function player_process()
	d.stamina-=1
	if(d.stamina<=0)
	then
		add(messages,"you died of exhaustion")
		state=2
	end
	if(d.lives<=0)
	then
		add(messages,"you were killed.")
		state=2
	end
end

--

function process_turn()
	pm=player_move()
	if(pm)
	then
		player_collide()
		others_move()
		player_process()
	end
end

--

function update_game()
	process_turn()
end

--

function update_endgame()
	if(btnp(4))
	then
		_init()
	end
end

--

function _update()
	if(state==0)
	then
		update_title()
	else
		if(state==1)
		then
			update_game()
		else
			update_endgame()
		end
	end
end

--

function draw_title()
 c_print("dogue",44,7)
 c_print("by program_ix",60,7)
 c_print("explore the dungeon",70,7)
 c_print("eat food to keep going",80,7)
 c_print("enemies will hurt you",90,7)
 c_print("find hearts to stay alive",100,7)
 c_print("arrows move, z to start",110,7)
	c_print("#7drl march 2017",120,7)
end

--

function draw_dog(fl,rm,tlx,tly)
	spr(1,tlx+(8*d.x),tly+(8*d.y))
end

--

function draw_enemies(fl,rm,tlx,tly)
	room=floors[fl][rm]
	for e in all(room.enemies)
	do
		spr(16,tlx+(8*e.x),tly+(8*e.y))
	end
end

--

function draw_items(fl,rm,tlx,tly)
 room=floors[fl][rm]
 for i in all(room.items)
 do
 	spr(i.s,tlx+(8*i.x),tly+(8*i.y))
 end
end

--

function draw_room(fl,rm,tlx,tly)
	room=floors[fl][rm]
	if not room
	then
		cls()
		--print("0 0"..floors[0][0])
		--print("0 1"..floors[0][1])
		print("1 0"..floors[1][0])
		print("1 1"..floors[1][1])
		return 0
	end
	for i=0,room.h
	do
		for j=0,room.w
		do
			tile=room[i+1][j+1]
			--pal(1,tile.t)
			--swap i,j because height
			--is y not x
			spr(2,tlx+(j*8),tly+(i*8))
			--pal()
		end
		if(i==room.ent)
		then
			spr(3,tlx-8,tly+(i*8))
		end
		if(i==room.ext)
		then
			spr(3,tlx+((room.w+1)*8),
			 tly+(i*8))
		end
	end
	if(cf==fl and cr==rm)
	then
		draw_enemies(fl,rm,tlx,tly)
		draw_items(fl,rm,tlx,tly)
	end
end

--

function draw_game()
	draw_room(cf,cr,8,8)
	draw_dog(cf,cr,8,8)
	if(debug)
	then
		print("floor: "..cf.." room: "..cr,8,120,7)
	end
	print("lives: "..d.lives..
	 " moves: "..d.stamina,0,0,7)
	if(#messages>0)
	then
		print(messages[#messages],0,100,7)
		if(#messages>1)
		then
			print(messages[#messages-1],0,110,7)
		end
	end
end

--

function draw_endgame()
	c_print(messages[#messages],60,7)
	c_print("you reached floor "..#floors,80,7)
	c_print("you died in room "..cr.." of floor "..cf,90,7)
	c_print("z to restart",110,7)
end

--

function _draw()
	cls()
	if(state==0)
	then
		draw_title()
	else
		if(state==1)
		then
			draw_game()
		else
			draw_endgame()
		end
	end
end
