pico-8 cartridge // http://www.pico-8.com
version 14
__lua__
--unrogue
--dunin

statut = {}
	statut.menu=0
	
	statut.setlevel=12
	statut.playermove=13
	statut.ennemiesmove=14
 statut.chooseinv=15
	statut.marchand=16
	statut.gameover=17
gs = statut.menu --game statut
offgridx=41
offgridy=22
offinvx=49
offinvy=8
offhx=5
offhy=offinvy
gridw=9
gridh=11
levels ={10,16,20,25,20,30,35,40,35,30,40,35,30}
level=1
h={}
inv={}
grid={}
spritewall = 34
spritestairs = 35
spritegold = 36
spritemarchand = 38
stairs = {}
ennemies = {}
gold = nil
marchand = nil
waitingtime=5
waitennemies = 4
wait=0
animations={}
hapt={}
nbinv = 8
idselect = nil
tdisplay=nil
score=0
phurt=nil
marselect=1
goldval=100
colormenu=0

typeinv = {
	gold=18, -- keep it to first id
	move=19, -- keep it second id
	arm=20,		-- keep incrementation
	force=21 -- keep it to last id
}

typeennemies = {
	{2,3,0,1,1,100}, -- spr snd a f m vdist
	{4,2,0,2,1,9},
	{6,4,0,1,2,8},
	{7,5,2,2,1,10},
	{3,2,0,1,3,7},
	{5,5,0,2,2,8},
	{8,4,3,1,2,6}
}

freqgold = 2
freqmarchand = 5

function _init() 
	colormenu=getrndcol()
	h = createperso(1,5,1,1,1,1,1,offhx,offhy)
	stairs = createstairs()
	tdisplay = t.start
	score=0
	gs = statut.menu
	music(0)	
end

function _update()
	if(gs == statut.menu) then
		if(btn(4)) then
			level=1
			tdisplay=nil
			gs=statut.setlevel
		elseif(btn(5)) then
			intronext()		
		end
	elseif(wait>0) then
		wait-=1
	
	elseif (gs<statut.setlevel) then
				if(btn(4) or btn(5))then
					intronext()
				end
	elseif (gs==statut.setlevel) then
		setlevel(levels[level])
		
	elseif (gs==statut.playermove) then
		if(h.m==0)then startennemiesturn()
		else	checkpmove() end
		--if(btn(4)) then gs=statut.setlevel	end
	
	elseif (gs==statut.ennemiesmove) then
		if(moveennemies()==false)then starthturn()		
		else wait=waitennemies end
	
	elseif (gs==statut.chooseinv) then
		chooseinv()

	elseif (gs==statut.marchand) then
		choosemar()
		
	elseif (gs==statut.gameover) then
		if(btn(4) or btn(5)) then
			fastreset()
		end
	end
end

function _draw()
	--cls()
	rectfill(0,0,128,128,7)
	--print("gamestatut : "..gs)
	if(gs<statut.setlevel) then
		rectfill(0,0,128,128,colormenu)
		for i=0,15 do
			for j=0,15 do
				spr(33,i*8,j*8)
			end
		end
	elseif (gs>=statut.playermove or (gs==statut.setlevel and wait>0)) then

		local ybottom=offgridy+gridh*8-5
 	cursor(offhx,ybottom)
 	color(5)
 	print("floor "..level)
 	cursor(offhx,ybottom+8)
		print("score "..score)
		
		drawgrid()
		drawperso(h)
		drawinv()
	
		for i=1,#ennemies do
			drawperso(ennemies[i])
		end
		--[[for x=0,6 do
			spr(18,48+x*9,0)
		end]]
	end
	
	for i=#animations,1,-1 do
		if(animations[i]()==false) then
			del(animations,animations[i])
		end
	end 
	
	if(tdisplay != nil)then 
		dialog(tdisplay,gs<statut.setlevel or gs==statut.gameover)
	end
	
	-- bad near ending jam code
	if(gs==3)	then
		spr(17,60,34)
		spr(typeinv.move,60,34)
	elseif(gs==4) then
		spr(17,60,37)
		spr(typeinv.arm,60,37)
	elseif(gs==5) then
		spr(17,60,42)
		spr(typeinv.force,60,42)
	elseif(gs==6) then
		spr(1,60,54)
	end
end

function fastreset()
	score=0
	tdisplay=nil
	level=1 
	gs=statut.setlevel
	sfx(6)
end

function getrndcol()
	local col =7
	while(col==7) do
		col=1+flr(rnd(15))
	end
	return col
end

function intronext()
	colormenu=getrndcol()
	gs+=1
	if (gs>#(t.intro)) then
		tdisplay = nil
		gs = statut.setlevel
		music(-1)
		sfx(6)		
	else
		tdisplay = t.intro[gs]
		wait=10
	end	
end

function setlevel(diff)
	marchand=nil
		
	--creating heros
	local gridtest ={}
	local nbway=0
	while(nbway<50) do
 		--creating grid
 	grid={}
 	for i=1,gridw do
 		grid[i] = {}
 		for j=1,gridh do
 			add(grid[i],false)
 		end
 	end
 	
 	for i=1,10+flr(rnd(10)) do
 		setxy(createwall(),getfreeplace())
 	end
 	
 	-- adding marchand
 	if(level%freqmarchand==0)then
 		marchand = createmarchand()
 		setxy(marchand,getfreeplace())
 	else
 		marchand=nil
 	end
 	
		--testing if hero can move
		nbway=0
		setxy(h,getfreeplace())
		gridtest = getgridmov(h.x,h.y)
		for i=1,gridw do
			for j=1,gridh do
				if(gridtest[i][j]<1000) then
					nbway+=1
				end
			end
		end
	end
	
	local gooddist = {}
	for i=1,gridw do
		for j=1,gridh do
			if(gridtest[i][j]>100) then
				setxy(createwall(),i,j)
			elseif (gridtest[i][j]>3 and grid[i][j]!=marchand) then
				add(gooddist,{x=i,y=j})
			end
		end
	end

	-- gold and stairs
	setxy(stairs,pickgood(gooddist))
 if(level%freqmarchand!=0 and (level%freqmarchand)%freqgold==0) then
 	gold = creategold()
 	setxy(gold,pickgood(gooddist))
 else
 	gold=nil
 end	
	
	--ennemies
	ennemies ={}
	local dif = levels[min(level,#levels)]
	local i=1
	while(dif!=0) do
		local typee = 1+flr(rnd( min(dif,#typeennemies) ))
		dif -= typee
		local e = typeennemies[typee]
		e = createperso(e[1],e[2],e[3],e[4],e[5],
								1,1,offhx,1,e[6])
		add(ennemies,e)
		setxy(e,pickgood(gooddist))
		e.dist = gridtest[e.x][e.y]
		i+=1
	end
	sortennemies()
		
	if(level==1) then
	 hapt.a=0
 	hapt.f=0
 	hapt.m=0
 	inv={}
 	addit("arm")
 	addit("move")
 	addit("force")
 	for i=1,nbinv-3 do
 		addit()
 	end
 end
 
 h.a = hapt.a
 h.f = hapt.f
 h.m = hapt.m
	gs = statut.playermove
end

function pickgood(goods)
	local g=	goods[1+flr(rnd(#goods))]
	del(goods,g)	
	return g.x,g.y
end

function getfreeplace() 
	local free ={}
	for i=1,#grid do
		for j=1,#grid[i] do
			if(grid[i][j] == false) then
				add(free,{i,j})
			end
		end
	end
	
	local rand = 1+flr(rnd(#free))
	return free[rand][1], free[rand][2]
end

function setxy (perso, x ,y)
	if(grid[perso.x][perso.y]==perso) then
		grid[perso.x][perso.y] =false
	end
	
	perso.x = x
	perso.y = y
	
	grid[x][y] = perso
end

function getgridmov(x,y)
	local grid2 ={}
	local seed ={}
	
	for i=1,gridw do
		grid2[i] = {}
		for j=1,gridh do
			add(grid2[i],1000)
		end
	end
	add(seed,{x=x,y=y,dist=0})
	grid2[x][y] =0
	while (#seed!=0) do
		local s = seed[1]
		--print("#seed : "..#seed)
		del(seed,s)
		--print("seed : "..s.x.." "..s.y)
		local news = {{x=s.x-1,y=s.y,dist=s.dist+1},
			{x=s.x+1,y=s.y,dist=s.dist+1},
			{x=s.x,y=s.y-1,dist=s.dist+1},
			{x=s.x,y=s.y+1,dist=s.dist+1}}
		
		for i=1,4 do
			if (testv(news[i]) and grid2[news[i].x][news[i].y]>news[i].dist) then
 			grid2[news[i].x][news[i].y] = news[i].dist
 			add(seed,news[i])
 			--print("add x:"..news[i].x.." y:"..news[i].y.." dist:"..news[i].dist)
 		end
		end
		
	end
	return grid2
end

function testv(coor)
	if(coor.x<1 or coor.x>gridw or coor.y<1 or coor.y>gridh) then return false end
	if(grid[coor.x][coor.y] != false and grid[coor.x][coor.y].sprite == spritewall
		and grid[coor.x][coor.y].sprite == spritemarchand) then
		 return false
	end
	return true
end

function addit(item)
	if(item == nil) then
		item = typeinv.move+flr(rnd(typeinv.force-typeinv.move+1))
	else
		item = typeinv[item]
	end
	add(inv,item)
	if(item == typeinv.move) then hapt.m+=1
	elseif(item == typeinv.arm) then hapt.a+=1
	elseif(item == typeinv.force) then hapt.f+=1
 end
end

function createwall()
	return {x=1,y=1,sprite=spritewall}
end

function createstairs()
	return {x=1,y=1,sprite=spritestairs}
end

function creategold()
	return{x=1,y=1,sprite=spritegold}
end

function createmarchand()
	return{x=1,y=1,sprite=spritemarchand}
end

function createperso(_s,_snd,_a,_f,_m,_x,_y,_mx,_my,vd)
	return {
	b_sprite = _s, -- base sprite
	sprite = _s,
	sound = _snd,
	x = _x,
	y = _y,
	flipx = false,
	mx = _mx, -- menu x
	my = _my, -- menu y
	a = _a, --armor
	f = _f, --force
	m = _m, --movements
	bm = _m, --basemovement
	ba= _a, --basearmor
	vdist=vd} --view distance
end

function starthturn()
	gs = statut.playermove
	h.m = hapt.m
	
	-- to see ennemies nbmove
	for i=1,#ennemies do
		ennemies[i].m = ennemies[i].bm
	end
end

function checkpmove()
	local dest = {x=h.x,y=h.y}
	
	-- we will allow diagonal
	-- change to elseif ?
	if(btn(0))then dest.x-=1 end
	if(btn(1))then dest.x+=1 end
	if(btn(2))then dest.y-=1 end
	if(btn(3))then dest.y+=1 end
	
	if(dest.x<1 or dest.x>gridw 
		or dest.y<1 or dest.y>gridh) then return end
	
	local destc = grid[dest.x][dest.y]
	if(destc != false) then
		if (destc.sprite ==spritewall) then return
		elseif (destc.sprite == spritestairs) then
			sfx(6)
			level += 1
			gs = statut.setlevel
			add(animations,animstairs)
			wait=30
		elseif(destc.sprite == spritegold) then
			gold = nil
			score+=goldval
		 gs = statut.chooseinv
		 wait=1
		 sfx(7)
		elseif(destc.sprite == spritemarchand) then
		 gs = statut.marchand
		 wait=1
		 --sfx(7)
		 return
		elseif (destc.sprite>=2) then
			attack(h,destc)
			dest.x =h.x
			dest.y = h.y
		end
	else 
		sfx(h.sound)
		wait=waitingtime
		updatedist()
	end
	
	setxy(h,dest.x,dest.y)
	if(wait>0 and gs!=statut.gameover) then
		h.m -= 1
	end
end

function chooseinv()
	if(idselect==nil)then 
		idselect=getnextinv(0)
		wait=waitingtime
		tdisplay = t.chooseinv
	else
		wait = waitingtime
		if(btn(1)) then 
			idselect=getnextinv(idselect)
			sfx(5)
		elseif(btn(0)) then 
			sfx(5)
			idselect=getnextinv(idselect,true)
		elseif(btn(4) or btn(5) or btn(3)) then
			tdisplay = nil
			removeapt(inv[idselect])
			inv[idselect]=typeinv.gold
			idselect=nil
			if(gs!=statut.gameover)then
 			gs = statut.playermove
				sfx(9)
			end
		else 
			wait=1
		end	
	end	
end

function removeapt(type)
	if (type == typeinv.arm) then
		hapt.a -=1
		h.a = min(h.a,hapt.a)
	elseif (type == typeinv.force) then
		hapt.f -=1
		h.f = min(h.f,hapt.f)
	elseif (type == typeinv.move) then
		hapt.m -=1
		h.m = min(h.m,hapt.m)
		if(hapt.m==0) then ending(true) end
	end
end

function getnextinv(id,prev)
	repeat
		if(prev)then id-=1 
		else id+=1 end
		if(id>nbinv) then id=1 end
		if(id<1) then id=nbinv end
		if(inv[id]!=typeinv.gold) then return id end
	until (false)
end

function choosemar()
	if(tdisplay==nil)then
	 if(checkgold()==0) then
			tdisplay = t.nomoney
			sfx(11)
		else
			sfx(10)
		end
	end
	
	if(checkgold()==0) then
		if(btn(4) or btn(5)) then 
			gs = statut.playermove
			tdisplay = nil
		end
	else
		if(btn(4) or btn(5)) then
			-- valid select
			local firstgold =nil
			for i=1,#inv do
				if (inv[i] == typeinv.gold) then
					firstgold = i
					break
				end
			end
			sound =7
			score-=goldval
			
			if (marselect == 1) then
				inv[firstgold] = typeinv.arm
				hapt.a +=1
				h.a +=1
			elseif (marselect == 2) then
				inv[firstgold] = typeinv.force
				hapt.f +=1
				h.f +=1
			elseif (marselect == 3) then
				inv[firstgold] = typeinv.move
				hapt.m +=1
				h.m +=1
			else
				sound=9
				score +=goldval --take nothing, keep money
			end
			
			if(sound!=9) then
				grid[marchand.x][marchand.y] = false
				marchand = nil
			end
			
			gs = statut.playermove
			marselect = 1
			wait=1
			tdisplay=nil
			sfx(sound)
		else
 		-- select marchandise
 		local txt ={}
 		concat(txt,t.marchand)
 		wait=waitingtime
 		if(btn(2)) then marselect -=1
 		elseif(btn(3)) then marselect +=1 
 		else wait=0 end
 		
 		if(marselect>4) then marselect = 1 end
 		if(marselect<1) then marselect = 4 end
 		
			for i=1,4 do
				local linestart = " "
				if(i==marselect) linestart = ">"
				add(txt,"  "..linestart..t.marselect[i])
			end
			
			tdisplay = txt
 	end
		
	end
end

function updatedist()
	local gridd = getgridmov(h.x,h.y)

	for i=1,#ennemies do
		local e = ennemies[i]
		e.dist = gridd[e.x][e.y]
	end
	sortennemies()
end

function startennemiesturn()
	if(#ennemies==0)then starthturn()
	else
 	gs=statut.ennemiesmove
 	for i=1,#ennemies do
 		ennemies[i].m = ennemies[i].bm
 	end
		wait=waitennemies 	
 end
end

function moveennemies()
	local gridd = getgridmov(h.x,h.y)
	local move=false
	
	for i=1,#ennemies do
		local e = ennemies[i]
		if(e.m!=0) then
 		local p = {{x=e.x-1,y=e.y},
 			{x=e.x+1,y=e.y},
 			{x=e.x,y=e.y-1},
 			{x=e.x,y=e.y+1}}
 		local distmin=1000
 		local choose = {}
 		
 		for j=1,4 do
 			if(p[j].x>0 and p[j].x<=gridw
 						and p[j].y>0 and p[j].y<=gridh
 						and (grid[p[j].x][p[j].y]==false or grid[p[j].x][p[j].y]==h)) then
  			local dist = gridd[p[j].x][p[j].y]
  			if(dist==distmin or e.dist>e.vdist) then
  				add(choose,p[j])
  			elseif(dist<distmin) then
  				choose = {p[j]}
  				distmin=dist
  			end
  		end
 		end
  		
  	if(#choose!=0)then
  		e.m -=1
   	choose=choose[1+flr(rnd(#choose))]
   	if(distmin==0) then
   		attack(e,h)
   	else
   		sfx(e.sound)
   		setxy(e,choose.x,choose.y)
   		e.dist = gridd[e.x][e.y]
   	end
   	sortennemies()
   	move=true
 		end
 	if(move) then return true end
 	end
	end
	
	return move
end

function sortennemies()
	local sorted ={}
	
	for i=#ennemies,1,-1 do
		local e=ennemies[i]
		local p=1
		while (#sorted>=p and sorted[p].dist<e.dist) do
			p+=1
		end
		
		local temp={}
		for j=#sorted,p,-1 do
			add(temp,sorted[j])
			del(sorted,sorted[j])
		end
		
		add(sorted,e)
		
		for k=#temp,1,-1 do
			add(sorted,temp[k])
		end
	end
	
	-- set menu y
	for l=1,#sorted do
		sorted[l].my = offgridy+l*18-10	
	end
	
	ennemies=sorted
end

function attack(p1,p2)
	p2.a -= p1.f
	phurt = p2		
	add(animations,hurt)
	wait=10
	sfx(8)
end

function hurt()
	if (phurt==nil) then return false end
	if(wait%6>2) then
 	for i=1,15 do
 		pal(i,8)
 	end
 	
 	spr(phurt.sprite,offgridx+phurt.x*8,offgridy+phurt.y*8)
 	
 	pal()
	end
	if(wait==1)then 
		if(phurt.a<0) then
			if (phurt==h) then ending()
			else 
				del(ennemies,phurt)
				score+=1
				grid[phurt.x][phurt.y]=false
			end
		end
		phurt =nil
		return false 
	end
	return true
end

function drawperso(p)
	-- draw menu
	if(p.my<128-offhy-30)then
 	if(p!=h) then pal(15,6) end
 	spr(16,p.mx,p.my)
 	spr(16,p.mx+32,p.my,1,1,true)
 	spr(16,p.mx,p.my+8,1,1,false,true)
 	spr(16,p.mx+32,p.my+8,1,1,true,true)
 	
 	--line(p.mx+8,p.my,p.mx+32,p.my)
 	--line(p.mx+8,p.my+15,p.mx+32,p.my+15)
 	rectfill(p.mx+8,p.my,p.mx+32,p.my+15,5)
 	rectfill(p.mx+8,p.my+1,p.mx+32,p.my+14,15)
 	--sspr(p.sprite*8,0,8,8,p.mx+5,p.my+5,6,6,p.flipx)
 	pal()
 	spr(p.sprite,p.mx+5,p.my+4,1,1,p.flipx)
 	color(5)
 	cursor(p.mx+14,p.my+2)
 	print("a  f")
 	print("m")
 	
 	color(8)
 	cursor(p.mx+18,p.my+2)
 	local a = p.a
 	if(p.a<0) then print("‡ "..p.f)
 	else print(p.a.."  "..p.f) end
 	if(p!=h and p.m!=p.bm) then color(5) end
 	print(p.m)
	end			
	-- draw sprite
	spr(p.sprite,offgridx+p.x*8,offgridy+p.y*8)
end

function drawgrid()
	--rectfill(offgridx+5,offgridy+5,offgridx+gridw*8+10,offgridy+gridh*8+10,4)
	rectfill(offgridx+8,offgridy+8,offgridx+gridw*8+7,offgridy+gridh*8+7,6)
	for i=0,1 do
		local inv = false
		if(i==1) inv = true
		for x=1,gridw do
			for y=1,gridh do
				if (grid[x][y]!=false and band(fget(grid[x][y].sprite),0x1)!=0) then
					spr(grid[x][y].sprite,offgridx+x*8,offgridy+y*8)
				elseif((i+x+y)%2==1) then
					spr(33,offgridx+x*8,offgridy+y*8,1,1,inv)
				end
			end
		end
	end
	pal()
	spr(stairs.sprite,offgridx+stairs.x*8,offgridy+stairs.y*8)
	if(gold != nil) then spr(gold.sprite,offgridx+gold.x*8,offgridy+gold.y*8) end
	if(marchand != nil) then spr(marchand.sprite,offgridx+marchand.x*8,offgridy+marchand.y*8) end
end

function drawinv()
	for i=0,#inv-1 do
		if(i+1==idselect)then
			spr(48,offinvx+(i%9)*8+i,offinvy+(flr(i/9)*8)-8) 
			cursor(offinvx,offinvy+9)
			color(5)
			print(t.looseinv.t)
			print(t.looseinv[inv[i+1]])
			pal(1,8)
		end
			spr(17,offinvx+(i%9)*8+i,offinvy+(flr(i/9)*8))
			spr(inv[i+1],offinvx+(i%9)*8+i,offinvy+(flr(i/9)*8))
		if(i+1==idselect)then pal() end
	end
	
	--[[local g =getgridmov(h.x,h.y)
	for i=1,#g do
		for j=1,#g[i] do
			if(g[i][j]!=1000)then print(g[i][j],offgridx+i*8,offgridy+j*8) end
		end
	end]]
	
	--print("fps "..stat(7),5,100)
end

function animstairs()
	if(wait==0)then score+=2 return false end
	spr(stairs.sprite,offgridx+stairs.x*8,offgridy+stairs.y*8)
	local step = mid(flr(wait/10)*2,1,3)
	sspr(10,0,4,3+step,offgridx+stairs.x*8+5-step,offgridy+stairs.y*8+4-step)
	return true
end

function dialog(tarr,centerscreen)
	local offx = offgridx+8
	local offy = offgridy+8
	local htot = gridh*8
	local wtot = gridw*8
	if(centerscreen==true) then
		offx =0
		offy =0
		htot =128
		wtot = 128
	end
	local h = #tarr*8+8
	local y = offy+flr((htot-h)/2)
	
	local w = 0
	for i=1,#tarr do
		if(w<#tarr[i]) then w=#tarr[i] end
	end
	w= w*4+11
	local x = offx+((wtot-w)/2)
	--rectfill(x+4,y+4,x+w-4,y+h-4,5)
	--pal(15,6)
	rectfill(x+4,y,x+w-4,y+h-1,15)
	rectfill(x,y+4,x+w-1,y+h-4,15)
	line(x+4,y,x+w-4,y,5)
	line(x+4,y+h-1,x+w-4,y+h-1,5)
	line(x,y+4,x,y+h-4,5)
	line(x+w-1,y+4,x+w-1,y+h-4,5)
	
	spr(16,x,y)
	spr(16,x+w-8,y,1,1,true)
	spr(16,x,y+h-8,1,1,false,true)
	spr(16,x+w-8,y+h-8,1,1,true,true)
	color(5)
	for i=1,#tarr do
		cursor(x+6,y-3+i*8)
		print(tarr[i])
	end
	pal()
end

function ending(good)
	gs = statut.gameover
	local txt={}
	if(good==true)then
		concat(txt,t.goodending)
	else
		concat(txt,t.badending)
	end
	concat(txt,t.goldlevel[flr((1+checkgold())/2)+1])
	concat(txt,{"",t.score..score})
	concat(txt,t.xtorestart)
	tdisplay=txt
end

function concat(a1,a2)
	for i=1,#a2 do
		add(a1,a2[i])
	end
end

function checkgold()
	local nb =0
	for i=1,#inv do
		if(inv[i]==typeinv.gold) then
			nb+=1
		end
	end
	return nb
end

