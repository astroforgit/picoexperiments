--tools
function get_frame
(
	_ani,
	_speed,
	_t_override
)
	_t = t
	if _t_override != nil then
		_t = _t_override
	end

	return _ani
	[
			flr(
				_t / _speed
			) % #_ani + 1
	]
end

function draw_sprite
(
	_spr,
	_x,
	_y,
	_flip_x
)
	spr(_spr,_x,_y,1,1,_flip_x)
end

function direction (_x,_y)
	return {
		x = _x,
		y = _y
	}
end

function position (_x,_y)
	return {
		x = _x,
		y = _y
	}
end

function random_int (mn,mx)
	random=flr(rnd(abs(mn-mx)+1))
	return mn + random
end
-->8
--entity
entity = {
	instances = {},
	id = "unset",
	pos = position(0,0),
	pos_px = position(0,0),
	anim = {
		idle = { 48 }
	},
	anim_speed = 4,
	button_map = {},
	ai="",
	flipped=false,
	last_direction=0,
	health=1,
	speed=1,
	speedf=0.75,
	text="",
	effect=function () end,
	effect_cooldown=2,
	effect_cooldown_cur=0,
	effect_self=false,
	effect_timeout=function () end,
	timeout=0,
	t_self=0
}

function entity:new(o)
	o = o or {}

	setmetatable(o, self)
	self.__index = self

	return o
end

function entity:get_instance(id)
	for _obj in 
		all(self.instances) do
		if _obj.id == id then
			return _obj
		end
	end
	
	return "not found"
end

function entity:move 
(
	direction
)
	_entity = 
		self

	if abs(_entity.pos_px.x) <= 1 and
	  	abs(_entity.pos_px.y) <= 1 then
				
		if direction.x != 0 and
					direction.y != 0 then
			direction.y = 0
		end
		
		_entity.last_direction = 0
		if direction.y != 0 then
			_entity.last_direction = 1
		end
		
		if direction.x < 0 then
			_entity.flipped=true
		elseif direction.x > 0 then
		 _entity.flipped=false
		end
		
		_target_pos = position(
			_entity.pos.x +
			 direction.x,
			_entity.pos.y +
				direction.y
		)
		
		_map_tile =
			mget(
				_target_pos.x,
				_target_pos.y
			)
			
		if 
			not fget(_map_tile, 7) and
 		not fget(_map_tile, 1) and
 		not fget(_map_tile, 0)
		then
		
			entity_collide=false
			for gameobject in
				all(entities.instances) do
				if 
					gameobject.pos.x == 
						_target_pos.x
				and
					gameobject.pos.y ==
						_target_pos.y then
						if gameobject.id !=
							_entity.id then
						 entity_collide=true
						 if gameobject.text != "" then
						 	if _entity.id == "player" then
						 	 status_msg = gameobject.text
						 	end
						 end
						 if gameobject.effect then
							 if gameobject.effect_cooldown_cur <= 0 then
								 if not gameobject.effect_only_player or
								 	_entity.id == "player" then
 								 if gameobject.effect_self then
	 							  gameobject.effect(gameobject)
		 						 else
			 					  gameobject.effect(_entity)
				 			 	end
							 	 gameobject.effect_cooldown_cur =
									   gameobject.effect_cooldown
							 	end
							 end
							end
						end
				end
			end
			
			if not entity_collide then
  	_entity.pos.x += direction.x
  	_entity.pos.y += direction.y
		
			_entity.pos_px.x = 
				-direction.x * to_px
				
			_entity.pos_px.y =
				-direction.y * to_px
			end
		end
	end
end

function entity:ai_move
(
	id,
	ai_type
)
	_entity =
	 self:get_instance(id)
	
	if _entity == "not found" then
	 return
	end
	
	if _entity.ai == "simple" then
	 _entity:move(
	  direction(
				random_int(-1,1),
				random_int(-1,1)
			)
	 )
	end
	
	if _entity.ai == "follow_player" then
		_dir_x = 0
		_dir_y = 0
		
		if _entity.pos.x < player.pos.x then
			_dir_x = random_int(0,1)
		elseif _entity.pos.x > player.pos.x then
		 _dir_x = random_int(-1,0)
		end
		
		if _entity.pos.y < player.pos.y then
			_dir_y = random_int(0,1)
		elseif _entity.pos.y > player.pos.y then
		 _dir_y = random_int(-1,0)
		end
		 
		_entity:move(
	  direction(
				_dir_x,
				_dir_y
			)
	 )
	end
end

function entity:calculate (id)
	_entity =
		self:get_instance(id)
		
	if _entity == "not found" then
		return
	end
	
	if _entity.t_self >= 120 then
		_entity.t_self = 0
	end
	
	_entity.t_self += 1
		
	if _entity.pos_px.x > 0 then
		_entity.pos_px.x -= _entity.speed
	end
	
	if _entity.pos_px.x < 0 then
		_entity.pos_px.x += _entity.speed
	end
	
	if _entity.pos_px.y > 0 then
		_entity.pos_px.y -= _entity.speed
	end
	
	if _entity.pos_px.y < 0 then
		_entity.pos_px.y += _entity.speed
	end
	
	if _entity.effect_cooldown_cur > 0 then
		_entity.effect_cooldown_cur -= 0.1
	end
	
	if _entity.timeout > 0 then
		if _entity.t_self % 30 == 0 then
			_entity.timeout -= 1
			if _entity.timeout <= 0 and
				_entity.effect_timeout then
				_entity.effect_timeout(_entity)
			end
		end
	end
end

function entity:get_input (id)
	_entity =
		self:get_instance(id)
		
	_button_map = 
		_entity.button_map

 for i=0,#_button_map-1 do
	 if 
		 btn(i)
	 then
	 	_button_map[i+1]()
	 end
 end
end

function entity:draw (id)
	_entity = 
		self:get_instance(id)
		
	if _entity == "not found" then
		return
	end
		
	if abs(_entity.pos_px.x) > 0 or
				abs(_entity.pos_px.y) > 0 then
		_anim=_entity.anim.walk
	else
		_anim=_entity.anim.idle
	end
	
	if _anim == nil then
		return
	end
	
	_speed = _entity.anim_speed
	_sprite =
	 get_frame(
	  _anim,_speed,_entity.t_self)
	
	draw_sprite(
		_sprite,
		_entity.pos.x * to_px 
			+ _entity.pos_px.x,
		_entity.pos.y * to_px
			+ _entity.pos_px.y,
		_entity.flipped
	)
end
-->8
--ui
function draw_ui_text (
	_text,
	_pos,
	_double,
	_color
)
	rf = 4
	af = 1
	
	if #_text % 2 == 1 then
		if _double then
			af=0
		end
	end
	
	if _double then
		rf*=2
	end

	rectfill(
		cam_pos.x +
		 _pos.x - 2,
		player_px_pos.y + _pos.y - 2,
		cam_pos.x + _pos.x +
			#_text * rf + af,
		player_px_pos.y + _pos.y + 7,
		5
	)
	
	rect(
		cam_pos.x + _pos.x - 2,
		player_px_pos.y + _pos.y - 2,
		cam_pos.x + _pos.x +
			#_text * rf + af,
		player_px_pos.y + _pos.y + 7,
		2
	)

	print(
		_text,
		cam_pos.x + _pos.x + 1,
		player_px_pos.y + _pos.y + 1,
		2
	)
	
	if not _color then
		_color=15
	end
	
	print(
		_text,
		cam_pos.x + _pos.x,
		player_px_pos.y + _pos.y,
 	_color
 )
end
-->8
--other
function spawn_flame_effect (spawn_pos)
 flame_effect = entity:new()
	flame_effect.id = "flame_effect"..random_int(0,1000)
			
	add(
		entities.instances,
		flame_effect)
				
	flame_effect.pos = spawn_pos
	flame_effect.pos_px = position(0,0)
				
 flame_effect.anim = {}
 flame_effect.anim.idle = effects[1].anim_idle
 flame_effect.anim_speed = 
 	random_int(effects[1].anim_speed_rng[1], effects[1].anim_speed_rng[2])
 
 
 flame_effect.timeout = effects[1].timeout
 flame_effect.effect_timeout = effects[1].effect_timeout
end
