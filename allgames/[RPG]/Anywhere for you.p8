pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
function _init()
	game_title="anywhere for you"
 game_over_title="you weren't remembered."
	
	t=0
	t2=60
	
	to_px=8
 debug=false

	_upd=update_menu
	_drw=draw_startscreen	

	music(9)
end

function load_game()
 start_game()
 
	_upd=update_game 
 _drw=draw_game

	reload(0x2000,0x2000,0x1000)

	music(1)
end

function _update()
	update_t()
 _upd()
end

function _draw()
	_drw()
end

function start_game()
	t=1
	
	death_timer_max=150
	death_timer=0
	flowers_collected=0
	shifted_worlds=0
	all_flowers=false
 
 status_msg="you feel a light breeze"
 	
 cam_pos = position(0,0)
 player_px_pos = position(0,0)
 	
 light_rect=
 {
 	x=45,
 	y=50,
 	w=20,
 	h=30
 }
 
 light=
 {
 	x=0,
 	y=0,
 	w=0,
 	h=0
 }
 
 light_anim=0
 light_radius=120
 light_radius_cur=120
 
 entities = entity:new()
 entities.instances = {}
  	
 entities.id = "all"
  
 player = entity:new()
 player.id = "player"
 
	add(entities.instances,player)

	player.pos = position(3,4)
	player.pos_px = position(0,0)
 
 player.health = 5
 player.damage = 1
 
 player.anim = {}
 
	player.anim.walk = 
	 {48,49,50,51}
		
	player.anim.idle = 
	 {48}
		
	player.anim_speed = 4
	
	player.effect =
		function(target)
		 player.health -= 1 end
	
	player.button_map = {}
	
	player.button_map[1] =
		function () 
		player:move(
			direction(-1,0)) end
		
	player.button_map[2] =
		function ()
		player:move(
			direction(1,0)) end
		
	player.button_map[3] =
		function ()
		player:move(
			direction(0,-1)) end
		
	player.button_map[4] =
		function ()
		player:move(
			direction(0,1)) end
			
	objects={
		{
			id="bonfire",
			anim_idle=
				{144,145,146,147},
			anim_walk={},
			anim_speed_rng={6,6},
			ai="",
			probability=100,
			text="pain and darkness fades away.",
			effect = function(target)
			 if target.health < 5 then
			 	target.health +=1 end
			 if death_timer > 10 then
			 	death_timer -= 10 end end
		},
		{
			id="flowers",
			anim_idle={160},
			anim_walk={},
			anim_speed_rng={2,2},
			ai="",
			probability=100,
			text="these are nice flowers.",
			effect=function(target)
					target.anim.idle={162}
					flowers_collected += 1
					target.effect = nil end,
			effect_self=true,
			effect_only_player=true
		},
		{
			id="blob",
			anim_idle={176,177},
			anim_walk={},
			anim_speed_rng={8,8},
			ai="",
			probability=40,
			text="this is disgusting."
		}
	}
	
	effects={
		{
			id="fire",
			anim_idle=
			{130,131,132,133,134,
				135,136,137,138,139,
				140},
			anim_walk={},
			anim_speed_rng={6,6},
			probability=100,
			timeout=2,
			effect_timeout = function (self)
				del(
					entities.instances,
				 self) end
		}
	}
	
	enemies={
		{
			id="squid",
			anim_idle=
				{128},
			anim_walk=
				{128,129},
			anim_speed_rng={4,4},
			ai="follow_player",
			probability=100,
			text="i dont feel so good.",
			effect = function(target)		
			 	target.health -= 1 end,
			timeout=10,
			effect_timeout= function(self)
				spawn_flame_effect(self.pos)
				del(
					entities.instances,
				 self) end
		},		
		{
			id="frog",
			anim_idle=
				{141,142,141,143},
			anim_walk=
				{141,142,141,143},
			anim_speed_rng={4,4},
			ai="follow_player",
			probability=100,
			text="i dont feel so good.",
			effect = function(target)		
			 	target.health -= 1 end,
			timeout=5,
			effect_timeout= function(self)
				spawn_flame_effect(self.pos)
				del(
					entities.instances,
				 self) end
		}
	}
	
	bonfire = entity:new()
	bonfire.id = "bonfire"
		add(
			entities.instances,
			bonfire)
			
	bonfire.pos = position(7,5)
	bonfire.pos_px = position(0,0)
	
	bonfire.anim = {}
	bonfire.anim.idle =
	 objects[1].anim_idle
	 
	bonfire.anim.walk =
		objects[1].anim_walk
		
	bonfire.anim_speed = 6
	
	bonfire.text = objects[1].text
	bonfire.effect = objects[1].effect

	gravestone = entity:new()
	gravestone.id = "gravestone"
	
	add(
		entities.instances,
		gravestone)
		
	gravestone.pos = position(3,3)
	gravestone.pos_px = position(0,0)

	gravestone.anim = {}
	gravestone.anim.idle = {161}
	
	gravestone.text = "i miss you so much."

	flowers = entity:new()
	flowers.id = "flowers"
	
	add(
		entities.instances,
		flowers)
		
 flowers.pos = position(2,4)
	flowers.pos_px = position(0,0)

	flowers.anim = {}
	flowers.anim.idle = {163}
	
	flowers.text = "i need to collect more flowers."
	
	flowers.effect = function (target)
			if flowers_collected >= 10 then
				all_flowers=true
			end
		end
	
	hint_a = entity:new()
	hint_a.id = "hint_a"
	
	add(
		entities.instances,
		hint_a)
		
	hint_a.pos = position(8,3)
	hint_a.pos_px = position(0,0)
	
	hint_a.anim = {}
	hint_a.anim.idle = {167}
	
	hint_a.text = "run away and they will perish."
	
	hint_b = entity:new()
	hint_b.id = "hint_b"
	
	add(
		entities.instances,
		hint_b)
		
	hint_b.pos = position(9,3)
	hint_b.pos_px = position(0,0)
	
	hint_b.anim = {}
	hint_b.anim.idle = {168}
	
	hint_b.text = "keep walking towards the fire."

	hint_c = entity:new()
	hint_c.id = "hint_c"
	
	add(
		entities.instances,
		hint_c)
		
	hint_c.pos = position(7,3)
	hint_c.pos_px = position(0,0)
	
	hint_c.anim = {}
	hint_c.anim.idle = {182}
	
	hint_c.text = "the stone restores the world."

	reset_stone = entity:new()
	reset_stone.id = "reset_stone"
	
	add(
		entities.instances,
		reset_stone)
	
	reset_stone.pos = position(11,2)
	reset_stone.pos_px = position(0,0)
	
	reset_stone.anim = {}
	reset_stone.anim.idle = {178}
	
	reset_stone.text = "the world has shifted."

	reset_stone.effect = function ()
			for gameobject in all(entities.instances) do
				if gameobject.id != "player" and
							gameobject.id != "hint_a" and
							gameobject.id != "hint_b" and
							gameobject.id != "hint_c" and
							gameobject.id != "gravestone" and
							gameobject.id != "flowers" and
							gameobject.id != "bonfire" and
							gameobject.id != "reset_stone" then
	    del(entities.instances, gameobject)
				end
			end
	 	reload(0x2000,0x2000,0x1000)
	 	shifted_worlds += 1
	 end

 spawn_entities()
end

function spawn_entities()
 for i=0,1239 do
		target_pos=position(0,0)
		
		target_pos.y = flr(i / 15)
	 target_pos.x = i -
	 	(target_pos.y * 15)
	 	
	 target_pos.y += player.pos.y - 8
	 target_pos.x += player.pos.x - 7
	 
		_map_tile=mget(
			target_pos.x,
			target_pos.y
		)
		
		if _map_tile == 1 or
					_map_tile == 2 then
  
  	spawn_source=objects
   if _map_tile == 2 then
	  	spawn_source=enemies
	  end
	   
	  obj_i=
	  	spawn_source[
	  		random_int(
	   			1,
	   			#spawn_source
	    )
	   ]
	   
	  mset(
	  	target_pos.x,
	  	target_pos.y,
	  	0)
	  	
	  if random_int(0,100) > obj_i.probability then
	  	return
	  end
   
   obj = entity:new()
	  obj.id = obj_i.id.."_"..i
	
	  add(
		  entities.instances,
	   obj
	  )
	
			obj.pos=target_pos
		 obj.pos_px=position(0,0)
	 
	  obj.anim = {}
	
	  obj.anim.idle = 
	  	obj_i.anim_idle
	  
	  obj.anim.walk =
	  	obj_i.anim_walk
	  		
	  obj.anim_speed =
	  	random_int(
	  		obj_i.anim_speed_rng[1],
	  		obj_i.anim_speed_rng[2]
	  	)
	  
	  obj.ai = obj_i.ai
	  obj.text = obj_i.text
	  obj.effect = obj_i.effect
			obj.effect_self = obj_i.effect_self
	 	obj.effect_only_player = obj_i.effect_only_player
	 
	 	obj.timeout = obj_i.timeout
	 	obj.effect_timeout = obj_i.effect_timeout
	 end
	end
end


-->8
--updates
function update_t()
	t+=1
	t2+=1
 	
	if t > 120 then
		t=1
	end
	
	if t2 > 120 then
		t2=1
	end
end

function update_game()	
	if t % 30 == 0 then
	 death_timer += 4
	 spawn_entities()
	end

	if death_timer >= death_timer_max + 25 or
		player.health <= 0 or
		shifted_worlds >= 7 then
		_upd=update_menu
		_drw=draw_gameover
		music(0)
		return
	end
	
	if all_flowers then
		_upd=update_menu
		_drw=draw_end
		music(10)
		return
	end

 for game_object in
		all(entities.instances) 
	do
		entities:get_input(
			game_object.id)
			
		entities:calculate(
		 game_object.id)
		
		update_light_radius()
		
		if t % 5 == 0 then
			entities:ai_move(game_object.id)
		end
	end
end

function update_menu()
	if btn(5) then
		load_game()
	end
end

function update_light_radius()
	light_radius =
	 	death_timer_max - death_timer
	
	if light_radius_cur <
		light_radius then
		 light_radius_cur += 0.2
	end
		
	if light_radius_cur >
		light_radius then
			light_radius_cur -= 0.2
	end
	
	light={
		x=light_rect.x - light_radius_cur,
		y=light_rect.y - light_radius_cur / 2,
		w=light_rect.w + light_radius_cur,
		h=light_rect.h + light_radius_cur
	}
end
