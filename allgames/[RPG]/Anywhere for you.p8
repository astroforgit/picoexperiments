--draws
function draw_game()
 cls(0)
 
	draw_map()
	draw_entities()
		
	player_px_pos =
  position(
   player.pos.x * to_px
		 + player.pos_px.x - 64,
		 player.pos.y * to_px
		 + player.pos_px.y - 64
		)
		 	
	camera(
		player_px_pos.x,
	 player_px_pos.y)	

	cam_pos.x = 
		peek(0x5f28) 
		+ peek(0x5f29) * 256
	cam_pos.y =
		peek(0x5f2a)
		+ peek(0xf2b) * 256
	
	draw_lights()
	
 draw_ui()
	draw_debug()

	entities:draw("player")
end

function draw_ui()
 draw_ui_text(
		game_title,
		position(2,2))
	
	hearts=""
	for i=1,player.health do
		hearts=hearts.."‡"
	end
	
	draw_ui_text(
		hearts,
		position(
			128 - #hearts * 8 - 2,
			2
		),
		true,
		8
	)
	
	draw_ui_text(
		status_msg,
		position(
			64 - #status_msg * 2,
		 14)
		)
	
	draw_ui_text(
		flowers_collected.." flowers",
		position(2,119))
end

function draw_debug()
 if debug then
 	draw_ui_text(
		 player.pos.x.." "..
		 player.pos.y.." "..
		 cam_pos.x.." "..
		 cam_pos.y.." "..
		 player_px_pos.x.." "..
		 player_px_pos.y,
		 position(2,108))
	end
end

function draw_entities()
	clip_boundary()
	for game_object in
		all(entities.instances)
	do	
		if game_object.id != "player" then
		 entities:draw(
	 		game_object.id)
		end
	end
	clip()
end

function draw_map()
	clip_boundary()
	map()
	clip()
end

function clip_boundary()
	clip(
 	light.x,
 	light.y,
 	light.w * 2,
 	light.h
 )
end

function draw_lights()
	if seconds == 300 then
		return
	end
	
	color(0)
	if t % 8 == 0 then
		if light_anim == 5 then
			light_anim = 0
		else
	 	light_anim+=1
		end
	end
	
 if light_anim == 0 then
	 fillp(0b1010001010101010.1)
	elseif light_anim == 1 then 
		fillp(0b0010101010001010.1)
 elseif light_anim == 2 then
  fillp(0b0101010101010101.1)
 elseif light_anim == 3 then
  fillp(0b0111011101011101.1)
 elseif light_anim == 4 then
  fillp(0b1010101010101010.1)
 elseif light_anim == 5 then
  fillp(0b0101110101110101.1)
 end
	
	rectfill(
		cam_pos.x + light.x,
		player_px_pos.y + light.y,
		cam_pos.x + light.x
		 + light.w / 4,
		player_px_pos.y + light.y
		 + light.h
	)
	rectfill(
		cam_pos.x + light.x
		 + light.w * 2,
		player_px_pos.y + light.y,
		cam_pos.x + light.x
		 + light.w * 1.75,
		player_px_pos.y + light.y
			+ light.h
	)
	rectfill(
		cam_pos.x + light.x
			+ light.w * 1.75,
		player_px_pos.y + light.y,
		cam_pos.x + light.x
			+ light.w / 3 - 1,
		player_px_pos.y + light.y
		 + light.h / 8
 )
 rectfill(
		cam_pos.x + light.x
			+ light.w * 1.75,
		player_px_pos.y + light.y
		 + light.h,
		cam_pos.x + light.x
			+ light.w / 3 - 1,
		player_px_pos.y + light.y
		 + light.h * 0.9
 )
	fillp()
end

function draw_gameover()
	cls(0)
	camera(0,0)

	cam_pos = position(0,0)
	player_px_pos = position(0,0)
	
	game_over_icon=16
	game_over_msg=game_over_title
	if player.health == 0 then
		game_over_msg="you were eaten."
		game_over_icon=128
	end
	if shifted_worlds >= 7 then
		game_over_msg="reality is broken."
		game_over_icon=178
	end
	
 draw_ui_text(
  game_over_msg,
	 position(24,82))
	
	draw_ui_text(
  "press x to restart.",
	 position(30,95),false,8)
	
	spr(game_over_icon,64,64)
end


function draw_startscreen()
	cls(0)
	camera(0,0)

	cam_pos = position(0,0)
	player_px_pos = position(0,0)
	
	move_effect_a = sin(t / 120) * 12
	move_effect_b = sin(t / 60) * 8
	move_effect_c = sin(t / 30) * 3
	move_effect_d = sin(t / 30) * 2
	move_effect_e = sin(t2 / 30) * 2
	
	col_pal={1,2,13}
	
	for i=1,64 do
		col_i = 5
		effect_choice=move_effect_d
		
		if i % 2 == 0 then
		 col_i = col_pal[random_int(1,#col_pal)]
			effect_choice=move_effect_d
		end
		
		pset_pos = position(
			i * 2 + effect_choice,
			i * 2 + effect_choice
		)
		
		fillp(0b1010101010101010.1)
		
		for u=0,60 do
			pset(
				u + pset_pos.x,
				u*2 - pset_pos.y,
			 col_i
			)
		end

		fillp()
	end

	spr(
	 179,
  20 + move_effect_a,
		-10 + move_effect_a + t * 1.2
 )
 
	spr(
	 179,
  60 + move_effect_b,
		-30 + move_effect_b + t * 1.3
 )
 
 spr(
	 179,
  90 + move_effect_b,
		-30 + move_effect_d + t2 * 1.3
 )
		
 draw_ui_text(
  game_title,
	 position(36 + move_effect_a,42),
	 false,
		7
	)
	
	draw_ui_text(
  "press x to start.",
	 position(34 + move_effect_c,55),
	 false,
	 8
	)
	
	if random_int(0,100) > 90 then
		fillp(0b0000111100001111.1)
	else
	 fillp(0b1111000011110000.1)
	end
	
	draw_ui_text(
  "made by odrez",
	 position(
	 	70,
	 	100),
	 false,
	 15
	)
	
	draw_ui_text(
  "for alakajam 8",
	 position(
	 	60,
	 	109),
	 false,
	 12
	)
end

function draw_end()
	cls(0)
	camera(0,0)

	cam_pos = position(0,0)
	player_px_pos = position(0,0)
	
	move_effect_a = sin(t / 120) * 12
	move_effect_b = sin(t / 60) * 8
	move_effect_c = sin(t / 30) * 3
	move_effect_d = sin(t / 30) * 2
	move_effect_e = sin(t2 / 30) * 2
	
	col_pal={8,9,5}
	
	for i=1,64 do
		col_i = 5
		effect_choice=move_effect_d
		
		if i % 2 == 0 then
		 col_i = col_pal[random_int(1,#col_pal)]
			effect_choice=move_effect_d
		end
		
		pset_pos = position(
			i * 2 + effect_choice,
			i * 2 + effect_choice
		)
		
		fillp(0b1010101010101010.1)
		
		for u=0,60 do
			pset(
				u + pset_pos.x,
				u*2 - pset_pos.y,
			 col_i
			)
		end

		fillp()
	end

	spr(
	 179,
  20 + move_effect_a,
		-10 + move_effect_a + t * 1.2
 )
 
	spr(
	 179,
  60 + move_effect_b,
		-30 + move_effect_b + t * 1.3
 )
 
 spr(
	 179,
  90 + move_effect_b,
		-30 + move_effect_d + t2 * 1.3
 )
		
 draw_ui_text(
  "they will always remember.",
	 position(
	 	15 + move_effect_d,42),
	 false,
		7
	)
	
	draw_ui_text(
  "press x to start again.",
	 position(
	 	20 + move_effect_c,
	 	55),
	 false,
	 8
	)
end
