function format_string(str,v)
 local os = ""
 local i=1
 while (i <= #str) do
  local c = sub(str,i,i)
  if (c == "$") then
   i+=1
   local nc = sub(str,i,i)
   if ((ord(nc) < 0x31) or (ord(nc) > 0x39)) return "$index error"
   local ci = ord(nc) - 0x30
   os = os .. v[ci]
   i+=1
  else
   os = os .. c 
   i += 1
  end --if
 end --for
 return os
end
