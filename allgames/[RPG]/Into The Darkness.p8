__lua__
game={}

function _init()
	--loads first state

			cartdata("rob_intodarkness_1")
			state_init()
	  characterselect()
			biggold=0
			biggold=dget(0)

end

function _update()
	game.update()
end

function _draw()
	game.draw()
end




