	waters=0
	spikes=0
	chest=0
	enemy1=0
	enemy2=0
	enemy3=0
	wpn1=0
	wpn2=0
	wpn3=0

	if floor<10 then
		waters=flr(rnd(3)) +1
		spikes=flr(rnd(3)) +1
		enemy1=flr(rnd(4)) +1
		if flr(rnd(2))==0 then
			chest=1
		end
		if flr(rnd(9-floor)) > 1 then
			enemy2=flr(rnd(2))+1
		end
		if flr(rnd(9-floor)) <2 then
			wpn2=flr(rnd(1))+1
		end
		if flr(rnd(9))==0 then
			wpn2=1
		end
	elseif floor<20 then
		waters=max(flr(rnd(3))+1,3)
		spikes=max(flr(rnd(3))+1,3)
		enemy1=flr(rnd(2)) +1
		enemy2=flr(rnd(3)) +2
		wpn1=flr(rnd(1)) +1
		wpn2=flr(rnd(2)) +1
		if flr(rnd(19-floor)) <5 then
			wpn3=flr(rnd(1))+1
		end
		if flr(rnd(19-floor)) <2 then
			enemy3=flr(rnd(1))+1
		end
		chest=flr(rnd(1))+1
	else
		waters=max(flr(rnd(4))+1,3)
		spikes=max(flr(rnd(4))+1,3)
		enemy2=flr(rnd(3))+3
		enemy3=flr(rnd(2))+2
		wpn2=flr(rnd(1))+1
		wpn3=flr(rnd(2))+1
		chest=2
	end
if waters>0 then
 wateri=0
	repeat
		ry=(flr(rnd(3))+1) *3
		rx=(flr(rnd(5))+1)*2
		if mget(rx,ry)==1 then
			mset(rx,ry,6)
			mset(rx,ry-1,23)
			mset(rx+1,ry,6)
			mset(rx+1,ry-1,23)
			wateri+=1
		end
	until wateri == waters
end

if spikes>0 then
	spikei=0
	repeat
		ry=(flr(rnd(3))+1) *3
		rx=(flr(rnd(5))+1)*2
		if mget(rx,ry)==1 then
			mset(rx,ry,5)
			mset(rx,ry-1,21)
			spikei+=1
		end
	until spikei == spikes
end

if chest>0 then
chesti=0
repeat
	ry=(flr(rnd(3))+1) *3
	rx=1
	mset(rx,ry-1,194)
	chesti+=1
until chesti == chest
end

if enemy1>0 then
enemy1i=0
repeat
	ry=(flr(rnd(3))+1) *3
	rx=(flr(rnd(5))+1)*2
	if mget(rx,ry)==1 then
		mset(rx,ry,2)
		mset(rx,ry-1,es1())
		enemy1i+=1
	end
until enemy1i == enemy1
end

if enemy2>0 then
enemy2i=0
repeat
	ry=(flr(rnd(3))+1) *3
	rx=(flr(rnd(5))+1)*2
	if mget(rx,ry)==1 then
		mset(rx,ry,2)
		mset(rx,ry-1,es2())
		enemy2i+=1
	end
until enemy2i == enemy2
end

if enemy3>0 then
enemy3i=0
repeat
	ry=(flr(rnd(3))+1) *3
	rx=(flr(rnd(5))+1)*2
	if mget(rx,ry)==1 then
		mset(rx,ry,2)
		mset(rx,ry-1,es3())
		enemy3i+=1
	end
until enemy3i == enemy3
end

if wpn1>0 then
wpn1i=0
repeat
	ry=(flr(rnd(3))+1) *3
	rx=(flr(rnd(5))+1)*2
	if mget(rx,ry)==1 then
		mset(rx,ry,2)
		mset(rx,ry-1,w1())
		wpn1i+=1
	end
until wpn1i == wpn1
end

if wpn2>0 then
wpn2i=0
repeat
	ry=(flr(rnd(3))+1) *3
	rx=(flr(rnd(5))+1)*2
	if mget(rx,ry)==1 then
		mset(rx,ry,2)
		mset(rx,ry-1,w2())
		wpn2i+=1
	end
until wpn2i == wpn2
end

if wpn3>0 then
wpn3i=0
repeat
	ry=(flr(rnd(3))+1) *3
	rx=(flr(rnd(5))+1)*2
	if mget(rx,ry)==1 then
		mset(rx,ry,2)
		mset(rx,ry-1,w2())
		wpn3i+=1
	end
until wpn3i == wpn3
end


end
-->8
--gameover screen
function gameover()
	if character=="royal" then
	biggold=gold
	else
	biggold+=gold
	end
	dset(0,biggold)
	game.update=gameover_update
	game.draw=gameover_draw
end

function gameover_update()
	if btn(ƒ) then
		characterselect()
	end
end

function gameover_draw()
	cls()
	print("you perished in the darkness", grid(1), grid(6),7)
	print("last floor: "..floor, grid(5), grid(7),0)
	print("gold: ".. gold, grid(5), grid(8),10)
	print("restart ƒ", grid(5), grid(13),11)

end


--character select
function characterselect()
	game.update=characterselect_update
	game.draw=characterselect_draw
	charchoose=0
	sprite=129
	unlockcost=0
	wait=0
	hold=0
	if dget(3)==1 then
	health=30+dget(2)
	else health=30
	end
end

function characterselect_update()
	canpick=true
	

	if charchoose==0 then
		canpick=true
		character="clerk"
		banish()
		bridge()
		bless()
		sprite=129
	elseif charchoose==1 then
		if dget(1)>=1 then
		canpick=true
		sprite=131
	else
		canpick=false
		sprite=165
		unlockcost=200
		end
		character="druid"

		eagle()
		focus()
		shift()
	elseif charchoose==2 then
		if dget(1)>=2 then
			canpick=true
			sprite=130
		else
			canpick=false
			sprite=165
			unlockcost=500
		end
		character="magus"

		drain()
		ritual()
		reach()
	elseif charchoose==3 then
		if dget(1)>=3 then
			canpick=true
			sprite=132
		else
			canpick=false
			sprite=165
			unlockcost=1000
		end
		character="royal"

		bargain()
		invest()
		fortify()
	end
	if wait>30 then
	if btn(3) then
		if canpick then
		state()
		elseif biggold >= unlockcost then
		if charchoose==1 then
			biggold -= unlockcost
			dset(0,biggold)
			dset(1,1)
			sprite=131
			canpick=true
			wait=0
		elseif charchoose==2 then
				biggold -= unlockcost
				dset(0,biggold)
				dset(1,2)
				sprite=130
				canpick=true
				wait=0
	elseif charchoose==3 then
			biggold -= unlockcost
			dset(0,biggold)
			dset(1,3)
			sprite=132
			canpick=true
			wait=0
	end
	end
	end
else wait+=1
end
	if hold>2 then
	if btn(0) then
		if charchoose>0 then
			charchoose-=1
		end
	end
	if btn(1) then
		if charchoose<3 then
			charchoose+=1
		end
	end
	if btn(”) then
		if canpick then
		if biggold>=50 then
			health+=1
			biggold -= 50
			dset(3,1)
			dset(0,biggold)
			val+=1
			dset(2,health-30)
		end
	end
end
	hold=0
else hold+=1
end


end

function characterselect_draw()

	cls(13)
	print("into the darkness!", grid(3)+5, 15,8)
	print("choose your class:", grid(3)+5, grid(1+2),7)
	spr(sprite, grid(8)-3, grid(2+2))

	print("‹ "..character.. " ‘", grid(5)+2, grid(3+2)+1,7)

	print(skill1.n, grid(2), grid(4+2)+3,8)
	print(skill1.txt, grid(2), grid(5+2)+3,7)

	print(skill2.n, grid(2), grid(6+2)+3,8)
	print(skill2.txt, grid(2), grid(7+2)+3,7)

	print(skill3.n, grid(2), grid(8+2)+3,8)
	print(skill3.txt, grid(2), grid(9+2)+3,7)
	if canpick then
	print("start ƒ", grid(6), grid(12+3)-4,8)
	print("health ” 50g", grid(4)+4, grid(12+2)-10,10)
else print("unlock ƒ "..unlockcost.."g",grid(4)+4,grid(12+2)-10,10)
end
	print(biggold.."g", 4, 1,10)
	print("health: ".. health, grid(11)-4, 1,10)
end
