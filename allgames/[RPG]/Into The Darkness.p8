--box_hit()
function collide(e,o)
	--necessary vars from objects
	local x1=e.x
	local y1=e.y
	local w1=e.w
	local h1=e.h
	local x1=o.x
	local y1=o.y
	local w1=o.w
	local h1=o.h
	--return variable
	local hit=false
	--collision detection vars
	local xs=w1/2+w2/2
	local ys=h1/2+h2/2
	local xd=abs((x1+(w1/2))-(x2+(w2/2)))
	local yd=abs((y1+(h1/2))-(y2+(h2/2)))
	--checks distance b/w hitboxes
	if xd<xs and yd<ys then
		hit=true
	end

	return hit
end

function px2grid(o)
	--pixel xy -> grid xy
	return flr(o/8)
end

function grid(i)
	return i*8
end

-->8
--skills
--example skill trigger: skill1.cast()
function skillupd()
	cx=px2grid(cursor.x)
	cy=px2grid(cursor.y)
	if select==0 then
		skill1.upd()
	elseif select==1 then
		skill2.upd()
	elseif select==2 then
		skill3.upd()
	end
end
function banish()
	skill1={}
	skill1.n="banish"
	skill1.txt="kill lvl 1 enemy"
	skill1.s=146
	skill1.cast=function()
		if fget(mget(cx,cy),2) and fget(mget(cx,cy),3) then
				mset(cx,cy,0)
				p.f-=1
		end
	end
	skill1.upd=function()
		if fget(mget(cx,cy),2) and fget(mget(cx,cy),3) then
				cursor.s=144
		else cursor.s=145
		end
	end
end

function bridge()
	skill2={}
	skill2.n="bridge"
	skill2.txt="cover spikes or water"
	skill2.s=146
	skill2.cast=function()
			if fget(mget(cx,cy),1) then
					p.f-=1
					mset(cx,cy,0)
					mset(cx,cy+1,7)
					if fget(mget(cx-1,cy),1) then
					mset(cx-1,cy,0)
					mset(cx-1,cy+1,7)
					elseif fget(mget(cx+1,cy),1) then
					mset(cx+1,cy,0)
					mset(cx+1,cy+1,7)
					end
				elseif fget(mget(cx,cy),0) then
					p.f-=1
					mset(cx,cy,0)
					mset(cx,cy+1,8)
				end
	end
	skill2.upd=function()
		if fget(mget(cx,cy),1) or fget(mget(cx,cy),0) then
				cursor.s=144
		else cursor.s=145
		end
	end
end

function bless()
	skill3={}
	skill3.n="bless"


		skill3.txt="restore 5 health"

	skill3.s=146
	skill3.cast=function()
			if p.h<p.mh then
				p.f-=1
				p.h+=5
			end
			if p.h>p.mh then
			p.h=p.mh
			end
	end
	skill3.upd=function()
				cursor.s=0
	end
end

function shift()
	skill1={}
	skill1.n="shift"
	skill1.txt="convert forces to attack"
	skill1.s=146
	skill1.cast=function()
				p.tempattk+=p.f
				p.f-=p.f
				p.s=163
	end
	skill1.upd=function()
				cursor.s=0
		if p.tempattk == 0 then
			p.s=131
		end
end
end

function focus()
	skill2={}
	skill2.n="focus"
	skill2.txt="convert forces to health"
	skill2.s=146
	skill2.cast=function()
				if p.h < p.mh then
				p.h=min((p.h+(p.f*2)),p.mh)
				p.f-=p.f
			end
	end
	skill2.upd=function()
			cursor.s=0
			end
end

function eagle()
	skill3={}
	skill3.n="eagle"
	skill3.txt="fly above this lane"
	skill3.s=146
	skill3.cast=function()
				p.f-= p.f
				p.y-= grid(1)
				p.s=164
				p.eagle=true
	end
	skill3.upd=function()
			cursor.s=0
			end
end


function drain()
	skill1={}
	skill1.n="drain"
	skill1.txt="kill lvl 1 to heal"
	skill1.s=146
	skill1.cast=function()
		if fget(mget(cx,cy),2) and fget(mget(cx,cy),3) then

				if p.h<p.mh then
				mset(cx,cy,0)
				p.f-=1
				p.h+=flr(rnd(4)+4)
				if p.h> p.mh then
					p.h=p.mh
				end
				end
		end
	end
	skill1.upd=function()
		if fget(mget(cx,cy),2) and fget(mget(cx,cy),3) then
				cursor.s=144
		else cursor.s=145
		end
	end
end

function ritual()
	skill2={}
	skill2.n="ritual"
	skill2.txt="turn demon into weapon"
	skill2.s=146
	skill2.cast=function()
		if mget(cx,cy)==68 or mget(cx,cy)==70 or mget(cx,cy)==77 then
				mset(cx,cy,w3())
				p.f-=1
				end
	end
	skill2.upd=function()
		if mget(cx,cy)==68 or mget(cx,cy)==70 or mget(cx,cy)==77 then
				cursor.s=144
		else cursor.s=145
		end
	end
end

function reach()
	skill3={}
	skill3.n="reach"
	skill3.txt="open chest at a distance"
	skill3.s=146
	skill3.cast=function()
		if mget(cx,cy)==194 then
				mset(cx,cy,0)
				gold+=flr(rnd(floor*2))+1
				p.h+=min(flr(rnd(floor*2))+1, 10)
				if p.h>p.mh then
					p.h=p.mh
				end
				p.f-=1
				end
	end
	skill3.upd=function()
		if mget(cx,cy)==194 then
				cursor.s=144
		else cursor.s=145
		end
	end
end

function bargain()
	skill1={}
	skill1.n="bargain"
	skill1.txt="turn 10g into 10 health"
	skill1.s=146
	skill1.cast=function()
		if gold>= 10 and p.h<p.mh then
			gold-=10
			p.h+=10
			p.f-=1
			if p.h>p.mh then
			p.h=p.mh
			end
		end
	end
	skill1.upd=function()
			cursor.s=0
			end
end

function invest()
	skill2={}
	skill2.n="invest"
	skill2.txt="pay 30g to upgrade attack"
	skill2.s=146
	skill2.cast=function()
		if gold>= 30 then
			gold-=30
			p.tempattk+=1
			p.f-=1
			if p.h>p.mh then
			p.h=p.mh
			end
		end
	end
	skill2.upd=function()
			cursor.s=0
end
end

function fortify()
	skill3={}
	skill3.n="fortify"
	skill3.txt="pay 30g to upgrade health"
	skill3.s=146
	skill3.cast=function()
		if gold>= 30 then
			gold-=30
			p.mh+=1
			p.f-=1
			if p.h>p.mh then
			p.h=p.mh
			end
		end
	end
	skill3.upd=function()
			cursor.s=0
end
