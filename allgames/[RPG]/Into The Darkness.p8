--state

--sets the state
function state()
	state_init()
	game.update=state_update
	game.draw=state_draw
end

function state_init()
	floor=1
	--player variables
	p={}
	p.x=grid(14)
	p.y=grid(2)

	p.mh=health --maxhealth
	p.h=p.mh --health
	p.f=3 --forces
	p.mf=3 --max forces
	p.running=false
	p.rd=0
	p.cd=0
	p.weapon=false
	p.attk=0
	p.ws=0
	p.wet=0
	p.decay=0
	p.maxdecay=0
	p.wpnattk=0
	p.eagle=false
	p.wpnname=""
	p.tempattk=0
	alert=""
	sdelay=0
	cursor={}
	cursor.x=p.x
	cursor.y= 16
	cursor.s=144
	cx=px2grid(cursor.x)
	cy=px2grid(cursor.y)
	gold=0
	if character=="clerk" then ---initialize skills
			p.s=129 --player sprite
			p.baseattk=0
		banish()
		bridge()
		bless()
	end
	if character=="druid" then ---initialize skills
			p.s=131 --player sprite
			p.baseattk=1
		shift()
		focus()
		eagle()
	end

	if character=="magus" then ---initialize skills
			p.s=130 --player sprite
			p.baseattk=0
		reach()
		ritual()
		drain()
	end
	if character=="royal" then ---initialize skills
			p.s=132 --player sprite
			p.baseattk=0
		gold=biggold
		fortify()
		bargain()
		invest()
	end
	select=0
	newroom()
end



function state_update()
		if floor<10 then
	 p.mf=3
		elseif floor< 20 then
			p.mf=5
		elseif floor < 30 then
		 p.mf=8
		end

		if p.decay<1 then
			p.weapon=false
			p.wpnattk=0
		end
		if p.h<1 then
			gameover()
		end
	p.attk=p.baseattk + p.wpnattk + p.tempattk
	skillupd()
	skillupdate()

	if btn(4) then
		p.running=true
		alert=""
	end

	if sdelay==6 then
		sdelay=0
		---function start
		if btn(3) then
			if select <2 then
			select+=1
			else select=0
			end
		end

		if btn(2) then
			if select >0 then
			select-=1
			else select=2
			end
		end

		if btn(0) then
			if cursor.x > grid(1) then
				cursor.x-=grid(1)
			end
		end

		if btn(1) then
			if cursor.x < grid(14) then
				cursor.x += 8
			end
		end


	else sdelay+=1
	end
	----------------
	----------------
	go=function()
		if p.running then

			if p.rd==8 then
				p.rd=0
				p.x-=8


			if p.x==0 then
				if p.y==grid(8) then
					floor+=1
					if floor == 10 then
						p.mf=5
					elseif floor == 20 then
						p.mf=8
					end
					if character=="druid" then
					p.s=131
					end
					if p.eagle then
						p.eagle=false
						p.s=131
					end
					p.f=p.mf
					p.x=grid(14)
					p.y=grid(2)
					cursor.x=p.x
					cursor.y=p.y
					newroom()
					p.running=false
				else
					if p.eagle then
						p.eagle=false
						p.s=131
						p.y+=grid(1)
					end


				p.running=false
				p.x=grid(14)
				p.y+=grid(3)
				cursor.y=p.y
				end
			end

			if mget(px2grid(p.x),px2grid(p.y)) == 21 then
				trigger=true
				p.h-=flr(rnd(2))+1
				p.rd=-32
				alert="spikes damaged health!"
			end

			if fget(mget(px2grid(p.x),px2grid(p.y)),1 ) and character~="druid" then
				trigger=true
				if p.wet==1 then
					p.wet=0
					if p.f>0 then
						p.f-=flr(rnd(1))+1
						p.rd=-32
						alert="water drained forces!"
					else p.h-=flr(rnd(1))+1
						p.rd=-32
						alert="water drained health!"
					end
				else p.wet+=1
				end
		end

		if fget(mget(px2grid(p.x),px2grid(p.y)),7) then
			p.rd=-32
			gold+=flr(rnd(floor*2))+1
			p.h+=min(flr(rnd(floor*2))+1, 10)
			if p.h>p.mh then
			p.h=p.mh
			end
			mset(px2grid(p.x),px2grid(p.y), 0)
			alert="opened chest!"
		end

		if fget(mget(px2grid(p.x),px2grid(p.y)),2) and fget(mget(px2grid(p.x),px2grid(p.y)),3) then
			p.rd=-32
			if 2-p.attk>0 then
			p.h-=2-p.attk, 0
			end
			gold+=flr(rnd(3))+1
			p.h-= max(2-p.attk, 0)
			if p.weapon then
				p.decay-=1
			end
			if mget(px2grid(p.x),px2grid(p.y))== 64 then
				alert="defeated bones! (lvl1)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 65 then
				alert="defeated ghost! (lvl1)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 66 then
				alert="defeated slime! (lvl1)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 67 then
				alert="defeated skeev! (lvl1)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 68 then
				alert="defeated skimp! (lvl1)"
			end
			mset(px2grid(p.x),px2grid(p.y), 0)
		end

		if fget(mget(px2grid(p.x),px2grid(p.y)),2) and fget(mget(px2grid(p.x),px2grid(p.y)),4) then
			p.rd=-32
			if 4-p.attk>0 then
			p.h-= max(4-p.attk,0)
			end
			gold+=flr(rnd(3))+1
			if p.weapon then
				p.decay-=1
			end
			if mget(px2grid(p.x),px2grid(p.y))== 64 +5 then
				alert="defeated guard! (lvl2)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 65+5 then
				alert="defeated devil! (lvl2)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 66+5 then
				alert="defeated ghoul! (lvl2)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 67+5 then
				alert="defeated knight! (lvl2)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 68+5 then
				alert="defeated rogue! (lvl2)"
			end
			mset(px2grid(p.x),px2grid(p.y), 0)
		end

		if fget(mget(px2grid(p.x),px2grid(p.y)),2) and fget(mget(px2grid(p.x),px2grid(p.y)),5) then
			p.rd=-32
			if 6-p.attk>0 then
			p.h-= max(6-p.attk,0)
			end
			gold+=flr(rnd(3))+1
			if p.weapon then
				p.decay-=1
			end
			if mget(px2grid(p.x),px2grid(p.y))== 64+10 then
				alert="defeated troop! (lvl3)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 65+10 then
				alert="defeated wuurm (lvl3)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 66+10 then
				alert="defeated ohgre! (lvl3)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 67+10 then
				alert="defeated demon! (lvl3)"
			elseif mget(px2grid(p.x),px2grid(p.y))== 68+10 then
				alert="defeated whyte! (lvl3)"
			end
			mset(px2grid(p.x),px2grid(p.y), 0)
		end

		if fget(mget(px2grid(p.x),px2grid(p.y)),6) and fget(mget(px2grid(p.x),px2grid(p.y)),3) then
			p.rd=-32
			p.weapon=true
			p.wpnattk=1
			p.decay=2
			p.maxdecay=2

			if mget(px2grid(p.x),px2grid(p.y))== 224 then
				p.wpnname="wand"
				alert="picked up wand (lvl1)!"
			elseif mget(px2grid(p.x),px2grid(p.y))== 225 then
				p.wpnname="axe"
				alert="picked up axe (lvl1)!"
			elseif mget(px2grid(p.x),px2grid(p.y))== 226 then
				p.wpnname="dagger"
				alert="picked up dagger (lvl1)!"
			end
			mset(px2grid(p.x),px2grid(p.y), 0)
		end

		if fget(mget(px2grid(p.x),px2grid(p.y)),6) and fget(mget(px2grid(p.x),px2grid(p.y)),4) then
			p.rd=-32
			p.weapon=true
			p.wpnattk=3
			p.decay=3
			p.maxdecay=3

			if mget(px2grid(p.x),px2grid(p.y))== 227 then
				p.wpnname="sword"
				alert="picked up sword (lvl2)!"
			elseif mget(px2grid(p.x),px2grid(p.y))== 228 then
				p.wpnname="spear"
				alert="picked up spear (lvl2)!"
			elseif mget(px2grid(p.x),px2grid(p.y))== 229 then
				p.wpnname="staff"
				alert="picked up staff (lvl2)!"
			end
			mset(px2grid(p.x),px2grid(p.y), 0)
		end

		if fget(mget(px2grid(p.x),px2grid(p.y)),6) and fget(mget(px2grid(p.x),px2grid(p.y)),5) then
			p.rd=-32
			p.weapon=true
			p.wpnattk=5
			p.decay=4
			p.maxdecay=4

			if mget(px2grid(p.x),px2grid(p.y))== 230 then
				p.wpnname="warhammer"
				alert="picked up warhammer (lvl3)!"
			elseif mget(px2grid(p.x),px2grid(p.y))== 231 then
				p.wpnname="greatsword"
				alert="picked up greatsword (lvl3)!"
			elseif mget(px2grid(p.x),px2grid(p.y))== 232 then
				p.wpnname="sceptre"
				alert="picked up sceptre (lvl3)!"
			end
			mset(px2grid(p.x),px2grid(p.y), 0)
		end

	----------------
	else p.rd+=1
	end
	end
	----------------
	----------------

end
go()
end



function state_draw()
	cls(0)
	map(0,0)
	spr(p.s,p.x,p.y)
	print("floor ".. floor,0,0,7)
	drawstats()
	print(gold .."g", grid(13),0, 10)
	if p.running then
	print(alert,2,grid(11)-2,8)
	end
	if not p.running then
		if p.f==0 then
		print("press Ž to face what lies ahead",0,grid(11)-2,10)
		end
		drawcursor()
	end
end
function drawcursor()
	spr(cursor.s,cursor.x,cursor.y)
end
function drawstats()
	print("skills:",2,grid(12)+2,8)
	if select==0 then
		print(skill1.n .. " —",2,grid(12+1)+2, 0)
		print(skill2.n,2,grid(12+2)+2, 10)
		print(skill3.n,2,grid(12+3)+2, 10)
		if not p.running then
			if p.f>0 then
		print(skill1.txt,2,grid(11)-2,7)
	end
		end
 elseif select==1 then
		print(skill1.n,2,grid(12+1)+2, 10)
		print(skill2.n .. " —",2,grid(12+2)+2, 0)
		print(skill3.n,2,grid(12+3)+2, 10)
		if not p.running then
			if p.f>0 then
		print(skill2.txt,2,grid(11)-2,7)
	end
		end
	elseif select==2 then
		print(skill1.n,2,grid(12+1)+2, 10)
		print(skill2.n,2,grid(12+2)+2, 10)
		print(skill3.n .. " —",2,grid(12+3)+2, 0)
		if not p.running then
			if p.f>0 then
		print(skill3.txt,2,grid(11)-2,7)
	end
	end
	end
	print("health: " .. p.h.."/"..p.mh,grid(8),grid(12+1)+2,0)
	print("forces: " .. p.f.."/"..p.mf,grid(8),grid(12+2)+2,0)
	if p.weapon then
		print(p.wpnname.. " " .. p.decay.."/"..p.maxdecay,grid(8),grid(12)+2,0)
	end
	print("attack:"..p.attk ,grid(8),grid(12+3)+2,0)
end

function skillupdate()
	if sdelay==2 then
		---------functionstart
		if btn(5) then
			if p.f>0 then

				if select==0 then
					skill1.cast()
				elseif select==1 then
					skill2.cast()
				elseif select==2 then
					skill3.cast()
				end
			end
		end
			--------functionend
	else sdelay+=1
	end
end

