--level generation

function newroom()
		p.tempattk=0

		mset(2,3,1)
		mset(3,3,1)
		mset(4,3,1)
		mset(5,3,1)
		mset(6,3,1)
		mset(7,3,1)
		mset(8,3,1)
		mset(9,3,1)
		mset(10,3,1)
		mset(11,3,1)
		mset(12,3,1)
