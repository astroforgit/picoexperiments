--states!

-- game_start
function update_gamestart()

 if (btn(—)) init_game()
end

function draw_gamestart()
  camera()
  cls(0)
  map(0,48,0,0)
  	print("\n\n\n\n\n press x or — to start",18,25,12)

 	print("by yulia bagel\n    enjoy",34,106,12)
end

-- game_run

function init_game()
  state=0
  t=0
  text=1
  timee=0
  r=1
  map_var()
  init_slimes()
  init_bounce()
  player_var() 
  init_ghosts()
  init_bghosts()
  ui_var()
  init_msg()
  reading=false
  gradius=false
 end
  
function update_game()
   t+=1 
  if state==0 then 
  if gradius==false and (r<(5*8)) then
   r+=1.5 
  end
  end
  if state==4 then
   
  if gradius==false and (r<(8*8)) then
   r+=1.5 
  end
  end
    --for offset
   move_player()
  if not reading==true then
   move_slimes()
  --if knum>=1 then move_ghosts() 
--  end 
  if (btnp(”)) or (btnp(ƒ)) or (btnp(‹)) or (btnp(‘)) then

   move_bounce()
   end
  end
  
   call_msg()
   update_msg()
 end
 
function draw_game()
   cls()
  draw_map()
  draw_slimes()
  draw_bounce()
  draw_player()
  draw_ghosts()
  draw_bghosts()
  if state==0 then
  invcircfill(r,0)
  end
  
  if state==4 then
  invcircfill(r,0)
  end
  draw_stats()
  draw_msg()
  if state==3 and cnum==0 then
   state=6
   end
 end 
  
-- game_over

function update_gameover()
  if (btn(—)) then
  init_game()
  end
end

function draw_gameover()
  camera()
  cls(0)
 	print("you lost\nx or — to start over",25,25,8)
end

-- game_won

function update_gamewon()
  if (btn(—)) then
  init_game()
  end
end

function draw_gamewon()
  camera()
  cls(0)
 	print("you paid the fee and charon\nlet you across the river\npress — to restart the game\nand discover a new ending",10,40,12)
end

--- ghost



function update_ghost()
   t+=1 
  if not gradius==true and (r<(80*8)) then
   r+=1.5 
  end
    --for offset
   move_player()
 --  move_ghosts() 
   move_bghosts()
   call_msg()
   update_msg()
   if cnum==0 then
   state=6
   end
end

function draw_ghost()
  cls()
  draw_map()
--  draw_slimes()
--  draw_bounce()
  draw_player()
  draw_bghosts()
 -- invcircfill(r,0)
  draw_stats()
  draw_msg()
end

----
-- state 6

function update_ghostover()
  if (btn(—)) then
  init_game()
  end
end

function draw_ghostover()
  camera()
  cls(0)
 	print("you have returned the\ncoin you stole and are\nnow allowed to pass on.\n\n\nthank you for playing!\n\nhit x or — to restart",25,25,8)
end
