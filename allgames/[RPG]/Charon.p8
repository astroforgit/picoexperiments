-- slimes+ghosts+bounce

function init_bounce()
	 bounceanim={27,28,29,30}
  bouncedelay=rnd(8)+1
	 bounce={}
	 bpos={
			{x=36,y=13},{x=55,y=8},
			{x=44,y=10},{x=57,y=12},
			{x=50,y=26},{x=52,y=26},
			{x=49,y=28},{x=50,y=30},
			{x=52,y=30},{x=53,y=28},
			{x=24,y=20},{x=18,y=24}
			,{x=30,y=22},{x=30,y=20}
			,{x=27,y=18},{x=23,y=20}
		  }
	 for p in all(bpos) do
		 b={
		 	x=p.x,
		 	y=p.y,
		 	flip=false,
		 	dirx=1,
		 	diry=1,
		 	life=1
		 }
		 add(bounce,b)
		end
		fbcount=0
end



function move_bounce()
 fbcount+=1

	for b in all(bounce) do
	if (fbcount>bouncedelay) then

 if (p.x-b.x>-3) and (p.x-b.x<3) and
    (p.y-b.y>-3) and (p.y-b.y<3) then 
 
 if not is_tile(wall,b.x,b.y) then

			if  (p.x-b.x<1) then
			b.x-=1	end
			if  (p.x-b.x>0) then
			b.x+=1 end
			if  (p.y-b.y<1) then
			b.y-=1	end
			if  (p.y-b.y>0) then
			b.y+=1 end
				end 
end
if (is_tile(wall,b.x,b.y)) then

			if  (p.x-b.x<1) then
			b.x+=1	end
			if  (p.x-b.x>0) then
			b.x-=1 end
			if  (p.y-b.y<1) then
			b.y+=1	end
			if  (p.y-b.y>0) then
			b.y-=1 end
				end
		end
		end
	
	if (fbcount>bouncedelay) then
	 fbcount=0
	 end
end



function draw_bounce()
	for b in all(bounce) do
 if b.life!=0 then
		spr(get_frame(bounceanim,9),b.x*8,
			b.y*8,1,1,b.flip)
  else
  del(bounce,b)
	end
	end
end


