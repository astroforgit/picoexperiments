-- player code

function player_var()
  offsx=0
  offsy=0
  
  if state==2 or state==0 then
   p={   }
  p.sprite=112
  p.x=4
  p.y=4
  p.key=0
  p.idle={112,113,114,115,112,112}
  p.walk={96,97}
  p.fight={81}
  p.flip=false
  end
  if state==4 then
  p={   }
  p.sprite=112
  p.x=94
  p.y=30
  p.key=0
  p.idle={112,113,114,115,112,112}
  p.walk={96,97}
  p.fight={81}
  p.flip=false
  end
 if state==3 then
  p={   }
  p.sprite=112
  p.x=39
  p.y=23
  p.key=0
  p.idle={112,113,114,115,112,112}
  p.walk={96,97}
  p.fight={81}
  p.flip=false
 end
 end
 
function draw_player()
  if (btn(ƒ)) or (btn()>0) and (btn()<5) then
   spr(get_frame(p.walk,9),p.x*8+offsx,p.y*8+offsy,1,1,p.flip)
  else if (btn(5)) then 
  spr(get_frame(p.fight,9),p.x*8+offsx,p.y*8+offsy,1,1,p.flip)
  else 
   spr(get_frame(p.idle,13),p.x*8+offsx,p.y*8+offsy,1,1,p.flip)
  end
  end
 end
 
 
-- all the interactions and 
-- movements

 
function move_player()
  
   pxold=p.x
   pyold=p.y
   
  if reading==false then
      if (btnp(‹)) then
     p.x-=1
     offsx=8
     p.flip=true
    end  
   if (btnp(‘)) then 
     p.x+=1 
     offsx=-8
     p.flip=false
    end
   if (btnp(”)) then 
     p.y-=1 
     offsy=8
    end
   if (btnp(ƒ)) then 
     p.y+=1 
     offsy=-8
    end
   end
   
   
   offs() 
   
   interact(p.x,p.y)
  if (state==0) then    
   p.x=mid(0,p.x,mxp) 
   p.y=mid(0,p.y,myp) 
   end

   if p.x==96 and p.y==30 then 
   r=0
   state=4
   end
   
  if p.x==39 and p.y==23 then
   state=3
   end
   
 if p.x==7 and p.y==26 then
   r=30 
   end
   
   
 end 	
  	
  
-- every "is_tile" result
-- if something has a flag
-- and does something, it
-- goes here  
  
function interact(x,y)
 
  if is_tile(wall,x,y) then
    p.x=pxold
    offsx=0
    p.y=pyold
    offsy=-2
    sfx(1)
   end  
 
 
  if is_tile(key,x,y) then
     get_key(x,y)
     sfx(10)
    elseif is_tile(door,x,y) 
    and p.key>0 then
     open_door(x,y)
   end
   
  if is_tile(door,x,y) and 
    p.key==0 then
    p.x=pxold
    p.y=pyold
    sfx(1)
   end
   
   if is_tile(portal,x,y) then
    swap_tile()
    end
   
   if is_tile(coin,x,y) then
    cnum+=1
    tile=mget(x,y)
    mset(x,y,tile-1)
    sfx(9)
    end
    
   
   if is_tile(coinb,x,y) then
    cnum+=1
    tile=mget(x,y)
    mset(x,y,62)
    mset(flr(rnd(14))+1,flr(rnd(14))+17,63)
    mset(flr(rnd(14))+1,flr(rnd(14))+17,63)
    sfx(9)
    end
    
   
    
   for m in all(monsters) do

   if (m.x==x and m.y==y) and m.life==1 then
		  p.x=pxold
    p.y=pyold
    offsy=-2
    if cnum>0 then
		  cnum-=1
		  end
		  moncoin=0
		  sfx(3)
	  end
	  if (m.x==x and m.y==y and btn(—) and m.life==1) then
		  m.life=0
		  knum+=1
		  cnum+=1
    offsy=-2
		  sfx(2)
		  tile=mget(x,y)
    mset(x,y,8)
	  end
	  end
	 
	   for b in all(bounce) do
    
    if (b.x==x and b.y==y) and b.life==1 then
		  p.x=pxold
    p.y=pyold
    offsy=-2
    if cnum>0 then
		  cnum-=1
		  end
		  moncoin=0
		  sfx(3)
	  end
	  if (b.x==x and b.y==y and btn(—) and b.life==1) then
		  b.life=0
		  knum+=1
		  cnum+=1
    offsy=-2
		  sfx(2)
    mset(x,y,26)
	  end
	  end
	  
	 for g in all(ghost) do 
	 if g.x==x and g.y==y then
	  if state==0 then
	  r-=1
	  gradius=true
	  timee+=1
	  reading=true
	  
	  if timee==30 then
	  state=1
	  end
	  end
	  
	  if state==3 then 
	  if  cnum>0 then 
	  cnum-=1
	  end
	  if cnum==0 then 
	  state=1
	  end
	  end
	 end
	 end
	 
	 

  if is_tile(enemy,x,y) 
    and btn(—) then 
     tile=mget(x,y)
     mset(x,y,47)
     knum+=1
     sfx(2)
   end
    
  if is_tile(enemy,x,y) then
    p.x=pxold
    p.y=pyold

    sfx(3)
   end


end	
 
