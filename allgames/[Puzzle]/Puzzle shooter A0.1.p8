-- waves


-- {
-- f=spawning function
-- fp = spawning function parameters
-- t=needed turns before access
-- l=number of turns it lasts
-- p=period
-- }
function add_enemy(sid)
  ship = add_ship(sid, flr(rnd(grid_width)), -1, 1)
  ship.ny = 0
end

function add_debris(sid)
 ship = add_ship(sid, grid_width, flr(rnd(grid_height)), 2)
 ship.nx = grid_width-1
end

waves = {
 { -- wander
  f=add_enemy,
  fp=3,
  t=0,
  p=6,
  l=60,
 },
 { -- asteroids
  f=add_debris,
  fp = 4,
  t = 0,
  p = 3,
  l = 30,
 },
 { -- mines
  f=add_debris,
  fp=10,
  t=160,
  p=2,
  l=15,
 },
 { -- seeker
  f=add_enemy,
  fp=6,
  t=300,
  p=30,
  l=30,
 },

  
}

function waves_new_game()
 wave_num = 0
 cur_wave = waves[1]
 wave_timer = 0
end

function spawn()

 if wave_timer <= 0 then

  new_wave()
 end
 
 wave_timer -= 1
 

 if period(cur_wave.p) then
  cur_wave.f(cur_wave.fp)
 end

end

function new_wave()
 local old_wave = cur_wave
 while cur_wave == old_wave do
  local candidate_wave = waves[flr(rnd(#waves)) + 1]
  if candidate_wave.t <= turns then
   cur_wave = candidate_wave
  end
 end
 wave_timer = cur_wave.l
 wave_num += 1
 if (wave_num % 2 == 0) then
  heal_ship(ships[1], 1)
 end
 mess("wave "..wave_num..": "
  ..ship_templates[cur_wave.fp].n)
	
end
