pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
-- puzzle shooter a0.1
-- by eli zupke 


function _init()

 new_game()
end

function new_game()
 
 turns = 0
 message = ""
 message_life = -1
	anim = 0
	buffered_inputs = {}
 state = 1 --waiting for input
 
	pal(14,129,1)
	palt(0,false)
	palt(3, true)
	poke(0x5d41,8) -- reverb ch3
 music(0, 0, 9)
 ships_new_game()
 waves_new_game()
 
end

function mess(m)
 message = m
 message_life = 4
 sfx(61)
end



-- states:
-- 1: in game, waiting for input
-- 2: in game, animating
-- 3: game over

function _update60()

 check_input()

 if state == 1 then
  if eval_input() then
   sfx(62)
  else
   return
  end
 end
 
 if state == 2 then
  anim = min(anim + 0.20, 1)
  if anim >= 1 then
  
   state = 1 --waiting for input
   run_turn()
		 clear_ships()

		 
		 if message_life <= 0 then
		  message = ""
		 end
		 message_life -= 1
	 
		end
  return
 end
 
 if state == 3 then
  if btnp(4) and stat(24) == -1 then
   new_game()
  end
  return
 end
 
 clear_crunch()
 turns+=1
 
 run_ai()
 
 spawn()
 check_collisions()
 state = 2 -- animating
 anim = 0
 
 
end

function game_over()
 music(48)
 state = 3
 mess("press — to try again")
end

function check_input()
 for i=0, 5 do
  if btnp(i) then 
   buffered_inputs[#buffered_inputs+1]
    = i
   return
  end 
 end
end




function move_left() return move_ship(-1, 0) end
function move_right() return move_ship(1, 0) end
function move_up() return move_ship(0, -1) end
function move_down() return move_ship(0, 1) end
function a1() return ship_action(1) end
function a2() return ship_action(2) end

inputs = {
 [0] = move_left,
 [1] = move_right,
 [2] = move_up,
 [3] = move_down,
 [4] = a1,
 [5] = a2,
}

function eval_input()

 if #buffered_inputs <= 0 then return false end
 
 i = deli(buffered_inputs, 1)
 
 if inputs[i] != nil then
  a = inputs[i]()
  if not a then
   deny()
  end
  return a
 end
 
 return false
end
-->8
-- util

_grid_size = 12

-- converts grid coords to screen coords
function grid(gx, gy)
	return gx * _grid_size + 6, gy * _grid_size + 8 + 4
end

function grid_c(gx, gy)
	return gx * _grid_size + 10, 
	       gy * _grid_size + 8 + 8
end
 
function is_in_bounds(gx, gy)
 return gx >= 0 and
        gx < grid_width and
        gy >= 0 and
        gy < grid_height
end        

-- adapted from code by mitch mcmabers (yay stackoverflow)
-- deletes ships that are marked for deletion
function clear_ships()
 local j, n = 1, #ships;

for i=1,n do
  if (not ships[i].d) then
   -- move i's kept value to j's position, if it's not already there.
   if (i ~= j) then
    ships[j] = ships[i];
    ships[i] = nil;
   end
    j = j + 1; -- increment position of where we'll place the next kept value.
  else
   if i == 1 then
    game_over()
			 j = j + 1; -- increment position of where we'll place the next kept value.
			else
    ships[i] = nil;
   end
  end
 end
end

function distance(x1, y1, x2, y2)
 return sqrt((x1-x2)^2 + (y1-y2)^2)
end

function lerp(s, e, t)
 return s * (1 - t) + e * t
end

-->8
-- actions

-- true if the action was successful, false otherwise

function c_sfx(n, c)
 if c then
  sfx(n)
 end
 return c
end

function deny(ship)
 sfx(60)
end

function shoot(ship, pid)
 add_ship(pid, ship.nx, ship.ny, ship.f)
 return true
end

-- shoot projecticles that move slowly
function shoot_slow(ship, pid)
 dy = 1
 if ship.f == 0 then dy = -1 end
 s = add_ship(pid, ship.nx, ship.ny, ship.f)
 s.ny += dy
 return s
end

function shoot_single(ship, pid)
 for i, ship in pairs(ships) do
  if ship.t == pid then
   return act_none()
  end
 end
 return shoot(ship, pid)
end

function act_shoot(ship)
 a = shoot_single(ship, 2)
 return c_sfx(58, a)
end

function act_shoot_weak(ship)
 a = shoot(ship, 8)
 return c_sfx(59, a)
end

function act_shoot_seeker(ship)
 a = shoot_slow(ship, 5)
 return c_sfx(57, a)
end

function act_lay_mine(ship)
 a = shoot_slow(ship, 9)
 return c_sfx(57, a)
end

function act_none(ship)
 return false
end
