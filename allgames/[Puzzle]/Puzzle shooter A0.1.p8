-- graphics

texts = {
 --{m="message", l=life,c=color, x, y}
}

explosions = {

 --{l=life, r=radius, x, y} 

}

function add_text(_m,_c, _gx, _gy)
 _x, _y = grid(_gx, _gy)
 _x += flr(rnd(2))-1
 _y += flr(rnd(2))-1
 texts[#texts+1] = {
  m=_m,
  l=20,
  c=_c,
  x=_x,
  y=_y,
 }
end

function explode(_gx, _gy, r)
 x, y = grid_c(_gx, _gy)
 explosions[#explosions+1] =
  {l = flr(rnd(10) + 35),
   r=r,x= x,y=y}
end

function _draw()
 rectfill(0, 0, 128, 128, 14) -- back
 draw_grid()
	draw_ships()
 rectfill(0, 0, 128, 7, 0)
 rectfill(0, 128-7, 128, 128, 0)
 
 status = "‡:" .. ships[1].h .. " “:" .. turns
 
 if state == 3 then
  status = "game over!"
 end
 
	print(status, 1, 2, 2)
	print(status, 1, 1, 8)
	m_color = 12
	if message_life <= 1 then 
	 m_color = 1
	end
	print(message, 1, 121, 14)
	print(message, 1, 120, m_color)

 draw_explosions()
 draw_text()

end

local e_colors = {7, 10, 9, 10}

function draw_explosions()
 if state == 2 then return end
 -- draw smoke
 poke(0x5f33,1) -- transparent fill
 for i, e in pairs(explosions) do
		if e.l > 0 then
			fillp(rnd(-1))
   circfill(e.x, e.y, e.r + 1, 6)		
		end
 end
 fillp(0)

 -- draw fire
 for i, e in pairs(explosions) do
  if e.l > 0 then
   circfill(e.x, e.y, e.r*0.9, e_colors[e.l % #e_colors])
   
   e.l -= 1/2
   e.r -= ((e.r * 0.1) + 0.5)/2
  end
 end
end

function draw_text()
 for i, text in pairs(texts) do
  if text.l > 0 then
   print(text.m, text.x, text.y+1, text.c)
   print(text.m, text.x, text.y, 7)
   text.l -= 1
  end
 end
end

function clear_crunch()

 texts = {}
 explosions = {} 	
end

function draw_ships()
 for i, ship in pairs(ships) do
  if (not ship.d) or state == 2 then
   draw_ship(ship)
  end
 end
end


function draw_ship(ship)
	
	t = ship_templates[ship.t]
	
	-- choose the right frame of animation
	id = t.sid[flr(time() * 5.7 + ship.h) % #t.sid + 1]
	
	cx, cy = grid(ship.x, ship.y)
	nx, ny = grid(ship.nx, ship.ny)
	x = lerp(cx, nx, anim)
	y = lerp(cy, ny, anim)
	spr(id, x, y, t.sx, t.sy, false, ship.f == 0)
	if t.sym then
		sx = x + (_grid_size * t.sx) - 3 
	 spr(id, sx, y, t.sx, t.sy, true, ship.f == 0)
	end
	
end

function draw_grid()
	for gx=0, grid_width - 1 do
		for gy=0, grid_height - 1 do
		 x, y = grid(gx, gy)
			spr(3, x-2, y-2, 2,2)
		end
	end
end

-->8
-- simulation

grid_width = 10 
grid_height = 9

ships = {
 -- {
  -- d = this ship is marked for deletion
  -- t = template index
  -- x = grid x position
  -- y = grid y position
  -- nx = next grid x pos
  -- ny = next grid y pos
  -- h = health
  -- f = force (team) (0= player, 1=enemy)
 -- }  
}


function add_ship(tid, _x, _y, _f)

 template = ship_templates[tid]

	ships[#ships + 1] = {
	 d=false,
		t=tid,
		x=_x,
		y=_y,
		nx = _x,
		ny = _y,
		h=template.hmax,
  f = _f,
 }
 
 return ships[#ships]

end

function remove_ship(sid)
 deli(ships, sid)
end

function remove_ship_ref(ship)
 del(ships, ship)
end

-- move the player's ship
function move_ship(dx, dy)
	mship = ships[1]
	nx = mship.x + dx
	ny = mship.y + dy
	mship.nx = mid(0, nx, grid_width - 1)
	mship.ny = mid(0, ny, grid_height - 1)
	return nx == mship.nx and ny == mship.ny
end

-- used for player input
function ship_action(aid)
 ship = ships[1]
 acts = ship_templates[ship.t].act
 if aid > #acts then
  return false
 else
  return acts[aid](ship)
 end
end

function ships_new_game()
 ships = {} -- clear ships
 add_ship(1, 5, 5, 0) -- create player ship
end

function damage_ship(ship, dmg)
 ship.h -= dmg
 local seek = ship_templates[ship.t].seek
 local e_r = 4
  if ship.h <= 0 and seek then
   sfx(63)
   e_r = 10
  else
   sfx(56)
  end
 if seek then
  add_text("-"..dmg,8, ship.nx, ship.ny)    
 end
 -- mark the dead ship for deletion
 if ship.h <= 0 then ship.d = true end
 explode(ship.nx, ship.ny, e_r)
end

function heal_ship(ship, h)
 hmax = ship_templates[ship.t].hmax
 ship.h = min(hmax, ship.h + h)
 add_text("+"..h,11, ship.nx, ship.ny)    
end 



function check_collisions()
 for i, ship in pairs(ships) do
  -- check collisions
   for j, ship2 in pairs(ships) do
    -- make sure we're not looking at our ship,
    -- make sure neither are dead
    if not (i == j) and
     not (ship.d or ship2.d) then
	    if (ship.nx == ship2.nx and ship.ny == ship2.ny) then
	     -- collision
      t1 = ship_templates[ship.t]
      t2 = ship_templates[ship2.t]
      
      damage_ship(ship, t2.dmg)
      damage_ship(ship2, t1.dmg)
      stp = false
      
	     -- if neither or both die, then don't move them
	     if stp then
 	     ship.nx = ship.x
	      ship.ny = ship.y
	     end
	     
	    end
    end
   end

 end
end


function run_turn()

 for i, ship in pairs(ships) do
  
  if i == 1 then
 	 ship.x = mid(0, ship.nx, grid_width - 1)
	  ship.y = mid(0, ship.ny, grid_height - 1)  
  else
   ship.x = ship.nx
   ship.y = ship.ny
   if not is_in_bounds(ship.x, ship.y) then   
    ship.d = true
	  end
	  
  end

 end
 
end


-->8
-- ai

function run_ai()
 for i, ship in pairs(ships) do
  
  ai = ship_templates[ship.t].ai
  
  assert(ai != nil, 
   "failed to load ship ai for ship " .. i .. 
   ", template " .. ship_templates[ship.t].n)
  ai(ship)
  
 end
end

function ai_none(ship)

end

function ai_projectile(ship)
 if ship.f == 0 then
 	ship.ny -= 1
 else
  ship.ny += 1
 end
end

function random_act(ship)
 acts = ship_templates[ship.t].act
 acts[flr(rnd(#acts)) + 1](ship)
end

function chance(p)
 return rnd(1) < p
end

function period(p)
 return turns % p == 0
end

-- conditional functions
function c_lateral(ship, c)
 if c then
  if rnd(1) < 0.5 then
   ship.nx -= 1
  else
   ship.nx += 1
  end
 end
 return c
end

function c_advance(ship, c)
 if c then
  if ship.f == 0 then
   ship.ny -= 1
  else
   ship.ny += 1
  end
 end
 return c
end

function c_retreat(ship, c)
 if c then
  if ship.f == 0 then
   ship.ny += 1
  else
   ship.ny -= 1
  end
 end
 return c
end

function c_rand_act(ship, c)
 if c then
  random_act(ship)
 end
 return c
end

function c_avoid_walls(ship, c)
 if c then
	 ship.nx = mid(0, ship.nx, grid_width - 1)
	 ship.ny = mid(0, ship.ny, grid_height - 1)
	end 
end

function c_avoid_ship(ship, c)
 if c then
  for i, o_s in pairs(ships) do
   -- avoid other ships of the same force
   if o_s != ship and o_s.f == ship.f then
    if ship.nx == o_s.nx and
     ship.ny == o_s.ny 
    then
     ship.nx = ship.x
     ship.ny = ship.y
     return
    end 
   end
  end
 end
end

function c_follow_dx(ship, dx, c)
 if c then
  if dx > 0 then
   ship.nx -= 1
  elseif dx < 0 then
   ship.nx += 1
  end
 end
end

function c_follow_dy(ship, dy, c)
 if c then
  if dy > 0 then
   ship.ny -= 1
  elseif dy < 0 then
   ship.ny += 1
  end
 end
end

function find_enemy(ship)
 if not ship.enemy or ship.enemy.d then
  ship.enemy = nearest_enemy(ship)
 end
 dx, dy = 0, 0
 if ship.enemy then 
	 dx = ship.nx - ship.enemy.nx
	 dy = ship.ny - ship.enemy.ny
	end
 return dx, dy
end

-- slowly wander
function ai_meander(ship)
 if period(3) then

	 c_lateral(ship, chance(0.6))
	 c_advance(ship, chance(0.25))
	 c_retreat(ship, chance(0))
  
  c_avoid_walls(ship, chance(0.5))
  c_avoid_ship(ship, true)
 else
  c_rand_act(ship, chance(0.25))
 end
end

function ai_drift(ship)
 if period(2) then
  ship.nx -= 1
 else
  c_rand_act(ship, chance(0.5))
 end
 c_advance(ship, chance(0.2))
 c_avoid_ship(ship, true)
end

function nearest_enemy(ship)
 
 closest = nil
 c_dist = 9999
 
 for i, o_ship in pairs(ships) do
  if o_ship.f != ship.f and
   ship_templates[o_ship.t].seek and
   not o_ship.d 
  then 
   o_dist = distance(ship.nx, ship.ny, o_ship.nx, o_ship.ny)
   if o_dist < c_dist then
    c_dist = o_dist
    closest = o_ship
   end
  end
 end
 
 return closest
end

function ai_home_fast(ship)
 ai_home(ship, 1)
end

function ai_home_slow(ship)
 ai_home(ship, 2)
end

function ai_home(ship, speed)
 if period(speed) then
  dx, dy = find_enemy(ship)
  
  c_follow_dx(ship, dx, true)
  if period(2) then
	  c_follow_dy(ship, dy, true)
	 else
	  c_advance(ship, true)
	 end
  c_avoid_ship(ship, chance(0.7))
 end
end

function general_backline(ship, p, follow, y_chance, shoot_chance)
 if period(p) then
  
  if follow then
	  dx, dy = find_enemy(ship)
	  c_follow_dx(ship, dx, true)
	 else
	  c_lateral(ship, true)
	  c_advance(ship, chance(y_chance) and y < 2)
	  c_retreat(ship, chance(y_chance) and y > 0)
	  c_avoid_walls(ship, true)
	  c_avoid_ship(ship, true)
	 end 
	 
 elseif chance(shoot_chance) then
  random_act(ship)
 end

end
   
function ai_snipe(ship)
 general_backline(ship, 3, true, 0.0, 0.70)
end
    
function ai_hold_back(ship)
 general_backline(ship, 3, false, 0.2, 0.50)
end

function ai_mine(ship)
 if not ship.l then ship.l = 50 end
 ship.l -= 1
 if ship.l > 0 then return end
 if chance(0.01) then
  damage_ship(ship, 10)
 end
end 

