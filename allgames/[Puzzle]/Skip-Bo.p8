-- menu screen

function upd_menu()

 if m_click then
 
  if (button(41,88,45,13)) start_game()
  if (button(41,104,45,13)) start_help()
  
 end
end


function draw_menu()
 -- green
 cls(3)
 fillp(0b100001000.1)
 rectfill(0,0,127,127,11)
 fillp()
 
 -- middle bar
 count=0
 space=2
 
 for i=1,50 do
  line(0,i+32,127,i+16,6)
 end
 line(0,32,127,16,3)
 line(0,82,127,66,3)
 
 -- logo
 spr(1,29+sin(wiggle)*3,42,9,2)
 
 -- start button
 spr(10,41,88,6,2)
 
 -- help button
 spr(42,41,104,6,2)
end

-->8
-- help screen


function start_help()
	screen="help" 
	m_click=false
 step=1
 
 text={}
 text[1]="this is your area. the gray  high light indicates that    it's your turn to play."
 text[2]="this deck is the most        important. play all the cardsin the deck to win. the red  number is the number of cardsleft."
 text[3]="the other 3 decks are for    support. they get a new card each at the start of your    turn. click on any of your 4 decks to select the top card."
 text[4]="place a card from one of yourdecks on these 'build decks'.the numbers on the cards mustfollow the normal order.     cards with a question mark(?)can be placed on any number."
 text[5]="you may place cards until there's none left that fits.    press this deck to end your  turn."
 text[6]="this area is from the        computer. be careful not to  help your opponent!"

 arrow_x={75,88,50,55,88,50}
 arrow_y={55,55,55,37,37,19}
end


function upd_help()
 if m_click then
 
  step=(step%6)+1
  sfx(1)
  
  -- exit
  if (button(2,2,7,7)) screen="menu"
 end
end


function draw_help()
 cls(5)
 
 -- stop button
 box(2,2,7,7,8,true)
 box(2,2,7,7,1,false)
 line(4,4,6,6,7)
 line(6,4,4,6,7)
 
 -- draw screen
 x=32
 y=4
 box(x,y,64,64,5,true)
 box(x,y,64,64,1,false)
 
 -- bar
 box(x+1,y+1,62,6,9,true)
 box(x+2,y+2,4,4,8,true)
 
 -- turn high light
 box(x+1,y+44,62,19,6,true)
 
 -- decks
 for j=0,2 do
  for i=0,3 do
   
   x=i*12+2+33
		 y=j*18+8+5
		 if (i==3 and j!=1) x+=12
		 
		 box(x,y,10,16,13,true)
		 
		end
	end
	
	box(83,31,10,16,4,true)

 -- number
 xprint("10",76,57,8)	
 
	-- text box
	box(4,79,120,45,13,true)
	box(4,79,120,45,1,false)
	
	x=6
	y=81
	
	-- wrap around text
	t=text[step]
	
	while #t>29 do
	 s=sub(t,1,29)
	 t=sub(t,30,#t)
	 
	 print(s,x,y,7)
	 y+=6
	end
	
	if (#t>0) print(t,x,y,7)
	
	-- step
	print(step.."/6",111,117,6)
	
	-- arrow
	x=arrow_x[step]+cos(wiggle)*3
	y=arrow_y[step]+sin(wiggle)*3
	spr(38,x,y,2,2)
end
 
