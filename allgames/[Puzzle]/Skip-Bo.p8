pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
-- skip-bo, by mattel
-- made by kim wijsbeek


function _init()
 -- enable mouse
 poke(0x5f2d,1)
 
 -- flyers
 init_fly()
 
 -- ai
 init_ai()
 
 -- state 
 screen="menu"
 wiggle=0
 select=0
 
 m_click=false
 m_prev=false
end


function _update()

 if (screen=="menu") upd_menu() 
 if (screen=="play") upd_game()
 if (screen=="help") upd_help()
 
 wiggle+=0.02
 
 upd_mouse()
end


function _draw()

 if (screen=="menu") draw_menu()
 if (screen=="help") draw_help()
 if (screen=="play") draw_game()
	
	draw_mouse()
end


function upd_mouse()
 mx=stat(32)
 my=stat(33)
 
 m_click=false
 
 if stat(34)==1 then
  if (not m_prev) m_click=true
  m_prev=true
 else
  m_prev=false
 end
end


function draw_mouse()
 spr(16,mx,my)
end


-->8
-- play screen

function start_game()
 init_deck()
 shuffle_stock()
 deal_cards()  
 
 screen="play"
 
 state="start turn"
 turn=1
 step=0
 wait=0
 select=0
 message=""
 clicked=false
 
 sfx(0)
end


function upd_game()
 upd_fly()
 upd_state()
end


function upd_state()
 if (state=="start turn") start_turn()

 if state=="input" then
  if (turn==0) input_comp()
  if (turn==1) input_player()
 end

 if (state=="clear build") clear_build()

 if (state=="game over") upd_message()
end

 
function start_turn()
 
 if wait==0 then
  if step<3 then
 
	  -- select deck
	  d=step+1
	  if (turn==1) d+=8
	  
	  -- take a card
	  nr=take_card(13)
	  add_fly(13,d,nr)
	 
	  wait=10  
	  step+=1
 
  end 
 else
  wait-=1
 end
 
 -- next state
 if step==3 and #fly==0 then
  state="input"
  step=0
  wait=0
 end
 
end


function clear_build()
 if wait==0 then

  -- remove a card
  nr=take_card(step)
  add_fly(step,14,nr)
 
  wait=3
  
  if (#deck[step]==0) then
   state="input"
   wait=0
   step=0
  end
  
 else
  wait-=1
 end

end


function input_player()
 local build=0
 
 -- click mouse
 if m_click then
  d=1
  
  for j=0,2 do
   for i=0,3 do
    
    -- coordinates
	   x=i*25+4
	   y=j*38+16
	   if (j!=1 and i==3) x+=25
	   
	   -- check row & column
	   if button(x,y,20,32) then
	    if (j==1 and select>0) build=d
	    if (j==2 and #deck[d]>0) then
	     select=d
	     wiggle=0
	    end
	   
	    sfx(0)
	   end

    d+=1
   end
  end	
     
  -- press end turn button
  if mx>=104 and my>=48 and mx<124 and my<80 then
   
   state="start turn"
   turn=0
   select=0
   
   sfx(1)
  end
  
  -- press exit button 
	 if button(1,2,7,7) then
	  screen="menu"
	  sfx(1)
	 end

  
 end
 
 -- place card on build deck
 if build>0 then
 
  -- get build deck card
  top=#deck[build]
  if top>0 then
   build_nr=deck[build][top]
  else
   build_nr=0
  end
  
  -- get selected card
  nr=take_card(select)
  
  if nr==build_nr+1 or nr==11 then
	  add_fly(select,build,build_nr+1)
	  select=0
  else
   add(deck[select],nr)
  end
 
 end
end


function upd_message()
 if (wait>0) wait-=1

 if (wait<30 and m_click) screen="menu"
 if (wait==0) screen="menu"
end


function draw_game()
 cls(5)
  
 draw_turn() 
 draw_decks()
 draw_bar()
 draw_fly()
 draw_message()
end


function draw_bar()
 -- bar
 box(0,0,128,11,9,true)
 line(0,0,127,0,10)
 line(0,10,127,10,4)
 line(0,11,127,11,1)
 
 -- stop button
 box(1,2,7,7,8,true)
 box(1,2,7,7,1,false) 
 line(3,4,5,6,7)
 line(5,4,3,6,7)
 
 -- title
 spr(32,40,2,6,1)
end


function draw_message()

 if message!="" then
  box(39,53,50,22,5,false)
  box(40,54,48,20,14,true)
  box(40,54,48,20,7,false)
  
  print(message,64-(#message*2),61,7)
 end
 
end 


function draw_turn()

 -- computer turn high light
 if turn==0 then
  box(0,12,128,40,6,true)
 -- player turn
 else
  box(0,88,128,40,6,true)  
 end
 
 -- computer info
 y=20
 xprint("me",89,y,1)
 xprint(#deck[4],89,y+8,12)
 xprint("cards",89,y+16,1)
 xprint("left",89,y+24,1)
 
 -- player info
 xprint("you",89,96,10)
 xprint(#deck[12],89,104,8)
 xprint("cards",89,112,10)
 xprint("left",89,120,10)
  
end
 
-->8
-- cards

--[[

deck 1-4 belong to computer
deck 4 is to be cleared to win
deck 5-8 are build decks
deck 9-12 belong to player
deck 12 is to be cleared
deck 13 the stock deck
deck 14 is the cleared deck

]]


function init_deck()
 -- create 14 decks
 deck={}
 
 for d=1,14 do
  deck[d]={}
 end
 
 -- fill stock with cards
 for i=1,8 do
  for j=1,10 do
   add(deck[13],j)
  end
 end
 
 -- fill stock with jokers
 for i=1,16 do
  add(deck[13],11)
 end
 
end


function shuffle_stock()
 for i=1,#deck[13]*10 do
 
  a=rand(#deck[13])
  b=rand(#deck[13])
  c=deck[13][a]
  deck[13][a]=deck[13][b]
  deck[13][b]=c
 end

end


function deal_cards()
 for i=0,1 do
 
  -- to computer or player
  local d=4
  if (i==1) d=12
  
  -- give 10 cards
  for j=1,10 do
   nr=take_card(13)
   add(deck[d],nr)
  end
  
 end
end


function read_card(d)
 local top=#deck[d]
 local nr=0
 
 if (top>0) nr=deck[d][top]
 
 return nr
end


function take_card(d)
 top=#deck[d]
 nr=0
 
 if top>0 then
 
	 nr=deck[d][top]
	 deck[d][top]=-1
	 
	 del(deck[d],-1)
	 
	 -- refill stock
	 if (d==13 and #deck[d]==0) refill_stock()
	
	end
	
 return nr
end


function refill_stock()
 for i in all(deck[14]) do
  add(deck[13],i)
  del(deck[14],i)
 end

 -- add cards if empty
 if #deck[13]<3 then
  for i=1,11 do
   add(deck[13],i)
  end
 end
 
 shuffle_stock()
end


function draw_card(x,y,nr)
 -- card color
 local col=12
 if (nr>4) col=11
 if (nr>8) col=8
 if (nr==11) col=9
 if (nr==0) col=4
 
 box(x+1,y+1,18,30,col,true)
 
 if nr>0 then
  
  -- card
  spr(128,x,y,3,4)
  
  -- big number
  img=62+nr*2
  if (nr>8) img=96+(nr-9)*2
  spr(img,x+2,y+9,2,2)
  
 else 
  -- card
  spr(134,x,y,3,4)
  
  -- text
  x+=10
  if turn==0 or state=="start turn" then
   xprint("skip",x,y+13,9)
   xprint("bo",x,y+20,9)
  else
   xprint("end",x,y+13,7)
   xprint("turn",x,y+20,7)
  end
 end
end
  
  
function draw_decks()
 local d=1
 
 for j=0,2 do
  for i=0,3 do
   
   -- coordinates
   x=i*25+4
   y=j*38+16
   if (j!=1 and i==3) x+=25
   
   -- show if not empty deck
   local top=#deck[d]
   if top>0 then
   
    -- wiggle selected 
    if (turn==1 and select==d) y+=sin(wiggle)*3
    
    -- draw top of deck
    draw_card(x,y,deck[d][top])
   else
    spr(131,x,y,3,4)
   end
   
   d+=1
  end
 end

 -- stock 
 top=#deck[13]
 draw_card(104,54,0)
end

-->8
-- tools

function box(x,y,w,h,col,fill)
 if fill then
  rectfill(x,y,x+w-1,y+h-1,col)
 else
  rect(x,y,x+w-1,y+h-1,col)
 end
end


function rand(x)
 return flr(rnd(x))+1
end


function xprint(text,x,y,col)
 text=""..text
 x-=#text*2
 y-=3
 print(text,x,y,col)
end


function button(x,y,w,h)
 on_button=false
 if (mx>=x and my>=y and mx<x+w and my<y+h) on_button=true
 
 return on_button
end
-->8
-- flyers

function init_fly()
 fly={}
end


function add_fly(from_deck,to_deck,nr)
 new={}

 -- starting coordinates
 if from_deck<=12 then
 
  col=(from_deck-1)%4
  row=(from_deck-1)\4
  if (row!=1 and col==3) col=4
  
  new.x=col*25+4
  new.y=row*38+16
  
 else
  
  new.x=104
  new.y=54
 end
  
 -- goal coordinates 
 if to_deck<=12 then
 
  col=(to_deck-1)%4
  row=(to_deck-1)\4
  if (row!=1 and col==3) col=4
  
  new.goal_x=col*25+4
  new.goal_y=row*38+16
  
 elseif to_deck==13 then
  new.goal_x=104
  new.goal_y=54
 else
  new.goal_x=128
  new.goal_y=48
 end
 
 new.nr=nr
 new.vx=(new.goal_x-new.x)/10
 new.vy=(new.goal_y-new.y)/10
 new.step=0
 new.deck=to_deck
 
 add(fly,new)
 
 sfx(2)
end


function upd_fly()
 for i in all(fly) do
 
  -- move flying card
  i.x+=i.vx
  i.y+=i.vy
  i.step+=1
  
  -- delete flyer
  if i.step==10 then
  
   d=i.deck
   add(deck[d],i.nr)
   del(fly,i)
   
   -- check full build deck
   if d>=5 and d<=8 and #deck[d]==10 then
    state="clear build"
    step=d
   end
  
   -- check win
   check_win()
  end
  
 end
end


function check_win()

 if #deck[4]==0 or #deck[12]==0 then
 
  state="game over"
  
  if #deck[4]==0 then
   
   message="i won..."
   sfx(4)
   wait=60
   
  else
  
   message="you won!"
   sfx(3)
   wait=60
  
  end
  
 end
end

function draw_fly()
 for i in all(fly) do
 
  draw_card(i.x,i.y,i.nr)
 
 end
end
-->8
-- ai

function init_ai()
 dif={}
 move={}
 ai_wait=20
end


function input_comp()
 if ai_wait==0 then
	 ai_build_dif()
	 ai_find_moves()
	 ai_do_move()
	else
	 ai_wait-=1
	end
end


function ai_build_dif()
 local clear_nr=read_card(4)
 
 for i=1,4 do
  
  build_nr=read_card(4+i)
  dif[i]=(clear_nr-build_nr)
  if (dif[i]<1) dif[i]+=10
  
  if (clear_nr==11) dif[i]=1
 
 end
end


function ai_find_moves()
 move={}
 
 -- try all try decks
 for i=1,4 do
 
  from_nr=read_card(i)
  
  -- test on build decks
  for j=5,8 do
   
   to_nr=read_card(j)
   
   -- fits
   if (from_nr==to_nr+1 or from_nr==11) then
    
    new={}
    new.from=i
    new.to=j
    new.score=11-dif[j-4]
    if (from_nr==11) new.score-=0.5
   
    -- dif = 1
    if dif[j-4]==1 then
     if (i<4) new.score=0
     if (i==4) new.score=20
    end
    
    add(move,new) 
   end
   
  end
 end
end


function ai_do_move()
 local hi_score,hi_move=0,nil
 
 -- pick move with highest score
 for i in all(move) do
  
  if i.score>hi_score then
  
   hi_score=i.score
   hi_move=i
  
  end
 end
 
 -- place card
 if hi_move!=nil then
  
  m=hi_move
  nr=take_card(m.from)
  
  add_fly(m.from,m.to,read_card(m.to)+1)

  ai_wait=20	 
 end
 
 -- stop
 if hi_move==nil then
  
  state="start turn"
  turn=1
  ai_wait=20
  
 end
 
end


function draw_ai()
 if turn==0 then
 
  -- show differences
  for i=1,4 do
   
   x=(i-1)*25+4
   y=48
   
   if (dif[i]!=nil) print(dif[i],x,y,12)
  end
  
  -- show # of moves
  print("movs "..#move,76,30,12)
 end
end
