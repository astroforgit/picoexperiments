--fruity falling blocks - kp73

deb=false

function _init()
	music_tune=true
	music_sfx=true
	init_out_cache(1,63)
	init_sp_names()
	swap_anim={
		step=0,
		done=false,
		left=0,
		right=0
	}	
	init_game()
	init_title()
end

function init_title()
	radius=8
	originx=9
	originy=48
	title={
		i=1,
		points={}
	}
	for a=0,360,5 do
	 local x=originx
	 	+radius
	 	*cos(a/360)
	 local y=originy
	 	+radius 
	 	*sin(a/360)
	 add(title.points,{x,y})
 end
	for x=0,64,2 do
		for y=0,64,2 do
			mset(x,y,flr(rnd(19))+1)
		end
	end
	game.fall_wait=0.26	
	_draw=draw_title
	_update60=update_title
end

