pico-8 cartridge // http://www.pico-8.com
version 32
__lua__

--- Constants
-- md=mine density (in pct), s=size
-- score multiplier implicit with mine density: 5 => 1 (1*5 = 5), 20 => 4 (4*5 = 20)
levels={
 {md=5,s=16},
 {md=7,s=16},
 {md=8,s=20},
 {md=10,s=20},
 {md=11,s=24},
 {md=13,s=24},
 {md=14,s=28},
 {md=15,s=28},
 {md=16,s=32},
 {md=18,s=32}
}
-- For score I want to penalize just going mindlessly direct to the end (e.g.) diagonal. I think for that I need:
-- 1. Win bonus (proportional to level size)
-- 2. Bonus on number of squares discovered
-- 3. Bonus on the sum of the value of discoevered squares
-- 4. Bonus on closest distance to objective
-- I don't want people to grind the whole map though, so make the win bonus good.
-- (2) and (3) are interesting, but 2 and 3 are effected by size, and 3 is effectd by mine density. Exclud it from the multiplier then?

--- globals
game={
 seed=0,
 level=0,
 scene="menu"
}
options={
 warning_sound=true
}

function _init()
 reseed()
 init_menu()
end

function _update()
 if game.scene == "menu" then update_menu()
 elseif game.scene == "game" then update_game()
 elseif game.scene == "endgame" then update_endgame()
 end
end

function _draw()
 if game.scene == "menu" then draw_menu()
 elseif game.scene == "game" then draw_game()
 elseif game.scene == "endgame" then draw_endgame()
 end
end

function reseed()
 game.seed = flr(rnd(0x8000))
 srand(game.seed)
end

--- menu

menu_items={
 {title="play"},
 {title="level", value="", type="dec"},
 {title="warning sound", value="", type="toggle"},
 {title="seed", value="", type="hex"}
}

menu={
 row=1,
 selected_row=0,
 selected_col=0
}

function init_menu()
 game.scene="menu"
 menu.row=1
 menu.selected_row=0
 menu.selected_col=0
 menu_items[2].value = ""..game.level
 if options.warning_sound then
  menu_items[3].value = "on"
 else
  menu_items[3].value = "off"
 end
 menu_items[4].value = hex_str(game.seed)
end

function update_menu()
 if(menu.selected_row == 0) then
  update_menu_list()
 else
  update_value()
 end
end

function update_menu_list()
 if btnp(”) and menu.row > 1 then
  menu.row=menu.row-1
 end
 if btnp(ƒ) and menu.row < #menu_items then
  menu.row=menu.row+1
 end
 if btnp(Ž) then
  if menu.row == 1 then
   init_game()
  else
   menu.selected_row=menu.row
   menu.selected_col=1
  end
 end
end

function update_value()
 local item=menu_items[menu.selected_row];
 if item.type != "toggle" then
  if btnp(‹) and menu.selected_col > 1 then
   menu.selected_col=menu.selected_col-1
  end
  if btnp(‘) and menu.selected_col < #(""..item.value) then
   menu.selected_col=menu.selected_col+1
  end
 end
 if btnp(—) or btnp(Ž) then
  menu.selected_row=0
 end
 if btnp(”) then
  increment_menu_value(item, 1)
 end
 if btnp(ƒ) then
  increment_menu_value(item, -1)
 end
end

function increment_menu_value(item, inc)
 if item.type == "toggle" then
  if item.value == "on" then
   options.warning_sound = false
   item.value = "off"
  else
   options.warning_sound = true
   item.value = "on"
  end
  return
 end

 local selected_char = sub(item.value, menu.selected_col, menu.selected_col)
 local selected_value
 if item.type == "hex" then
  selected_value = tonum("0x7"..selected_char)
 else
  selected_value = tonum("5"..selected_char)
 end

 selected_value = selected_value + inc

 local transformed_char
 if item.type == "hex" then
  transformed_char = sub(hex_str(selected_value), 4, 4)
 else
  transformed_char = sub(tostr(selected_value), 2, 2)
 end

 item.value = sub(item.value, 1, menu.selected_col-1)..transformed_char..sub(item.value, menu.selected_col+1)

 if item.title == "level" then
  game.level = tonum(item.value)
 else -- seed
  game.seed=tonum("0x"..item.value)
  srand(seed)
 end
end

function draw_menu()
 cls()

 spr(8, (128-64)/2, 0, 8, 8)

 cursor(30, 60)
 ?"mine walker"
 ?""

 for i=1,#menu_items do
  local item=menu_items[i];
  if menu.row == i then color(12) else color(7) end
  if item.value then
   if menu.selected_row == i then
    ?item.title.." "..print_value(item)
   else
    ?item.title.." "..item.value
   end
  else
   ?item.title
  end
 end
 
 color(7)
 ?""
 ?"\-0\-5reach the bottom right corner"
 ?"\-0\-5without stepping into mines!"
 ?""
 ?"\-0\-5Ž to mark obvious nearby mines"
end

function print_value(item)
 if menu.selected_col == 0 then return item.value end
 if item.type == "toggle" then return "\f8"..item.value.."\fc" end
 return sub(item.value, 1, menu.selected_col-1).."\f8"..sub(item.value, menu.selected_col, menu.selected_col).."\fc"..sub(item.value, menu.selected_col+1)
end

function hex_str(value)
 return sub(tostr(value, true), 3, 6)
end

-- game
field={}
game_end_time=0
player={
 x=0,
 y=0
}
translation={
 x=0,
 y=0
}
game_stats={
 discovered_squares=0,
 discovered_value=0
}

function init_game()
 game.scene="game"
 field={}
 game_end_time=0
 player.x=0
 player.y=0
 translation.x=0
 translation.y=0

 local level=levels[game.level+1]
 local total_size = level.s * level.s
 local total_mines = flr(total_size / 100 * level.md)

 for i=0,level.s-1 do
  field[i] = {}
 end

 field[0][0] = {
  t="start",
  d=true,
  v=0
 }
 field[level.s-1][level.s-1] = {
  t="end",
  d=false,
  v=0
 }

 local mine_index={}
 for i=1,total_mines do
  local mx=0 my=0
  repeat
   mx=flr(rnd(level.s))
   my=flr(rnd(level.s))
  until (field[mx][my] == nil)

  field[mx][my]={
   t="mine",
   d=mx <= 1 and my <= 1,
   v=0
  }
  add(mine_index, {mx, my})
 end

 for x=0,level.s-1 do
  for y=0,level.s-1 do
   if not field[x][y] then
    field[x][y] = {
     t="empty",
     d=false,
     v=0
    }
   end
  end
 end

 for m in all(mine_index) do
  for x=-1,1 do
   for y=-1,1 do
    if (x != 0 or y != 0) and field[m[1]+x] and field[m[1]+x][m[2]+y] then
     field[m[1]+x][m[2]+y].v = field[m[1]+x][m[2]+y].v + 1
    end
   end
  end
 end

 game_stats.discovered_squares=1
 game_stats.discovered_value=field[0][0].v

 if options.warning_sound then
  menuitem(1, "warn sound on", toggle_warning_sound_menu_item)
 else
  menuitem(1, "warn sound off", toggle_warning_sound_menu_item)
 end
end

function toggle_warning_sound_menu_item()
 if options.warning_sound then
  options.warning_sound = false
  menuitem(1, "warn sound off", toggle_warning_sound_menu_item)
 else
  options.warning_sound = true
  menuitem(1, "warn sound on", toggle_warning_sound_menu_item)
 end
 return true
end

function update_game()
 update_translation()

 if(game_end_time > 0) then
  if btnp(Ž) then
   init_endgame()
  end
  return
 end

 if btnp(Ž) then
  mark_obvious_squares()
  return
 end

 if move() then
  collide()
  discover(player.x,player.y)
 end
end

function update_translation()
 if(game_end_time > 0) then
  if game_end_time < (time() - 0.5) then
   if (btn(‹)) then translation.x = translation.x + 3 end
   if (btn(‘)) then translation.x = translation.x - 3 end
   if (btn(”)) then translation.y = translation.y + 3 end
   if (btn(ƒ)) then translation.y = translation.y - 3 end
  end
 else
  local player_pos={
   x=player.x*7+translation.x,
   y=player.y*7+translation.y
  }
  if player_pos.x < 14 then
   translation.x = translation.x + 2
  elseif player_pos.x > 128-21 then
   translation.x = translation.x - 2
  end
  if player_pos.y < 14 then
   translation.y = translation.y + 2
  elseif player_pos.y > 128-28 then
   translation.y = translation.y - 2
  end
 end

 local level=levels[game.level+1]
 local limit={
  x=min(-(level.s-18)*7+2, 0),
  y=min(-(level.s-17)*7+1, 0)
 }
 if translation.x > 0 then translation.x = 0 end
 if translation.x < limit.x then translation.x = limit.x end
 if translation.y > 0 then translation.y = 0 end
 if translation.y < limit.y then translation.y = limit.y end
end

function move()
 local level=levels[game.level+1]
 local r=false
 if (btnp(‹)) then
  player.x=max(0, player.x-1)
  r=true
 end
 if (btnp(‘)) then
  player.x=min(level.s-1, player.x+1)
  r=true
 end
 if (btnp(”)) then
  player.y=max(0, player.y-1)
  r=true
 end
 if (btnp(ƒ)) then
  player.y=min(level.s-1, player.y+1)
  r=true
 end
 return r
end

function collide()
 local square = field[player.x][player.y];
 if square.t == "end" then
  sfx(1)
  game_end_time = time()
  return
 end
 if square.t == "mine" then
  sfx(2)
  game_end_time = time()
  return
 end
end

function discover(x, y)
 if field[x][y].d then
  return
 end

 if not field[x][y].d then
  game_stats.discovered_squares=game_stats.discovered_squares+1
  game_stats.discovered_value=game_stats.discovered_value+field[x][y].v
 end

 field[x][y].d = true
 if field[x][y].v > 0 and options.warning_sound then
  sfx(3)
 end
end

function mark_obvious_squares()
 local mines_are_obvious = true

 for x=-1,1 do
  for y=-1,1 do
   if (x != 0 or y != 0) and field[player.x+x] and field[player.x+x][player.y+y] then
    local square = field[player.x+x][player.y+y]
    if square.t != "mine" and not square.d then
     mines_are_obvious = false
    end
   end
  end
 end

 if mines_are_obvious then
  for x=-1,1 do
   for y=-1,1 do
    if (x != 0 or y != 0) and field[player.x+x] and field[player.x+x][player.y+y] then
     local square = field[player.x+x][player.y+y]
     square.d = true
    end
   end
  end
 end
end

function draw_game()
 draw_field()
 draw_player()
 draw_header()
end

function draw_field()
 cls(0)

 local level=levels[game.level+1]
 local cm=get_centering_margin()
 rectfill(cm.x, cm.y, cm.x + level.s*7-1, cm.y + level.s*7-1, 5)
 color(6)
 for x=0,level.s-1 do
  for y=0,level.s-1 do
   if field[x][y].d then
    if field[x][y].t == "empty" or field[x][y].t == "start" then
     print(field[x][y].v, cm.x + x*7+2+translation.x, cm.y + y*7+1+translation.y)
    elseif field[x][y].t == "mine" then
     spr(2, cm.x + x*7+translation.x, cm.y + y*7+translation.y)
    end
   elseif game_end_time > 0 and field[x][y].t == "mine" then
    spr(2, cm.x + x*7+translation.x, cm.y + y*7+translation.y)
   end
  end
 end
end

function draw_player()
 local cm=get_centering_margin()
 spr(1,cm.x+player.x*7+translation.x,cm.y+player.y*7+translation.y)
end

function draw_header()
 rectfill(0, 0, 128, 7, 0)
 color(7)
 local points = ""..get_points()
 while #points < 4 do
  points = "0"..points
 end

 print("score "..points.."   level "..game.level.."   seed "..hex_str(game.seed), 0, 1)
end

function get_centering_margin()
 local level=levels[game.level+1]
 return {
  x=max(0, (128 - level.s*7)/2),
  y=8 + max(0, (128 - 8 - level.s*7)/2),
 }
end

--- endgame

total_points=0
round_points=0
function init_endgame()
 game.scene="endgame"

 round_points = get_points()
 if type(total_points) != "string" then
  total_points = total_points + round_points
  if (total_points < 0) then
   total_points = "legend"
  end
 end
end

function get_points()
 local end_square = field[player.x][player.y]
 local is_win = game_end_time > 0 and end_square.t == "end"

 local level=levels[game.level+1]
 local level_multiplier=level.md / levels[1].md

 local win_bonus = 0

 if is_win then win_bonus = 50 end

 return flr((win_bonus + game_stats.discovered_squares) * level_multiplier + game_stats.discovered_value)
end

function update_endgame()
 local end_square = field[player.x][player.y]

 if end_square.t == "end" then
  if btnp(Ž) then
   game.level = min(9, game.level + 1)
   reseed()
   init_game()
  end
  if btnp(—) then
   reseed()
   init_game()
  end
 else
  if btnp(Ž) or btnp(—) then
   reseed()
   init_game()
  end
 end
 

end

function draw_endgame()
 draw_game()

 local left = (128-96)/2
 local top = (128-64)/2
 local right = left+96
 local bottom = top+64
 rectfill(left, top, right, bottom, 0)
 rect(left+2, top+2, right-2, bottom-2, 7)

 color(7)
 local end_square = field[player.x][player.y]
 if (end_square.t == "end") then
  print("cleared! Š", left+4, top+4)
 else
  print("you steped on a mine!", left+4, top+4)
 end
 ?""
 ?""
 ?"round points: "..round_points
 ?"total points: "..total_points
 ?""
 ?""
 if game.level < 9 then
  if end_square.t == "end" then
   ?"Ž next level"
   ?"— repeat level"
  else
   ?"Ž repeat level"
  end
 else
  ?"Ž new game"
 end
end
