		print(string,63-#string*2,59,6)
		print(string2,63-#string2*2,67,6)
		print(string3,63-#string3*2,75,6)
	end
end
-->8
--menu code

function menu_setup()
	timer_menu=20
	create_title()
	sfx(3)
end

function create_title()
	--creates a table where we will store the title's letters
	title={}
	--we add letters to title 
	letter_sprite=50
	letter_x=12
	letter_y=22
	letter_dy=1
	for i=1,13 do
		letter={sprite=letter_sprite,x=letter_x,y=letter_y,dy=letter_dy}
		add(title,letter)
		letter_sprite+=1
		letter_x+=8
		letter_y+=letter_dy
		if letter_y>25 or letter_y<19 then	
			letter_dy=-letter_dy
		end
	end
end

function update_menu()
	--monsters move to eat cakes
	timer+=1
	if timer>=timer_menu then
		timer=0
		for monster in all(monsters) do
			if monster.y<12 then
				monster.y+=1
				if monster.y==12 then
					sfx(0)
				end
			else
				anim=false
			end
		end
	end
	update_title()
	--press x to start game
	if btnp(—) and not anim then
		sfx(7)
		menu=false
		level_screen=true
		set_level(level)
	end
end

function update_title()
	--makes title letters bounce
	if timer%2==0 then
		for letter in all(title) do
			letter.y+=letter.dy
			if letter.y>25 or letter.y<19 then	
				letter.dy=-letter.dy
			end
		end
	end
end

function draw_menu()
	camera()
	cls(1)
	rectfill(5,17,124,57,0)
	rectfill(4,16,123,56,13)
	line(title[1].x-2,36,title[13].x+8,36,6)
	draw_title()
	if not anim then
		string="press — to start"
		print(string,63-#string*2,44,6)
	end
	draw_wall()
	rectfill(2.5*8,10*8,13.5*8,13*8,13)
	draw_monster()
	--draw cake only if monsters haven't reached them
	if monsters[1].y<12 then
		spr(red_cake,2.5*8,12*8)
		spr(orange_cake,4.5*8,12*8)
		spr(yellow_cake,6.5*8,12*8)
		spr(green_cake,8.5*8,12*8)
		spr(blue_cake,10.5*8,12*8)
		spr(purple_cake,12.5*8,12*8)
	end
end

function draw_title()
	for letter in all(title) do
		spr(letter.sprite,letter.x,letter.y)
	end
end

function draw_wall()
	--draws walls around monsters and cake
	for i=1.5,13.5 do
		spr(16,i*8,9*8)
	end
	for i=1.5,13.5 do
		spr(16,i*8,13*8)
	end
	for i=9,12 do
		spr(16,1.5*8,i*8)
	end
	for i=9,12 do
		spr(16,13.5*8,i*8)
	end
end
-->8
--undo code

function undo()
	--gets info to draw previous tilemap and deletes it
	i=1
	for x=mapx,mapx+15 do
		for y=mapy,mapy+15 do
			mset(x,y,tilemap[i])
			i+=1
		end
	end
	--gets info to draw monsters' previous position
	monsters={}
	for pmonster in all(pmonsters) do
		monster={sprite=pmonster.sprite,x=pmonster.x,y=pmonster.y}
		add(monsters,monster)
	end
end

function get_state()
	--gets current state of screen
	if btnp(”) or
	btnp(ƒ) or
	btnp(‘) or
	btnp(‹) then	
		--gets tilemap 
		get_tilemap()
		--gets monsters 
		get_monsters()
	end
end

function get_tilemap()
	--gets the tiles as they are on the screen
	--table that holds all the tiles
	tilemap={}
	for x=mapx,mapx+15 do
		for y=mapy,mapy+15 do
			tile=mget(x,y)
			add(tilemap,tile)
		end
	end
end

function get_monsters()
	--gets info of all monsters
	pmonsters={}
	for monster in all(monsters) do
		pmonster={sprite=monster.sprite,x=monster.x,y=monster.y}
		add(pmonsters,pmonster)
	end
end
