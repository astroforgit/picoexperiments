--level screens code

function level_screen_setup()
	timer_level_screen=90
end

function update_level_screen()
	timer+=1
	if timer>=timer_level_screen then
		timer=0
		level_screen=false
	end
end

function draw_level_screen()
	camera()
	cls(13)
	string="level "..level
	print(string,63-#string*2+1,49,1)
	print(string,63-#string*2,48,6)
	if level==1 then
		string="welcome to cake monsters!"
		string2="monsters like eating cake"
		print(string,63-#string*2,59,6)
		print(string2,63-#string2*2,67,6)
