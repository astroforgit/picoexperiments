pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--connect four +
--by flapje (@1flapje)


cx=4
cy=4
p=-1

ani={t=0}
ant=0
smode=false

tps={}
drs={}

bg={}

pnts={}
pnts[1]=0
pnts[-1]=0
mp=10

aipl=0
aivsai=false
function initgame()
 music(0)
 for i=1,9*9+1 do
  field[i]=0
 end
 for x=0,8 do
  tf[x]={}
  ac[x]={}
  for y=0,8 do
   tf[x][y]=false
   ac[x][y]=false
  end
 end
 for i=1,30 do
  bg[i]={x=rnd(128),y=rnd(128),
         xv=rnd(2)+1,yv=rnd(2)-1,c=i%2==0}
 end
 cx=4
 cy=4
 p=-1
  
 tps={}
 drs={}
 
 pnts={}
 pnts[1]=0
 pnts[-1]=0
end

function drawgame()
 cls()
 --ani
 if ant>0 and ani.t=="fade" then
  local fo=flr(ant/20*3)
  fade(fo)
 end
 
 for b in all(bg) do
  local c=14
  if(b.c)c=13
  circfill(b.x,b.y,7,c)
 end
 for b in all(bg) do
  local c=8
  if(b.c)c=12
  circfill(b.x,b.y,5,c)
  circfill(b.x-2,b.y-2,1,7)
  b.x+=b.xv
  b.y+=b.yv
  if b.x>135 then
   b.x=-15
   b.y=rnd(128)
   b.xv=rnd(2)+1
   b.yv=rnd(2)-1
  end
 end
 
 rectfill(xo,yo,xo+72,yo+72,0)
 if ant>0 then
  if ani.t=="fall" then
   fspr(gs(ani.p),ani.x,li(-1,ani.y,(8-ant)^2/64))
  end
 end
 
 map(0,0,xo-8,yo-8)
 for x=0,8 do
  for y=0,8 do
   if(gp(x,y,0)!=0)fspr(gs(gp(x,y,0)),x,y,0)
--   if(ac[x][y])fspr(23,x,y)
  end
 end
 
-- for p in all(tps) do
--  fspr(22,p.x,p.y)
-- end
 --if(#tps!=0)while not btn(Ž) do flip() end
 
 if ant==0 then
  fspr(gs(p),cx,-1)
  if top(cx,0)>-1 then
   fspr(gs(p)+3,cx,top(cx,0))
  end
 else
  if ani.t=="win" then
   for d in all(ani.dp) do
    local x=sx(d.xb+d.xm*1.5)+4
    local y=sy(d.yb+d.ym*1.5)+4
    circ(x,y,(ant/2)^3,gc(d.tp))
   end
  elseif ani.t=="boom" then
   for p in all(ani.ps) do
    if(ant<6)circ(p.x,p.y,(12-ant)*8,p.c)
    if(ant>=6)circfill(p.x,p.y,(12-ant)*8,p.c)
   end
  elseif ani.t=="seek" then
   for p in all(ani.ps) do
    local x0=li(p.x0,p.x1,(5-ant)/5)
    local y0=li(p.y0,p.y1,(5-ant)/5)
    local x1=li(p.x0,p.x1,(10-ant)/5)
    local y1=li(p.y0,p.y1,(10-ant)/5)
    line(x0+1,y0+1,x1,y1,7)
    line(x0+1,y0-1,x1,y1,7)
    line(x0-1,y0+1,x1,y1,7)
    line(x0-1,y0-1,x1,y1,7)
    line(x0,y0,x1,y1,7)
   end
  elseif ani.t=="gwin" then
   local t=200-ant
   t*=4
   for i=0,min(23*23,t) do
    local x=(i%23)*6-5
    local y=122-flr(i/23)*6
    if(t-i<70)y=li(-7,y,min((t-i)^2/70^2,1))
    local c=gs(ani.p)
    if(ani.p==0)c=gs((i%2)*2-1)
    spr(c,x,y)
   end
  end
 end
 
 dprint(pnts[-1],10,100,8,7)
 dprint(pnts[1],110,100,12,7)
 
 local m1=pnts[-1]/mp
 local m2=(-pnts[1]/mp)+1
 rectfill(19,98,21+80*m1,103,7)
 rectfill(101,101,19+80*m2,106,7)
 rectfill(20,99,20+80*m1,102,8)
 rectfill(100,102,20+80*m2,105,12)
 
end

function updategame()
 if ant>0 then
  ant-=0.5
  if not smode then
   ant-=0.5
  end
  if ant==0 then
   smode=false
   if ani.t=="fall" then
    sp(ani.x,ani.y,ani.p,0)
    test4win()
   elseif ani.t=="win" then
    if(sf)sfx(1)
    drs=ani.dp
    ani={}
    ani.ps={}
    ani.t="boom"
    ant=12
    for d in all(drs) do
     for o=0,3 do
      local x,y=d.xb+o*d.xm,d.yb+o*d.ym
      rm(x,y,0)
      acir(x,y,d.tp)
     end
    end
    
   elseif ani.t=="boom" then
    ani={}
    ani.t="seek"
    ani.ps={}
    ant=10
    for dr in all(drs) do
     local ps=grndp(-dr.tp,4,0)
     local x0=sx(dr.xb+dr.xm*1.5)+4
     local y0=sy(dr.yb+dr.ym*1.5)+4
     for p in all(ps) do
      local x1=sx(p.x)+4
      local y1=sy(p.y)+4
      add(ani.ps,{x=p.x,y=p.y,
                  x0=x0,y0=y0,
                  x1=x1,y1=y1})
     end
    end
   elseif ani.t=="seek" then
    for p in all(ani.ps) do
     rm(p.x,p.y,0)
    end
    cleanup()
    test4win()
   elseif ani.t=="gwin" then
    smm()
   end
   
  end
 else --no ani
  if(aivsai)aipl=p
  if aivsai and des==-1 then
   aides()
  elseif aipl==p and des==-1 then
   aides()
  end
  for x=0,8 do
   for y=0,8 do
    ac[x][y]=false
   end
  end
  local dp={}
  for p in all(tps) do
   local o=t4r(p.x,p.y,0)
   for d in all(o) do
    add(dp,d)
   end
   del(tps,p)
  end
  if #dp>0 then
   a4r(dp)
   return
  end
  
  if(inp(‹))cx=(cx-1)%9
  if(inp(‘))cx=(cx+1)%9
  if inp(—) then
   local y=top(cx,0)
   if y>-1 then
    --sp(cx,y,p,0)
    if(sf)sfx(0)
    add(tps,{x=cx,y=y})
    afall(p,cx,y)
    if t4r(cx,y,0,p) then
     smode=true
    end
    np()
   end
  end
 end
end
-->8
--helpers

xo=64-9*4
yo=12

field={}
tf={}
ac={}

mu=true
sf=true

function inp(b)
 if p==aipl or aivai then
  local c=aib()
  if(c==— and b==—)des=-1
  return b==c
 end
 return btnp(b)
end

function gp(x,y,ai)
 if(x<0 or x>8 or y<0 or y>8)return 0
 if(ai==1)return aif[x+y*9+1]
 if(ai==0)return field[x+y*9+1]
end

function sp(x,y,p,ai)
 if(ai==1)aif[x+y*9+1]=p
 if(ai==0)field[x+y*9+1]=p
end

function np()
 p*=-1
end

function sx(x)
 return xo+x*8
end

function sy(y)
 return yo+y*8
end

function fspr(s,x,y)
 spr(s,sx(x),sy(y))
end

function dprint(t,x,y,c,c2)
 print(t,x+1,y,c2)
 print(t,x-1,y,c2)
 print(t,x,y+1,c2)
 print(t,x,y-1,c2)
 print(t,x+1,y+1,c2)
 print(t,x-1,y-1,c2)
 print(t,x+1,y-1,c2)
 print(t,x-1,y+1,c2)
 print(t,x,y,c)
end

function gs(p)
 return p/2+1.5
end

function gc(p)
 local c=8
 if(p==1)c=12
 return c
end

function li(a,b,v)
 v=min(1,max(0,v))
 return a+(b-a)*v
end 

function top(x,ai)
 for y=8,0,-1 do
  if(gp(x,y,ai)==0)return y
 end
 return -1
end

function cdp(x,y,ai)
 if(x<0 or x>8 or y<0 or y>8)return false
 local t=top(x,ai)
 if(t==-1)return false
 return y==t
end

function dell(xd,yd,ai)
 for y=yd,0,-1 do
  sp(xd,y,gp(xd,y-1,ai),ai)
 end
end

function t4r(xo,yo,ai,ct)
 local xm,ym,c
 local xb,yb=nil,nil
 local tp=gp(xo,yo,ai)
 if(ct!=nil)tp=ct
 local dp={}
 if(tp==0)return dp
 for i=0,3 do
  if(i==0)xm,ym=1,0
  if(i==1)xm,ym=0,1
  if(i==2)xm,ym=1,1
  if(i==3)xm,ym=-1,1
  xb,yb=nil,nil
  c=0
  for o=-3,3 do
   local x,y=xo+o*xm,yo+o*ym
   local fp=gp(x,y,ai)
   if ct!=nil and o==0 then
    fp=ct
   end
   if fp==tp and not ac[x][y] then
    if xb==nil then
     xb,yb=x,y
    end
    c+=1
    if c==4 then
     if(ct!=nil)return true
     if(ai==0)pnts[tp]+=1
     if(ai==1)aip[tp]+=1
     if(ai==0)p=tp
     o=3--continu
     add(dp,{xb=xb,yb=yb,xm=xm,ym=ym,tp=tp})
    end
   else
    xb,yb=nil,nil
    c=0
   end
  end
 end
 if(ct!=nil)return false
 if ai==0 then
  for d in all(dp) do
   for o=0,3 do
    ac[d.xb+d.xm*o][d.yb+d.ym*o]=true
   end
  end
 end
 return dp
end

function grndp(p,c,ai)
 local cat={}
 for x=0,8 do
  for y=0,8 do
   if(gp(x,y,ai)==p)add(cat,{x=x,y=y})
  end
 end
 local f={}
 c=min(#cat,c)
 for i=0,c-1 do
  local d=cat[flr(rnd(#cat))+1]
  add(f,d)
  del(cat,d)
 end
 return f
end

function rm(x,y,ai)
 sp(x,y,0,ai)
 if(ai==0)tf[x][y]=true
end

function cleanup()
 for x=0,8 do
  for y=8,0,-1 do
   if tf[x][y]==true then
    for yo=0,y do
     add(tps,{x=x,y=yo})
    end
    y=0
   end
  end
 end
 for x=0,8 do
  for y=0,8 do
   if tf[x][y] then
    dell(x,y,0)
    tf[x][y]=false
   end
  end
 end
end

function test4win()
 local sw=false
 if pnts[1]>=mp or pnts[-1]>=mp then
  sw=true
 else
  sw=true
  for x=0,8 do
   if(gp(x,0,0)==0)sw=false
  end
 end
 if sw then
  music(-1)
  if(sf)sfx(2)
  ant=200
  ani.t="gwin"
  if pnts[1]==pnts[-1] then
   ani.p=0
  elseif pnts[1]>pnts[-1] then
   ani.p=1
  elseif pnts[-1]>pnts[1] then
   ani.p=-1
  end
 end
end

function fade(o)
 for xo=0,1 do
   for y=0,7 do
    local x=112+4*xo
    pal(sget(x,y),sget(x+o,y),1)
   end
  end
end

function a4r(dp)
 ani={}
 ani.t="win"
 ani.dp=dp
 ant=10
end

function afall(p,x,y)
 ani.t="fall"
 ani.p=p
 ani.x=x
 ani.y=y
 ant=8
end

function acir(x,y,p)
 add(ani.ps,{x=sx(x)+3,y=sy(y)+3,c=gc(p)})
end
-->8
-- ai

des=-1
aif={}
aip={}
function aib()
 if(cx<des)return ‘
 if(cx>des)return ‹
 if cx==des then
  return —
 end
end

function aides()
 local ws={}
 for x=0,8 do
  for i=1,#field do
  aif[i]=field[i]
  end
  aip[1]=0
  aip[-1]=0
  ws[x]=getw(x)
 end
 
 local hw=-32768 --lowest posible
 
 for i=0,8 do
  if ws[i]>hw then
   des=i
   des=i
   hw=ws[i]
  elseif ws[i]==hw and rnd(9)<1 then
   des=i
   hw=ws[i]
  end
 end
end

function getw(xo)
 local p=aipl
 local yo=top(xo,1)
 if yo>-1 then
  sp(xo,yo,p,1)
  t4r(xo,yo,1)

  if(aip[p]>aip[-p])return aip[p]*1000
  
  return evals(p)
  
 else
  return -100
 end
end

function evals(p)
 local xm,ym
 local s=0
 for i=0,3 do
  if(i==0)xm,ym=1,0
  if(i==1)xm,ym=0,1
  if(i==2)xm,ym=1,1
  if(i==3)xm,ym=-1,1
  for x=0,8 do
   for y=0,8 do
    s+=evalp(x,y,xm,ym,p)
   end
  end
 end
 return s
end

function evalp(x,y,xm,ym,p)
 local tp=gp(x,y,1)
 if(tp==0) return 0
 if(gp(x-xm,y-ym,1)==tp)return 0
 local l=0
 while gp(x+xm*l,y+ym*l,1)==tp do
  l+=1
 end
 if cdp(x+xm*l,y+ym*l,1) then
  l+=1
  while gp(x+xm*l,y+ym*l,1)==tp do
   l+=1
  end
  l-=1
 end
 
 local x0,y0=x-xm,y-ym
 local x1,y1=x+xm*l,y+ym*l
 local m=0
 
 m+=evalse(x0,y0,tp)
 m+=evalse(x1,y1,tp)
 
 if(tp!=p)m*=-3
 return (l^2)*m
end

function evalse(x,y,tp)
 if x<0 or x>8 or
    y<0 or y>8 then return 0 end
 if(gp(x,y,1)==-tp)return 0
 if(y==8)return 0.5
 if(gp(x,y+1,1)!=0)return 0.5
 return 0
 
end

--[[function evals(p)
 local s=0
 
 for y=0,8 do
  for x=0,8 do
   --test evry side
   local tp=gp(x,y,1)
   local m=p*tp
   if(m==-1)m=-2
   if m!=0 then
    for xo=-1+x,1+x do
     for yo=-1+y,1+y do
      if y!=yo or x!=xo then
       if xo>=0 and xo<=8 and
          yo>=0 and yo<=8 then
        
        if gp(xo,yo,1)==tp then
         s+=2*m
        elseif gp(xo,yo,1)==-tp then
         s+=-2*m
        elseif gp(xo,yo-1,1)!=0 then
         s+=1*m
        elseif yo==8 then
         s+=1*m
        end
        
       end
      end 
     end
    end
   end
     
  end
 end
 return s
end]]
-->8
--menu

mode="start"
sel=1

isair=false
isaib=true
function initmenu()
end

function drawmenu()
 cls()
 
 if ani.t=="fade" and ant>0 then
  local fo=flr((ant-20)/20*-4+4)
  fade(fo)
 end
 
 for o=-10,10 do
  local p=o+sin((t()/5))
  line(p*6+64,0,p*48+64,128,3)
  p=(o+10+(t()/1.5)%1)^2-1
  line(0,p,128,p,3)
 end
 palt(0,false)
 palt(1,true)
 spr(64,64-11*4,10,11,3)
 spr(112,65-9*4,22,9,3)
 palt()
 
 if mode=="start" then
  dprint("press — to start",
        64-2*17,64,6,0)
 elseif mode=="seti" then
  rectfill(14,44,128-14,88,0)
  rect(15,45,128-15,87,7)
  --r
  if isair then
   spr(16,22,50,2,2)
   print("ai",26,70,8)
  else
   spr(18,22,50,2,2)
   print("human",20,70,8)
  end
  if(sel==0)rect(18,48,40,84,10)
  --b
  pal(8,12,0)
  if isaib then
   spr(16,92,50,2,2)
   print("ai",96,70,8)
  else
   spr(18,92,50,2,2)
   print("human",90,70,8)
  end
  pal(8,8,0)
  if(sel==2)rect(88,48,110,84,10)
  --mid
  spr(75,54,50,3,3)
  local c=6
  if(sel==1 and ant==0)c=9
  print("start",56,73,c)
  
  dprint("‹ ‘ to move, — to select",0,120,1,0)
 end
end

function updatemenu()
 if ant>0 then
  ant-=1
  if ant==20 and ani.t=="fade" then
   smg()
  end
 else
  if mode=="start" then
   if(btnp(—))mode="seti"
  elseif mode=="seti" then
   if(btnp(‹))sel=(sel-1)%3
   if(btnp(‘))sel=(sel+1)%3
   if btnp(—) then
    if sel==0 then
     isair=not isair
    elseif sel==1 then
     if not isair and
        not isaib then
      aipl=0
      aivsai=false
     elseif isair and
        not isaib then
      aipl=-1
      aivsai=false
     elseif not isair and
                isaib then
      aipl=1
      aivsai=false
     elseif isair and
            isaib then
      aivsai=true
     end
     ant=40
     ani.t="fade"
    elseif sel==2 then
     isaib=not isaib
    end
   end
  end
 end
end
-->8
--control

screen="menu"

function tm()
 mu=not mu
 if mu and screen=="game" then
  music(0)
 end
 if not mu then
  music(-1)
 end
end

function ts()
 sf=not sf
end

function _init()
 mode="start"
 menuitem(1,"toggel music",tm)
 menuitem(2,"toggel sfx",ts)
 menuitem(3,"back to menu",smm)
 smm()
end

function _draw()
 draw()
end

function _update()
 update()
end

function smg()
 screen="game"
 initgame()
 draw=drawgame
 update=updategame
end

function smm()
  music(-1)
 screen="menu"
 initmenu()
 draw=drawmenu
 update=updatemenu
end
