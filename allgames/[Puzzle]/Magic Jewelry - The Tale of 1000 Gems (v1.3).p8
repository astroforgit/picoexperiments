pico-8 cartridge // http://www.pico-8.com
version 7
__lua__
-- magic jewelry the tale of 1k gems
-- a game by adrian09_01 - p8jam2

mapx = 0
mapy = 0
block1 = 0
block2 = 0
block3 = 0
tempblock1 = 0
tempblock3 = 0
x = 4
y = 3
falldelay = 2
resetdelay = 2
setx = 0
sety = 0
blocks = 0
scr = 0
block = 0
gem = 0
lvl = 0
mat = nil
flame = 0
moony = 128
col1 = 2
col2 = 14
nextgem = nextgemrule
bl = 0
mus = 0
gain = 0
gainx = 128
gainy = 0
gems = 0
flash = 0
menu = true
editrules = true
menusel = 0
mode = 0
normalhi = 10
timedhi = 10
timed = false
timeleft = 5000
val = 0
nextgemrule = 70
gemscorerule = 1
speedrule = 2
initialspeedrule = 50
currentrule = 0
savehisc = false
continues = 2

function _init()
for resx=1,6,1 do
  	for resy=1,13,1 do
    	 mset(resx, resy, 1)
   end
end  
init_blocks()
random_blocks()
mapx = 0
mapy = 0
block1 = 0
block2 = 0
block3 = 0
tempblock1 = 0
tempblock3 = 0
x = 4
y = 3
falldelay = 50
resetdelay = 50
setx = 0
sety = 0
blocks = 0
scr = 0
block = 0
gem = 0
lvl = 0
mat = nil
flame = 0
moony = 128
col1 = 2
col2 = 14
nextgem = nextgemrule
bl = 0
mus = 0
gain = 0
gainx = 128
gainy = 0
gems = 0
over = false
flash = 0
oversfx = false
menu = true
menuwait = 0
mode = 0
timed = false
timeleft = 5000
palette = 0
editrules = false
continues = 2
end

function _update()
if not menu then
if not over then
timeleft -= 0.50
if timeleft <= 4930 then
move_player()
check(13, 6)
if timeleft == 4930 then music(mus*2) end
if not timed then
if timeleft <= 4900 then timeleft = 4900 end
end
if timeleft <= 0 then
over = true
end
end
for falx=1,6,1 do
  	for faly=1,13,1 do
    	 fall_down(falx,faly)
   end
end  
end
if over then 
game_over()
if not oversfx then
sfx(40)
oversfx = true
end
end
end
end

function _draw()
-- draws
if menu then
if not editrules then 
draw_title()
end
if editrules then
draw_rules()
end
end
if not menu then
draw_map()
draw_moon()
if not over then
draw_block()
end
draw_next()
draw_score()
draw_flame()
draw_gain()
pal(5, col1 ,1)
pal(6, col2 ,1)
if oversfx then
draw_gover()
if secret then
secret_screen()
end
end
end
end

function set_palette(x)
if x == 0 then
col1 = 2
col2 = 14
end
if x == 1 then
col1 = 5
col2 = 6
end
if x == 2 then
col1 = 2
col2 = 13
end
if x == 3 then
col1 = 3
col2 = 11
end
if x == 4 then
col1 = 14
col2 = 2
end
if x == 5 then
col1 = 11
col2 = 3
end
if x == 6 then
col1 = 8
col2 = 10
end
if x == 7 then
col1 = 12
col2 = 1
end
if x == 8 then
palette = 0
col1 = 2
col2 = 14
end
end

function draw_rules()
rectfill(0, 0, 128, 128, 0)
if currentrule == 4 then
waitdelay = 0
currentrule = 0
editrules = false
end
if currentrule == 3 then
print("start speed "..initialspeedrule, 29, 47, 5)
print("start speed "..initialspeedrule, 28, 46, 7)
if (btnp(0)) then initialspeedrule -= 1 end
if (btnp(1)) then initialspeedrule += 1 end
if (btnp(5)) then currentrule += 1 end
end
if currentrule == 2 then
print("speed increase +"..speedrule, 29, 47, 5)
print("speed increase +"..speedrule, 28, 46, 7)
if (btnp(0)) then speedrule -= 1 end
if (btnp(1)) then speedrule += 1 end
if (btnp(5)) then currentrule += 1 end
end
if currentrule == 1 then
print("gem score x"..gemscorerule, 29, 47, 5)
print("gem score x"..gemscorerule, 28, 46, 7)
if (btnp(0)) then gemscorerule -= 1 end
if (btnp(1)) then gemscorerule += 1 end
if (btnp(5)) then currentrule += 1 end
end
if currentrule == 0 then
print("to magical gem "..nextgemrule, 29, 47, 5)
print("to magical gem "..nextgemrule, 28, 46, 7)
if (btnp(0)) then nextgemrule -= 1 end
if (btnp(1)) then nextgemrule += 1 end
if (btnp(5)) then currentrule += 1 end
end
print("changing rules won't", 29, 65, 5)
print("changing rules won't", 28, 64, 7)
print("let you save hi-score", 29, 73, 5)
print("let you save hi-score", 28, 72, 7)
map(0, 21, 0, 0, 16, 16)
savehisc = false
end

function draw_title()
sfx(-1)
over = false
oversfx = false
music(-1)
rectfill(0, 0, 128, 128, 0)
map(0, 17, 28, 14, 11, 3)
print("normal hi-sc "..normalhi.."00", 29, 47, 5)
print("normal hi-sc "..normalhi.."00", 28, 46, 7)
print("timed  hi-sc "..timedhi.."00", 29, 57, 5)
print("timed  hi-sc "..timedhi.."00", 28, 56, 7)
print("push o for normal, x for timed", 5, 73, 5)
print("push o for normal, x for timed", 4, 72, 7)
print("push the up key to edit rules!", 5, 81, 5)
print("push the up key to edit rules!", 4, 80, 7)
print("made by adrian09_01 for p8jam2", 5, 96, 5)
print("made by adrian09_01 for p8jam2", 4, 95, 7)
print("a demake of a game by", 22, 104, 5)
print("a demake of a game by", 21, 103, 7)
print("the taiwanese guy hwang shinwei", 3, 113, 5)
print("the taiwanese guy hwang shinwei", 2, 112, 7)
if btnp(5) and menuwait > 50 then 
menu = false
ready_game() 
end
if btnp(2) and menuwait > 50 then
editrules = true
music(21)
end
if btnp(4) and menuwait > 50 then 
timed = true
ready_game()

menu = false 
end
menuwait += 1
resetdelay = initialspeedrule
nextgem = nextgemrule
end

function ready_game()
music(16)
end

function draw_gover()
if over then
rectfill(16, 24, 48, 32, 0)
if flash <= 25 then
print("you lose", 17, 25, 5)
end
if flash >= 50 then flash = 0 end
flash += 1
end
end

function draw_gain()
print(gain.."00", gainx+1, gainy+1, 5)
print(gain.."00", gainx, gainy, 7)
gainx += 3
end

function draw_moon()
spr(51, 64, moony)
moony -= 1
if (moony <= -20) moony = 128
end

function draw_map()
-- this function goes thru
-- the map and draws it
-- loop thru the map
rectfill(0, 0, 128, 128, 0)
for mapx=0,64,1 do
	for mapy=0,64,1 do
	 -- draw a sprite
	 spr(mget(mapx, mapy),mapx * 8, mapy * 8)
	end
end
end

function draw_block()
spr(block3 + 2, x * 8, y * 8)
spr(block2 + 2, x * 8, (y - 1) * 8)
spr(block1 + 2, x * 8, (y - 2) * 8)
end

function draw_next()
print("next", 95, 9, 5)
print("next", 94, 8, 7)
spr(nextblock3 + 2, 12 * 8 - 2, 4 * 8)
spr(nextblock2 + 2, 12 * 8 - 2, (4 - 1) * 8)
spr(nextblock1 + 2, 12 * 8 - 2, (4 - 2) * 8)
end

function draw_flame()
flame += 1
if (flame < 12) spr(50, 59, 88)
if (flame >= 12) spr(50, 60, 88)
if (flame >= 25) flame = 0
end

function draw_score()
print("score", 95, 49, 1)
print("score", 94, 48, 12)
if scr > 0 then
print(scr.."00", 95, 57, 1)
print(scr.."00", 94, 56, 12)
end
if scr == 0 then
print(scr, 95, 57, 1)
print(scr, 94, 56, 12)
end
print("gems", 95, 73, 4)
print("gems", 94, 72, 9)
print(gem, 95, 81, 4)
print(gem, 94, 80, 9)
print("level", 95, 97, 3)
print("level", 94, 96, 11)
print(lvl, 95, 105, 3)
print(lvl, 94, 104, 11)
if timed then
print(flr(timeleft), 1, 1, 5)
print(flr(timeleft), 0, 0, 7)
end
end

function move_player()
-- let the player move left
-- and right
if mget(4, 2) ~= 1 then over = true end
if not over then
if (mget(x, y + 1) ~= 1) then
 if falldelay <= 2 or (btnp(3)) then
  solidize_blocks()
 end
end
if (btnp(0)) then
if (x > 1 and mget(x - 1, y) == 1) x -= 1  
sfx(0)
end
if (btnp(1)) then
if (x < 6 and mget(x + 1, y) == 1) x += 1
sfx(0)
end
if (btnp(5)) then 
swap_blocks_acwise()
sfx(2)
end
if (btnp(4)) then 
swap_blocks_cwise()
sfx(2)
end
if (btnp(2)) then
rotate_blocks()
sfx(2)
end
if (btnp(3)) then
 if (mget(x, y + 1) == 1) then
 falldelay = 0 
 end
end
falldelay -= 1
if (falldelay <= 0) then
if (mget(x, y + 1) == 1) then
y += 1
falldelay = resetdelay
sfx(0)
end
end
end
end

function random_blocks()
-- give random blocks
nextblock1 = flr(rnd(5))
nextblock2 = flr(rnd(5))
nextblock3 = flr(rnd(5))
end

function init_blocks()
-- give random blocks
block1 = flr(rnd(5))
block2 = flr(rnd(5))
block3 = flr(rnd(5))
end

function solidize_blocks()
if block1 < 5 then
mset(x, y, block3 + 2)
mset(x, y - 1, block2 + 2)
mset(x, y - 2, block1 + 2)
end
if block1 == 5 then
lvl += 1
next_level()
bl = mget(x, y+1)
destroy_map(bl)
end
block1 = nextblock1
block2 = nextblock2
block3 = nextblock3
random_blocks()
if nextgem <= 0 then
special_block()
end
x = 4
y = 3
sfx(3)
end

function swap_blocks_acwise()
tempblock1 = block1
block1 = block2
block2 = block3
block3 = tempblock1
end

function rotate_blocks()
tempblock1 = block1
block1 = block3
block2 = block2
block3 = tempblock1
end

function swap_blocks_cwise()
tempblock3 = block3
block3 = block2
block2 = block1
block1 = tempblock3
end

function check(w, h)
    -- horizonta
    for i=1, h do
        local l=1 -- the length of the current "streak"
        for j=2, w do
            if mget(i,j)==mget(i, j-1) and mget(i, j)~=1 then
                l = l + 1 -- "streak" gets bigger
            else
                if l >= 3 then -- remove the blocks
                    for q=j-l, j-1 do
                        mset(i, q, 1)
                        scr += gemscorerule * l
                        gem += 1
                        gain = gemscorerule * l
                        sfx(1)
                        gainx = 0
                        gainy = y * 8
                        nextgem -= 1
                    end
                end
                l=1
            end
        end
        if l >= 3 then
            for q=w-l+1, w do
                mset(i, q, 1)
                scr += gemscorerule * l
                gem += 1
                gain = gemscorerule * l
                sfx(1)
                gainx = 0
                gainy = y * 8
                nextgem -= 1
            end
        end
    end
    
    -- vertical
    for j=1, w do
        local l=1 -- the length of the current "streak"
        for i=2, h do
            if mget(i, j)==mget(i-1, j) and mget(i, j) ~= 1 then
                l = l + 1 -- "streak" gets bigger
            else
                if l >= 3 then -- remove the blocks
                    for q=i-l, i-1 do
                        mset(q, j, 1)
                        scr += gemscorerule * l
                        gem += 1
                        gain = gemscorerule * l
                        sfx(1)
                        gainx = 0
                        gainy = y * 8
                        nextgem -= 1
                    end
                end
                l=1
            end
        end
        if l >= 3 then
            for q=h-l+1, h do
                mset(q, j, 1)
                scr += gemscorerule * l
                gem += 1
                gain = gemscorerule * l
                sfx(1)
                gainx = 0
                gainy = y * 8
                nextgem -= 1
            end
        end
        -- primary pseudodiagonals ( tl -> br )
    -- first half
    for i=h-2, 1, -1 do
        local ii, jj, l = i+1, 2, 1
        repeat 
            if mget(ii-1, jj-1) == mget(ii, jj) and mget(ii-1, jj-1) ~= 1 then
                l = l + 1
            else
                if l >= 3 then
                    for q = jj - l, jj - 1 do
                        mset(i+q-1, q, 1)
                        scr += gemscorerule * l
                        gem += 1
                        gain = gemscorerule * l
                        sfx(1)
                        gainx = 0
                        gainy = y * 8
                        nextgem -= 1
                    end
                end
                l=1
            end
            ii = ii + 1
            jj = jj + 1
        until ii > h or jj > w
        if l >= 3 then
            for q = jj - l, jj - 1 do
                mset(i+q-1, q, 1)
                scr += gemscorerule * l
                gem += 1
                gain = gemscorerule * l
                sfx(1)
                gainx = 0
                gainy = y * 8
                nextgem -= 1
            end
        end
    end

    -- second half
    for j=1, w do
        local ii, jj, l = 2, j+1, 1
        repeat 
            if mget(ii-1, jj-1) == mget(ii, jj) and mget(ii-1, jj-1) ~= 1 then
                l = l + 1
            else
                if l >= 3 then
                    for q = ii - l, ii - 1 do
                        mset(q, j+q-1, 1)
                        scr += gemscorerule * l
                        gem += 1
                        gain = gemscorerule * l
                        sfx(1)
                        gainx = 0
                        gainy = y * 8
                        nextgem -= 1
                    end
                end
                l=1
            end
            ii = ii + 1
            jj = jj + 1
        until ii > h or jj > w
        if l >= 3 then
            for q = ii - l, ii - 1 do
                mset(q, j+q-1, 1)
                scr += gemscorerule * l
                gain = gemscorerule * l
                sfx(1)
                gainx = 0
                gainy = y * 8
                gem += 1
                nextgem -= 1
            end
        end
    end
    

    -- secondary pseudodiagonals ( tr -> bl )
    -- mirror the thing
    mirror(w, h)
    -- do what we did earlier
    -- first half
    for i=h-2, 1, -1 do
        local ii, jj, l = i+1, 2, 1
        repeat 
            if mget(ii-1, jj-1) == mget(ii, jj) and mget(ii-1, jj-1) ~= 1 then
                l = l + 1
            else
                if l >= 3 then
                    for q = jj - l, jj - 1 do
                        mset(i+q-1, q, 1)
                        scr += gemscorerule * l
                        gem += 1
                        gain = gemscorerule * l
                        sfx(1)
                        gainx = 0
                        gainy = y * 8
                        nextgem -= 1
                    end
                end
                l=1
            end
            ii = ii + 1
            jj = jj + 1
        until ii > h or jj > w
        if l >= 3 then
            for q = jj - l, jj - 1 do
                mset(i+q-1, q, 1)
                scr += gemscorerule * l
                gem += 1
                gain = gemscorerule * l
                sfx(1)
                gainx = 0
                gainy = y * 8
                nextgem -= 1
            end
        end
    end

    -- second half
    for j=1, w do
        local ii, jj, l = 2, j+1, 1
        repeat 
            if mget(ii-1, jj-1) == mget(ii, jj) and mget(ii-1, jj-1) ~= 1 then
                l = l + 1
            else
                if l >= 3 then
                    for q = ii - l, ii - 1 do
                        mset(q, j+q-1, 1)
                        scr += gemscorerule * l
                        gem += 1
                        gain = gemscorerule * l
                        sfx(1)
                        gainx = 0
                        gainy = y * 8
                        nextgem -= 1
                    end
                end
                l=1
            end
            ii = ii + 1
            jj = jj + 1
        until ii > h or jj > w
        if l >= 3 then
            for q = ii - l, ii - 1 do
                mset(q, j+q-1, 1)
                scr += gemscorerule * l
                gem += 1
                gain = gemscorerule * l
                sfx(1)
                gainx = 0
                gainy = y * 8
                nextgem -= 1
            end
        end
    end
    mirror(w, h)
    end
end

function mirror(w, h)
    local q = {}
    for i=1, h do
        q[i] = {}
        for j=1, w do
            q[i][j] = mget(i, w-j+1)
        end
    end
    for i=1, h do
        for j=1, w do
            mset(i, j, q[i][j])
        end
    end
end

function fall_down(falx, faly)
if (mget(falx, faly > 1) and mget(falx,faly) < 8) then
	if (mget(falx, faly + 1) == 1) then
		mset(falx, faly+1, mget(falx, faly))
		mset(falx, faly, 1)
end
end
end

function next_level()
palette += 1
set_palette(palette)
resetdelay -= speedrule
if (resetdelay <= 2) resetdelay = 2
mus += 1
if mus > 7 then
mus = 0
end
music(mus * 2)
nextgem = nextgemrule
end

function special_block()
block1 = 5
block2 = 5
block3 = 5
end

function destroy_map(bl)
for destx= 1, 6, 1 do
 for desty= 1, 13, 1 do
  if mget(destx, desty) == bl then
   gems += 1
   mset(destx, desty, 1)
   gem += 1
   scr += gemscorerule
   gain = gemscorerule * gems
   sfx(1)
   gainx = 0
   gainy = y * 8
  end
  end
 end
end

function secret_screen()
rectfill(0, 0, 128, 128, 0)
spr(112, 56, 64)
print(continues, 71, 65, 4)
print(continues, 70, 64, 9)
if (btnp(4)) then
over = false
for clex = 1, 6, 1 do
	for cley = 1, 13, 1 do
	mset(clex, cley, 1)
	end
end
game = true
secret = false
end
end

function game_over()
for overx = 1, 6, 1 do
	for overy = 1, 13, 1 do
	mset(overx, overy, 7)
	end
end
if not timed then
if savehisc then
if scr > normalhi then normalhi = scr end
end
if timed then
if scr > timedhi then timedhi = scr end
end
end
if (btn(1) and btn(2) and btn(5) and continues > 0) then
if not secret then
continues -= 1
secret = true
over = false
oversfx = false
end
end
if not secret then
if btnp(5) then _init() end
end
end
