pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- sARAH AND THE lONELY kEY
-- tESSELODE


-- utility functions
local function lerp(a, b, f)
	return a + (b - a) * f
end

-- https://www.lexaloffle.com/bbs/?pid=50555#p
local function sort(a, cmp)
	for i = 1, #a do
		local j = i
		while j > 1 and cmp(a[j-1], a[j]) do
			a[j], a[j-1] = a[j-1], a[j]
			j = j - 1
		end
  	end
end

local function printOutlined(text, x, y, color, outlineColor, align)
	align = align or 0
	local width = #text * 4
	x -= width * align
	if outlineColor then
		for xx = x - 1, x + 1 do
			for yy = y - 1, y + 1 do
				if not (xx == x and yy == y) then
					print(text, xx, yy, outlineColor)
				end
			end
		end
	end
	print(text, x, y, color)
end

-- custom key repeat
local input = {}
for i = 0, 5 do
	input[i] = {
		timer = false,
		pressed = false,
	}
end

local function updateInput()
	for i = 0, 5 do
		input[i].pressed = false
		if not btn(i) then
			input[i].timer = false
		elseif not input[i].timer then
			input[i].pressed = true
			input[i].timer = 15
		else
			input[i].timer -= 1
			if input[i].timer <= 0 then
				input[i].pressed = true
				input[i].timer = 6
			end
		end
	end
end

local function pressed(i) return input[i].pressed end
-- classes
local function makeClass(t, parent)
	t = t or {}
	t.parent = parent
	t.__index = t
	setmetatable(t, {
		__index = parent,
		__call = function(_, ...)
			local instance = setmetatable({}, t)
			if instance.new then instance:new(...) end
			return instance
		end,
	})
	return t
end

local class = {}

class.tile = makeClass({
	blockedBy = {0},
})

function class.tile:new(state, sprite, x, y)
	self.state = state
	self.sprite = sprite
	self.x = x
	self.y = y
	self.displayX = x * 8
	self.displayY = y * 8
	self.history = {
		x = {},
		y = {},
		alive = {},
		currentStep = 1,
	}
end

function class.tile:onBeginTurn()
	self.history.currentStep += 1
end

function class.tile:move(dx, dy)
	-- make the sure there isn't a solid tile at the target location
	for flag in all(self.blockedBy) do
		if fget(mget(self.x + dx, self.y + dy), flag) then
			return false
		end
	end
	-- push entities
	for other in all(self.state.entities) do
		if not other.destroyed then
			if other.x == self.x + dx and other.y == self.y + dy then
				if not other:onPush(self, dx, dy) then return end
			end
		end
	end
	self.history.x[self.history.currentStep] = self.x
	self.history.y[self.history.currentStep] = self.y
	self.x = self.x + dx
	self.y = self.y + dy
	-- touch entities
	for other in all(self.state.entities) do
		if not other.destroyed then
			if other.x == self.x and other.y == self.y then
				if other.onTouch then other:onTouch(self) end
			end
		end
	end
	return true
end

function class.tile:destroy()
	self.history.alive[self.history.currentStep] = true
	self.destroyed = true
	if self.onDestroy then self:onDestroy() end
end

function class.tile:onUndo()
	if self.history.x[self.history.currentStep] then
		self.x = self.history.x[self.history.currentStep]
	end
	if self.history.y[self.history.currentStep] then
		self.y = self.history.y[self.history.currentStep]
	end
	if self.history.alive[self.history.currentStep] then
		self.destroyed = false
	end
	for k, v in pairs(self.history) do
		if k ~= 'currentStep' then
			self.history[k][self.history.currentStep] = nil
		end
	end
	self.history.currentStep -= 1
end

function class.tile:update()
	local targetDisplayX, targetDisplayY = self.x * 8, self.y * 8
	self.displayX = lerp(self.displayX, targetDisplayX, .5)
	if abs(targetDisplayX - self.displayX) < 1 then
		self.displayX = targetDisplayX
	end
	self.displayY = lerp(self.displayY, targetDisplayY, .5)
	if abs(targetDisplayY - self.displayY) < 1 then
		self.displayY = targetDisplayY
	end
end

function class.tile:draw()
	spr(self.sprite, self.displayX, self.displayY)
end

class.player = makeClass({
	type = 'player',
	canPush = true,
	blockedBy = {0, 1}
}, class.tile)

function class.player:new(state, x, y)
	self.parent.new(self, state, 2, x, y)
	self.facing = 0
	self.footstepSound = false
	self.blinkTimer = 150 + rnd(370)
end

function class.player:move(dx, dy)
	if self.parent.move(self, dx, dy) then
		self.footstepSound = not self.footstepSound
		sfx(self.footstepSound and 8 or 10)
	else
		sfx(9)
	end
	if dx == 1 then
		self.facing = 0
	elseif dx == -1 then
		self.facing = 1
	elseif dy == -1 then
		self.facing = 2
	end
end

function class.player:update()
	self.parent.update(self)
	self.blinkTimer -= 1
	if self.blinkTimer <= -22 then
		if rnd() < .15 then
			self.blinkTimer = 30
		else
			self.blinkTimer = 150 + rnd(370)
		end
	end
	self.sprite = 32 + self.facing
	if self.blinkTimer <= 0 then
		self.sprite += 16
	end
end

class.crate = makeClass({
	canPush = true,
	fillsWater = true,
}, class.tile)

function class.crate:new(state, x, y)
	self.parent.new(self, state, 3, x, y)
end

function class.crate:onPush(other, dx, dy)
	if other.canPush then
		return self:move(dx, dy)
	end
	return false
end

class.water = makeClass({}, class.tile)

function class.water:new(state, x, y)
	self.parent.new(self, state, 4, x, y)
end

function class.water:update()
	self.parent.update(self)
	self.sprite = 36 + flr((t() % 1) * 4)
end

function class.water:onPush(other, dx, dy)
	if other.type == 'player' then
		return false
	else
		other:destroy()
		if other.fillsWater then
			self:destroy()
		end
		return true
	end
end

function class.water:onDestroy()
	for i = 1, 5 do
		add(self.state.entities, class.particle(self.x, self.y, 12, .5))
	end
	for i = 1, 10 do
		add(self.state.entities, class.blobParticle(self.x, self.y, 12))
	end
	sfx(12)
end

class.key = makeClass({
	type = 'key',
	canPush = true,
}, class.tile)

function class.key:new(state, x, y)
	self.parent.new(self, state, 5, x, y)
end

function class.key:onPush(other, dx, dy)
	if other.canPush then
		return self:move(dx, dy)
	end
	return false
end

class.door = makeClass({}, class.tile)

function class.door:new(state, x, y)
	self.parent.new(self, state, 6, x, y)
end

function class.door:onPush(other, dx, dy)
	if other.type == 'key' then
		self:destroy()
		other:destroy()
		return true
	end
	return false
end

function class.door:onDestroy()
	self.state.screenShakeAmount += 4
	for i = 1, 30 do
		add(self.state.entities, class.particle(self.x, self.y, 10))
	end
	for i = 1, 15 do
		add(self.state.entities, class.blobParticle(self.x, self.y, 10))
	end
	sfx(16)
end

class.switch = makeClass({
	z = -10,
}, class.tile)

function class.switch:new(state, x, y, color)
	self.parent.new(self, state, 0, x, y)
	self.color = color
	self.history.color = {}
end

function class.switch:onPush(other)
	return true
end

function class.switch:onTouch(other)
	if self.state.activeColor ~= self.color then
		self.history.color[self.history.currentStep] = self.state.activeColor
		self.state.activeColor = self.color
		sfx(12 + self.color)
	end
end

function class.switch:onUndo()
	if self.history.color[self.history.currentStep] then
		self.state.activeColor = self.history.color[self.history.currentStep]
	end
	self.parent.onUndo(self)
end

function class.switch:update()
	if self.color == self.state.activeColor then
		self.sprite = 10 + 16 * (self.color - 1)
	else
		self.sprite = 11 + 16 * (self.color - 1)
	end
end

class.switchBlock = makeClass({
	z = -10,
}, class.tile)

function class.switchBlock:new(state, x, y, color)
	self.color = color
	self.green = green
	self.parent.new(self, state, 0, x, y)
end

function class.switchBlock:update()
	if self.state.activeColor == self.color then
		self.sprite = 9 + 16 * (self.color - 1)
	else
		self.sprite = 8 + 16 * (self.color - 1)
	end
end

function class.switchBlock:onPush(other)
	return self.color == self.state.activeColor
end

class.flag = makeClass({
	z = -10,
}, class.tile)

function class.flag:new(state, x, y)
	self.parent.new(self, state, 7, x, y)
end

function class.flag:onPush(other, dx, dy)
	if other.type == 'player' then
		self.state:onFlagReached()
		for i = 1, 30 do
			add(self.state.entities, class.particle(self.x, self.y, 12))
			add(self.state.entities, class.particle(self.x, self.y, 14))
		end
		for i = 1, 15 do
			add(self.state.entities, class.blobParticle(self.x, self.y, 12))
			add(self.state.entities, class.blobParticle(self.x, self.y, 14))
		end
	end
	return true
end

class.particle = makeClass()

function class.particle:new(x, y, color, life)
	life = life or 1
	self.x = x * 8 + 4
	self.y = y * 8 + 4
	self.color = color
	self.life = (60 + rnd(60)) * life
	self.speed = (1 + rnd(2)) * sqrt(life)
	self.damping = .01 + rnd(.02)
	self.angle = rnd()
	self.angularVelocity = -.005 + rnd(.01)
end

function class.particle:update()
	self.angularVelocity += -.005 + rnd(.01)
	self.angularVelocity = lerp(self.angularVelocity, 0, .1)
	self.angle += self.angularVelocity
	self.speed = lerp(self.speed, 0, self.damping)
	self.x += self.speed * cos(self.angle)
	self.y += self.speed * sin(self.angle)
	self.life -= 1
	if self.life <= 0 then
		self.removeFromPool = true
	end
end

function class.particle:draw()
	local x1, y1 = self.x, self.y
	local x2 = x1 - self.speed * cos(self.angle)
	local y2 = y1 - self.speed * sin(self.angle)
	line(x1, y1, x2, y2, self.color)
end

class.blobParticle = makeClass()

function class.blobParticle:new(x, y, color)
	self.x = x * 8 + 4
	self.y = y * 8 + 4
	self.color = color
	self.life = 15 + rnd(30)
	self.speed = 1 + rnd(1)
	self.damping = .02 + rnd(.04)
	self.angle = rnd()
end

function class.blobParticle:update()
	self.speed = lerp(self.speed, 0, self.damping)
	self.x += self.speed * cos(self.angle)
	self.y += self.speed * sin(self.angle)
	self.life -= 1
	if self.life <= 0 then
		self.removeFromPool = true
	end
end

function class.blobParticle:draw()
	circfill(self.x, self.y, self.life / 45 * 3, self.color)
end

class.windParticles = makeClass({
	baseSpeed = .75,
})

function class.windParticles:new()
	self.particles = {}
	for i = 1, 100 do
		add(self.particles, {
			x = rnd(128),
			y = -128 + rnd(256),
			vx = .75 + rnd(.75),
			vy = .5 + rnd(.25),
		})
	end
end

function class.windParticles:update()
	for particle in all(self.particles) do
		particle.vx += (-.0125 + rnd(.025)) * self.baseSpeed
		particle.vy += (-.0125 + rnd(.025)) * self.baseSpeed
		particle.x -= (particle.vx) * self.baseSpeed
		particle.y += (particle.vy) * self.baseSpeed
		if particle.x < 0 then
			particle.x = 129 + rnd(16)
			particle.y = -128 + rnd(256)
			particle.vx = 1 + rnd(.5)
			particle.vy = .5 + rnd(.25)
		end
	end
end

function class.windParticles:draw()
	for particle in all(self.particles) do
		pset(particle.x, particle.y, 1)
	end
end
-- states
local currentState
local function gotoState(state, ...)
	currentState = state
	if state.enter then state:enter(...) end
end

local state = {}

state.title = {}

function state.title:enter()
	self.windParticles = class.windParticles()
	self.transitioning = false
	self.panY = -200
	self.panVelocity = 0
	music(28)
end

function state.title:update()
	self.windParticles:update()
	if self.transitioning then
		self.panVelocity += .05
		self.panY += self.panVelocity
		if self.panY > 300 then
			gotoState(state.intro)
		end
	elseif btnp(4) then
		self.transitioning = true
		sfx(26)
		music(-1)
	else
		self.panY = lerp(self.panY, 0, .05)
		if abs(self.panY) < .5 then self.panY = 0 end
	end
end

function state.title:draw()
	camera(0, self.panY)
	self.windParticles:draw()
	printOutlined('sarah and the lonely key', 64, 32, 6, 1, .5)
	spr(5, 60, 60 + 2.99 * sin(t() / 4))
	printOutlined('press Ž to start', 64, 96, 6, 1, .5)
	printOutlined('(KEYBOARD: z)', 64, 104, 5, 0, .5)
	camera()
end

state.intro = {}

function state.intro:enter()
	self.textX = 34
	self.textY = 61
	self.timer = 240
	music(0)
end

function state.intro:update()
	self.timer -= 1
	if self.timer <= 120 then
		self.textX = lerp(self.textX, 2, 1/20)
		self.textY = lerp(self.textY, 121, 1/20)
		if abs(self.textX - 2) < .5 then self.textX = 2 end
		if abs(self.textY - 121) < .5 then self.textY = 121 end
	end
	if self.timer <= 0 then
		gotoState(state.gameplay)
	end
end

function state.intro:draw()
	printOutlined('keys left: 1', self.textX, self.textY, 6, 1)
end

state.gameplay = {}

function state.gameplay:loadMap()
	self.activeColor = 1
	self.entities = {}
	-- load entities
	for x = 0, 127 do
		for y = 0, 63 do
			local sprite = mget(x, y)
			-- player
			if sprite == 2 then
				if not self.coverMode then
					self.player = add(self.entities, class.player(self, x, y))
				end
				mset(x, y, 0)
			-- crates
			elseif sprite == 3 then
				add(self.entities, class.crate(self, x, y))
				mset(x, y, 0)
			-- water
			elseif sprite == 4 then
				add(self.entities, class.water(self, x, y))
				mset(x, y, 0)
			-- keys
			elseif sprite == 5 then
				add(self.entities, class.key(self, x, y))
				mset(x, y, 0)
			-- doors
			elseif sprite == 6 then
				add(self.entities, class.door(self, x, y))
				mset(x, y, 0)
			-- flags
			elseif sprite == 7 then
				add(self.entities, class.flag(self, x, y))
				mset(x, y, 0)
			-- switches
			elseif sprite == 10 or sprite == 11 then
				add(self.entities, class.switch(self, x, y, 1))
				mset(x, y, 0)
			elseif sprite == 26 or sprite == 27 then
				add(self.entities, class.switch(self, x, y, 2))
				mset(x, y, 0)
			elseif sprite == 42 or sprite == 43 then
				add(self.entities, class.switch(self, x, y, 3))
				mset(x, y, 0)
			-- switch blocks
			elseif sprite == 8 or sprite == 9 then
				add(self.entities, class.switchBlock(self, x, y, 1))
				mset(x, y, 0)
			elseif sprite == 24 or sprite == 25 then
				add(self.entities, class.switchBlock(self, x, y, 2))
				mset(x, y, 0)
			elseif sprite == 40 or sprite == 41 then
				add(self.entities, class.switchBlock(self, x, y, 3))
				mset(x, y, 0)
			end
		end
	end
	-- sort entities
	sort(self.entities, function(a, b) return (a.z or 0) > (b.z or 0) end)
end

function state.gameplay:initCamera()
	self.camera = {x = 0, y = 0}
	if self.player then
		self.camera.x = self.player.displayX - 60
		self.camera.y = self.player.displayY - 60
	end
end

function state.gameplay:enter(coverMode)
	self.coverMode = coverMode
	self:loadMap()
	self:initCamera()
	self.windParticles = class.windParticles()
	self.screenShakeAmount = 0
	self.visibleRadius = 0
	self.musicStartTimer = 60
	self.gameClearTimer = false
	self.gameClearFanfareTimer = false
	if coverMode then
		self.blinkTimer = 150 + rnd(370)
	end
end

function state.gameplay:updateCamera()
	if self.player then
		self.camera.x = self.player.displayX - 60
		self.camera.y = self.player.displayY - 60
	end
end

function state.gameplay:beginTurn(playerDx, playerDy)
	for entity in all(self.entities) do
		if entity.onBeginTurn then
			entity:onBeginTurn()
		end
	end
	self.player:move(playerDx, playerDy)
end

function state.gameplay:undo()
	for entity in all(self.entities) do
		if entity.onUndo then
			entity:onUndo()
		end
	end
	sfx(11)
end

function state.gameplay:onFlagReached()
	self.gameClearTimer = 200
	self.gameClearFanfareTimer = 90
	sfx(32)
end

function state.gameplay:update()
	if self.gameClearTimer then
		self.gameClearTimer -= 1
		self.gameClearFanfareTimer -= 1
		if self.gameClearFanfareTimer == 0 then
			music(31)
		end
		if self.gameClearTimer <= 0 then
			gotoState(state.ending)
		end
	else
		if self.coverMode then
			-- manual camera control
			if btnp(0) then self.camera.x -= 8 end
			if btnp(1) then self.camera.x += 8 end
			if btnp(2) then self.camera.y -= 8 end
			if btnp(3) then self.camera.y += 8 end
		else
			-- movement inputs
			if pressed(0) then self:beginTurn(-1, 0) end
			if pressed(1) then self:beginTurn(1, 0) end
			if pressed(2) then self:beginTurn(0, -1) end
			if pressed(3) then self:beginTurn(0, 1) end
			if pressed(5) then self:undo() end
		end
	end

	-- update entities
	for entity in all(self.entities) do
		if not entity.destroyed then
			if entity.update then entity:update() end
		end
		if entity.removeFromPool then
			del(self.entities, entity)
		end
	end

	-- screen shake
	self.screenShakeAmount = lerp(self.screenShakeAmount, 0, 1/3)
	if self.screenShakeAmount < 1/15 then
		self.screenShakeAmount = 0
	end

	self:updateCamera()

	self.windParticles:update()

	-- square out animation
	if self.visibleRadius < 64 then
		self.visibleRadius = lerp(self.visibleRadius, 72, .05)
	end

	-- music
	if self.musicStartTimer > 0 then
		self.musicStartTimer -= 1
		if self.musicStartTimer <= 0 then
			music(1)
		end
	end

	-- cover mode - sarah blink animation
	if self.coverMode then
		self.blinkTimer -= 1
		if self.blinkTimer <= -22 then
			if rnd() < .15 then
				self.blinkTimer = 30
			else
				self.blinkTimer = 150 + rnd(370)
			end
		end
	end
end

function state.gameplay:getNumberOfKeys()
	local keysLeft = 0
	for entity in all(self.entities) do
		if entity.type == 'key' and not entity.destroyed then
			keysLeft += 1
		end
	end
	return keysLeft
end

function state.gameplay:drawHud()
	rectfill(0, 119, 128, 128, 0)
	local keysLeft = self:getNumberOfKeys()
	local color = keysLeft == 0 and 8 or 6
	local outlineColor = keysLeft == 0 and 2 or 1
	printOutlined('keys left: ' .. tostr(keysLeft), 2, 128-7, color, outlineColor)
	printOutlined('— undo', 128-30, 128-7, 6, 1)
end

function state.gameplay:draw()
	clip(64 - self.visibleRadius, 64 - self.visibleRadius, self.visibleRadius * 2, self.visibleRadius * 2)
	local screenShakeAngle = rnd()
	local screenShakeX = self.screenShakeAmount * cos(screenShakeAngle)
	local screenShakeY = self.screenShakeAmount * sin(screenShakeAngle)
	self.windParticles:draw()
	camera(self.camera.x + screenShakeX, self.camera.y + screenShakeY)
	map(0, 0, 0, 0, 128, 64)
	for entity in all(self.entities) do
		if not entity.destroyed then
			if entity.draw then entity:draw() end
		end
	end
	camera()
	clip()
	if self.coverMode then
		fillp(0b0101101001011010.1)
		circfill(64, 64, 24, 1)
		if self.blinkTimer <= 0 then
			sspr(0, 32, 32, 32, 64-16, 64-16 + 4.99 * sin(t() / 6))
		else
			sspr(96, 0, 32, 32, 64-16, 64-16 + 4.99 * sin(t() / 6))
		end
		spr(59, 32, 48 + 4.99 * cos(t() / 5.5))
		spr(59, 88, 56 + 4.99 * cos(t() / 6.5 + 1/3))
	else
		self:drawHud()
	end
end

state.ending = {}

function state.ending:enter()
	self.blinkTimer = 150 + rnd(370)
end

function state.ending:update()
	self.blinkTimer -= 1
	if self.blinkTimer <= -22 then
		if rnd() < .15 then
			self.blinkTimer = 30
		else
			self.blinkTimer = 150 + rnd(370)
		end
	end
end

function state.ending:draw()
	if self.blinkTimer <= 0 then
		sspr(0, 32, 32, 32, 64-16, 64-16 + 4.99 * sin(t() / 6))
	else
		sspr(96, 0, 32, 32, 64-16, 64-16 + 4.99 * sin(t() / 6))
	end
	spr(59, 32, 48 + 4.99 * cos(t() / 5.5))
	spr(59, 88, 56 + 4.99 * cos(t() / 6.5 + 1/3))
	printOutlined('thank you for playing!', 64, 96, 6, 1, .5)
	printOutlined('@tesselode', 64, 108, 12, 1, .5)
end
-- main loop

function _init()
	gotoState(state.title)
end

function _update60()
	updateInput()
	if currentState.update then currentState:update() end
end

function _draw()
	cls()
	if currentState.draw then currentState:draw() end
end

