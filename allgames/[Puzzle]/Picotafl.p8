--game states

function u_menu()

 m_u_controls()
 m_u_title()
 


end

function d_menu()
 cls(1)
 d_board()
 --d_pieces()
 
 m_d_controls()
 m_d_title()
 
end

function u_play()

 u_controls()
 u_selected()
 u_eatpiece()
 
 if ctrl.selected then
  u_path()
 end
 
 u_win()

end

function d_play()

 d_board()
 d_pieces()
 
 if ctrl.selected then
  d_path(ctrl.piece)
 end
 
 
 d_controls()
 d_ui()
 
end

function u_endgame()

 if win.bx<128 then
  win.bx+=0.1*(135-win.bx)
 elseif win.tx>(64-(#win.str+5)*2) then
  win.tx+=0.1*(30-win.tx)
 else
  win.rx=37
 end
 
 if btnp(5) then
  i_pieces()
  ctrl={
   x=6,
   y=6,
   sprite=1,
   sprites={5,7,9},
   selected=false,
   selt=5,
   xstart=0,
   ystart=0,
   piece=nil,
  }
  win={
   bx=0,
   tx=140,
   rx=140,
   str="hello"
  } 
  game={
   move="BLACK",
   upd=u_play,
   drw=d_play,
  }
  
 end
 
end

function d_endgame()

 d_board()
 d_pieces()
 
 rectfill(0,55,win.bx,57,13)
 rectfill(0,49,win.bx,55,12)

 print(win.str .. " wins!",win.tx,50,7)

 outline("— to restart",win.rx,95,13,1)

end
