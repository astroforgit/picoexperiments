-- player

guy=entity:extend({
 sprite={idle={32}}
})

guy:spawns_from(32)

function guy:init()
 add(guys,self)
end

function guy:idle()
 local mx,my=0,0
 if (btnp(‹)) mx=-1
 if (btnp(‘)) mx=1
 if (btnp(”)) my=-1
 if (btnp(ƒ)) my=1
 
 if mx~=0 or my~=0 then
  local xx,yy=self.pos.x/8+g_level.base.x+mx,
   self.pos.y/8+g_level.base.y+my
   
  if fget(mget(xx,yy),0) then
   shk=1
   return
  end
  
  for g in all(guys) do
   if g.pos.x==self.pos.x+mx*8 and
    g.pos.y==self.pos.y+my*8 then
    shk=1
    return
   end
  end
  
  if self.mx then
   if (self.mx==mx and self.my*-1==my) or
    (self.my==my and self.mx*-1==mx) then
    shk=1
    return
   end
  
   local x,y=self.pos.x/8+g_level.base.x+self.mx,
   self.pos.y/8+g_level.base.y+self.my
   local t=mget(x,y)
   
   if t==1 then
    mset(x,y,0)
   end
  end
 
  self.mx,self.my=mx,my
  sfx(17)
  self:become("move")
 end
end

function guy:move()
 if self.pos.x%8==0 and self.pos.y%8==0 then
  local x,y=self.pos.x/8+g_level.base.x,
   self.pos.y/8+g_level.base.y 
  local tt=mget(x,y)
  
  if tt==16 then
   g_index+=1
   restart_level()
   fade()
   return
  elseif tt==8 then
   mset(x,y,9)
  end
  
  local t=mget(x+self.mx,y+self.my)
  
  if fget(t,0)==true then
   self:become("idle")
   sfx(18)
   return
  end
  
  for g in all(guys) do
   if g.pos.x==self.pos.x+self.mx*8 and
    g.pos.y==self.pos.y+self.my*8 then
    self:become("idle")
   sfx(18)
    return
   end
  end
 end
 
 local s=2
 self.pos.x+=self.mx*s
 self.pos.y+=self.my*s
end

function guy:render()
 if self.mx~=nil then
  if self.mx==0 then
   spr(33,self.pos.x,
   self.pos.y,1,1,false,
   self.my==-1)
  else
   spr(32,self.pos.x,
   self.pos.y,1,1,
   self.mx==-1,false)
  end
 else
  spr(32,self.pos.x,
  self.pos.y)
 end
end
