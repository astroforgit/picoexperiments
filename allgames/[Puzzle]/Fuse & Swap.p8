pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
--fuse into as few shapes as 
--possible by swapping blocks!

gridcursor={}
board={}  --just stats
oldblocks={} --to cancel/undo
gblocks={}
cam={}

function _init()
 cartdata("phort99_fuse_swap_1")
	modes={
	 [menumode]={update=updatemenu,
	             draw=drawmenu},
	 [gamemode]={update=updategame,
	             draw=drawgame},}
	
	local loadgame=dget(gamerow)
	local loadsize=dget(sizerow)
	local loadcolorblind=dget(colorblindrow)
	
	if loadgame!=0 then
	 menurows[gamerow].value=loadgame
	 menurows[sizerow].value=loadsize
	 menurows[colorblindrow].value=loadcolorblind
	end
 
 -- custom config key repeat
	poke(0x5f5c, 10) -- set the initial delay before repeating. 255 means never repeat.
	poke(0x5f5d, 2) -- set the repeating delay.
	
	-- enable mouse support	
	poke(0x5f2d, 1)
	
	startmenu()
end

function startmenu()
	camera()
	resethold=0
	mode=menumode
end

function startgame()
 mode=gamemode

	colors={}
	for i=1,#games[game].pals
	do 
	 add(colors,i) 
	end

 gridcursor={
	 speed=0.6,--lerp approach rate
	 draw={},--animated grid pos
	 mouseok=false,
	 mouse={x=-1,y=-1,click=0},
	 grabpos=v(0,0),
	 blocks={},
	 click=false,
	 --set to true as a hack to 
	 --prevent click on game start
	 lastclick=true,
	 justclicked=false,
	}
	
 board.width=boardsize
 board.height=boardsize
 cam.x=-64+(board.width*4)
 cam.y=-64+(board.height*4)
 
 gridcursor.pos=
  v(ceil(board.width/2),
    ceil(board.height/2))
 gridcursor.draw=v(0,0)
 gridcursor.mouse=getmouse()
 gridcursor.mouse.click=0
 
 gblocks={}
 for x=1,board.height do
  gblocks[x]={}
  for y=1,board.width do
			local block={}
			
			--choose colors that 
			--avoid connections
			local freecolors=deepcopy(colors)
		 local	neighbors=
		  getneighbors(gblocks,v(x,y))
			for direction,block 
			    in pairs(neighbors) 
			do
		 	del(freecolors,block.color)
			end
			assert(#freecolors>0)
			
			block.color=rnd(freecolors)
   gblocks[x][y]=block
  end
 end
 
 eachblock(gblocks,animateblock,1)
 
 eachblock(gblocks,connectblocks,blocks)
 score=0
 moves=0
 
 resethold=0
 
 sfx(sfxstartgame)
end

function connectblocks(block,pos,blocks)
 neighbors=
  getneighbors(gblocks,pos)
 
 for direction,offset in
     pairs(dirs)
 do
  block[direction]=nil
 end
 
 for direction,other in 
     pairs(neighbors) 
 do
  if block.color==other.color
  then
   block[direction]=true
  end
 end
end

function getscore(blocks)
	local visited={}
	local score=board.width*board.height
	eachblock(blocks,
	 function(block,pos)
	  if visited[block] then return end
		 eachconnected(
		  blocks,pos,
		  function(connected,pos)
		  	visited[connected]=true
    end)
   
   score-=1
	 end)
	 return score
end

function _update60()
 modes[mode].update()
end

function updatemenu()
 menurow=menurow or 1
 
 row=menurows[menurow]
 if btnp(ã) then
 	row.value-=1
 	if row.value<row.minval
 	 then row.value=row.maxval
 	end
 	sfx(sfxmenu)
 elseif btnp(ë) then
 	row.value+=1
 	if row.value>row.maxval
 	 then row.value=row.minval
 	end
 	sfx(sfxmenu)
 end
 
 if btnp(î) then
 	menurow-=1
 	if menurow<1
 	 then menurow=#menurows
 	end
 	sfx(sfxmenu)
 elseif btnp(É) then
 	menurow+=1
 	if menurow>#menurows
 	 then menurow=1
 	end
 	sfx(sfxmenu)
 end
 
 game=menurows[gamerow].value
 boardsize=menurows[sizerow].value
 colorblind=menurows[colorblindrow].value==1
 --save settings
 dset(gamerow,game)
	dset(sizerow,boardsize)
	dset(colorblindrow,
	 menurows[colorblindrow].value)
 
 local menuok=btn(ó) or btn(é)
 if menuok and not lastmenuok 
 then
	 startgame()
 end
 lastmenuok=menuok
end

function updategame()
 local mouse=getmouse()
 if not eq(mouse,gridcursor.mouse) then
 	gridcursor.mouseok=true
 end
 gridcursor.mouse=mouse
 
 gridcursor.click=
  btn(ó) or btn(é) 
 	or mouse.click==1
 gridcursor.justclicked=
  gridcursor.click and 
 	not gridcursor.lastclick
	gridcursor.lastclick=
	 gridcursor.click

 for direction,offset in pairs(dirs) do
  if btnp(direction) then
 	 local pos=vadd(gridcursor.pos,
 	                offset)
   movecursor(pos)
   gridcursor.mouseok=false
  end
 end
 if gridcursor.mouseok then
 	local pos=v(
 	 flr(mouse.x/8)+1,
   flr(mouse.y/8)+1)
  pos.x=min(max(pos.x,1),board.width)
  pos.y=min(max(pos.y,1),board.height)
  movecursor(pos)
 end
 
 animatecursor()
 eachblock(gblocks,animateblock,0.6)
 
 eachblock(
  gblocks,
  function(block,pos)
  	block.obstructed=nil
  end)
 
 if countblocks(gridcursor.blocks)==0 then
  if gridcursor.justclicked then
 		grab()
		end
	else
	 updatedrop()
 end
 
 if btn(ó) and btn(é) then
  if resethold==0 then
  	sfx(sfxreset)
  end
 	resethold+=1/60/1.6
 	if resethold>=1 then
 	 startmenu()
		end
 else
  --cancel sound
  sfx(sfxreset,-2)
  resethold=0
 end
end

function grab()
	
	local pos=deepcopy(gridcursor.pos)
	gridcursor.blocks={}
	gridcursor.grabpos=pos
 eachconnected(
  gblocks,pos,moveblock,
  {src=gblocks,
   dst=gridcursor.blocks})
   
 oldblocks=copyblocks(gblocks)
 
 if countblocks(gridcursor.blocks)>0 then
  sfx(sfxgrab) 	
 end
end

function eachconnected(blocks,pos,fn,tbl,_seen)
	local block=getblock(blocks,pos)
	if block==nil then return end
	
	_seen=_seen or {}
 if _seen[block] then
  --don't retread
  return
 else
  _seen[block]=true
 end
 
 fn(block,pos,tbl)
 
 for direction,offset in pairs(dirs) do
 	if block[direction] then
	  local offsetpos=vadd(pos,offset)
 	 eachconnected(blocks,offsetpos,fn,tbl,_seen)
		end
 end 
end

--moves a block into a 
--new table and optionally 
--offset its location
--erases from src if !tbl.copy
function moveblock(block,pos,tbl)
 if block==nil then return end
 
 local dstpos=vadd(
  pos,tbl.offset or v(0,0))
 
 tbl.dst[dstpos.x]=
  tbl.dst[dstpos.x] or {}
 
	tbl.dst[dstpos.x]
	       [dstpos.y]=block
	if not tbl.copy then
  tbl.src[pos.x][pos.y]=nil
	end
end

function copyblocks(blocks)
 tbl={
  src=blocks,
  dst={},
  copy=true}
	eachblock(blocks,moveblock,tbl)
	return tbl.dst
end

function drop(cursoroffset)
 sfx(sfxdrop)
 
 if cursoroffset.x!=0 or
    cursoroffset.y!=0
 then
 	moves+=1
 end
 
 eachblock(
	 gridcursor.blocks,
	 moveblock,
	 {src=gridcursor.blocks,
	  dst=gblocks,
	  offset=cursoroffset})
	gridcursor.blocks={}
	
	eachblock(gblocks,
	 animateblock,1.0)
	eachblock(gblocks,
	 connectblocks,
	 newblocks)
end

function updatedrop()
 local newblocks=
  copyblocks(oldblocks)
 local swapblocks={}
  
 local cursoroffset=
  vsub(gridcursor.pos,
       gridcursor.grabpos)
 local reverseoffset=
  vsub(gridcursor.grabpos,
       gridcursor.pos)
 
 local validmove=true
 
 --sorry 'bout this 
 --entire section:
  
 eachblock(
  gridcursor.blocks,
  function(_,pos)
   local newpos=vadd(
    pos,cursoroffset)
   
		 local shadowblock=getblock(
		  newblocks,newpos)
  	local shadowcluster={}
  	eachconnected(
  	 newblocks,
  	 newpos,
  	 moveblock,
  	 {src=newblocks,
  	  dst=shadowcluster})
   local candrop=inbounds(newpos)
   local clusteroffset=
    reverseoffset
   
   for i=1,board.width do
    local searching=false
			 eachblock(
			  shadowcluster,
			  function(shadowed,pos)
			   local swaptopos=
 		    vsub(pos,
 		         vmul(cursoroffset,i))
		   
			   --if nil, bystander blocks
			   --are not blocking the move
			   local targetspace=
			    getblock(newblocks,
			     swaptopos)
--  	   assert(targetspace==nil)
			   
			   --if nil, blocks held by 
			   --cursor don't block us
			   local todropspace=
			    getblock(gridcursor.blocks,
	 		    vsub(swaptopos,
	 		         cursoroffset))
--		    assert(todropspace==nil,
--		     "block held by cursor blocked the move")
	 		  
	 		  if targetspace==nil and
	 		     todropspace==nil then
	     	--not blocked! yay!
	     else
	      --any block obstructed?
	      --try again at next pos
	      searching=true
	     end
	     
	     if not inbounds(swaptopos) then
	 		  	searching=false
	 		  	candrop=false
      end

     end)
    
    if not searching then
     clusteroffset=
      vmul(reverseoffset,i)
     break 
    end
   end
   
   validmove=
    validmove and candrop
   local offset=v(0,0)
   if candrop then
    offset=clusteroffset
   else
    eachblock(
     shadowcluster,
     function(block,pos)
     	block.obstructed=true
     end)
   end
   
  	eachblock(
  	 shadowcluster,
  	 moveblock,
  	 {src=shadowcluster,
  	  dst=swapblocks,
  	  offset=offset})
  end)
 
 eachblock(
	 swapblocks,
	 moveblock,
	 {src=swapblocks,
	  dst=newblocks})
	
 eachblock(
  gridcursor.blocks,
  function(block,pos)
  	block.obstructed=not validmove
  end)
  
--	assert(validmove)

	gblocks=newblocks
 
 if gridcursor.justclicked then
 	if validmove	then
		 drop(cursoroffset)
		else
		 gblocks=oldblocks
		 drop(v(0,0))
		end
		
  score=getscore(gblocks)
 end
 
 
end

function animatecursor()
 local target=
  gridtoscreen(gridcursor.pos)
 
 gridcursor.draw=animatepos(
  gridcursor.draw,
  target,
  gridcursor.speed)
end

function animateblock(block,pos,rate)
 target=gridtoscreen(pos)
	drawpos=block.drawpos or target
	block.drawpos=animatepos(
	 drawpos,target,rate)
end

function animatepos(pos,goal,rate)
 local togoal=vsub(goal,pos)
 local newpos=
  vadd(pos,vmul(togoal,rate))
 if vlensqr(togoal)<0.1 then
  newpos=goal
 end
 return newpos
end

-->8
--draw

function _draw()
 modes[mode].draw()
end

function drawmenu()
 cls(0)
 pal()
 local pattern=bor(
  ç<<((time()*1)%32-16),
  ñ>>((time()*4)%32-16))
 fillp(pattern)
 rectfill(0,0,128,128,1)
 
 local pos1=v(0,4)
 local pos2=v(20,128-8*5-34)
 
 --lazily using globals...
 fusepos=fusepos or pos1
 swappos=swappos or pos2
 
 local fusetarget=pos1
 local swaptarget=pos2
 if time()%10>=5 then
	 fusetarget=pos2
	 swaptarget=pos1
 end
 
 fusepos=animatepos(fusepos,fusetarget,0.05)
 swappos=animatepos(swappos,swaptarget,0.05)
 
 menuword("fuse",fusepos.x,fusepos.y,
  {orange,red,orange,red})
 menuword("swap",swappos.x,swappos.y,
  {white,blue,green,gray})
 
 --ampersand vibrates 
 --uncontrollably
 spr(ampersand,
     60+sin(time()*10)*0.9,
     60-15+sin(time()*3.78)*0.9)
 
 menupos=v(0,105)
 
 for i=1,#menurows do
  local row=menurows[i]
  local selected=i==menurow
  local str=row.getstr(
   row,selected)
  local col=6
  if selected then col=10 end
  
	 outlinetext(str,
	  menupos,col)
	 
 	menupos.y+=6
 end
 outlinetext("ó[x] or é[z]: play",
  menupos,12)
end

function menuword(str,x,y,pals)
 for i=1,#str do
  char=sub(str,i,i)
 	
 	mappos=letters[char]
 	
 	local wave=i*-.25
 	if str=="swap" then
 		wave=i*.25
		end
 	
 	x1=(i-1)*3.5*8+x
 	y1=sin(time()*.5+wave)*3.5+y
 	
 	pal(pals[i])
 	map(mappos[1],mappos[2],
 	    x1,y1,
 	    3,5)
 end
end

function drawgame()
 cls(0)
 pal()
 fillp(ñ)
 rectfill(
  cam.x+64*resethold,
  cam.y,
  cam.x+128-64*resethold,
  cam.y+128,
  1)
 fillp(Ä)
 camera(cam.x,cam.y)
 
 drawboard()
 drawcursor()
-- drawdebug()
 drawscore()
 
 camera()
 local hintcol=6
 if btn(ó) and btn(é) then
 	hintcol=10
 end
 outlinetext("hold ó+é: reset",
  v(60,122),hintcol)
 camera(cam.x,cam.y)
end

function drawcursor()
 local offset=vadd(
  vsub(
   gridcursor.draw,
   vmul(gridcursor.grabpos,8)),
  v(8,8))
 local settings={
  tileset=tiledefaultoutline,
  offset=offset,
  }
  
 eachblock(gridcursor.blocks,
           drawblock,
           settings)

 pal()
 spr(sprbox[1],
     gridcursor.draw.x,
     gridcursor.draw.y)
 if gridcursor.mouseok then
	 spr(sprmouse,
	     gridcursor.mouse.x-4,
	     gridcursor.mouse.y-4)
	else
	 spr(sprdot,
      gridcursor.draw.x,
      gridcursor.draw.y)
 end
end

function drawboard()
 local settings={
  tileset=tilejoinsimple}
 eachblock(gblocks,drawblock,settings)
end

function drawblock(block,pos,settings)
	if block==nil then return end
	
	local blockpalette=
	 games[game].pals[block.color]
 pal(blockpalette)
 
 local connect=0b0000
 if block[ã] then 
  connect |= 0b1000 end
 if block[ë] then 
  connect |= 0b0100 end
 if block[î] then 
  connect |= 0b0010 end
 if block[É] then 
  connect |= 0b0001 end
 
 local sprite=blocksprites[connect]
 sprite+=settings.tileset or 0
 
 local drawpos=vadd(
  block.drawpos,
  settings.offset or v(0,0))
 
 if colorblind then
	 spr(sprcolorblind[block.color],
	  drawpos.x,drawpos.y)
 else
	 rectfill(
	  drawpos.x,drawpos.y,
	  drawpos.x+7,drawpos.y+7,13)
 end
 
 palt(13,true)
 spr(sprite,drawpos.x,drawpos.y)
 
 
 if block.obstructed then
	 pal()
	 pal(11,8)
	 palt()
 	sprite=blocksprites[connect]+
  	tileoutlineonly
  spr(sprite,drawpos.x,drawpos.y)
 end
 
 pal()
end

function drawdebug()
	camera(0)
	local py=6
	if debugblocks then
	 eachblock(debugblocks,
	  function(block,pos)
	  	print("x="..pos.x..",y="..pos.y,0,py)
	  	py+=6
	  end)	
	end
 
	camera(cam.x,cam.y)
end

function outlinetext(str,pos,col)
	for direction,offset in 
  pairs(dirs) 
 do
  local outlinepos=vadd(pos,offset)
 	print(str,
 	 outlinepos.x,outlinepos.y,0)
 end
 print(str,pos.x,pos.y,col)
end

function drawscore()
 local maxscore=
  board.width * 
  board.height - #colors
 local scorestr="score="
  ..score.."/"..maxscore..
  " moves="..moves
 
 local center=function(str)
 	return (board.width*4)-
       	 (4*#str/2)
 end
 
 local pos=v(
  center(scorestr),-7)
 outlinetext(scorestr,pos,9)
 if score==maxscore then
  local str="perfect!"
 	pos=v(0,122)
 
  winflashy=winflashy or 1	
  
  camera()
 	outlinetext(str,pos,winflashy)
  camera(cam.x,cam.y)
 
 	winflashy+=0.25
 	if winflashy>=16 
 	then 
 	 winflashy=1 
 	end
 end
end
