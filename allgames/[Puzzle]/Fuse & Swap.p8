--gameplay 
menumode=1
gamemode=2
mode=menumode
colorblind=true

games={
 {name="2 color (trivial)",
  pals={red,white}},
 {name="3 color (easy)",
  pals={green,orange,gray}},
 {name="4 color (normal)",
  pals={red,green,orange,blue}},
 {name="5 color (hard)",
  pals={blue,green,orange,red,white}},
}
 
--menu
menurows={
 --game option
 {getstr=function(self,selected)
   if selected then
	 	 return "game:      ã"..
	 	  games[self.value].name..
	 	  "ë"
	  else
	   return "game:        "..
	    games[self.value].name
	  end
  end,
  value=3,
  minval=1,
  maxval=#games},
 --grid size
 {getstr=function(self,selected)
   local size=self.value
   local comment=" (2 minutes)"
   if size<9 then
   	comment=" (1 minute)"
   end
   if size<7 then
   	comment=" (<1 minute)"
   end
   if size>10 then
   	comment=" (3 minutes)"
   end
   if size>12 then
   	comment=" (4 minutes)"
   end
   if selected then
	 	 return "size:      ã"..
	 	  size.."x"..size..comment.."ë"
	  else
	 	 return "size:        "..
	 	  size.."x"..size..comment
	  end
  end,
  value=9,
  minval=5,
  maxval=14},
 --colorblind
 {getstr=function(self,selected)
   local str="friendly"
   if self.value==0 then
   	str="unfriendly"
   end
   if selected then
	 	 return "colorblind:ã"..
	 	  str.."ë"
	  else
	 	 return "colorblind:  "..
	 	  str
	  end
  end,
  value=1,
  minval=0,
  maxval=1},
}
gamerow=1
sizerow=2
colorblindrow=3

--sprites
sprmouse=16
sprdot=32
sprbox={33,34}
sprcolorblind={2,3,19,35,51}

ampersand=98

--table of joined block sprites
--in ãëîÉ order
blocksprites={
 [0b1000]=4,
 [0b0100]=5,
 [0b0010]=6,
 [0b0001]=7,
 [0b1100]=20,
 [0b1010]=21,
 [0b1001]=22,
 [0b0110]=23,
 [0b0101]=36,
 [0b0011]=37,
 [0b0111]=38,
 [0b1011]=39,
 [0b1101]=52,
 [0b1110]=53,
 [0b1111]=54,
 [0b0000]=55}

tiledefault=0
tilejoinsimple=64
tiledefaultoutline=4
tileoutlineonly=8

--map data
letters={
 f={0,0},
 u={4,0},
 s={8,0},
 e={12,0},
 w={4,5},
 a={8,5},
 p={12,5},
}

--sounds
sfxgrab=0
sfxdrop=1
sfxreset=2
sfxmenu=3
sfxstartgame=4
-->8
--utils

dirs={
 [ã]={x=-1,y= 0},
 [ë]={x= 1,y= 0},
 [î]={x= 0,y=-1},
 [É]={x= 0,y= 1},
}
oppdirs={
 [ã]=ë,
 [ë]=ã,
 [î]=É,
 [É]=î,
}

--naive shallow value equality
function eq(a,b)
 equal = #a==#b
	for key,val in pairs(a) do
		equal=equal and (val==b[key])
	end
	return equal
end

function shallowcopy(t)
 clone={}
	for key,val in pairs(t) do
		clone[key]=val
	end
	return clone
end

function deepcopy(obj, seen)
  if type(obj) ~= 'table' then return obj end
  if seen and seen[obj] then return seen[obj] end
  local s = seen or {}
  local res = setmetatable({}, getmetatable(obj))
  s[obj] = res
  for k, v in pairs(obj) do res[deepcopy(k, s)] = deepcopy(v, s) end
  return res
end

function eachblock(tbl,fn,usr)
 for x,col in pairs(tbl) do
  for y,block in pairs(col) do
   fn(block,{x=x,y=y},usr)
  end
 end
end

function countblocks(blocks)
	local count=0
 eachblock(blocks,
  function(block,pos)
   count+=1
  end)
 return count
end

function gridtoscreen(gridpos)
	return vsub(vmul(gridpos,8),
             v(8,8))
end

--get block at specified
--location, or nil if outside
function getblock(tbl,pos)
 col=tbl[pos.x]
 if col then
  return col[pos.y]
 end
end

function getmouse()
	return{
  x=stat(32)+cam.x,
  y=stat(33)+cam.y,
  click=stat(34),}
end

function movecursor(pos)
 if inbounds(pos)
 then
  gridcursor.pos=pos
 end
end

function inbounds(pos)
 return pos.x>=1 and 
        pos.y>=1 and 
        pos.x<=board.width and 
        pos.y<=board.height 
end

function getneighbors(blocks,pos)
 neighbors={}
 
 for direction,offset 
  in pairs(dirs)
 do
  other=getblock(blocks,
   {x=pos.x+offset.x,
    y=pos.y+offset.y})
  if other then
   neighbors[direction]=other
  end
 end

 return neighbors
end

function v(x,y)
	return {x=x,y=y}
end

function vadd(a,b)
 return {
  x=a.x+b.x,
  y=a.y+b.y,
 }
end
function vsub(a,b)
 return {
  x=a.x-b.x,
  y=a.y-b.y,
 }
end
function vmul(a,s)
 return {
  x=a.x*s,
  y=a.y*s,
 }
end
function vround(a)
 return {
  x=flr(a.x+0.5),
  y=flr(a.y+0.5),
 }
end
function vlensqr(a)
	return a.x*a.x+a.y*a.y
end

function gcd(a,b)
	if b ~= 0 then
		return gcd(b, a % b)
	else
		return abs(a)
	end
