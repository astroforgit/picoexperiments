pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- pikoban
-- now with 457 levels!

function _init()
  levels=#level_data
  clicks=0
  
  cartdata("pikoban")
  level=dget(0)
  if level<1 or level>levels then level=1 end

  init_game()
  init_menu()
  init_selector()
  init_stats()

  show_menu()
end

function _update()
  if mode==0 then update_menu() end
  if mode==1 and not win_anim then update_game() end
  if mode==1 and win_anim then update_win() end
  if mode==2 then update_selector() end
  if mode==3 then update_stats() end
end

function _draw()
  if mode==0 then draw_menu() end
  if mode==1 and not win_anim then draw_game() end
  if mode==1 and win_anim then draw_win() end
  if mode==2 then draw_selector() end
  if mode==3 then draw_stats() end
end

-->8
-- game functions

function init_game()
  px,py=0,0
  p_sprites={left=7,right=7,up=8,down=6}
  player_spr,flipped=6,false
  level_init=false
  steps=0
  moves={}
end

function update_game()
  -- move player
  if btnp(‹) then move("left")
  elseif btnp(‘) then move("right")
  elseif btnp(”) then move("up")
  elseif btnp(ƒ) then move("down") end

  -- undo move with Ž
  if btnp(—) and not btnp(Ž) then undo() end

  -- reset game with Ž + —
  if btnp(—) and btn(Ž) and steps>0 then
    start_game()
    sfx(7)
  end
  
  -- level solved
  if open_targets==0 then
    win()
  end
end

function draw_game()
  cls(5)
  map(0,0,map_x,map_y,level_w,level_h)
  rectfill(0,0,127,8,1)
  line(0,9,127,9,9)
  cursor(2,2,6)
  print("level "..level)
  palt(0,false)
  palt(13,true)
  spr(player_spr,px*8+map_x,py*8+map_y,1,1,flipped)

  steps_x=100
  if steps>9 then steps_x=96 end
  if steps>99 then steps_x=92 end
  print(steps,steps_x,2)
  print("steps",107,2)

  if level==1 then -- print tutorial
    print("move    to",38,34,7)
    spr(4,57,32)
    spr(3,83,32)
    print("to undo move",50,94,7)
    print("—",38,95,1)
    print("—",38,94,9)
    print("+    to restart level",30,109,7)
    print("Ž   —",18,110,1)
    print("Ž   —",18,109,9)
  end
end

function start_game()
  dset(0,level)
  dset(1,dget(1)+steps)

  init_game()
  set_map(level)

  menuitem(1,"skip level", function() next_level(); dset(3,dget(3)+1) end)
  menuitem(2,"show menu", function() show_menu() end)
end

function move(dir)
  player_spr=p_sprites[dir]

  -- set target coordinates
  if dir=="left" then
    tx,tx1=px-1,px-2
    ty,ty1=py,py
    flipped=true
  elseif dir=="right" then
    tx,tx1=px+1,px+2
    ty,ty1=py,py
    flipped=false
  elseif dir=="up" then
    tx,tx1=px,px
    ty,ty1=py-1,py-2
  elseif dir=="down" then
    tx,tx1=px,px
    ty,ty1=py+1,py+2
  end

  if mget(tx,ty)==2 or mget(tx,ty)==3 then -- no crate
    px=tx
    py=ty
    steps+=1
    add(moves,"n"..dir..steps)
    sfx(1)
    if steps%2==0 then sfx(1) else sfx(2) end
  elseif mget(tx,ty)==4 or mget(tx,ty)==5 then -- crate next to player
    if mget(tx1,ty1)==2 or mget(tx1,ty1)==3 then -- can move crate
      if mget(tx,ty)==5 then -- move crate off target
        mset(tx,ty,3)
        open_targets+=1
        sfx(0)
      else -- move crate
        mset(tx,ty,2)
        sfx(0)
      end
      
      if mget(tx1,ty1)==3 then -- move crate on target
        mset(tx1,ty1,5)
        open_targets-=1
        sfx(0)
      else -- move crate
        mset(tx1,ty1,4)
        sfx(0)
      end
      -- move player after crate
      px=tx
      py=ty
      steps+=1
      add(moves,"c"..dir..steps)
      if steps%2==0 then sfx(1) else sfx(2) end
    end
  end
end

function undo()
  if #moves==0 then return end

  dir=sub(moves[#moves],2,2)
  
  -- set target coordinates
  tx,ty=px,py
  if dir=="l" then
    tx1,ty1=px-1,py
    px+=1
    player_spr=7
    flipped=true
  elseif dir=="r" then
    tx1,ty1=px+1,py
    px-=1
    player_spr=7
    flipped=false
  elseif dir=="u" then
    tx1,ty1=px,py-1
    py+=1
    player_spr=8
  elseif dir=="d" then
    tx1,ty1=px,py+1
    py-=1
    player_spr=6
  end

  if sub(moves[#moves],1,1)=="c" then -- undo crate move
    sfx(3)
    if mget(tx,ty)==3 then -- move on target/floor
      mset(tx,ty,5)
      open_targets-=1
    else
      mset(tx,ty,4)
    end

    if mget(tx1,ty1)==4 then -- replace with floor/target
      mset(tx1,ty1,2)
    else
      mset(tx1,ty1,3)
      open_targets+=1
    end
  end

  del(moves, moves[#moves])
  
  steps-=1
  if steps%2==0 then sfx(1) else sfx(2) end
end

function win()
  player_spr=6
  win_anim=true
  win_anim_frame=1
  win_anim_rev=false
  solved_all=false
  circ_x=px*8+map_x
  circ_y=py*8+map_y
  sfx(4)
  draw_game()
  dset(2,dget(2)+1)
  level+=1
  if level>levels then
    level=1
    solved_all=true
  end
end

function update_win()
  if win_anim_rev and not solved_all then
    win_anim_frame-=8
  else
    win_anim_frame+=8
  end
  if win_anim_frame >= 96 then
    set_map(level)
    start_game()
    win_anim_rev=true
  end
  if win_anim_frame<=0 then
    win_anim=false
  end

  if solved_all and (btnp(4) or btnp(5)) then show_menu() end
end

function draw_win()
  if win_anim_rev then draw_game() end
  circfill(circ_x,circ_y,win_anim_frame,0)
  if win_anim_frame>=64 and solved_all then
    for i=1,10 do
      print(".",rnd(128),rnd(128),rnd(15))
    end
    print_center("congratulations!",51,0)
    print_center("congratulations!",50,9)
    print_center("all levels solved!",61,0)
    print_center("all levels solved!",60,9)
  end
end

-->8
-- level functions

function set_map(lvl)
  reload()
  mx=0
  my=0
  open_targets=0
  level_w=0
  level_h=1
  
  level_str=level_data[lvl]

  if level_str then
    for i=1,#level_str do
      local c=tonum(sub(level_str,i,i))

      if c==1 or c==2 or c==3 or c==4 or c==5 then
        mset(mx,my,c)
      end

      if c==7 then -- player on target
        mset(mx,my,3)
        px=mx
        py=my
      end

      if c==6 then -- player coordinates
        mset(mx,my,2)
        px=mx
        py=my
      end

      if c==3 or c==7 then open_targets+=1 end

      if mx>level_w then level_w=mx end
      mx+=1

      if c==9 then -- new line
        mx=0
        my+=1
        level_h+=1
      end
    end
    map_x=(16-level_w)/2*8
    map_y=(16-level_h)/2*8+4
  end
end

function next_level()
  level+=1
  if level>levels then level=1 end
  start_game()
end

-->8
-- menu functions

function init_menu()
  active_item=1
  menu_pos_y=60
  menu_update=true

  menu_entries={
    "continue on level "..level,
    "select level",
    "stats"
  }
end

function update_menu()
  if btnp(”) then
    active_item-=1
    sfx(5)
    menu_update=true
  elseif btnp(ƒ) then
    active_item+=1
    sfx(5)
    menu_update=true
  end
  
  if menu_update then
    if active_item>#menu_entries then active_item=#menu_entries end
    if active_item<1 then active_item=1 end

    menu_entries[1]="continue on level "..level
  end

  if btnp(—) then
    sfx(6)
    mode=active_item
    if active_item==1 then
      start_game()
    elseif active_item==2 then
      selector_update=true
    elseif active_item==3 then
      stats_update=true
    end
  end
end

function draw_menu()
  if menu_update then
    cls(5)
    set_map(level)
    map(0,0,map_x,map_y,16,16)

    palt()
    spr(64,8,4,14,4)

    print("levels by david w skinner",13,120,1)

    rectfill(17,menu_pos_y+5,120,menu_pos_y+35,0)
    rectfill(12,menu_pos_y,115,menu_pos_y+30,1)
    rect(11,menu_pos_y-1,116,menu_pos_y+31,9)
    spr(4,17,active_item*8+menu_pos_y-4)

    for i,e in pairs(menu_entries) do
      if i==active_item then col=7
      else col=5 end
      print(e,30,i*8+menu_pos_y-3,col)
    end
  end
  menu_update=false
end

function show_menu()
  mode=0
  menu_update=true
  menuitem(1)
  menuitem(2)
end

-->8
-- level selector

function init_selector()
  speed=6
end

function update_selector()
  if not show_selector then selected_lvl=level end

  if btn(‹) and not btn(‘) and selected_lvl>1 or btn(‘) and not btn(‹) and selected_lvl<levels then
    if (clicks==0) speed=6
    if (clicks==30) speed=4
    if (clicks==50) speed=2
    if (clicks==150) speed=1
    
    if clicks%speed==0 then
      if btn(‹) then selected_lvl-=1
      else selected_lvl+=1 end
      
      selector_update=true
      sfx(5)
    end
    clicks+=1
  else
    clicks=0
  end

  if selector_update then set_map(selected_lvl) end

  if btnp(—) and show_selector then
    level=selected_lvl
    mode=1
    show_selector=false
    sfx(6)
    start_game()
    return
  end

  if btnp(Ž) then
    show_selector=false
    show_menu()
    return
  end

  show_selector=true
end

function draw_selector()
  if selector_update then
    cls(1)
    pal(5,1)
    palt(13,true)
    map(0,0,map_x,map_y,level_w,level_h)
    spr(player_spr,px*8+map_x,py*8+map_y,1,1,flipped)
    pal()
    print_center("level "..selected_lvl.." / "..levels, 5,0)
    print_center("level "..selected_lvl.." / "..levels, 4,9)
    print("‹‘           —",19,121,0)
    print("‹‘           —",19,120,9)
    print("change       start",37,121,0)
    print("change       start",37,120,7)
    selector_update=false
  end
end

-->8
-- stats page
function init_stats()
  show_stats=false
  stats_update=false
end

function update_stats()
  if btnp(Ž) and not btn(—) and show_stats then
    show_menu()
    show_stats=false
    return
  end

  if btn(Ž) and btn(—) then
    clicks+=1
    if clicks>20 then
      dset(1,0)
      dset(2,0)
      dset(3,0)
      sfx(7)
      clicks=0
      stats_update=true
    end
  else
    clicks=0
  end

  show_stats=true
end

function draw_stats()
  if stats_update then
    cls(1)
    print_center("statistics",21,0)
    print_center("statistics",20,9)
    line(42,28,84,28,9)
    line(42,29,84,29,0)
    cursor(25,50,7)
    print("steps taken:    "..dget(1))
    print("\nwins:           "..dget(2))
    print("\nlevels skipped: "..dget(3))
    print_center("hold Ž + — to reset stats",115,5)
    stats_update=false
  end
end
