level=entity:extend({
 draw_order=0
})

function level:init()
 local px=g_data[1]
 for x=0,7 do
  for y=0,7 do
   mset(x,16+y,mget(x+px,y))
  end
 end
 px=g_data[2]
 for x=0,7 do
  for y=0,7 do
   mset(x,24+y,mget(x+px,y+8))
  end
 end
 px=g_data[3]
 for x=0,7 do
  for y=0,7 do
   mset(x+8,16+y,mget(x+px+8,y))
  end
 end
 px=g_data[4]
 for x=0,7 do
  for y=0,7 do
   mset(x+8,24+y,mget(x+px+8,y+8))
  end
 end
 
 local b,s=self.base,self.size
 for x=0,s.x-1 do
  for y=0,s.y-1 do
   local blk=mget(b.x+x,b.y+y)
   local cl=entity.spawns[blk]
   if cl then
    local e=cl({
     pos=v(x,y)*8,
     map_pos=b+v(x,y),
     tile=blk
    })
    local xx,yy=b.x+x,b.y+y
    if(not e.norem)mset(xx,yy,e.dtile)
    e_add(e)
   end
  end
 end
end

function level:render()
 map(self.base.x,self.base.y)
end

