-- player

player=entity:extend({
 draw_order=6
})
player:spawns_from(16)

function player:init()
 self.dir="left"
end

function player:idle()
 local xx,yy=0,0
 
 if (btnp(‹)) xx-=1
 if (btnp(‘)) xx+=1
 if (btnp(”)) yy-=1
 if (btnp(ƒ)) yy+=1
 
 if abs(xx+yy)==1 then
  local mv=v(xx,yy)*8
  local v=self.pos+mv
   
  if xx<0 then
   self.dir="left"
  elseif xx>0 then
   self.dir="right"
  elseif yy<0 then
   self.dir="up"
  else
   self.dir="down"
  end
   
  if not bad(v.x/8+g_level.base.x,
  v.y/8+g_level.base.y) then
   for b in all(entities_tagged["box"]) do
    if b.pos.x==v.x and b.pos.y==v.y then
     local n=b.pos+mv
     if bad(n.x/8+g_level.base.x,n.y/8+g_level.base.y,b.key) then
      sfx(1)
      return
     end
     for bb in all(entities_tagged["box"]) do
      if bb.pos.x==n.x and bb.pos.y==n.y then
       sfx(1)
       return
      end
     end
     b.pos=n
     b:onmove()
     break
    end  
   end
   
   mv_world()
   local old=self.pos
   self.pos=v
   for b in all(entities_tagged["box"]) do
    if b.pos.x==v.x and b.pos.y==v.y then
     self.pos=old
     sfx(1)
     return
    end 
   end
   g_moves+=1
   local xx,yy=self.pos.x/8+g_level.base.x,self.pos.y/8+g_level.base.y
   local t=mget(xx,yy)
   
   if t==7 then
    local x,y=self:find_tile(7,xx,yy)
    if x then
     parts(self.pos.x+4,self.pos.y+4,5,4,5)
     self.pos.x=x*8
     self.pos.y=y*8
     parts(self.pos.x+4,self.pos.y+4,5,4,5)
     sfx(2)
    end   
    else
    sfx(0) 
   end
  else
   sfx(1)
  end
 end
end

function player:find_tile(t,sx,sy)
 local mx,my=flr(self.pos.x/8/8)*8,flr(self.pos.y/8/8)*8
 for x=0+mx,7+mx do
  for y=0+my,7+my do
   local xx,yy=x+g_level.base.x,y+g_level.base.y
   if xx~=sx or yy~=sy then
    local tl=mget(xx,yy)
    if(tl==t) return x,y
   end
  end
 end
end

function mv_world()
 for b in all(entities_tagged["box"]) do
  b:trytoslide()
	end
end

function bad(x,y,key)
 local t=mget(x,y)
 
 return (t==1 or (t==21 and not key))
end

function player:render()
 local x,y=self.pos.x,self.pos.y
 local s=self.t/30%2
 if self.dir=="left" then
  spr(16+s,x,y)
 elseif self.dir=="right" then
  spr(16+s,x,y,1,1,true,false)
 elseif self.dir=="up" then
  spr(32+s,x,y)
 else
  spr(32+s,x,y,1,1,false,true) 
 end
end
