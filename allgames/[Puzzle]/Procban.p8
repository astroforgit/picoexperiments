  local x,y=rnd(128),rnd(128)
  local c=g_time/30
  local xx,yy=64-x,64-y
  local d=sqrt(xx*xx+yy*yy)
  
  c+=tri(xx/128)*8
  c+=cos(x/64)*4
  c+=sin(y/32)*2
  --c+=tri(d/64)*16
  --c+=sin(cos(y/128)/100)*16
  
  --c+=atan2(64-y,64-x)*8+g_time/100
  
  circ(x,y,1,plt[flr(c/2)%(#plt+1)])
 end

