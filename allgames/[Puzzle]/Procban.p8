function _init()
 g_time,state,g_index,g_won=
 0,menu,
 8
 ,false
  
 g_score=0
 generate_level()

 shk=0
 g_color=0
 mn={y=-64}
 tween(mn,{y=0},0.3,"back_out")
 
 -- do not forget about 
 -- m()
 -- ‘‘”ˆŽ–„”‘ˆŽ–
end

function _update60()
 state.update()
 tween_update(1/60)
 g_time+=1
 
 if btnp(—,1) then
  g_color=(g_color+1)%8
 end
end

function _draw()
 if shk>0.5 then
  shk-=0.2
  camera(rnd(shk)-shk/2,rnd(shk)-shk/2)
 else
  camera()
 end
 
 state.draw()
end

function generate_level()
 g_data={flr(rnd(8))*16,flr(rnd(8))*16,flr(rnd(8))*16,flr(rnd(8))*16}
 restart_level()
end

function restart_level()
 fade()
 g_moves=0
 reload(0x2000,0x2000,0x1000)
 entity_reset()

 g_level=e_add(level({
  base=v(g_index%8*16,flr(g_index/8)*16),
  size=v(16,16)
 }))
end
