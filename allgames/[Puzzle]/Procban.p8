box=entity:extend({
 sprite={idle={4,6,delay=30},active={20}},
 tags={"box"},
 draw_order=5
})

box:spawns_from(4)

function box:onmove()
 self:become(mget(self.pos.x/8
 +g_level.base.x,
 self.pos.y/8+g_level.base.y)==0 and "active" or "idle")
 if self.state=="active" then
  parts(self.pos.x+4,self.pos.y+4,5,4,5)
 end

 for b in all(entities_tagged["box"]) do
  if (b.state~="active") return
 end
 g_score+=1
 generate_level()
 sfx(3)
end

function box:trytoslide()
 local t=mget(self.pos.x/8
 +g_level.base.x,
 self.pos.y/8+g_level.base.y)
 
 if t==18 then
  self:slide(0,1)
 elseif t==35 then
  self:slide(0,-1)
 end
end

function box:slide(x,y)
 local v=v(self.pos.x+
  x*8,self.pos.y+y*8)
 
 if not bad(v.x/8+g_level.base.x,
 v.y/8+g_level.base.y,self.key) then
  for b in all(entities_tagged["box"]) do
   if b~=self and b.pos.x==v.x and b.pos.y==v.y then
    return
   end  
  end
     
  self.pos=v
  self:onmove()
	end
end

