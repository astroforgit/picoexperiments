function tri(v)
 v=v%1
 return
  (v<0.5
  and v*4-1
  or 1-(v-0.5)*4)
end

--plt={0,1,2,4,9,10,7,10,9,4,2,1,0}
plt={0,1,5,6,5,1,0}
local st=false
function menu.draw()
