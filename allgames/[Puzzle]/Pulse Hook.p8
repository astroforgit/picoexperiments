pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- pulse hook: a puzzle game
-- by @elastiskalinjen
-- sebastian Lind

-- started as a 2 hour game jam

particles={}
function initparticle(x,y,dx,dy,size,col)
	local p={}
	p.x=x
	p.y=y
	p.dx=dx
	p.dy=dy
	p.size=size
	p.col=col
	
	add(particles,p)
end

function updateparticle(p)
	p.dx*=0.99
	p.dy*=0.99
 	p.x+=p.dx
 	p.y+=p.dy
 	p.size -= 0.035
	if(p.size <=0)then 
		del(particles, p)
	end
end

function drawparticle(p)
	circ(p.x,p.y,p.size,p.col)
end

texts={}
function inittext(text,x,y,dy, c)
	local p={}
	p.text = text
	p.x=x
	p.y=y
	p.dy=dy
	p.c = 8
	
	add(texts,p)
end

function updatetext(p)
	p.dy*=0.9
 	p.y+=p.dy

 	if p.dy > -0.01 then
 		p.dy = 0
 	end

 	if p.dy == 0 then 
		del(texts, p)
	end
end

function drawtext(p)
	print(p.text, p.x, p.y, p.c)
end

shake=0
function doshake()
	local shakex=16-rnd(32)
 	local shakey=16-rnd(32)
 
	shakex*=shake
	shakey*=shake
	camera(shakex,shakey)
	shake=shake*0.95
	if(shake < 0.05)shake=0
	if(shake >= 0.3)shake=0.25
end

function calcdist(x1,y1,x2,y2)
	dist=sqrt(((x2-x1)/10)^2+((y2-y1)/10)^2)*10
	return dist
end

function circcoll(x1,y1,x2,y2,rad1,rad2)
	dist = calcdist(x1,y1,x2,y2)
	if(dist < (rad1+rad2)) then return true else return false end
end

function lerp(var,target,pow)
	return(var+pow*(target-var))
end

function calcangle(x1,y1,x2,y2)
 angle = atan2(x1-x2,y1-y2)
 return angle
end

function movetowards(x1, y1, x2, y2, speed)
	local newangle=calcangle(x1,y1,x2,y2)
	x2+=speed*cos(newangle)
	y2+=speed*sin(newangle)

	return x2,y2
end

points={}
function initpoint(x,y)
	local p={}
	p.x = x - 4
	p.y = y - 4 
	p.spr = 16
	p.areasize = 4
	p.attached = false
	p.dead = false
	p.pulse = false
	p.blink = 0
	p.angle = 0
	p.drawline = false

	add(points, p)
end

function updatepoint()
	for k,p in pairs(points) do
		p.angle=calcangle(mouse.x+4,mouse.y+4,p.x+4,p.y+4)
		
		if p.attached == false then
			if p.pulse == false then 
				if p.areasize < 24 then 
					p.areasize = lerp(p.areasize, 25, 0.025)
				else
					initcircle(p.x+4, p.y+4, 0, 10, 0.4, 2) 
					p.pulse = true
				end
			end
			if p.pulse == true then 
				if p.areasize > 10 then 
					p.areasize = lerp(p.areasize, 0, 0.03)
				else 
					p.pulse = false
					initcircle(p.x+4, p.y+4, 0, 24, 0.29, 2) 
				end
			end
		else 
			if p.areasize > 0 then
				p.areasize = lerp(p.areasize, -1, 0.075)
			end
		end

		if p.dead == false then 
			for k,op in pairs(points) do
				if op ~= p then
					if p.attached == false and circcoll(p.x,p.y,op.x, op.y, p.areasize, op.areasize) then 
						initline(p.x,p.y,op.x,op.y)
						p.attached = true
						op.attached = true
						local gainedscore = flr(calcdist(p.x,p.y,op.x,op.y) / 2) 
						if gainedscore <= 10 then
							 sfx(8) 
						elseif gainedscore > 10 and gainedscore < 18 then
							sfx(4)
						else  
							sfx(7) 
						end
						score+=gainedscore
						inittext(gainedscore, mouse.x-4, mouse.y-4, -1, 1)
					end
				end
			end

			if p.blink <= 120 then 
				p.blink +=1
			else 
				p.blink = 0
			end
		end

		local dist = calcdist(p.x, p.y, mouse.x-4, mouse.y-4)
		if p.attached == false and dist < 40 and (btn(4) or pntr()) then 
			p.drawline= true
			if dist > 4 then 
				 p.x, p.y = movetowards(mouse.x-4, mouse.y-4, p.x, p.y, 0.7)
			end
			p.areasize = lerp(p.areasize, 10, 0.075)
		else 
			p.drawline = false 
		end

		if p.dead == true then 
			if p.areasize > 0 then
				p.areasize = lerp(p.areasize, -20, 0.075)
			else
				for i=0,10 do 
					initparticle(p.x+rnd(4), p.y+rnd(4), rnd(1)-rnd(1), rnd(1)-rnd(1), 1+flr(rnd(2)), 8)
				end
				del(points, p)
			end
		end 
	end
end

function drawpoint(p)
	if p.drawline then 
		line(p.x+4 + camoffsetx, p.y+4 + camoffsety, mouse.x, mouse.y, 2)
	end

	if p.blink <= 110 then 
		spr(p.spr, p.x + camoffsetx, p.y + camoffsety) 
		spr(18,p.x+cos(p.angle)*1.25 + camoffsetx,p.y+sin(p.angle)*1.25 + camoffsety)
	else 
		spr(17, p.x + camoffsetx, p.y + camoffsety)
		spr(19, p.x+cos(p.angle)*1.25 + camoffsetx, p.y+sin(p.angle)*1.25 + camoffsety)
	end
	circ(p. x+ 4 + camoffsetx, p.y + 4 + camoffsetx, p.areasize, 8)
	
end

lines={}
function initline(sx,sy,ex,ey)
	local l={}
	l.sx = sx+4
	l.sy = sy+4
	l.ex = ex+4
	l.ey = ey+4

	add(lines, l)
end

function updateline(l)
	
end

function drawline(l)
	line(l.sx + camoffsetx,l.sy + camoffsety , l.ex + camoffsetx,l.ey + camoffsety, 14)
end

enemies={}
function initenemy(x,y, type)
	local e={}
	e.x = x
	e.y = y
	e.size = 8
	e.maxsize = 12 + flr(rnd(12))
	e.grow = false
	e.blink = 0
	e.angle = 0
	
	e.type = type
	e.turn = 0
	e.turnpos = 0
	e.speed = rnd(3) / 4.5
	e.turncounter = 20 + flr(rnd(20))

	if e.type == 0 then 
		e.color = 9
	elseif e.type == 1 then
		e.color = 10
	elseif e.type == 2 then
		e.color = 14
	else 
		e.color = 15
	end

	add(enemies, e)
end

function updateenemy(e)
	e.angle=calcangle(mouse.x+4,mouse.y+4,e.x+4,e.y+4)

	if e.size <= e.maxsize*0.8 and e.grow == false then
		e.size = lerp(e.size, e.maxsize, 0.01)
	else
		e.grow = true
	end

	if e.size >= 5 and e.grow == true then
		e.size = lerp(e.size, 0, 0.005)
	else
		e.grow = false
	end

	if e.blink <= 90 then 
		e.blink +=1
	else 
		e.blink = 0
	end

	for p in all(points) do
		if circcoll(e.x,e.y,p.x+4, p.y+4, e.size, p.areasize) and p.attached == false then
			p.dead = true
			sfx(2)
		end 
	end

	if e.type == 1 or e.type == 2 then 
		if e.turnpos < e.turncounter then
			e.turnpos += e.speed
			if e.turn == 0 then 
				if(e.type == 1)then e.x +=e.speed else e.y +=e.speed end 
			else 
				if(e.type == 1)then e.x -=e.speed else e.y -=e.speed end 
			end
		else
			e.turnpos = 0
			if (e.turn == 0)then e.turn = 1 else e.turn = 0 end
			for i=0,3 do 
				initparticle(e.x+rnd(e.size), e.y+rnd(e.size), 0, 0.25, 2+flr(rnd(2)), 13)
			end
			if e.type == 1 then sfx(9) else sfx(10) end 
		end
	end

	if e.type == 3 then 
		e.x, e.y = movetowards(mouse.x, mouse.y, e.x, e.y, 0.15)
	end
end

function drawenemy(e)
	circfill(e.x + camoffsetx, e.y +camoffsety, e.size, e.color)
	if e.blink <= 85 then
		spr(117+e.type*2,e.x-4+cos(e.angle)*2 + camoffsetx,e.y-4+sin(e.angle)*2 + camoffsety)
	else 
		spr(117+e.type*2+1,e.x-4+cos(e.angle)*2 + camoffsetx,e.y-4+sin(e.angle)*2 + camoffsety)
	end
end

circles={}
function initcircle(x, y, rad, maxrad, speed, col)
	local c={}
	c.x=x
	c.y=y
	c.rad=rad
	c.maxrad=maxrad
	c.speed = speed
	c.col = col
	add(circles,c)
end

function updatecircle(c)
	c.rad+=c.speed
	if(c.rad >= c.maxrad)del(circles,c)
end

function drawcircle(c)
	circ(c.x,c.y,c.rad,c.col)
end

------------------------------------------
score=0
scrollingscore=0
highscore = 0
scrollinggoal=0
ammo = 4
newrecord = false
function _init()
	mouse.init()
	cartdata("elastiskalinjen_pulsehook")
	highscore = dget(0)
	if dget(3) == 1 then
		mouse.off = false
	else 
		mouse.off = true
	end
	sfx(11)
end

pulsecounter=0
pulser=1
pulsercolor=1
function pulse()
	if pulsecounter < 30 then 
		pulsecounter+=1
	else
		pulsecounter = 0
		if start == false then
			pulser = 4
			pulsercolor=2
		elseif dead == true then
			pulser = 3
			pulsercolor=8
		else
			pulser = 2
			pulsercolor=13
		end 
		for i=1, pulser do 
			initparticle(flr(rnd(128)),-10,0, rnd(3), 2+flr(rnd(2)), pulsercolor)
		end
	end 
end

start = false
eye1x = 20
eye1y = 54
eye1angle = 0
eye2x = 90
eye2y = 54
eye2angle = 0

function _update60()
	camoffsetx =  mouse.x / 32
	camoffsety =  mouse.y / 32

	mouse.update()
	foreach(particles, updateparticle)
	foreach(texts, updatetext)
	pulse()
	
	scrollingscore = lerp(scrollingscore, score, 0.05)
	scrollinggoal = lerp(scrollinggoal, nextlevelscore-score, 0.05)
	eye1angle=calcangle(mouse.x+4,mouse.y+4,eye1x+8,eye1y + 8)
	eye2angle=calcangle(mouse.x+4,mouse.y+4,eye2x+8,eye2y + 8)

	if pntp() or pntr() then
		mouse.off = false
		dset(3,1)
	end

	if start == true then 
		updatepoint()
		foreach(lines, updateline)
		foreach(enemies, updateenemy)
		playerupdate()
		playerloop()
		foreach(circles, updatecircle)
	else --start screen
		if pntp() or btnp(5) then
			start = true
			transpeed = 0
			sfx(5)
			for i=1, 25 do
				initparticle(flr(rnd(128)), flr(rnd(128)), rnd(1)-rnd(1), rnd(1)-rnd(1), 1+flr(rnd(2)), 1)
			end
			for i=0,20 do 
				for j =0,20 do 
			 		mset(i,j,64+(level-1))
			 	end
			end
		end
		if textscroll <= 132 then
			 textscroll+=0.5 
		else
			if mouse.off == false then  
				textscroll = -70
			else
				textscroll = -90
			end
		end
	end

	if dead == true then
		if pntp() or btnp(5) then
			run() -- i am so lazy...
		end
	end
	if (clickblink < 50)clickblink+=1 else clickblink=0 

	if (mouse.off == false) then 
		menuitem(1, "use arrow keys", function() mouseoff()  end)
	else 
		menuitem(1, "use mouse", function() mouseon() end)
	end

	transpeed += 0.08

	if glitch > 0 then 
		glitch -=1
	end
end

function mouseoff()
	mouse.off = true
	dset(3, 0)
	sfx(5)
end

function mouseon()
	mouse.off = false
	dset(3, 1)
	sfx(5) 
end

clickblink=0
textscroll=-70
starthelp=120
function _draw()
	cls()
	map(0, 0, camoffsetx - 20, camoffsety - 20, 128, 128)
	foreach(texts, drawtext)
	foreach(particles, drawparticle)

	if dead == false then
		if start == true then
			foreach(circles, drawcircle)
			foreach(enemies, drawenemy)
			foreach(lines, drawline)
			foreach(points, drawpoint)
			doshake()

			if starthelp >= 0 then
				starthelp-=1
				if ammo > 0 then
					if level == 1 then 
						initword("hook them together", 26, 64, 6, 28, 13) 
					elseif level == 2 then 
						initword("farther away the better", 16, 64, 6, 28, 13) 
					elseif level == 3 then 
						if mouse.off == true then 
							initword("lure them to you with z", 12, 64, 4, 28, 13)
						else 
							initword("lure them to you with rclick", 4, 64, 4, 28, 13)
						end
					elseif level == 4 then 
						initword("you are doing great!", 22, 64, 6, 28, 13) 
					elseif level == 5 then 
						initword("thank you for playing", 22, 64, 6, 28, 13) 
					elseif level == 6 then 
						initword("--good luck!--", 28, 64, 6, 28, 13) 
					elseif level == 7 then 
						initword("now it is kinda hard", 20, 64, 6, 28, 13) 
					elseif level == 8 then 
						initword("game is not balanced for this!", 2, 64, 6, 28, 13) 
					elseif level == 9 then 
						initword("is this even possible?!", 12, 64, 6, 28, 13) 
					elseif level == 10 then 
						initword("i never reached this far myself", 0, 64, 6, 28, 13) 
					elseif level == 11 then 
						initword("i think you must be cheating", 4, 64, 6, 28, 13)
					elseif level == 12 then 
						initword("are you even human?", 20, 64, 6, 28, 13) 
					elseif level == 13 then 
						initword("don't play for a reward", 12, 64, 6, 28, 13) 
					elseif level == 14 then 
						initword("because this can go on forever", 1, 64, 6, 28, 13) 
					elseif level >= 15 then 
						initword("..............................", 0, 64, 6, 28, 13) 
					end
				end
			end
			entrytransition(0, 0, 1)
			drawui()		
			
			if ammo <= 0 then
				print("-"..deathcountdown.."-", 56, 64, 13)
			end
			if btn(4) or pntr() then 
				spr(5, mouse.x-4, mouse.y-4)
				if clickblink > 15 then 
					initparticle(mouse.x,mouse.y,rnd(0.5)-rnd(0.5),rnd(0.5)-rnd(0.5),1,2)
				end
			else 
				spr(1, mouse.x-4, mouse.y-4)
			end
			if glitch > 0 then 
				o1 = flr(rnd(0x1f00)) + 0x6040
				o2 = o1 + flr(rnd(0x4)-0x2)
				len = flr(rnd(0x40))
				memcpy(o1,o2,len)
			end	
			
		else
			for i=0,20 do 
				for j =0, 20 do 
			 		mset(i, j, 116)
			 	end
			end
			rectfill(0,32,128,83, 2)

			print("-pulse hook-", 40, 43, 8)
			print("-pulse hook-", 40, 42, 14)
	
			if mouse.off == false then 
				print("controls:mouse and z", textscroll, 85, 2)
				print("controls:mouse and z", textscroll, 86, 14)
			else
				print("controls:arrow keys/Ž/—", textscroll-20, 85, 2)
				print("controls:arrow keys/Ž/—", textscroll-20, 86, 14)
			end

			spr(34, eye1x+cos(eye1angle)*1.5, eye1y+sin(eye1angle)*1.5, 2, 2)
			spr(34, eye2x+cos(eye2angle)*1.5, eye2y+sin(eye2angle)*1.5, 2, 2)
			
			if clickblink < 14 then
				spr(6,46,46,4,4)
			else
				spr(10,46,46,4,4)
			end

			if clickblink < 20 then
				if mouse.off == false then 
					print("click to start", 36, 75, 1)
				else
					print("press — to start", 28,75, 1)
				end
			end

			spr(2, mouse.x-4, mouse.y-4)
			print("highscore:"..flr(highscore), 72, 26, 13)

			if mouse.off == false then 
				print("mouse:on", 2,26, 13)
			else 
				print("mouse:off", 2,26, 13)
			end

			print("by @elastiskalinjen", 50, 120, 2)
			print("by @elastiskalinjen", 50, 121, 12)
			entrytransition(0, 0, 1)
		end
	else
		rectfill(0,32,128,83,2)
		print("-game over-", 40, 43, 8)
		print("-game over-", 40, 42, 14)
		print("score:"..flr(score), 47, 75, 1)
		if clickblink < 20 then 
			if mouse.off == false then 
				print("click to restart", 34, 120, 8)
			else
				print("press — to restart", 28, 120, 8)
			end
		end
		if newrecord then 
			print("highscore!", 44, 4, 12)
		end

		spr(96, eye1x+cos(eye1angle)*1.5, eye1y+sin(eye1angle)*1.5, 2, 2)
		spr(96, eye2x+cos(eye2angle)*1.5, eye2y+sin(eye2angle)*1.5, 2, 2)

		spr(3, mouse.x-4, mouse.y-4)
		entrytransition(0, 0, 2)
	end
end

function drawui()
	if ammo > 1 then 
		rect(0,0,127,127,1)
	else 
		rect(0,0,127,127,8)
	end
	print("score:",90,2,12)
	print(flr(scrollingscore),115,2,8)
	
	print("level:",2,2,12)
	print(level,27,2,8)
	print("blobs:",2,121,12)
	for i=1, ammo do
		spr(48, 24 + i*3, 118)
	end

	print("next:", 95, 121,12)
	print(flr(scrollinggoal), 115, 121,8)
end

tim = 0
function initword(word, x, y, height, speedLimiter, color)
	tim += 0.5
	for i=0, #word, 1 do
		print(sub(word, i, i), x + (i * 4), y + sin((tim + i) / speedLimiter) * height, color)
	end
end

------------------------------------------

mouse=
{	
	x=0,y=0, 
	b=0,ob=0,
 	rad=4,hit=0,off=true,dx=0,dy=0,acc = 0.3,speed= 1.24,
	init=function()
		poke(0x5f2d,1)
		mouse.x=mid(0,stat(32),127)
		mouse.y=mid(0,stat(33),127)
		mouse.b= stat(34)				
	end,	
	update=function()
		mouse.ob=mouse.b
		mouse.dx *= 0.85
 		mouse.dy *= 0.85

		if btn(0) or btn(1) or btn(2) or btn(3) or mouse.off == true then
			mouse.off = true
			dset(3,0)
			mouse.dx=min(mouse.dx, mouse.speed)
 			mouse.dx=max(mouse.dx,-mouse.speed)
 			mouse.dy=min(mouse.dy, mouse.speed)
 			mouse.dy=max(mouse.dy,-mouse.speed)
 			mouse.x += mouse.dx
 			mouse.y += mouse.dy
			if btn(0) then mouse.dx-=mouse.acc end
			if btn(1) then mouse.dx+=mouse.acc end
			if btn(2) then mouse.dy-=mouse.acc end
			if btn(3) then mouse.dy+=mouse.acc end

			if mouse.x <= 4 or mouse.y <= 4 or mouse.x >= 120 or mouse.y >= 120 then --((space+2) * 8))
				mouse.x = lerp(mouse.x,64,0.016)
				mouse.y = lerp(mouse.y,64,0.016)
			end
		end

		if mouse.off == false then
			mouse.x=mid(0,stat(32),127)
			mouse.y=mid(0,stat(33),127)
		end
		mouse.b= stat(34)
	end,
}
-- mouse newly pressed
function pntp() return (mouse.b==1 and mouse.ob==0) end
-- mouse pressed
function pnt()  return (mouse.b==1) end
-- mouse newly released
function pntr() return (mouse.b==0 and mouse.ob==1) end
-- mouse coordinates: x,y=pntc()
function pntc() return mouse.x,mouse.y end

function pntr()  return (mouse.b==2) end


nextlevelscore = 19
level = 1
ammoperlevel = 4
deathcountdown = 160
dead = false
enemiecount = 1
glitch = 0
function playerloop()
	if score >= nextlevelscore then
		glitch = 60
		nextlevelscore += 14 * level
		level+=1
		enemiecount+= 0.7
		if (randscrub < 100)randscrub += 10
		sfx(1)
		ammoperlevel+=1.5
		flr(ammoperlevel)
		ammo = ammoperlevel
		deathcountdown = 160
		starthelp=120
		for e in all(enemies) do
			del(enemies, e)
		end
		for p in all(points) do
			p.dead = true
		end
		for l in all(lines) do
			del(lines, l)
		end
		for c in all (circles) do 
			del(circles, c)
		end

		for i=1, flr(enemiecount) do
			initenemy(rnd(128), rnd(128), scrubpicker())
		end

		for i=1, 25 do
			initparticle(flr(rnd(128)), flr(rnd(128)), rnd(1)-rnd(1), rnd(1)-rnd(1), 1+flr(rnd(2)), 12)
		end

		for i=0,20 do 
			for j =0,20 do 
			 	mset(i,j,64+(level))
			 end
		end
		tim = 0
	end

	if ammo <= 0 then 
		if deathcountdown > 0 then 
			deathcountdown-=1
		else
			if dead == false then
				for i=0,20 do 
					for j =0,20 do 
			 			mset(i,j,80)
			 		end
				end
				transpeed = 0
				dead = true
				shake = 0.1
				sfx(3)
				for i=1, 25 do
					initparticle(flr(rnd(128)), flr(rnd(128)), rnd(1)-rnd(1), rnd(1)-rnd(1), 1+flr(rnd(2)), 8)
				end

				if highscore < score then
					newrecord = true
					dset(0,score)
				end
			end
		end
	end
end

randscrub = 0
function scrubpicker()
	dice=rnd(randscrub)

	if dice < 50 then--50
		index = 0
	elseif dice >= 50 and dice < 70 then--20
		index = 1
	elseif dice >= 70 and dice < 90 then--20
		index = 2
	elseif dice >= 90 and dice <= 100 then--10
		index = 3
	end

	return index
end

function playerupdate()
	if (pntp() or btnp(5)) and ammo > 0 then
		ammo-=1
		sfx(0) 
		for i=0,10 do 
			initparticle(mouse.x, mouse.y, rnd(1)-rnd(1), rnd(1)-rnd(1), 1+flr(rnd(2)), 8)
		end
		shake +=0.05
		initpoint(mouse.x, mouse.y)
	end
end

-- by zep
transpeed = 0
function entrytransition(x, y, col)
	for y=0, 16 do
		for x=0, 16 do
			local sx = x * 8
			sx += (y % 2) * 4
			local sy = y * 8
			q = transpeed - y/10 - x/40
			q -= 0.8
			q = mid(0, 1-q, 1)

			if q > 0 then
				circfill(x + sx,y+sy, q*5, col)
			end
		end
	end
end


