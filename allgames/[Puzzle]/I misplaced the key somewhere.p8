pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
--can't enter the spaceship..
--by shomaisshi

function _init()
	map_setup()
	text_setup()
	make_player()
	
	game_win=false
	game_over=false
end

function _update()
	if (not game_over) then
		if (not active_text) then
			update_map()
			move_player()
			check_win_lose()
		end
	else
		if (btnp(—)) extcmd("reset")
	end
end

function _draw()
	cls()
	if (not game_over) then
		draw_map()
		show_inventory()
		draw_player()
		draw_text()
	else
		draw_win_lose()
	end
end

-->8
--map code

function map_setup()
	--timers
	timer=0
	anim_time=30 --30 = 1 second

	--map tile setting
	wall={13,18,30,34,36,38,39,40,41,50,52,55,58,59}
	keys={16,20}
	door={41,52}
	anim1={23}
	anim2={24}
	text={20,39,55,36,38,40}
	lose={23}
	win={9}
	gold={58}
	block={25}
	warp={5,7,11}
end

function update_map()
	if (timer<0) then
		toggle_tiles()
		timer=anim_time
	end
	timer-=1
end

function draw_map()
	mapx=flr(p.x/16)*16
	mapy=flr(p.y/16)*16
	camera(mapx*8,mapy*8)

	map(0,0,0,0,128,128)
end

function is_tile(tile_type,x,y)
	tile=mget(x,y)
	for i=1,#tile_type do
		if (tile==tile_type[i]) return true
	end
	return false
end

function can_move(x,y)
	return not is_tile(wall,x,y)
end

function swap_tile(x,y)
	tile=mget(x,y)
	mset(x,y,tile+1)
end

function unswap_tile(x,y)
	tile=mget(x,y)
	mset(x,y,tile-1)
end

function get_keys(x,y)
	p.keys+=1
	swap_tile(x,y)
	sfx(3)
end

function get_gold(x,y)
	p.gold+=5
	swap_tile(x,y)
	sfx(3)
end

function open_door(x,y)
	p.keys-=1
	swap_tile(x,y)
	sfx(4)
end

function break_block(x,y)
	swap_tile(x,y)
	sfx(8)
end

--warp
function warp_point(x,y,prex,prey,nextx,nexty)
	if (x==prex and y==prey) then
		newx=nextx
		newy=nexty
	end
end

function warp_stairs(x,y)
	sfx(6)
	if (timer<0) then
		warp_point(x,y,11,1,13,18)
		warp_point(x,y,13,17,12,1)
		warp_point(x,y,5,22,4,26)
		warp_point(x,y,4,26,5,22)
	end
end
-->8
--player code

function make_player()
	p={}
	p.x=2
	p.y=13
	p.sprite=3
	p.keys=0
	p.gold=0
	p.oxygen=99
end

function draw_player()
	spr(p.sprite,p.x*8,p.y*8)
end

function move_player()
	newx=p.x
	newy=p.y
	
	if (btnp(‹)) newx-=1 p.sprite=1
	if (btnp(‘)) newx+=1 p.sprite=2
	if (btnp(”)) newy-=1 p.sprite=3
	if (btnp(ƒ)) newy+=1 p.sprite=4
	if (btnp(‹) or btnp(‘) or btnp(”) or  btnp(ƒ)) then
		p.oxygen-=1
	end
	
	interact(newx,newy)
	
	if (can_move(newx,newy)) then
		p.x=mid(0,newx,127)
		p.y=mid(0,newy,63)
	else
		sfx(2)
	end
	
end

function interact(x,y)
	
	if (is_tile(text,x,y)) then
		active_text=get_text(x,y)
		sfx(10)
	end

	if (is_tile(keys,x,y)) then
		get_keys(x,y)
	elseif (is_tile(door,x,y) and p.keys>0) then
		open_door(x,y)
	elseif (is_tile(gold,x,y)) then
		get_gold(x,y)
	elseif (is_tile(block,x,y)) then
		break_block(x,y)
	elseif (is_tile(warp,x,y)) then
		warp_stairs(x,y)
	end
end
-->8
--inventory code

function show_inventory()
	invx=mapx*8+8
	invy=mapy*8+120
	
	rectfill(invx,invy,invx+128,invy+8,1)
	--print("inventory",invx+7,invy+4,7)
	print("keys "..p.keys,invx+2,invy+2,7)
	print("gold "..p.gold,invx+32,invy+2,7)
	oxycol=12
	if (p.oxygen<10) then oxycol=8 end
	print("oxygen "..p.oxygen,invx+82,invy+2,oxycol)	
end
-->8
--animation code

function toggle_tiles()
	for x=mapx,mapy+15 do
		for y=mapy,mapy+15 do
			if (is_tile(anim1,x,y)) then
				swap_tile(x,y)
				--sfx(5)
			elseif (is_tile(anim2,x,y)) then
				unswap_tile(x,y)
				--sfx(5)
			end
		end
	end
end
-->8
--win/lose code

function check_win_lose()
	if (is_tile(win,p.x,p.y)) then
		game_win=true
		game_over=true
		--sfx(9)
		sfx(1)
	elseif (is_tile(lose,p.x,p.y) or p.oxygen==0) then
		game_win=false
		game_over=true
	end
end

function draw_win_lose()
	camera()
	
	textx=mapx*8+4
	texty=mapy*8+52
	
	if (game_win) then
		print("’ mission clear! ’",26,34,12)
		rectfill(textx,texty,textx+119,texty+31,7)
		print("i'm sorry,\ni kept the key on the ui.",textx+4,texty+4,1)
		print("press — to play again",textx+4,texty+23,6)
	else
		print("game over",44,34,8)
		rectfill(textx,texty,textx+119,texty+40,7)
		print("i lost keys.\nso sorry everyone...\ni guess that the keys are in\nthis area..",textx+4,texty+4,1)
		print("press — to play again",textx+4,texty+32,6)
	end
end

-->8
--text code

function text_setup()
	start=true
	texts={}
	add_text(5,2,"i don't need treasure\nbut, i want to go home..")
	add_text(4,12,"can't enter the spaceship")
	add_text(15,14,"it's all over for us")
end

function add_text(x,y,message)
	texts[x+y*128]=message
	texts[0]="--mission--\nback to the spaceship\nbefore the oxygen runs out."
end

function get_text(x,y)
	return texts[x+y*128]
end

function draw_text()
	if (start==true) then
		active_text=texts[0]
		sfx(10)
		start=false
	end

	if (active_text) then
		textx=mapx*8+4
		texty=mapy*8+52
		
		rectfill(textx,texty,textx+119,texty+31,7)
		print(active_text,textx+4,texty+4,1)
		print("—",textx+4,texty+23,6)		
	end
	
	if (btnp(—) or btnp(4)) active_text=nil
end
