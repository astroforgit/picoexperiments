function ai_move(ai_turn)
 aito = ai_turn
 qualm = 1
end
function ai_set(ai_turn)
 qualm = 0
 analyze(1)
 ai_value = value
 list = {}
 alog = {}
 tfor_mate(true)
 ende = false
	ait = ai_turn
 if legalmoves == 0 then
 	 if (check_flag == 1) checkmate() else stalemate()
 	 ende = true
	end
	if not ende then
  deeper(ai_level)
  y_sel = cut[2]
  x_sel = cut[1]
  p_sel = board[cut[2]][cut[1]]
  if (p_sel > 10) p_sel -= 10
  turndo(cut[3],cut[4])
 end
end

function ai_one()
 high = ai_value+6
 gist = {}
 for i = 1, #alog do
  if (alog[i] > high) add (gist,list[i])
 end
 if #gist == 0 then
  split(list[ceil(rnd(#list))])
 else
  split(gist[ceil(rnd(#gist))])
 end
end

function ai_zero()
 split(list[ceil(rnd(#list))])
end 

function ai_two()
 low = -22222
 gist = {}
 for i = 1, #list do
  add (gist,list[i])
 end
 for x = 1, 8 do
  for y = 1, 8 do
   gboard[y][x] = board[y][x]
  end
 end
 kist = {}
 klog = {}
 kid = {}
 for i = 1, #gist do
 list = {}
 alog = {}
 qlog = {}
 qist = {}
  split(gist[i])
  board[cut[4]][cut[3]] = board[cut[2]][cut[1]]
  board[cut[2]][cut[1]] = 0
  flipturn()
  tfor_mate(true)
  high = 22222
  for j = 1, #list do
   add (qlog,alog[j])
   add (qist,list[j])
  end
  for j = 1, #qist do
   split(qist[j])
   per = i/#gist*100
   if qlog[j] < high then
    high = qlog[j]
    tid = j
   end
  end
  add(klog,high)
  add(kid,tid)
  flipturn()
  for x = 1, 8 do
   for y = 1, 8 do
    board[y][x] = gboard[y][x]
   end
  end
 end
 gopnyk = false
 repeat
  free = true
  high = -22222
  for i = 1, #klog do
   if (klog[i] > high+5) highd = i high = klog[highd]
  end
  gisteroutput = 22222
  if (ai_level == 3) modifgister(highd)
  if klog[highd] > gisteroutput then
   klog[highd] = gisteroutput
   free = false
   gopnyk = true
  end
 until free
 if not gopnyk then
 for i = 1, #klog do
  if (klog[i] == high) add(kist,i)
 end
 else
  add(kist,highd)
 end
 pawncount = 0
 if turn_counter < 5 then
  checkpawns(ait)
 end
 turn_counter += 1
 if pawncount > 5 and not gopnyk and rnd(2) > 0.2+turn_counter/3 then
  if turn_counter == 1 and startturn == 0 and rnd(1) > 0.2 and board[5][5] == 1 then
  split(5254)
  else  
   schmoove = {}
  for i = 1, #gist do
   split(gist[i])
   if board[cut[2]][cut[1]]%10 == 1 then
    add (schmoove,gist[i])
   end
  end
  split(schmoove[ceil(rnd(#schmoove))])
  end
 else
 split(gist[kist[ceil(rnd(#kist))]])
 end
end

function checkpawns(p_t)
 pawncount = 0
 for i = 1, 8 do
  if board[p_t*-2.5+4.5][i] == p_t*5+6 then
   pawncount += 1
  end
 end
end


function deeper(level)
if (level == 0) ai_zero()
if (level == 1) ai_one()
if (level == 2) ai_two()
if (level == 3) ai_two()
 pmc = cut[1]
 pmx = cut[1]
 pmy = cut[2]
end


function split(input)
 splice = tostr(input)
 cut = {}
 for i = 1, #splice do
  add(cut,tonum(sub(splice,i,i)))
 end
end
function flipturn()
 if (turn == 0) turn = 1 else turn = 0
end

function goldogrin(val)
 flipturn()
  list = {}
  alog = {}
  h1 = board[cut[4]][cut[3]]
  board[cut[4]][cut[3]] = board[cut[2]][cut[1]]
  board[cut[2]][cut[1]] = 0
 tfor_mate(true)
 flipturn()
 if (legalmoves == 0) qlog[val] -= 9999
 if (checkflag == 1) qlog[val] -= 2.5   
 board[cut[2]][cut[1]] = board[cut[4]][cut[3]]
 board[cut[4]][cut[3]] = h1
end


function modifgister(aye)
 list = {}
 alog = {}
 qlog = {}
 qist = {}
 split(gist[aye])
 board[cut[4]][cut[3]] = board[cut[2]][cut[1]]
 board[cut[2]][cut[1]] = 0
 flipturn()
 tfor_mate(true)
 flip()
 for j = 1, #list do
  add (qlog,alog[j])
  add (qist,list[j])
 end
 for j = 1, #qist do
  split(qist[j])
  per = j/#qist*100
  if (ai_level == 3) goldogrin(j) 
  if qlog[j] < high then
   high = qlog[j]
   tid = j
  end
 end
 gisteroutput = high
 flipturn()
 for x = 1, 8 do
  for y = 1, 8 do
   board[y][x] = gboard[y][x]
  end
 end
end
