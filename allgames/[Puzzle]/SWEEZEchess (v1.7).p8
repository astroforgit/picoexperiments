function analyze(wdir)
 value = 0
 for x = 1, 8 do
  for y = 1, 8 do
   if (x > 4) alx = 9-x else alx = x
   ga = board[y][x]
   if ga > 10 then
    ga -= 10
    if (wdir == -1) ya = 9-y else ya = y
    value += worth[ga][ya][alx]*wdir
   elseif ga > 0 and ga < 10 then
    if (wdir == 1) ya = 9-y else ya = y
    value -= worth[ga][ya][alx]*wdir
   end
  end
 end
end

function setupworths()
 worth_pawn = {
 {90,90,90,90},
 {15,15,16,20},
 {11,11,15,18},
 {10.5,10.5,14,15},
 {10,12,13,15},
 {10.5,9.5,9,10},
 {10.5,11,9,11},
 {10,10,10,10}}
 worth_rook = {
 {50,50,50,50},
 {50.5,51,51,51}}
 for i = 1, 5 do
 add(worth_rook,{49.5,50,50,50})
 end
 add(worth_rook,{49.5,999,50,50.5})
 worth_knight = {
 {25,26,27,27},
 {26,28,30,30},
 {27,30,31,31.5},
 {27,30.5,31.5,32},
 {27,30,31.5,32},
 {27,30.5,30,31.5},
 {26,28,30,30.5},
 {25,26,27,27}}
 worth_bishop = {
 {28,29,29,29},
 {29,30,30,30},
 {29,30,30.5,31},
 {29,30.5,30.5,31},
 {29,30,31,31},
 {29,31,31,31},
 {29,30.5,30,30},
 {28,29,29,29}}
 worth_queen = {
 {88,89,89,89.5},
 {89,90,90,90},
 {89,90,90.5,90.5},
 {89.5,90,90.5,90.5},
 {90,90,90.5,90.5},
 {89,90.5,90.5,90.5},
 {90,90,90.5,90},
 {88,89,89,89.5}}
 worth_king = {}
 for i = 1, 4 do
 	add(worth_king,{997,996,996,995})
 end
 add(worth_king,{998,997,997,996})
 add(worth_king,{999,998,998,998})
 add(worth_king,{1002,1002,1000,1000})
 add(worth_king,{1002,1003,1001,1000})
 worth = {}
 add (worth,worth_pawn)
 add (worth,worth_rook)
