pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--plant escape
--tom brinton

p={}
p.x=1
p.y=6

path={}
add(path,{1,7})

level=1
switches=0
lx=0
ly=0

camx=0
camy=0

rex=1
rey=6

gamemode="title"

function _init()
 poke(0x5f2c,3)
 cls()
 getswitches()
end

function _update()
if gamemode=="title" then
 if btn(Ž) and btn(—) then
  gamemode="play"
 end
elseif gamemode=="play" then
 mset(p.x,p.y,33)
 if btnp(”) and not fget(mget(p.x,p.y-1),0) then
  updatepath(p.x,p.y-1)
 elseif btnp(ƒ) and not fget(mget(p.x,p.y+1),0) then
  updatepath(p.x,p.y+1)
 elseif btnp(‹) and not fget(mget(p.x-1,p.y),0) then
  updatepath(p.x-1,p.y)
 elseif btnp(‘) and not fget(mget(p.x+1,p.y),0) then
  updatepath(p.x+1,p.y)
 end
 if btn(Ž) and btn(—) then
  resetgame()
 end
 updatelevel()
 if stuck() then
  gamemode="stuck"
  sfx(5)
 end
 if p.x==126 and p.y==62 then
  sfx(4)
  gamemode="win"
 end
elseif gamemode=="stuck" or gamemode=="win" then
 if btn(Ž) and btn(—) then
  resetgame()
 end
end
end

function _draw()
 cls()
 updatecam()
 camera(camx,camy)
 map(0,0,0,0,127,64)
 if gamemode=="stuck" then
  fillp(0b0101101001011010.1)
  rectfill(camx,camy,camx+64,camy+64,2)
  fillp()
  printo("plant b stuck",camx+6,camy+24,7,0)
  printo("Ž + —\n reset",camx+18,camy+40,10,0)
 elseif gamemode=="title" then
  fillp(0b0101101001011010.1)
  rectfill(camx,camy,camx+64,camy+64,1)
  fillp()
  printo("plant escape",camx+9,camy+24,7,0)
  printo("Ž + —\n start",camx+18,camy+40,10,0)
 elseif gamemode=="win" then
  fillp(0b0101101001011010.1)
  rectfill(camx,camy,camx+64,camy+64,3)
  fillp()
  printo("plant escaped",camx+6,camy+24,7,0)
  printo("Ž + —\n reset",camx+18,camy+40,10,0)
 end
 --print(switches,camx,camy,8)
end
-->8
function updatepath(nx,ny,d)
 if mget(nx,ny)==5 then 
  switches-=1 
  sfx(1)
 else
  sfx(0)
 end
 
 prx=path[#path][1]
 pry=path[#path][2]
 ptile=mget(prx,pry)
 
 --set correct map tile
 if ptile==16 or ptile==32 then
  if nx<p.x then 
   if pry>p.y then 
    mset(p.x,p.y,19)
   else
    mset(p.x,p.y,20)
   end
  end
  if nx>p.x then 
   if pry>p.y then 
    mset(p.x,p.y,17)
   else
    mset(p.x,p.y,21)
   end
  end
  if ny!=p.y then mset(p.x,p.y,16) end
 elseif ptile==18 then
  if ny<p.y then 
   if prx>p.x then 
    mset(p.x,p.y,21)
   else
    mset(p.x,p.y,20)
   end
  end
  if ny>p.y then 
   if prx>p.x then 
    mset(p.x,p.y,17)
   else
    mset(p.x,p.y,19)
   end
  end
  if nx!=p.x then mset(p.x,p.y,18) end
 elseif ptile==17 then
  if prx!=p.x then
   if nx>p.x then mset(p.x,p.y,18) end
   if ny<p.y then mset(p.x,p.y,20) end
   if ny>p.y then mset(p.x,p.y,19) end
  elseif pry!=p.y then
   if ny>p.y then mset(p.x,p.y,16) end
   if nx<p.x then mset(p.x,p.y,20) end
   if nx>p.x then mset(p.x,p.y,21) end 
  end
 elseif ptile==19 then
  if prx!=p.x then
   if nx<p.x then mset(p.x,p.y,18) end
   if ny<p.y then mset(p.x,p.y,21) end
   if ny>p.y then mset(p.x,p.y,17) end
  elseif pry!=p.y then
   if ny>p.y then mset(p.x,p.y,16) end
   if nx<p.x then mset(p.x,p.y,20) end
   if nx>p.x then mset(p.x,p.y,21) end 
  end
 elseif ptile==20 then
  if prx!=p.x then
   if nx<p.x then mset(p.x,p.y,18) end
   if ny<p.y then mset(p.x,p.y,21) end
   if ny>p.y then mset(p.x,p.y,17) end
  elseif pry!=p.y then
   if ny<p.y then mset(p.x,p.y,16) end
   if nx<p.x then mset(p.x,p.y,19) end
   if nx>p.x then mset(p.x,p.y,17) end 
  end
 elseif ptile==21 then
  if prx!=p.x then
   if nx>p.x then mset(p.x,p.y,18) end
   if ny<p.y then mset(p.x,p.y,20) end
   if ny>p.y then mset(p.x,p.y,19) end
  elseif pry!=p.y then
   if ny<p.y then mset(p.x,p.y,16) end
   if nx<p.x then mset(p.x,p.y,19) end
   if nx>p.x then mset(p.x,p.y,17) end 
  end 
 end

 --add old coords to path
 add(path,{p.x,p.y})
 --update coords
 p.x=nx
 p.y=ny
end

function updatelevel()
 --open doors
 if switches==0 then
  for i=lx,lx+8 do
  for j=ly,ly+8 do
   if mget(i,j)==3 then
    mset(i,j,4)
   end
  end
  end
 end
 --go to next level
 if p.x-lx >7 then
  lx+=7
  sfx(2)
  getswitches()
 end
 if p.x-lx <0 then
  lx-=7
  sfx(2)
  getswitches()
 end
 if p.y-ly >7 then
  ly+=7
  sfx(2)
  getswitches()
 end
end

function updatecam()
 llx=lx*8
 lly=ly*8
 if (llx>camx) camx+=4
 if (llx<camx) camx-=4
 if (lly>camy) camy+=4
 if (lly<camy) camy-=4
end

function notsmoothcam() 
 if abs(camx-llx)>.5 or abs(camy-lly)>.5 then
  ang=atan2(llx-camx,lly-camy)
  camx+=cos(ang)
  camy+=sin(ang)
 else
  camx=llx
  camy=lly
 end
end
-->8
function printo(text,x,y,c,bc)
 for i=x-1,x+1 do
 for j=y-1,y+1 do
  print(text,i,j,bc)
 end
 end
  print(text,x,y,c)
end
-->8

function getswitches()
 --find out how many
 --switches are in the current
 --level
 switches=0
 for i=lx,lx+7 do
  for j=ly,ly+7 do
   if mget(i,j)==5 then
    switches+=1
   end
  end
 end
 --other new level stuff

 
end

function stuck()

 if not fget(mget(p.x-1,p.y),0) then
 	return false
 elseif not fget(mget(p.x+1,p.y),0) then
 	return false
 elseif not fget(mget(p.x,p.y-1),0) then
 	return false
 elseif not fget(mget(p.x,p.y+1),0) then
 	return false
 end

 return true
end

function resetgame()
 reload(0x2000, 0x2000, 0x1000)
  for p in all(path) do
   del(path,p)
  end
  add(path,{1,7})
  gamemode="play"
  p.x=1
  p.y=6
  lx=0
  ly=0
  getswitches()
  sfx(3)
end
