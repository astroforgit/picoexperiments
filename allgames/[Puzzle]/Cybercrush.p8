pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--cybercrush 1.0
--by fuchikoma71

function _init()
 n=8
 grid={} 
 for i=0,n-1 do
  grid[i]={}
  for j=0,n-1 do
   grid[i][j]={}
   grid[i][j].x=i
   grid[i][j].y=j
   grid[i][j].z=-1
  end
 end
 fill()
 group={}
 x=flr(rnd()*n)
 y=flr(rnd()*n)
 t=0
 ds=0
 ss=0
 mm=0
 palt(5,true)
 palt(0,false)
 stage=0
 hits=0
 score=0
 display=false
 points={}
 events={}
 for i=1,16 do
  points[i]=0
  events[i]=0
 end
end

function _update()
 if stage==0 then
  if btnp(5) then
   stage=1
  end
 else
  x2=x
  y2=y
  if btnp(0) then
   x2=(x+n-1)%n
  end
  if btnp(1) then
   x2=(x+1)%n
  end
  if btnp(2) then
   y2=(y+n-1)%n
  end
  if btnp(3) then
   y2=(y+1)%n
  end
  if btn(4) then
   swap(grid[x][y],grid[x2][y2])
  end
  if btnp(5) then
   display=not display
  end
  x=x2
  y=y2
  step()
  if stable and hits>0 then
   findscore()
  end
 end
 t=(t+1)%120
 if total>0 and total<n*n then
  ds=flr((t%30)/3)
  if t%30==0 then
   ss=(ss+1)%60
   if ss==0 then
    mm=min(mm+1,99)
   end
  end
 end
end

function _draw()
 if stage==0 then
  draw_intro()
 else
  if stage==1 then
   draw_game()
  end
 end
 draw_glitch()
end

function draw_intro()
 cls()
 camera(0,0)
 rectfill(0,32,127,67,10)
 sspr(0,40,106,40,11,32)
 print("by fuchikoma71",38,84,2)
 print("by fuchikoma71",39,83,8)
 camera(flr(rnd()*2),flr(rnd()*2))
 if t%8>2 then
  print("press — to start...",50,120,12)
 end
end

function draw_game()
 cls()
 camera(x-4,y-4)
 for i=0,n-1 do
  for j=0,n-1 do
   xpos=i*16
   ypos=j*16
   if grid[i][j].z>=0 then
    sspr(grid[i][j].z*16,0,16,16,xpos,ypos)
   else
    sspr(64,0,16,16,xpos,ypos)
   end   
  end
 end
 draw_clock()
 camera(0,0)
 xpos=x*16-6+abs(x-8)/2
 ypos=y*16-6+abs(y-8)/2
 xpos=x*16-x
 ypos=y*16-y
 sspr(flr(t/2)%4*24,16,24,24,xpos,ypos)
 if display or total==n*n then
  draw_score()
 end
end

function draw_score()
 lines=3
 for i=1,16 do
  if events[i]>0 then
   lines+=1
  end
 end
 camera(-32,-32)
 rectfill(0,0,64,4+lines*6,1)
 rect(1,-1,65,3+lines*6,12)
 rectfill(40,-6,66,2,1)
 rect(41,-7,67,1,12)
 print("hacks",45,-5,12)
 j=0
 for i=1,16 do
  if events[i]>0 then
   print(events[i].." x",10,6+j*6,12)
   if i<3 then
    print((i*4).." = "..points[i],30,6+j*6,12)
   else
    print((i*4).." = "..points[i],26,6+j*6,12)
   end
   j+=1
  end
 end
 j+=1  
 print("files  = "..score,10,4+j*6,12)
end

function draw_clock()
 posx=-8
 posy=-112
 if x<n/2 then
  posx=-90
 end
 if y>=n/2 then
  posy=-8
 end
 camera(posx,posy)
 rectfill(0,0,30,8,1)
 rect(1,-1,31,7,12)
 if mm<10 then
  print("0"..mm..":",3,1,12)
 else
  print(mm..":",3,1,12)
 end
 if ss<10 then
  print("0"..ss..".",15,1,12)
 else
  print(ss..".",15,1,12)
 end
 print(ds,27,1,12)
end

function findscore()
 unit=1
 events[hits/4]+=1
 for i=1,hits do
  score+=unit
  points[hits/4]+=unit
  if i%4==0 then
   unit*=2
  end
 end
 hits=0
end

function swap(one,two)
 sve=one.z
 one.z=two.z
 two.z=sve
 stable=false
end

function step()
 stable=true
 z=0
 while stable and z<4 do
  fall(z)
  if stable then
   z+=1
  end
 end
 if not stable then
  move(z)
 else
  crush()
 end
end

function fill()
 tile={}
 for i=0,3 do
  tile[i]=n*n/4
 end
 total=n*n
 while total>0 do
  repeat
   z=flr(rnd()*4)
  until tile[z]>0
  repeat
   i=flr(rnd()*n)
   j=flr(rnd()*n)
   block=false
   if i>0 then
    if grid[i-1][j].z==z then
     block=true
    end
   end
   if i<n-1 then
    if grid[i+1][j].z==z then
     block=true
    end
   end
   if j>0 then
    if grid[i][j-1].z==z then
     block=true
    end
   end
   if j<n-1 then
    if grid[i][j+1].z==z then
     block=true
    end
   end
  until not block
  if grid[i][j].z>=0 then
   tile[grid[i][j].z]+=1
  else
   total-=1
  end
  grid[i][j].z=z
  tile[z]-=1
 end
end

function crush()
 for i=0,n-1 do
  for j=0,n-1 do
   if grid[i][j].z>=0 then
    list={}
    group={}
    l=1
    g=0
    add(list,grid[i][j])
    z=grid[i][j].z
    while l>0 do
     next=list[1]
     add(group,next)
     g+=1
     for dir=0,3 do
      cell=nil
      if dir==0 and next.x>0 then
       cell=grid[next.x-1][next.y]
      end
      if dir==1 and next.x<n-1 then
       cell=grid[next.x+1][next.y]
      end
      if dir==2 and next.y>0 then
       cell=grid[next.x][next.y-1]
      end
      if dir==3 and next.y<n-1 then
       cell=grid[next.x][next.y+1]
      end
      if cell!=nil then
       if cell.z==z then
        if not contains(list,cell) and not contains(group,cell) then
         add(list,cell)
         l+=1
        end
       end
      end
     end 
     del(list,next)
     l-=1
    end
    if g%4==0 then
     stable=false
     for cell in all(group) do
      total+=1
      hits+=1
      cell.z=-1
     end
    end
   end
  end
 end
end

function fall(z)
 falling={}
 stable=true
 for i=0,n-1 do
  for j=0,n-1 do
   cell=grid[i][j]
   if cell.z==z then
    if z==0 and i>0 then
     if grid[i-1][j].z<0 then
      add(falling,cell)
      stable=false
     end
    end
    if z==1 and i<n-1 then
     if grid[i+1][j].z<0 then
      add(falling,cell)
      stable=false
     end
    end
    if z==2 and j>0 then
     if grid[i][j-1].z<0 then
      add(falling,cell)
      stable=false
     end
    end
    if z==3 and j<n-1 then
     if grid[i][j+1].z<0 then
      add(falling,cell)
      stable=false
     end
    end
   end
  end 
 end
end

function move(z)
 for cell in all(falling) do
  cell.z=-1
  if z==0 then
   grid[cell.x-1][cell.y].z=0
  end
  if z==1 then
   grid[cell.x+1][cell.y].z=1
  end
  if z==2 then
   grid[cell.x][cell.y-1].z=2
  end
  if z==3 then
   grid[cell.x][cell.y+1].z=3
  end
 end
end

function contains(vct,obj)
 found=false
 for elt in all(vct) do
  if elt==obj then
   found=true
  end
 end
 return found
end

function draw_glitch()
 for i=1,8 do
  ypos=flr(rnd()*128)
  if(rnd()<0.5) then
   xpos=flr(rnd()*128)
   line(xpos,ypos,xpos+1+flr(rnd()*4),ypos,12)
  end
  for xpos=1,127 do
   pset(xpos,ypos,pget(xpos+1,ypos))
  end
 end
end
