pico-8 cartridge // http://www.pico-8.com
version 15
__lua__
-- benjamin soule
-- 2018 alakajam #3

di={1,0,0,1,-1,0,0,-1}
cl_max=7
tp_max=7
sl_max=cl_max+tp_max
xmax=15
ymax=12
pdat={0,1,2,2}
--pdat={0,2,2,2}
--test_end=true
--reset_hi=true
final=true
draw_max=6


function _init()
 
 ents={}
 logs={} 
 t=0
 cartdata("pandemia")
 if reset_hi then dset(0,99) end
 hiscore=dget(0) or 99
 
 --init_game()
 init_menu()

 
end


function init_menu()
 
 ents={}
 db=nil
 t=0
 music(0)
 menu=mke()
 local pos={}
 local sel=0
 local gsel=1
 local rn=nil
 local ln=nil
 local cred=0
 
 
 
 spark=mke(8,64,64)
 ready=nil 
 menu.upd=function()
  for p in all(pos) do
   p.x-=1
  end
 
  add(pos,{x=spark.x+3,y=spark.y+3})
  if #pos > 64 then
   del(pos,pos[1])
  end
  spark.x=64+sin(t/320)*16
  spark.y=64+cos(t/17)*(10+cos(t/32)*8)+sin(t/160)*12
  if rn then spark.x+= (rn*rn)/8 end
  -- timers
  ready=t>16
  if t==16 then 
   sfx(20) 
   cred+=1
  end
    
  -- command
  if rn then
   if btnp(0) then
    sel=(sel-1)%4
    sfx(19)
   elseif btnp(1) then
    sel=(sel+1)%4
    sfx(19)
   elseif btnp(2) or btnp(3) then
    gsel=1-gsel
    sfx(19)
   elseif btnp(4) and not ln then
    menu._shk=4
    if gsel==1 then
     if green==11 then
      ln=0
      sfx(17)
      music(-1)
     else
      sfx(7)
     end
    else
     sfx(18)
     pdat[1+sel]=(pdat[1+sel]+1)%3
    end
   end
  
  elseif btnp(4) and cred>0 then
   cred-=1
   sfx(17)
   rn=0
  end
  
   
  
  if rn and rn<64 then rn+=1 end
  if ln then
   if ln>16 then
    init_game()
   else 
    ln+=1
   end
  end

  
 end
 

 menu.upd(menu)
 
 menu.dr=function()
  
  -- border
  if t>16 then
   rect(0,0,127,127,4)
  end
  
  -- graph
  clip(2,2,124,124)
  for y=32,96,4 do
   line(0,y,127,y,2)
  end   
  local y=32
  for x=0,40 do
   cl=2
   if x%4==0 then cl=4 end
   if x%8==0 then cl=9 end   
   px=x*4-t%32
   line(px,y,px,y+64,cl)
  end
  line(0,64,127,64,9)
  
  -- bands
  apal(1)
  for i=0,ready and 1 or -1 do
   local x=(t*(i*2-1))%128 
   map(16,0,x,3+i*16)
   map(16,0,x-128,3+i*16)
  end
  pal()
  
  -- spark
  px=pos[1].x
  py=pos[1].y
  k=0
  if not rn or rn<256 then
   for p in all(pos) do
    cl=sget(k*8/#pos,25)
    line(px,py,p.x,p.y,cl)
    px=p.x
    py=p.y
    k+=1
   end
  end
  -- title
  if abs(t-17)<2 then
   apal(7)
  end
  local ty=64-(min(t/16,1)^.5)*60
  rectfill(0,ty+8,16,ty+13,4)
  rectfill(110,ty+8,127,ty+13,4)  
  sspr(0,97,93,20,(128-93)/2,ty)
  pal()
  -- press
  local vis=t%16<12
  if rn then vis=t%2<1 and rn<16 end
  if vis and ready then
   str="press <z> to start"
   print(str,64-#str*2,101,7)
  end
  
  -- credits  
  str="credit(s) : "..cred
  print(str,64-#str*2,110,13)
   
   
  -- footer
  if ready then
   str="a puzzle game by benjamin soule for alakajam #3 - 48h game jam - 2018 - "
   k=#str*4
   str=str..str
   print(str,-(t%k),rn and 121+rn or 121,1)
  
   -- animals
   local c=0
   if rn then c=min(rn/16,1)^2 end
   for k=0,1 do 
    clip()
    pal()
    if k==0 then    
     clip(0,ty+8,127,13)
    end
    for i=0,1 do
     rpal((t/32+i*4)%5)
     if k==0 then apal(2) end
     local fr=16+(i*2+t/128)%6
     local x=60+(i*2-1)*(54+c*24)
     local y=ty+2.5+cos(t/20+i/2)*2
     sh=(k-1)*3
     spr(fr,x-sh,y-sh,1,1,i==(rn and 1 or 0) )
    end
   end
   pal()
  end

		
  -- players
  local fd=ln and ln*ln or 0

  local ec=6
  local x=2 
  if rn and rn>16 then  
   local y=max(128-rn*rn/6,56)
   local by=y  
   for i=0,3 do
    ppal(i)
    local x=14+i*27
    y=max(128-rn*rn/6,56)-fd
    if i==sel and gsel==0 then
     y+=may(menu._shk)
    end
    for k=0,2 do
     cl=0
     if k==1 then
      cl=4
      if i==sel and gsel==0 then
       cl=t%4<2 and 7 or 11
      end      
     end    
     rectfill(x+k-3,y+k-3,x+18-k,y+18-k,cl)
    end    
    
    local k=pdat[i+1]
    sspr(k*16,64,16,16,x,y)    
    local a={"human","ia",""}
    local str=a[1+k]
    function f() 
     local y=y-10
     if i==sel then
      y-=may(menu._shk)*2
     end
     print(str,x+8-#str*2,y,7)
    end
    dsh(f)
   end
   
   -- start but
   
   ww=32
   x=(128-ww)/2
   y=by+26+fd
   rectfill(x-1,y-1,x+ww+1,y+9,0)
   cl=4
   if gsel==1 and not ln then   	
    local sum=0
    for k in all(pdat) do 
     if k<2 then sum+=1 end
    end  
    green = sum==0 and 8 or 11  
    cl=t%4<2 and 7 or green
   end    
   pal()
   rectfill(x,y,x+ww,y+8,cl)
   print("start",x+7,y+2,0)   
  end 
  
  -- fade
  if ln then fade(fd) end

 end
end

function fade(fd)
 for i=0,1 do
  rectfill(0,0,127,fd,0)
  rectfill(0,127-fd,127,127,0)
 end
end

function may(n)
 return n and n or 0
end

function ppal(i)
 pal(2,sget(6,i))
 pal(8,sget(7,i))
end


function init_game()
 
 ents={}
 kl(menu)
 menu=nil
 sel=0
 --grid
 grid={}
 for x=0,xmax-1 do for y=0,ymax-1 do
  sq={x=x,y=y,tp=rand(cl_max),cl=rand(tp_max)}
  if test_end and x+y>0 then
   sq.vir=rand(2)
  end
  add(grid,sq)
 end end
 -- arrow
 ar=mke(2)
 ar.transp=1
 ar.upd=function(e)
  if e.trg then
   local dx=e.trg.x-e.x
   local dy=e.trg.y-e.y
   e.x += dx*.5
   e.y += dy*.5
  end
 end
 
 -- players
 players={}
	pos=0
 for n=0,3 do
  local k=pdat[n+1]
  if k<2 then
   local pl={ 
    id=n,
    ia=k==1,
    choices={},
    sleep=true,
    turn=0,
    pool={},
    pos=pos,
   }
   get_score(pl)   
   for i=0,sl_max-1 do
    add(pl.pool,i)
   end
   add(players,pl)
   refill(pl,draw_max+1+pos)
   add_choice(pl,100)
   pos+=1
  end
 end
 

  
  
 -- start
 pl=players[1]
 nxt_player(true)
 
 
 
end

function show(e,dx,dy)
 ar.ddx=dx or 0
 ar.ddy=dy or 0
 ar.trg=e
end


function check_end()
 for sq in all(grid) do
  if not sq.vir then 
   return false 
  end
 end 
 
 local ranking={}
 for pl in all(players) do add(ranking,pl) end
 
 function chk(a,b) return a.score<b.score end
 sort(ranking,chk)
 
 --[[
 local win=nil
 for pl in all(players) do
  if not win or pl.score>win.score then
   win=pl
  end
 end
 --]]
 
 -- hiscore
 new_hi=pl.turn<hiscore and not pl.ia
 if new_hi then
  hiscore = pl.turn
  dset(0,hiscore)
 end
 
 -- debrief
 t=0
 ww=64
 hh=64 
 fd=nil
 music(16)
 sfx(21)
 ar.trg=nil
 mvt(ar,64,128,8)
 ar.krv=slow_in
 
 db=mke()
 db.x=(128-ww)/2-1
 db.y=(128-hh)/2-6
 db.y-=128
 mv(db,0,128,8)

	function cpr(str,y,cl)
	 print(str,ww/2-#str*2,y,cl)
	end

 db.dr=function(e,x,y) 
  local n=cos(t/32)*2+.5
  local k=8+n
  shade(x+ww,y+k,k,hh)
  shade(x+k,y+hh,ww-k,k)  
  camera(-x,n-y) 
   
  for i=0,2 do
   cl= i==1 and 7 or 0
   rectfill(i-2,i-2,ww+2-i,hh+2-i,cl)
  end   
  if #ranking>1 then
   cpr("results:",2,7)
   local py=29-#ranking*3.5
   for pl in all(ranking) do
    cl=sget(7,pl.id) 
    first=false
    print("player "..(pl.id+1),3,py,cl)
    print(pl.prc,ww-#pl.prc-4-6,py,cl)
    py+=7
   end

		 local win=ranking[1]
   local str="player "..(win.id+1) 
   
   local cl=8+t%8
   cpr(str,48,cl)
   cpr("win the game",54,cl)

  else
   local cl=7
   local y=14
   
   for i=0,1 do  
    local sc= i==0 and pl.turn or hiscore 
    cpr(i==0 and (pl.ia and "ia" or "your").. " score" or "high score",y,8)
    local cl=new_hi and 8+t%8 or 7
    
    cpr(sc.." turns",y+8,cl)
    y+=24
   end  
  end
  camera()
  if fd then
   fade(fd*fd)
  end  
 end
 
 local wt=true
 db.upd=function(e)
  if btnp(4) and wt then
   fd=0
   e._wt=8
   wt=false
   sfx(17)
   music(-1) 
   function f() dl(16,init_menu) end
   mv(e,0,128,16,f)
   e.krv=slow_in
  end 
  
  if not wt and not e._wt then
   fd+=1
  end
  
 end
 
 return true
 
end

--

function slow_in(n)
 return n*n
end
function slow_out(n)
 return sqrt(n)
end

function shade(x,y,ww,hh)
 for dx=0,ww do for dy=0,hh do
  pix=pget(x+dx,y+dy)
  pix=dark(pix)
  pset(x+dx,y+dy,pix)
 end end
end


function nxt_player(pass)
 
 if check_end()then 
  return 
 end 
 
 if not pass then
  local n=(pl.pos+1)%#players
  pl=players[1+n]
  pl.turn+=1
 end
 
 
 pl.sleep=false
 chpos(pl) 
 inc_sel(0)
 t=0
 refilling=false
 if pl.ia then
  function f()
   run_ia()
   inc_sel(0)
   loop(play_ia)
  end
  dl(2,f)
 else 
  local e=loop(play)
  e.dr=function(e)
   
  end
 end
 
end

function loop(f)
 local e=mke()
 e.upd=f
 return e
end

function get_choice(pl,n)
 for e in all(pl.choices) do
  if e.ch==n then
   return e
  end
 end  
 return nil
end

function add_choice(cpl,n)
 local e=mke(n)
 e.ch=n
 e.x=64
 e.y=128

 if n<cl_max then
  e.fr=23
  e.cl=n
 elseif n<100 then
  e.cl=7
  e.fr=16+n-cl_max
 else   
  e.fr=1
 end


 add(cpl.choices,e)
 
 if pl==cpl then
  local e=pl.choices[1+sel]
  select(e.ch,e)
  show(e,-4,4) 
 end 
 
 
 
end

function refill(pl,num,f)

 if #pl.pool==0 or num==0 then
  if f then dl(8,f) end
  return
 end
 num-=1
 local n=arand(pl.pool,true)
 add_choice(pl,n)
 chpos(pl)
 
 local function again()
  refill(pl,num,f)
 end
 dl(f and 4 or 0,again)
end

function log(n)
 add(logs,n)
 if #logs>18 then 
  del(logs,logs[1])
 end
end

function gsq(x,y)
 if x<0 or y<0 or x>=xmax or y>=ymax then
  return nil
 end
 return grid[x*ymax+y+1]
end

function rand(n)
 return flr(rnd(n))
end

function _update()
 local lp=1
 if btn(5) and not final then lp=10 end
 
 for i=1,lp do
  t=t+1 
  foreach(ents,upe)
 end
end

function play_ia(ev)
 if t<16 then
  --wait
 elseif t%2==0 then
  if tsel<sel then
   inc_sel(-1)
  elseif tsel>sel then
   inc_sel(1)
  else
   val(ev)
  end
 end
 
end
function val(ev)
  
 if useless then
  sfx(7)
  mch._shk=4
 else
  
  validate()
  kl(ev)
 end

end

function play(ev)
 if refilling then
  return
 end

 if btnp(0) then
  inc_sel(-1)
 elseif btnp(1) then
  inc_sel(1)
 elseif btnp(4) then
  val(ev)
 end 
end



function arand(a,rmv)
 local n=a[rand(#a)+1]
 if rmv then del(a,n) end
 return n
end

function validate()
 t=0
 
 
 -- refill
 if mch.ch==100 then
  sfx(5)
  ar._blu=8
  refilling=true
  mch.sel=nil
  local function f()
   pl.sleep=true
   chpos(pl)
   dl(16,nxt_player)
  end 
  refill(pl,draw_max,f)
  return
 end
 
 -- remove mch
	

 local function leave()
  pl.sleep=true
  chpos(pl)
 end 
 dl(8,leave)
 
 
 
 flh=true

	if jump then
	 sfx(6)
  sel=arand(sln)
  sel.hi=true
  show(cen(sel),-4,4)
		loop(infest)
  ready=false
 else
  ar._blu=8
  sfx(2)
  spend()
  dl(20,apply)
 end
 
 --[[
 if jump then
  local ssq=sln[1+rand(#sln)]
  sln={ssq}
  for sq in all(grid) do
   sq.hi=sq==ssq
  end
  jump=nil
 end
 --]]
 
end

function spend()
 del(pl.choices,mch)
 add(pl.pool,mch.ch)
 kl(mch)
 chpos(pl)
end

function infest(ev)
 

 function go()
  if not is(sel,mch.ch) then
   sfx(7)
   ar._shk=4
   mch._shk=3
   return
  end
  ar._blu=8
  ar.trg=nil
  mv(ar,-6,6,8)
  ar.krv=slow_out
  
  spend()
  sfx(4)
  kl(ev)
  local sq=sel
  sln={sel}
  sel=0
  --show(pl.choices[1])
  
  jump=nil
  local e=dl(16,apply)
  e.dr=function(e)
   local c=(e.life/16)^.5
   local x=sq.x*8+7
   local y=sq.y*8+15
  	local ra=c*32
  	local rb=c*64
  	for px=0,127,4 do for py=0,127,4 do
  	 local dx=px-x
  	 local dy=py-y
  	 local dd=sqrt(dx*dx+dy*dy)
  	 if dd>ra and dd<rb then
  	  spr(4+mid(0,dd/16,3),px-1,py)
  	 end
  	end end
  end  
 end
 
 if pl.ia then
  if t%4==0 then
   if tsq.x< sel.x then move(-1,0)
   elseif tsq.x> sel.x then move(1,0)
   elseif tsq.y< sel.y then move(0,-1)
   elseif tsq.y> sel.y then move(0,1)
   else
    go()
   end
  end
 else  
  if btnp(0) then move(-1,0)
  elseif btnp(1) then move(1,0) 
  elseif btnp(2) then move(0,-1) 
  elseif btnp(3) then move(0,1)
  elseif btnp(5) then
   sel=0
   jump=nil
   flh=nil
   kl(ev)
   nxt_player(true)
  elseif btnp(4) then
   if ready then go() end
  else 
   ready=true 
  end
 end  
end


function cen(sq)
 return {x=sq.x*8+4,y=sq.y*8+12}
end

function move(dx,dy)
 sfx(3)
 local nx=sel.x+dx
 local ny=sel.y+dy
 local nsq=gsq(nx,ny)
  
 if nsq then
  sel.hi=nil
  sel=nsq
  sel.hi=true  
  show(cen(nsq),-4,4)
 end

end

function nei(sq,d)
 local nx=sq.x+di[d*2+1]
 local ny=sq.y+di[d*2+2]
 return gsq(nx,ny)
end

function mke(fr,x,y)
 fr = fr or 0
 x = x or 0
 y = y or 0
 local e={
  x=x,y=y,fr=fr,vis=true,
  ddx=0,ddy=0,
 
 }
 add(ents,e)
 return e
end

function dl(n,f)
 if n<=0 then f() return end
 local e=mke()
 e.life=n
 e.nxt=f
 return e
end

function upe(e)
 if e.upd then e.upd(e) end

 -- counters
 for v,n in pairs(e) do
  if sub(v,1,1)=="_" then
   n-=1
   e[v]= n>0 and n or nil
  end
 end 
 -- tween 
 if e.twc then
  e.twc=min(e.twc+e.tws,1)
  local c= e.krv(e.twc)
  e.x=e.sx+c*(e.trg.x-e.sx)
  e.y=e.sy+c*(e.trg.y-e.sy)
  if e.twc==1 then
   e.twc=nil
   if e.twf then
    local f=e.twf
    e.twf=nil
    f()
   end 
  end
 end
 -- life
 if e.life then
  e.life-=1
  if e.life==0 then
   kl(e)
  end
 end
 
 
end
function kl(e)
 if not e then return end
 del(ents,e)
 if e.nxt then e.nxt() end
end

function chpos(pl)

 function chk(a,b) return a.ch>b.ch end
 sort(pl.choices,chk)

 -- choices
 local x=64-(#pl.choices)*4
 local y=114
 if pl.sleep and #players>1 then
  y=128
 end
 
 for e in all(pl.choices) do
  mvt(e,x,y,4)
  x+=8
 end
end


function mvt(e,x,y,t,f)
 e.twc=0
 e.krv=function(n) return n end
 e.tws=1/t
 e.sx=e.x
 e.sy=e.y
 e.trg={x=x,y=y}
 e.twf=f
end


function mv(e,x,y,t,f)
 mvt(e,e.x+x,e.y+y,t,f)
end

function apply()
 flh=false

 for sq in all(sln) do
  sq.hi=nil
  sq.vir=pl.id
 end
 
 nxt_player()
 
end


function eval(ch)

 
 select(ch)

 -- create move
 local mv={ 
  sel=#moves,
  sco=count_hi()
 }
 add(moves,mv)
 
 -- cancel if draw
 if ch==100 then
  draw=mv
  return mv
 end
  
 -- check best jump
 if jump then
  mv.sco,mv.sq=best_jump(ch)
 end
 
 return mv
 
end

function run_ia()
 moves ={}
 
 -- eval choices
 for e in all(pl.choices) do
  eval(e.ch)
 end
 for ch in all(pl.pool) do
  local mv=eval(ch) 
  mv.pool=true
 end
 
 function chk(a,b) return a.sco < b.sco end
 sort(moves,chk)
 
 local i=1
 local mv=moves[i]
 local bsc=mv.sco
 while mv and mv.pool do
  i+=1
  mv=moves[i]
 end
 
 -- check if draw is better
 local lim=#pl.choices/2
 if not mv or (bsc-mv.sco)>lim or mv.sco<=0 then
  mv=draw
 end
 
 tsel=mv.sel
 tsq=mv.sq

 
end

function best_jump(ch)
 local a={}
 trace_dist()
 for sq in all(grid) do
  if is(sq,ch) then 
   local sco=sq.dist+1
   add(a,{sq=sq,sco=sco}) 
  end
 end
 
 function chk(a,b) return a.sco<b.sco end
 sort(a,chk)
 local bst=a[1]
 return bst.sco,bst.sq
end

function trace_dist()
 local a={}
 for sq in all(grid) do  
  if sq.vir or sq.x==0 or sq.y==0 or sq.x==xmax-1 or sq.y==ymax-1 then
   add(a,sq)
  end
 end
 
 function chk(sq) return true end
	expand(a,chk)
	for sq in all(grid) do
	 sq.dist=sq.tmp
	end

end

function expand(wk,chk)
 local res={}
 for sq in all(grid) do  
  sq.tmp=999
 end
 for sq in all(wk) do  
  sq.tmp=0
 end 
 while #wk>0 do
  local sq=wk[1]
  del(wk,sq)
  for nsq in gneis(sq) do
   if nsq.tmp> sq.tmp+1 and chk(nsq) then
    add(res,nsq)
    add(wk,nsq)
    nsq.tmp=sq.tmp+1
   end
  end  
 end 
 return res 
end


function sort(a,chk)
 for i=1,#a do
  local j = i
  while j > 1 and chk(a[j-1],a[j]) do
   a[j],a[j-1] = a[j-1],a[j]
   j = j - 1
  end
 end
end


function count_hi()
 local n=0
 for sq in all(grid) do
  if sq.hi then n+=1 end
 end
 return n
end

function inc_sel(n)
 sfx(1)
 for e in all(pl.choices) do
  e.sel=nil
 end
 --local prev=pl.choices[1+sel]
 --if prev then prev.sel=nil end
 
 sel=(sel+n)%#pl.choices
 local e=pl.choices[1+sel] 
 show(e,-4,4)
 select(e.ch,e)

end

function select(ch,e)
 mch=e
 
 jump=nil
 useless=nil
 sln={}
 local vir=pl.id 
 local wk={}
 for sq in all(grid) do
  sq.tmp=nil
  sq.hi=nil
  if sq.vir==vir then 
   add(wk,sq) 
  end
 end

 while #wk>0 do
  local sq=wk[1]
  del(wk,sq)
  for nsq in gneis(sq) do
   if not nsq.tmp then
    if is(nsq,ch) then
     nsq.tmp=true
     nsq.hi=true
     add(wk,nsq)
     add(sln,nsq)
    end 
   end
  end
 end

 if #sln>0 then return end
 
 for sq in all(grid) do
  if is(sq,ch) then
   add(sln,sq) 
  end
 end

 if #sln>0 then
  jump=true
 else
  useless= ch!=100 or #pl.pool==0
 end

end

function is(sq,ch)
 return not sq.vir and (ch>=cl_max or sq.cl==ch ) and ( ch<cl_max or sq.tp==ch-cl_max )
end


function gneis(sq)
 local a={}
 for i=0,3 do
  local nsq=gsq(sq.x+di[1+i*2],sq.y+di[2+i*2])
  if nsq then add(a,nsq) end
 end
 return all(a)
end

function dre(e)
 if not e.vis then
  return 
 end
 
 pal()
 if e.cl then
  rpal(e.cl)
 end
 
 local x=e.x+e.ddx
 local y=e.y+e.ddy
 
 
 -- shake
 if e._shk then
  y+=e._shk*((e._shk%2)*2-1)
 end
 
 -- transp
 if e.transp then
  palt(0,false)
  palt(e.transp,true)
 end
 
 --
 if e._blu and t%2==0 then
  pal(0,12)
 end
 
 -- red
 if e._red and t%2<1 then
   apal(8)
 end
 
 if e.fr>0 then
  spr(e.fr,x,y)
 end
 pal()
 palt()
 
 if e.dr then e.dr(e,x,y) end
end

function _draw()
 cls()
 if menu then
  foreach(ents,dre) 
  dr_logs()
  return
 end
 
 
 --map
	map() 
 
 -- grid
 for sq in all(grid) do
  pal()
  local x=4+sq.x*8
  local y=12+sq.y*8

  local flp=t%2==0
   
  local fr=0
  local fl=t%2==0
  if sq.vir then
   fr=32+sq.vir
   --fr=64+(t/2+(sq.x+sq.y)/4)%11
   --fr=99.5+cos(t/20+(sq.x+sq.y)/40)*2
   --rpal(sq.vir)
  else
   fr=sq.tp+16
   rpal(sq.cl)
  end
  if sq.hi and fl and not jump then
   fr=flh and 32+pl.id or -1
  end  
  spr(fr,x,y)
 
 end
 pal()
 
 -- infest
 if jump and flh then
  pal()
  local x=sel.x*8+4
  local y=sel.y*8+12
  local ok=is(sel,mch.ch)
  
  --[[
  local cl = ok and 7 or 8
	 if cl==8 and t%2==0 then cl=0 end
  rect(x-2,y-2,x+8,y+8,cl)  
  --]]
  
  local verb=ok and "infest this " or "search a "
  local cl = ok and  7+(t%2)*3 or 13 
  local str=verb..trg_name(mch.ch)
  if t>16 then
   if ar._shk and t%2==0 then
    cl=8
   end
   print(str,64-#str*2,123,cl)
  end
 end
   
 -- inter
 if not flh then
  draw_choices()
 end
 
 function f()
  str="player "..(pl.id+1)
  print(str,64-#str*2,107,7)
 end
 
 if not db then
  dsh(f)
 end
 -- ents
 foreach(ents,dre)
 
 -- arrow
 dre(ar)

 -- scores
 dr_scores()

 -- logs
	dr_logs()
 
 
end

function dr_scores()
 if db then return end
 
 if #players==1 then
  local str="turn:"..players[1].turn
  print( str,64-#str*2,1)
  return
 end


 local ma=6
 local pls=12
 local space=128-#players*pls-2*ma
 local ec=flr(space/(#players-1))
 local x=ma
 for cpl in all(players) do
  pcl=sget(7,cpl.id)
  prc=get_score(cpl,true)  
		print(prc,x,1,pcl)
		if cpl==pl then
		 palt(0,false)
		 palt(1,true)
		 spr(25,x-7.5+cos(t/40),-1)
		 palt()
		end
		-- t%2==0 or cpl!=pl 

  x+=pls+ec
 end
end

function dr_logs()
 pal()
 cursor(0,0)
 color(8)
 for s in all(logs) do
  print(s)
 end
end

function dsh(f)
 apal(0)
 camera(1,0) f()
 camera(0,1) f()
 camera(-1,0) f()
 camera(0,-1) f()
 
 camera(1,1) f()
 camera(-1,1) f()
 camera(1,-1) f()
 camera(-1,-1) f() 
 
 pal()
 camera() f()
end

function apal(n)
 for i=0,15 do pal(i,n) end
end

function dark(n) 
 local x=4+n%4
 local y=4+flr(n/4)
 return sget(x,y) 
end



function get_score(pl,prc)
 local n=0
 for sq in all(grid) do
  if sq.vir==pl.id then n+=1 end
 end
 pl.score=n
 
	if not prc then return n end
	n=flr(n*100/(xmax*ymax)).."%"
 while #n<3 do n = "0"..n end
 
 pl.prc=n
 
 return n

end


function rpal(n)
 pal(2,sget(0,n))
 pal(8,sget(1,n))
end

function draw_choices()
 if t<8 or refilling or db then
  return 
 end
 
 --
 local ch=pl.choices[sel+1].ch
 local trg=trg_name(ch) 
 local verb=jump and "infect a new " or "spread to "
 local str=trg and verb..trg or "draw "..min(6,#pl.pool).." target(s)"
 print(str,64-#str*2,123,13)

end

function trg_name(ch)
 local trg=colors[ch+1]
 if not trg then trg=animals[ch+1-cl_max] end
 if ch<cl_max then
  trg=trg.." creature"
 end 
 return trg
end
animals={"dog","frog","fish","snake","squirrel","jellyfish","human"}
colors={"red","green","orange","blue","pink","brown","dark"}

