pico-8 cartridge // http://www.pico-8.com
version 32
__lua__
--jonk's poker
--2021 lostcadesoft by bgelais


function deck_init()
	deck={}
	for i=1,52 do
		deck[i]=i
	end
deck=shuffle(deck)
end

function _init()
intro_init()
--	game_init()
end

function card_draw(x,y,v)
palt(0,false)
 rect(x-1,y-1,x+8,y+16,7)
	spr(v,x,y)
	spr(v,x,y+8,1,1,true,true)
palt()
end

function shuffle(a)
local b,c={}
  repeat
   c=flr(rnd(#a))+1
   add(b,a[c]) del(a,a[c])
  until #a==0
  return b
end

function fprint(str,x,y)
	if (time()%1<.5) print("\#0"..str,x,y,7)
	if (time()%1>=.5) print("\#7"..str,x,y,0)
end
-->8
--player and jonk

function player_update()
ppair=false
psuite=false
 for i=1,5 do
 	if value(player[i])==value(deck[1])+1
 	or value(player[i])==value(deck[1])-1
 	then
 		psuite=true
 		ph=i
		end
 end

for i=1,5 do
	if (value(player[i])==value(deck[1])) ph=i ppair=true psuite=false
end

	if youplay then
 	if (btnp(‹) and not psuite and not ppair) ph-=1 pface=0
		if (btnp(‘) and not psuite and not ppair) ph+=1 pface=0
			ph=mid(1,ph,5)
		if btnp(Ž) or btnp(—) then 
			
			player[ph]=deck[1]
			del(deck,deck[1])
			sfx(0)
			jh=1
			faces_update()
			ppair=false
			youplay=false
		end
	end
end


function player_draw()
 for i=1,5 do
 	card_draw(8+i*14,77,15+player[i])
 end
if (youplay) draw_hand(10+ph*14,89,false)
end

function jonk_update()
 jpair=false
 jsuite=false
 for i=1,5 do
 	if value(jonk[i])==value(deck[1])+1
 	or value(jonk[i])==value(deck[1])-1
 	then
 		jsuite=true
 		jh=i
		end
 end

 for i=1,5 do
		if (value(jonk[i])==value(deck[1])) jh=i jpair=true jsuite=false
	end
	
	if not youplay 
	and time()%1==0
	then
		jface=0
		if value(jonk[jh])<value(deck[1])
		or jsuite
		or jpair	then
			jonk[jh]=deck[1]
			del(deck,deck[1])
			sfx(0)
		 faces_update()
		 jpair=false
			youplay=true
		else
	 	jh+=1
	 	if jh>5 then
	 		jh=flr(rnd(5))+1
	 		jonk[jh]=deck[1]
				del(deck,deck[1])
			 sfx(0)
			 faces_update()
			 jpair=false
			 youplay=true
			end
	 end
	end
end


function jonk_draw()
 for i=1,5 do
 	card_draw(8+i*14,36,15+jonk[i])
 end
if (not youplay) draw_hand(10+jh*14,32,true)
end

function faces_update()
	if (js>ps) jface=1 pface=2
	if (js<ps) jface=2 pface=1
	if (js==ps) pface=0 jface=0
end

function draw_hand(x,y,f)
	palt(0,false) palt(4,true)
	spr(2,x,y,1,1,false,f)
	palt()
end

function score(o)
	r=0
		for i=1,#o do
			r+=value(o[i])
		end
	return r
end

function value(o)
	v=o%13
	if (v==0) v=13
	return v
end

function wait(t)
 for i=0,t*60 do flip() end
end
-->8
--game

function game_init()
	deck_init()
	player={}
	jonk={}
	discards={}
	js=0
	ps=0
	jface=0
	pface=0
	ph=3
	jh=3
	youplay=true
	srand()
	for i=1,5 do
		add(player,deck[1])
		del(deck,deck[1])
		add(jonk,deck[1])
		del(deck,deck[1])
	end
	_update60=game_update
	_draw=game_draw
end

function game_update()
		if #deck>0 then
		player_update()
		jonk_update()
		js=score(jonk)
		ps=score(player)
	else
	over_init() end
end

function game_draw()
		cls()
	rectfill(0,32,127,96,3)
	if (#deck>=2) card_draw(102,56,1)
	if (#deck>0 and not move) card_draw(90,56,15+deck[1])
	print(#deck,113,62,7)
	palt(0,false)
	jonk_draw()
	player_draw()
 if jpair and not youplay then
  fprint("pair!",98,34,7)
 elseif jsuite and not youplay then 
  fprint("suite!",98,34,7)
 elseif ppair and youplay then
  fprint("pair!",98,90,7)
 elseif psuite and youplay then
  fprint("suite!",98,90,7)
 end
 
 if (youplay and not ppair and not psuite) print("‹‘ select",8,100,7)
 if (youplay) print("Ž/— draw",8,106,7)
spr(192+jface*4,0,0,4,4)
spr(128+pface*4,96,97,4,4)
print("\^p"..ps,80,108,9)
print("\^p"..js,38,10,9)
print("\^wparfum pume",0,122,9)
print("\^wjonk eeye",56,0,12)
end

function over_init()
	timeout=time()+5
 if ps>js then 
  sfx(1) sfx(5) jface=2 pface=1
  jtalk=""
  ptalk="your perfume\nstinkge!"
  mtalk="\#1     you win!    "	
 elseif ps<js then
  sfx(2) sfx(6) jface=1 pface=2
  jtalk="i win!!!"
  ptalk=""
  mtalk="\#8    game over    "
 elseif ps==js then
  sfx(3)	sfx(5) jface=0 pface=0
  jtalk="flush dude!"
  ptalk=""
  mtalk="\#1  let's replay!  "
	end
	_update60=over_update
	_draw=over_draw
end

function over_update()
	if time()>=timeout then 
		if (ps>=js) game_init()
		if (ps<js) title_init()
	end
end

function over_draw()
	cls()
	rectfill(0,32,127,96,3)
	if (#deck>=2) card_draw(102,56,1)
	if (#deck>0) card_draw(90,56,15+deck[1])
 jonk_draw()
	player_draw()
	palt(0,false)
	spr(192+jface*4,0,0,4,4)
	spr(128+pface*4,96,97,4,4)
 fprint(ptalk,1,106,7)
	fprint(jtalk,60,6,7)
	print("\^p"..ps,80,108,9)
	print("\^p"..js,38,10,9)
	print("\^t\^w"..mtalk,0,59,7)
end
-->8
--title / intro

function title_init()
	timeout=time()+10
	_update60=title_update
	_draw=title_draw
end

function title_update()
 if (time()>=timeout) intro_init()
 if (btnp(—) or btnp(Ž)) sfx(4) game_init()	
end

function title_draw()
	cls()
	spr(196,72,19,4,4)
	spr(80,22,48,11,3)
	?"jONK eEYE'S",22,44,7
	?"2021 lostcadesoft by bgelais",8,120,6
 if (time()%1<.5) print("Ž/— to start",38,100,7)	
end

function intro_init()
	timeout=time()+10
	_update60=intro_update
	_draw=intro_draw
end

function intro_update()
	if (time()>=timeout or btnp()!=0) title_init()
end

function intro_draw()
	cls()
	spr(192,48,4,4,4)
	print([[
 you play against me on a five
 card's open draw score battle 
   on players's hand's sum! 
    (ace to king = 1 to 13)	
]],0,38,7)
 print("\^w\#8mandatory draws",4,64)
 rectfill(0,70,127,96,3)
 card_draw(67,75,1)
 card_draw(56,75,25)
 card_draw(20,75,51)
 card_draw(94,75,37)
 card_draw(116,75,65)
 palt(0,false) palt(4,true)
 spr(2,94,89)
 spr(2,20,89)
 spr(2,116,89)
 palt()
 fprint("pairs",1,98)
 fprint("suites",104,98)
 print([[
  game ends when deck is empty.
    you win, game continues! 
      i win, game is over!  
]],0,108,7)
end
