--generating functions <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
function initialize_game()
	state = 
	{
		update = update_game,
		draw = draw_game
	}
	
	grasstable = {}
	nearbycrunchables = {}
	selector={x=64,	y=64}
	jumpdistance=20

	generatelevel()
	generateplayer()
	generatenearbycrunchables()

	currentselection = 1
	cursormode = "inspect" --cursormode will always be with "inspect" or "select"
	currenttable={}--is referenced in changeselection()
end

function generatelevel()
	--generate grass
	for i=1, 100+flr(rnd(100)) do
		local x = flr(rnd(129))
		local y = flr(rnd(129))
		local direction = flr(0.75*rnd(3))--puts a slant on the grass
		local grass = {}
		grass.x = x
		grass.y = y
		grass.direction = direction
		add(grasstable, grass)
	end
	if (levelscompleted<=25) then
		generatecrunchobjtable(25+levelscompleted)
	else
		generatecrunchobjtable(50)
	end
end

function generatecrunchobjtable(objnumber)
	--generate bark or ice within centered on pixels 10-118 
	--easiest diffictuly should have 7 breakables
	--hardest should feautre... 25?
	crunchobjtable = {}
	local i=1
	repeat
		local x = flr(rnd(109)+10)
		local y = flr(rnd(109)+10)
		
		--generate x and y value for a crunchable
		if(#crunchobjtable>=1) then
			local generationtries = 0
			repeat
				local dir = rnd(1)--only used in the calulation of sin and cosine for x and y values in section below
				
				x = round(crunchobjtable[#crunchobjtable].x+((jumpdistance-1) *sin(dir )))
				y = round(crunchobjtable[#crunchobjtable].y+((jumpdistance-1) *cos(dir )))
				
				generationtries+=1
				if(generationtries>=25) then
					crunchobjtable={}
					x = 64
					y = 64
					i = 1
					generationtries = 0
				end
			until (withinbounds(x) and withinbounds(y) and nearotherobj(x,y,10,crunchobjtable)==false) --and numberofnearbycrunchables(x,y,crunchobjtable)<=2)
		end
		
		local crunchobj={}
		crunchobj.number=i
		crunchobj.x=x
		crunchobj.y=y
		crunchobj.broken=false
		crunchobj.sprite=flr(rnd(4)) --crunchobj.sprite is one of 4 random sprites
		add(crunchobjtable, crunchobj)
		i+=1
	until(i==objnumber)
end

function generateplayer()
	
	player={
			state=0,--standing, facing right
			direction=1,
			currentcrunch=1, --assuming player starts at crunchobjtable[1]
			x=crunchobjtable[1].x,
			y=crunchobjtable[1].y
	}
	crunchobjtable[1].broken=true --assuming player starts at crunchobjtable[1]
end
	
function generatenearbycrunchables()
	nearbycrunchables = {}
	for i in all(crunchobjtable) do
		if( hypot(crunchobjtable[player.currentcrunch].x,crunchobjtable[player.currentcrunch].y,i.x,i.y) <= jumpdistance and i.broken == false and player.currentcrunch != i) then -- 
			add(nearbycrunchables, i)
		end
	end
end

--draw functions <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

function drawlevel()
	if ((levelscompleted)%2==0)then --if forest
		rectfill(0,0,128,128,3)
		for g in all(grasstable) do
			line(g.x, g.y, g.x+g.direction, g.y-2, 11) --draws individual blade of grass
		end
	else --if winter
			rectfill(0,0,128,128,7)
		--for g in all(grasstable) do
		--	line(g.x, g.y, g.x+g.direction, g.y-2, 11) --draws individual blade of grass
		--end
	end
	
end

function drawcrunchobj(crunchable)
	if (crunchable.broken==false) then
		if ((levelscompleted)%2==0)then --if forest
			spr(crunchable.sprite,crunchable.x-4,crunchable.y-4)--the "-4" in crunchable.x-4 and crunchable.y-4 are to adjust the sprite 8*8 grid to center
		else --if winter
			spr(crunchable.sprite+8,crunchable.x-4,crunchable.y-4)--the "-4" in crunchable.x-4 and crunchable.y-4 are to adjust the sprite 8*8 grid to center
		end
	elseif (crunchable.broken==true) then
		if ((levelscompleted)%2==0)then --if forest	
			spr(crunchable.sprite+4,crunchable.x-4,crunchable.y-4)--the "-4" in crunchable.x-4 and crunchable.y-4 are to adjust the sprite 8*8 grid to center
		else --if winter
			spr(crunchable.sprite+12,crunchable.x-4,crunchable.y-4)--the "-4" in crunchable.x-4 and crunchable.y-4 are to adjust the sprite 8*8 grid to center
		end
	end
end

function drawcircle(crunchable)
	if(crunchable.broken==false)then
		circ(crunchable.x,crunchable.y,8,8)
	end
end

function drawselector(x,y)
	local color=
	--top left
	line(x-5,y-5,x-5,y-3,1)
	line(x-5,y-5,x-3,y-5,1)
	--top right
	line(x+5,y-5,x+5,y-3,1)
	line(x+5,y-5,x+3,y-5,1)
	--bottom left
	line(x-5,y+5,x-5,y+3,1)
	line(x-5,y+5,x-3,y+5,1)
	--bottom right
	line(x+5,y+5,x+5,y+3,1)
	line(x+5,y+5,x+3,y+5,1)
end

function drawplayer()
	if ((levelscompleted)%2==0)then --if forest
		if (player.x>=selector.x and player.state==0) then
			spr(16,crunchobjtable[player.currentcrunch].x-8,crunchobjtable[player.currentcrunch].y-14,2,2)
		elseif (player.state==0) then
			spr(18,crunchobjtable[player.currentcrunch].x-8,crunchobjtable[player.currentcrunch].y-14,2,2)
		end
	else
		if (player.x>=selector.x and player.state==0) then
			spr(24,crunchobjtable[player.currentcrunch].x-8,crunchobjtable[player.currentcrunch].y-14,2,2)
		elseif (player.state==0) then
			spr(26,crunchobjtable[player.currentcrunch].x-8,crunchobjtable[player.currentcrunch].y-14,2,2)
		end
	end
end

function drawlinestocrunchables()
	for i in all(crunchobjtable) do
		if(i.broken==false and hypot(crunchobjtable[currentselection].x,crunchobjtable[currentselection].y,i.x,i.y)<=jumpdistance and btn(5) and cursormode == "inspect") then
			line(crunchobjtable[currentselection].x,crunchobjtable[currentselection].y,i.x,i.y,8)
			circ(crunchobjtable[currentselection].x,crunchobjtable[currentselection].y,jumpdistance,8)
		elseif(i.broken==false and btn(5)==false) then		
			for j in all(crunchobjtable) do
				if(j.broken==false and hypot(j.x,j.y,i.x,i.y)<=jumpdistance) then
					if ((levelscompleted)%2==0)then --if forest
						line(j.x,j.y,i.x,i.y,7)
					else
						line(j.x,j.y,i.x,i.y,13)
					end
				end
			end
		end
	end
	for i in all(nearbycrunchables) do
		line(i.x,i.y,player.x,player.y,14)
	end
end

function drawcheckmark(f)
	if(f<=18)then
		for i=1, round(f/3.6) do
			circ(64,64,50+(2*i),11)
		end
	else
		for i=1, 5 do
			circ(64,64,50+(2*i),11)
		end
	end
	
	if(f<=10)then
		for i=0,7 do
			line(42+i,67-i,42+i+(f*2),67-i+(f*2),11)
		end
	elseif(f>10 and f<=20) then
		for i=0,7 do
			line(42+i,67-i,62+i,87-i,11)
			line(63+i,72+i,63+i+round(((f-10)/10)*25),72+i-round(((f-10)/10)*25),11)
		end
	elseif(f>20)then
		for i=0,7 do
			line(42+i,67-i,62+i,87-i,11)
			line(63+i,72+i,63+i+25,72+i-25,11)
		end
	end
	--else
--		for i=0,9 do
--			line(42+i,62-i,58+i,78-i,11)
--			line(58+i,68+i,58+i+25,68+i-25,11)
--		end
--	end
end

function drawxmark(f)
	
	if(f<=18)then
		for i=0,9 do
			line(24+i,33-i,23+i+(4*f),32-i+(4*f),8)			
		end
		for i=1, round(f/3.6) do
			circ(64,64,50+(2*i),8)
		end
	elseif(f>=18)then
		for i=0,9 do
			line(24+i,33-i,23+i+(4*18),32-i+(4*18),8)
		end
		for i=1, 5 do
			circ(64,64,50+(2*i),8)
		end
	
	end
	
end

function antiquatedrawcheckmark(f)
	
	if(f<=15)then
		for i=1,5 do
			line(42+i,62-i,42+i+f,62-i+f,11)
		end
	elseif(f<28)then
		for i=1,5 do
			line(42+i,62-i,58+i,78-i,11)
			line(58+i,68+i,58+i+(2*(f-16)),68+i-(2*(f-16)),11)
		end
	elseif(f>=28)then
		
		for i=1,5 do
			line(42+i,62-i,58+i,78-i,11)
			line(58+i,68+i,58+i+25,68+i-25,11)
		end
		for i=1, 5 do
			circ(64,64,50+(2*i),11)
		end
	
	end
	
end

--utilities <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

function changeselection()
	currenttable=nearbycrunchables
	if( (btnp(1) or btnp(0)) and #nearbycrunchables>1) then
		sfx(4,3,0)
	end
	
	if    (btnp(1) and currentselection<(#currenttable) and uncrunchedcrunchables()>=1) then --replace "#crunchobjtable" with "currenttable" and fill it out
		currentselection += 1 
	elseif(btnp(1) and currentselection>=#currenttable and uncrunchedcrunchables()>=1) then
		currentselection = 1
	elseif(btnp(0)and currentselection<=1 and uncrunchedcrunchables()>=1) then
		currentselection = #currenttable
	elseif(btnp(0) and currentselection<=#currenttable and uncrunchedcrunchables()>=1) then
		currentselection -= 1
	end
	
	--update selector position
	--print(numberofnearbycrunchables(player.x,player.y,jumpdistance,crunchobjtable))
	if(uncrunchedcrunchables()>=1 and numberofnearbycrunchables(player.x,player.y,jumpdistance,crunchobjtable)>0)then
		selector.x = crunchobjtable[nearbycrunchables[currentselection].number].x
		selector.y = crunchobjtable[nearbycrunchables[currentselection].number].y
	end
	
end	

function moveplayer()
	if (btnp(4)) then
		player.currentcrunch=nearbycrunchables[currentselection].number
		player.x=crunchobjtable[player.currentcrunch].x
		player.y=crunchobjtable[player.currentcrunch].y
		
		crunchobjtable[nearbycrunchables[currentselection].number].broken=true
		
		
		sfx(flr(rnd(4)),3,0)
		generatenearbycrunchables()
		
		currentselection = flr(rnd(#nearbycrunchables))+1
		checkforwin()
	end
	
end	

function withinbounds(j)--returns true if input is between 10 and 118
--returns true if input is between 10 and 118
	if(j>=6 and j<=122) then
		return(true)
	else
		return(false)
	end
end

function numberofnearbycrunchables(x,y,distance,t)
--return true if input is far enough away from other instances in table
	local cr = 0 --represents number of nearby crunchables
	for i in all(t) do
		if( hypot(x,y,i.x,i.y) <= distance and i.broken==false) then
			cr += 1
		end
	end
	return cr
end

function nearotherobj(x,y,distance,t)
	for i in all(t) do
		if(hypot(x,y,i.x,i.y)<=distance and i!=#crunchobjtable) then
			return true
		end
	end
	return false
end

function checkforwin()
	if(uncrunchedcrunchables()==0) then
		state.draw=draw_win
		state.update=update_win
		winlossframe=0
	elseif( (numberofnearbycrunchables(player.x,player.y,jumpdistance,crunchobjtable)==0 and uncrunchedcrunchables()>0) ) then
		state.draw=draw_fail
		state.update=update_fail
		winlossframe=0
	end
	for i in all(crunchobjtable) do --ends the game early if there are any lone crunchables that make the game a loss
		if(	numberofnearbycrunchables(i.x,i.y,jumpdistance,crunchobjtable)== 0 and i.broken==false)then
			state.draw=draw_fail
			state.update=update_fail
			winlossframe=0
		end
	end
end

function round(r)
	return flr(r+0.5)
end

function hypot(x1,y1,x2,y2)
	return sqrt( ( x1 - x2 )^2 + ( y1 - y2 )^2 )
end

function uncrunchedcrunchables()
	local brokencrunchables=0
	for i in all(crunchobjtable) do
		if(i.broken==false) then 
			brokencrunchables+=1
		end
	end
	return brokencrunchables
end
