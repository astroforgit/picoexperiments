function update_win()
	cls()
end

function draw_win()
	if(winlossframe==1) then
		music(0,0,7)
	end
	drawlevel()
	foreach(crunchobjtable,drawcrunchobj)
	drawplayer()
	
	palt(0,true)
	palt(8,false)
	spr(96,44,56,5,1)
	palt(0,false)
	palt(8,true)
	if(winlossframe>=30)then
		for i=0,2 do
			for j=0,2 do
				print("press 'z' to continue",23+i,79+j,7)
			end
		end
		print("press 'z' to continue",24,80,1)
		if(btnp(4)) then
			levelscompleted+=1
			cls()
			print("generating next level",24,60,7)	
			initialize_game()
		end
	end
	for i=0,2 do
		for j=0,2 do
			print(1+levelscompleted.." level(s) completed",23+i,66+j,7)
		end
	end
	print(1+levelscompleted.." level(s) completed",24,67,1)
	if(winlossframe<120)then
		winlossframe+=1
	end
end

