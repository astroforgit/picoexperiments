function update_title()
	cls()
	if(btnp(4) and gameframe>=16)then
		music(-1,0,4)
		initialize_game()
	end
	
	if(btnp(5) and gameframe>=16)then
		music(-1,0,4)

		crunchobjtable = {
			{number=1,x=54,y=64,broken=false,sprite=flr(rnd(4))},
			{number=2,x=64,y=54,broken=false,sprite=flr(rnd(4))},
			{number=3,x=74,y=64,broken=false,sprite=flr(rnd(4))},
			{number=4,x=64,y=74,broken=false,sprite=flr(rnd(4))},
			{number=5,x=64,y=94,broken=false,sprite=flr(rnd(4))}
		}
		nearbycrunchables = {}
		selector={x=64,	y=64}
		jumpdistance=20
		generateplayer()
		generatenearbycrunchables()
		currentselection = 1
		gameframe=1
		state = {
			update=update_tutorial,
			draw=draw_tutorial
		}
	end


end

