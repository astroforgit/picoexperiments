end

function update_tutorial()
	cls()
	if(gameframe%10==0 and gameframe>=20 and player.currentcrunch!=5) then
		player.currentcrunch+=1
		player.x=crunchobjtable[player.currentcrunch].x
		player.y=crunchobjtable[player.currentcrunch].y
		crunchobjtable[player.currentcrunch].broken=true
		generatenearbycrunchables()
		
	end
	
	--drawtutorialmessage()
end

function draw_tutorial()
	rectfill(0,0,128,128,3)
	drawlinestocrunchables()
	foreach(crunchobjtable,drawcrunchobj)
	drawplayer()

	--draw checkmark scenario and initialize conditions for drawxmark scenario
	if(gameframe>=70 and gameframe<=100) then
		drawcheckmark(gameframe-70)
		if(gameframe==100)then
			crunchobjtable = {
				{number=1,x=54,y=64,broken=false,sprite=flr(rnd(4))},
				{number=2,x=64,y=54,broken=false,sprite=flr(rnd(4))},
				{number=3,x=74,y=64,broken=false,sprite=flr(rnd(4))},
				{number=4,x=64,y=74,broken=false,sprite=flr(rnd(4))},
				{number=5,x=64,y=94,broken=false,sprite=flr(rnd(4))},
				{number=6,x=74,y=44,broken=false,sprite=flr(rnd(4))}
			}
			nearbycrunchables = {}
			selector={x=64,	y=64}
			jumpdistance=20
			generateplayer()
			generatenearbycrunchables()
			currentselection = 1
		end
	end
	if(gameframe>=150 and gameframe<180) then
		drawxmark(gameframe-150)
		foreach(crunchobjtable,drawcircle)
	end
	
	
	--iterate gameframe
	if(gameframe<200)then
		gameframe+=1
		if(gameframe==200) then
			initialize_game()
		end
	end
end

function update_game()
	cls()
	changeselection()
	moveplayer()
end

