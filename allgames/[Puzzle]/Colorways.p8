pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
t = 0
g_state = 1
offset = 24
grid_size = 8
is_moving = false
leveling_up = false
dead = false
level = 1
match = 3
bonus = 1
score = {b=0,m=0,t=0,s=0}
hi_score = {b=0,m=0,t=0,s=0}
x_pos = {0,0}
y_pos = 0

grid = {}
to_splode = {}
anim_events = {}

function ctext(text, y)
	local l = #text * 4
	print(text, (128 - l) / 2, y, 7)
end

local function tlen(tab)
	c = 0
	for _,_ in pairs(tab) do c = c + 1 end
  return c
end

function set_score(v)
 local _t = flr(v/1000)
 score.t = score.t + _t
 score.s = score.s + v - _t*1000
 if score.s >= 1000 then
  score.t = score.t + 1
  score.s = score.s - 1000
 end
 if score.t >= 1000 then
  score.m = score.m + 1
  score.t = score.t - 1000
 end
 if score.m >= 1000 then
  score.b = score.b + 1
  score.m = score.m - 1000
 end
end

function get_score(_s)
 local _score = _s or score
 local _b,_m,_t,_s = '','','',''
 _s = _score.s
 if _score.t > 0 then
  _t = _score.t .. ','
  _s = sub('000'.. _score.s,-3)
 end
 if _score.m > 0 then
  _m = _score.m .. ','
  _t = sub('000'.. _score.t,-3)
 end
 if _score.b > 0 then
  _b = _score.b .. ','
  _m = sub('000'.. _score.m,-3)
 end
 return _b .. _m .. _t .. _s
end

function get_hi_score()
	if score.b > hi_score.b then
		return true
	elseif score.m > hi_score.m then
		return true
	elseif score.t > hi_score.t then
		return true
	elseif score.s > hi_score.s then
		return true
	end

	return false
end

function gen_piece()
	local p_count = 3 + level
	return flr(1 + rnd(p_count))
end

function level_up()
	local i = t
	while anim_events[i] ~= nil do
		i = i + 1
	end

	leveling_up = true
	sfx(7)

	local e = function()
		local d = t - i

		if d > 50 then
			leveling_up = false
			anim_events[i] = nil
		end
	end

	anim_events[i] = e
end

function init_game()
	y_pos = 0
	is_moving = false
	dead = false
	leveling_up = false
	t = 0
	bonus = 1
	score = {b=0,m=0,t=0,s=0}
	grid = {}
	to_splode = {}
	anim_events = {}

	local piece_found = false

	while not piece_found do
		for x=1,grid_size do
			for y=1,grid_size do
				if rnd(10) > 9 then
					grid[x..y] = gen_piece()
					piece_found = true
				end
			end
		end
	end
end

function load_state(n)
	g_state = n

	if g_state == 3 then
		init_game()
	elseif g_state == 4 then
		t = 0
		sfx(-1)
	elseif g_state == 5 then
		level = 1
		grid_size = 8
		x_pos = {0,0}
		music(6)
	end
end

function draw_intro()
 spr(12, 96 / 2, 48, 4,4)
 print('threesidedpolygon', 30, 83, 1)
 print('threesidedpolygon', 30, 82, 7)
end

function draw_title()
	local o = (t / 2) % 16
	camera(0, 132)
	map(0, 0, 0, 0, 132, 32)
	camera()
	for i=0,8 do
		if i == 8 then
			sspr(0, 48, 11, 16, 8 + 12 * i, 48 + (cos((o - i) / 16) * 2))
		else
			sspr(12 * i, 32, 11, 16, 8 + 12 * i, 48 + (cos((o - i) / 16) * 2))
		end
	end
  ctext('press x to start', 80)
end

function draw_menu()
	local c1 = 5
	local c2 = 5
	if y_pos == 0 then c1 = 7 else c2 = 7 end
	camera(0, 132)
	map(0, 0, 0, 0, 132, 32)
	camera()
	ctext('choose your difficulty', 8)
	ctext('grid size', 32)
	ctext('8  6  4', 40)
	rect(48 + (x_pos[1] * 12), 38, 48 + 6 + (x_pos[1] * 12), 38 + 8, c1)
	ctext('level', 56)
	ctext('1  2  3  4  5', 64)
	rect(36 + (x_pos[2] * 12), 62, 36 + 6 + (x_pos[2] * 12), 62 + 8, c2)
	ctext("high score", 90)
	ctext(get_score(hi_score), 98)
	ctext('press x when ready', 120)
end

function draw_game()
	local lvl_info_offset = offset + 8
	local _d = (8 * grid_size) + 8
	local c = 7
	local o = {7,9,10,11,12}

	camera()
	map(0, 0, 0, 0, 128, 32)
	rectfill(offset + 8 - 1,offset + 8 - 1,offset + _d, offset + _d, 0)
	print(get_score(), offset + 9, offset, 0)
	print(get_score(), offset + 8, offset - 1, 7)

	print('level', 9, lvl_info_offset + 1, 0)
	print('level', 8, lvl_info_offset, 7)

	print(level, 17, lvl_info_offset + 8 + 1, 0)
	print(level, 16, lvl_info_offset + 8, 7)

	print('bonus', 9, lvl_info_offset + (8 * 3) + 1, 0)
	print('bonus', 8, lvl_info_offset + (8 * 3), 7)

	print(bonus, 19 - ((#tostr(bonus) * 4) / 2), lvl_info_offset + (8 * 4) + 1, 0)
	print(bonus, 18 - ((#tostr(bonus) * 4) / 2) , lvl_info_offset + (8 * 4) + 1, 7)

	for x=1,grid_size do
		spr(48, offset + x*8, offset + 72)
		for y=1,grid_size do
			spr(48, offset + x*8, offset + y*8)

			if grid[x..y] ~= nil then
				local jx = 0
				local jy = 0
				local die = 0
				if dead then
					jx = -1 + rnd(2)
					jy = -1 + rnd(2)
					die = 16
				end
				spr(grid[x..y] + die, offset + x*8 + jx, offset + y*8 + jy)
			end
		end
	end

	if leveling_up then
		c = o[1 + flr(rnd(5))]
	end
	rect(offset + 8 - 1,offset + 8 - 1,offset + _d, offset + _d, c)
end

function draw_gameover()
	ctext("game over", 64)
	ctext(get_score(), 82)
	if get_hi_score() then
		ctext('new high score!', 90)
	end
end

function anim_move(fn)
	is_moving = true
	i = t

	sfx(1)

	local e = function()
		moved = fn()

		if not moved then
			check_board(fn)
			anim_events[i] = nil
		end
	end

	anim_events[i] = e
end

function move_right()
	local moved = false
	for x=grid_size,1,-1 do
		for y=grid_size,1,-1 do
			if grid[x..y] then
				local new_x = x + 1
				local p = grid[x..y]

				if new_x <= grid_size and grid[new_x .. y] == nil then
					moved = true
					grid[x..y] = nil
					grid[new_x..y] = p
				end

			end
		end
	end
	return moved
end

function move_left()
	local moved = false
	for x=1,grid_size do
		for y=1,grid_size do
			if grid[x..y] then
				local new_x = x - 1
				local p = grid[x..y]

				if new_x > 0 and grid[new_x .. y] == nil then
					moved = true
					grid[x..y] = nil
					grid[new_x..y] = p
				end
			end
		end
	end
	return moved
end

function move_up()
	local moved = false
	for x=1,grid_size do
		for y=1,grid_size do
			if grid[x..y] then
				local new_y = y - 1
				local p = grid[x..y]

				if new_y > 0 and grid[x .. new_y] == nil then
					moved = true
					grid[x..y] = nil
					grid[x..new_y] = p
				end
			end
		end
	end
	return moved
end

function move_down()
	local moved = false
	for x=grid_size,1,-1 do
		for y=grid_size,1,-1 do
			if grid[x..y] then
				local new_y = y + 1
				local p = grid[x..y]

				if new_y <= grid_size and grid[x .. new_y] == nil then
					moved = true
					grid[x..y] = nil
					grid[x..new_y] = p
				end
			end
		end
	end
	return moved
end

function die()
	music(-1)
	sfx(12)
	dead = true
	local i = 0
	local t = 'dead'
	local e = function()
		i = i + 1

		if i > 63 then
			anim_events['dead'] = nil
			load_state(4)
		end
	end

	anim_events['dead'] = e
end

function check_pieces(x, y, all_checks)
  local c = grid[x..y]
	local matches = {}
	local hits = { [x..y] = c }

	while tlen(hits) > 0 do
		for coord,_c in pairs(hits) do
			all_checks[coord] = true
			if c == _c and matches[coord] == nil then
				matches[coord] = true

				local x = tonum(sub(coord, 1,1))
				local y = tonum(sub(coord, 2,2))

				hits[x + 1 .. y] = grid[x + 1 .. y]
				hits[x - 1 .. y] = grid[x - 1 .. y]
				hits[x .. y + 1] = grid[x .. y + 1]
				hits[x .. y - 1] = grid[x .. y - 1]
			end

			hits[coord] = nil
		end
	end
	return matches
end

function check_board(fn)
	local add_bonus = false
	local pts = 0
	all_checks = {}
	for x=1,grid_size do
		for y=1,grid_size do
			if grid[x..y] ~= nil then
				local matches = check_pieces(x, y, all_checks)

				if tlen(matches) >= match then
					add_bonus = true

					local _p = flr(tlen(matches) * (7 + tlen(matches)) * bonus) * (1 + x_pos[1] * 10) * (1 + x_pos[2])
					set_score(_p)
					pts = pts + _p

					for pos,c in pairs(matches) do
						to_splode[pos] = grid[pos]
						grid[pos] = nil
					end
				end
			end
		end
	end

	if add_bonus then
		bonus = bonus + 0.5
	else
		bonus = 1
	end

	if tlen(to_splode) > 0 then
		splode_board(pts)
		sfx(2)
	end

	update_board(fn)
end

function splode_board(pts)
	local duration = 32
	local _d = 0
	local i = t
	local _splodes = to_splode
	local splode = function()
    _d = _d + 1
    if (_d < duration) then
      for coord,c in pairs(_splodes) do
				local x = tonum(sub(coord, 1,1))
				local y = tonum(sub(coord, 2,2))
				local _y = (offset + y*8) - ((-45 * 0.005) * (_d*_d) + 2.5*_d + 2)
        local _x = offset + x*8
				rectfill(_x, _y, _x + 7, _y + 7, 0)
        spr(c, _x, _y)
      end

			if (_d < duration / 2) then
				local pto = #tostr(get_score()) * 4 + 8
				print('+' .. pts, offset + pto + 1, offset + 1  - _d, 0)
				print('+' .. pts, offset + pto, offset - _d, 7)
			end
      return
    end
    anim_events[i] = nil
  end

	to_splode = {}
	anim_events[i] = splode
end

function update_board(fn)
	is_moving = false
	found_piece = false

	local count = flr(1 + rnd(2))

	while not found_piece do
		for v=1,count do
			local pos = ''
			local spot = ceil(rnd(grid_size))
			if fn == move_right then
				pos = 1 .. spot
			elseif fn == move_left then
				pos = grid_size .. spot
			elseif fn == move_up then
				pos = spot .. grid_size
			elseif fn == move_down then
				pos = spot .. 1
			end

			if grid[pos] == nil then
				grid[pos] = gen_piece()
				found_piece = true
			end
		end
	end

	if tlen(grid) == grid_size * grid_size then die() end

	if score.t > 29 then
		if level < 6 then level_up() end
		level = 6
	elseif score.t > 19 then
		if level < 5 then level_up() end
		level = 5
	elseif score.t > 9 then
		if level < 4 then level_up() end
		level = 4
	elseif score.t > 4 then
		if level < 3 then level_up() end
		level = 3
	elseif score.t > 1 then
		if level < 2 then level_up() end
		level = 2
	end
end

function refresh_events()
  for _,e in pairs(anim_events) do e() end
end

function _init()
end

function _update()
	t = t + 1

	if g_state == 1 then
		if btnp(5) then
			load_state(2)
		end

		if t == 10 and g_state == 1 then
	    sfx(0)
	  end

	  if t == 100 and g_state == 1 then
	    load_state(2)
	  end
	elseif g_state == 2 then
		if btnp(5) then
			load_state(5)
		end
	elseif g_state == 3 then
		if not is_moving and not dead then
			if btnp(1) then
				anim_move(move_right)
			elseif btnp(3) then
				anim_move(move_down)
			elseif btnp(0) then
				anim_move(move_left)
			elseif btnp(2) then
				anim_move(move_up)
			end
		end

		if dead then
			if t % 32 == 0 then
				sfx(12)
			end
		end
	elseif g_state == 4 then
		if btnp(5) then
			load_state(2)
			if get_hi_score() then
				hi_score = score
			end
		end

		if t == 200 then
			load_state(2)
			if get_hi_score() then
				hi_score = score
			end
		end
	elseif g_state == 5 then
		if btnp(1) then
			sfx(1)
			if y_pos == 0 then
				grid_size = grid_size - 2
				if grid_size < 4 then grid_size = 8 end
				x_pos[1] = (x_pos[1] + 1) % 3
			else
				level = level + 1
				if level > 5 then level = 1 end
				x_pos[2] = (x_pos[2] + 1) % 5
			end
		elseif btnp(3) then
			sfx(1)
			y_pos = (y_pos + 1) % 2
		elseif btnp(0) then
			sfx(1)
			if y_pos == 0 then
				grid_size = grid_size + 2
				if grid_size > 8 then grid_size = 4 end
				x_pos[1] = x_pos[1] - 1
				if x_pos[1] < 0 then x_pos[1] = 2 end
			else
				level = level - 1
				if level < 0 then level = 5 end
				x_pos[2] = x_pos[2] - 1
				if x_pos[2] < 0 then x_pos[2] = 4 end
			end
		elseif btnp(2) then
			sfx(1)
			y_pos = (y_pos - 1)
			if y_pos < 0 then y_pos = 1 end
		end

		if btnp(5) then
			load_state(3)
			music(0)
		end
	end
end

function _draw()
	local states = {
    draw_intro, -- 1
    draw_title, -- 2
    draw_game, -- 3
    draw_gameover, -- 4
		draw_menu, -- 5
  }
	cls()
	states[g_state]()
	refresh_events()
end
