-->8
--gfx funcs

sc = 3 --2 or 3

function tile_draw(t,x,y)
	sspr((t+1)*8,0,8,8,x,y,8*sc,8*sc)
	return true
end

function pointer_draw(t,x,y)
	sspr((t+1)*8,8,8,8,x,y,8*sc,8*sc)
	return true
end

function board_draw(b,px,py,x,y)
	i = 0
	j = 0
	for t in all(b) do
		tx = x + i*8*sc
		ty = y + j*8*sc
	 tile_draw(t,tx,ty)
		if i == 4 then
			i = 0
			j += 1
		else
			i += 1
		end
	end
	idx = flipidx(px,py)
	for i in all(idx) do
		t=b[px+(py-1)*5+i]
		hx=x+((px-1+i)%5)*8*sc
		hy=y+(py-1+(i/abs(i))*flr(abs(i/5)))*8*sc
		pointer_draw(t,hx,hy)
		--pointer_draw(t,x+(px-1)*8*sc,y+(py-1)*8*sc)
	end
end

function intro_draw()
	rectfill(0,0,127,127, 0x23)
	rectfill(16,16,111,111, 0x22)
	color(9)
	print("> tile flip",20,20)
	print("> a pico-8 puzzle game",20,28)
	print("> by “snail god“",20,36)
	print("> select with ”ƒ‹‘",20,52)
	print("> flip with      Ž",20,60)
	print("> get all tiles alike \n  to win",20,76)
	print("> then Ž for next lvl",20,90)
	print("Ž to begin",42,103) 
end

function win_draw(x,y)	
	--bg
	rectfill(x+8*sc,y+8*sc,x+32*sc,x+32*sc, 0x22)
	--win text
	sspr(32,8,24,8,x+8*sc,y+16*sc,24*sc,8*sc)
	stars_draw()
end

function stars_draw()
	--defined in _init()
	--stars = {0,6,11,17, 0,6,11,17} --spacing
	--twinkles={0,0,0,0, 0,0,0,0}
	--times = {0,0,0,0, 0,0,0,0}
	for i=1,8 do
		twinkles[i], times[i] = twinkle(twinkles[i],times[i])
	end
	--stars (above)
	--sspr(32,0,24,8,x+8*sc,y+8*sc,24*sc,8*sc,false,twu)
	--stars (below)
	--sspr(32,16,24,8,x+8*sc,y+24*sc,24*sc,8*sc,false,twd)
	i=0
	for j in all(stars) do
		sx=x+sc*(8+j)
		if i < 4 then
			sy=y+sc*(8+2*(i%2))
		else
			sy=y+sc*(24+2*(i%2))
		end
		tw = twinkles[i+1]
		sspr(24,8,8,6,sx,sy,8*sc,6*sc,false,tw)
 	i+=1
 end
end

function twinkle(b,t)
	if t != flr(time()) then
		if time()%1==0 then
			if rnd(100)<10 then
				sfx(2)
				return not b,flr(time())
			end
		end
	end
	return b,t
end

function title_draw(x,y)	
	--bg
	rectfill(x+8*sc,y+8*sc,x+32*sc,x+32*sc, 0x22)
	--win text
	sspr(64,8,24,8,x+8*sc,y+16*sc,24*sc,8*sc)
	stars_draw()
	extcmd("label")
end
-->8
--logic funcs

function genboard()
	b={}
	fill=flr(rnd(2))
	for i=1, (5*5) do
		--fill 5x5 w/ 1 or 0's
		--add(b,flr(rnd(2)))
		add(b,fill) --for win debug
	end
	return b
end

function flipidx(x,y)
	idx = {0}
 if x!=5 then
 	add(idx,1)
 end
 if x!=1 then
 	add(idx,-1)
 end
 if y!=5 then
 	add(idx,5)
 end
 if y!=1 then
 	add(idx,-5)
 end
 return idx
end

function tflip(b,x,y)
	--generate index offsets to flip
 to_flip = flipidx(x,y)
 --flip each tile
 for di in all(to_flip) do
 	i = x+(y-1)*5 + di
 	if b[i] then
 		b[i] = abs(b[i]-1)
 	end
	end
	return b
end

function shuffle_board(b,itr)
	for i=1,itr do
		x=ceil(rnd(5))
		y=ceil(rnd(5))
		b=tflip(b,x,y)
	end
	return b
end

function check_win(b)
	bwin = true
	for t in all(b) do
		bwin = bwin and (b[1]==t)
	end
 return bwin
end
-->8
--init
difficulty = 0
music(4)
play=false
bsplash=true
function _init()
	--initiallize board:
	board = genboard()
	board = shuffle_board(board,difficulty)
	bwin = check_win(board)
	--initalize pointer:
	pointer = {3,3}
	--for gfx
	stars = {0,6,11,17, 0,6,11,17} --spacing
	twinkles={0,0,0,0, 0,0,0,0}
	times =  {0,0,0,0, 0,0,0,0}
end

-->8
--draw
function _draw()
	cls()
	fillp(0b1010010110100101)
	rectfill(0,0,127,127, 0x29)
	if bsplash then
		intro_draw()
	else
 	bpos = (128-40*sc)/2
 	board_draw(board,pointer[1],pointer[2],bpos,bpos)
 	--for creating cart cover:
 	--title_draw(bpos,bpos)
 	if bwin then
 		win_draw(bpos,bpos)
 	end
	end
end


-->8
--update
function _update()
	--button input:
	--on splash screen:
	if bsplash then
		tt=time()
		if btnp(4) then
 		music(-1)
 		t=time()+1
 		play=true
 		sfx(10)
 	end
 	if (play and tt>t) then
 		bsplash=false
 		music(0)
 	end
	end
	--left:
	if btnp(0) then
		if pointer[1] != 1 then
			pointer[1] -= 1
		end
	--right:
	elseif btnp(1) then
		if pointer[1] != 5 then
			pointer[1] += 1
		end
	end
	--up
	if btnp(2) then
		if pointer[2] != 1 then
			pointer[2] -= 1
		end
	--down
	elseif btnp(3) then
		if pointer[2] != 5 then
			pointer[2] += 1
		end
	end
	--Ž (flip)
	if btnp(4) then
		if bwin then
			difficulty += 1
			_init()
		else
	 	board = tflip(board,pointer[1],pointer[2])
			--check for win
			bwin = check_win(board)
			if bwin then
				sfx(1)
			else
				sfx(0)
			end
		end
	end
end
