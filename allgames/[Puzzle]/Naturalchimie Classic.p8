cls()
dbg = 0
bw = 7
bh = 9
v = 8
mv = 4
--t = 10
w = 12
pos = 2
rot = 0
cur = {}
next = {}
obs = {}
pa = false
ta = 0
--bt = 0
bl = 8
com=0
lu = 0
avt = 0
sc = 0
stars={}
scs = {0.01,0.03,0.09,0.27,0.81,2.43,7.29,21.87,65.61,196.83,590.49,1771.47,5314.41}
lost=-8
f=0

board = {}
for i = 0, bw-1 do
 for j = 0, bh-1 do
  board[i*bh+j] = {}
  board[i*bh+j].v = 0
 end
end

function _init()
	cur = piece()
	next = nex()
	local r = rnd()
	srand(11)
	for i=1,25 do
		local sx = rnd()*82 + 37
		local sy = rnd()*86
		s={x=sx, y=sy}
		add(stars, s)
	end
	srand(r)
end
	

function make(x,y,v)
	o = {}
	o.x = x
	o.y = y
	o.v = v
	o.tx = x
	o.ty = y
	o.e = accs
	o.d = false
	o.t = 0
	o.ft = die
	o.s = false
	return o
end

function draw_cur()
	rect(pos*w, t, pos*w+w, t+w, cur[1])
	if rot == 0 then
		rect(pos*w+w, t, pos*w+w*2, t+w, cur[2])
	end
	if rot == 1 then
		rect(pos*w, t-w, pos*w+w, t, cur[2])
	end
	if rot == 2 then
		rect(pos*w-w, t, pos*w, t+w, cur[2])
	end
	if rot == 3 then
		rect(pos*w, t+w, pos*w+w, t+w+w, cur[2])
	end	
end

function draw_board()
	for i = 0, bw-1 do
 	for j = 0, bh-1 do
 		if board[i*bh+j].v != 0 then
 			rectfill(i*w, 128-j*w, i*w+w, 128-j*w-w,board[i*bh+j])
 		end
 		print(i*bh+j, -2+i*w+w/2, -2+128-j*w-w/2, 8)
 	end
	end
end

function draw_av()
	for k=0,700 do
	--a=rnd(1)
	local x = flr(rnd(27))
	local y = flr(rnd(27))
	--r=rnd(14)
	local c=(atan2(x-13,y-13)+avt)%1 *6 + 8	
	--pset(r*cos(a)+17,r*sin(a)+17,c)
	
	--x = flr(rnd(27))
	--y = flr(rnd(27))
	--c=(2*(x/60+y/30+avt))%7+8
	pset(x+4,y+4,c)
	end
	avt+=(com^1.8)*0.01+rnd(0.01)-0.02
end

function draw_obj(o)
	if o.t > 0 then
		if o.t > 0.25 then
			if o.t%0.2 > 0.1 then
				wh()
			end
			sspr(((o.v-1)%6)*w+36,flr((o.v-1)/6)*w+8,w,w,36+o.x*w,o.y*w)
			--spr((2*o.v-2)*(flr((o.v-1)/8)+1),o.x*w,o.y*w,2,2)
			pal()
			palt(15, true)
 		palt(0, false)
		else
			if o.ft == up then
				sspr(((o.v)%6)*w+36,flr((o.v)/6)*w+8,w,w,36+o.x*w,o.y*w)
				--spr((2*o.v)*(flr((o.v)/8)+1),o.x*w,o.y*w,2,2)
			end
		end
		o.t -= 0.11
		if o.t <= 0 then
			o.ft(o)
		end
	else
		sspr(((o.v-1)%6)*w+36,flr((o.v-1)/6)*w+8,w,w,36+o.x*w,o.y*w)
		--spr((2*o.v-2)*(flr((o.v-1)/8)+1),o.x*w,o.y*w,2,2)
		--sspr(((o.v-1)%8)*16,flr((o.v-1)/8)*16,16,16,o.x*w,o.y*w)
	end
	if o.x==o.tx and o.y==o.ty then
		if not o.s then
			o.s=true
			if (o.d) sfx(2)
		end
	else
		o.s=false
		o.x += o.e(o.tx-o.x)
		o.y += o.e(o.ty-o.y)
	end
end

function draw_lost()
	memset(0x6000, 0, 0x2000)
	print("you lost!", 20, 20, 8)
	local s = "0000000"
	s = s..flr(sc)..flr(sc*100 % 100)
	print("score of "..sub(s,-7), 30, 30, 8)
	print("x to restart", 40, 40, 8)
	if (btn(4) or btn(5)) run()
end

function _draw()
	--cls()
	if(lost>-1) then
		if (lost>6) then
			pal()
			draw_lost()
			return
		end
		local drk={[0]=0,0,1,1,2,1,5,6,2,4,9,3,1,1,8,10}
	 for c=0,15 do
 	 local cc=c
 	 for i=0,lost do
 	  cc=drk[cc]
 	 end
 	 pal(c,cc,1)
	 end	 
	 if(f%12==0) lost+=1
	end
	palt(15, true)
 palt(0, false)
 draw_av()
	--draw_board()
	--draw_cur()
	sspr(0,0,128,128,0,0)
	--memcpy(0x6000, 0x0000, 0x2000)
	--rectfill(8,36,91,119,1)
	rectfill(36,8,107,31,1)
	--for k=1,1000 do
	--	x,y = rnd(83),rnd(83)
	--	if b(flr(x/12),flr(y/12)).v == 0 then
	--		circ(x+8,y+36,1,pget(x+8,y+36))
	--	end
	--end
	--[[sspr(0,0,8,128,0,0)
	sspr(8,0,120,36,8,0)
	sspr(92,36,36,92,92,36)
	sspr(8,120,84,8,8,120)]]
	for o in all(obs) do
		draw_obj(o)
	end
	sspr(4,36,27,34,4,36)
	--rectfill(0,0,31,69,2)
	sspr(4,86,27,27,4,86)
	for s in all(stars) do
		if pget(s.x, s.y) == 1 and rnd()<0.99 then
			pset(s.x, s.y, 7)
		end
	end
	--rectfill(4,86,31,128,2)
	--line(0, 3*w, 128, 3*w)
	--line(bl+bw*w,0,bl+bw*w,128)
	--line(0, bh*w+w, 128, bh*w+w)
	--line(bl-1,0,bl-1,128)
	--print(stat(1), 0, 120, 15)
	--print(com, 0, 110, 15)
	--print(topclear(pos))
	local s = "0000000"
	s = s..flr(sc)..flr(sc*100 % 100)
	print(sub(s,-7),5,51,15)
	--draw_board()
	--print(flr(100*(sc%1)),25,50,15)
	--test = {{1, 2}}
	--printh(test)
	--print(hast({test}, {1, 2}), 0, 120)
end

function topclear(row)
	n = bh-2
	while (n >= 0 and board[row*bh+n].v == 0) do
		n -= 1
	end
	return max(0, n+1)
end

function drop()
	cur[1].x = cur[1].tx
	cur[2].x = cur[2].tx
	cur[1].e = lin
	cur[2].e = lin
	if rot == 0 then
		local y1 = topclear(pos)
		board[pos*bh+y1] = cur[1]
		cur[1].ty = bh-y1
		y1 = topclear(pos+1)
		board[(pos+1)*bh+y1] = cur[2]
		cur[2].ty = bh-y1
	end
	if rot == 1 then
		local y1 = topclear(pos)
		board[pos*bh+y1] = cur[1]
		cur[1].ty = bh-y1
		y1 = topclear(pos)
		board[pos*bh+y1] = cur[2]
		cur[2].ty = bh-y1
	end
	if rot == 2 then
		local y1 = topclear(pos+1)
	 board[(pos+1)*bh+y1] = cur[1]
		cur[1].ty = bh-y1
		y1 = topclear(pos)
		board[pos*bh+y1] = cur[2]
		cur[2].ty = bh-y1
	end
	if rot == 3 then
		local y1 = topclear(pos)
		board[pos*bh+y1] = cur[2]
		cur[2].ty = bh-y1
		y1 = topclear(pos)
		board[pos*bh+y1] = cur[1]
		cur[1].ty = bh-y1
	end
	cur[1].d = true
	cur[2].d = true
end

function area(p)
	if board[p].v == 0 then
		return {p}
	end
	if board[p].t > 0 then
		return {p}
	end
	if board[p].v == 12 then
		return {p}
	end
	local v = board[p].v
	final = {}
	check = {p}
	--printh("began checking "..p)
	i = 1
	while i <= #check do
		cp = check[i]
		x = flr(cp/bh)
		y = cp%bh
		--printh("x "..x)
		--printh("y "..y)
		if x > 0 then
			if board[cp-bh].v == v and board[cp-bh].t == 0 then
				cadd(check, cp-bh)
			end
		end		
		if x < bw-1 then
			if board[cp+bh].v == v and board[cp+bh].t == 0 then
				cadd(check, cp+bh)
			end
		end		
		if y > 0 then
			if board[cp-1].v == v and board[cp-1].t == 0then
				cadd(check, cp-1)
			end
		end		
		if y < bh-1 then
			if board[cp+1].v == v and board[cp+1].t == 0 then
				cadd(check, cp+1)
			end
		end		
		add(final, check[i])
		--printh("cur len "..#check)
		--printh("cur i "..i+1)
		i += 1
	end
	--printh("ended checking "..p)
	return final
end

function fixcur()
	if rot == 0 then
		if (pos>=bw-1) pos -= 1
		cur[2].tx = pos+1
		cur[2].ty = 1
		cur[1].tx=pos
		cur[1].ty=1
	elseif rot == 1 then
		cur[2].tx=pos
		cur[2].ty=0.5
		cur[1].tx=pos
		cur[1].ty=1.5
	elseif rot == 2 then
		if (pos>=bw-1) pos -= 1
		cur[2].tx=pos
		cur[2].ty=1
		cur[1].tx=pos+1
		cur[1].ty=1
	elseif rot == 3 then
		cur[2].tx=pos
		cur[2].ty=1.5
		cur[1].ty=0.5
		cur[1].tx=pos
	end
end

