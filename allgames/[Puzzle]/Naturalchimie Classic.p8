	for i = 0, bw-1 do
		for j = 0, bh-1 do
			for o in all(obs) do
				if o.d and o.tx==i and bh-o.ty==j then
				 bs(i,j,o)
				end
			end
		end
	end
end]]

function cl_areas()
	local c = false
	--while c do
	--	c = false
 for i = 0, bw-1 do
		for j = 0, bh-1 do
			local a = area(i*bh+j)
			if #a > 2 then
				c = true
				local l = lw(a)
				printh("success "..i*bh+j)
				printh("len "..#a)
				v = b(i,j).v
				for p in all(a) do
					if p != l then
						board[p].t = 1
						sfx(5+com)
 					--del(obs, board[p])
 					--board[p] = {}
						--board[p].v = 0+
					else
						board[p].t = 1
						board[p].ft = up
					end
				end
				--board[lw(a)].v = 1
				--c = true
			end
		end
	end
	--if (not c) com=0
	--up_board()
	printh(c)
	if (c) com+=1 lu = 0
	fall()
		--c = c or fall()
	--end
	return c
end

function fall()
	local w = false
	for i = 0, bw-1 do
		for j = 0, bh-2 do
			if b(i,j).v==0 and b(i,j+1).v!=0 and b(i,j+1).t == 0 then
				w = true
				for n=j+1,bh-1 do
					--bs(i,n,b(i,n+1))
					--bs(i,n+1,em())
					local p = b(i,n)
					if p.v != 0 and p.t == 0 then
					 p.ty += 1
					 --up_board()
					 bs(i,n,em())
					 bs(i,n-1,p)
					else
						break
					end
				end
			end
 	end
	end
	if (w) fall()
	--up_board()
	return w
end

function check_loss()
	for i=0,bw-1 do
		for j=7,8 do
			if (b(i,j).v != 0) return true
		end
	end
	return false
end

function _update()
	lu+=1
	f+=1
	if(lost>-1) return
	if(lu>15 and com>0) com-=1 lu-=15
	if cur[1].tx < 0 then
		if cur[1].y < 4.1 then
			fixcur()
			cur[1].x=cur[1].tx
			cur[1].y=cur[1].ty-4
			cur[2].x=cur[2].tx
			cur[2].y=cur[2].ty-4
			next = nex()
		else goto che end
	elseif cur[1].y > 0 then
		cur[1].e = acc
		cur[2].e = acc
	end
	if (btnp(0)) then
		if (pos!=0) sfx(1)
		pos = max(0, pos-1)
	end
	if (btnp(1)) then
		if (pos<bw-2 or (pos==bw-2 and rot%2==1)) sfx(1)
		pos = min(bw-1, pos+1)
	end
	if (btnp(2)) then
		sfx(0)
		rot += 1
		rot %= 4
	end
	if (btnp(3)) then
		sfx(0)
		rot += 3
		rot %= 4
	end
	fixcur()
	::che::
	sc=0
	a = true
	for o in all(obs) do
		if o.d then
			sc += scs[o.v]
			a = a and (o.tx==o.x and o.ty==o.y and o.t==0)
		end
	end
	if a then
		if ta < 1 then
			if not fall() then
				--up_board()
				if not cl_areas() then
					if (check_loss() and lost<=-1) then
						lost+=1
						if (lost==-7) sfx(4)
						return
					end
					--com = 0
					--avt=1
				end
				
			else return end
			ta += 1
		end
	else
		ta = 0
		return
	end
	if cur[1].tx < 0 then
		return
	end	
	if (btnp(4) or btnp(5)) then
		sfx(3)
	 drop()
	 --com = 0
	 --avt=1
	 cur = next --piece()
	 --next = nex()
	 cur[1].ty = 4
	 cur[2].ty = 4
	 --add(cur, make(1, 1, flr(rnd(mv-1)+1)))
		--add(cur, make(1, 1, flr(rnd(mv-1)+1)))
		--add(obs, cur[1])
		--add(obs, cur[2])
		--[[fixcur()
		cur[1].x=cur[1].tx
		cur[1].y=cur[1].ty-8
		cur[2].x=cur[2].tx
		cur[2].y=cur[2].ty-8]]
		printh("dropped")
	end
end

function piece()
	c = {}
	add(c,make(1, 1, flr(rnd(mv-1)+1)))
	add(c,make(1, 1, flr(rnd(mv-1)+1)))
	add(obs, c[1])
	add(obs, c[2])
	return c
end

function nex()
	n = piece()
	--n[1].v=8
	n[1].tx, n[1].x = -2.5, -2.5
	n[1].ty, n[1].y = 6, 8
	--n[2].v=9
	n[2].tx, n[2].x = -1.5, -1.5
	n[2].ty, n[2].y = 6, 8
	return n
end

function b(i, j)
	return board[i*bh+j]
end

function bs(i,j,v)
	board[i*bh+j] = v
end

function lw(a) --lower right
	bx = bw-1 --best x
	by = bh-1 --best y
	for p in all(a) do
		x=flr(p/bh)
		y=p%bh
		if y < by then
			bx = x
			by = y
		elseif y == by then
			if x < bx then
				bx = x
				by = y
			end
		end
	end
	return bx*bh+by
end



function has(t, v)
	for e in all(t) do
		if e == v then
			return true
		end
	end
	return false
end

function hast(t, v)
	for e in all(t) do
		c = true
		printh(e)
		for i in 1,#e do
			c = c and e[i] == v[i]
		end
		if c then
			return true
		end
	end
	return false
end

function cadd(t, v)
	if not has(t, v) then
		add(t, v)
	end
end

function sgn(n)
	if (n>0) return 1
	if (n==0) return 0
	return -1
end

function acc(n)
	if (abs(n) < 0.05) return n
	return 0.4*n
end

function accs(n)
	if (abs(n) < 0.05) return n
	return 0.2*n
end

function lin(n)
	if (abs(n) < 0.2) return n
	return sgn(n)*0.3
end

function em()
	e = {}
	e.v = 0
	return e
end

function die(o)
	o.v = 0
	del(obs, o)
	for i=1,#board do
		if board[i] == 0 then
			board[i] = em()
		end
	end
	--[[o.v = 0
	o.t = nil
	o.x=nil o.y=nil o.tx=nil o.ty=nil
	o.e = nil
	o.d = nil
	o.ft = nil]]
end

function up(o)
	o.v += 1
	o.t = 0
	o.ft = die
	-- sfx(4+com)
	mv = min(11, max(mv, o.v))
	--com += 1
	lu=0
end

function wh()
	for i=1,15 do
		pal(i,7)
	end
end
