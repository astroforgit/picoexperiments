pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
function _init()
	menuitem(1, "end game", _init)
	initgame()
	debug=false
end

function _update()
	if gamemode=="game" then
		gameupdate()
		if wincheck() then
			gamemode="win"
			sfx(6)
		end
		--Win Animation
	elseif gamemode=="win" then
		cardanim=cards[flr(rnd(52))+1]
		cardanim.x=flr(rnd(114))
		cardanim.y=flr(rnd(108))
		cardanim.closed=false
		-- cardanim.suit=flr(rnd(4))+1
		-- cardanim.value=flr(rnd(13))+1
		if btnp(é) or btnp(ó) then initgame() end
	elseif gamemode=="start" then
		if btnp(é) then
			gamemode="game"
			sfx(20)
		end
	end
end

function _draw()
	if gamemode=="game" then
		cls(3)
		renderdeck()
		renderstock()
		rendertableaus()
		rendercur()
		renderselected()
		renderfoundations()
	end
	if gamemode=="win" then
		rendercard(cardanim)
	elseif gamemode=="start" then
		cls(3)
		for c in all(cardfalls) do
			rendercard(c)
			c.y+=c.vspeed
			if c.y>=128 then
				c.suit=flr(rnd(4)+1)
				c.vaslue=flr(rnd(13)+1)
				c.x=flr(rnd(116))
				c.y=-20
				c.vspeed=rnd(2)+0.4
				c.closed=false
				if rnd()<0.1 then c.closed=true end
			end
		end

		sspr(16,40,112,18,8,40)
		rectfill(27,61,99,67,3)
		print("by myshaak - 2019",30,62,7)
		print("version: 0.8",0,122,5)
		rectfill(27,99,99,105,3)
		color(abs(flr(sin(time())+.5))*7)
		print("press é to start",30,100)
	end
-- color(10)
--	print(stat(1),0,123)
--	print(#tableaus[cur.x],120,123)
end

function renderselected()
	local yofs=0
--	if cur.x==selected and #selecttab>1 then
--		yofs=-10
--	end
	for i=#selecttab,1,-1 do
		c=selecttab[i]
		if c.selected then
			c.x=cur.dx-4
			c.y=cur.dy-8+yofs
			rendercard(c)
			yofs+=7
		end
	end
end
	
function wincheck()
	local sum,test=0,52
	if debug then test=1 end
	for i=1,4 do
		sum+=#foundations[i]
	end
	return sum==test
end

function gameupdate()
	updatecur()
	local tab=tableaus[cur.x]
	local c
	--low row
	if cur.row==1 and btnp(é) then
		if selected==0 then
			-- select in tableau
			if #tab>0 then
				if tab[#tab].closed then
					--turn closed card face up
					tab[#tab].closed=false
				else		
					--select cards
					sfx(2)	
					deselect()
					if cur.row==1 then
						for i=1,cur.y do
							c=tab[#tab-i+1]
							c.selected=true--not c.selected
							add(selecttab,c)
							selected=cur.x
						end
						cur.y=1
					end
				end
			end
		else
		 -- move cards
			local srctab=selected==8 and stock or tableaus[selected]
			local t_card=tab[#tab]
			-- if t_card~=nul then
			-- 	t_card.closed = true
			-- end
			local t_value,t_color
			if t_card==nil then
				--free column
				t_value=14
				t_color=2				
			else
				t_value=t_card.value
				t_color=t_card.suit%2
			end
			local i=1
			while not srctab[i].selected do 
				i+=1
			end
			local source=srctab[i]
			local s_value=source.value
			local s_color=source.suit%2
			if s_value+1==t_value and s_color~=t_color then
				sfx(5)
				for i=1,#srctab do
					if srctab[i].selected then
						add(tab,srctab[i])
					end
				end
				for i=#srctab,1,-1 do
					if srctab[i].selected then
						del(srctab,srctab[i])
					end
				end
				deselect()
			else
				sfx(1)
			end
		end
	elseif cur.row==0 and btnp(é) then
		-- high row
		if cur.x==1 then
			-- deck
			if selected~=0 then
				sfx(1)
			else
				if #deck>0 then
					sfx(3)
					for i=1,3 do
						drawtostock()
					end				
				else
					-- deck is empty
					--move cards from stock
					deck=stock
					stock={}
				end
			end
		elseif cur.x==2 then
			-- stock
			if selected~=0 then
				sfx(1)
			else
				if #stock>0 then
					deselect()
					stock[#stock].selected=true
					selected=8
					add(selecttab,stock[#stock])
				end
			end
		end
	elseif btnp(ó) and selected~=0 then
		deselect()
	elseif cur.row==1 and btnp(ó) then
		--move to foundation
		c=tab[#tab]
		if c~=nil then
			local t_f=foundations[c.suit]
			if c.value==#t_f+1 or debug then
				sfx(4)
				add(t_f,del(tab,c))
	  end	
		end
	elseif cur.row==0 and cur.x==2 and btnp(ó) then
		--move from stock to foundation
		c=stock[#stock]
		local t_f=foundations[c.suit]
		if c.value==#t_f+1 then
			sfx(4)
			add(t_f,del(stock,c))
		end
	end
	autoopen()
end

function autoopen()
	local c,tab
	for i=1,7 do
		tab=tableaus[i]
		c=tab[#tab]
		if c~=nil then
			if c.closed then
				c.closed=false
			end
		end
	end
end

function deselect()
--*
	selected=0
	for c in all(cards) do
		c.selected=false
	end
	selecttab={}
end

function gentableaus()
 tableaus = {}
	for i=1,7 do
		add(tableaus,{})
	end
	for i=1,7 do
		for j=1,i do
		 local c=drawcard()
			add(tableaus[i],c)
			if i~=j then
				c.closed=true
			end
		end
	end
--	for t=1,6 do
--		local r=flr(rnd(5))
--		for i=1,r do
--			add(tableaus[t],drawcard())
--		end
--	end
end

function drawtostock()
 local c=drawcard()
	add(stock,c)
end

function drawcard()
	return del(deck,deck[1])
end

function updatecur()
	if btnp(ã) then
		sfx(0)
		cur.y=1
		cur.x-=1
		if cur.x==0 then
			cur.x=7
			cur.row=1
		end
--		cur.y=1
--		if cur.x==0 then
--			cur.x=cur.row==1 and 7 or 6
--		end
	end
	if btnp(ë) then
		sfx(0)
		cur.y=1
		cur.x+=1
		if cur.x>7 then
			cur.x=1
		elseif cur.x>2 and cur.row==0 then
			cur.x=1
			cur.row=1
		end
		
--		cur.y=1
--		if cur.x>(cur.row==1 and 7 or 6) then
--			cur.x=1
--		end
	end
	if btnp(î) and selected==0 then
		sfx(0)
	 if cur.row==1 then
			local tab=tableaus[cur.x]
			cur.y+=1
			if cur.y>#tab then
				cur.y=1
				cur.row=0
				cur.x=min(2,cur.x)
			else
				local c=tab[#tab-cur.y+1]
				if c.closed then
					cur.y=1
					cur.row=0
					cur.x=min(2,cur.x)
				end
			end
		end
	end
	if btnp(É) then
		sfx(0)
		if cur.row==1 then
			cur.y-=1
			if cur.y==0 then
				cur.x,cur.y=1,1
				cur.row=0
			end
		else --row 0
			cur.row=1
			if cur.x>2 then cur.x+=1 end
		end
	end
end

function newdeck(sets)
	for set=1,sets do
		for suit=1,4 do
			for value=1,13 do
				local card=newcard(suit,value)
				add(deck,card)
				add(cards,card)
			end
		end
	end
end

function newcard(suit,value)
--	local closed=rnd(10)<1
	return {
		suit=suit,
		value=value,
		text=sub(values,value,value),
		x=0,
		y=0,
		closed=false,
		selected=false
	}
end

function shuffledeck()
	for i=#deck,1,-1 do
		local r=flr(rnd(i)+1)
		deck[i],deck[r]=deck[r],deck[i]
	end
end

-->8
--render
function cardpos(tableau,index)
	local y,dy=25,0
	for i=1,index do
		local c=tableau[i]
		if not c.selected then
			y+=dy
			dy=c.closed and 3 or 7
		end
	end
	return y
end

function rendercur()
	local xpos={8,26,60,77,94,111}
	local dx,dy,ypos
--	local y=#tablau[curpos]
	if cur.row==1 then
		dx=9+(cur.x-1)*17
		local tab=tableaus[cur.x]
		ypos=cardpos(tab,#tab-cur.y+1)
		if cur.y==1 then ypos+=12 end
		ypos=min(120,ypos) 
	else
		dx=xpos[cur.x]
		ypos=14
		if cur.x==2 then
			dx+=(min(2,max(0,#stock-1)))*7
		end
	end
	dy=5+sin(t())+ypos
	cur.dx=dx
	cur.dy=dy
--	if cur.y==1 then cur.dy-=12 end
 spr(66,dx,dy)
end

function renderstock()
	local cnt=1
	for i=max(#stock-2,1),#stock do
		local c=stock[i]
		c.x=15+cnt*7
		c.y=3
		if not c.selected then
			rendercard(c)
		end
		cnt+=1
	end
end

function rendertableaus()
	for i=1,7 do
		sspr(0,32,16,24,5+(i-1)*17,25)
	end
	for i=1,7 do
		for index,c in pairs(tableaus[i]) do
			c.x=5+(i-1)*17
			c.y=cardpos(tableaus[i],index)
			if not c.selected then
				rendercard(c)
			end
		end
	end
end

function renderfoundations()
	local x,y
	for i=1,4 do
		x,y=39+17*i,2
		if #foundations[i]==0 then
			sspr(0,32,16,24,x,y)
		else
			local c=foundations[i][#foundations[i]]
			c.x,c.y=x,y
			rendercard(c)
		end
	end
end

function renderdeck()
	if #deck>0 then
		sspr(24,0,16,24,5,3)
		if #deck>1 then
			sspr(24,0,16,24,4,2)
		end
	end	
end	

function rendercard(c)
	if c.closed then
		sspr(24,0,16,24,c.x,c.y)
	else
		if c.selected then
			pal(7,10)
		end
		sspr(8,0,16,24,c.x,c.y)
		pal(7,7)
		local col=colors[c.suit]
		if c.value==10 then
			pal(0,col)
			spr(37,c.x+2,c.y+2)
			pal(0,0)
		else
			color(col)
			print(c.text,c.x+3,c.y+2)
		end
		--small suit
		spr(20+c.suit,c.x+8,c.y+2)
		if c.value>10 then
			--figures
			sspr(13*(c.suit-1),64+12*(c.value-11),13,12,c.x+1,c.y+8)
		else
	  --big suit
			sspr(72+flr((c.suit-1)/2)*16,((c.suit-1)%2)*16,11,11,c.x+2,c.y+8)
		end
	end
end

-->8
--init
function initgame()
	deck={}
	cards={}
	tableaus={}
	stock={}
	foundations={}
	gamemode="start"
	cur={dx=0,dy=0,x=1,y=1,row=1}
	selected=0
	selecttab={}

	cls(3)
	palt(0,false)
	palt(3,true)
	--suits="áìèà"
	values="a23456789xjqk"
	colors={8,0,8,0}
	for i=1,4 do
		foundations[i]={}
	end
	cardanim=newcard(1,1)
	cardfalls={}
	prepareanim()
	
	newdeck(1)
	shuffledeck()
	
	gentableaus()
end	

--prepare start animation
function prepareanim()
	local c
	for i=1,15 do
		c=newcard(flr(rnd(4)+1),flr(rnd(13)+1))
		c.x=flr(rnd(116))
		c.y=-20
		c.vspeed=rnd(2)+0.4
		if rnd()<0.1 then c.closed=true end
		add(cardfalls,c)
	end
end
