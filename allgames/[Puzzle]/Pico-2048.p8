pico-8 cartridge // http://www.pico-8.com
version 7
__lua__
--pico-2048
--classical puzzle game

--original by
--https://gabrielecirulli.github.io/2048

--created 2016/05/11 by joss

--have fun !!

--set colors here
backcolor=1
texcolor=7

--board parameter
spd=6 --animation speed
boardw=4
boardh=4
board={{},{}}
animboard={}
cs=24 --cell size pixels
anothermove=0 --to move 3times by turn
lm=0 --last merge
checkgo=false --check gameover
--hasmerge=false

--player parameter
playerturn=false
gameover=true
doublecheck=3
score=0
best=0

--use for save highscore
cartdata("joss_2048")

--set the board the first time
function setboard()
	local nb=2
	for x=1,boardw do
		board[x]={}
		for y=1,boardh do
			board[x][y]={}
				board[x][y].v=0
				board[x][y].lv=0
				board[x][y].pos={}
				board[x][y].pos.x=0
				board[x][y].pos.y=0
				board[x][y].move=false
			if(rnd(10)<3 and nb>0)then
				board[x][y].v=1
				nb-=1
			end
		end
	end
end

--call by init or after gamerover
function startgame()
	best=dget(0)
	setboard()
	score=0
	playerturn=true
	gameover=false
end

function _init()
	startgame()
end

--check if the player can put new number tile
function checkgameover()
	local emptyplace=0
	for x=1,boardw do
		for y=1,boardh do
			if(board[x][y].v==0)emptyplace+=1
		end
	end
	if(emptyplace==0)then
		doublecheck-=1
		if(doublecheck<1)then
			gameover=true
			--set highscore
			if(best<score) dset(0,score)
		end
	else
		doublecheck=3
		addnewcell()
	end
end

--add new number tile
function addnewcell()
	local nb=1
	if(rnd(10)<3)nb=2 --2 cells by turn
	
	for x=1,boardw do
		for y=1,boardh do
			if(board[x][y].v==0
				and rnd(10)<3 
				and nb>0)then
					board[x][y].v=1
					if(rnd(10)<2)board[x][y].v=2
					nb-=1
			end
		end
	end
end

--when press left
function mergeleft()
	playerturn=false
	for x=2,boardw do
		for y=1,boardh do
			if(board[x][y].v!=0)then
			
				if(board[x-1][y].v!=0
				and board[x-1][y].v==board[x][y].v)then
					board[x-1][y].lv=board[x-1][y].v
					movingcell(board[x][y],board[x-1][y],"left")
					board[x-1][y].v+=1
					addscore(board[x-1][y].v)
					board[x][y].v=0
					--hasmerge=true
				end
				
				if(board[x-1][y].v==0)then
					board[x-1][y].lv=board[x-1][y].v
					movingcell(board[x][y],board[x-1][y],"left")
					board[x-1][y].v=board[x][y].v
					board[x][y].v=0
				end
			end
		end
	end
	checkgo=true
end

--when press right
function mergeright()
	playerturn=false
	for x=boardw-1,1,-1 do
		for y=1,boardh do
			if(board[x][y].v!=0)then
				
				if(board[x+1][y].v!=0
				and board[x+1][y].v==board[x][y].v)then
					board[x+1][y].lv=board[x+1][y].v
					movingcell(board[x][y],board[x+1][y],"right")
					board[x+1][y].v+=1
					addscore(board[x+1][y].v)
					board[x][y].v=0
					--hasmerge=true
				end
		 
				if(board[x+1][y].v==0)then
					board[x+1][y].lv=board[x+1][y].v
					movingcell(board[x][y],board[x+1][y],"right")
					board[x+1][y].v=board[x][y].v
					board[x][y].v=0
				end
			end
		end
	end
	checkgo=true
end

--when press up
function mergeup()
	playerturn=false
	for x=1,boardw do
		for y=2,boardh do
			if(board[x][y].v!=0)then
				
				if(board[x][y-1].v!=0
				and board[x][y-1].v==board[x][y].v)then			
					board[x][y-1].lv=board[x][y-1].v
					movingcell(board[x][y],board[x][y-1],"up")
					board[x][y-1].v+=1
					addscore(board[x][y-1].v)
					board[x][y].v=0
					--hasmerge=true
				end
			
				if(board[x][y-1].v==0)then
					board[x][y-1].lv=board[x][y-1].v
					movingcell(board[x][y],board[x][y-1],"up")
					board[x][y-1].v=board[x][y].v
					board[x][y].v=0
				end
			end	
		end
	end
	checkgo=true
end

--when press down
function mergedown()
	playerturn=false
	for x=1,boardw do
		for y=boardh-1,1,-1 do
			if(board[x][y].v!=0)then
				
				if(board[x][y+1].v!=0
				and board[x][y+1].v==board[x][y].v)then
					board[x][y+1].lv=board[x][y+1].v
					movingcell(board[x][y],board[x][y+1],"down")
					board[x][y+1].v+=1
					addscore(board[x][y+1].v)
					board[x][y].v=0
					--hasmerge=true
				end
			
				if(board[x][y+1].v==0)then
					board[x][y+1].lv=board[x][y+1].v
					movingcell(board[x][y],board[x][y+1],"down")
					board[x][y+1].v=board[x][y].v
					board[x][y].v=0
				end
			end
		end
	end
	checkgo=true
end

--create move cell
function movingcell(from,to,where)
	newmovecell(from,to,where)
	mvg(to,true)
end

--can draw cell
function mvg(mc,b)
	mc.move=b
end

--add movement cell
function newmovecell(f,t,m)	
	nmc={}
	nmc.v=f.v
	nmc.mov=m
	nmc.pos={}
	nmc.pos.x=f.pos.x
	nmc.pos.y=f.pos.y
	nmc.nex=t
	nmc.dir={}
	nmc.dir.x=t.pos.x
	nmc.dir.y=t.pos.y
	
	add(animboard,nmc)
end

--calc anim movement
function updateanim(c)
	if(c.mov=="left")then
		c.pos.x-=spd
		if(c.pos.x<=c.dir.x)then
			c.nex.move=false
			rmv(c)
		end
	end
	if(c.mov=="right")then
		c.pos.x+=spd
		if(c.pos.x>=c.dir.x)then
			c.nex.move=false
			rmv(c)
		end
	end
	if(c.mov=="up")then
		c.pos.y-=spd
		if(c.pos.y<=c.dir.y)then
			c.nex.move=false
			rmv(c)
		end
	end
	if(c.mov=="down")then
		c.pos.y+=spd
		if(c.pos.y>=c.dir.y)then
			c.nex.move=false
			rmv(c)
		end
	end
end

--del element in animboard
function rmv(c)
	del(animboard,c)
end 

--increase score
function addscore(add)
	score+=corr(add,0)
end

function merge(where)
		anothermove-=1
		if(where==0)mergeleft()
		if(where==1)mergeright()
		if(where==2)mergeup()
		if(where==3)mergedown()
end

--update function
function _update()
	if(playerturn==true)then
		--left
		if(btnp(0))then
		 sfx(00)
			lm=0
			--anothermove=boardw
			merge(0)
		end
		--right
		if(btnp(1))then
			sfx(00)
			lm=1
			--anothermove=boardw
			merge(1)
		end
		--up
		if(btnp(2))then
			sfx(00)
			lm=2
			--anothermove=boardh
			merge(2)
		end
		--down
		if(btnp(3))then
			sfx(00)
			lm=3
			--anothermove=boardh
			merge(3)
		end
	end
	
	--calc animation
	foreach(animboard,updateanim)
	if(#animboard==0)then
		if(anothermove > 1) then
			if(hasmerge==false)then
				merge(lm)
			else
				anothermove=0
				hasmerge=false
			end
		else
			if(checkgo==true)then
				checkgameover()
				checkgo=false
			end
			playerturn=true
		end
	end
	
	--gameover button and color button
	if(gameover==true)then
		if(btnp(4)) startgame()
	else
		if(btnp(4))then
			backcolor+=1
		end
		if(btnp(5))then
			texcolor+=1
		end
		if(backcolor>15)backcolor=0
		if(texcolor==backcolor)texcolor+=1
		if(texcolor>15)texcolor=0
	end
	
end

--using to draw ui
function drawui()
	--title
	print("pico-2048",8,6,texcolor)
	print("by joss",8,14,texcolor)
	
	--score
	print("score",64,6,texcolor)
	print(score,64,14,texcolor)
	
	--best score
	print("best",100,6,texcolor)
	print(best,100,14,texcolor)
	
	--gameover
	if(gameover==true) then
		rectfill(28.5,55,100.5,80,backcolor)
		rect(28.5,55,100.5,80,texcolor)
		print("gameover",49,60,texcolor)
		print("press z to replay",31,72,texcolor)
	end
	
end

--using to draw the board
function drawboard()
	for x=1,boardw do
		for y=1,boardh do
			--rect(x*cs,y*cs,cs,cs,board[x][y])
			px=x*cs-8
			py=y*cs
			board[x][y].pos.x=px
			board[x][y].pos.y=py
			if(board[x][y].move==false)then
				spr(corr(board[x][y].v,1),px,py,3,3)
			else
				spr(corr(board[x][y].lv,1),px,py,3,3)
			end
		end
	end
end

--using to draw anim
function drawanim(c)
	spr(corr(c.v,1),c.pos.x,c.pos.y,3,3)
end

--using to find sprite or value of the number tile
function corr(nb,a)
	--arg 0 = value
	--arg 1 = spr
 if(nb==0) then
 	if(a==0) return 0
 	if(a==1) return 048
 end
	if(nb==1) then
		if(a==0) return 2
		if(a==1) return 003
	end
	if(nb==2) then
		if(a==0) return 4
		if(a==1) return 006
	end
	if(nb==3) then
		if(a==0) return 8
		if(a==1) return 009
	end
	if(nb==4) then
		if(a==0) return 16
		if(a==1) return 012
	end
	if(nb==5) then
		if(a==0) return 32
		if(a==1) return 051
	end
	if(nb==6) then
		if(a==0) return 64
		if(a==1) return 054
	end
	if(nb==7) then
		if(a==0) return 128
		if(a==1) return 057
	end
	if(nb==8) then
		if(a==0) return 256
		if(a==1) return 060
	end
	if(nb==9) then
		if(a==0) return 512
		if(a==1) return 099
	end
	if(nb==10) then
		if(a==0) return 1024
		if(a==1) return 102
	end
	if(nb==11) then
		if(a==0) return 2048
		if(a==1) return 105
	end
	if(nb==12) then
		if(a==0) return 4056
		if(a==1) return 108
	end
	if(nb==13) then
		if(a==0) return 8192
		if(a==1) return 147
	end
	if(nb==14) then
		if(a==0) return 16384
		if(a==1) return 150
	end
	if(nb==15) then
		if(a==0) return 32768
		if(a==1) return 153
	end
	if(nb==16) then
		if(a==0) return 65536
		if(a==1) return 156
	end
end

--function draw
function _draw()
	--clear scene
	cls()
	
	--background color
	rectfill(0,0,127,127,backcolor)
	
	--draw board
	drawboard()
	
	--draw anim
	foreach(animboard,drawanim)
	
	--front ui
	drawui()
end

--end
--lot of fun !
