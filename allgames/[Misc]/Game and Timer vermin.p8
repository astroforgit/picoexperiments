function starthigh()
 if game=="a" then
  ones=@0x5e00
  tens=@0x5e01
  hunds=@0x5e02
  thows=@0x5e03
 elseif game=="b" then
  ones=@0x5e04
  tens=@0x5e05
  hunds=@0x5e06
  thows=@0x5e07 
 end
 upd=updhigh
 drw=drawscore
 lives=3
 if is_released(4) or is_released(5) then
  startgame()
 end
end

function startgame()
 upd=updategame
 ones=0
 tens=0
 hunds=0
 thows=0
 money=0
end
-->8
--update

function updategame()
 more()
 updatemole()
 youdead()
 act()
end

function updatefall()
 for m in all(mole) do
  if m.pos==4 and m.t<=1 or m.pos==5 then
   molecheckmate=true
   m.deadmole=true
   upd=upgover
  end
 end
end

function upgover()
 act()
 for m in all(mole) do
  updatemole()
 end
end

function updtimer()
 if stat(93)>9 then
  thows=ord(stat(93))-48
 else
  thows=0
 end
   
 if stat(93)>9 then
  hunds=ord(stat(93),2)-48
 else
  hunds=ord(stat(93))-48
 end  

 if stat(94)>9 then
  tens=ord(stat(94))-48
 else
  tens=0
 end 

 if stat(94)>9 then
  ones=ord(stat(94),2)-48
 else
  ones=ord(stat(94))-48
 end
 
 if is_held(5) then
  game="b"
  starthigh()
  
 end
 if is_held(4) then
  game="a"
  starthigh()
 end
 for m in all(mole) do
  m.t-=1
  if m.t==10 then
   m.pos-=1
   m.t=20
   if m.pos<1 then
    del(mole,m)
   end
  end
 end
end

function updhigh()
 if game=="a" then
  ones=@0x5e00
  tens=@0x5e01
  hunds=@0x5e02
  thows=@0x5e03
 elseif game=="b" then
  ones=@0x5e04
  tens=@0x5e05
  hunds=@0x5e06
  thows=@0x5e07 
 end
 act()
 if is_released(4) or is_released(5) then
  startgame()
 end
end

function youdead()
 if lives==0 then
  sfx(3)
  if game=="a" and ones+10*tens+100*hunds+1000*thows>@0x5e00+10*@0x5e01+100*@0x5e02+1000*@0x5e03 or game=="b" and ones+10*tens+100*hunds+1000*thows>@0x5e04+10*@0x5e05+100*@0x5e06+1000*@0x5e07 then
   savescore()
  end
  upd=updtimer
 end
end
-->8
--draw

function drawbody()
 if last==1 then
  spr(44,30,38,2,1)
  spr(62,30,46,2,1)
 elseif last==2 then
  spr(44,56,38,2,4)
 elseif last==3 then
  spr(44,82,38,2,1)
  spr(62,82,46,2,1,1)
 end
 spr(30,last*26+4,22,2,2)
end

function drawham()
 if upl then
  --arml
  spr(56,last*26-1,33,1,1,1)
  --handl
  spr(29,last*26-10,32,1,1,1)
  --haml
  spr(0,last*26-9,16,1,2)
 else 
  spr(40,last*26-1,43,1,1,1)
  spr(41,last*26-22,51,3,2,1)
 end
 if upr then
  --armr
  spr(56,last*26+17,33)
  --handr
  spr(29,last*26+26,32)
  --hamr
  spr(0,last*26+26,16,1,2)
 else
  spr(40,last*26+17,43,1,1)
  spr(41,last*26+22,51,3,2)
 end
end

function dscore()
 
 if ones>9 then
  tens+=1
  ones=0
 end
 
 if tens>9 then
  hunds+=1
  tens=0
 end
 
 if hunds>9 then
  thows+=1
  hunds=0
 end 
 
 if thows>9 then
  thows=9
  hunds=9
  tens=9
  ones=9
 end
 
 if thows==9 and hunds==9 and tens==9 and ones==9 then
  money=4
  ones=9
  tens=9
  hunds=9
  thows=9
 end
 
 if ones>0 or tens>0 or hunds>0 or thows>0 then
  spr(12-ones,82,112,1,2)
 end
 
 if tens>0 or hunds>0 or thows>0 then
  spr(12-tens,74,112,1,2)
 end
 
 if hunds>0 or thows>0 then
  spr(12-hunds,66,112,1,2)
 end
 
 if thows>0 then
  spr(12-thows,58,112,1,2)
 end
end

function drawlives()
 if lives<3 then
  spr(1,3,112)
  spr(37,3,120)
  spr(15,11,120)
  spr(17,11,112)
 end
  if lives<2 then
  spr(1,20,112)
  spr(37,20,120)
  spr(15,28,120)
  spr(17,28,112)
 end
  if lives<1 then
  spr(1,37,112)
  spr(37,37,120)
  spr(15,45,120)
  spr(17,45,112)
 end  
end
-->8
--tools
function frame(ani)
 return ani[flr(t/8)%#ani+1]
end

function dofade()
 local p,kmax,col,k=flr(mid(0,fadeperc,1)*100)
 for j=1,15 do
  col = j
  kmax=flr((p+j*1.46)/22)
  for k=1,kmax do
   col=dpal[col]
  end
  pal(j,col,1)
 end
end

function checkfade()
 if fadeperc>0 then
  fadeperc=max(fadeperc-0.08,0)
  dofade()
 end
end

function wait(_wait)
 repeat
  _wait-=1
  flip()
 until _wait<0
end

function fadeout(spd,_wait)
 if (spd==nil) spd=0.04
 if (_wait==nil) _wait=0
 repeat
  fadeperc=min(fadeperc+spd,1)
  dofade()
  flip()
 until fadeperc==1
 wait(_wait)
end

 function is_held(k) return band(keys[k], 1) == 1 end
 function is_pressed(k) return band(keys[k], 2) == 2 end
 function is_released(k) return band(keys[k], 4) == 4 end

 function upd_key(k)
     if keys[k] == 0 then
         if btn(k) then keys[k] = 3 end
     elseif keys[k] == 1 then
         if btn(k) == false then keys[k] = 4 end
     elseif keys[k] == 3 then
         if btn(k) then keys[k] = 1
         else keys[k] = 4 end
     elseif keys[k] == 4 then
         if btn(k) then keys[k] = 3
         else keys[k] = 0 end
     end
 end

 function init_keys()
     for a = 0,5 do keys[a] = 0 end
 end

 function upd_keys()
     for a = 0,5 do upd_key(a) end
 end
 
function tablelength(t)
  local count = 0
  for _ in pairs(t) do count = count + 1 end
  return count
end

-->8
--gameplay

function act()
 if is_pressed(0) then
  last=max(last-1,1)
 elseif is_pressed(1) then
  last=min(last+1,3) 
 end
end

function bonk()
 if lives<=3 then
  for m in all(mole) do
   if m.pos>3 and m.mole==last and not m.deadmole and m.t<=18 then
    upl=false
    ones+=1
    del(mole,m)
    sfx(1+money)
   end
   if m.pos==4 and m.mole==last+2 and not m.deadmole and m.t<=18 then
    upr=false
    ones+=1
    del(mole,m)
    sfx(1+money)
   end
  end
 end
end

function more()
 local mathit=game=="a" and 5.5 or 4
 if morer<=0+min(flr(tens+hunds+thows/mathit),12+money/2) then
  moletype=flr(rnd(5.99))
  addmole(moletype,1,20)
  morer=19
  sfx(0)
 else
 morer-=1
 end
end

function savescore()
 if game=="a" then
  poke(0x5e00,ones)
  poke(0x5e01,tens)
  poke(0x5e02,hunds)
  poke(0x5e03,thows)
 else
  poke(0x5e04,ones)
  poke(0x5e05,tens)
  poke(0x5e06,hunds)
  poke(0x5e07,thows)
 end
end
-->8
--mole
function addmole(_mole,_pos,_t)
 local m={mole=_mole,
          pos=_pos,
          t=_t,
          deadmole=false
          }
 add(mole,m)
 return m
end

function updatemole()
 for m in all(mole) do
  if m.mole<=0 then
   del(mole,m)
  end
  local mathit=game=="a" and 5.5 or 4
  if m.t<=0+min(flr(tens+hunds+thows/mathit),12+money/2) then
   if not molecheckmate then
    m.pos=min(m.pos+1,5)
    m.t=20
   elseif m.pos>1 and m.deadmole then
    m.pos=max(m.pos-1,1)
    m.t=20
    sfx(2)
   elseif m.pos==1 and m.t<=0 and m.deadmole then
    for m in all(mole) do
     if m.deadmole then
      lives=max(lives-1,0)
      molecheckmate=false
      upd=updategame
      m.deadmole=false
      del(mole,m)
     end
     for m in all(mole) do
      m.t=0
     end
    end
   end
  end
  if not molecheckmate then
   m.t-=1
  elseif m.deadmole then
   m.t-=.5
  elseif m.t==0 and m.deadmole then
   m.pos-=1
  end
 end
end

function drawmole()
 for m in all(mole) do
  local digpile,other,fix,otherfix=m.pos==1 and 53 or m.pos==2 and 13 or m.pos==3 and 38,m.mole%2==0 and m.pos==3 and 4 or 0,m.mole==5 and m.pos==2 and 1 or 0,m.mole==5 and m.pos==3 and 1 or 0
  if m.pos<4 and m.mole<3 then
   spr(digpile,max(2-m.pos+1,1)+m.mole*25-25+other,110-m.pos*10,max(4-m.pos,2),1)
  elseif m.mole<3 then
   spr(33+m.mole*2-2,4+m.mole*26-26,64,2,2)
  end
  
  if m.mole==3 and m.pos<4 then
   spr(digpile,min(52+m.pos*4-4,56),110-m.pos*10,max(4-m.pos,2),1)
  elseif m.mole==3 then
   spr(35,56,64,2,2)
  end
  
  if m.pos<4 and m.mole>3 then
   spr(digpile,77+min(m.pos*10-10,10)-other*5/4+(m.mole-4)*25-fix-otherfix,110-m.pos*10,max(4-m.pos,2),1)
  elseif m.mole>3 then
   spr(35-(m.mole-2)*2+4,4+m.mole*26-26,64,2,2,1)
  end
 end
end
