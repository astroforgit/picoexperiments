 spr(13,87,90,2,1)
 spr(38,82,80,2,1)
 --dig5
 spr(53,102,100,3,1)
 spr(13,111,90,2,1)
 spr(38,111,80,2,1)
 fadebody()
 pal()
end

function fadebody()
  --fade head
 spr(30,30,22,2,2)
 spr(30,56,22,2,2)
 spr(30,82,22,2,2)
 --fade body
