pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
-- game and timer vermin
-- by aden nguyen

function _init()
 cartdata(game_and_timer_vermin)
 mole={}
 keys={}
 init_keys()
 last=2
 up=true
 upl=true
 upr=true
 morer=19
 upd=updtimer
 drw=drawtimer
 lives=3
 molecheckmate=false
end

function _draw()
 upl=true
 upr=true
 cls(7)
 startboard()
 palt(7,true)
 palt(0,false)
 drawbody()
 bonk()
 drawham()
 drawmole()
 dscore()
 drawlives()
end

function _update()
 upd_keys()
 updatefall()
 upd()
 drawmole()
end

function startboard()
 --ground
 palt(0,false)
 palt(7,true)
 spr(48,0,120) 
 rectfill(0,110,48,109)
 rectfill(55,117,56,128)
 
 spr(32,48,109)
 
