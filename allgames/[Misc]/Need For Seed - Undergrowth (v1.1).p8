pico-8 cartridge // http://www.pico-8.com
version 5
__lua__
--need for seed: undergrowth
--by connor halford

--originally made in 48 hours
--for ludum dare 34 with the
--dual themes of "growing" and
--"two button controls"

---------todo!!!!
--music?
--screen wrap?
--change vine die sfx to vine
 --spawn sfx, or play at start

---------bugs!!!!
--pfx sometimes get left on the
 --screen,but the game is about
 --messing up the screen anyway


s_menu=0
s_game=1
s_lose=2
state=s_menu
state_next=s_menu
fading=false
fade_t=0

sfx_get_fert=0
sfx_get_flower=3
sfx_game_over=4
sfx_die1=6
sfx_die2=7
sfx_die3=8
sfx_fade=9
sfx_mower=10
chnl_mower=3

puns={}
puns[0]="final fantiseed"
puns[1]="grass effect"
puns[2]="bark of the ninja"
puns[3]="assassin's seed"
puns[4]="spec crops: the vine"
puns[5]="raingrow six"
puns[6]="wolfenvine 3d"
puns[7]="fallout: grew vegas"
puns[8]="vinecraft"
puns[9]="bark: survival evolved"
puns[10]="saints grow 3"
puns[11]="shears of war"
puns[12]="super mario grows"
puns[13]="sonic the hedge"
puns[14]="hotvine miami"
puns[15]="prison barkitect"
puns[16]="pokemon reed and grew"
puns[17]="super wheat boy"
puns[18]="heavy grain"
puns[19]="bloom"
puns[20]="bark souls"
puns[21]="ground theft auto"
puns[22]="the winding of isaac"
puns[23]="barksiders"
puns[24]="mgs v: the phantom grain"
puns[25]="gang yeasts"
puns[26]="amnesia: the bark descent"
num_puns=#puns
pun_index=flr(rnd(num_puns))
pun_x=128

function _init()
 state=s_menu
 init_menu()
end

function _update()
 if state==s_menu then
   update_menu()
 elseif state==s_game then
   update_game()
 else
   update_lose_screen()
 end
end

function _draw()
 if state==s_menu then
   draw_menu()
 elseif state==s_game then
   draw_game()
 else
   draw_lose_screen()
 end
 
 if fading then
   --draw fade sprites everywhere
   palt(0,false)
   palt(7,true)
   for y=0,15 do
     for x=0,15 do
       --fades are spr 16-24
       spr(16+fade_t,x*8,y*8)
     end
   end
   palt()
   
   --when the fade ends,
   --change state
   fade_t+=1
   if fade_t>=10 then
     fading=false
     fade_t=0
     state=state_next
     if state==s_menu then
       init_menu()
     elseif state==s_game then
       init_game()
     else
       init_lose_screen()
     end
   end
 end
end

function init_menu()
 --mower!
 t_mower=1 --time to spawn
 t_mpfx=0 --time to next particle
 mowerspeed=2
 mowertype=0 --from right,left,or top
 mower={}
 mower.x=0
 mower.y=0
 mower.w=8
 mower.h=8
 pfx={} --particle fx
 
 pun_x=128
end

function update_menu()
 if (fading) return
 
 update_particles()
 update_mower()
 
 --scrolling text
 pun_x-=1
 local s=puns[pun_index]
 if pun_x<-4*#s then
   pun_x=128
   pun_index+=1
   if (pun_index>=num_puns) pun_index=0
 end
 
 if btnp(1) then --right
   fading=true
   sfx(sfx_fade)
   state_next=s_game
 end
end

function draw_menu()
 cls()
 
 --mower!
 draw_mower()
 draw_particles()
 
 --"need for seed:"=64-77
 for i=0,13 do
   spr(64+i,8+8*i,18)
 end
 --"undergrowth"=80-90
 for i=0,10 do
   spr(80+i,20+8*i,27)
 end
 
 --instructions
 local x=10
 local y=48
 local dy=8
 local c=7
 local c2=13
 local c3=8
 print("                  seeds",x-1,y+1,c2)
 print("- grow vines from seeds",x,y,c)
 spr(11,105,y-1)
 y+=dy
 print("     refills",x-1,y+1,c2)
 print("-    refills vine life",x,y,c)
 spr(4,x+7,y)
 y+=dy
 print("      bees           flowers",x-1,y+1,c2)
 print("- fly bees from   to flowers",x,y,c)
 spr(9,72,y-1)
 y+=dy
 print("         pollen       seeds",x-1,y+1,c2)
 print("  to get pollen, then seeds",x,y,c)
 y+=dy
 print("                  game over",x-1,y+1,c2)
 print("- still no seeds? game over",x,y,c)
 y+=1.8*dy
 print("    left     right",x-1,y+1,c2)
 print("use left and right to steer",x,y,c)
 y+=1.8*dy
 print("      right",x+12,y+1,c3)
 print("press right to start",x+13,y,c)
 
 --print("    seeds         flowers",x-1,y+1,c2)
 --print("use seeds to grow flowers.",x,y,c)
 --y+=dy
 --print("when you run out of seeds",x,y,c)
 --y+=dy
 --print("             pollinate",x-1,y+1,c2)
 --print("go forth and pollinate.",x,y,c)
 --y+=dy
 --print("                game over",x-1,y+1,c2)
 --print("still no seeds? game over",x,y,c)
 --y+=2*dy
 --print("    left     right",x-1,y+1,c2)
 --print("use left and right to steer",x,y,c)
 --y+=2*dy
 --print("      right",x+12,y+1,c3)
 --print("press right to start",x+13,y,c)
 
 
 
 --puns
 print(puns[pun_index],pun_x,122,c)
end

function init_lose_screen()
 
end

function update_lose_screen()
 if (fading) return
 
 if btnp(0) then --left
   fading=true
   sfx(sfx_fade)
   state_next=s_menu
 elseif btnp(1) then --right
   fading=true
   sfx(sfx_fade)
   state_next=s_game
 end
end

function draw_lose_screen()
 cls()
 
 --"game over"=96-104
 for i=0,8 do
   spr(96+i,28+i*8,20)
 end
 
 local x=0
 local y=36
 local dy=10
 local c=7
 local seconds=flr(stats.time/30)
 
 local s="sprouted for "..seconds.." seconds"
 x=centre_x(s)
 print("sprouted",x-1,y+1,3)
 print(s,x,y,c)
 y+=dy
 s="pollinated "..stats.seeds.." plants"
 x=centre_x(s)
 print("pollinated",x-1,y+1,9)
 print(s,x,y,c)
 y+=dy
 s="bloomed "..stats.flowers.." flowers"
 x=centre_x(s)
 print("bloomed",x-1,y+1,13)
 print(s,x,y,c)
 y+=dy
 s="mowed down "..stats.mowers.." times"
 x=centre_x(s)
 print("mowed down",x-1,y+1,8)
 print(s,x,y,c)
 y+=dy
 s="fertilized "..stats.ferts.." times"
 x=centre_x(s)
 print("fertilized",x-1,y+1,4)
 print(s,x,y,c)
 y+=2*dy
 s="press right to retry"
 x=centre_x(s)
 print("      right",x-1,y+1,8)
 print(s,x,y,c)
 y+=dy
 s="press left for menu"
 x=centre_x(s)
 print("      left",x-1,y+1,8)
 print(s,x,y,c)
end

function init_game()
 --screen isn't cleared while
 --the game is running, we
 --just clear it once here.
 cls()
 
 px=0   --player position
 py=0
 ang=0  --heading
 seedx=0 --next spawn pos
 seedy=0
 seedang=0 --next spawn heading
 vinelife=40 --life
 beelife=60
 life=vinelife
 lifespeed=0.3
 seeds=4 --seeds
 t_vine=0 --time this vine alive
 
 bee=false
 beecol={} --colors bee flew over
 beecol.tl=0 --top left
 beecol.tr=0 --top right
 beecol.bl=0 --bottom left
 beecol.br=0 --bottom right
 visits=0 --num flowers visited
 hivex=0   --next bee spawn pos
 hivey=0
 hiveang=0 --heading from hive
 beetrail={}
 t_trail=0
 
 flowers={}
 
 ferts={} --fertilizer pickups
 t_fert=20 --time to next fert
 
 t_mower=0 --time to spawn
 t_mpfx=0  --time to next particle
 mowerspeed=2
 mowertype=0 --from right,left,or top
 mower={}
 mower.x=0
 mower.y=0
 mower.w=8
 mower.h=8
 
 pfx={} --particle fx
 
 stats={}
 stats.time=0
 stats.flowers=0
 stats.ferts=0
 stats.mowers=0
 stats.seeds=0
 
 seedx,seedy,seedang=randomize_spawn()
 respawn_hive()
 spawn_vine()
end

function update_trail()
 if (not bee) return
 if (visits<=0) return
 t_trail-=1
 if t_trail<=0 then
   t_trail=5
   local p={}
   p.x=px
   p.y=py
   p.prevcol=beecol.tl
   beetrail[#beetrail+1]=p
 end
end

function draw_trail()
 if (not bee) return
 for p in all(beetrail) do
   pset(p.x,p.y,15)
 end
end

function remove_trail()
 for p in all(beetrail) do
   pset(p.x,p.y,p.prevcol)
   del(beetrail,p)
 end
end

function respawn_hive()
 spr(10,hivex,hivey)
 hivex,hivey,hiveang=randomize_spawn()
end

function update_game()
 
 if (fading) return
 
 stats.time+=1
 
 --replace colors bee flew over
 if bee then
   pset(px,py,beecol.tl)
   pset(px+1,py,beecol.tr)
   pset(px,py+1,beecol.bl)
   pset(px+1,py+1,beecol.br)
 end
 
 update_trail()
 
 --randomly add small details
 local xpos=flr(rnd(128))
 local ypos=flr(rnd(128))
 local c=pget(xpos,ypos)
 if c==11 or c==3 then
   local type=flr(rnd(3))
   if type==0 then --blue berry
     pset(xpos,ypos,12)
   elseif type==1 then --red berry
     pset(xpos,ypos,8)
   else --mini flower
     spr(8,xpos-1,ypos-1)
   end
 end
 
 update_mower()
 
 --spawn fertilizer
 t_fert-=1
 if t_fert<=0 then
   t_fert=100+flr(rnd(60))
   local f={}
   f.x=flr(rnd(121))
   f.y=9+flr(rnd(113))
   f.w=8
   f.h=5
   ferts[#ferts+1]=f
 end
 
 if bee then
   bee_flower_collision()
 else --not bee
   vine_fert_collision()
   
   --spawn flowers over time
   t_vine+=lifespeed
   if t_vine>31 then
     t_vine=0
     add_flower(px-3,py-3)
   end
 end
 
 --steering
 local turnspeed=5
 if (btn(0)) ang+=turnspeed
 if (btn(1)) ang-=turnspeed
 
 --movement
 local movespeed=0.5
 px+=cos(ang/360)*movespeed
 py+=sin(ang/360)*movespeed
 
 --life
 life-=lifespeed
 if life<=0 then --dead
   --die
   if bee then
     if seeds<=0 then
       --game over!
       fading=true
       sfx(-1,chnl_mower)
       sfx(sfx_game_over)
       state_next=s_lose
     else
       --respawn hive
       respawn_hive()
       die_sound()
       
       --respawn player
       spawn_vine()
     end
   else --not bee
     kill_vine()
     die_sound()
   end
   
   --reduce max lifetimes
   vinelife-=0.5
   beelife-=0.5
   if (vinelife<24) vinelife=24
   if (beelife<40) beelife=40
 end
 
 update_particles()
 
 --store colors bee flies over
 if bee then
   beecol.tl=pget(px,py)
   beecol.tr=pget(px+1,py)
   beecol.bl=pget(px,py+1)
   beecol.br=pget(px+1,py+1)
 end
end

function draw_game()
 --draw vine
 if not bee then
   spr(1,px,py)
 end
 
 --draw fertilizer
 for f in all(ferts) do
   spr(4,f.x,f.y)
 end
 
 --draw flowers
 for fl in all(flowers) do
   spr(2,fl.x,fl.y)
 end
 
 draw_seed()
 
 --draw hive
 spr(9,hivex,hivey)
 
 draw_mower()
 draw_trail()
 draw_particles()
 
 --draw bee
 if bee then
   rectfill(px,py,px+1,py+1,10)
 end
 
 ----draw hud
 rectfill(0,0,127,8,1)
 print("seeds:"..seeds,2,2,7)
 print("life:",128-48,2,7)
 --life
 local maxw=25
 local w=maxw*(life/vinelife)
 if (bee) w=maxw*(life/beelife)
 local x=126-maxw
 rect(x,1,x+maxw,7,14)
 rectfill(x,1,x+w,7,14)
end

function draw_seed()
 if (seeds<=0) return
 
 if seedang==90 then      --up
   spr(11,seedx,seedy)
 elseif seedang==180 then --left
   spr(12,seedx,seedy)
 elseif seedang==270 then --down
   spr(11,seedx,seedy,1,1,false,true)
 elseif seedang==0 then   --right
   spr(12,seedx,seedy,1,1,true,false)
 end
end

function draw_dead_seed()
 if seedang==90 then      --up
   spr(27,seedx,seedy)
 elseif seedang==180 then --left
   spr(28,seedx,seedy)
 elseif seedang==270 then --down
   spr(27,seedx,seedy,1,1,false,true)
 elseif seedang==0 then   --right
   spr(28,seedx,seedy,1,1,true)
 end
end

--draw mower and erase behind
function draw_mower()
 if t_mower<=0 then --draw mower
   palt(0,false)
   if mowertype==0 then
     --right to left
     spr(6,mower.x,mower.y)
     rectfill(mower.x+8,mower.y,mower.x+8+mowerspeed,mower.y+8,0)
   elseif mowertype==1 then
     --left to right
     spr(6,mower.x,mower.y,1,1,true)
     rectfill(mower.x-1,mower.y,mower.x-1-mowerspeed,mower.y+8,0)
   else
     --top to bottom
     spr(7,mower.x,mower.y)
     rectfill(mower.x,mower.y-1,mower.x+8,mower.y-1-mowerspeed,0)
   end
   palt()
 elseif t_mower<=60 then --warning
   if (state!=s_game) return
   
   local f=mod(div(t_mower,5),2)
   
   if mowertype==0 then
     --right to left
     spr(29+f,120,mower.y)
   elseif mowertype==1 then
     --left to right
     spr(29+f,0,mower.y,1,1,true,false)
   else
     --top to bottom
     spr(13+f,mower.x,8)
   end
 end
end

function add_particle(x,y,vx,vy,t,c)
 local p={}
 p.x=x
 p.y=y
 p.vx=vx
 p.vy=vy
 p.t=t
 p.c=c
 p.prev_c=pget(x,y)
 pfx[#pfx+1]=p
end

function update_particles()
 for p in all(pfx) do
   --redraw what we covered
   pset(p.x,p.y,p.prev_c)
   
   --move
   p.x+=p.vx
   p.y+=p.vy
   
   --store what we now cover
   p.prev_c=pget(p.x,p.y)
   
   --remove if offscreen
   if p.y>128 or p.x<0 or p.x>128 then
     del(pfx,p)
   end
   
   --remove when it dies
   p.t-=1
   if (p.t<=0) del(pfx,p)
 end
end

function draw_particles()
 for p in all(pfx) do
   pset(p.x,p.y,p.c)
 end
end

function spawn_pollen(x,y)
 pfx_ring(x,y,10,0.5,15,15)
end

--x,y centre of ring
--p number of particles
--s speed, t lifetime, c color
function pfx_ring(x,y,p,s,t,c)
 local vx=0
 local vy=0
 local a=0
 local da=360/p
 for i=1,p do
   a=(i*da)/360
   vx=cos(a)*s
   vy=sin(a)*s
   add_particle(x,y,vx,vy,t,c)
 end
end

function spawn_fert_pfx(x,y)
 local vx=0
 local vy=0
 local speed=1
 local num_p=5
 local a=0
 local da=180/(num_p+1)
 local t=10
 local c=4
 for i=1,num_p do
   a=(i*da)/360
   vx=cos(a)*speed
   vy=sin(a)*speed
   add_particle(x,y,vx,vy,t,c)
 end
end

function respawn_mower()
 if state==s_menu then
   if mowertype==0 then
     mowertype=1 --l to r
     mower.x=-8
     mower.y=37
   else
     mowertype=0 --r to l
     mower.x=127
     mower.y=10
   end
 else --s_game
   mowertype=flr(rnd(3))
   if mowertype==0 then
     --right to left
     mower.x=127
     mower.y=9+flr(rnd(111))
   elseif mowertype==1 then
     --left to right
     mower.x=-8
     mower.y=9+flr(rnd(111))
   else
     --top to bottom
     mower.y=0
     mower.x=flr(rnd(120))
   end
 end
end

function update_mower()
 if t_mower>0 then
   t_mower-=1
   if t_mower<=0 then --spawned
     if state==s_game then
       sfx(sfx_mower,chnl_mower)
       stats.mowers+=1
     end
   end
 else --mower alredy exists
   --move mower
   local mowerdead=false
   if mowertype==0 then
     --right to left
     mower.x-=mowerspeed
     if(mower.x<=-8)mowerdead=true
   elseif mowertype==1 then
     --left to right
     mower.x+=mowerspeed
     if(mower.x>=129)mowerdead=true
   else
     --top to bottom
     mower.y+=mowerspeed
     if(mower.y>=129)mowerdead=true
   end
   if mowerdead then
     --reset timer
     if state==s_menu then
       t_mower=1
     else
       t_mower=200+flr(rnd(150))
       --get harder over time
       t_mower-=2*stats.seeds
       if (t_mower<1) t_mower=1
       
       sfx(-1,chnl_mower)
     end
     respawn_mower()
     return
   end
   
   --particle trail
   mower_particles()
   
   --only do collision in-game
   if (state==s_menu) return
   
   --mower fert collision
   for f in all(ferts) do
     if collision(mower,f) then
       kill_fertilizer(f)
     end
   end
   
   --mower flower collision
   for fl in all(flowers) do
     if collision(mower,fl) then
       kill_flower(fl)
     end
   end
   
   --mower vine/bee collision
   local p={}
   p.x=px
   p.y=py
   p.w=2
   p.h=2
   if collision(mower,p) then
     die_sound()
     if bee then
       spawn_bee(false)
       remove_trail()
     else
       kill_vine()
     end
   end
   
   --mower seed collision
   p.x=seedx
   p.y=seedy
   p.w=8
   p.h=8
   if seedang==0 or seedang==180 then
     --left or right
     p.h=7
   else --up or down
     p.w=7
   end
   if collision(mower,p) then
     draw_dead_seed()
     seedx,seedy,seedang=randomize_spawn()
   end
   
   --mower hive collision
   p.x=hivex
   p.y=hivey
   p.w=7
   p.h=6
   if collision(mower,p) then
     respawn_hive()
   end
 end
end

function mower_particles()
 t_mpfx-=1
 if (t_mpfx>0) return
 
 --x,y,vx,vy,t,c
 local x=0
 local y=0
 local vx=0
 local vy=0
 if mowertype==2 then
   --top to bottom
   t_mpfx=4
   
   x=mower.x+mower.w*0.5
   y=mower.y
   local a=0
   local num_p=5
   local da=180/(num_p+1)
   for i=1,5 do
     a=(i*da)/360
     vx=cos(a)
     vy=sin(a)
     add_particle(
      x,y,vx,vy,25,3)
   end
 else --sideways
   t_mpfx=2
   
   if mowertype==0 then
     --right to left
     x=mower.x+9
   else
     --left to right
     x=mower.x-2
   end
   y=mower.y+7
   vx=0
   vy=-0.1-1*rnd(0.2)
   add_particle(
    x,y,vx,vy,25,3)
 end
end

function bee_flower_collision()
 local bee_box={}
 bee_box.x=px
 bee_box.y=py
 bee_box.w=2
 bee_box.h=2
 for fl in all(flowers) do
   if collision(bee_box,fl) then
     sfx(sfx_get_flower)
     visits+=1
     if visits>1 then
       seeds+=1
       stats.seeds+=1
     end
     kill_flower(fl)
   end
 end
end

function vine_fert_collision()
 local v={}
 v.x=px
 v.y=py
 v.w=2
 v.h=2
 for f in all(ferts) do
   if collision(v,f) then
     sfx(sfx_get_fert)
     --refill life
     life=vinelife
     kill_fertilizer(f)
     stats.ferts+=1
   end
 end
end

function kill_flower(fl)
 spr(3,fl.x,fl.y)
 spawn_pollen(fl.x+fl.w*0.5,
              fl.y+fl.h*0.5)
 del(flowers,fl)
end

function kill_fertilizer(f)
 spr(5,f.x,f.y)
 spawn_fert_pfx(f.x+f.w*0.5,
                f.y+f.h*0.5)
 del(ferts,f)
end

function kill_vine()
 --make the vine dark green
 --(col 11 to col 3)
 for i=1,127 do
   for j=1,127 do
     if pget(i,j)==11 then
       pset(i,j,3)
     end
   end
 end
 
 add_flower(px-3,py-3)
 
 --reduce seeds
 if seeds>=1 then
   spawn_vine()
 else
   seeds=0
   spawn_bee(true)
 end
end

function add_flower(x,y)
 spr(2,x,y)
 local fl={}
 fl.x=x
 fl.y=y
 fl.w=8
 fl.h=8
 flowers[#flowers+1]=fl
 stats.flowers+=1
end

function spawn_vine()
 --spawn
 px=seedx+3
 py=seedy+3
 ang=seedang
 life=vinelife
 bee=false
 remove_trail()
 t_vine=0
 seeds-=1
 
 --pfx
 pfx_ring(px,py,20,1,20,11)
 
 --reset spawn point
 draw_dead_seed()
 seedx,seedy,seedang=randomize_spawn()
end

function spawn_bee(do_reset)
 px=hivex+3
 py=hivey+4
 ang=hiveang
 visits=0
 bee=true
 
 if do_reset then
   life=beelife
 end
 
 pfx_ring(px,py,20,1,20,15)
end

function randomize_spawn()
 --position
 local x=flr(rnd(121))
 local y=9+flr(rnd(111))
 local a=0
 
 --steer away from nearest edge
 local left=x
 local right=128-x
 local top=y
 local bottom=120-y
 if left<=right and left<=top and left<=bottom then
   a=0
 end
 if right<=left and right<=top and right<=bottom then
   a=180
 end
 if top<=left and top<=right and top<=bottom then
   a=270
 end
 if bottom<=left and bottom<=right and bottom<=top then
   a=90
 end
 
 return x,y,a
end

--axis-aligned bounding boxes
function collision(a,b)
 if (a.x+a.w<b.x) return false
 if (a.x>b.x+b.w) return false
 if (a.y+a.h<b.y) return false
 if (a.y>b.y+b.h) return false
 return true
end

--screen-centred text
function centre_x(s)
 --each char is 3+1 pixels,
 --sub 1 for last char
 return 64-((#s/2)*4)+1
end

function die_sound()
  chance=flr(rnd(3))
  if chance==0 then
    sfx(sfx_die1)
  elseif chance==1 then
    sfx(sfx_die2)
  else
    sfx(sfx_die3)
  end
end

function mod(a,b)
 val=a
 while val>=b do
   val-=b
 end
 return val
end

function div(a,b)
 i=0
 while a>b do
   i+=1
   a-=b
 end
 return i
end
