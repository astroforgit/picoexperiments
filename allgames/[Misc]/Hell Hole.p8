--game

routines={}

function game_init()
	has_won=dget(0)
	--clear blood from floor
	memset(0x1000,0x0000,128*64)

	can_debug=false
	
	saw_time=860
	saw_timer=saw_time

	demon_kills=0
	close_calls=0
	
	enemies={}
	saws={}
	
	--can start playing
	game_start=false
	
	e_time=0 --spawn counter
	enemy_clock=220 --time between spawn
	fire=false
	side=1 --spawn side
	fire_time=0 --fire timer
 
 _update60=game_update
 _draw=game_draw
 
 saws={}
	
	player_init()
 
 _time=666
 _tstep=0
 
 counter={
 	x=-38,
 	y=0,
 	w=38,
 	h=8,
 	o=1
 }
 local counter_tween=tween(counter,{x=0,y=0},0.8,"back_out")
 
 end_trans=false
 trans_time=0
 wstate=0
end

function game_update()
	tween_update(1/60)
	update_fire()
	
	if not game_start then
		px=player.x
		py=player.y
	end
	
	if game_start then
 	--spawn saws
 	saw_timer-=1
	 if saw_timer<0 and #saws<3 then
  	make_saw()
	  saw_timer=saw_time
 	end
 
 	player_update()
 	update_enemies()
 	update_saws()
 
 	upd_keys()
 
 	--count time
 	if _time>0 and p_alive and game_start then
 		_tstep+=1
 		if _tstep==6 then
  		_tstep=0
  		_time-=1
 		end
 	end
 
 	if _time<10 then
  	_time=0
  	--win game
  	wstate=1
  	game_start=false
  	kill_all()
  	p_f=1
 	end
 end
 
 if wstate==1 then
		if #routines<1 and not end_trans then
 		sfx(11)
 		end_trans=true
 	end 
 end
 
 update_splash()
 
 if not p_alive then
 	die_time-=1
 	if die_time<0 then
 		--lose game
 		wstate=0
 		if not end_trans then
 			sfx(9)
 			end_trans=true
 		end
 	end
 end
 
 if end_trans then
 	trans_time+=0.2
 	if trans_time>20 then
 		end_game(wstate)
 	end
 end
 
	for c in all(routines) do
		if costatus(c)=="suspended" then
			coresume(c)
		elseif costatus(c)=="dead" then
			del(routines,c)
		end
	end
 
 entities=#enemies+#saws+1+#soul_part+#fire_tbl+#splashes
end

function game_draw()
 cls()
 do_shake()
 
 palt(0,false)
 palt(11,true)
 
 if not end_trans then
 	draw_splash()
 end
 
 
 draw_enemies()
 draw_saws()
 player_draw()
 draw_fire()
 draw_gui()
 fade(trans_time)
 palt()
 
 --print("prev dx:"..prev_dx,2,16)
 --print("prev dy:"..prev_dy,2,24)
end

function draw_gui()
 --draw borders
 line(0,0,0,127,8)
 line(0,0,127,0,8)
 line(0,127,127,127,8)
 line(127,127,127,0,8)
	
	draw_counter(counter)
 
 --draw stats
	if can_debug then
		debug()
	end
end

function draw_counter(c)
	
	if overlap(counter,player) then
		fillp(0b101101001011010.1)
	end
	
	rectfill(c.x,c.y,c.x+c.w,c.y+c.h,8)
	
	fillp()
	
	rect(c.x-c.o,c.y-c.o,c.x+c.w+c.o,c.y+c.h+c.o,0)
 
 if _time>=0 then
 	print("time: ".._time,c.x+2,c.y+2,7)
 else
 	print("time: ".."000",c.x+2,c.y+2,7)
 end
end

function debug()
 
 local stats={
 	{"mem:",stat(1)},
 	{"cpu:",stat(2)},
 	{"fps:",stat(7)},
 	{"entities:",entities}
 }
 
 local col=3
 local x=4
 local y=128-(#stats*8)
 local sep=6
 
 for i=1,#stats do
 	local lbl=stats[i][1]
 	local st=stats[i][2]
 	local txt=lbl..st
  print(txt,x,y+(sep*i),col)
 end
 
 print("routines:"..#routines,4,16)
end

