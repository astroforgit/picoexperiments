--enemy

--lookup table for enemy positions
e_dir={}

function get_point()
 local ang=rnd(360)
 local off=rndb(-16,16)
 local x=cos(ang)*off
 local y=sin(ang)*off
 return {x,y}
end

for i=1,100 do
	e_dir[i]=get_point()
end

--enemy speed
e_spd=0.3

--all enemies use same frames
e_spr={5,6}
e_t,e_f,e_s=0,1,8

function make_enemy(x,y)
 local e={}
 e.x,e.y=x,y
 e.w,e.h=8,8
 
 --pick random point
	local p=1+flr(rnd(#e_dir))
	e.point=e_dir[p]
 
 e.flp=false
 
 e.sp=1 --curent sprite
 
 e.atk=false --wait for atack
 e.at=0 --atack timer
 e.atk_sign=false --attack!
 
 add(enemies,e)
end

e_punches={}

function punch(e)
	local p={}
	p.x=e.x
	p.y=e.y
	p.spr={11,12,13,14}
	p.s=p.spr[1]
	p.stp=1
	p.flp=e.flp
	add(e_punches,p)
	--sfx(6)
end

function draw_punches(p)
	spr(p.spr[flr(p.stp)],p.x,p.y,1,1,p.flp)
	p.stp+=0.5
 if p.stp>#p.spr then
  del(e_punches,p)
 end
end

function e_die(e)
	splash(e.x+4,e.y+4,{2})	
 shake=0.6
 demon_kills+=1
 del(enemies,e)
end

function update_enemy(e)
	local at_p={
		x=px,
		y=py,
		w=8,
		h=8
	}
	if p_shoot then
		at_p.x=p_shell_x
		at_p.y=p_shell_y
	end
	
	
	e.flp=e.x>at_p.x
	if not e.atk then
  move_to_player(e)
  e.sp=e_f
 else
 	e.sp=1
  e.at+=1
  local atk_wait=15 --time to wait
  if e.at>atk_wait and p_alive then
   --attack!
   punch(e)
   if e.at>atk_wait+10 then
    e.at=0
    e.atk_sign=false
   	e.atk=false
   	if overlap(e,at_p) then
   		--player dies
					player_die()
   	else
   		close_calls+=1
   	end
   end
  end
 end
	
 if p_shoot then
 	--die
 	if overlap(e,player) and can_hurt then
			e_die(e)
			local s=2+flr(rnd(2))
			sfx(s)
  --kill
  elseif overlap(e,at_p) then
  	e.atk=true
  end
	else 
		if overlap(e,player) then
			e.atk=true
  end
 end
end

function move_to_player(e)
 local dx,dy
 if not p_shoot then
  dx=px+e.point[1]
  dy=py+e.point[2]
 else
  dx=p_shell_x+e.point[1]
  dy=p_shell_y+e.point[2] 
 end
 local x1,y1=dx-e.x,dy-e.y
 local ang=atan2(x1,y1)
 e.x+=cos(ang)*e_spd
 e.y+=sin(ang)*e_spd
end

function draw_enemy(e)
 spr(e_spr[e.sp],e.x,e.y,1,1,e.flp)
 
 --attacking
 if e.atk_sign then
  spr(10,e.x,e.y)
 end
 
 --rect(e.x,e.y,e.x+e.w,e.y+e.h,10)
end

function update_enemies()
 --animate all enemies
 e_t=(e_t+1)%e_s
 if e_t==0 then
  e_f=e_f%#e_spr+1
 end
 
 for i=#enemies,1,-1 do
 	local e=enemies[i]
 	update_enemy(e)
 end
 
 --spawn enemies
 e_time=(e_time+1)%enemy_clock
 if e_time==0 then
 	sfx(5,2)
  side=flr(rnd(4))
  fire=true
  for i=1,8 do
   if(side==0) make_enemy(rnd(128),-8)
   if(side==1) make_enemy(rnd(128),128+8)
   if(side==2) make_enemy(-8,rnd(128))
   if(side==3) make_enemy(128+8,rnd(128))
  end
  enemy_clock-=5
 end
 
 if fire then
  fire_time+=1
  if fire_time>60 then
   fire_time=0
   fire=false
  end
 end
end

function draw_enemies()
 
 for i=#enemies,1,-1 do
 	local e=enemies[i]
 	draw_enemy(e)
 end
 
 if fire then
  start_fire(side)
 end
 
 for i=#e_punches,1,-1 do
 	local p=e_punches[i]
 	draw_punches(p)
 end
end

function kill_all()
	local c=cocreate(function()
		for i=#enemies,1,-1 do
			local e=enemies[i]
			e_die(e)
			local s=2+flr(rnd(2))
			sfx(s)
			for j=1,10 do
				yield()
			end
		end
	end)
	add(routines,c)
end
-->8
--sawblade

s_spd=1 --1
s_sp=7

boxsize=8

function make_saw()
 local s={}
 s.x,s.y=56,56
 s.w,s.h=16,16
 s.a=0

 s.bbox={
 	x=s.x+(s.w-boxsize)/2,
 	y=s.y+(s.h-boxsize)/2,
 	w=boxsize,
 	h=boxsize
 }

	s.dx=0
	s.dy=0
 
 s.go=false
 s.go_time=60
 
 s.blood=false
 s.blcount=0
 add(saws,s)
end

function update_saws()
 for i=#saws,1,-1 do
 	local s=saws[i]
 	update_saw(s)
 end
end

function update_saw(s)
 s.bbox.x=s.x+(s.w-boxsize)/2
 s.bbox.y=s.y+(s.h-boxsize)/2
 
 if s.x<0 or s.x>113 then
  s.dx=-s.dx
  sfx(8)
 end
 
 if s.y<0 or s.y>113 then
  s.dy=-s.dy
  sfx(8)
 end
 
 if s.go then
	 s.x+=s.dx
	 s.y+=s.dy
	 s.a+=8
	else
	 s.go_time-=1
	 if s.go_time<1 then
		 local tox,toy=p_shell_x-s.x,p_shell_y-s.y
		 local ang=atan2(tox,toy)
		 s.dx=cos(ang)*s_spd
		 s.dy=sin(ang)*s_spd 
   s.go=true
   sfx(7)
  end
	end
	
	if not p_shoot then
		if overlap(s.bbox,player) and 
		p_alive and s.go then
			player_die()
			s.blood=true
		end
	else
		if overlap(s.bbox,shell) and 
		p_alive and s.go then
			player_die()
			s.blood=true
		end
	end
	
	if s.blood then
		s.blcount+=1
		splash(s.x+8,s.y+8,{8})
		if s.blcount>60 then
			s.blood=false
		end
	end
end

function draw_saws()
 for i=#saws,1,-1 do
 	local s=saws[i]
 	draw_saw(s)
 end
end

function draw_saw(s)
 pal(6,0)
 palt(11,true)
 palt(0, false)
 spr_r(s_sp,s.x+1,s.y+1,s.a,2,2)
 pal()
 palt(11,true)
 spr_r(s_sp,s.x,s.y,s.a,2,2)
 
 --rect(s.bbox.x,s.bbox.y,s.bbox.x+s.bbox.w,s.bbox.y+s.bbox.h,10)
end


-->8
--side fire

--fire directions
f_r={
1,0 --right
}
f_u={
0,-1 --up
}
f_l={
-1,0 --left
}
f_d={
0,1 --down
}

function create_flame(x,y,d)
	local f={}
	f.x=x+rnd(8)
	f.y=y+rnd(8)
	f.r=12+rnd(4)
	f.col=8
	f.spd=0.4+rnd(1)
	f.d=d
	add(fire_tbl,f)
end

function update_flame(f)
 local dx=f.d[1]*f.spd
 local dy=f.d[2]*f.spd
 
 f.x+=dx
 f.y+=dy
 
 f.r-=0.4
 
 if f.r<0 then
 	del(fire_tbl,f)
 end
end

function draw_flame(f)
	circfill(f.x,f.y,f.r,f.col)
end

function start_fire(side)
 local n=8
 local offset=16
 if side==2 then
  --left
 	for i=1,n do
			create_flame(-offset,rnd(128),f_r)
		end
 elseif side==3 then
  --right
 	for i=1,n do
			create_flame(128+offset,rnd(128),f_l)
		end
 elseif side==0 then
  --up
 	for i=1,n do
			create_flame(rnd(128),-offset,f_d)
		end
 elseif side==1 then
  --down
 	for i=1,n do
			create_flame(rnd(128),128+offset,f_u)
		end
 end
end

function update_fire()
	for i=#fire_tbl,1,-1 do
		local f=fire_tbl[i]
		update_flame(f)
	end
end

function draw_fire()
	for i=#fire_tbl,1,-1 do
		local f=fire_tbl[i]
		draw_flame(f)
	end
end
-->8
--end game

function end_game(w)
 pal()
 _update60=end_update
 _draw=end_draw
 
 fire_time=0
 game_start=false
 
	kill_label={
		x=-80,
		y=38,
		dx=16,
		txt="demon kills:"..demon_kills
	}
 close_label={
 	x=-80,
 	y=54,
 	dx=16,
 	txt="close calls:"..max(0,close_calls-1),
 }
 
 time_label={
 	x=-80,
 	y=70,
 	dx=16,
 	txt="time survived:"..666-_time,
 }
 
 replay_label={
 	x=30,
 	y=200,
 	dy=100,
 	txt="press — to retry!"
 }
 
 if w>0 then
 	over_label={
 		x=30,
 		y=-16,
 		dy=16,
 		txt="you escaped hell!"
 	}
 	dset(0,1)
 else
 	over_label={
 		x=44,
 		y=-16,
 		dy=16,
 		txt="game over!"
 	} 
 end
 
 labels={
 	kill_label,
 	close_label,
 	replay_label,
 	time_label,
 	over_label
 }
 
 local tw_time=1
 
 local t1=tween(kill_label,{x=kill_label.dx},tw_time,"back_out")
 
 local t2=tween(close_label,{x=close_label.dx},tw_time,"back_out")
 t2.delay=0.2
 
 local t3=tween(replay_label,{y=replay_label.dy},tw_time,"back_out")
 t3.delay=0.4
 
 local t4=tween(time_label,{x=time_label.dx},tw_time,"back_out")
 t4.delay=0.6
 	
 local t5=tween(over_label,{y=over_label.dy},tw_time,"back_out")
end

function end_update(w)
 tween_update(1/60)
 fire_time+=1
 
 if fire_time>2 then
 	fire_time=0
 	start_fire(0)
 	start_fire(1)
 	start_fire(2)
 	start_fire(3)
 end
 
 update_fire()
 
 if btnp(Ž) or btnp(—) then
 	game_init()
 end
end

function end_draw()
	cls()
	
	draw_fire()
	
	for i=#labels,1,-1 do
		local l=labels[i]
		if i==#labels then
			outline(l.txt,l.x,l.y,0,8)
		else
			outline(l.txt,l.x,l.y,0,7)
		end
		
	end
end

function hcenter(t)
 return 64-#t*2
end

function write_label(l,v,x,y)
	outline(l,x,y,0,7)
	local valx=x+(#l*4)
	outline(v,valx,y,0,7)
end
