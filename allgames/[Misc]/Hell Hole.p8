--player

function player_init(n)
 --player obj info
 player={
 	x=64-4,
 	y=-16,
 	w=8,
 	h=8
 }
 
 --position
 px,py=player.x,player.y
 
 --visuals
 p_sprite={1,2}
 p_soul=3
 p_shell=4
 p_flp=false
 p_t,p_f,p_s=0,1,8 --tick,frame,step
 
 --movement
 p_acc=1.1
 p_shoot_acc=1.8
 p_fric=0.4
 p_dx,p_dy=0,0
 
 prev_dx=0
 prev_dy=0
 prev_ang=0
 
 --shooting
 p_shoot=false
 can_move=true
 p_shell_x,p_shell_y=0,0
 
 shell={
 	x=p_shell_x,
 	y=p_shell_y,
 	w=8,
 	h=8
 }
 
 can_hurt=false
 
 dx,dy=0,0
 
 p_alive=true

	local start_tween=tween(player,{x=64-4,y=64},0.7,"back_out") 
	start_tween.onend=function()
		sfx(10)
		game_start=true
		shake=1.2
	end
	start_tween.delay=0.5
	
	die_time=120
end

function player_update()
 if p_alive then
 	player_move()
 	player_action()
 
 	--animate player
 	if btn(0) or btn(1) or btn(2) or btn(3) then
  	anim()
 	else
  	p_f=p_sprite[1]
 	end
 
 	if p_shoot then
  	emit_soul(px,py)
 	end
 	foreach(soul_part,update_part)
 end
 
 player.x=px
 player.y=py
 shell.x=p_shell_x
 shell.y=p_shell_y
 
 if overlap(player,shell) then
 	can_hurt=false
 else
 	can_hurt=true
 end
end

function player_draw()
 -- pal(7,10)
 palt(0, false)
 if p_alive then
 	if not p_shoot then
 		if (has_won==1) spr(26,px,py-8)
  	spr(p_sprite[p_f],px,py,1,1,p_flp)
  	--rect(player.x,player.y,player.x+player.w,player.y+player.h,14)
 	else
 		if (has_won==1) spr(26,px,py-8)
 		if (has_won==1) spr(26,p_shell_x,p_shell_y-8)
 		if overlap(player,shell) then
  		fillp(0b101101001011010.1)
  	end
  	spr(p_shell,p_shell_x,p_shell_y)
  	foreach(soul_part,draw_part)
 	end
 end
 fillp()
 pal()
end

--control player
function player_move()

 if can_move then
  control_player()
 else
  move_to_body()
 end
 
 px+=p_dx
 py+=p_dy
 
 p_dx*=p_fric
 p_dy*=p_fric
 
 if game_start then
 	if px<0 then px=0 end
 	if px>120 then px=120 end
 	if py<0 then py=0 end
  if py>120 then py=120 end
 end
end

function control_player()
 local a=0
 if p_shoot then 
  a=p_shoot_acc
 else
  a=p_acc
  p_shell_x=px
  p_shell_y=py
 end
 
 if btn(0) then
  dx=-1
  p_flp=true
 elseif btn(1) then
  dx=1
  p_flp=false
 else
  dx=0
 end
 
 if btn(2) then
  dy=-1
 elseif btn(3) then
  dy=1
 else
  dy=0
 end
 
 local ang=atan2(dx,dy)
 
 if dx~=0 or dy~=0 then
  p_dx=cos(ang)*a
  p_dy=sin(ang)*a
 end
end

function move_to_body()
 --move to player 
 local x1=p_shell_x-px
 local y1=p_shell_y-py
 local ang=atan2(x1,y1)
 
 px+=cos(ang)*4
 py+=sin(ang)*4
 
 if overlap(player,shell) then
  can_move=true
  p_shoot=false
  px=p_shell_x
  py=p_shell_y
  shake=0
 end
end


local has_pressed=false
--shootsoul
function player_action()
 if (is_pressed(—) or is_pressed(Ž)) and can_move then
  p_shell_x=px
  p_shell_y=py
  p_shoot=true
  sfx(0)
  shake=0.6
  
  --push the soul away
--  p_dx=cos(prev_ang)*10
--  p_dy=sin(prev_ang)*10
 end
 if (is_released(—) or is_released(Ž)) and p_shoot then
  can_move=false
  sfx(1)
  has_pressed=false
 end
 
 if btnp(—) or btnp(Ž) then
  if not has_pressed then
	  for i=1,6 do
	   emit_soul_round(px,py)
	  end
  has_pressed=true
  end
 end
end

--animate
function anim()
 p_t=(p_t+1)%p_s
 if p_t==0 then
  p_f=p_f%#p_sprite+1
 end
end

--create particle for the soul
soul_part={}

function emit_soul(x,y)
 local sl={}
 sl.x,sl.y=x+4,y+4
 sl.spd=0.3
 sl.dr=rnd(360)
 sl.r=5
 sl.dep=0.3
 sl.tl=true
 add(soul_part,sl)
end

function emit_soul_round(x,y)
 local sl={}
 sl.x,sl.y=x+4,y+4
 sl.spd=1
 sl.dr=rnd(360)
 sl.r=4
 sl.dep=0.3
 sl.tl=false
 add(soul_part,sl)
end

function update_part(sl)
 if not sl.tl then
 	sl.x+=cos(sl.dr)*sl.spd
 	sl.y+=sin(sl.dr)*sl.spd
 end
 
 sl.r-=sl.dep
 
 if(sl.r<0)del(soul_part,sl)
end

function draw_part(sl)
 circfill(sl.x,sl.y,sl.r,7)
end

function player_die()
 if p_shoot then
 	px=p_shell_x
 	py=p_shell_y
	end
 p_alive=false
 p_shoot=false
 shake=2
 local center_x=px+4
 local center_y=py+4
 for i=1,1+rnd(4) do
 	splash(center_x+rnd(8),center_y+rnd(8),{7,8})
 end
 sfx(10)
end

