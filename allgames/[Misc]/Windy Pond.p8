pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
---------windy pond-------
--------bennett foddy------
fish={}
petals={}
ripples={}
goal={x=29,y=16,t=0,s=7}
segl=2
drag=0.15
curve=0.0
curvepos=0

timeleft=13
framesleft=60
score=0
hiscore=0
btnheld=false

flash=0

heights={14, 11, 5, 6,
          7, 8, 9, 9,
         10,11,11,11,
         10,9, 8, 6}


function _init()
 for i=1,16 do
  add(fish,{
   i=i,x=64,y=104-segl*i,vx=0,
   vy=0,a=0,s=1+flr((i)/3),va=0,
   h=heights[i]
  })
  head=fish[#fish]
 end
 music(0) 
 --save tree art to memory
 savetrees()
 
 for i=1,30 do
  add(petals,{x=0,y=0,alive=false,
  vx=0,vy=0,r=flr(rnd(4))})
 end
 makepetal(15,32)
 makepetal(32,98)
 makepetal(64,64)
 makepetal(80,8)
 makepetal(18,100)
 makepetal(96,24)
 makepetal(8,24)
 makepetal(108,56)
 makepetal(74,44)
 makepetal(44,37)
 
 for i=1,10 do
  add(ripples,{x=0,y=0,l=0,a=false})
 end
end

local s
function _update60()
	framesleft-=1
	if framesleft<=0 then
	 framesleft=60
	 timeleft-=1
	 if timeleft<=0 then
	  timeleft=20
	  if score>hiscore then
	   hiscore=score   
	  end
	  score=0
	  flash=12
	  sfx(2)
	  music(0)
	 end
	end


 for p in all(petals) do
  if p.alive then
  
	  p.x+=p.vx
	  p.y+=p.vy
	  p.vy=mid(-0.02,0.02,p.vy+rnd(0.03))
	  p.vx=mid(-0.02,0.02,p.vx+rnd(0.04)-0.02)
			local magp=mag(p.x-head.x,p.y-head.y)
	  if magp<8 then
    p.vx+=mid(head.vx/(magp+1),-0.4,0.4)
    p.vy+=mid(head.vy/(magp+1),-0.4,0.4)

   end
	  p.vx*=0.99
	  p.vy*=0.99
	  local oob=false
	  if p.y>128 then
	   oob=true
	  elseif p.x<-16 then 
	   oob=true
	  elseif p.x>128 then
	   oob=true
	  end
	  if oob then 
	   p.alive=false
	   makepetal(flr(rnd(96)),-16)
	  end
	 end
 end
 
 if btnp()>0 and not btnheld then
  sfx(0)
 end
 
 oldcurve=curve
 if btn()>0 then
  curvepos=mid(curvepos-0.07,0,1)
  curve=getcurve(curvepos)  
  btnheld=true
 else
  if btnheld then sfx(0) end
  btnheld=false
  curvepos=mid(curvepos+0.07,0,1)
  curve=getcurve(curvepos)  
 end
 mv=mag(head.vx,head.vy)
 
 dcurve=1000*(oldcurve-curve)
 dcurve*=1000*(oldcurve-curve)

 head.vx+=0.03*dcurve*cos(head.a)
 head.vy-=0.03*dcurve*sin(head.a)
 
 
 head.vx-=0.1*head.vx*abs(head.vx)
 head.vy-=0.1*head.vy*abs(head.vy)
 head.x+=head.vx
 head.y+=head.vy
 
 head.va-=5*curve*max(0,mv-0.001)
 head.va-=0.3*head.va
 
 //rotate toward up
 head.va+=0.01*deltaangle(head.a,0.75)
 head.vy+=0.002
 head.a+=0.1*head.va
 
 
 
 local s,n,tx,ty
 for i=#fish-1,1,-1 do
  --just follow the leader
  s=fish[i]
  n=fish[i+1]
  tx=n.x-segl*cos(n.a)
  ty=n.y+segl*sin(n.a)
  s.x=tx
  s.y=ty
  s.a=n.a+(4*(#fish-i)/#fish)*curve
  n.a=s.a-(4*(#fish-i)/#fish)*curve
 end
 
-- for i=1,#fish do
  s=head
  if s.x>120 then s.x=120 s.vx=0
   s.a+=0.02*deltaangle(s.a,0.5)
  elseif s.x<0 then s.x=0 s.vx=0
   s.a+=0.02*deltaangle(s.a,0.0)
  end
  if s.y>114 then s.y=114 s.vy=0
   s.a+=0.02*deltaangle(s.a,0.75)
  elseif s.y<0 then s.y=0 s.vy=0
   s.a+=0.02*deltaangle(s.a,0.25)
  end
-- end

 if overlap(fish[#fish],goal) then
  score+=1
  ripple(goal.x,goal.y)
  goal.x=flr(goal.x+120*1.618)%120
  goal.y=flr(goal.y+112*1.618)%112
  timeleft+=10-min(flr(score/3),8)
  sfx(1) 
 end
 
 goal.y+=0.125
 if goal.y>112 then 
  goal.y=-4 end
 
 for _r in all(ripples) do
  if _r.a==true then
   _r.l+=1
   if _r.l>128 then
    _r.l=0
    _r.a=false
   end
  end
 end

end

_time=0
function _draw()
 _time+=1/60
 
 cls(6)
 rectfill(0,120,128,128,flash)
 
 if flash>0 then
  flash-=1
 end
 clip(0,0,128,120)
 
 drawfish(true)
 drawripples()
 
 --draw goal
 goal.t+=0.1
 o=5+3*sin(goal.t)

 drawgoal(true)
 drawbg(1)
 
 --screen to sprite memory
 memcpy(0x0200,0x6000,0x1fff-0x0200)
 
 pal()
 rectfill(0,0,128,120,1)
 clip(0,0,128,120)
 local px,py
 
	drawfish(false)
	drawgoal(false)

	--draw reflection on top
	palt(1,true)
	
	spr(16,0,0,16,15)

 palt()
 pal()
 
 palt(11,true)
 drawpetals()
 
 clip()
 
 
 
 print("score: "..score,1,121,7)
 print("hi: "..hiscore,51,121,7)
 local t=""
 if timeleft<10 then t=" " end
 print("time: "..t..timeleft,96,121,7)
end 

function overlap(s1,s2)
 if s1.x+8<s2.x then return false
 elseif s1.x>s2.x+8 then return false end

 if s1.y+8<s2.y then return false
 elseif s1.y>s2.y+8 then return false end
 return true
end

function getcurve(t)
 t=mid(t,0,1)
 return 0.024*(t*t*(3-2*t)-0.5)
end
-->8
function savetrees()
 --save 2nd row of sprites to
 --bottom to general ram
 --and map ram
 
 memcpy(0x4300,0x0200,0x0fff)
 memcpy(0x2000,0x1000,0x0fff)
end

function drawbg(pass)
 --copy tree mem
 --to sprite mem
 memcpy(0x0200,0x4300,0x1000)
 memcpy(0x1000,0x2000,0x1000)
	
	pal()
	palt()
	if pass==1 then
	 
  palt(6,true)
  palt(1,false)
  palt(0,false)
  palt(7,false)
 elseif pass==2 then
  
 end

	--spr(16,0,0,16,15)
	for r=0,127 do
  offset=(sin(_time*1-r*0.1))
  
  sspr(0,r+8,128,1,offset,r)
 end 
end

function makepetal(x,y)
 for p in all(petals) do
  if p.alive==false then
   p.alive=true
   p.x=x
   p.y=y
   p.vx=0
   p.vy=0.05
   p.r=flr(rnd(4))
   break
  end
 end
end

function ripple(x,y)
 for i=1,#ripples do
  if not ripples[i].a then
   ripples[i].a=true
   ripples[i].x=x
   ripples[i].y=y
   ripples[i].t=0
  end
 end
end

function drawripples()
 for _r in all(ripples) do
  if _r.a then
   local t=_r.l
   local n=0
   while t>0 and n<5 do
    if t<32 then 
     circ(_r.x,_r.y,t,13)
    end
    t-=5
    n+=1
   end
  end
 end
end

function drawpetals()
 pal(7,13)
 for p in all(petals) do
  if p.alive then
	  if p.r==0 then
	   spr(12,p.x+0,p.y+0,1,1,false,false)
	   spr(13,p.x+8,p.y+0,1,1,false,false)
	   spr(14,p.x+0,p.y+8,1,1,false,false)
	   spr(15,p.x+8,p.y+8,1,1,false,false)
	  elseif p.r==1 then
	   spr(9,p.x+0,p.y+0,1,1,false,false)
	   spr(11,p.x+8,p.y+0,1,1,false,false)
	   spr(8,p.x+0,p.y+8,1,1,false,false)
	   spr(10,p.x+8,p.y+8,1,1,false,false)
	  elseif p.r==2 then
	   spr(14,p.x+0,p.y+0,1,1,false,true)
	   spr(15,p.x+8,p.y+0,1,1,false,true)
	   spr(12,p.x+0,p.y+8,1,1,false,true)
	   spr(13,p.x+8,p.y+8,1,1,false,true)
	  else
	   spr(11,p.x+0,p.y+0,1,1,true,false)
	   spr(9,p.x+8,p.y+0,1,1,true,false)
	   spr(10,p.x+0,p.y+8,1,1,true,false)
	   spr(8,p.x+8,p.y+8,1,1,true,false)
	  end
  end
 
 end
 
end

function drawgoal(palswap)
 if palswap then pal(8,14) end
 
	sspr(56,0,8,8,goal.x-o/2,goal.y,
 o,8)
end

function drawfish(palswap)
 if palswap then
  pal(9,10)
  pal(10,9)
 end
 for s in all(fish) do
  sspr(s.s*8,0,8,8,s.x,s.y-0.5*(s.h-8),8,s.h)
 end
 for i=4,#fish-2 do
  line(fish[i].x+3,fish[i].y+3-0.5*(fish[i].h-8),
   fish[i-1].x+3, fish[i-1].y+3-0.5*(fish[i-1].h-8),10)
 end
 
end

-->8
function lerp(a,b,t)
 return a*(1-t)+b*t end
 
function lerpangle(a,b,t)
 return ((a%1+1)*(1-t) + (b%1+1)*t)%1 end 
 
function dot(v1x,v1y,v2x,v2y)
 return v1x*v2x + v1y*v2y
end

function mag(vx,vy)
 return sqrt(vx*vx+vy*vy) end
 
function deltaangle(a,t)
 r=t%1-a%1
 if r>0.5 then r-=1.0
 elseif r<-0.5 then r+=1.0
 end
 return r
end
 
function nearptonline(
x0,y0,ang,xt,yt)
 local lvx=cos(ang)
 local lvy=sin(ang)
 local vx=xt-x0
 local vy=yt-y0
 local d=(dot(vx,vy,lvx,lvy))
 return x0+lvx*d,y0+lvy*d

end
