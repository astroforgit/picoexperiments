--game

function update_game()

--debug cheaty button
--    if btnp (4) then 
--     player_points += 1   
--     pentascore += 0.4
--     shake=0.8
--     end

------------------------------------------------------------------------
-- ball movement
------------------------------------------------------------------------

    --ball movement
    ball.x += ball.dx
    ball.y += ball.dy

------------------------------------------------------------------------
-- controls - player
------------------------------------------------------------------------

    -- edge bounce
    if player.x < court_left + 1 
    then player.dx = -player.dx  
    end 
    if player.x + player.w > court_right + 1 
    then player.dx = -player.dx  
    end         


    if btn(0)
    and player.x > court_left + 1 then
        player.dx-=player.acc
    end

    if btn(1)
    and player.x + player.w < court_right - 1 then
        player.dx+=player.acc
    end

    --limit left/right speed
    player.dx=mid(-player.max_dx,player.dx,player.max_dx)
    computer.dx=mid(-computer.max_dx,computer.dx,computer.max_dx)

    -- apply friction
    player.dx*=friction

    --apply dx and dy to player position
    player.x+=player.dx
    computer.x+=computer.dx

    -- serve    
    if btnp (—) 
    and served == false 
    then
      if btn(0)
       then        
       ball.dx = rnd(1)-1.15
       end
      if btn(1)
      then
       ball.dx = rnd(1)+0.15
      end
      if not btn(0)
      and not btn(1)
       then
        ball.dx = rnd(0.5)-0.25
       end
      ball.dy = -1.25
      served = true
      sfx(02)
    end



------------------------------------------------------------------------
-- computer controls / ai
------------------------------------------------------------------------

    
    --computer controls
    mid_computer = computer.x + (flr(computer.w/2))

    if ball.dy < 0 then
        if mid_computer > ball.x
        and computer.x > court_left + 1 then
            computer.dx -= computer.acc
        end

        if mid_computer < ball.x
        and computer.x + computer.w < court_right - 1 then
            computer.dx += computer.acc
        end

    else
        if mid_computer > 73 then
            computer.dx -= computer.acc
        end
        if mid_computer < 53 then
            computer.dx += computer.acc
        end
    end

------------------------------------------------------------------------
-- collisions
------------------------------------------------------------------------

    --collide with com
    if ball.dy < 0 -- ball is moving up 
    and ball.y-ball.r+1 <= computer.y+computer.h  -- balls y position, plus radius is greater than computer y pos
    and ball.y-ball.r >= computer.y
    and ball.x+ball.r >= computer.x
    and ball.x-ball.r <= computer.x + computer.w
    then
        ball.dy = -(ball.dy - ball.speedup)
        sfx(0)
        ball.c=computer.c
        ball.c2=computer.c2
        ball.c3=computer.c3
								shake+=0.075
    end

    --collide with player
    if ball.dy > 0
    and ball.y+ball.r-1 >= player.y
    and ball.y+ball.r <= player.y+player.h
    and ball.x+ball.r >= player.x
    and ball.x-ball.r <= player.x+player.w
    then
        --control ball dy if hit and left up or right
        if btn(0) then
            if ball.dx > 0 then --ball moves right
                ball.dx = -ball.dx
                ball.dx -= ball.speedup * 2
            else --ball moves up
                ball.dx -= ball.speedup * 2
            end
        end
        if btn(1) then
            if ball.dx < 0 then --ball left
                ball.dx = -ball.dx
                ball.dx += ball.speedup * 2
            else --ball moves down
                ball.dx += ball.speedup * 2
            end
        end

        --flip ball dx and add speed
        ball.dy = -(ball.dy + ball.speedup)
        ball.c=player.c
        ball.c2=player.c2
        ball.c3=player.c3

        sfx(1)
        if ball.dy <= -2.25
    				or ball.dy >= 1.5
    				then
         shake=0.1
        end
    end


    --collide with court
    if ball.x - ball.r <= court_left + 1
    or ball.x + ball.r >= court_right - 1 then
        ball.dx = -ball.dx
        sfx(2)
     end

   -- score
    if ball.y > court_bottom 
    and player_points%6 >= 1 then
        player_points -= 1
        pentascore -= 0.4 
        shake+=0.8
    end

    if ball.y > court_bottom then
        scored = "player"
        served = false
        sfx(3)
        shake+=0.8
        init_game() --reset game
    end

    if ball.y < court_top then
     player_points += 1
     scored = "computer"
     pentascore += 0.4
     sfx(4)
     shake+=0.8
     init_game() --reset game
    end
    
    -- split score

    if player_points < 7 then
       score_bottom = player_points
       end

    if player_points < 13 
       and player_points > 5 then
        score_left = (player_points-6)
       end

    if player_points > 12 then score_right = (player_points-12) 
       end
------------------------------------------------------------------------
-- difficulty increase
------------------------------------------------------------------------

    if player_points >= 12 then 
    computer.max_dx = computer.max_dx3
    player.max_dx = player.max_dx3
    
    elseif player_points >= 6  then
    computer.max_dx = computer.max_dx2
    player.max_dx = player.max_dx2
    else 
    computer.max_dx = computer.max_dx1
    player.max_dx = player.max_dx1
    end

------------------------------------------------------------------------
-- game over 
------------------------------------------------------------------------

    if player_points == 18 then 
    
      timescore =flr(player_t)
    
     init_gameover()
    end



end

function draw_game()
			
			 doshake()
   
    cls(black)
 

    map(16,0,0,0,16,16)
  --  pal()
    player_t+=one_frame 
    
      -- debug
    if  highscore != 666 then
    print_shadow("“"..flr(player_t/60)..":"..flr(player_t%60),8,6,gray,red)
 			end

    draw_pentagram(30)
				

    draw_pentascore(30)

    
    if served==false then
    ball.x=(player.x+(player.w/2))


    -- centre ball circle
      circ((player.x+(player.w/2)),ball.y,8*cos(player_t)+4,ball.c)
    --  circfill ((player.x+(player.w/2)),ball.y,5*cos(player_t)+3,black)
    end
    
    -- comet
    if ball.dy <= -2.75
    or ball.dy >= 2.0
    then
      for i=0,5 do
--      circfill(ball.x-(2*ball.dx*(rnd(i))),ball.y-(2*ball.dy*(i)),(i),ball.c)
      pset(ball.x-(1.2*ball.dx*(rnd(i))),ball.y-(1.2*ball.dy*(i)),i)
--						pset(ball.x-(rnd(16)-8),ball.y-(rnd(16)-8),ball.c2)
      circfill(ball.x-(1.5*ball.dx*(rnd(i))),ball.y-(1.5*ball.dy*(i)),3-i,ball.c)

      end
--     circ (ball.x,ball.y,ball.r+10,ball.c2)
     ball.c2=ball.c3
     sfx(23)
    end     

------------------------------------------------------------------------
-- draw ball, player, computer
------------------------------------------------------------------------
    -- draw ball
    circfill(ball.x,ball.y,ball.r,ball.c2)
				circ(ball.x,ball.y,ball.r+1,ball.c)
    circ (ball.x-1,ball.y-1,0,ball.c)
  
    -- draw player
    
				spr(014,player.x,player.y,2,1)

    -- draw spoopy eyes

    rectfill(computer.x+4,computer.y+5,computer.x+4,computer.y+5,red)
    rectfill(computer.x+11,computer.y+5,computer.x+11,computer.y+5,red)

    if player_points > 5 then
    rectfill(computer.x+3,computer.y+5,computer.x+4,computer.y+5,red)
    rectfill(computer.x+11,computer.y+5,computer.x+12,computer.y+5,red)
    end
    if player_points > 11 then
    rectfill(computer.x+2,computer.y+4,computer.x+4,computer.y+5,red)
    rectfill(computer.x+11,computer.y+4,computer.x+13,computer.y+5,red)
    end
    
 
    -- draw enemy
			 spr(030,computer.x+8,computer.y+1,2,1)
    spr(030,computer.x-8,computer.y+1,2,1,true)

end




