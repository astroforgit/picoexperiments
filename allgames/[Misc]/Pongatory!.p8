--inits

function _init()
    --first game state
				
				init_logo()
				
--    init_menu()

end

function init_logo()
    _update60=update_logo
    _draw=draw_logo
        music(00)

    

end

function update_logo()
   player_t+=one_frame

   if player_t>=3.9 then init_menu() end
  end

function draw_logo()
   cls(brown)
-- print(player_t,2,2,white)

    -- for i=0,10,0.1 do
    --  circ(64,64,(player_t+i)*50,brown)
    -- end

  print_border_8("hot slice",64-#"hot slice"*2,74,brown,orange)
-- print_border_8("game",64-#"game"*2,83,brown,orange)

  print_border_8("music by gruber",64-#"music by gruber"*2,112,orange,brown)
  print_border_8("@gruber_music",64-#"@gruber_music"*2,120,orange,brown)
 
   



   circfill(64,60,10,brown)
   circ(64,60,10,orange)
   circ(64,60,8,yellow)


   spr(46,56,52,2,2)

   if player_t>=2 then
    for i=0,1,0.1 do
      circfill(64,64,((player_t-4+i)*160),yellow)
      circfill(64,64,((player_t-4+i)*140),orange)
      circfill(64,64,((player_t-4+i)*130),black)
      circfill(64,64,((player_t-4+i)*120),orange)
      circfill(64,64,((player_t-4+i)*110),black)


     end
   end
 
end

function init_menu()
   	
--   	music(00)
   	highscore = dget(0)

   	if  highscore == 0 then
				    highscore=666
				end	
   	
   	
   	
    _update60=update_menu
    _draw=draw_menu
				
    --variables
   	player_t = 0
    timescore = 0 
				pentascore = -0.4 
    --court
    court_left = 7
    court_right = 121
    court_top = 0
    court_bottom = 127

    friction=0.85

    player={
        x = 55,
        y = 116,
        dx = 0,
        dy = 0,
        acc=0.5,
        boost=4,
        max_dx=1.5,
        max_dx1=1.5,
        max_dx2=2,
        max_dx3=2.5,
        c = green,
        c2 = dblue,
        c3 = white,
        w = 16,
        h = 8,
        speed = 1.25,
        speed1 = 1.25,
        speed2 = 1.5,
        speed3 = 1.75
    }

    computer={
        x = 55,
        y = 8,
        dx = 0,
        dy = 0,
        acc = 0.5,
        boost = 4,
        max_dx = 1.5,
        max_dx1 = 1.5,
        max_dx2 = 1.75, 
        max_dx3 = 2, 
        c = red,
        c2 = dblue,
        c3 = yellow,
        w = 16,
        h = 8,
        speed = 1,
        speed1 = 1,
        speed2 = 1.25,
        speed3 = 1.5
    }

    ball={
        x = 64,
        y = ((court_bottom/2)+court_top+1) ,
        c = black,
        c2 = black,
        w = 2,
        dx = 0,
        dy = 0,
        speed = 0.5,
        speedup = 0.2,
        r = 2
    }
    

    served = false

     --sound
    if scored == "player" then
        sfx(3)
    elseif scored == "computer" then
        sfx(4)
    else
    end

    -- reset score

    player_points = 0
    score_bottom = 0 
    score_left = 0
    score_right = 0 

end

function init_game()
				music(6)
    _update60=update_game
    _draw=draw_game
    ball.x=64
    ball.y=110
    served = false    
    ball.dx=0
    ball.dy=0
    ball.c=player.c
    ball.c2=player.c2
    
end

function init_gameover()
				music(10)
    _update60=update_gameover
    _draw=draw_gameover
end

