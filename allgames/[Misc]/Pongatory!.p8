--gameover

function update_gameover()
------------------------------------------------------------------------
-- controls - game over
------------------------------------------------------------------------
  player_t+=one_frame 
    if btnp(—) then
    				if timescore <= highscore	then
    				 highscore = timescore
    				 dset(0, highscore)
    				end

      shake=0.8
      init_menu()
    end
end

function draw_gameover()
    cls(black)
				doshake()
    map(0,0,0,0,16,16)


    draw_pentagram(30)
    draw_pentascore(30)
				
    print_shadow("time “"..flr(timescore/60)..":"..flr(timescore%60),64-#"time “ 123"*2,90,gray,red)
    print_shadow("press —",64-#"press x "*2,115,gray,dblue)

    spr(66,28,(3*sin(player_t/10)+40),9,6)
				
    
end

