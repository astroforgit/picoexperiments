--menu

function update_menu()
------------------------------------------------------------------------
-- controls - menu
------------------------------------------------------------------------
    if btnp(—) then
        player_t = 0 
        init_game()
     		 sfx(02)
        shake=0.8
    end
end

function draw_menu()
    cls(black)
				doshake()

    player_t+=one_frame

    

    map(0,0,0,0,16,16)
 		 

    
    draw_pentagram(45)



--    pal(gray,dblue)
--    pal(red,purple)
--    pal(dgray,black)
    pal(dgray,dblue)
    pal(gray,dblue)
    pal(red,dblue)
--    pal(dgray,dgray)

    spr(160,5,(3*cos(player_t/10)+51),15,4)
    pal()
    spr(160,5,(3*sin(player_t/10)+45),15,4)

				if  highscore != 666 then
        print_shadow("best time",64-#"best time"*2,88,gray,red)
				    print_shadow("“"..flr(highscore/60)..":"..flr(highscore%60),64-#"“01:23"*2,96,gray,red)
				end
    print_shadow("press —",64-#"press x "*2,(1*cos(player_t/5)+115),gray,dblue)

if player_t <=2 then
    circfill(64,64,(128-(player_t)*140),black)
end

end



