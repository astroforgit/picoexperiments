--functions

 function doshake()
  -- this function does the
  -- shaking
  -- first we generate two
  -- random numbers between
  -- -16 and +16
  local shakex=16-rnd(32)
  local shakey=16-rnd(32)
 
  -- then we apply the shake
  -- strength
  shakex*=shake
  shakey*=shake
  
  -- then we move the camera
  -- this means that everything
  -- you draw on the screen
  -- afterwards will be shifted
  -- by that many pixels
  camera(shakex,shakey)
  
  -- finally, fade out the shake
  -- reset to 0 when very low
  shake = shake*0.95
  if (shake<0.05) shake=0
 end


function draw_pentagram(size)
 
 
  local x,y=64,64
  local s=size -- radius
  local xc=x-1
  circfill (xc,y,s+2,black)
  color(dblue)
  circ(xc-1,y,s)
  circ(xc+1,y,s)
  circ(xc,y-1,s)
  circ(xc,y+1,s)
--  circ(xc,y+2,s)
 
  for i=0,2,2/5 do
   local t=player_t/120+i -- rotate
   local x1,y1=x-s*cos(t),y+s*sin(t)
   local x2,y2=x-s*cos(t+0.60),y+s*sin(t+0.60)
-- local x2,y2=x+s*cos(t+5/8),y+s*sin(t+5/8)
   
   line(x1+1,y1,x2+1,y2,dblue)
   line(x1-1,y1,x2-1,y2,dblue)
   line(x1,y1+1,x2,y2+1,dblue)
   line(x1,y1-1,x2,y2-1,dblue)
   line(x1,y1,x2,y2,black)   

  end
  
  circ(xc,y,s,black)


end

function draw_pentascore(size)
 -- draw big score rings

  circ(xc,y,s,black)


  
  --outer ring bg
  circ(63,64,30+14,black)
  -- mid ring bg
  circ(63,64,30+7,black)

  -- bottom score bg
    circfill(64,103,7,black)
    circ(64,103,6,black)
    circ(64,103,5,dblue)
    circfill(64,103,4,black)

  --left score bg
    circfill(25,64,7,black)
    circ(25,64,6,black)
    circ(25,64,5,dblue)
    circfill(25,64,4,black)

  --right score bg
    circfill(101,64,7,black)
    circ(101,64,6,black)
    circ(101,64,5,dblue)
    circfill(101,64,4,black)
  
  -- ball shadow
  circfill(ball.x,ball.y+ball.dy-((ball.y-player.y)/15),ball.r+1,dblue)    

 
  local x,y=64,64
  local s=size -- radius
  local xc=x-1

 
  for i=0,pentascore,2/5 do
   local t=player_t/120+i -- rotate
   local x1,y1=x-s*cos(t),y+s*sin(t)
   local x2,y2=x-s*cos(t+0.60),y+s*sin(t+0.60)
   
   line(x1+1,y1,x2+1,y2,dblue)
   line(x1-1,y1,x2-1,y2,dblue)
   line(x1,y1+1,x2,y2+1,dblue)
   line(x1,y1-1,x2,y2-1,dblue)
   line(x1,y1,x2,y2,red)   

  end
  -- reset pentascore
  if pentascore >= 2.2 then pentascore = 0 end

  
  -- center ring
  if player_points > 5 then
  circ(xc,y,s,red)
  
  end

  -- outer ring score

  if player_points > 11 then
  circ(xc,y,s+14,red)
  end
  -- mid ring

  if player_points > 17 then
  circ(xc,y,s+7,red)
  end

  -- bottom score

    if player_points >= 1 
     then
     print(score_bottom,63,101,computer.c)
    end
    
    if player_points >= 6 
    then
     circfill(64,103,6,dblue)
     circfill(64,103,5,computer.c)
     circfill(64,103,4,dblue)
     print(score_bottom,63,101,computer.c)
     
    end

    --left score

    if player_points >= 7 
     then
     print(score_left,24,62,computer.c)
    end


    if player_points >=12
    then
     circfill(25,64,6,dblue)
     circfill(25,64,5,computer.c)
     circfill(25,64,4,dblue)
     print(score_left,24,62,computer.c)
    end

    --right score
    
    if player_points >= 13 
     then
     print(score_right,100,62,computer.c)
    end
    
    if player_points >=18
    then
     circfill(101,64,6,dblue)
     circfill(101,64,5,computer.c)
     circfill(101,64,4,dblue)
     print(score_right,100,62,computer.c)
    end

    


end

------------------------------------------------------------------------
-- print string with a shadow
-- constant one pixel south shadow
------------------------------------------------------------------------

function print_shadow(string, x, y, col, bcol)
 print(string, x, y + 1, bcol)
 print(string, x, y, col)
end

------------------------------------------------------------------------
-- print string with an outline
-- originally by cbmakes
-- 4-direction outline
------------------------------------------------------------------------

function print_border(string, x, y, col, bcol)
 for d = -1, 1, 2 do
  print(string, x + d, y, bcol)
  print(string, x, y + d, bcol)
 end
 print(string, x, y, col)
end

------------------------------------------------------------------------
-- 8-direction outline
------------------------------------------------------------------------
function print_border_8(string, x, y, col, bcol)
 for dy = -1, 1 do
  for dx = -1, 1 do
   print(string, x + dx, y + dy, bcol)
  end
 end
 print(string, x, y, col)
end


