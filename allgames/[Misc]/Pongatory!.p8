version 18
__lua__
-- pongatory 
-- by hot slice

cartdata("hotslice_pong_1")

-- variables
  one_frame=1/60
  player_t=0
  
--shake
		shake=0

--timescore
		timescore=0
		highscore=0
		

  --- colours
  black = 0
  dblue = 1
  purple = 2
  dgreen = 3
  brown = 4
  dgray = 5
  gray = 6
  white = 7
  red = 8
  orange = 9
  yellow = 10
  green = 11
  blue = 12
  indigo = 13
  pink = 14
  peach = 15 

  -- game settings
  title = "pongatory"

  player_points = 0 
  computer_points = 0 
  scored = ""


