pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- p-tapper v1.0
-- 2016/2017 by claudio cipolla
function create_cust(x)
 -- typ, state, lane, x, knockback
 return {flr(rnd(diffcust)),0,flr(rnd(4)),x,0}
end

function title()
 gameruns=false
 cls()
 map(16,2,4,4,15,2)
 map(16,4,55,22,2,1)
 map(16,5,43,30,5,2)
 spr(131,10,22,3,3)
 spr(131,93,22,3,3)
 spr(128,10,22,3,3)
 spr(128,93,22,3,3)
 color(6)
 cursor(8,48)
 print("           v1.0")
 if instr_page==0 then
  cursor(43,60)
  print("difficulty")
  color(7)
  print("    ”")
  for i = 1,4 do
   if diffnames[i]==diffnames[difficulty+1] then
    color(7)
   else
    color(5)
   end
   cursor(43,67+i*6)
   print(diffnames[i])
  end
  color(7)
  cursor(43,98)
  print("    ƒ")
  color(6)
  cursor(8,109)
  print("press — to start")
  print("press Ž for instructions")
 elseif instr_page==1 then
  cursor(8,60)
  print("”/ƒ to move the bartender")
  print()
  print("Ž to pour a drink")
  print("")
  print("don't let any glasses crash")
  print("or you lose a life.")
  print("")
  print("also, don't slack off!")
  cursor(8,115)
  print("press Ž for page 2")
 elseif instr_page==2 then
  cursor(8,60)
  print("when the barrel is almost")
  print("empty, order a full one by")
  print("pressing — next to it.")
  print("")
  print("you can press — next to the")
  print("bell to send the waitress to")
  print("help you collect the glasses.")
  cursor(8,115)
  print("press Ž to return to title")
 end
 waittitle=true
end

function instructions()
 color(6)
 print("”/ƒ moves the bartender.")
 print("Ž taps a drink.")
 print("— uses the items on the right:")
 print("barrel:")
 print(" - order a new full barrel")
 print("bell:")
 print(" - send the waitress")
 print(" - don't let any glasses crash!")
 print("")
end

function gameover()
 music(-1)
 map(16,8,25,43,8,5)
 waitgameover=true
end

function _init()
 difficulty=0
 diffnames={"easy","normal","hard","impossible"}
 instr_page=0
 waitgameover=false
 waittitle=false
 waitfornextlevel=false
 gameruns=false
 title()
 kbr=1.5 -- knockbackrate (pixel per fill)
 kbs=2 -- knockbackspeed
 gbs=0.3 -- glassbackspeed
 gbr=5 -- glassbackrotate
 drinktime=5
 diffcust=8
 speed=5
 bfact=8 -- barrel multiplier
 bbase=16 -- don't change!
 barrelspeed=2
 puddles={{{2,3},{7,6},{3,11}},{{6,3},{8,14}}}
 maxglasses=10
 glassxstart=79
 glassspeed=3
 glassmaxfull=20 -- glass full at
 glassfillspeed=1
 grd=3 -- glass rotate delay
 loselifedelay=60
 waitressspeed=2
 endleveldelay=60
 title()
end

function startgame()
 score=0
 lives=3
 level=1
 waiting_cust=0
 endlevelwait=0
 startlevel(level)
end

function startlevel(l)
 reset()
 waiting_cust=(1+difficulty)*l+1+difficulty
 for i=1,l+difficulty do
  add(cust,create_cust((i-1)*2))
  waiting_cust-=1
 end
 endlevelwait=0
 readycust(l)
 gameruns=true
 music((2*((l-1)%3)))
end

function readycust(l)
 nextcust=min(flr(rnd(500)/(flr(rnd(flr(l/2)))+1)),l*30)
end

function reset()
 tapping=false
 delay=0
 loselive=false
 homerun=false
 timer=0
 ppos=0
 pstate=0
 barrel=bbase*bfact
 boffset=0
 orderbarrel=false
 updown=false
 glassfull=0 -- current glass
 glasses=maxglasses
 orderglasses=false
 cust={} -- customers
 glass={} -- glasses
 oldglass={} -- empty glasses
 waitress={false,0,0,0} -- working,state,lane,x
 collected_glasses=0
end

function pcust(c)
 if c[2]<2 then
  spr(64+2*c[1]+c[2],c[4],32*c[3],1,2)
 else
  spr(96+2*c[1]+flr((c[2]-2)/drinktime),c[4],32*c[3],1,2)
 end
end

function pwaitress()
 if waitress[1] then
  if waitress[3]==0 or waitress[3]==2 then
   flipher=true
  else
   flipher=false
  end
  clip(0,0,104,128)
  spr(136+waitress[2],waitress[4],15+32*waitress[3],1,4,flipher)
  clip()
 end
end

function update_game()
 for i in all(cust) do
  if (i[2]>1) and (i[5]<=0) then
   -- customer is drinking
   i[2]+=1
   if i[2]>2*drinktime+1 then
    i[2]=0
    makeoldglass(i[4],i[3])
   end
  else
   if (i[2]==0) then i[2]=1
   elseif i[2]==1 then i[2]=0 end
   if i[2]<2 then i[4]+=1 end
  end
 end
end

function clearglasslist()
 newlist={}
 for i = 1,#glass do
  if not glass[i][5] then add(newlist,glass[i]) end
 end
 glass = newlist
end

function clearoldglasslist()
 newlist={}
 for i = 1,#oldglass do
  if not oldglass[i][3] then add(newlist,oldglass[i]) end
 end
 oldglass = newlist
end

function clearcustlist()
 newlist={}
 if #cust>0 then
  for i in all(cust) do
   if i[4]>-8 then
    add(newlist,i)
   else
    makeoldglass(0,i[3])
    givescore(5*level)
   end
  end
  cust = newlist
 end
end

function sendglass()
 glasses-=1
 add(glass,{0,ppos,glassxstart,false,false,glassfull})
 glassfull=0
 sfx(14)
end

function makeoldglass(x,lane)
 add(oldglass,{x,lane,false,0,0}) -- x,lane,collected,state,fallingstate
end

function gameloop()
 if (waiting_cust>0 or #cust>0) then
 -- main loop
  if not loselife then
   -- check for homerun
   for i in all(cust) do
    if i[4]>75 then
     loselife=true
     homerun=true
     lives-=1
    end
   end
   -- advance waiting customers
   if waiting_cust>0 then
    nextcust-=1
    -- speed up if no customers
    if #cust==0 then
     nextcust-=4
    end
    if nextcust<1 then
     add(cust,create_cust(0))
     waiting_cust-=1
     if waiting_cust>0 then readycust(level) end
    end
   end
   -- move waitress --
   if waitress[1] then
    waitress[2]+=1
    if waitress[2]>3 then waitress[2]=0 end
    if waitress[3]==1 or waitress[3]==3 then
     waitress[4]-=waitressspeed
     if waitress[4]==-8 then waitress[3]-=1 end
    else
     waitress[4]+=waitressspeed
     if waitress[4]==104 then
      glasses+=collected_glasses
      collected_glasses=0
      if waitress[3]==2 then
       waitress[3]-=1
      else
       waitress[1]=false
      end
     end
    end
    for i in all(oldglass) do
     if abs(i[1]-waitress[4])<2 and i[2]==waitress[3] then
      i[3]=true
      collected_glasses+=1
     end
    end
   end
   -- check for glasses arriving
   for i in all(glass) do
    xpos=i[3]
    for j in all(cust) do
     if (j[4]>-1) and (abs(xpos-j[4])<3) and (j[2]<2) and (j[3]==i[2]) and (not i[5]) then
     -- customer takes glass
     givescore(level)
     j[2]=2 -- set customer to drinking
     i[5]=true -- mark glass for deletion
     j[5]=flr(i[6]*kbr) -- start knockback
     end
    end
   end
   -- knockback customers
   for i in all(cust) do
    if i[5]>0 then
     i[4]-=kbs
     i[5]-=kbs
    end
   end
   -- update customer rhythm
   timer+=1
   if timer==speed then
    timer=0
    update_game()
   end
   -- move empty glasses
   for i in all(oldglass) do
    i[4]+=1
    if i[4]>3*gbr then
     i[4]=0
    end
    i[1]+=gbs
    if i[1]>82 then
     if ppos==i[2] then
     -- collected glass
     givescore(1)
     i[3]=true
     glasses+=1
     else
      -- glass drops
      i[5]=1
      glassdrop=true
      loselife=true
      lives-=1
     end
    end
   end
   -- tapping?
   if ((glasses>0) or (pstate==1)) and (btn(4) and ((barrel>0) or tapping) and (not orderbarrel)) then
    pstate=1
    tapping = true
    -- glass not full yet?
    if (glassfull<glassmaxfull) and (barrel>0) then
     barrel-=1
     glassfull+=glassfillspeed
    end
   else pstate=0 end
   -- tapping finished?
   if (pstate==0) and tapping then
    tapping=false
    sendglass()
   end
   -- moving?
   if not tapping and not updown and (btn(2) or btn(3)) then
    updown=true
    if btn(2) and ppos >0 then ppos-=1 end
    if btn(3) and ppos <3 then ppos+=1 end
   elseif not (btn(2) or btn(3)) then updown=false end
   -- actions
   if (not orderdown) and btn(5) then
    orderdown=true
    -- order barrel?
    if (ppos==0) and (barrel<flr(bfact*bbase/4)) and (not orderbarrel) then
     orderbarrel=true
    end
    -- call waitress?
    if (ppos==3) and (not waitress[1]) then
     waitress[1]=true
     waitress[2]=0
     waitress[3]=3
     waitress[4]=104
    end 
   elseif not btn(5) then orderdown=false end
   -- ordering barrel?
   if orderbarrel then
    if (barrel<bbase*bfact) then
     boffset+=barrelspeed
    else boffset-=barrelspeed end
    if (boffset==24) then barrel=bbase*bfact end
    if (boffset==0) then orderbarrel=false end
   end 
   -- move glasses
   for i in all(glass) do
    -- crashes?
    if i[3]<-2 then
     -- crashglass
     sfx(13)
     i[4]=true
     i[3]=0
     loselife=true
     lives-=1
     i[1]=0 -- crash animation frame
    else
     -- uncrashed moves
     i[1]+=1
     if (i[1]>6*grd) then i[1]=0 end
     i[3]-=glassspeed
    end
   end 
  else
   music(-1)
   if not (homerun or glassdrop) then
    -- crash! lose a live
    for i in all(glass) do
     if i[4] then
      i[1]+=1
     end
     if i[1]>5*grd then
      i[1]=5*grd
      delay+=1
     end
    end
   elseif not glassdrop then
    -- homerun!
    delay+=1
   else
    -- glassdrop
    for i in all(oldglass) do
     if i[5]>0 then
      i[5]+=1
     end
    end
    delay+=1
   end
   if delay>=loselifedelay then
    glassdrop=false
    loselife=false
    if lives>0 then
     startlevel(level)
    else
     gameruns=false
     gameover()
    end
   end
  end
  clearglasslist()
  clearcustlist()
  clearoldglasslist()
 end
end

function _draw()
 if gameruns then
 cls()
 map(0,0,0,0,16,16)
 for typ = 1,2 do
  for pud in all(puddles[typ]) do
   spr(1+typ*16,pud[1]*8,pud[2]*8)
  end
 end
 for i = 1,4 do
  spr(34,12*8,(-2+i*4)*8)
 end
 -- customers a
 for i in all(cust) do
  if i[3]<=waitress[3] then
   pcust(i)
  end
 end
 -- barrel
 spr(8,104+flr(boffset),8,3,4)
 if barrel<bfact*bbase then rectfill(110+flr(boffset),16,121+boffset,31-flr(barrel/bfact),0) end
 -- glasses
 for i in all(glass) do
  if not i[4] then
   if i[1]<4*grd then
    spr(36+flr(i[1]/grd),i[3],17+i[2]*32)
   else
    if flr(i[1]/(2*grd))==i[1]/(2*grd) then
     spr(35,i[3],17+i[2]*32)
    else
     spr(49,i[3],17+i[2]*32)
    end
   end  
  else
   spr(50+flr(i[1]/grd),i[3],17+i[2]*32)
  end
 end
 if glasses>0 then
  spr(131,104,48,3,3)
  if glassfull<glassmaxfull then
   rectfill(106,51,122,51+(glassmaxfull-glassfull),0)
  end
  spr(128,104,48,3,3)
 end
 for i=0,glasses-2 do
  spr(140,(13+i%3)*8,76+flr(i/3)*9)
 end
 -- waitress a
 if waitress[3]<ppos then pwaitress() end
 -- playersprite
 if loselife then
  spr(134,11*8-2,5+ppos*32,2,4)
 else
  spr(11+pstate*2,11*8-2+pstate,5+ppos*32,2,4)
 end
 --waitress b
 if waitress[3]>=ppos then pwaitress() end
 -- customers b
 for i in all(cust) do
  if i[3]>waitress[3] then
   pcust(i)
  end
 end
 -- oldglasses
 for i in all(oldglass) do
  if i[5]==0 then
   if flr(i[4]/gbr)<4 then
    spr(140+flr(i[4]/gbr),flr(i[1]),i[2]*32+13)
   else
    spr(146-flr(i[4]/gbr),flr(i[1]),i[2]*32+13)
   end
  else
   -- glass is falling
   if i[5]<12 then
    spr(156,87,i[2]*32+16+flr(i[5]/1.5))
   elseif i[5]<13 then
    spr(156+(flr((i[5]-11)/3)),87,i[2]*32+22+flr((i[5]-11)/2))
   elseif i[5]<21 then
    if i[5]==13 then sfx(13) end
    spr(156+(flr((i[5]-11)/3)),87,i[2]*32+25)
   end
  end
 end
 -- lives
 for i = 1,lives do
  spr(48,96+8*i,0)
 end
 showscore(score)
 end
end

function strlen(n)
 i=1
 p=10
 while n>p do
  i+=1
  p*=10
 end
 return(i)
end

function showscore(s)
 cursor(104-4*strlen(s),0)
 print(s)
end

function _update()

 if gameruns then
  if #cust==0 and waiting_cust==0 then
   gameruns=false
   waitfornextlevel=true
  end
  gameloop()
 end
 
 if waittitle then
  if btnp(3) and instr_page==0 then
   difficulty+=1
   if difficulty>3 then difficulty=3 end
   title()
  end
  if btnp(2) and instr_page==0 then
   difficulty-=1
   if difficulty<0 then difficulty=0 end
   title()
  end
  if btnp(5) and instr_page==0 then
   waittitle=false
   startgame()
  end
  if btnp(4) then
   instr_page+=1
   if instr_page>2 then
    instr_page=0
   end
   title()
  end
 end

 if waitgameover then
  if btnp(4) or btnp(5) then
   waitgameover=false
   title()
  end
 end

 if waitfornextlevel then
  music(-1)
  endlevelwait+=1
  if endlevelwait>=endleveldelay then
   waitfornextlevel=false
   endlevelwait=0
   level+=1
   startlevel(level)
  end 
 end
end

function givescore(s)
 score+=s*(difficulty+1)
end
