pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
--swatel barf's shufflepuck
--(c)2020 lostcadesoft
--   by bgelais

home=0
visitor=0
ptime=60

function _init()
intro_init()
end

function score_draw()
print("swatel",0,1,7)
print("kakwrs",105,1,7)
hs=sub("0"..home,-2)
vs=sub("0"..visitor,-2)
ps=sub("0"..ptime,-2)
spr(48+tonum(sub(hs,1,1)),24,0)
spr(48+tonum(sub(hs,2,2)),32,0)
pal(11,8)
spr(48+tonum(sub(vs,1,1)),87,0)
spr(48+tonum(sub(vs,2,2)),95,0)
pal(11,9)
spr(48+tonum(sub(ps,1,1)),56,0)
spr(48+tonum(sub(ps,2,2)),64,0)
pal()
end


-->8
--player / puck / kakweers

function swatel_update()
if (btn(‹)) swatel.x-=2 rod.x-=2
if (btn(‘)) swatel.x+=2 rod.x+=2
swatel.x=mid(41,swatel.x,86)
rod.x=mid(8,rod.x,120)
rod.y=mid(16,rod.y,111)
end

function puck_update()
puck.x+=puck.xd
puck.y+=puck.yd
if (puck_col(rod)) sfx(1) puck.yd=-1
if (puck_col(molson)) sfx(3) puck.yd=1
if (puck_col(swatel)) sfx(1) puck.yd=-1
if (puck_col(maple)) sfx(2) puck.yd=1
if (puck.y<=16 and not puck_goal()) sfx(4) puck.yd=1
if (puck.y<=16 and puck_goal()) goal=true home+=1 homegoal_init()
if (puck.y>=111 and not puck_goal()) sfx(4) puck.yd=-1
if (puck.y>=111 and puck_goal()) goal=true visitor+=1 visigoal_init()
if (puck.x<=8) sfx(4) puck.xd=1
if (puck.x>=120) sfx(4) puck.xd=-1
end

--puck--

function puck_goal()
if puck.x==mid(41,puck.x,86)
then return true end
end

function puck_col(o)
 if abs(o.x-puck.x)<=5
 and abs(o.y-puck.y)<=5
 then 
 puck.xd=puck.x-o.x
 if (o.x==mid(puck.x-4,puck.x,puck.x+4)) puck.xd=0
 return true end
end

--kakweers--

function kak_update()
if (puck.x<maple.x) maple.x-=rnd(2) molson.x-=rnd(2)
if (puck.x>maple.x) maple.x+=rnd(2) molson.x+=rnd(2)
molson.x=mid(41,molson.x,86)
maple.x=mid(8,maple.x,120)
end
-->8
--inits

function game_init()
goal=false
swatel={x=64,y=108}
rod={x=64,y=85}
maple={x=64,y=45}
molson={x=64,y=20}
puck={x=64,y=64,
xd=1,yd=1}
if (rnd(1)<.5) puck.yd=-1

for i=40,0,-1 do
game_draw()
circfill(64,68,i,5)
circfill(64,64,i,6)
flip() end
sfx(4)
_update60=game_update
_draw=game_draw
end

function title_init()
timeout=time()+10
_update60=title_update
_draw=title_draw
end

function intro_init()
timeout=time()+12
t=0
_update60=intro_update
_draw=intro_draw
end


function homegoal_init()
sfx(5)
timeout=time()+3
_update60=homegoal_update
_draw=homegoal_draw
end

function visigoal_init()
sfx(5)
timeout=time()+3
_update60=visigoal_update
_draw=visigoal_draw
end

function over_init()
sfx(6)
print("time out!",46,64,7)
for t=1,120 do flip() end
timeout=time()+5
_update60=over_update
_draw=over_draw
end


-->8
--updates

function game_update()
swatel_update()
if (not goal) puck_update()
if (not goal) kak_update()
if time()%1==0 and not goal then 
ptime-=1
ptime=max(0,ptime) end
if (ptime==0) over_init()
end

function title_update()
if btnp(Ž) or btnp(—) then
home=0
visitor=0
ptime=60
game_init() end
if (time()>=timeout) intro_init()
end

function intro_update()
if (time()>=timeout) title_init()
if (btnp(—) or btnp(Ž)) title_init()
t=t+1
end

function homegoal_update()
if (time()>=timeout) game_init()
end

function visigoal_update()
if (time()>=timeout) game_init()
end

function over_update()
if time()>=timeout and home!=visitor 
then title_init() end
if time()>=timeout and home==visitor
then ptime=60 game_init() end
end

-->8
--draws

function game_draw()
cls()
line(0,64,127,64,1)
circfill(64,64,17,0)
circ(64,64,14,1)
circ(64,64,6,8)
map()
spr(1,swatel.x-4,swatel.y-4)
spr(2,rod.x-4,rod.y-4)
spr(3,maple.x-4,maple.y-4)
spr(4,molson.x-4,molson.y-4)
if (not goal) spr(5,puck.x-4,puck.y-4)
score_draw()
if (home>=visitor+2) print("digital advantage to swatel!",0,121,7)
if (visitor>=home+2) print("digital advantage to kakweers!",0,121,7)
end

function title_draw()
cls()
map()
score_draw()
spr(64,32,26,4,4)
for i=50,46,-1 do
spr(192,16,i,13,4) end
print("2020 lostcadesoft by bgelais",8,121,9)
if (time()%1<=.5) print("Ž/— to start",40,90,7)
end

function intro_draw()
cls()
color(7)
print(sub([[
swatel barf team (player)

swatel barf (goaler)
leader of the team and
founder of this league.

rod drigg (striker)
trailor hot fan and
fast solid strike.

        ---  v s ---
             
             the kakweers
             
             molson (goaler)
             leader of canadian
             beer goodness.
             
             maple (striker)
             leader of sausage
             brand strikers.
]],1,t),0,0,7)
spr(64,100,0,4,4) 
spr(68,96,26,4,4)
spr(72,0,70,4,4) 
spr(76,8,90,4,4)

end

function over_draw()
cls()

x=4 y=46
if home==visitor then
spr(64,x+0,y,4,4)
spr(167,x+32,y+8,7,2)
spr(72,x+88,y,4,4)
print("extra gameplay!",40,100,rnd(15))
elseif home>visitor then
spr(64,x+0,y,4,4)
spr(135,x+32,y+8,7,2)
spr(68,x+88,y,4,4)
print("game over",48,100,7)
elseif home<visitor then
spr(72,x+0,y,4,4)
spr(135,x+32,y+8,7,2)
spr(76,x+88,y,4,4)
print("game over",48,100,7)
 end
end

function homegoal_draw()
cls()
game_draw()
x=4 y=46
spr(64,x+0,y,4,4)
spr(128,x+34+rnd(2),y+rnd(2),7,3)
spr(68,x+88,y,4,4)
end

function visigoal_draw()
cls()
game_draw()
x=4 y=46
spr(72,x+0,y,4,4)
spr(128,x+34+rnd(2),y+rnd(2),7,3)
spr(76,x+88,y,4,4)
end
