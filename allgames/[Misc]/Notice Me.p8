pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
steps = 0
start = true
ending = false
timeout = false
win = false

-- make actor
function make_actor(x,y,dx,inr)
 a={}
 a.x = x
 a.y = y
 a.dx = dx
 a.dy = 0
 a.spr = 16
 a.frame = 0
 a.inertia = inr
 a.inertia_y = 0.95
 a.frames=2
 a.scd = false

 a.w = 0.4
 a.h = 0.4
 
 add(actor,a)
 
 return a
end

-- move actor
-- falling objects move twice
-- but that's okay i guess
-- (it works anyways)
function move_actor(a)
 -- scored objects stay on table
 if (a.scd) == false then
  a.x += a.dx
  if (a.x < 1.4) then
   a.x = 1.4
   a.dx = abs(a.dx)
  end
  if (a.x > 13) then
   a.x = 12.7
   a.dx = -abs(a.dx)
   if (a == pl) make_obj(score,nxt)
  end
 end
 -- inertia 
 a.dx *= a.inertia
 a.dy *= a.inertia_y
 
 a.frame += abs(a.dx) * 4
 a.frame += abs(a.dy) * 4
 a.frame %= a.frames

end
 
function control_player(pl)
 -- button presses accelerate
 accel = 0.1
 if (btn(0)) pl.dx -= accel 
 if (btn(1)) pl.dx += accel 
-- if (btnp(4)) score += 1
end

-- motion gravity sfx for objs
function move_obj(a)
 if ((a.scd == false) and a != pl and a != want) then
  if (abs(a.dx) < 0.05) a.dx *= abs(0.05/a.dx)
  a.x += a.dx
  if (a.scd == false and (a.x > pl.x-1.0) and (a.x < pl.x+1.0) and (a.y > pl.y-1.2)and (a.y < pl.y - 0.8)) then
   a.dy = - a.dy
   sfx (2)
  end
  if (a.scd == false) then
   a.y += a.dy
   a.dy += gravity
  end
  -- score object
  if (a.x<3.5 and a.y>8.5 and a.y<9.2 and a.dy>=0) then
   if (a.scd == false) score+=1
   a.scd = true
   a.y = 8.55
   sfx (1)
   obj_t = flr(rnd(11))
   if (obj_t == 0) nxt = 19
   if (obj_t == 1) nxt = 33
   if (obj_t == 2) nxt = 34
   if (obj_t == 3) nxt = 35
   if (obj_t == 4) nxt = 36
   if (obj_t == 5) nxt = 37
   if (obj_t == 6) nxt = 49
   if (obj_t == 7) nxt = 50
   if (obj_t == 8) nxt = 51
   if (obj_t == 9) nxt = 52
   if (obj_t == 10) nxt = 53
   want.spr = nxt
  end
  -- object hits floor game over
  if (a.y > 10.75) then
   a.spr = 0
   if (ending == false) then
    go_step = 0 + steps
    sfx (0)
   end
   ending = true
  end
 end
end

-- make new falling object
-- random sprites
function make_obj(score,nxt)
 sfx (3)
 if (win == true) then
  obj_t = flr(rnd(11))
  if (obj_t == 0) nxt = 19
  if (obj_t == 1) nxt = 33
  if (obj_t == 2) nxt = 34
  if (obj_t == 3) nxt = 35
  if (obj_t == 4) nxt = 36
  if (obj_t == 5) nxt = 37
  if (obj_t == 6) nxt = 49
  if (obj_t == 7) nxt = 50
  if (obj_t == 8) nxt = 51
  if (obj_t == 9) nxt = 52
  if (obj_t == 10) nxt = 53
 end
 trajectory = flr(rnd(10))
 if (trajectory == 0) then
  oa = make_actor(13,2,-abs(pl.dx)/4,0.95)
  oa.spr = nxt
 elseif (trajectory == 1) then
  ob = make_actor(13,4,-abs(pl.dx)/4,0.95)
  ob.spr = nxt
 elseif (trajectory == 2) then
  oc = make_actor(13,1,-abs(pl.dx)/4,0.95)
  oc.spr = nxt
 elseif (trajectory == 3) then
  od = make_actor(13,3.25,-abs(pl.dx)/4,0.95)
  od.spr = nxt
 elseif (trajectory == 4) then
  oe = make_actor(13,1.5,-abs(pl.dx)/4,0.95)
  oe.spr = nxt
 elseif (trajectory == 5) then
  oe = make_actor(13,2.6,-abs(pl.dx)/4,0.95)
  oe.spr = nxt
 elseif (trajectory == 6) then
  oe = make_actor(13,3.8,-abs(pl.dx)/4,0.95)
  oe.spr = nxt
 elseif (trajectory == 7) then
  oe = make_actor(13,2.3,-abs(pl.dx)/4,0.95)
  oe.spr = nxt
 elseif (trajectory == 8) then
  oe = make_actor(13,3.3,-abs(pl.dx)/4,0.95)
  oe.spr = nxt
 else
  oe = make_actor(13,5.0,-abs(pl.dx)/4,0.95)
  oe.spr = nxt
 end
end

-- draw actors
function draw_actor(a)
 local sx = (a.x * 8) - 4
 local sy = (a.y * 8) - 4
 if (a == want) then
  if (win == true) a.spr = 1
 end
 if (a == pl) then
  spr(a.spr + a.frame, sx, sy)
 else
  spr(a.spr, sx, sy)
 end
end

-- each step
function _update()
 if (start == true) then
  go_step = -999
  to_step = -999
  win_step = -999
  time_left = 3000
  actor = {}
  steps = 0
  gravity = 0.05
  score = 0
  -- make player
  pl = make_actor(10,10,0,0.9)
  pl.spr = 17
  want = make_actor(2.75,6.375,0,0)
  want.spr = 19
  nxt = 19
  ending = false
  timeout = false
  win = false
 end
 if (win == false) time_left -= 1
 start = false
 control_player(pl)
 foreach(actor, move_obj) 
 foreach(actor, move_actor)
 steps += 1
 if (time_left == 0) then
  to_step = steps
  timeout = true
 elseif (score >= 10 and win == false) then
  win_step = steps
  win = true
 end
end

-- each drawn frame
-- a lot of this probably should
-- go in update, but it works
function _draw()
 cls()
 map(0,0,0,0,16,16)
 foreach(actor,draw_actor)
 print("items retrieved (^-^): "..score.."/10",0,120,7)
 print("time left: "..flr(time_left/30.0),0,110,7)
 if (win == true) then
  if (steps - win_step < 31) then
   print("huh?",0,100,7)
  end
  if (steps - win_step > 39 and steps - win_step < 71) then
   print("they're looking at me!",0,100,7)
  end
  if (steps - win_step > 79) then
   print("human? let's be friends! ‡",0,100,7)
  end
 elseif (ending == true and win == false) then
  print ("game over",45,50,7)
  if (steps - go_step < 31) then
   print("*smash*",0,100,7)
  end
  if (steps - go_step > 39 and steps - go_step < 71) then
   print("oh no - they'll hate me now...",0,100,7)
  end
  if (steps - go_step > 79 and steps - go_step < 111) then
   print("i'm so sorry...",0,100,7)
  end
  if (steps - go_step > 109 and steps - go_step < 141) start = true
 
 elseif (timeout == true) then
  print ("game over",45,50,7)
  if (steps - to_step < 31) then
   print("i took too long...",0,100,7)
  end
  if (steps - to_step > 39 and steps - to_step < 71) then
   print("they'll never notice me now...",0,100,7)
  end
  if (steps - to_step > 79 and steps - to_step < 111) start = true

 elseif (score == 0) then
  if (steps < 31) then
   print("\"notice me\"",0,100,7)
  end
  if (steps > 39 and steps < 71) then
   print("piconaut - ian fare - 2016",0,100,7)
  end
  if (steps > 79 and steps < 111) then
   print("that human is beautiful...",0,100,7)
  end
  if (steps > 119 and steps < 151) then
   print("they want a cup of coffee...",0,100,7)
  end
  if (steps > 159 and steps < 191) then
   print("i can bump it off the shelf",0,100,7)
  end
  if (steps > 199 and steps < 231) then
   print("by pressing /right/",0,100,7)
  end
 else
  go_step = steps - 999
  to_step = steps - 999
  win_step = steps - 999
  if (score == 1) print ("a thousand years of loneliness",0,100,7)
  if (score == 2) print ("and they're so alive...",0,100,7)
  if (score == 3) print ("i can feel them breathe...",0,100,7)
  if (score == 4) print ("their eyes gaze out the window...",0,100,7)
  if (score == 5) print ("their warmth fills the room...",0,100,7)
  if (score == 6) print ("sound banishes silence...",0,100,7)
  if (score == 7) print ("a grey world lit by glowing skin",0,100,7)
  if (score == 8) print ("their chest rises and falls...",0,100,7)
  if (score == 9) print ("their beating heart revives me!",0,100,7)
  
 end
end
