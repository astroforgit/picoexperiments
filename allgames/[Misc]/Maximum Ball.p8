--main

gravity=0.04
bounds={
	t=8,
	r=120,
	b=120,
	l=8
}

playerjump={
	.08,
	.16,
	.24,
	.32,
	.40,
	.48,
	.56
}
playerspeed=1.4
playertraction=0.25
playerfriction=0.125

playerballbounce=0.8

gameintro=3
gameduration=45
gameoutro=1
hudfadein=0.5

player_template={
	x=64,
	y=100,
	dx=0,
	dy=0,
	r=7.5,
	flipx=false,
	jumpframes=999,
	jumpdone=true,
	bounce=0
}

player={}
score=0
starttime=0
mainstart=0
counteddown=0
warningtime=0
gameovertime=-1
timeleft='00'
balldown=false

hudy=-22

function init_main()
	merge(player, player_template)
	
	player.y=bounds.b-player.r
	
 score=0
 newhiscore=false
 starttime=t()+gameintro+titlefadein
 mainstart=t()
 counteddown=0
 gameovertime=-1
 dt=1
 balldown=false
 timeleft=zeropad(gameduration,2)
 warningtime=5
 
 hudy=-22
 
 init_ball()
 init_targets()
 init_hands()
 
 input.enabled=true
end

function update_main()
	if t()<starttime-gameintro then
		return
	end

	local mhud=mid(0,
		(t()-starttime+gameintro)/hudfadein,
		1)
	hudy=easeout(-22,5,mhud)

	if t()-starttime>gameduration
	and gameovertime==-1
	then
		gameover()
		return	
	end
	
	if t()<starttime then
		local countdown=ceil(starttime-t())
		if countdown~=counteddown then
			sfx(sfx_countdown)
			counteddown=countdown
		end
		return
	elseif counteddown==1	then
		sfx(sfx_timeover)
		counteddown=0
	end
	
	local timeleftn=ceil(gameduration-(t()-starttime))
	if timeleftn<=warningtime
	and warningtime>=1
	and gameovertime==-1
	then
		sfx(sfx_warning)
		warningtime-=1
	end
	
	timeleft=zeropad(timeleftn,2)

	player.dy+=gravity*dt
	
	local grounded=
	 player.y+player.dy+player.r
	 >=bounds.b
	
	if btnu(Ž) then
		player.jumpdone=true
	end
	
	if grounded
	and player.jumpdone
	then
		player.jumpframes=1
		if btnd(Ž) then
			sfx(sfx_jump)
		end
	elseif not btnh(Ž) then
	 player.jumpframes=999
	end
	
	if btnh(Ž)
	and player.jumpframes<#playerjump
	then
		player.dy-=playerjump[player.jumpframes]
		player.jumpframes+=1
		player.jumpdone=false
	end
	
	player.y+=player.dy*dt
	
	if btnh(‹) then
		player.dx-=playertraction
	elseif btnh(‘) then
		player.dx+=playertraction
	elseif abs(player.dx)<playerfriction
	then
		player.dx=0
	else
		player.dx-=sign(player.dx)*playerfriction*dt
	end
	player.dx=mid(-playerspeed,
		player.dx,playerspeed)
	
	player.x+=player.dx
	
	ball.x+=ball.dx*dt
	ball.dy+=gravity*dt
	ball.y+=ball.dy*dt
	
	player.flipx=gameovertime>-1
		and player.flipx
		or ball.x<player.x
	
	update_hands()
	
	mapcirclecollide(player)
	
	if playerballcollide(player,ball)
	and mag(diff(player.dx,player.dy,ball.dx,ball.dy))>0.1
	and gameovertime==-1
	then
		sfx(sfx_bonk)
	end
	
	local bounce,bounceb=
		mapcirclecollide(ball)
	if gameovertime==-1 then
		if bounceb then
			balldown=true
			gameover()
			return
		elseif bounce then
			sfx(sfx_bounce)
		end
	end
		
	update_targets()
	
	if score>hiscore then
		newhiscore=true
		hiscore=score
	end
end

function draw_main()
	cls()
	map(32, 0)
	map(0, 0)
	
	draw_targets()
	
	draw_hand_back()
	
	local playersprite=player.flipx
		and 4 or 2
	spr(playersprite,
		player.x+(
			player.flipx and -8 or -7),
		player.y-7,
		2,
		2)
	
	draw_hand_front()
		
	spr(12,ball.x-4,ball.y-4,2,2)
	
	printo("1up",5,hudy)
	printo(zeropad(score,8),5,hudy+7)
	printo("hi score",91,hudy)
	printo(zeropad(hiscore,8),91,hudy+7)
	
	local timeleftn=gameduration-(t()-starttime)
	if timeleftn<=5
	and ceil(timeleftn*2)%2==0
	and gameovertime==-1 then
		pal(8,7)
		pal(9,7)
		pal(10,7)
	end
	
	sprnumstr(timeleft,57,hudy+4,64)
	pal()
	
	local elapsed=t()-starttime
	if elapsed<-gameintro then
		fadefromblack((t()-mainstart)/titlefadein)
	elseif elapsed<=0 then
		local s=elapsed<-2
			and 100
			or elapsed<-1
			and 98
			or 96
		spr(s,59,40,2,2)
	elseif elapsed<=1 then
		if flr(elapsed*10)%2==0 then
			pal(10,7)
			pal(11,10)
		end
		spr(102,54,40,3,2)
	end
	pal()
	
	--debug stuff
	if not debug then return end
	
	local nx,ny=norm(diff(ball.x,
		ball.y,player.x,player.y))
	local dx,dy=diff(ball.dx,
		ball.dy,player.dx,player.dy)
	local rx,ry=reflect(dx,dy,nx,ny)
	
	local r=player.r
	color(10)
	line(player.x+nx*r,player.y+ny*r,
		player.x+nx*8,player.y+ny*8)

	color(12)
	line(player.x+nx*r,
	 player.y+ny*r,
		player.x+nx*r+rx*8,
		player.y+ny*r+ry*8)
		
	printo(mag(ball.dx,ball.dy),0,123)
end

function start_main()
	transition({
		init=init_main,
		update=update_main,
		draw=draw_main
	})
end

