--targets

targetpoints=99
targetlifespan=7
targetinterval=1
targetintro=0.8
targetspawns={
	{64,35},
	{104,35},
	{24,40},
	{64,40},
	{104,40},
	{24,30},
	{64,30},
	{104,30},
	{24,35}
}
target_template={
	x=64,
	y=32,
	r=10.5,
	points=targetpoints,
	spawned=-1,
	hit=-1,
	alive=false
}
numtargets=8

targets={}
nexttarget=0
maxnumtargets=1
targetspawn=1

function init_targets()
	targets={}
	maxnumtargets=1
	targetspawn=1

 for i=1,numtargets do
 	add(targets, clone(target_template))
 end
end

function update_targets()
	local numalivetargets=0
	
	for targ in all(targets) do
		update_target(targ)
		if targ.alive then
			numalivetargets+=1
		end
	end
	
	if numalivetargets<maxnumtargets
	and t() >= nexttarget
	then
		spawn_target()
	end
end

function update_target(targ)
	if not targ.alive then return end
	
	local targetable=targ.hit==-1
		and t()>=targ.spawned
		and gameovertime==-1
	
	if targ.hit>-1
	and t()>targ.hit+targetintro then
		targ.alive=false
		return
	end
	
	if not targetable then return end
	
	if overlaps(targ,ball) then
		sfx(sfx_score)
		score+=targ.points
		targ.hit=t()
		nexttarget=t()+targetinterval
		return
	end
	
	targ.points=gameovertime>-1
		and targ.points
		or max(
			ceil(((targetlifespan-(t()-targ.spawned))/targetlifespan)*targetpoints),
			1)
end

function draw_targets()
	for targ in all(targets) do
		draw_target(targ)
	end
end

function draw_target(targ)
	if not targ.alive then return end
	
	local phase=gameovertime>-1
		and gameovertime
		or t()
	
	local targetable=gameovertime==-1
		and targ.hit==-1
		and phase>=targ.spawned
	
	local s=phase<targ.spawned
		and 10
		or 11
	
	local n=7
	for i=1,n do
		local r=targ.r
		local m=-phase
		
		if phase<targ.spawned then
			r=easein(targ.r,256,
				targ.spawned-phase)
		elseif targ.hit>-1 then
			r=easeout(targ.r,256,
				phase-targ.hit,
				1.2)
			m=targ.hit
		end
		
		local x=targ.x+cos(m/2+i/n)*r-3
		local y=targ.y+sin(m/2+i/n)*r-3
		spr(s,x,y)
	end
	
	if phase<targ.spawned then
		return
	end
	
	sprnumstr(
		zeropad(targ.points,2),
		targ.x-6,
		targ.y-3,
		80,
		6)
end

function spawn_target()
 local index=-1
 for i=1,numtargets do
 	if not targets[i].alive then
 		index=i
 	end
 end
 if index==-1 then return end
 
 local targ=targets[index]
 
 merge(targ,target_template)
 
 local spawn=targetspawns[targetspawn]
 targetspawn=targetspawn+1
 if targetspawn>#targetspawns then
 	targetspawn=1
 end
 
 targ.x=spawn[1]
 targ.y=spawn[2]
 targ.spawned=t()+targetintro
 targ.alive=true
end

