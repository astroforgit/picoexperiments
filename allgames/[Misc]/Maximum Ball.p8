--physics

function mapcirclecollide(actor)	
	local bouncey=false
	local bouncex=false
	local bounceb=false
	
	if actor.y-actor.r<=bounds.t then
		actor.y=bounds.t+actor.r
		bouncey=true
	end
	if actor.x+actor.r>=bounds.r then
		actor.x=bounds.r-actor.r
		bouncex=true
	end
	if actor.y+actor.r>=bounds.b then
		actor.y=bounds.b-actor.r
		bouncey=true
		bounceb=true
	end
	if actor.x-actor.r<=bounds.l then
		actor.x=bounds.l+actor.r
		bouncex=true
	end
	
	if bouncey then
		actor.dy=
			-(actor.dy*actor.bounce)
	end
	if bouncex then
		actor.dx=
			-(actor.dx*actor.bounce)
	end
	
	return bouncex or bouncey,
		bounceb
end

function playerballcollide(
	player,
	ball)
	
	if not overlaps(player, ball)
	then
		return false
	end
	
	local nx,ny=norm(diff(ball.x,
		ball.y,player.x,player.y))
	local dx,dy=diff(ball.dx,
		ball.dy,player.dx,player.dy)
	local rx,ry=reflect(dx,dy,nx,ny)

	local d=dot(nx,ny,rx,ry)
	if d<0 then return end

	ball.dx=rx*playerballbounce
	ball.dy=ry*playerballbounce
		
	--todo factor in bounce
	ball.x=player.x+nx*
		(ball.r+player.r)
		+ball.dx
	ball.y=player.y+ny*
		(ball.r+player.r)
		+ball.dy
		
	return true
end

