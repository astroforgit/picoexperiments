-- utils.lua

function clone(val)
	if type(val) ~= "table" then return val end
	local result = {}
	for k,v in pairs(val) do
		result[k] = clone(v)
	end
	return result
end

function merge(tbl, ...)
	for u in all({...}) do
		for k,v in pairs(u) do
			tbl[k] = v
		end
	end
	return tbl
end

function extend(tbl, ...)
	return merge({}, tbl, ...)
end

function pretty(val, n)
	if type(val) == "string" then return '"' .. val .. '"' end
	if type(val) ~= "table" then return tostr(val) end

	n = n or 0
	local pad = ""
	for i = 1,n do pad = pad .. " " end

	local result = "{\n"
	for k,v in pairs(val) do
		result = result .. pad .. " " .. k .. "=" .. pretty(v, n+1) .. ",\n"
	end
	result = sub(result, 1, #result-2) .. "\n" .. pad .. "}"
	return result
end

function zeropad(n, places)
	if type(n) == "number" then n = n.."" end

	if #n >= places then return n end

	return zeropad("0" .. n, places)
end

-- end utils.lua



-- math.lua

function sq(n)
	return n*n
end

function dist(x1, y1, x2, y2)
	return mag(diff(x1, y1, x2, y2))
end

function dot(x1, y1, x2, y2)
	return x1*x2 + y1*y2
end

function mag(x, y)
	return sqrt(sq(x) + sq(y))
end

function norm(x, y)
	local m = mag(x, y)
	return x/m, y/m
end

function reflect(dx, dy, nx, ny)
	local mult = 2*dot(dx, dy, nx, ny)
	return dx - mult*nx, dy - mult*ny
end

function diff(x1, y1, x2, y2)
	return x1 - x2, y1 - y2
end

function mult(x, y, n)
	return n*x, n*y
end

function project(ax, ay, bx, by)
	return mult(bx, by, dot(ax,ay,bx,by) / dot(bx,by,bx,by))
end

function sign(n)
	if n < 0 then return -1 end
	if n > 0 then return 1 end
	return 0
end

function overlaps(a, b)
	return dist(a.x, a.y, b.x, b.y) < a.r+b.r
end

function rndrange(lb, ub)
	return lb + rnd(ub - lb)
end

function lerp(lb, ub, n)
	return lb + n * (ub - lb)
end

function easein(lb, ub, n, exp)
	exp = exp or 2
	return lerp(lb, ub, n^exp)
end

function easeout(lb, ub, n, exp)
	exp = exp or 2
	return lerp(lb, ub, -(-n + 1)^exp + 1)
end

-- end math.lua



-- graphics.lua

function prints(s, x, y, c1, c2)
	c1 = c1 == nil and 7 or c1
	c2 = c2 == nil and 1 or c2
	color(c2)
	print(s,x+1,y)
	print(s,x+1,y+1)
	print(s,x,y+1)
	color(c1)
	print(s,x,y)
end

function printo(s, x, y, c1, c2)
	c1 = c1 == nil and 7 or c1
	c2 = c2 == nil and 1 or c2
	color(c2)
	print(s,x,y-1)
	print(s,x+1,y-1)
	print(s,x+1,y)
	print(s,x+1,y+1)
	print(s,x,y+1)
	print(s,x-1,y+1)
	print(s,x-1,y)
	print(s,x-1,y-1)
	color(c1)
	print(s,x,y)
end

function sprnumstr(s, x, y, index0, cwidth)
	index0 = index0 == nil and 64 or index0
	cwidth = cwidth == nil and 7 or cwidth
	for i=1,#s do
		local cx = x + (i-1)*cwidth
		local sidx = index0 + ord(sub(s,i,i)) - 48
		spr(sidx,cx,y)
	end
end

function fadetoblack(n)
	n = mid(0, n, 1)
	color(0)
	for x = 0,8 do
		for y = 0,8 do
			local r = lerp(0,12, 4*n - (x/9) - y/4.5)
			if r > 0 then
				circfill(x*16, y*16, r)
			end
		end
	end
end

function fadefromblack(n)
	n = mid(0, n, 1)
	color(0)
	for x = 0,8 do
		for y = 0,8 do
			local r = lerp(0,12, 1 + y/4.5 - (4*n + (x-9)/9))
			if r > 0 then
				circfill(128-x*16, y*16, r)
			end
		end
	end
end

function pall(p)
	for i=1, #p do
		pal(i,p[i])
	end
end

-- end graphics.lua



-- input.lua

input = {
	buttons = {},
	enabled = true
}

function init_input(buttons)
	for b in all(buttons) do
		input.buttons[b] = {
			d = false,
			h = false,
			u = false
		}
	end
	input.enabled = true
end

function update_input()
	for b,i in pairs(input.buttons) do
		if btn(b) then
			i.d = not i.h
			i.h = true
			i.u = false
		else
			i.u = i.h
			i.d = false
			i.h = false
		end
	end
end

function btnd(b)
	return input.enabled and input.buttons[b].d
end

function btnh(b)
	return input.enabled and input.buttons[b].h
end

function btnu(b)
	return input.enabled and input.buttons[b].u
end

-- end input.lua




