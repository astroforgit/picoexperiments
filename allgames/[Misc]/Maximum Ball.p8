--hands

handlifespan=8/60
handforce=2.5
handoffset={
	x=-4,
	y=3
}
hand={
 x=0,
	y=0,
	r=3,
	punching=false,
	punched=0
}

function init_hands()
	hand.punching=false
	
	local fromx,fromy=
		compute_from_pos()
	hand.x=fromx
	hand.y=fromy
end

function update_hands()
	if btnd(—) then
		hand.punched=t()
		hand.punching=true
		sfx(sfx_punch)
	elseif t()>hand.punched+handlifespan
	then
		hand.punching=false
	end
	
	local fromx,fromy=
		compute_from_pos()
	
	local nx,ny=norm(diff(ball.x,
		ball.y,player.x,player.y))
	local tox=
		player.x+nx*(player.r+hand.r)
	local toy=
		player.y+ny*(player.r+hand.r)
	
	local n=mid(0,
		(t()-hand.punched)/handlifespan
		,2)
	if n>1 then n=2-n end
		
	hand.x=lerp(fromx,tox,n)
	hand.y=lerp(fromy,toy,n)
	
	local to={x=tox,y=toy,r=hand.r}
	
	if overlaps(ball,to)
	and hand.punching
	then
		ball.dx=nx*handforce
		ball.dy=ny*handforce
		
		if dot(nx,ny,player.dx,player.dy) > 0 then
			local px,py=project(
				player.dx,player.dy,
				nx,ny)
			ball.dx+=px
			ball.dy+=py
		end
		
		sfx(sfx_whack1)
		sfx(sfx_whack2)
		
		hand.punching=false
	end
end

function draw_hand_back()
	local s=player.flipx
		and 31
		or 15
	
	local fromx,fromy=
		compute_from_pos()
	
	if player.flipx then
		fromx=fromx-10
	else
		fromx=fromx+9
	end
	
	spr(s,fromx-4,fromy-4)
end

function draw_hand_front()
	
	local s=player.flipx
		and 31
		or 15
	
	local animating=
		t()-hand.punched
		<=handlifespan*2
	if animating then
		local dx,dy=diff(ball.x,
			ball.y,player.x,player.y)
		local d=dy/dx
		if dy<-1 then
			s=14
		elseif dy>1 then
			s=30
		end
	end	
	
	spr(s,
		hand.x-4,
		hand.y-4)
end

function compute_from_pos()
	local fromx=
		player.x+handoffset.x*
		(player.flipx and -1 or 1)+
		(player.flipx and 1 or 0)
	local fromy=
		player.y+handoffset.y
	return fromx,fromy
end
