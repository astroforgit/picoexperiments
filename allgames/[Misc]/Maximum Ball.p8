--title & game over

gameoverfadein=2/3

gameoverendtime=-1

function init_gameover()
	input.enabled=false
	dt=0.5
	gameovertime=t()
	gameoverendtime=-1
end

function update_gameover()
	update_main()
	
	timeleft=zeropad(
		ceil(gameduration-(gameovertime-starttime)),2)
	
	if btnp(—)
	and gameoverendtime==-1
	and t()>=gameovertime+gameoutro+gameoverfadein
	then
		sfx(sfx_menuchoice)
		endgameover()
	end
	
	if gameoverendtime~=-1
	and t()>=gameoverendtime+titlefadein
	then
		start_title()
	end
end

function draw_gameover()
	draw_main()
	
	if t()<gameovertime+gameoutro then
		return
	end
	
	local s=balldown and 128 or 135
	
	local m1=mid(0,
		(t()-(gameovertime+gameoutro))/gameoverfadein,
		1)
	local x1=easeout(-56,38,m1)
	
	spr(s,x1,40,7,2)
	
	local fromx2=129
	if newhiscore then
		fromx2=-52
	end
	local x2=easeout(fromx2,48,m1)
	
	if gameoverendtime==-1 then
		printo("press —",x2,72)
	elseif ceil((t()-gameoverendtime)*8)%2==0
	then
		printo('press —',
			48,72)
	end
	
	local x3=easeout(129,39,m1)
	
	if (m1<1
	or flr((t()-gameovertime)/(gameoutro/2))%2==0)
	and newhiscore
	then
		printo("new hi score!!",x3,58,7,3)
	end
	
	if gameoverendtime~=-1 then
		fadetoblack((t()-gameoverendtime)/titlefadein)
	end
end

function gameover()
	if gameovertime ~= -1 then
		return
	end
	
	sfx(balldown
		and sfx_balldown
		or sfx_timeover)
	
	if newhiscore then
		dset(0,hiscore)
	end
	
	transition({
		init=init_gameover,
		update=update_gameover,
		draw=draw_gameover
	})
end

function endgameover()
	gameoverendtime=t()
end

titlestart=0
titleend=-1

function init_title()
	input.enabled=false
	titlestart=t()
	titleend=-1
	
	music(0)
end

function update_title()
	if btnp(—) and titleend==-1
	then
		sfx(sfx_menuchoice)
		music(-1, 666)
		titleend=t()
	end
	
	if titleend~=-1
	and t()>=titleend+titlefadein
	then
		start_main()
	end
end

function draw_title()
	cls()
	map(32,0)
	map(16,0)
	map(48,0,16,16)
	
	printo('starring gravity gonzalez',
		14,53,10,2)
	
	local period=titleend==-1
		and 1
		or 8
	local blinkstart=titlestart-period
	if titleend~=-1 then
		blinkstart=titleend
	end
	if ceil((t()-blinkstart)*period)%2==0
	then
		printo('press —',
			48,72)
	end
		
	printo('hi score: '..
		zeropad(hiscore,8),
		29, 100)
	
	printo(
		'a game by fredrik blomqvist',
		10,120,6,1)
		
	if t()<titlestart+titlefadein then
		fadefromblack((t()-titlestart)/titlefadein)
	end
	if titleend~=-1 then
		fadetoblack((t()-titleend)/titlefadein)
	end
end

function start_title()
	transition({
		init=init_title,
		update=update_title,
		draw=draw_title
	})
end
