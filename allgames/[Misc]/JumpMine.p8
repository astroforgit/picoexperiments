pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
function _init()
	gameover=false
	makeplayer()	
	makecave()
	makeactors()
	makenuggets()
	laserparticles={}
	cavesicles={}
	score=0
	health=3
	
	jumpdown = false
 tick = 0
 last_bombed = 0
 bombed = false
 bomby = 0
 laseparticles={}
 ticks_since_started=0
 ticks_since_tutorial=0
 game_started = false
 nbombs = 0
 ticks_since_first_bomb = 0
 bg_phase =0
 screenshake_x = 0
	music(16)
	--music(0)
end

function _update()
	if(not gameover) then
		moveplayer()
		updatecave()
		updatenuggets()
		update_cavesicles()
		checkhit()
		
	else
		doblood()
		if(btnp(5)) then
			_init()
		end
	end
	
	tick+=1
	
	updatebgparts()
	foreach(laserparticles,updatelaserparticle)
end

function draw_score_health()
 if(not gameover) then
 	spr(48,0,0)
 	spr(48,8,0)
 	spr(48,16,0)
 	spr(48,24,0)
 	spr(51,32,0)
 	spr(50,0,8)
 	spr(50,8,8)
 	spr(50,16,8)
 	spr(50,24,8)
 	spr(49,32,8)
		print("score: "..score,1,1,12)
		for h = 0, health-1 do
			spr(21,1 + h*(8+1),6)
		end
	end
end

function hcenter(s)
  -- screen center minus the
  -- string length times the 
  -- pixels in a char's width,
  -- cut in half
  return 64-#s*2
end

function _draw()
	cls()
	drawbg()
	--print("nug:"..#nuggets, 30,30,6)
	drawplayer()
	drawcave()
	rendernuggets()
	draw_score_health()
	render_cavesicles()
	if(gameover) then
		print("you died", 48,50,12)
		print("—", 60, 60, 12)
		scorestring = "score:"..score
		print(scorestring, hcenter(scorestring),70,12)
 else
	
	if(not game_started)then 
		print("” jump",43,player.y+12,12) 
	elseif(not bombed and ticks_since_started>60) then
	print("— mine",43,player.y+12,12) 
	end
	
	--if(nbombs>0)then
	
	--	if((ticks_since_first_bomb>100) and
	-- 	(ticks_since_first_bomb) <200) then
	--		print("collect as many\nnuggets as possible",23,player.y+12,7) 
	--	end
	--end
	end
end

function makeplayer()
player={}
player.x = 54
player.y = 60
player.dy = 0 
player.rise = 0
player.fall = 1
player.dead = 5
player.speed = 1
player.score = 0
player.flapanim = 0
player.hurt = 0
end

function rot(x,y,cx,cy,ang)
	local sang = sin(ang)
	local cang = cos(ang)
	
	x-=cx
	y-=cy
	
	local rotx = cang*x - sang*y
	local roty = sang*x + cang*y
	rotx +=cx
	roty +=cy
	return rotx, roty
end

function draw_texture_mapped(t, reso, xx, yy, ang)
 for y = 0.0, (7.0*reso) do
  local sx = xx
  local sy = yy + y/reso
  local ex = xx+7
  local ey = yy + y/reso
  
  local sx,sy = rot(sx,sy,xx+4,yy+4,ang)
  local ex,ey = rot(ex,ey,xx+4,yy+4,ang)
  
		tline(sx,sy,ex,ey,
		t, y * (1.0/(8.0*reso)),
		1.0/8.0, 0.0)
	end
end

function drawplayer()

	--draw_texture_mapped(16.0,70,40)

	if(gameover) then
		spr(player.dead, player.x+screenshake_x,player.y)
	elseif(not game_started)then
	 spr(18,player.x+screenshake_x,player.y)
	elseif(player.hurt>0) then
		hurt_spr = player.hurt%2
	 spr(16+hurt_spr,player.x+screenshake_x,player.y) 
	elseif(tick-last_bombed<8 and bombed) then
		spr(20, player.x+screenshake_x,player.y)
	elseif(player.flapanim > 0) then
		local flapspr = (6- player.flapanim)%3
		spr(2+flapspr, player.x+screenshake_x,player.y)
	elseif(player.dy<0) then
		spr(player.rise, player.x+screenshake_x, player.y)
	else
	 spr(player.fall, player.x, player.y)			
	end
	renderblood()
end
-->8


function render_cavesicle(o)
	local rx1 = o.x1
	local rx2 = o.x2
	local ry1 = o.y1
	local ry2 = o.y2
	
 local rx1,ry1 = rot(rx1,ry1,o.x1,o.y1,o.ang)
	local rx2,ry2 = rot(rx2,ry2,o.x1,o.y1,o.ang)
	
	line(rx1,ry1,rx2,ry2,o.type)
end

function render_cavesicles()
 foreach(cavesicles,render_cavesicle)
end

function update_cavesicle(o)
	o.y1 += o.dy
	o.y2 += o.dy
	o.x1 += o.dx
	o.x2 += o.dx
	
	o.dy += 0.1
	
	o.ang += o.angspeed
	
	if(o.y1 > 127 and o.y2 >127) then
		del(cavesicles,o)
	end
end

function update_cavesicles()
	foreach(cavesicles,update_cavesicle)
end

function crumble_cave_column(x,y1,y2,side)
	local length = y2-y1
	local totallength = length	
	local cury = y1
	while(length>0) do
	 crumbamount = rnd(0.8) + 0.2
		seglen = crumbamount*totallength
		length -= seglen
		
		local newseg = {}
		newseg.x1 = x
		newseg.x2 = x
		newseg.y1 = cury
		newseg.y2 = cury+seglen
		newseg.segid = flr(rnd(16))
		newseg.dx = rnd(1.0)
		newseg.dy = rnd(2.0)
		newseg.ang = 0.0
		newseg.angspeed = rnd(0.01)-0.005
	 
	 if(side == 0) then
	  newseg.type = 4
	  type2 = 5
	  
	  if(y2-cury < 4)then
			 newseg.type = type2
		 end		
	 end
	 
	 if(side == 1) then
	 	newseg.type = 4
	 	type2 = 5
	 	
	 	newseg.dy *= -1
	 	
	 	if(cury - y1 < 4)then
			 newseg.type = type2
		 end		
	 end
		
		cury += seglen
		add(cavesicles,newseg)
	end
end

function moveplayer()
	gravity = 0.1
	
	if(btn(2) and not jumpdown
	and player.flapanim==0) then
		player.dy-=2.5
		player.flapanim=3
	 if(not game_started) then
	  music(0)
	 end
		game_started=true
		sfx(0)
	end
	
	jumpdown = btn(2)
	
	player.flapanim-=1
	player.flapanim = max(player.flapanim,0)
	
	if(game_started)then
	 ticks_since_started+=1
		player.dy = min(player.dy,4)
	
		player.dy+=gravity
	
		--limit vertical speed
		player.dy = min(player.dy,3.0)
		player.dy = max(player.dy, -3.0)
	
		player.y+=player.dy
		player.score+=player.speed
	else
	 player.y = 54 + sin(tick*0.03)*4.0
	end
	
	--bombs
	if(#cave==128)then
	
	if(game_started and 
	btn(5) and tick-last_bombed>32)then
		--destroy terrain in an area
			bomby = player.y-10
			bombed=true
			nbombs+=1
			sfx(5)
			last_bombed=tick
	end
	
	if(nbombs>0) then
	 ticks_since_first_bomb+=1
	end
	
	--pain--
	player.hurt-=1
	player.hurt=max(0,player.hurt)
	
	if(bombed and (tick-last_bombed<16))then
	bombtick = tick-last_bombed
	bombtick*=8
	max_column = player.x+bombtick
	max_column= min(max_column,127)
	for i = player.x, max_column do
		local destroyed = false
		
		if(cave[i+1].top>bomby+2) then
				 crumble_cave_column(i+1, bomby+2, cave[i+1].top, 0)
					cave[i+1].top = bomby+2
					destroyed=true
		end
				
		if(cave[i+1].btm<bomby + 26) then
					crumble_cave_column(i+1, cave[i+1].btm, bomby + 26, 1)
					cave[i+1].btm = bomby + 26
					destroyed=true
		end
		
		if(destroyed)then
			rndsfx = flr(rnd(2))
			sfx(6+rndsfx)
		end
		
		--add some nice particles for the laser
		if(i>(max_column-16))then
			local laser_particle = {}
			laser_particle.x = i
			laser_particle.y = bomby+rnd(16.0)
			laser_particle.dx = rnd(4.0)-2.0
			laser_particle.dy = rnd(4.0)-2.0
			laser_particle.life = 0
			add(laserparticles,laser_particle)
		end
	end
	end
	end
	
end

function makecave()
	cave = {{["top"]=5, ["btm"]=119, ["col"]=3, ["fall"]=false}}
	top = 10
	btm = 110
	difficulty = 0.0
end

function makeactors()
	blood = {}
	bgparticles={}
end

function doblood()
	local bld={}
	bld.x = player.x + rnd(6.0)
	bld.y = player.y
	bld.dy = -1
	bld.dx = rnd(1.0) - 0.5
	if(#blood < 32) then
		add(blood,bld)
	end
	foreach(blood,processblood)	
end

function drawbloodparticle(o)
	line(o.x,o.y,o.x+1,o.y+1,12)
end

function processblood(o)
	o.y += o.dy
	o.x += o.dx
	o.dy +=0.2
	
	local i = flr(o.x)
	if(cave[i].btm<o.y) then
		cave[i].col=12
		o.dy = 0.0
		o.dx = 0.0
		
	end
	
end

function drawlaserparticle(o)
 col = 10
 if(o.life>6)then
 	col = 9
 end
 if(o.life>12)then
 	col = 8
 end
	line(o.x,o.y,o.x,o.y,col)
	--spr(55+(10-col), o.x,o.y)
	
end

function updatelaserparticle(o)
	o.x+=o.dx
	o.y+=o.dy
	
	o.dy+=0.1
	o.life+=1
	if(o.life>16) then
		del(laserparticles,o)
	end
end

function renderblood()
 foreach(blood, drawbloodparticle)
	foreach(laserparticles,drawlaserparticle)
		
	--draw bombs
	if(bombed and tick-last_bombed<16)then
	
	 ticksprite = tick-last_bombed
	 
		for x = 0, 8 do
			sprshift = (x+tick/1)%6 +2 
			if(x<1) then
				sprshift=x+(tick/4)%2
			end
			
			if(x<ticksprite and
			x>ticksprite-8) then
			
				spr(7+sprshift,
				player.x + x * 8 + 8 +
				screenshake_x,
				bomby,
				1,4)
			end
		end
	end
	
end

function updatecave()
	--remove the back of the cave
	if(#cave >player.speed) then
		for i = 1, player.speed do
			del(cave, cave[1])
		end
	end
	
	--difficulty
	if(game_started)then
		difficulty+=0.1
		top +=0.1
		btm -= 0.1
		top = min(64, top)
	 btm = max(64,btm)
	end

	
	--add cave bits
	while(#cave<128) do
		local col ={}
		local up =flr(rnd(9)-4)
		local dwn = flr(rnd(9)-4)
		
		if(not game_started) then
		 up = 0
		 dwn =0
		end
		
		col.top = mid(3, cave[#cave].top +up,top)
		col.btm = mid(btm, cave[#cave].btm +dwn, 124)
		col.col=5
		add(cave,col)
		
		makenugget=false
		
		if(col.btm<100 and(rnd(16)<2))then
			--generate nuggets
			nug={}
			nug.x = #cave
			nug.y = col.btm+9+rnd(16)
			nug.type = flr(rnd(2))
			nug.free=false
			nug.collected = false
			nug.colframe = 0
			add(nuggets,nug)
		end
		
		if(col.top>27 and(rnd(16)<2))then
			--generate nuggets
			nug={}
			nug.x = #cave
			nug.y = col.top-12-rnd(16)
			nug.type = flr(rnd(2))
			nug.free=false
			nug.collected = false
			nug.colframe = 0
			add(nuggets,nug)
		end
	end
end


function drawcave()

 bomb_amount = 16.0 - min(tick-last_bombed,16)
 bomb_amount/=16.0
 
 local shx = 0.0
 local shy = 0.0
 
 local nshakex = (rnd(8.0))*bomb_amount
	screenshake_x = nshakex;//(screenshake_x + nshakex)/2.0

 if(not bombed)then
  screenshake_x = 0.0
 end

	top_color = 5
	
	for i = 1, #cave do
		line(i-1+screenshake_x,0+shy, i-1+screenshake_x,
		 cave[i].top+shy, top_color)
		line(i-1+screenshake_x,0+shy, i-1+screenshake_x,
		 cave[i].top-5+shy, 4)
		line(i-1+screenshake_x,128+shy, i-1+screenshake_x,
		 cave[i].btm+shy, cave[i].col)
			line(i-1+screenshake_x,128+shy, i-1+screenshake_x,
		 cave[i].btm+5+shy, 4)
	end
end

function checkhit()
	for i = player.x, player.x+7 do
		hurt_reason = 0
		if(cave[i+1].top>player.y) then
			hurt_reason =1
		end
		if(cave[i+1].btm<player.y+7) then
			hurt_reason =2
		end
		
		if(hurt_reason > 0) then
			health-=1

			if(health<0) then
				gameover =true
				sfx(2)
				sfx(3)
				music(10)
			else 
				player.y-= (hurt_reason == 1) and -4 or 4 
			 player.dy -=(hurt_reason == 1) and -2 or 2 
			 player.hurt=4
			 sfx(17)
			end
		end
	end
end
-->8
function moveparticle(o)
o.x-=o.spd
end

function drawparticle(o)
line(o.x,o.y,o.x,o.y,4)
end

function updatebgparts()
	yrnd = rnd(127)
	local pcl = {}
	pcl.y = yrnd
	pcl.x = 127
	pcl.spd = rnd(1.0)*0.5 + 1.5
	if(rnd(1.0)<0.1)then
	add(bgparticles,pcl)
	end
	foreach(bgparticles,moveparticle)
end


function drawbg()
	
	if(game_started)then
  bg_phase+=1
 end
 
 bomb_amount = 16.0 - min(tick-last_bombed,16)
 bomb_amount/=16.0
 
	for i=0, 127 do
		  local prog = (i + bg_phase)/500
		  prog = prog%4
		  prog+=rnd(0.05)*bomb_amount
		  tline(0,i,127,i,prog,2,0.005,0.0)
	end
	
	foreach(bgparticles,drawparticle)
	
end

-----nuggets-----
function makenuggets()
nuggets={}
end

function lerp(tar,pos,perc)
 return (1-perc)*tar + perc*pos;
end

function updatenugget(o)

	if(o.free)then
		o.x = lerp(o.x,player.x,0.1)
		o.y = lerp(o.y,player.y,0.1)
		
		o.colframe+=1
		if(o.colframe>20 and not o.collected) then
			o.collected=true
			rndsfx = flr(rnd(5))
			sfx(12+rndsfx)
			score+=1
		end
		
		if(o.colframe>28)then
			del(nuggets,o)
		end
		
	else
		o.x-=player.speed
	end
	--check if free
	if(o.x>0)then
		anyover=false
		inti=flr(o.x)
		intimax =  min(127,inti+8)
		for i = inti, intimax do
			if(cave[i].btm<o.y or
				cave[i].top>o.y+8)then
				anyover=true
				break
			end
		end
	end
	
	if(o.x<-16) then
		del(nuggets, o)
	end
	
	if(not anyover and not o.free and o.x>0) then
		o.free=true
		sfx(11)
	end
	
end

function updatenuggets()
	--nugglets are generated by the cave generator
	foreach(nuggets,updatenugget)
end

function rendernugget(o)
 ang = o.colframe/32.0
	if(o.collected==false)then
	 if(o.free) then
	 	draw_texture_mapped(o.type,3,o.x,o.y,ang)
	 else
			spr(36+o.type,o.x+screenshake_x,o.y)
		end
	else
		draw_texture_mapped(3+o.type,8,o.x+screenshake_x,o.y,ang)
	end
end

function rendernuggets()
	foreach(nuggets,rendernugget)
end
