pico-8 cartridge // http://www.pico-8.com
version 27
__lua__
grid = {}
player1 = {}
player2 = {}
playercpu = {}
gravity = 0.125
vxcharge = 0.03125
vycharge = 0.03125
waiting = 0
title = true
cpu = false
titlebuffer = false

function _init()
	poke(0x5f5c, 255)
end

function reset()
	generategrid()
	createplayer(player1,20,0)
	createplayer(player2,100,1)
	createcpu()
	if(cpu) then
		player2.timer = 3
		player2.spr = 1
		sfx(3,1)
	end
end

function generategrid()
	local heights = {}
	heights[1] = flr(rnd(12)) + 1
	heights[13] = flr(rnd(12)) + 1
	terrain(heights, 1, 13)

	local emptygridline = generategridline(0)
	grid[1] = emptygridline
	grid[2] = emptygridline
	grid[16] = emptygridline
	grid[17] = emptygridline
	grid[31] = emptygridline
	grid[32] = emptygridline
	
	local i = 1
	while i <= 13 do
		grid[2 + i] = generategridline(heights[i])
		grid[31 - i] = generategridline(heights[i])
		i = i + 1
	end
end

function terrain(heights, l, r)
	local midpoint = flr((l+r)/2)
	if(midpoint <= l or midpoint >= r) return
	heights[midpoint] = randomheight(heights[l], heights[r])
	terrain(heights, l, midpoint)
	terrain(heights, midpoint, r)
end

function randomheight(l, r)
	local height = flr((l + r) / 2) + flr(rnd(3) - 1)
	if height <= 0 then height = 1 end
	return height
end

function generategridline(height)
	local ln = {}
	local i = 1
	while i <= 28  do
		if i > 28 - height then
			ln[i]=true
		else ln[i]=false end
		i = i + 1
	end
	return ln
end

function createplayer(player,x,c)
	player.x = x
	player.y = findspawny()
	player.spr = 0
	player.timer = 0
	player.vy = 0
	player.bomb = {}
	player.bomb.visible = false
	player.bomb.x = 0
	player.bomb.y = 0
	player.bomb.vx = 0
	player.bomb.vy = 0
	if(btn(0,c) or btn(1,c)) then
		player.timer = 3
		player.spr = 1
		sfx(c+2,c)
	end
end

function createcpu()
	playercpu.dr = 1+(-2*flr(rnd(2)))
	playercpu.bombtimer = -1
	walktimer()
end

function walktimer()
	playercpu.walktimer=flr(rnd(32))+16
end

function findspawny()
	local line1 = grid[6]
	local line2 = grid[7]
	local y = 0
	while not(line1[y+1] or line2[y+1]) do
		y = y + 1
	end
	return y * 4
end

function menu()
	if(btnp(0,0) or btnp(1,0)) then
		cpu = not cpu
	end
	if(btnp(4,0) or btnp(5,0)) then
		reset()
		player1.lives = 9
		player2.lives = 9
		title = false
		titlebuffer = true
	end
end

function _update60()
	if(title) then
		menu()
		return
	end
	if(waiting == 0) then
		sprchange(player1, 0)
		sprchange(player2, 1)
		moveplayer(player1, 0)
		moveplayer(player2, 1)
		movebomb(player1,0)
		movebomb(player2,1)
		playercollide(player1, player2.bomb)
		playercollide(player2, player1.bomb)
		if(waiting == 0) then
			chargeshot(player1, 0)
			chargeshot(player2, 1)
			cputimers()
		end
	else
		sfx(-1,0)
		sfx(-1,1)
		sfx(-1,3)
		waiting = waiting - 1
		if(waiting == 0) then 
			if(player1.lives == 0 or player2.lives == 0) then
				title = true
			else
				reset()
			end 
		end
	end
	deadplayer(player1)
	deadplayer(player2)
end

function sprchange(player,c)
	if(player.timer != 0) then
		player.timer = player.timer - 1
		if(player.timer == 0) then
			if(player.spr == 3) then
				player.spr = 0
				if(btn(0,c) or btn(1,c)) then
					player.timer = 3
					player.spr = 1
					sfx(c+2,c)
				end
			elseif(player.spr == 1) then
				player.spr = 0
				player.timer = 3
			elseif(player.spr == 0) then
				player.spr = 1
				player.timer = 3
			end
		end
	end
end

function killplayer(player)
	player.spr = 4
	player.lives = player.lives - 1
	waiting = 120
	removebomb(player1.bomb)
	removebomb(player2.bomb)
	sfx(-1,0)
	sfx(-1,1)
	sfx(8,2)
	sfx(-1,3)
end

function checkcpuwalk(dr)
	local center = flr((player2.x+3)/4)+1
	local y = flr(player2.y / 4)
	
	if(dr == -1 and not
		(grid[center][y+2] or
		 grid[center][y+1]) and not
		 (grid[center-1][y+2] or
		 grid[center-1][y+1])) then
			playercpu.dr = dr * -1
	elseif(dr == 1 and not
		(grid[center][y+2] or
		 grid[center][y+1]) and not
		 (grid[center+1][y+2] or
		 grid[center+1][y+1])) then
			playercpu.dr = dr * -1
	end
end

function cpuwalk()
	local dr = playercpu.dr
	player2.x=player2.x+dr
	checkcpuwalk(dr)
end

function moveplayer(player, c)
	if(player.spr == 4) then return end
	local left = flr((player.x+1)/4)+1
	local right = flr((player.x+6)/4)+1
	local center = flr((player.x+3)/4)+1
	local y = flr(player.y / 4)
	if(not (grid[left][y+1] or grid[right][y+1] or grid[center][y+1])) then
		player.y=player.y+4
		if(player.y>122) then killplayer(player) end
		return
	end

	if(player.spr > 1) then return end
	if(c==1 and cpu) then
		cpuwalk()
	elseif(btn(0,c)) then 
		player.x=player.x-1
		if(btnp(0,c)) then
			player.timer = 3
			player.spr = 1
			sfx(c+2,c)
		end
	elseif(btn(1,c)) then 
		player.x=player.x+1
		if(btnp(1,c)) then
			player.timer = 3
			player.spr = 1
			sfx(c+2,c)
		end
	else 
		player.spr = 0 
		player.timer = 0
		sfx(-1,c)
	end
	
	left = flr((player.x+1)/4)+1
	right = flr((player.x+6)/4)+1
	if(grid[left][y]) then
		if(not grid[left][y-1]) then
			player.y=player.y-4
		else	player.x=player.x+1 end
	end
	if(grid[right][y]) then 
		if(not grid[right][y-1]) then
			player.y=player.y-4
		else	player.x=player.x-1 end
	end
end

function movebomb(player,c)
	local bomb = player.bomb
	if(not bomb.visible) return
	bomb.x = bomb.x + bomb.vx
	bomb.y = bomb.y + bomb.vy
	bomb.vy = bomb.vy + gravity
	if(bomb.vy > 4) then bomb.vy = 4 end
	if(bomb.y>116 or bomb.x<-4 or bomb.x>128) then removebomb(bomb) return end

	local left = flr(bomb.x/4)+1
	local right = flr((bomb.x+3)/4)+1
	local bottom = flr(bomb.y/4)
	local top = flr((bomb.y-3)/4)
	
	removegrid(left, bottom, bomb, c)
	removegrid(left, top, bomb, c)
	removegrid(right, bottom, bomb, c)
	removegrid(right, top, bomb, c)
end

function removebomb(bomb)
	bomb.vx = 0
	bomb.vy = 0
	bomb.visible = false
end

function removegrid(x,y,bomb,c)
	if(grid[x]==nil) then return end
	if(grid[x][y]) then
		grid[x][y] = false
		removebomb(bomb)
		sfx(4+c,c+2)
	end
end

function playercollide(player,bomb)
	local pleft = player.x + 1
	local pright = player.x + 6
	local ptop = player.y + 7
	local pbottom = player.y
	
	local bleft = bomb.x
	local bright = bomb.x + 3
	local btop = bomb.y + 3
	local bbottom = bomb.y
	
	if(not bomb.visible) then return end
	if(bleft < pright and
		bright > pleft and
		bbottom < ptop and
		btop > pbottom) then
			killplayer(player)
			player.vy = -2.5
	end
end

function deadplayer(player)
	if(player.spr == 4) then
		player.y = player.y + player.vy
		if(player.y > 122) then player.y = 122 return end
		player.vy = player.vy + gravity
	end
end

function cpucharge()
	local bomb = player2.bomb
	if(playercpu.bombtimer > 0) then
		player2.spr = 2
		if(bomb.vy < -3.18) then return end
		bomb.vx = bomb.vx + vxcharge * -1
		bomb.vy = bomb.vy - vycharge
	elseif(playercpu.bombtimer == 0) then
		sfx(-1,1)
		sfx(7,3)
		player2.spr = 3
		player2.timer = 2
		bomb.x = player2.x+2
		bomb.y = player2.y-11
		bomb.visible = true
	end
end

function chargeshot(player, c)
	if(c==0 and titlebuffer) then
		if(not (btn(4,0) or btn(5,0))) then
			titlebuffer = false
		end
		return
	end
	local bomb = player.bomb
	if(cpu and c==1) then 
		cpucharge() 
		return 
	elseif(button(c) and player.spr < 3 and not bomb.visible) then
		player.spr = 2
		if(bomb.vy < -3.18) then return end
		if(bomb.vx == 0) then
			sfx(c,c)
		end
		bomb.vx = bomb.vx + (vxcharge * (1 + (-2 * c)))
		bomb.vy = bomb.vy - vycharge
	elseif(player.spr == 2 and not button(c)) then
		sfx(-1,c)
		sfx(c+6,c+2)
		player.spr = 3
		player.timer = 2
		bomb.x = player.x+2
		bomb.y = player.y-11
		bomb.visible = true
	end
end

function button(c)
	return btn(4,c) or btn(5,c)
end

function cputimers()
	if(not cpu) then return end
	if(playercpu.bombtimer > -1) then
		playercpu.bombtimer = playercpu.bombtimer - 1
		if(playercpu.bombtimer == -1) then
			player2.timer = 3
			player2.spr = 1
			sfx(3,1)
		end
	end
	playercpu.walktimer = playercpu.walktimer - 1
	if(playercpu.walktimer == 0) then
		walktimer()
		playercpu.dr = playercpu.dr * -1
		if(not player2.bomb.visible and playercpu.bombtimer == -1) then
			playercpu.bombtimer = flr(7.5*sqrt((player2.x-player1.x)))
			sfx(1,1)
		end
	end
end

function drawplayfield()
	local x = 1
	while x <= #grid do
		local y = 1
		local ln = grid[x]
		while y <= #ln do
			if(ln[y]) rectfill((x-1)*4, (y-1)*4, x*4 - 1, y*4 - 1, 10)
			y = y + 1
		end
	x = x + 1
	end
end

function drawplayers()
	spr(player1.spr, player1.x, player1.y-10, 1, 2)
	pal(8, 3)
	pal(14, 11)
	spr(player2.spr, player2.x, player2.y-10, 1, 2, true, false)
	pal()
end

function drawbombs()
	local bomb1 = player1.bomb
	local bomb2 = player2.bomb
	if(bomb1.visible) then
		rectfill(bomb1.x,bomb1.y,bomb1.x+3,bomb1.y-3,9)
	end
	if(bomb2.visible) then
		rectfill(bomb2.x,bomb2.y,bomb2.x+3,bomb2.y-3,9)
	end
end

function drawscores()
	local score1=9-player2.lives
	local score2=9-player1.lives
	local p1win = "player 1 wins"
	local p2win = "player 2 wins"
	
	print(score1,22,118,8)
	print(score1,22,117,14)
	print(score2,102,118,3)
	print(score2,102,117,11)
	
	if(score1 == 9) then
		print(p1win, 38, 40, 8)
		print(p1win, 38, 39, 14)
	elseif(score2 == 9) then
		print(p2win, 38, 40, 3)
		print(p2win, 38, 39, 11)
	end
end

function drawtitle()
	local x = 44
	local y = 45
	spr(5,x,y+1,5,2)
	pal(9, 10)
	spr(5,x,y,5,2)
	
	spr(0,x-1,y+14,1,2)
	pal(8, 3)
	pal(14, 11)
	spr(0,x+32,y+14,1,2,true)
	pal()
	
	local select = "‹ 2 player game ‘"
	local start = "Ž/— to start"
	if(cpu) then
		select = "‹ 1 player game ‘"
	end
	print(select,x-18,y+26,5)
	print(select,x-18,y+25,7)
	print(start,x-8,y+33,5)
	print(start,x-8,y+32,7)
end

function _draw()
	cls(0)
	if(title) then
		drawtitle()
		return
	end
	drawplayfield()
	drawbombs()
	drawplayers()
	rectfill(0, 112, 128, 128, 1)
	drawscores()
end
