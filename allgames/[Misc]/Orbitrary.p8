--metaact

function actgame()
t+=1
if btn(—)==false and btn(Ž)==false then
btns=0
end



if defeat==false then
for i=1,#po do
if pdead[i]==false then
	pinv[i]=max(pinv[i]-1,0)
	
	
	if btn(pbtn1[i]) and btns==0 then
	pr[i]=max(pr[i]-2,16)
	elseif btn(pbtn2[i]) and btns==0 then
	pr[i]=min(pr[i]+2,48)
	elseif pr[i]!=32 then
	pr[i]-=2*sgn(pr[i]-32)
	end
	
	if mode==3 then
	po[i]+=((1/10+0.02*pch[i])*1/pr[i])%1
	if i==1 then
	race-=((1/10+0.02*pch[i])*1/pr[i])%1
	else
	race+=((1/10+0.02*pch[i])*1/pr[i])%1
	end
	else
	po[i]+=(1/7*1/pr[i])%1
	end
	
	px[i]=-pr[i]*sin(po[i])+64
	py[i]=-pr[i]*cos(po[i])+64
	
	if t%3==0 then
	rand=rnd()
	if pshield[i] then
	makeparticle(px[i],py[i],0.05*sin(rand),0.05*cos(rand),120,7)
	else
	makeparticle(px[i],py[i],0.05*sin(rand),0.05*cos(rand),120,pcolor[i])
	end
	end
	
	if mode==3 then
		pch[i]=min(pch[i],10)
	else
		if pch[i]>=10 then
		pch[i]-=10
		if pshield[i] then
		score+=5
		sfx(3,0)
		maketext("+5 bONUS",px[i]-12,py[i])
		else
		pshield[i]=true
		sfx(3,0)
		maketext("sHIELD UP",px[i]-16,py[i])
		end
		end
	end
end
end

rcharge+=1
if mode==3 then

if rcharge>=30+10*#rng then
rand1=rnd()
rand2=16*ceil(rnd(3))
makering(rand1,rand2)
makering(rand1+0.5,rand2)
rcharge=0
end

if t%90==0 then
rand1=rnd()
makemeteor(rand1)
makemeteor(rand1+0.5)
end

if t%180==0 and pch[1]+pch[2]>=5 then
rand=rnd()
makethunder(rand,0.125,100)
makethunder(rand+0.5,0.125,100)
end

if race<0 then
pdead[2]=true
makeexplode(px[2],py[2])
defeat=true
btns=1
rng={}
winner=1
wins[1]+=1
t=0
sfx(5,3)
end

if race>1 then
pdead[1]=true
makeexplode(px[1],py[1])
defeat=true
btns=1
rng={}
winner=2
wins[2]+=1
t=0
sfx(5,3)
end

else

if rcharge>=30+10*#rng then
makering(rnd(),16*ceil(rnd(3)))
rcharge=0
end

if t%181==0 and dif>=10 then
makethunder(rnd(),0.125+dif*0.002,100)
end

mtrcharge+=1
if mtrcharge>=180/(1+dif*0.02) then
makemeteor(rnd())
mtrcharge=0
end

if dif>=nextast*20 then
makeasteroid(rnd(),48-16*((nextast-1)%3))
nextast+=1
end

end


else
	if btns==0 and t>30 then
	if btn(—) then
	startgame()
	end
	if btn(Ž) then
	startmenu()
	end
	end
end

foreach(rng,actring)
foreach(cmt,actcomet)
foreach(mtr,actmeteor)
foreach(tdr,actthunder)
foreach(ast,actasteroid)
foreach(prt,actparticle)
foreach(exp,actexplode)
foreach(txt,acttext)

end


function actmenu()
if id==0 then

	if btn(—)==false and btn(Ž)==false then
	btns=0
	end
	if btnp(”) then
	sel=(sel-1)%#opt
	sfx(0)
	end
	if btnp(ƒ) then
	sel=(sel+1)%#opt
	sfx(0)
	end
	
	if btnp(Ž) and btns==0 then
		sfx(0)
		if sel==0 then
		mode=1
		startgame()
		else
		id=sel
		t=0
		end
		if sel==1 then
		mode=2
		end
		if sel==2 then
		page=1
		end
	end
	
	ardx=61-2*#tostr(opt[sel+1])
	ardy=sel*6+50
elseif id==1 then

	if p2ready then
		if btnp(‘) then
		p2ready=false
		end
	else
		if btnp(‹) then
		p2ready=true
		sfx(0)
		end
	end
	
	if p1ready then
		if btnp(—) then
		p1ready=false
		end
	else
		if btnp(Ž) then
		p1ready=true
		sfx(0)
		end
		if btnp(—) then
		id=0
		p1ready=false
		p2ready=false
		mode=1
		end
	end
	
	if btnp(”) or btnp(ƒ) then
	mode=(mode-1)%2+2
	end
	
	if p1ready and p2ready then
	t-=1
	if t==0 then
	startgame()
	end
	else
	t=180
	end
	
elseif id==2 then

	if btnp(‘) then
	page+=1
	sfx(0)
	if page>#help then
	id=0
	end
	end
	
	if btnp(‹) then
	page-=1
	sfx(0)
	if page<1 then
	id=0
	end
	end
	
	if btnp(—) then
	sfx(0)
	id=0
	end

elseif id==3 then
	if btnp(—) then
	id=0
	end
	if btnp(Ž) then
	t+=1
	sfx(0,1)
	end
	if t==11 then
	t=0
	dset(1,0)
	dset(2,0)
	sfx(3,1)
	end
elseif id==4 then
	if btnp(—) then
	id=0
	end
	
end
	arx=(arx+ardx)/2
	ary=(ary+ardy)/2
	foreach(bll,actball)
end
