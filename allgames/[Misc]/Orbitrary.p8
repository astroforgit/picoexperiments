--metadraw

function drawgame()
cls(0)
cvy=cvy+0.5*(0-cy-cvy)
cvx=cvx+0.5*(0-cx-cvx)
cy+=cvy
cx+=cvx
camera(f(cx),f(cy))
circfill(64,64,64,1)

fillp(plnp[pln2])
circfill(64,64,8,plno[pln1]+16*plni[pln1])
fillp()


if mode!=3 then
rectfill(64+2*#tostr(score),64+3,64-2*#tostr(score),64-3,plno[pln1])
print(score,65-2*#tostr(score),62,plni[pln1])
end
circ(64,64,16,2)
circ(64,64,32,2)
circ(64,64,48,2)


foreach(rng,drawringback)
foreach(prt,drawparticle)
foreach(exp,drawexplode)
for i=1,#po do
	if pdead[i]==false then
	
	if t<=180 and defeat==false then
	if i==1 then
	print("x",
	64-40*sin(po[i])-1,
	64-40*cos(po[i])-2,pcolor[i])
	
	print("z",
	64-24*sin(po[i])-1,
	64-24*cos(po[i])-2,pcolor[i])
	
	line(64-28*sin(po[i]),
	64-28*cos(po[i]),
	64-36*sin(po[i]),
	64-36*cos(po[i]),pcolor[i])
	
	line(64-16*sin(po[i]),
	64-16*cos(po[i]),
	64-20*sin(po[i]),
	64-20*cos(po[i]),pcolor[i])
	
	line(64-44*sin(po[i]),
	64-44*cos(po[i]),
	64-48*sin(po[i]),
	64-48*cos(po[i]),pcolor[i])
	else
	
	print("‘",
	64-40*sin(po[i])-3,
	64-40*cos(po[i])-2,pcolor[i])
	
	print("‹",
	64-24*sin(po[i])-3,
	64-24*cos(po[i])-2,pcolor[i])
	
	line(64-28*sin(po[i]),
	64-28*cos(po[i]),
	64-36*sin(po[i]),
	64-36*cos(po[i]),pcolor[i])
	
	line(64-16*sin(po[i]),
	64-16*cos(po[i]),
	64-20*sin(po[i]),
	64-20*cos(po[i]),pcolor[i])
	
	line(64-44*sin(po[i]),
	64-44*cos(po[i]),
	64-48*sin(po[i]),
	64-48*cos(po[i]),pcolor[i])
	end
	end
	
	if pinv[i]%2==0 then
	circfill(f(px[i]),f(py[i]),2,pcolor[i])
	end
	if pshield[i] then
	circ(f(px[i]),f(py[i]),2,7)
	end
	for o=1,pch[i] do
	circfill(f(px[i]-5*sin(t*0.01+o*0.1)),f(py[i]-5*cos(t*0.01+o*0.1)),1,7)
	end
	end
end


if mode==3 and defeat==false and t%4<=1 then
if race<0.1 then
line(64,
	64,
	64-64*sin(po[1]),
	64-64*cos(po[1]),pcolor[1])
end
if race>0.9 then
line(64,
	64,
	64-64*sin(po[2]),
	64-64*cos(po[2]),pcolor[2])
end
end

foreach(rng,drawringfront)
foreach(cmt,drawcomet)
foreach(mtr,drawmeteor)
foreach(ast,drawasteroid)
foreach(tdr,drawthunder)
foreach(txt,drawtext)

if defeat==true then
	if t<=1 then
	cls(7)
	end
	rectfill(64-28,64-10,64+28,64+10,0)
	if mode==3 then
	print("p"..winner.." wins!",64-13,64-9,7)
	print("p1:"..wins[1],64-24,64-3,8)
	print("p2:"..wins[2],64-24,64+3,12)
	else
	print("game over",64-17,64-9,7)
	print("score:"..score,64-24,64-3,7)
	if newhigh then
	print("new highscore!",64-27,64+3,7)
	else
	print("highscore:"..dget(mode),64-27,64+3,7)
	end
	end
	rectfill(64-16,64-10+25,64+16,64+27,0)
	print("x: retry",49,80,7)
	print("z: quit",49,86,7)
end
end


function drawmenu()
cls()

circfill(64,64,25,1)
foreach(bll,drawball)
if id==0 then

	for i=1,#opt do
	print(opt[i],65-2*#tostr(opt[i]),44+i*6,7)
	end
	print("”zƒ",55,83,0)
	print(">",f(arx),f(ary),7)
	print("<",126-f(arx),f(ary),7)
	
elseif id==1 then

	print("mode:",57,43,7)
	if mode==2 then
	print("coop",57,50,7)
		if t==180 then
		print("get a ",53,62,7)
		print("highscore",47,68,7)
		end
	else
	print("deathmatch",45,50,7)
		if t==180 then
		print("overtake",49,62,7)
		print("your foe",49,68,7)
		end
	end
	print("”ƒ",57,56,0)
	if p1ready then
	print("p1:z",45,75,7)
	else
	print("p1:z",45,75,0)
	end
	if p2ready then
	print("p2:‹",65,75,7)
	else
	print("p2:‹",65,75,0)
	end
	if p1ready and p2ready then
	print("start in "..ceil(t/60),45,62,7)
	end
	print("x",63,83,0)
	
elseif id==2 then
	
	print(page.."/7",59,44,7)
	for i=1,#help[page] do
	print(sub(help[page],i,i),45+((i-1)%10)*4,50+6*flr((i-1)/10),7)
	end
	print("‹x‘",55,83,0)
	
elseif id==3 then

	print("single:"..dget(1),43,54,7)
	print("coop:"..dget(2),43,60,7)
	for i=1,10 do
	if i<=t then
	print(sub("z to reset",i,i),41+i*4,70,8)
	else
	print(sub("z to reset",i,i),41+i*4,70,7)
	end
	end
	print("x",63,83,0)

elseif id==4 then

	print("made by",51,45,7)
	print("aimainiac",47,51,7)
	print("ld 47:",53,59,7)
	print("stuck in",49,65,7)
	print("a loop",53,71,7)
	print("x",63,83,0)

end
end
