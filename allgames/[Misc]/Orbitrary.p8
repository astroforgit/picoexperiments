function _init()
--[[
have some ice cream
  _
 ( )
(_v_)
	\ /
	 v
	 
because you are epic!
]]
cartdata("aimainiacsorbitrary")
cx=0
cy=0
cvx=0
cvy=0
plno={10,15,11,14,6,9,7}
plni={9 ,4 ,3 ,2 ,5,4,6}
plnp={0b1111000011110000,
      0b1010010110100101,
      0b1100011000111001,
      0b1010000110100100,
      0b0100101000100101,
      0b1101010000101011}

startmenu()
end



function _update60()
act()
wipe=max(wipe-2,0)
end


function _draw()

draw()
if wipe>0 then
circfill(64,64,wipe,0)
end
end


-->8
--tools
function f(n)
return flr(n+0.5)
end


function shake(q)
rand=rnd()
cx=sin(rand)*q
cy=cos(rand)*q
end


function fail(g)
if pdead[g]==false and pinv[g]==0 then
makeexplode(px[g],py[g])
	if pshield[g] then
	pshield[g]=false
	pch[g]=0
	pinv[g]=60
	else
	if mode==3 then
	pch[g]=max(0,pch[g]-3)
	pinv[g]=60
	else
	pdead[g]=true
	sfx(5,3)
	end
	check=true
		for i=1,#po do
		if pdead[i]==false then
		check=false
		end
		end
	if check then
	defeat=true
	t=0
	rng={}
	btns=1
	if mode!=3 and score>dget(mode) then
	newhigh=true
	dset(mode,score)
	end
	end
	end
end

end


function checkcol(x1,y1,w1,h1,x2,y2,w2,h2)
if x2<x1+w1 and
x1<x2+w2 and
y2<y1+h1 and
y1<y2+h2 then
return true
else
return false
end
end


function startgame()
score=0
newhigh=false
dif=0
defeat=false
t=0
btns=1
rcharge=0
mtrcharge=0
race=0.5
nextast=1
if mode==1 then
po={0}
pr={32}
px={-pr[1]*sin(po[1])+64}
py={-pr[1]*cos(po[1])+64}
pinv={0}
pshield={false}
pch={0}
pdead={false}
pbtn1={4}
pbtn2={5}
pcolor={8}
else
po={0,0.5}
pr={32,32}
px={-pr[1]*sin(po[1])+64,-pr[2]*sin(po[2])+64}
py={-pr[1]*cos(po[1])+64,-pr[2]*cos(po[2])+64}
pinv={0,0}
pshield={false,false}
pch={0,0}
pdead={false,false}
pbtn1={4,0}
pbtn2={5,1}
pcolor={8,12}
end
rng={}
cmt={}
mtr={}
ast={}
tdr={}
prt={}
exp={}
txt={}
pln1=ceil(rnd(#plno))
pln2=ceil(rnd(#plnp))
act=actgame
draw=drawgame
end


function startmenu()
wipe=53
opt={"single","multi","help/tips","highscore","credits"}
--     00000000001111111111222222222233333333334444444444
help={"hold x to go outward and z to  go inward",
						"go through rings to   score     points",
						"avoid the  meteors, asteroids,   and    lightning",
						"build up ashield by   flying   through    rings",
						"the closeryou are tothe planetthe fasteryou orbit",
						"  adjust  your speed to dodge lightning",
						"  smash   asteroids  to bits  with your   shield"}
arx=49
ary=50
ardx=49
ardy=50
sel=0
id=0
page=0
p1ready=false
p2ready=false
t=0
btns=1
bll={}
wins={0,0}
act=actmenu
draw=drawmenu
cls()
print("orbitrary",0,0,7)
for x=0,36 do for y=0,4 do
if pget(x,y)==7 then
makeball(x*0.02-0.5,50-y*5)
end
end end
end
-->8
--make



function makering(o,r)
a={}
a.o=o
a.r=r
a.x=0
a.y=0
a.t=0
a.s=5
a.c=10
a.ready={}
for i=1,#po do
add(a.ready,1)
end
a.done=false
add(rng,a)
end


function makecomet(o,r)
a={}
a.x=64-64*sin(o)
a.y=64-64*cos(o)
a.dx=-1.25*sin(r)
a.dy=-1.25*cos(r)
a.t=360
a.p=30
a.o=o
a.r=r
add(cmt,a)
end

function makemeteor(o)
a={}
a.t=0
a.o=o
a.h=60
add(mtr,a)
end

function makeasteroid(o,r)
a={}
a.o=o
a.r=r
a.p=60
add(ast,a)
end

function makethunder(o,e,ch)
a={}
a.t=0
a.o=o
a.e=e/2
a.ch=ch
add(tdr,a)
end

function makeparticle(x,y,dx,dy,t,c)
a={}
a.x=x
a.y=y
a.dx=dx
a.dy=dy
a.t=t
a.c=c
add(prt,a)
end


function makeexplode(x,y)
a={}
a.x=x
a.y=y
a.c=8
a.t=0
shake(5)
sfx(1,1)
add(exp,a)
end


function makeball(o,r)
a={}
a.o=o
a.r=r
add(bll,a)
end


function maketext(n,x,y)
a={}
a.t=0
a.n=n
a.x=x
a.y=y
add(txt,a)
end
-->8
--act




function actring(g)
g.t+=1
if g.t>60 then
if g.done then
	g.s+=0.5
else
	for i=1,#po do
		if g.ready[i]==2 and (g.o-po[i])%1>0.25 then
		g.done=true
		score+=1
		dif+=1
		g.c=11
		pch[i]+=1
		if pch[i]<10 or mode==3 then
		sfx(2,0)
		end
		end
		if g.done!=true then
		if (g.o-po[i])%1<0.25 and g.r==pr[i] then
		g.ready[i]=2
		else
		g.ready[i]=1
		end
		end
	end
end
end

if g.t<60 then
	if g.t%9<=2 then
	g.c=0
	elseif g.t%9<=5 then
	g.c=4
	else
	g.c=9
	end
end

if g.t==60 then
g.c=10
end

if g.s==10 then
del(rng,g)
end
g.o+=(1/(100*g.r))%1
end


function actcomet(g)

if g.p==0 then
g.t-=1
g.dy=g.dy+0.001*(64-g.y-g.dy)
g.dx=g.dx+0.001*(64-g.x-g.dx)

g.x+=g.dx
g.y+=g.dy
if g.t==0 then
del(cmt,g)
end
else
g.p-=1
end
end

function actmeteor(g)
g.t+=1
g.x=64-g.h*sin(g.o)
g.y=64-g.h*cos(g.o)

if g.t>60 then
	rand1=rnd()
	rand2=rnd(16)
	makeparticle(g.x-sqrt(rand2)*sin(rand1),g.y-sqrt(rand2)*cos(rand1),0,0,30,9)
	g.h-=0.5
	if g.h==10 then
	del(mtr,g)
	makeexplode(f(g.x),f(g.y))
	end
	for i=1,#po do
	if pdead[i]==false and checkcol(px[i]-2,py[i]-2,5,5,g.x-4,g.y-4,9,9) then
	fail(i)
	del(mtr,g)
	end
	end
end
end

function actasteroid(g)
g.x=64-g.r*sin(g.o)
g.y=64-g.r*cos(g.o)
	if g.p==0 then
	g.o-=(1/(15*g.r))%1
	for i=1,#po do
	if checkcol(px[i]-2,py[i]-2,5,5,g.x-2,g.y-2,5,5) then
	fail(i)
	for i=1,10 do
	rand1=rnd(0.25)
	rand2=rnd(0.25)+0.25
	makeparticle(g.x,
	g.y,
	rand2*sin(g.o+rand1-0.125+0.25),
	rand2*cos(g.o+rand1-0.125+0.25),
 ceil(rnd(30))+120,4)
	end
	del(ast,g)
	end
	end
else
	g.p-=1
end
end

function actthunder(g)
g.t+=1
if g.t==g.ch then
	for i=1,#po do
		if (po[i]-g.o-0.5)%1-0.5-g.e<=0
		and (po[i]-g.o-0.5)%1-0.5+g.e>=0 then
		fail(i)
		end
	end
	sfx(4,2)
	for i=0,299 do
		rand1=sqrt(rnd(64^2))
		rand2=rnd(g.e*2)-g.e+g.o
		makeparticle(64-rand1*sin(rand2),64-rand1*cos(rand2),0,0,ceil(rnd(60)),7)
		shake(10)
	end
del(tdr,g)
end
end



function actparticle(g)
g.t-=1
g.x+=g.dx
g.y+=g.dy
if g.t==0 then
del(prt,g)
end
end


function actexplode(g)
g.t+=1
if g.t==3 then
g.c=2
end
if g.t==5 then
g.c=0
end
if g.t==7 then
del(exp,g)
end
end


function actball(g)
g.o+=0.001
g.o%=1
end

function acttext(g)
g.t+=1
g.y-=0.5
if g.t==60 then
del(txt,g)
end
end
