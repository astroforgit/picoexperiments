--draw


function drawringfront(g)
g.x=64-g.r*sin(g.o)
g.y=64-g.r*cos(g.o)

line(
f(g.x-g.s*sin(g.o+0)),
f(g.y-g.s*cos(g.o+0)),
f(g.x-(g.s/2)*sin(g.o+0.25)),
f(g.y-(g.s/2)*cos(g.o+0.25)),g.c)
line(
f(g.x-g.s*sin(g.o+0.5)),
f(g.y-g.s*cos(g.o+0.5)))
end


function drawringback(g)
g.x=64-g.r*sin(g.o)
g.y=64-g.r*cos(g.o)

line(
f(g.x-g.s*sin(g.o+0)),
f(g.y-g.s*cos(g.o+0)),
f(g.x-(g.s/2)*sin(g.o+0.75)),
f(g.y-(g.s/2)*cos(g.o+0.75)),g.c)
line(
f(g.x-g.s*sin(g.o+0.5)),
f(g.y-g.s*cos(g.o+0.5)))
end



function drawcomet(g)
if g.p==0 then
circfill(f(g.x),f(g.y),2,4)
else
x1=g.x-10*sin(g.r)
y1=g.y-10*cos(g.r)
line(f(g.x),f(g.y),f(g.x-10*sin(g.r)),f(g.y-10*cos(g.r)),8)
line(f(x1),f(y1),f(x1-4*sin(g.r+0.125*3)),f(y1-4*cos(g.r+0.125*3)))
line(f(x1),f(y1),f(x1-4*sin(g.r+0.125*5)),f(y1-4*cos(g.r+0.125*5)))
end
end

function drawmeteor(g)
if g.t>60 then
circfill(f(g.x),f(g.y),4,4)
else
--line(64,64,g.x,g.y,8)
if g.t%8>=3 then
circ(f(64-g.h*sin(g.o)),f(64-g.h*cos(g.o)),4,8)
print("!",f(g.x-1),f(g.y-2),8)
else
circ(f(64-g.h*sin(g.o)),f(64-g.h*cos(g.o)),4,10)
print("!",f(g.x-1),f(g.y-2),10)
end
end
end

function drawthunder(g)
if g.t%4>=1 then
line(
f(64-64*sin(g.o+g.e)),
f(64-64*cos(g.o+g.e)),
f(64-8*sin(g.o+g.e)),
f(64-8*cos(g.o+g.e)),7)
line(
f(64-64*sin(g.o-g.e)),
f(64-64*cos(g.o-g.e)),
f(64-8*sin(g.o-g.e)),
f(64-8*cos(g.o-g.e)),7)
else
line(
f(64-64*sin(g.o+g.t*g.e/g.ch)),
f(64-64*cos(g.o+g.t*g.e/g.ch)),
f(64-8*sin(g.o+g.t*g.e/g.ch)),
f(64-8*cos(g.o+g.t*g.e/g.ch)),7)
line(
f(64-64*sin(g.o-g.t*g.e/g.ch)),
f(64-64*cos(g.o-g.t*g.e/g.ch)),
f(64-8*sin(g.o-g.t*g.e/g.ch)),
f(64-8*cos(g.o-g.t*g.e/g.ch)),7)
end
end

function drawasteroid(g)
if g.p==0 then
circfill(f(g.x),f(g.y),2,4)
else
circ(g.x,g.y,g.p,8)
end
end

function drawparticle(g)
pset(f(g.x),f(g.y),g.c)
end

function drawexplode(g)
circfill(g.x,g.y,10,g.c)
end


function drawball(g)
circfill(f(64-g.r*sin(g.o)),f(64-g.r*cos(g.o)),2,7)
end

function drawtext(g)
print(g.n,g.x,g.y,7)
end
