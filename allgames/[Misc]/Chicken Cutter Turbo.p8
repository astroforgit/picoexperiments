pico-8 cartridge // http://www.pico-8.com
version 14
__lua__
--chicken cutter turbo

--game by remagamer

--hey does anybody know how to do better chicken code?
--based on a dumb in joke

--player variables
function initialize()
 --reset all game variables.
 px=16 -- player x
 py=16 -- player y
 ps=0 -- player sprite counter
 cx=16 -- collision check x
 cy=16 -- collision check y
 co=0 -- collision outcome
 pcx=1 -- player cel
 pcy=1 -- player cel
 --system variables
 ms=0 -- menu select. 1 or 2 player.
 tt=0 -- gamestatus 0-title 1-gameplay 2-gameover
 scr=0 -- keys collected
 kx=112 --key x
 ky=112 --key y
 tick=0 --timer tick.
 tim=45 --default time.
 hnd=1 --handicap.
 --chicken variables
 c1d=0 --chicken 1 delay
 c2d=0 --chicken 2 delay
 c3d=0 --chicken 3 delay
 crg=0 --rng number.
 c1x=8
 c1y=64
 c2x=112
 c2y=64
 c3x=64
 c3y=64
 csc=0
 tc1x=8 --collision checks for chickens.
 tc1y=64
 tc2x=112
 tc2y=64
 tc3x=64
 tc3y=64
 tcsc=0
 --2player variables
 ptwo=1 -- active chicken.
 tcx=8 --active chicken collide x
 tcy=64 --active chicken collide y
 acx=8 --active chicken x
 acy=64 --active chicken y
 cpr=0 --button limiter for change button
end

initialize()

function _update()

 if (tt==3) then --2p gameplay
  --reset cx/yy and tcx/tcy and acx/acy
  cx=px
  cy=py
  if ptwo==1 then
   tcx=c1x
   tcy=c1y
   acx=c1x
   acy=c1y
  end
  if ptwo==2 then
   tcx=c2x
   tcy=c2y
   acx=c2x
   acy=c2y
  end
  if ptwo==3 then
   tcx=c3x
   tcy=c3y
   acx=c3x
   acy=c3y
  end
  --redundant check for collision
  if cx==c1x and cy==c1y then
   co=2
  end
  if cx==c2x and cy==c2y then
   co=2
  end
  if cx==c3x and cy==c3y then
   co=2
  end
  --get p1 check coords
  if (btnp(0)) then
   cx=px-8 
   sfx(3,-1)
  end
  if (btnp(1)) then
   cx=px+8
   sfx(3,-1)
  end
  if (btnp(2)) then
   cy=py-8
   sfx(3,-1)
  end
  if (btnp(3)) then
   cy=py+8
   sfx(3,-1)
  end
  --get player 2 check coords
  if btnp(0,1) then
   tcx=acx-8 
   sfx(3,-1)
  end
  if btnp(1,1) then
   tcx=acx+8
   sfx(3,-1)
  end
  if btnp(2,1) then
   tcy=acy-8
   sfx(3,-1)
  end
  if btnp(3,1) then
   tcy=acy+8
   sfx(3,-1)
  end
  if btnp(4,1) then
   cpr=0 --accept only 1 if per press
   sfx(5,-1)
   if ptwo==3 and cpr==0 then
    ptwo=1
    tcx=c1x
    tcy=c1y
    cpr=1
   end
   if ptwo==2 and cpr==0 then
    ptwo=3
    tcx=c3x
    tcy=c3y
    cpr=1
   end
   if ptwo==1 and cpr==0 then
    ptwo=2
    tcx=c2x
    tcy=c2y
    cpr=1
   end
  end
  --collision check for p1
  pcx=cx/8
  pcy=cy/8
  co=0
  if mget(pcx,pcy)==1 or mget(pcx,pcy)==18 or mget(pcx,pcy)==34 or mget(pcx,pcy)==35 then
   co=1
  end
  if cx==c1x and cy==c1y then
   co=2
  end
  if cx==c2x and cy==c2y then
   co=2
  end
  if cx==c3x and cy==c3y then
   co=2
  end
  --enact consequences for p1
  if co==0 then
   px=cx
   py=cy
  end
  if co==2 then
   tt=4 -- chicken wins
  end
  
  --enact consequences for p2
  if collide(tcx,tcy)==0 then
   if ptwo==1 then
    c1x=tcx
    c1y=tcy
   end
   if ptwo==2 then
    c2x=tcx
    c2y=tcy
   end
   if ptwo==3 then
    c3x=tcx
    c3y=tcy
   end
  end
  --enemy movement.
  tc1x=c1x
  tc1y=c1y
  tc2x=c2x
  tc2y=c2y
  tc3x=c3x
  tc3y=c3y
  --chicken 1 2p
  --chicken 1 moves at random
  if ptwo==1 then
   --nothing here
  else
   if c1d>=15 then
    sfx(0,-1)
    c1d=0
    crg=flr(rnd(4))
    if crg==0 then
     tc1x=c1x+8
    end
    if crg==1 then
     tc1x=c1x-8
    end
    if crg==2 then
     tc1y=c1y+8
    end
    if crg==3 then
     tc1y=c1y-8
    end
    if collide(tc1x,tc1y)==0 then
     c1x=tc1x
     c1y=tc1y
    end
   else
    c1d=c1d+1
   end
  end
  --chicken 2 2p
  --chicken 2 moves at random
  if ptwo==2 then
   --nothing here
  else
   if c2d>=15 then
    sfx(0,-1)
    c2d=0
    crg=flr(rnd(4))
    if crg==0 then
     tc2x=c2x+8
    end
    if crg==1 then
     tc2x=c2x-8
    end
    if crg==2 then
     tc2y=c2y+8
    end
    if crg==3 then
     tc2y=c2y-8
    end
    if collide(tc2x,tc2y)==0 then
     c2x=tc2x
     c2y=tc2y
    end
   else
    c2d=c2d+1
   end
  end
  --chicken 3 2p
  --chicken 3 moves at random
  if ptwo==3 then
   --nothing here
  else
   if c3d>=15 then
    sfx(0,-1)
    c3d=0
    crg=flr(rnd(4))
    if crg==0 then
     tc3x=c3x+8
    end
    if crg==1 then
     tc3x=c3x-8
    end
    if crg==2 then
     tc3y=c3y+8
    end
    if crg==3 then
     tc3y=c3y-8
    end
    if collide(tc3x,tc3y)==0 then
     c3x=tc3x
     c3y=tc3y
    end
   else
    c3d=c3d+1
   end
  end
  --tick timer every second
  if tick==30 then
   tick=0
   scr=scr-1
  else
   tick=tick+1
  end
  --give victory to p1 if scr=0
  if scr==0 then
   tt=5
  end
 end --end of p2 gameplay
  
 if (tt==1) then --gameplay
  --reset cx/py
  cx=px
  cy=py
  --get check coords
  if (btnp(0)) then
   cx=px-8 
   sfx(3,-1)
  end
  if (btnp(1)) then
   cx=px+8
   sfx(3,-1)
  end
  if (btnp(2)) then
   cy=py-8
   sfx(3,-1)
  end
  if (btnp(3)) then
   cy=py+8
   sfx(3,-1)
  end
  -- collision check
  pcx=cx/8
  pcy=cy/8
  co=0
  if mget(pcx,pcy)==1 or mget(pcx,pcy)==18 or mget(pcx,pcy)==34 or mget(pcx,pcy)==35 then
   co=1
  end
  if cx==c1x and cy==c1y then
   co=2
  end
  if cx==c2x and cy==c2y then
   co=2
  end
  if cx==c3x and cy==c3y then
   co=2
  end
  if cx==kx and cy==ky then
   sfx(2,-1)
   scr=scr+1
   kx=8+flr(rnd(14))*8
   ky=8+flr(rnd(14))*8
  end
  --enact consequence
  if co==0 then
   px=cx
   py=cy
  end
  if co==2 then
   tt=2
  end
  --enemy movement.
  --chicken 1
  --chicken 1 moves at random
  if c1d>=23-hnd*3-scr/5 then
   sfx(0,-1)
   c1d=0
   crg=flr(rnd(4))
   if crg==0 then
    tc1x=c1x+8
   end
   if crg==1 then
    tc1x=c1x-8
   end
   if crg==2 then
    tc1y=c1y+8
   end
   if crg==3 then
    tc1y=c1y-8
   end
   if collide(tc1x,tc1y)==0 then
    c1x=tc1x
    c1y=tc1y
   end
  else
   c1d=c1d+1
  end
  --chicken 2
  --chicken 2 moves at random
  if c2d>=23-hnd*3-scr/5 then
   sfx(0,-1)
   c2d=0
   crg=flr(rnd(4))
   if crg==0 then
    tc2x=c2x+8
   end
   if crg==1 then
    tc2x=c2x-8
   end
   if crg==2 then
    tc2y=c2y+8
   end
   if crg==3 then
    tc2y=c2y-8
   end
   if collide(tc2x,tc2y)==0 then
    c2x=tc2x
    c2y=tc2y
   end
  else
   c2d=c2d+1
  end
  --chicken 3
  --chicken 3 moves at random
  if c3d>=23-hnd*3-scr/5 then
   sfx(0,-1)
   c3d=0
   crg=flr(rnd(4))
   if crg==0 then
    tc3x=c3x+8
   end
   if crg==1 then
    tc3x=c3x-8
   end
   if crg==2 then
    tc3y=c3y+8
   end
   if crg==3 then
    tc3y=c3y-8
   end
   if collide(tc3x,tc3y)==0 then
    c3x=tc3x
    c3y=tc3y
   end
  else
   c3d=c3d+1
  end
 end
 if tt==0 then
  --title stuff.
  if btnp(0) then
   ms=0
   sfx(3,-1)
  end
  if btnp(1) then
   ms=1
   sfx(3,-1)
  end
  if btnp(3) and ms==1 then
   if tim>=10 then
    sfx(5,-1)
    tim=tim-5
   else
    sfx(6,-1)
   end
  end
  if btnp(2) and ms==1 then
   if tim<=175 then
    sfx(5,-1)
    tim=tim+5
   else
    sfx(6,-1)
   end
  end
  if btnp(2) and ms==0 then
   if hnd<=6 then
    sfx(5,-1)
    hnd=hnd+1
   else
    sfx(6,-1)
   end
  end
  if btnp(3) and ms==0 then
   if hnd>=2 then
    sfx(5,-1)
    hnd=hnd-1
   else
    sfx(6,-1)
   end
  end
  if btnp(4) and ms==0 then
   tt=1
   sfx(1,-1)
  end
  if btnp(4) and ms==1 then
   tt=3
   sfx(4,-1)
   scr=tim
  end
 end
 if tt==2 then
  --gameover stuff.
  cls()
  print("you lose.",50,64)
  print("’score’",50,70)
  print(scr,66,76)
  print("press z to restart.",33,82)
  if btnp(4) then
   initialize()
  end
 end
end
function _draw()
 if tt==3 then --2p gp render
  cls()
  map(0,0,0,0)
  color(9)
  print("time remaining:",2,2)
  print(scr,61,2)
  -- player anims
  ps=ps+1
  if (ps<=5) then
   spr(3,px,py)
  else
   spr(2,px,py)
  end
  if (ps==10) then
   ps=0
  end
  -- enemy anims
  csc=csc+1
  if (csc<=5) then
   spr(5,c1x,c1y)
   spr(21,c2x,c2y)
   spr(37,c3x,c3y)
  else
   spr(6,c1x,c1y)
   spr(22,c2x,c2y)
   spr(38,c3x,c3y)
  end
  if (csc==10) then
   csc=0
  end
  --puts an icon over the active chicken
  if ptwo==1 then
   spr(50,c1x,c1y-8)
  end
  if ptwo==2 then
   spr(50,c2x,c2y-8)
  end
  if ptwo==3 then
   spr(50,c3x,c3y-8)
  end
 end
 if (tt==1) then --gp render
  --system render
  cls()
  map(0,0,0,0)
  color(9)
  print("keys collected:",2,2)
  print(scr,61,2)
  spr(17,kx,ky)
  -- player anims
  ps=ps+1
  if (ps<=5) then
   spr(3,px,py)
  else
   spr(2,px,py)
  end
  if (ps==10) then
   ps=0
  end
  -- enemy anims
  csc=csc+1
  if (csc<=5) then
   spr(5,c1x,c1y)
   spr(21,c2x,c2y)
   spr(37,c3x,c3y)
  else
   spr(6,c1x,c1y)
   spr(22,c2x,c2y)
   spr(38,c3x,c3y)
  end
  if (csc==10) then
   csc=0
  end
 end
 if tt==0 then --title render
  cls()
  color(7)
  sspr(56,0,32,32,0,0,128,128)
  if ms==0 then
   sspr(88,0,16,16,28,82,16,16)
   print("1 player mode!",10,75)
   print("”difficultyƒ:",7,81)
   print(hnd,66,81)
  end
  if ms==1 then
   sspr(88,0,16,16,76,82,16,16)
   print("2 player mode!",57,75)
   print("”timeƒ:",63,81)
   print(tim,98,81)
  end
 end
 if tt==4 then
  --p2 wins.
  cls()
  print("player 2 wins!",40,64)
  print("“time“",50,70)
  print(scr,62,76)
  print("press z to restart.",33,82)
  if btnp(4) then
   initialize()
  end
 end
 if tt==5 then
  --p1 wins.
  cls()
  print("player 1 wins!",40,64)
  print("“time“",50,70)
  print("0!",62,76)
  print("press z to restart.",33,82)
  if btnp(4) then
   initialize()
  end
 end
end
-->8
--additional functions
function collide(x,y)
 --this function takes am x/y
 --destination, tests it for
 --collision outcomes, and
 --returns a collision value.
 --0 = no collision
 --1 = collision with wall.
 --hopefully, this function
 --works for any object that
 --moves between cels.
 if mget(x/8,y/8)==1 or mget(x/8,y/8)==18 or mget(x/8,y/8)==34 or mget(x/8,y/8)==35 then
  return 1
 else
  return 0
 end
end 
