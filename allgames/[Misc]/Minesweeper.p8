pico-8 cartridge // http://www.pico-8.com
version 5
__lua__
--minesweeper
--by sophie kirschner
--sophiek@pineapplemachine.com
--zlib/libpng license
--http://opensource.org/licenses/zlib

--helpful consts
z=16
zz=256

--cursor
curstart=7+z*8
cur=curstart --pos
curtick=0 --animation
currate=10 --animation

--puzzle data
puz={}
tileseed=flr(rnd(32767))

--game state
state="intro"

--intro
inttime=0 --timer
introx=4 --pos
introy=7 --pos

--buttons
revealbtn=4
flagbtn=5

--difficulty settings
diff=2
diffmines={20,30,40,50}

--menu
menux=4
menuy=6
menuw=8
menuh=4
menusel=0
menuoptcount=3

--win/lose banner
victory="play"
bannertick=0
bwini=48
bwinw=2
blosei=50
blosew=3
banneri=bwini
bannerw=bwinw



function _init()
 cls()
end
function _update()
 if state=="intro" then
  updateintro()
 elseif state=="menu" then
  updatemenu()
  if victory!="play" then updatebanner() end
  curtick+=1
 elseif state=="play" then
  upcur()
  if victory!="play" then updatebanner() end
 end
end
function _draw()
 if state=="intro" then
  drawmap()
 elseif state=="menu" then
  drawmap()
  drawcursor()
  if victory!="play" then drawbanner() end
  drawmenu()
 elseif state=="play" then
  drawmap()
  drawcursor()
  if victory!="play" then drawbanner() end
 end
end



--check for win
function updatewinstate()
 if victory=="play" then
  win=true
  for i=1,zz do
   if puz[i]==0 or puz[i]==1 then
    win=false
    break
   end
  end
  if win then
   initbanner(true)
   victory="win"
  end
 end
end

--you lost
function updatelosestate()
 initbanner(false)
 victory="lose"
end

--banner
function drawbanner()
 screenh=128
 y=bannertick
 drawbannerat((y)%screenh)
 drawbannerat((y+16)%screenh)
 drawbannerat((y+32)%screenh)
 drawbannerat((y+48)%screenh)
 drawbannerat((y+64)%screenh)
 drawbannerat((y+80)%screenh)
 drawbannerat((y+96)%screenh)
 drawbannerat((y+112)%screenh)
end
function drawbannerat(y)
 bannerpixw=bannerw*8
 bannerx=(128-bannerpixw)/2
 palt(0, true)
 spr(banneri,bannerx,y,bannerw,1)
 if y+8>z*8 then drawbannerat(y-z*8) end
end
function updatebanner()
 bannertick+=1
end
function initbanner(win)
 if win then
  banneri=bwini
  bannerw=bwinw
 else
  banneri=blosei
  bannerw=blosew
 end
 bannertick=8
end
 
--menu
function drawmenu()
 palt(0,false)
 rx=menux*8
 ry=menuy*8
 rw=menuw*8-1
 rh=menuh*8-1
 rectfill(rx,ry,rx+rw,ry+rh,0)
 optx=menux*8+8
 opty=menuy*8
 spr(24,optx,opty   ,4,1) --return
 spr(40,optx,opty+8 ,3,1) --again
 spr(56,optx,opty+16,6,1) --difficulty
 spr(63,optx,opty+24) --decrease
 spr(44,optx+8,opty+24,diff,1) --current
 spr(62,optx+40,opty+24) --increase
 spr(55,optx-8,opty+menusel*8) --selection
end
function updatemenu()
 if btnp(2) then menusel-=1 end
 if btnp(3) then menusel+=1 end
 menusel %= menuoptcount
 action=btnp(4)
 back=btnp(5)
 if back or (menusel==0 and action) then --return
  state="play"
 elseif menusel==1 and action then --again
  newgame(true)
  state="play"
 elseif menusel==2 then --difficulty
  if btnp(0) then diff-=1 end
  if btnp(1) then diff+=1 end
  diff=max(1,min(diff,#diffmines))
 end
end

--draw cursor
function drawcursor()
 palt(0,true)
 curx=flr(cur/z)
 cury=cur%z
 curframe=14
 if curtick%(currate+currate)>=currate then curframe+=1 end
 spr(curframe,curx*8,cury*8)
end

--draw map
function drawmap()
 palt(0,false)
 map(0,0,0,0,z,z)
end

--lovely intro graphic
function updateintro()
 if inttime>=45 or btnp(4) then
  --intro is over
  pal()
  state="play"
  inttime=0
  newgame(false)
 else
  if inttime==0 then
   initintro()
   pal(7,9,1)  --white
   pal(6,9,1)  --lgray
   pal(13,9,1) --dgray
   pal(0,9,1)  --black
  elseif inttime==12 then
   pal(7,9,1)  --white
   pal(6,9,1)  --lgray
   pal(13,4,1) --dgray
   pal(0,4,1)  --black
  elseif inttime==16 then
   pal(7,10,1)  --white
   pal(6,15,1)  --lgray
   pal(13,13,1) --dgray
   pal(0,13,1)  --black
  elseif inttime==20 then
   pal(7,7,1)  --white
   pal(6,6,1)  --lgray
  end
  inttime+=1
 end
end
function initintro()
 --clearmap(12)
 puzmap()
 --draw intro
 for x=0,7 do
  mset(
   introx+x,
   introy,
   x+16
  )
  mset(
   introx+x,
   introy+1,
   x+32
  )
 end
end

--clear map tiles
function clearmap(t)
 for x=0,z-1 do
 for y=0,z-1 do
  mset(x,y,t)
 end
 end
end

--start a new game
function newgame(newtileseed)
 if newtileseed then tileseed=flr(rnd(32767)) end
 cur=curstart
 genpuz(diffmines[diff])
 puzmap()
 victory="play"
end

--set map tiles for puzzle
tiles={}
tiles[-3]=11 --revealed mine
tiles[-2]=12 --hidden mine
tiles[-1]=13 --flagged mine
tiles[ 0]=12 --unrevealed dot
tiles[ 1]=13 --flagged dot
tiles[ 2]=1  --revealed dot
tiles[ 3]=2  --revealed "1"
tiles[ 4]=3  --revealed "2"
tiles[ 5]=4  --revealed "3"
tiles[ 6]=5  --revealed "4"
tiles[ 7]=6  --revealed "5"
tiles[ 8]=7  --revealed "6"
tiles[ 9]=8  --revealed "7"
tiles[10]=9  --revealed "8"
tiles[11]=10 --revealed "9"
unrevalt0=28
unrevalt1=29
flagalt0=30
flagalt1=31
function puzmap()
 i=1
 seed=tileseed
 for x=0,z-1 do
 for y=0,z-1 do
  p=puz[i]
  if p==nil then p=0 end
  t=tiles[p]
  --alternates
  -- print(seed)
  -- print(seedperiod)
  seedperiod=seed%5
  if t==12 then
   if seedperiod==0 then t=unrevalt0 end
   if seedperiod==1 then t=unrevalt1 end
  elseif t==13 then
   if seedperiod==0 then t=flagalt0 end
   if seedperiod==1 then t=flagalt1 end
  end
  --xorshift
  seed=bxor(shr(seed,3))
  seed=bxor(shl(seed,6))
  seed=bxor(shr(seed,8))
  seed*=18713
  seed=flr(seed)
  --draw it
  mset(x,y,t)
  i+=1
 end
 end
end

--update cursor for game state
function upcur()
 if btnp(0) then cur-=z end
 if btnp(1) then cur+=z end
 if btnp(2) then cur-=1 end
 if btnp(3) then cur+=1 end
 cur%=zz
 if btnp(flagbtn) then
  flagpos(cur+1)
  puzmap()
 elseif btnp(revealbtn) then
  revealpos(cur+1)
  puzmap()
 end
 curtick+=1
end

--reveal a tile
function revealpos(i)
 if puz[i]==-3 then
  --revealed mine (toggle menu)
  state="menu"
 elseif puz[i]<0 then
  --unrevealed mine
  revealall()
  updatelosestate()
  sfx(1)
 elseif puz[i]<=1 then
  --unrevealed dot
  revealflood(i)
  updatewinstate()
  if victory=="play" then
   sfx(0)
  elseif victory=="win" then
   sfx(2)
  end
 else
  --revealed dot (toggle menu)
  state="menu"
  return
 end
end

--flood fill reveal
function revealflood(i)
 if i<1 or i>zz then return end
 q={i}
 while #q>0 do
  nq={}
  foreach(q,
   function(j)
    if j>0 and j<=zz and puz[j]>-3 and puz[j]<2 then
     jm=(j-1)%z
     n=prox(j)
     puz[j]=n+2
     if n==0 then
      --cardinal
      if jm>0 then add(nq,j-1) end
      if jm<z-1 then add(nq,j+1) end
      add(nq,j-z)
      add(nq,j+z)
      --diagonal
      if jm>0 then add(nq,j-1-z) end
      if jm>0 then add(nq,j-1+z) end
      if jm<z-1 then add(nq,j+1-z) end
      if jm<z-1 then add(nq,j+1+z) end
     end
    end
   end
  )
  q=nq
 end
end

--reveal all tiles
function revealall()
 for i=1,zz do
  if puz[i]<0 then
   --mine
   puz[i]=-3
  else
   --not a mine
   puz[i]=prox(i)+2
  end
 end
end

--put a flag somewhere
function flagpos(i)
 if puz[i]>1 or puz[i]==-3 then
  --revealed (do nothing)
 elseif puz[i]==-2 then
  --mine
  puz[i]=-1
 elseif puz[i]==-1 then
  --flagged mine
  puz[i]=-2
 elseif puz[i]==0 then
  --unrevealed
  puz[i]=1
 elseif puz[i]==1 then
  --flagged unrevealed
  puz[i]=0
 end
end

--gen puzzle
function genpuz(m)
 puz={}
 for i=1,zz do --init
  puz[i]=0
 end
 for j=1,m do --mines
  x=flr(rnd(zz))+1
  while puz[x]==-2 do
   x=flr(rnd(zz))+1
  end
  puz[x]=-2
 end
 return puz
end

--count adjacent mines
function prox(i)
 n=0
 im=(i-1)%z
 if im>0 and puz[i-1]!=nil and puz[i-1]<0 then n+=1 end
 if im<z-1 and puz[i+1]!=nil and puz[i+1]<0 then n+=1 end
 if puz[i-z]!=nil and puz[i-z]<0 then n+=1 end
 if puz[i+z]!=nil and puz[i+z]<0 then n+=1 end
 if im>0 and puz[i-1-z]!=nil and puz[i-1-z]<0 then n+=1 end
 if im>0 and puz[i-1+z]!=nil and puz[i-1+z]<0 then n+=1 end
 if im<z-1 and puz[i+1-z]!=nil and puz[i+1-z]<0 then n+=1 end
 if im<z-1 and puz[i+1+z]!=nil and puz[i+1+z]<0 then n+=1 end
 return n
end
