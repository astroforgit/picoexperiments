pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--pearpicker
--tom brinton

--arrow keys to move
--z to shoot brain wave
--(once charged)

--todo
-- fruit
-- x eat fruit - particles
-- x make fruit fall when ripe
-- bats
-- x make them steal fruit
-- x you are so sad if they hit u
-- bullets
-- x make them kill all in their path
-- lvl gen?
-- intro
--

--title
--help screen
--building 
-- does this level look ok?
-- generate again
--play
--win

cartdata("pearpicker")
hiscore=dget(0)
firsttime=dget(1)
if (hiscore==0) hiscore=1024

mode="title"


function _init()
 music(0)
 p={}
 p.x=60
 p.y=96
 p.by=104
 p.moving=false
 p.full=0
 p.hit=true
 
 t=0
 
 eatup=40
 owie=0
 
 letters={}
 createletters()
 
 showbuttons=false
 
 winbuffer=3
 
 starttime=0
 
 fruit={}
 
 bullets={}
 
 enemies={}
 
 debris={}
end

function _update()
 if mode=="title" then
  updatetitle()
 elseif mode=="help" then
  updatehelp()
 elseif mode=="win" then
  updatewin()
 elseif mode=="play" then
  t+=1
  if (t>9) then
   addfruit()
   createenemy()
   t=0
  end
  moveplayer()
  foreach(enemies,moveenemy)
  foreach(fruit,updatefruit)
  foreach(bullets,updatebullet)
  if (p.full<0) p.full=0
 end
end

function _draw()
 if mode=="title" then
  drawtitle()
 elseif mode=="help" then
  drawhelp()
 elseif mode=="win" then
  drawwin()
 elseif mode=="play" then
  cls()
  map(0,0,0,0,16,16)
  foreach(debris,drawdebris)
  foreach(fruit,drawfruit)
  drawplayer()
  foreach(enemies,drawenemy)
  foreach(bullets,drawbullet)
  --fullness meter
  if owie>0 then
   owie-=1
   line(14,124,114,124,2)
   rectfill(14,123,14+p.full,124,8)
  else
   line(14,124,114,124,3)
   rectfill(14,123,14+p.full,124,11)
  end
  --eatup prompt
  if eatup>0 then
   eatup-=1
   if (t>2) spr(132,40,56,6,2)
  end
 end
end

-->8
--player
function moveplayer()
 if not p.hit then
  if (btn(‹) and canmove(p.x-1,p.y)) p.x-=1
  if (btn(‘) and canmove(p.x+1,p.y)) p.x+=1
  if (btn(”) and canmove(p.x,p.y-1)) p.y-=1
  if (btn(ƒ) and canmove(p.x,p.y+1)) p.y+=1
  if (btn()>0) sfx(1);p.moving=true; else p.moving=false
  if (btnp(Ž)) p.full-=10; createbullets()
 else
  p.y+=2
  if p.y>95 then
   p.y=96
   p.hit=false
  end
 end
 --energy drain
 if t==9 and p.full>0 then
  p.full-=1
 end
 --win state
 if p.full>99 then
  
  mode="win"
  score=flr(time()-starttime)
  if (score<hiscore) hiscore=score;dset(0,hiscore)
 end
end

function drawplayer()
 if p.y<96 then
  local necky=p.y+4
  repeat
   spr(2,p.x,necky)
   necky+=8
  until necky>p.by-2
 end
 --draw body
 if not p.moving then
	 spr(32,p.x,p.by)
 else
  if t>4 then
   spr(16,p.x,p.by)
  else
   spr(17,p.x,p.by)
  end
 end
 --draw head
 if p.moving then
	 spr(1,p.x,p.y)
 else
	 spr(33,p.x,p.y)
 end
 if (p.hit) spr(49,p.x,p.y)
end

function canmove(cx,cy)
 if cy<0 or cy>96 or cx<0 or cx+7>127 then
  return false
 end
 
 for ccx=cx,cx+7 do
  for ccy=cy,cy+7 do
   if fget(mget(ccx/8,ccy/8),0) then
    return false
   end
  end
 end
 
 return true
end
-->8
--level gen

-->8
--fruit
function addfruit()
 --randomness
 if (rnd()>.5) return
 if (#fruit >15) return
 --find available spot
 ::retry::
 fx=flr(rnd(16))
 fy=flr(rnd(10))
 if not fget(mget(fx,fy),0) then
  goto retry
 end
 for ff in all(fruit) do
  if fx*8==ff.x and (fy+1)*8==ff.y then
  	goto retry
  end
 end
 --add fruit
 local f={}
 f.x=(fx)*8
 f.y=(fy+1)*8
 f.ys=0
 f.size=0
 if (rnd()>.35) f.kind=1 else f.kind=2
 f.shrink=false
 f.falling=false
 add(fruit,f)
end

function updatefruit(f)

 --grow
 if t==9 and f.size<3 and not f.shrink and rnd()>.8 then
  f.size+=1
 end
 
 if f.kind==2 then
  --shrink thorns
  if t==9  and f.size==3 and rnd()>.8 then
   f.shrink=true
  end
  if t==9 and f.size>0 and f.shrink and rnd()>.8 then
   f.size-=1
  end
  if f.shrink and f.size==0 then
   del(fruit,f)
  end
 
 elseif f.kind==1 then
 	--make old fruit drop
  if t==9 and f.size==3 and not f.falling and rnd()>.95 then
   f.falling=true
   f.size=4
   sfx(4)
   f.ys=1
  end
  
  if f.falling then
   if (rnd()>.6) createdebris(f.x+4,f.y,10)
   f.ys+=.1
   f.y+=f.ys
   if f.y>103 then
    for i=1,10 do
    	createdebris(f.x+4,f.y+8,4)
    end
    del(fruit,f)
   end
  end
  
 end
 --player eats
 if f.size>0 and not p.hit then
  cfx,cfy=f.x+4,f.y+4
  cpx,cpy=p.x+4,p.y+4
  if abs(cfx-cpx)<5 and abs(cfy-cpy)<5 then
   if f.kind==1 then
    --eat good
    p.full+=f.size*5 
    for i=1,f.size*10 do
     createdebris(cfx,cfy,9)
    end
    del(fruit,f)
    sfx(2)
   else
    --eat bad
    p.full-=f.size*5 
    for i=1,f.size*10 do
     createdebris(cfx,cfy,2)
    end
    del(fruit,f)
    sfx(3)
    owie=10
   end
  end
 end
end

function drawfruit(f)
 if f.kind==1 then
 spr(11+f.size,f.x,f.y)
 else
 spr(27+f.size,f.x,f.y) 
 end
end
-->8
--bullets
function createbullets()
 sfx(0)
 local b={}
 b.x=p.x-4
 b.y=p.y
 b.xs=-4
 add(bullets,b)
 local b={}
 b.x=p.x+4
 b.y=p.y
 b.xs=4
 add(bullets,b)
end

function updatebullet(b)
 --move
 b.x+=b.xs
 if (b.x<-9 or b.x> 128) del(bullets,b)

 --clear anything in path
 for f in all(fruit) do
  cbx,cby=b.x+4,b.y+4
  cfx,cfy=f.x+4,f.y+4
  if abs(cbx-cfx)<5 and abs(cby-cfy)<5 and not p.hit then
   if f.kind==2 then
    del(fruit,f)
   else
    f.falling=true
    f.ys=1
   end
   for i=1,3 do
    createdebris(cbx,cby,3)
   end
  end
 end
 for e in all(enemies) do
  cbx,cby=b.x+4,b.y+4
  cex,cey=e.x+4,e.y+4
  if abs(cbx-cex)<5 and abs(cby-cey)<5 and not p.hit then
   del(enemies,e)
   for i=1,3 do
    createdebris(cbx,cby,3)
   end
   
  end
 end
 
end 

function drawbullet(b)
 if t>4 then
   spr(18,b.x,b.y)
 else
   spr(34,b.x,b.y)
 end
end
-->8
--enemies
function createenemy()
 --randomness
 if (rnd()> (p.full/150)) return
 if (#enemies > 10) return
 local e={}
 way=ceil(rnd(2))
 if way==1 then
  e.x=164
  e.xs=-2
 else
  e.x=-32
  e.xs=2
 end
 e.y=flr(rnd(13))*8
 e.stolen=false
 add(enemies,e)
 sfx(5)
end

function moveenemy(e)
 --move
 e.x+=e.xs
 if (e.x<-33 or e.x>165) del(enemies,e)
 if (rnd()>.4) createdebris(e.x+4,e.y+4,1)
 
 
 --collide w player
 cex,cey=e.x+4,e.y+4
 cpx,cpy=p.x+4,p.y+4
 if abs(cex-cpx)<5 and abs(cey-cpy)<5 and not p.hit then
  p.full-=50
  p.hit=true
  sfx(19)
  owie=20
 end
 
 --steal fruit
 if not e.stolen then
  for f in all(fruit) do
   if f.x==e.x and f.y==e.y and f.size>0 then
    del(fruit,f)
    sfx(18)
    for i=1,5 do
     createdebris(cfx,cfy,1)
    end
    e.stolen=true
 
   end
  end
 end
end

function drawenemy(e)
 --warning
 if e.x<-8 and e.xs>0 then
  if (t>4) spr(7,0,e.y)
 end
 if e.x>128 and e.xs<0 then
  if (t>4) spr(7,120,e.y)
 end
 --bat
 if e.xs<0 then
  if t>4 then
   spr(8,e.x,e.y)
  else
   spr(9,e.x,e.y)
  end
 else
   if t>4 then
   spr(8,e.x,e.y,1,1,true)
  else
   spr(9,e.x,e.y,1,1,true)
  end
 end
end
-->8
--particles
function createdebris(x,y,c)
 local d ={}
 d.x=x
 d.y=y
 d.xs=-1+rnd(2)
 d.ys=-1+rnd(2)
 d.col=c
 d.size=1+rnd(2)
 add(debris,d)
end

function drawdebris(d)
 d.x+=d.xs
 d.y+=d.ys
 d.y+=.1
 circfill(d.x,d.y,d.size,d.col)
 d.size-=.1
 if (d.size<0) del(debris,d)
end
-->8
--title & help

function updatetitle()
 if (rnd()>.5) createdebris(32+rnd(64),32+rnd(64),rnd(15))
 if showbuttons then
  if firsttime>0 then
  if (btnp(Ž)) mode="play";sfx(16);music(1);starttime=time()
  if (btnp(—)) mode="help"
  else
   if (btnp(Ž)) mode="help";firsttime=1;dset(1,1)
  end
 end
end

function drawtitle()
 cls()
 foreach(debris,drawdebris)
 foreach(letters,drawletter)
 if showbuttons then
  if firsttime>0 then
   printo("[z] play\n[x] help",49,104,15,2)
  else
   printc("[z] how to play",64,104,15,2,0)
  end
  if (hiscore<1024)printc("fastest time: "..hiscore.." sec",64,8,9,1,0)
 end
end

function drawletter(l)
 l.t+=1
 if (l.t>30) l.t=0
 if (not l.wiggle) l.y+=l.ys*2
 if (l.y> l.gy and not l.wiggle) showbuttons=true; l.wiggle=true
 if l.wiggle then
  lsin=sin(l.t/31)*4
  spr(l.s,l.x,l.y+lsin,2,3)
 else
  spr(l.s,l.x,l.y,2,3)
 end
end

function createletters()
 lx=32
 lt=0
 for sx=64,70,2 do
  local l={}
  l.x=lx
  l.y=-sx/2
  l.gy=32
  l.s=sx
  l.ys=2
  l.t=lt
  l.wiggle=false
  add(letters,l)
  lx+=16
  lt+=1
 end
 lx=16
 for sx=72,78,2 do
  local l={}
  l.x=lx
  l.y=-sx/2
  l.gy=56
  l.s=sx
  l.ys=2
  l.t=lt
  l.wiggle=false
  add(letters,l)
  lx+=16
  lt+=1
 end
 for sx=128,130,2 do
  local l={}
  l.x=lx
  l.y=(-sx+48)/2
  l.gy=56
  l.s=sx
  l.ys=2
  l.t=lt
  l.wiggle=false
  add(letters,l)
  lx+=16
  lt+=1
 end
end

--help

function updatehelp()
  createdebris(32+rnd(64),32+rnd(64),rnd(15))
 if (btnp(—)) mode="title"
end

function drawhelp()
 cls()
 foreach(debris,drawdebris)
 foreach(letters,drawletter)

 fillp(0b0000010000000001.1)
 rectfill(0,0,127,127,0)
 fillp()
 for i=46,96 do
  circfill(20,i,6,2)
 end
 printc("how to play:",64,16,6,2,0)
 printc("”ƒ‹‘ move around",64,32,7,1,4)
 
 spr(14,16,43)
 printo("eat fruit",32,44,7,1)
 
 spr(8,16,55)
 printo("avoid bats",32,56,7,1)

 spr(30,16,67)
 printo("avoid thorns",32,68,7,1)
 
 spr(34,16,79)
 printo("[z] shoot brain waves",32,80,7,1)

 spr(1,16,91)
 printo("you win when he's full",32,92,7,1)

 printc("[x] go back",64,112,6,2,0) 
end

--win

function updatewin()
  t+=1
  if (t>9) then
   winbuffer-=1
   t=0
  end
  if btnp(Ž) and winbuffer<0 then
   _init()
   mode="title"
  end
end

function drawwin()
  cls()
  map(0,0,0,0,16,16)
  foreach(debris,drawdebris)
  foreach(fruit,drawfruit)
  drawplayer()
  foreach(enemies,drawenemy)
  foreach(bullets,drawbullet)
  --fullness meter
  line(14,124,114,124,3)
  rectfill(14,123,14+p.full,124,11)
  
  fillp(0b0101101001011010.1)
  rectfill(0,0,127,127,0)
  fillp()

  printc("you got full!",64,32,11,3,0)
  printc("and it only took",64,48,3,1,0)
  printc(""..score.."",64,56,11,3,2)
  printc("seconds",64,64,3,1,0)
  if (score==hiscore)printc("new fastest time!",64,72,14,2,0)
  if (winbuffer<0) printc("[z] continue",64,88,6,1,0)
end

--print funcs
function printo(str,startx,starty,col,col_bg)
	print(str,startx+1,starty,col_bg)
	print(str,startx-1,starty,col_bg)
	print(str,startx,starty+1,col_bg)
	print(str,startx,starty-1,col_bg)
	print(str,startx+1,starty-1,col_bg)
	print(str,startx-1,starty-1,col_bg)
	print(str,startx-1,starty+1,col_bg)
	print(str,startx+1,starty+1,col_bg)
	print(str,startx,starty,col)
end
function printc(
	str,x,y,
	col,col_bg,
	special_chars)

	local len=(#str*4)+(special_chars*3)
	local startx=x-(len/2)
	local starty=y-2
	printo(str,startx,starty,col,col_bg)
end
