pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
function _init()
 --spr 132 10x5
 musict = 0 --2674
 
 
 scr = "menu"
 
 debug = false
 page = 1
 
 sel = 1
 
 --bs = 0.25
 bs = 0.1
 
 level = 1
 
 bean = {}
 pchance = 15
 gchance = 30
 fchance = 20
 _addbean()
 _addbean()
 bnew = false
 
 grabbed = false
 
 cchoice = 1
 col1 = 14
 col2 = 11
 col3 = 12
 col4 = 10
 
 sun = "day" --day mid night
 backanim = 60
 
 ground = 116
 alive = true
 px = 64
 py = ground - 8
 ps = 0.75
 pturn = false --0=r 1=l
 pspr = 5
 panim = 30
 score = 0
 eaten = 0
 tutor = false
 inv = 0 --600
 frz = 0 --300
 frozen = false
 
 tongue = false
 tx = px
 ty = py
 tc = 14
 ts = 2--1.5
 
 corrupt = false
end


function _addbean()
 for i=1,1 do
  add(bean,{
   x = flr((rnd(114)+3)/8)*8+4,
   y = (rnd(100)+1)*-1,
   s = rnd(bs)+bs,
   p = flr(rnd(pchance)+1),
   g = flr(rnd(gchance)+1),
   f = flr(rnd(fchance)+1)
  })
 end
end


function _update60()
 cls()
 if musict <= 0 then
  music(0)
  musict = 2674
 else
  musict -= 1
 end
 if false == false then
	 if debug == false then
		 menuitem(1,"-debug-",function() 
		 	if debug == true then
		 	 debug = false 
		 	else 
		 	 debug = true 
		 	end 
		 end)
		end
	end
 if debug == true then
  if page == 1 then
	  menuitem(2," +5k score",function()
	   score += 5000
	  end)
	  menuitem(3," +bean",function()
	   _addbean()
	   --for b in all(bean) do
	   -- b.p = pchance
	   --end
	  end)
	  menuitem(4," corrupt mode",function()
	   if corrupt == true then
	    corrupt = false
	   else
	    corrupt = true
	   end
	  end)
	  menuitem(1,"-debug 1-",function() 
		 	if debug == true then
		 	 debug = false 
		 	else 
		 	 debug = true 
		 	end 
		 end)
	  menuitem(5," next page",function()
	   page += 1
	  end)
	 end
	 
	 if page == 2 then
	  menuitem(1,"-debug 2-",function() 
		 	if debug == true then
		 	 debug = false 
		 	else 
		 	 debug = true 
		 	end 
		 end)
		 menuitem(2," p beans",function()
		  for b in all(bean) do
		   b.p = pchance
		  end
		 end)
		 menuitem(3," g beans",function()
		  for b in all(bean) do
		   b.g = gchance
		  end
		 end)
		 menuitem(4," f beans",function()
		  for b in all(bean) do
		   b.f = fchance
		  end
		 end)
		 menuitem(5," first page",function()
	   page -= 1
	  end)
	 end 
 else
 	menuitem(2)
 	menuitem(3)
 	menuitem(4)
 	menuitem(5)
 end
 
 if corrupt == true then
  for i=1,5 do
		 poke(rnd(0x8000),rnd(0x100))
		end
 end
 --camera(-64+(tx),ty-120)
 --for i=1,5 do
 -- poke(rnd(0x5f27),rnd(0x100))
 --end
 
 if scr == "menu" then
  _menu()
  if btnp(4) and sel == 1 then
   scr = "game"
   sfx(2)
  end
 end
 
 
 if scr == "game" then
	 --mset(10,0,0)
	 
	 if score >= 5000 then
	  --pal(8,14)
	  pal(1,8)
	  pal(12,9)
	 end
	 if score >= 10000 then
	  pal(1,13)
	  pal(10,7)
	  pal(12,1)
	 end
	 
	 backanim -= 1
	 if backanim <= 0 then
	  backanim = 60
	 end
	 rectfill(0,0,128,128,12)
	 if backanim >= 30 then
	  --sspr(32,64,32,32,0,0,128,128)
	  sspr(0,64,32,32,0,0,128,128,true)
	 else
	  sspr(0,64,32,32,0,0,128,128)
	 end
	 map(0,3,0,ground+8,16,1)
	 pal()
	 --if score >= 10000 then
	 -- map(0,2,4,ground,16,1)
	 --else
	  map(0,0,4,ground,16,1)
	 --end
	 --map(0,3,0,ground+8,16,1)
	 if inv != 0 then
	  inv-=1
	 end
	 if debug == true then
	  print(inv,20,30,rnd(15)+1)
	 end
	 
	 _bean()
	 if grabbed == false and alive == true then
	  if tc == 14 then
	   pal(11,15)
	   pal(3,14)
	  end
	  --if tc == 11 then
	  -- tutor = true
	  --else
	  -- tutor = false
	  --end
	  if tc == 12 then
	   pal(11,12)
	   pal(3,1)
	  end
	  if tc == 10 then
	   pal(11,10)
	   pal(3,9)
	  end
	  if inv > 0 then
	   --print(inv,20,30,rnd(15)+1)
	   pal(11,rnd(15)+1)
	   pal(3,rnd(15)+1)
	  end
	  _tongue()
	  pal()
	  if btn(5) == true then
    pspr = 7
   end
	 end
	 if btn(5) == false then
	  grabbed = false
	  if alive == true then
	   _move()
	  end
	  _player()
	 end
	 
	 if alive == false then
	  pspr = 8
	  _gameover()
	 end
	 if tc == 11 then
   pal(8,11)
   pal(2,3)
  end
  if tc == 12 then
   pal(8,12)
   pal(2,1)
  end
  if tc == 10 then
   pal(8,10)
   pal(2,9)
   pal(9,5)
   pal(4,5)
  end
  --if inv > 0 then
  -- 
  --end
  palt(0,false)
  palt(15,true)
  spr(pspr+16,px-3,py,1,1,pturn)
  spr(pspr+16,px-5,py,1,1,pturn)
	 spr(pspr+16,px-4,py-1,1,1,pturn)
	 palt()
	 spr(pspr,px-4,py,1,1,pturn)
	 pal()
	 
	 print("score:",5,6,0)
	 print("score:",7,6,0)
	 print("score:",6,5,0)
	 print("score:",6,7,0)
	 print("score:",6,6,7)
	 print(score,29,6,0)
	 print(score,31,6,0)
	 print(score,30,5,0)
	 print(score,30,7,0)
	 print(score,30,6,7)
	end
 
 rect(0,0,127,127,8)
 rect(1,1,126,126,9)
 rect(2,2,125,125,10)
 rect(3,3,124,124	,11)
 
 --print score
 
 
 --print(btn(5),20,20,7)
 --line(64,0,64,128,15)
 _level()
 _freeze()
end

 function _level()
  --if score > 0 and score < 1000 level != 1 then
  -- level = 1
  --end
  if score >= 500 and level == 1 and level != 2 then
   level = 2
   _addbean()
  end
  if score >= 1000 and level == 2 and level != 3 then
   level = 3
   ps += 0.25 --0.75
   bs = 0.25
   _addbean()
   _addbean()
  end
  if score >= 2000 and level == 3 and level != 4 then
   level = 4
   _addbean()
  end
  if score >= 5000 and level == 4 and level != 5 then
   level = 5
   ps += 0.25 --0.75
   bs += 0.05
   --ts += 1
   _addbean()
   pchance -= 2
   gchance -= 2
  end
  if score >= 10000 and level == 5 and level != 6 then
   level = 6
   _addbean()
   pchance -= 3
   gchance -= 3
  end
 end

function _menu()
 rectfill(0,0,128,128,12)
 
 --print("pyoro",57,24,0)
 --print("pyoro",55,22,rnd(4)+8)
 spr(132,22,5,10,5)
 print("start",55,76,10)
 --if cchoice != 1 then
 -- print("bird:",38,90,tc)
 --else
 -- print("bird:",38,90,8)
 --end
 palt(0,false)
 palt(15,true)
 spr(21,px-3,py)
 spr(21,px-5,py)
 spr(21,px-4,py-1)
 spr(21,px-4,py+1)
 palt()
 if cchoice == 1 then
  -- more pink bean
  --print("red",59,90,8)
  spr(5,px-4,py)
  --pchance = 10
 end
 if cchoice == 2 then
  print("green",55,90,tc)
  spr(14,px-4,py)
  --pchance = 15
 end
 if cchoice == 3 then
  print("blue",57,90,tc)
  spr(13,px-4,py)
 end
 if cchoice == 4 then
  print("yello",55,90,tc)
  spr(12,px-4,py)
 end
 
 if sel == 1 then
  print("start",55,76,0)
  print("start",54,75,10)
 end
 if sel == 2 and false == true then
  if cchoice == 1 then
   print("red",59,90,0)
   print("red",58,89,8)
  end
  if cchoice == 2 then
   print("green",55,90,0)
   print("green",54,89,tc)
  end
  if cchoice == 3 then
	  print("blue",57,90,0)
	  print("blue",56,89,tc)
	 end
	 if cchoice == 4 then
	  print("yello",55,90,0)
	  print("yello",54,89,tc)
	 end
  if btnp(0) and cchoice != 1 then
   cchoice -= 1
   sfx(0)
  end
  if btnp(1) and cchoice != 4 then
   cchoice += 1
   sfx(0)
  end
  
  if cchoice == 1 then
   tc = col1
  end
  if cchoice == 2 then
   tc = col2
   --spr(13
  end
  if cchoice == 3 then
   tc = col3
   --spr(14
  end
  if cchoice == 4 then
   tc = col4
   --spr(12
  end
  
 end
 
 if btnp(2) and sel != 1 then
  sel -= 1
  sfx(0)
 end
 if btnp(3) and sel != 2 and false == true then
  sel += 1
  sfx(0)
 end
 --print("press Ž to start",32,101,0)
 --print("press Ž to start",31,100,8)
 
 
end


function _bean()
 print("",20,40)
 color(11)
 for b in all(bean) do
  --if debug == true then
  -- print(b.p)--,20,40,11)
  --end
  palt(0,false)
  palt(1,true)
  spr(96,b.x-1,b.y)
  spr(96,b.x+1,b.y)
  spr(96,b.x,b.y-1)
  spr(96,b.x,b.y+1)
  palt()
  if b.p != pchance and b.g != gchance and b.f != fchance then
   spr(64,b.x,b.y)
  elseif b.p == pchance then
   spr(65,b.x,b.y)
  elseif b.g == gchance then
   --pal(9,flr(rnd(2)+8))
   --pal(10,flr(rnd(2)+9))
   spr(66,b.x,b.y)
   --pal()
  elseif b.f == fchance then
   spr(67,b.x,b.y)
  end
  if frozen != true then
   b.y += b.s
  end
  if (b.y > ground-8 and mget(b.x/8,0) == 17) or b.y > 128 then
   --_rebean()
   if (b.y > ground-8 and mget(b.x/8,0) == 17) then
    sfx(6)
   end
   mset(b.x/8,0,0)
   b.x = flr((rnd(114)+3)/8)*8+4
	  b.y = (rnd(100)+1)*-1
	  b.s = rnd(bs)+bs
	  b.p = flr(rnd(pchance)+1)
   b.g = flr(rnd(gchance)+1)
   b.f = flr(rnd(fchance)+1)
  end
  
  if debug == true then
	  line(0,14,128,14,7)
	  line(0,26,128,26,7)
	  line(0,40,128,40,7)
	  line(0,70,128,70,7)
	 end
  --score += 100
  if tx >= b.x and tx <= b.x+8 and ty >= b.y and ty <= b.y+8 then
   if b.p != pchance and b.g != gchance and b.f != fchance then
    sfx(3)
   elseif b.p == pchance then
    sfx(4)
    _angel()
   elseif b.g == gchance then
    sfx(5)
    for i=1,3 do
     _angel()
    end
   elseif b.f == fchance then
    sfx(7)
    frz = 300
   end
   sfx(-1,2)
   grabbed = true
   tongue = false
   eaten += 1
   if b.y >= 70 then
    score += 10
   end
   if b.y >= 40 and b.y < 70 then
    score += 50--50
   end
   if b.y >= 26 and b.y < 40 then
    score += 100
   end
   if b.y >= 14 and b.y < 26 then
    score += 300
   end
   if b.y < 14 then
    score += 1000
   end
   
   --if score > 1000 and bnew == false then
   -- bnew = true
   -- _addbean()
   --end
   
   --_rebean()
   b.x = flr((rnd(114)+3)/8)*8+4
	  b.y = (rnd(100)+1)*-1
	  b.s = rnd(bs)+bs
	  b.p = flr(rnd(pchance)+1)
	  b.g = flr(rnd(gchance)+1)
	  b.f = flr(rnd(fchance)+1)
	  tx = px
   ty = py+4
	  --print(b.p)
  end
  if b.x+6 >= px-3 and b.x+2 <= px+3 and b.y+8 >= py then
   alive = false
   --_rebean()
   b.x = flr((rnd(114)+3)/8)*8+4
	  b.y = (rnd(100)+1)*-1
	  b.s = rnd(bs)+bs
	  b.p = flr(rnd(pchance)+1)
	  b.g = flr(rnd(gchance)+1)
	  b.f = flr(rnd(fchance)+1)
	  --print(b.p)
  end
 end
end


function _rebean()
 for b in all(bean) do
	 b.x = rnd(116)+1
	 b.y = (rnd(30)+1)*-1
	 b.s = bs
	end
end


function _move()
 if btn(0) or btn(1) then
  panim -= 4
 end
 
 if btn(0) then
  pturn = true
 end
 if btn(1) then
  pturn = false
 end
 
 if btn(0) and btn(1) != true and (px-4)-ps > 4 and mget(flr((px-9)/8),0) == 17 then
  px -= ps
  pturn = true
  sfx(0)
 end
 if btn(1) and btn(0) != true and (px+4)+ps < 125 and mget(flr(px/8),0) == 17 then
  px += ps
  pturn = false
  sfx(0)
 end
 
 if btn(0) != true and btn(1) != true then
  panim = 30
 end
 
end


function _player()
 if panim >= 15 then
  pspr = 5
  --spr(5,px-4,py,1,1,pturn)
 else
  pspr = 6
  --spr(6,px-4,py,1,1,pturn)
 end
 
 if panim <= 0 then
  panim = 30
 end
 
 --spr(pspr,px-4,py,1,1,pturn)
end


function _tongue()
 --if tutor == true then
  --if pturn == true then
  -- line(px,py+4,px-15,py+4-15,3)
  --else
  -- line(px,py+3,px+15,py+3-15,3)
  --end
 --end
 if tongue == false then
  
  if btnp(5) then
   if tx > 4 and tx < 125 and ty > 3 then
    sfx(1,2)
   end
   tongue = true
  end
 else
  if tx > 4 and tx < 125 and ty > 3 then
	  
	  if pturn == true then
	   line(px,py+2,tx,ty-2,0)
	   line(px,py+4,tx,ty,11)
	   line(px,py+3,tx,ty-1,3)
	   line(px,py+5,tx,ty+1,3)
	   line(px,py+6,tx,ty+2,0)
	   
	   palt(0,false)
	   palt(15,true)
	   spr(53,tx-5,ty-6,1,1,1)
	   spr(53,tx-7,ty-6,1,1,1)
	   spr(53,tx-6,ty-5,1,1,1)
	   spr(53,tx-6,ty-7,1,1,1)
	   palt()
	   spr(37,tx-6,ty-6,1,1,1)
	   tx-=ts
	   ty-=ts
	  else
	   line(px,py+1,tx,ty-3,0)
	   line(px,py+3,tx,ty-1,11)
	   line(px,py+2,tx,ty-2,3)
	   line(px,py+4,tx,ty+0,3)
	   line(px,py+5,tx,ty+1,0)
	   
	   
	   palt(0,false)
	   palt(15,true)
	   spr(53,tx-1,ty-6)
	   spr(53,tx-3,ty-6)
	   spr(53,tx-2,ty-5)
	   spr(53,tx-2,ty-7)
	   palt()
	   spr(37,tx-2,ty-6)
	   tx+=ts
	   ty-=ts
	  end
	  --pal()
	 end
  
  if tx <= 4 or tx >= 125 or ty <= 3 then
   sfx(-1,2)
   grabbed = true
   tongue = false
  end
  
  if btn(5) != true then
   sfx(-1,2)
   grabbed = false
   tongue = false
  end
 end
 
 --tx = px
 --ty = py+4
 if tongue == false then
  tx = px
  ty = py+4
  
 end
end


function _angel()
 for a=0,15 do
  if mget(flr(px/8)-a,0) != 17 and flr(px/8)-a > -1 then
   mset(flr(px/8)-a,0,17)
   break
   break
  end
  if mget(flr(px/8)+a,0) != 17 and flr(px/8)+a < 16 then
   mset(flr(px/8)+a,0,17)
   break
   break
  end
 end
end


function _freeze()
 if frozen == true then
	 print(flr(frz/60)+1,px-1,py-9,0)
	 print(flr(frz/60)+1,px-3,py-9,0)
	 print(flr(frz/60)+1,px-2,py-8,0)
	 print(flr(frz/60)+1,px-2,py-10,0)
  print(flr(frz/60)+1,px-2,py-9,7)
 end
 
 if frz > 0 then
  frozen = true
  frz -= 1
 else
  frozen = false
 end
end


function _gameover()
 tx = px
 ty = py + 16
 --if backanim >= 30 then
  print("game over",45,64,0)
  print("game over",47,64,0)
  print("game over",46,63,0)
  print("game over",46,65,0)
  print("game over",46,64,7)
 --else
  
 --end
end
