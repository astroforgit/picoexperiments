pico-8 cartridge // http://www.pico-8.com
version 32
__lua__
--enoshima picnic
--by nice gear games

--initialize

function _init()
 --variables
 scene="menu"
 x=63
 y=63
 
 clock=57
 timer= time()
 hour=11
 progress=0
 clear=false
 music(0)

onigiri=3
ricenum=44

winkid1=16
winkid2=18
losekid1=32
losekid2=34
timing=0.25

--enemy values
ensize=5

--mouse 1 values
mouse1x=22
mouse1y=21
mouse1xdir=2
mouse1ydir=-1
mouse1f=true

--mouse 2 values
mouse2x=85
mouse2y=22
mouse2xdir=1
mouse2ydir=-2
mouse2f=true

--cat values
catx=0
caty=60
catxdir=1
catf=true

--hawk
hawkx=121
hawky=112
hawkxdir=1
hawkydir=-2
hawkf=true

--player
playx=64
playy=64
playflip=false
playw=8
playh=8

soundonflag=false

end
-->8
--main update and draw

function _update()
 if scene=="menu" then
  update_menu()
 elseif scene=="game" then
  update_game()
 elseif scene=="win" then
  update_win()
 elseif scene=="lose" then
  update_lose()
 end
end

function _draw()
 if scene=="menu" then
  draw_menu()
 elseif scene=="game" then
  draw_game()
 elseif scene=="win" then
  draw_win()
 elseif scene=="lose" then
  draw_lose()
 end
end
-->8
--updates
function update_menu()
 if btnp(5) then
  scene="game"
  starttime=time()
 end
end

function update_game()
 bouncerice()
 moveplayer()
 moveenemy()
 bounceenemy()
 bounceplay()
 eatrice()
 timecount()
end

function update_win()
 winkid1+=timing
 if winkid1>17 then winkid1=16 end

 winkid2+=timing
 if winkid2>19 then winkid2=18 end

 if btnp(5) then
  load("enoshima_picnic")
 end
 
 if soundonflag==false then
  sfx(3)
  soundonflag=true
 end
end

function update_lose()
 losekid1+=timing
 if losekid1>33 then losekid1=32 end

 losekid2+=timing
 if losekid2>35 then losekid2=34 end

 if btnp(5) then
  load("enoshima_picnic")
 end
 
 if soundonflag==false then
  sfx(2)
  soundonflag=true
 end
end
-->8
--draws
function draw_menu()
 cls()
 map(16,0)
 
 print("your class is",38,40,1)
 print("on a picnic at",37,48,1)
 print("enoshima! yay!",37,56,1)
 print("protect your",40,64,1)
 print("lunch til 12!",39,72,1)
 print("press —",50,84,1)
end

function draw_game()
 cls()
  map(0,0)
 --mouse 1
 if mouse1xdir>0 then
  spr(003,mouse1x,mouse1y,1,1,false,false)
 end
 if mouse1xdir<0 then
  spr(003,mouse1x,mouse1y,1,1,true,false)
 end
 --mouse 2
 if progress>=1 then
  if mouse2xdir>0 then
   spr(003,mouse2x,mouse2y,1,1,false,false)
  end
  if mouse2xdir<0 then
   spr(003,mouse2x,mouse2y,1,1,true,false)
  end
 end
 --cat
 if progress>=2 then
  if catxdir>0 then
   spr(004,catx,caty,1,1,false,false)
  end
  if catxdir<0 then
   spr(004,catx,caty,1,1,true,false)
  end
 end
 --hawk
 if progress>=3 then
  if hawkxdir>0 then
   spr(005,hawkx,hawky,1,1,false,false)
  end
  if hawkxdir<0 then
   spr(005,hawkx,hawky,1,1,true,false)
  end
 end
 --onigiris
 for i=1,onigiri do
  spr(002,ricenum+i*8,60)
 end
 --draw player
 spr(001,playx,playy,1,1,playflip,false)

--time count
  print (clock,62,4,7)
  print (hour,52,4,7)
  print (":",59,4,7)
  print (":",69,4,7)
 if (flr((time()-starttime)%60))<10 then
  print (0,72,4,7)
  print (flr(((time()-starttime)%60)),76,4,7)
 elseif (flr((time()-starttime)%60))==60 then
  print("00",72,4,7)
 else
  print ((flr((time()-starttime)%60)),72,4,7)
 end
end

function draw_win()
 cls()
 map(0,0)
 print("lunchtime!",45,4,7)
 for i=1,onigiri do
  spr(002,ricenum+i*8,60)
 end
 spr(winkid1,46,80)
 spr(winkid2,56,80)
 spr(20,66,72,2,2)
end

function draw_lose()
 cls()
 map(0,0)
 print("game over!",45,4,7)
 spr(losekid1,46,80)
 spr(losekid2,56,80)
 spr(22,66,72,2,2)
end
-->8
--game functions
function moveplayer()
 if btn(0) then
  if playx>32 then
   playx-=2
   playflip=true
  end
 end
 if btn(1) then
  if playx<88 then
   playx+=2
   playflip=false
  end
 end
 if btn(2) then
  if playy>32 then
   playy-=2
  end
 end
 if btn(3) then
  if playy<88 then
   playy+=2
  end
 end
end

function moveenemy()
 --mouse 1
 mouse1x+=mouse1xdir
 mouse1y+=mouse1ydir
 --mouse 2
 if progress>=1 then
  mouse2x+=mouse2xdir
  mouse2y+=mouse2ydir
 end
 --cat
 if progress>=2 then
  catx+=catxdir
 end
 --hawk
 if progress>=3 then
  hawkx+=hawkxdir
  hawky+=hawkydir
 end
end

function bounceenemy()
 --mouse 1 movement
 --left
 if mouse1x<ensize+10 then
  mouse1xdir=-mouse1xdir
  --sfx(0)
  mouse1f=true
 end

 --right
 if mouse1x>128-ensize-14 then
  mouse1xdir=-mouse1xdir
  --sfx(0)
  mouse1f=true
 end

 --top
 if mouse1y<ensize+10 then
  mouse1ydir=-mouse1ydir
  --sfx(0)
  mouse1f=true
 end

 --bottom
 if mouse1y>128-ensize-14 then
  mouse1ydir=-mouse1ydir
  mouse1f=true
 end

 --mouse 2 movement
 --left
 if mouse2x<ensize+10 then
  mouse2xdir=-mouse2xdir
  --sfx(0)
  mouse2f=true
 end

 --right
 if mouse2x>128-ensize-14 then
  mouse2xdir=-mouse2xdir
  --sfx(0)
  mouse2f=true
 end

 --top
 if mouse2y<ensize+10 then
  mouse2ydir=-mouse2ydir
  --sfx(0)
  mouse2f=true
 end

 --bottom
 if mouse2y>128-ensize-14 then
  mouse2ydir=-mouse2ydir
  mouse2f=true
 end

 --cat movement
 if catx<-5 then
  catx=128
  catxdir=-1
  catf=true
 end
 
 if catx>133 then
  catx=0
  catxdir=1
  catf=true
 end
 
 --hawk movement
 --left
 if hawkx<ensize-20 then
  hawkxdir=-hawkxdir
  hawkf=true
  --sfx(0)
 end

 --right
 if hawkx>140-ensize-4 then
  hawkxdir=-hawkxdir
  --sfx(0)
  hawkf=true
 end

 --top
 if hawky<ensize-20 then
  hawkydir=-hawkydir
  --sfx(0)
  hawkf=true
 end

 --bottom
 if hawky>140-ensize-4 then
  hawkydir=-hawkydir
  hawkf=true
 end
end

--bounce enemies off the player
function bounceplay()
 --player bounce mouse 1
 if mouse1x>=playx-8 and
  mouse1x<=playx+playw and
  mouse1y>playy-8 and
  mouse1f==true and
  mouse1y<=playy+playh then
  sfx(0)
  mouse1ydir=-mouse1ydir
  mouse1xdir=-mouse1xdir
  mouse1f=false
 end
 --player bounce mouse 2
 if mouse2x>=playx-8 and
  mouse2x<=playx+playw and
  mouse2y>playy-8 and
  mouse2f==true and
  mouse2y<=playy+playh then
  sfx(0)
  mouse2ydir=-mouse2ydir
  mouse2xdir=-mouse2xdir
  mouse2f=false
 end
 --player bounce cat
 if catx>=playx-8 and
  catx<=playx+playw and
  caty>playy-8 and
  catf==true and
  caty<=playy+playh then
  sfx(0)
  catxdir=-catxdir
  catf=false
 end
 --player bounce hawk
 if hawkx>=playx-8 and
  hawkx<=playx+playw and
  hawky>playy-8 and
  hawkf==true and
  hawky<=playy+playh then
  sfx(0)
  hawkydir=-hawkydir
  hawkxdir=-hawkxdir
  hawkf=false
 end
end

--bounce enemies off onigiri
function bouncerice()
 --onigiris bounce mouse 1
 if mouse1x>=48 and
  mouse1x<=72 and
  mouse1y>=56 and
  mouse1y<=64 and
  onigiri==3 then
   sfx(1)
   mouse1x=22
   mouse1y=21
   onigiri-=1
 end
 if mouse1x>=52 and
  mouse1x<=68 and
  mouse1y>=56 and
  mouse1y<=64 and
  onigiri==2 then
   sfx(1)
   mouse1x=22
   mouse1y=21
   onigiri-=1
 end
 if mouse1x>=52 and
  mouse1x<=68 and
  mouse1y>=56 and
  mouse1y<=64 and
  onigiri==1 then
   sfx(1)
   mouse1x=22
   mouse1y=21
   onigiri-=1
 end
 --onigiris bounce mouse 2
 if mouse2x>=48 and
  mouse2x<=72 and
  mouse2y>=56 and
  mouse2y<=64 and
  onigiri==3 then
   sfx(1)
   mouse2x=85
   mouse2y=22
   onigiri-=1
 end
 if mouse2x>=52 and
  mouse2x<=68 and
  mouse2y>=56 and
  mouse2y<=64 and
  onigiri==2 then
   sfx(1)
   mouse2x=85
   mouse2y=22
   onigiri-=1
 end
 if mouse2x>=52 and
  mouse2x<=64 and
  mouse2y>=56 and
  mouse2y<=64 and
  onigiri==1 then
   sfx(1)
   mouse2x=85
   mouse2y=22
   onigiri-=1
 end
 --onigiris bounce cat
 if catx>=48 and
   catx<=72 and
   caty>=56 and
   caty<=64 and
   onigiri==3 then
    sfx(1)
    catx=0
    caty=60
    onigiri-=1
 end
 if catx>=52 and
  catx<=68 and
  caty>=56 and
  caty<=64 and
  onigiri==2 then
   sfx(1)
   catx=0
   caty=60
   onigiri-=1
 end
 if catx>=52 and
  catx<=64 and
  caty>=56 and
  caty<=64 and
  onigiri==1 then
   sfx(1)
   catx=0
   caty=60
   onigiri-=1
 end
 --onigiris bounce hawk
 if hawkx>=48 and
  hawkx<=72 and
  hawky>=56 and
  hawky<=64 and
  onigiri==3 then
   sfx(1)
   hawkx=121
   hawky=112
   onigiri-=1
 end
 if hawkx>=52 and
  hawkx<=68 and
  hawky>=56 and
  hawky<=64 and
  onigiri==2 then
   sfx(1)
   hawkx=121
   hawky=112
   onigiri-=1
 end
 if hawkx>=52 and
  hawkx<=68 and
  hawky>=56 and
  hawky<=64 and
  onigiri==1 then
   sfx(1)
   hawkx=121
   hawky=112
   onigiri-=1
 end
 if onigiri<=0 then
  scene="lose"
 end
end

function eatrice()
 if onigiri==3 then
  ricenum=44
 end
 if onigiri==2 then
  ricenum=48
 end
 if onigiri==1 then
  ricenum=52
 end
end

function timecount()

 timer=180-(time()-starttime)
 
 if timer>120 and timer<=180 then
  clock=57
 end
 
 if timer>60 and timer<=120 then
  clock=58
 end
 
 if timer>0 and timer<=60 then
  clock=59
 end
 
 if timer==0 then
  clear=true
  scene="win"
 end
 
 if timer>150 and timer<=170 then
  progress=1
 end
 
 if timer>120 and timer<=150 then
  progress=2
 end
 
 if timer>90 and timer<=120 then
  progress=3
 end
 
 if timer>60 and timer<=90 then
  progress=4
 end
 
 if timer>0 and timer<=60 then
  progress=5
 end
end
