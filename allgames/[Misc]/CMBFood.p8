pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
--cmbfood
--by sean_
hscr=0
lscr=0
function init()
 ftxt={}
 food={} smk={} cmb={} cmbscr=0
	px=64 dx=0 ct=0 scr=0 pow=0
	py=64 dy=0 pt=0 z=0
	b={-1,1,0,0,0,0,-1,1} m=0
	shk=0 cshk=0 tshk=0 nom=0
	t=0 hp=3
end
init()
hp=0
function oprint(txt,x,y,c)
 x-=(#txt*2)
 for i=-1,1 do
 for j=-1,1 do
  print(txt,x+i,y+j,0)
 end
 end
 print(txt,x,y,c)
end
function ptxt(_txt,_x,_y)
 add(ftxt,{txt=_txt,x=_x-(#_txt*2),y=_y,
 dx=rrnd(2),dy=rrnd(2),t=30,
 upd=function(s)
  s.t-=1
  s.x+=s.dx s.y+=s.dy
  s.dx*=0.97
  s.dy*=0.97
  s.x=mid(1,s.x,127)
  s.y=mid(1,s.y,127)
  if s.t==0 then
   del(ftxt,s)
  end
 end,drw=function(s)
  oprint(s.txt,s.x,s.y,7)
 end
 })
end
function rrnd(n)
 a=rnd(n)-(n/2)
 return a
end
function add_cmbp(_x,_y,_r)
 add(cmb,{_x=x,_y=y,_r=r,
 drw=function(s)
  if pow==0 then
	  spr(17,_x,_y)
	  if _x%30<15 and t%(_x%60)<5 then
	   spr(17+nom,_x,_y)
	   _x+=rrnd(2) _y+=rrnd(2)
	  end
	  if px>_x and px<_x+8 
	  and py>_y and py<_y+8 then
	   spr(16,_x,_y)
	  end
  else
   spr(33,_x,_y)
  end
 end,
 upd=function(s)
  _x=mid(8,_x,120)
  _y=mid(1,_y,120)
  if px>_x and px<_x+8 
  and py>_y and py<_y+8 then
   if pow==1 then
    if t%30*4==0 and cmbscr>5 then
	    sfx(40+flr(rnd(3)))
	   end
    px=_x+4 py=_y+4
    dx=0 dy=0
    if btnp(4) then
	    del(cmb,s) flip()
	    cmbscr+=hp shk+=6 cshk+=3
	    ptxt("+"..hp.."!",px,py)
	    tshk+=20 pt=30*2 nom=3
	    for i=1,flr(rnd(4)+1+flr(rnd(2)*12)) do
	     add_smk(_x,_y,1)
	    end
	    sfx(5+flr(rnd(3)))
    end
    if pt==0 then
     del(cmb,s) flip()
	    cmbscr+=5 shk+=6 cshk+=3 nom=3
	    for i=1,flr(rnd(4)+1+flr(rnd(2)*12)) do
	     add_smk(_x,_y,1)
	    end
    end 
   elseif btnp(4) then
    sfx(-1)
    sfx(16)
    shk+=2
    ct=0 scr+=cmbscr cmbscr=0
    cshk+=1
    ptxt("-‡",px,py)
    hp-=1
   end
  end
 end
 })
end
function add_smk(_x,_y,_c)
 add(smk,{x=_x,y=_y,
 dx=rrnd(3),dy=rrnd(3),
 r=2+rnd(4),b=flr(rnd(2)),
 upd=function(s)
  s.x+=s.dx s.y+=s.dy
  s.dx*=0.9 s.dy*=0.9
  if abs(s.dx)<0.1 and abs(s.dy)<0.1 then
   del(smk,s)
  end
 end,
 drw=function(s)
 	if s.b==0 then
 	 circ(s.x,s.y,s.r,_c)
 	else
   circfill(s.x,s.y,s.r,_c)
  end
 end
 })
end
function add_food(_x,_y,_dx,_dy,_p)
 add(food,{x=_x,y=_y,dx=_dx,dy=_dy,bx=0,uy=0,t=0,
 r=(12+rnd(4))-mid(4,hp,12),
 upd=function(s)
  s.x+=s.dx
  s.y+=s.dy
  s.dy+=0.1
  s.dx*=0.9
  s.x=mid(8,s.x,120)
  if s.y>128+s.r and s.dy>0 then
   del(food,s)
  end
  s.bx=s.x-s.r
  s.uy=s.y-s.r
  if s.bx<px and s.bx+(s.r*2)>px
  and s.uy<py and s.uy+(s.r*2)>py 
  and pget(px,py)~=8 then
   if py<100 then
    px=s.x py=s.y dx=0 dy=0
    s.t=1
    if btnp(4) then
     flip()
     for i=1,flr(4)+5 do
      if pow==0 then
       add_smk(s.x,s.y,11)
      else
       add_smk(_x,_y,10)
      end
      if _p==1 then
       sfx(-1)
       pow=1
       pt=30*2
       for f in all(food) do
        del(food,f)
       end
      end
     end
     sfx(2+flr(rnd(3)))
     scr+=1
     cmbscr+=1
     add_cmbp(s.x,s.y,s.r)
     del(food,s)
     nom=3
     shk+=2
     ct+=30*2
     cshk+=4
    end
   end
  else s.t=0 end
 end,
 drw=function(s)
   circfill(s.x,s.y,s.r,11+s.t)
  if _p==1 then
   circfill(s.x,s.y,s.r,10-s.t)
  end
 end
 })
end

function _update()
 if z==1 then
  if hp<=0 then z=0 sfx(-1) sfx(25+ceil(rnd(2))) sfx(27+ceil(rnd(2))) end
	 if #cmb==0 and pow==1 then
	  pt=0
	 end
	 if pt>0 then
	  pt-=1
	 else
	  if pow==1 and pt==0 then
	   pow=0
	   sfx(-1)
	   if #cmb==0 then
	    ptxt("+‡",px,py)
	    hp+=1
	    sfx(18)
	    sfx(19)
	    for i=5,flr(rnd(30)+5) do
	     add_smk(px,py,10)
	     flip()
	    end
	   else
	    ptxt("-‡",px,py)
	    hp-=1
	    sfx(8)
	    cmbscr*=-1
	    ptxt(cmbscr.."!",px,py)
	   end
	   for cp in all(cmb) do
	    del(cmb,cp)
	   end
	  end
	 end
	 
	 if abs(shk)>0.2 then
	  shk*=0.9
	 else
	  shk=0
	 end
	 if abs(cshk)>0.2 then
	  cshk*=0.6
	 else
	  cshk=0
	 end
	 if abs(tshk)>0.2 then
	  tshk*=0.9
	 else
	  tshk=0
	 end
	 camera(0+rrnd(cshk),0)
	 if ct>30 and pow==0 then 
	 	ct*=0.98
	 elseif ct<=30 then
	  scr+=cmbscr 
	  cmbscr=0
	 else
	  ct=31
	 end
	 if ct>30 and t%30*4==0 then
	  if cmbscr<10 then
	   sfx(9)
	  elseif pow==0 then
	   sfx(10+flr(rnd(4)))
	  end
	 end
	 t+=1
	 if nom>0 and t%4==0 then
	  nom-=1
	 end
	 m=0
	 for i=0,3 do
	  if btn(i) then
	   m=1
	   dx+=b[i+1]*mid(1.5-(hp/10),0.8,0.2)
	   dy+=b[i+5]*mid(1.5-(hp/10),0.8,0.2)
	  end
	 end
	 dx=mid(-3,dx,3)dy=mid(-3,dy,3)
	 px+=dx py+=dy
	 dx*=0.9 dy*=0.9
	 px=mid(0,px,127)
	 py=mid(0,py,127)
	 if btnp(4) then
	  if pget(px,py)==8 then
	   ct=0 scr+=cmbscr cmbscr=0
	   cshk+=1 shk+=2 sfx(16)
	   ptxt("-‡",px,py)
    hp-=1
	  end
	 end
	 if t%(10+hp)==0 and pow==0 then
	  for i=1,flr(rnd(3)+1) do
	  add_food(rnd(128),128,rrnd(10),-rnd(1)-4,0)
	  if cmbscr>5 and rnd(10)<1 then
	   add_food(rnd(128),128,rrnd(10),-rnd(1)-4,1)
	  end
	  end
	 end
	 for f in all(food) do
	  f:upd()
	 end
	 for s in all(smk) do
	  s:upd()
	 end
	 for p in all(cmb) do
	  p:upd()
	 end
	 for p in all(ftxt) do
	  p:upd()
	 end
 else
  if scr>hscr then
   hscr=scr
  end
  if scr<lscr then
   lscr=scr
  end
  if btnp(5) then
   init()
   z=1
   sfx(-1)
   sfx(1)
  end
 end
end

function _draw()
 if z==1 then
	 cls() 
	 for f in all(food) do
	  f:drw()
	 end
	 for s in all(smk) do
	  s:drw()
	 end
	 for p in all(cmb) do
	  p:drw()
	 end
	 for p in all(ftxt) do
	  p:drw()
	 end
	 print("+",px,py,10)
	 spr(1+nom,px+rrnd(shk),py+rrnd(shk))
	 for j=100,128,2 do
	  line(0,j,128,j,0)
	 end
	 if pow==1 then
   oprint("+"..cmbscr,64+rrnd(tshk)+sin(t/64)*8,64+rrnd(tshk)+cos(t/128)*8,11)
  else
   oprint("+"..cmbscr,64,64,11)
  end
 else
  for i=1,100 do
   xx=rnd(128) yy=rnd(128)
   cc=pget(xx,yy)
   circ(xx,yy,1,cc)
  end
  px=64-8
  py=64-8
  palt(0,false) palt(1,true)
  for i=1,7 do
   spr(5+i,64-8-(3.5*8)+(i*8),32)
  end
  pal()
  oprint("sean_ - 2019",128-25,2,10)
  oprint("fc_jam #4",20,122,9)
  oprint("— to start",64,80,11)
  oprint("highscr:"..hscr,64,64-8,9)
  oprint("lowscr:"..lscr,64,64+8,10)
 end
 if (ct>30 and pow==0)oprint(flr(ct).."",64,64+7,6)
 if (pow==1)oprint(pt.."",64,64+7,12)
 oprint(scr.."",px+8,py+8,10)
 for i=1,hp do
  oprint("‡",64-(hp*2)+(i*6)-15+(sin(i/16+pt/64)*pt)+rrnd(shk),114+(cos(i/16+t/64)*4),10)
 end
end
