--2 lose state
function lose_update()
	timer+=1
--check if player has let go of
--the button after playing
	if btn(4)==false and btn(5)==false then
		btnrelease=true
	end

--press the button to continue 
	if (btn(4) or btn(5)) and btnrelease==true then
		btnrelease=false
		_init()
		timer=0
	end
	
	--[[reset game after a good while
	if timer>420 then
		timer=0
		_init()
	end]]
	
end

function lose_draw()
	color(8)
	print("g a m e   o v e r",32,48,8)
	print("final score: "..score,40,56,7)
	spr(8,48,70,4,4)
	print("push — to continue",164-(timer%264),120,5)
end
-->8
--3 win state
function win_update()
	timer+=1

--check if player has let go of
--the button after playing
	if btn(4)==false 
	and btn(5)==false then
		btnrelease=true
	end
--press either button to play
--again
 if (btn(4) or btn(5)) 
 and btnrelease==true then
 
 	if timer>128 then
  	timer=0--rest timer
 		_init()
		end
		
		btnrelease=false
	
	end
end

--draws line dash fake text
function lorem(x,y,xx,yy,c)
--takes the top left corner,
--bottom right corner, and
--color

	local w=xx-x
	local h=yy-y
 	
 srand(1)
 
	for i=h,1,-3 do
		for j=1,w do
			r=rnd(3)
			if r>1 then
	 		pset(x+j,y+i,c)
	 	end
 	end
	end

--reinitialize random seed
	srand(flr(t()))

end

function win_draw()
	
	if timer<128 then
		camera(0,timer-128)
 end
 	
	print("c o n g r a t u l a t i o n s",4,-64,7)

--newsprint gray
	rectfill(0,0,128,128,6)
	--lorem ipsum
	lorem(6,50,120,120,5)
	rectfill(31,0,33,128,6)
	rectfill(63,0,65,128,6)
	rectfill(95,0,97,128,6)
	--kiss back, pict, border
	rectfill(32,50,64,82,6)
	spr(74,32,50,4,4)
	rect(32,50,64,82,5)
	--title border
	line(2,6,126,6,5)
	line(2,26,126,26,5)
	line(2,28,126,28,5)
	--newsnews
	spr(32,0,8,8,2)
	spr(32,65,8,8,2)
	--headline
	print("        magic legalized         ",0,32,1)
	print("       witches celebrate        ",0,40,1)
	line(2,48,126,48,5)
	--score
	rectfill(65,50,128,62,6)
	print("score: "..score,68,54,1)

	print("push — to continue",28,122,5)

end
-->8
--buncha functions

--adds a table with data of a
--new ship into table ships at
--the next sequential key
function addship()
	local s={
								x=flr(rnd(128)),
								y=flr(rnd(128)),
								f=false
								}
								
	local edge=flr(rnd(4))+1
	
	if edge==1 then 
		s.x=-8
		elseif edge==2 then
			s.y=-8
			elseif edge==3 then
				s.x=128
				else s.y=128
	end
	
	add(ships,s)
end

--gives ships ai hopefully
function flyship(s)

--if ship is left/right of player
--then move ship right/left
 if s.x>player.x then 
 	s.x=s.x-shipspeed
 	s.f=false
 	elseif s.x<player.x then
 		s.x=s.x+shipspeed
 		s.f=true
 end

--if ship is above/below player
--then move ship down/up 
 if s.y>player.y then 
 	s.y=s.y-shipspeed
 	elseif s.y<player.y then
 		s.y=s.y+shipspeed
 end
end

--checks if ships are colliding
--makes boom noise and deletes
--ships if they are. put the
--whole ships() table in s.
function boomship(s)
	
	--go through each ship
 for keya,shipa in	pairs(s) do
 
--if ship hits player 
 	if (shipa.x+7>player.x and shipa.x<player.x+7) 
 	and (shipa.y+7>player.y and shipa.y<player.y+7) then
				 hearts-=1
--record crash for later
					local crash={x=shipa.x,y=shipa.y}
					add(crashes,crash)
--delete ship
 				del(ships,shipa)
--play a crash sound
 				sfx(0)
 	end
 end
	
--go through each ship
 for keya,shipa in	pairs(s) do
--check against all other ships
 	for keyb,shipb in pairs(s) do
--if its not the same ship
 		if keyb!=keya then
--if the x and y are the same
 			if (shipa.x+7>shipb.x and shipa.x<shipb.x+7) 
 			and (shipa.y+7>shipb.y and shipa.y<shipb.y+7) then
--add to score
					if (score+25)%50<25 
					and (score+#ships+25)%50>=25 then
						sfx(2)
						hearts+=1
					end
					
					if (score+50)%100<50 
					and (score+#ships+50)%100>=50 then
						sfx(3)
						lives+=1
					end
					
					score+=#ships
--record crash for later
					local crash={x=shipa.x,y=shipa.y}
					add(crashes,crash)
					numcrash+=1
--delete both ships
 				del(ships,shipa)
 				del(ships,shipb)
--play a crash sound
 				sfx(0)
 			end
 		end
 	end
 	
 end
	
end 

function delship()
--[[deletes the first ship in 
the table and shifts remaining
ships down a slot (2nd becomes
first etc)]]
	del(ships,ships[1])
end

function drawstars(w,s,c)
--w=wind, s=size, c=color
	for star in all (cosmos) do
		circfill(star.x,star.y,s,c)
		star.x=(star.x+w)%128
 -- star.y=(star.y+(w*0.5))%128
	end
	
end	
-->8
--4 level transit state

function trans_update()
	
	timer+=1
	
	if timer>60 then --wait a moment

		--reset timer
		timer=0
		
 	--put player back in middle
  player.x=56
  player.y=56
  
  --clear out old ships
 	ships={}
  --clear out old crashes
  crashes={}
 	numcrash=0
	
 	if lives>0 then
 		if level>6 then
 			gamestate=3 --victory
 			else
 			gamestate=1 --keep playing
 		end
 	end
 	
 	if lives<=0 then
 		gamestate=2 --lose
 	end
	
	end
	
end

function trans_draw()
	if level<7 then
		print("level "..level,48,58,7)
		spr(16,48,70)
		print(" x "..lives,56,70,7)
		else print("c o n g r a t u l a t i o n s",4,64,7)
	end
end
