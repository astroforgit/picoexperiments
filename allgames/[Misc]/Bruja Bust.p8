pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--be magic do crimes v1.4
--by sadie_sys copyleft2018

function _init()
	cls()
	camera()
--max numb of ships at once
	maxships=6
	
	shipspeed=0.5
	
--crashes needed to win
	goal=10

	gamestate=0
	--	0 intro, 1 play, 2 lose,
	-- 3 win, 4 level transit

	score=0
	
	level=1 --current level of play
		
	lives=3 --player's lives
	
	hearts=4 --player's health
	
	heartscore=""
	
	numcrash=0 --#crashes goes here
		
	player={
		x=56,
		y=56,
		f=false
		}
	
	--make some stars
	cosmos={}	
	for star=1,64 do
		star={x,y}
 	star.x=flr(rnd(128))
 	star.y=flr(rnd(128))
 	add(cosmos,star)
 end
	
	ships={}--table to hold ships
	crashes={}--keep crashes for drawing
	timer=0
	btnrelease=false
end
	
function _update()
	
	if gamestate==0 then
		intro_update()
	end
	
	if gamestate==1 then
		play_update()
	end
	
	if gamestate==2 then
		lose_update()
	end
	
	if gamestate==3 then
		win_update()
	end
 
 if gamestate==4 then
 	trans_update()
 end
	
end

function _draw()
	cls()

	if gamestate==0 then
		intro_draw()
	end
	
	if gamestate==1 then
		play_draw()
	end
	
	if gamestate==2 then
		lose_draw()
	end
	
	if gamestate==3 then
		win_draw()
	end
	
	if gamestate==4 then
		trans_draw()
	end
	
end
-->8
--0 intro state
function intro_update()
	timer+=1
--check if player has let go of
--the button after playing
	if (btn(4)==false	and btn(5)==false) then
		btnrelease=true
	end
--push Ž or — to play
	if btnrelease==true and (btn(4) or btn(5)) then
		sfx(3)
		timer=0
		gamestate=1
	end
	
--[[uncomment to access debug
--push up to increase level
	if (btn(2) and level<7) then level+=1 end
--push down to decrease level
	if (btn(3) and level>2) then level-=1 end
--push right to increase hearts
	if btn(1) then hearts+=1 end
--push left to decrease hearts	
	if (btn(0) and hearts>2 )then hearts-=1 end
--]]
	
end

function intro_draw()
	--draw starry sky
	drawstars(-0.4,1,7) --wind,size,color
	--draw far cop copter
	spr(6,32,43)
	--draw far cop copter
	spr(6,40,48)
	--draw close cop copter
	spr(70,46,50,4,4)
	
	--draw witch
	spr(65,64,64,5,6)
	
	--draw title
	spr(134,6,6,10,2)
	spr(166,64,24,8,2)
	print("v1.4",110,0,5)
	
	--write instructions
	rectfill(0,120,128,128,0)
	print("dodge police drones and make them crash into each other. push — to play. good luck bruja!",128-(timer%500),120,11)
	
end
-->8
--1 play state
function play_update()
--create a new ship with Ž
--[[
	if btnp(4) and #ships<maxships then	
		addship() 
		sfx(1)
	end
	]]

--roll for random encounters
 local rnjesus=flr(rnd(21))

--how many ships does the cops
--have left?
	local rmn=goal-numcrash
	if rmn<=1 then rmn+=1 end

--if roll 20 and haven't maxed
--out your ships, add random
--ships up to max 	
	if rnjesus>19
	and #ships<maxships then
 	local randos=(flr(rnd(maxships)))%rmn
		for i=#ships,randos do
			addship()
			sfx(1)
		end
	end
	
--witch flight controls
	if btn(0) and player.x>0 then
	 player.x-=2.5
	 player.f=true
	 end
	if btn(1) and player.x<120 then 
		player.x+=2.5
		player.f=false
		end
	if btn(2) and player.y>0 then player.y-=2 end
	if btn(3) and player.y<120 then player.y+=2 end
	
--activate ship ai
	foreach(ships,flyship)
--clear crash cache
	numcrash+=#crashes
	crashes={}
--check if ships collide
	boomship(ships)
		
		
--beat level increase difficulty
	if numcrash>=goal then
		gamestate=4 --you won!
		level+=1 --increase level
		goal+=3
		hearts+=1
		maxships=3+flr(level/2)		
		
		if level==2 then 
			shipspeed+=0.5
		end
	
	end
	
	if hearts<=0 then
		lives-=1 --lose a life
		gamestate=4
		score=flr(score/2) --lose points
		sfx(4) --play a sad sound
		hearts=4
	end
	
	if lives<=0 then 
		gamestate=2
	end
end

function play_draw()

	--draw starry sky
	drawstars(-0.5,1,7) --wind,size,color

	--draw hud
	rectfill(0,0,128,18,0)
	color(7)
	print ("level: "..level.." lives: "..lives.." score:"..score)
	print ((goal-numcrash).." drones left")
	
	heartscore=""
	for i=1,hearts do
		heartscore=heartscore.."‡"
	end
	color(14)
	print (heartscore)

	--iterate through ships table
	--it goes through each key
	--but only returns the value at
	--that key which in this case
	--is another table (containing
	--data for a single ship) and
	--makes v point to that table
	for v in all(ships) do
		spr(6,v.x,v.y,1,1,v.f)
	end
	
	for v in all(crashes) do
		circfill(v.x,v.y,10,10)
	end
 --for above:
	--to acess the key as well as
	--the value the key points to
	--use pairs in place of all
	--with "k,v in pairs" key holds
	--the key 
	
 --draw player
	spr(16,player.x,player.y,1,1,player.f)
	
end


