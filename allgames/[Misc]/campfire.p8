pico-8 cartridge // http://www.pico-8.com
version 21
__lua__
-- campfire
-- by jonah

t = 0
turn = 0
p = {5,5,5,5,true}

music(2)

function rndcorner()
	return flr(rnd()+0.5)*8
end

goal = p
maingoal = {rndcorner(), rndcorner()}
idle,right,left,up,down=0,1,2,3,4
d = idle
animate = false
enemies = {	
}

function switch(e,z)
 tmp = {z[1],z[2]}
	z[3] = e[3]
	z[4] = e[4]
	e[3] = tmp[1]
	e[4] = tmp[2]
end

function water(x,y)
	return mget(flr(x+0.5),flr(y+0.5)) == 2
end	




function level(lvl)
	for i=1,lvl do
		x = rndcorner()
		y = rndcorner()
		enemies[#enemies+1] = {x,y,x,y,false}
	end
end

play = 4
lose = 20
theend = 36
game = theend
function upd(o)
 if o[1] < 0 then o[1] = 0 end
 if o[2] < 0 then o[2] = 0 end
 if o[1] > 8 then o[1] = 8 end
 if o[2] > 8 then o[2] = 8 end
 
	o[1] = o[1] + (o[3] - o[1])/4
 o[2] = o[2] + (o[4] - o[2])/4
 if abs(o[2] - o[4]) < 0.2 and 
 abs(o[1] - o[3]) < 0.2
 then
  o[2] = o[4]
  o[1] = o[3]
  return true
 end
 
 return false
end

function move(od,o,jump)
	v = 1
	if jump then v = 2 end
 if od == idle then o[3] = o[1] o[4] = o[2] return true end
	if od == left and o[1] > (0+(v-1)) then o[3] = o[1] - v return true end
	if od == right and o[1] < (8-(v-1)) then o[3] = o[1] + v return true end
	if od == up and o[2] > (0+(v-1)) then o[4] = o[2] - v return true end
	if od == down and o[2] < (8-(v-1)) then o[4] = o[2] + v return true end
	return false
end

function move_towards(e,g)
	if e[1] == g[1] or e[2] == g[2] then
			if e[1] < g[1] then move(right, e) end
			if e[1] > g[1] then move(left, e) end
			if e[2] < g[2] then move(down, e) end
			if e[2] > g[2] then move(up, e) end
	else
		if flr(rnd(2)) == 1 then
			if e[1] < g[1] then
			move(right, e)
			else
			move(left,e)
			end
		else
			if e[2] < g[2] then
			move(down,e)
			else
			move(up,e)
			end
		end
	end
end

function _update()
		foreach(enemies, function(e)
			if e[5] and e[1] == maingoal[1] and e[2] == maingoal[2] then 
				if game == lose then
				game = theend
				music(-1,100) 
				music(2,100) 
				end
			end
		end)
		if p[5] then
			goal = p
		else
			goal = {4,4}
			foreach(enemies, function(e)
				if e[5] then goal = e end
			end)
		end
		animate = false
  if upd(p) then 
  	d = idle
  else
  	animate = true
  end
  for i=1,#enemies do 
  	if upd(enemies[i]) then
  	else
  		animate = true
  	end
  end
		if animate == false and d == idle and p[1] == p[3] and p[2] == p[4] then
	 	if (btnp(0)) then d = left  end
		 if (btnp(1)) then d = right end
		 if (btnp(2)) then d = up    end
		 if (btnp(3)) then d = down  end
			if d != idle or btnp(5) then
			--	enemies = {}
			--	level(4)
				if game == play then
					turn += #enemies
				else
						if game == lose then
							turn -= 1
						end
				end	
				move(d,p,btn(4) and not water(p[1],p[2]))
				if p[3] == 4 and p[4] == 4 then
				 if p[5] and not btn(4) then
				 	p[5] = false
				 	if game == lose then
				 	
				 	level(1)
				 	else
				 	enemies = {}
				 	turn = 0
				 	level(2)
				 	end
				 game = play
				 	sfx(7)
						music(-1,100)
				 	music(1,100)
				 else
				 	if game == play and not btn(4) then
				 	game = lose
					 	sfx(5)
					 	music(-1,100)
							music(0,100)
					 	p[5] = true	
				 	end
				 end
				 move(idle,p)
				end
				for i=1,#enemies do
				 e = enemies[i]
					if e[5] then 
						if flr(rnd(3)+0.5) == 1 then
							move(flr(rnd(4)+1) ,e)
						else
							move_towards(e,maingoal)
						end
					else
						move_towards(e,goal)
					
					end
				end
				-- sound
				hit_enemy = false
				foreach(enemies, function(e)
					if flr(p[3]) == flr(e[1]) and flr(p[4]) == flr(e[2]) then
					hit_enemy = true
					end
				end)
				
				if hit_enemy then
					sfx(6)
				else
				 if not (p[1] == p[3] and p[2] == p[4]) then
					if btn(4) then
					-- jump
					sfx(13)
					else
						if water(p[1],p[2]) then
							sfx(14)
						else
						 sfx(4)
					 end
				 end
				 end
				end
				-- end sound
				
				for i=1,#enemies do
					e = enemies[i]
		
					if p[3] == e[3] and p[4] == e[4] then
						move(idle,e)
					end
					if p[1] == e[3] and p[2] == e[4] then
						move(idle,e)
					end
					if flr(p[3]) == flr(e[1]) and flr(p[4]) == flr(e[2]) then
						e[3] = flr(rnd()+0.5)*8
						e[4] = flr(rnd()+0.5)*8
						p[5] = e[5] or p[5]
						e[5] = false

						if not btn(4) then 
								move(idle,p)
						end
					end
						for j=1,#enemies do
							z = enemies[j]
							if z != e then
							
							 if (z[3] == e[3] and z[4] == e[4])
							 or (z[3] == e[1] and z[4] == e[2]) then
									if not z[5] then move(idle,z) end
								end
								if e[5] then
										if z[3] == e[3] and z[4] == e[4] then
											switch(z,e)
											end
									end
								
							end
						end
						if 4 == e[3] and 4 == e[4] then
						if game == play then
							game = lose
							music(-1,100)
							music(0,100)
							sfx(5)
							e[5] = true
							maingoal = {rndcorner(), rndcorner()}
						end
						move(idle,e)
					end
					
				end
				
			end
		end
end

	
	
function draw_sprite(img,x,y)
	if mget(flr(x+0.5),flr(y+0.5)) == 2 then
		img = img + 1
	end
	spr(img+(flr(t%2)*16),8*(x+1),8*(y+1))
end

function _draw()
	t = t + 0.125
		cls(0)	
	if game == play then
			rectfill(7,7,1+8*10,1+8*10,1)
	else
		rectfill(7,7,1+8*10,1+8*10,0)
		end

	rect(7,7,1+8*10,1+8*10,6)
	map(0,0,8,8)
		if game == lose then
		if p[5] then
			draw_sprite(10,4,4)
	
		else
			draw_sprite(10,maingoal[1], maingoal[2])
		end
	end
	spr(game+(t%4),8+8*4,8+8*4)
	ty = 0
	if flr(t) % 2 != 0 then
	ty = -0.25
	end
	foreach(enemies, function(e)
		x = e[1]
		y = e[2]
		draw_sprite(16,x,y)
		if e[5] then
			draw_sprite(8,x+0.25,y+ty)
		end
	end)
	draw_sprite(18,p[1],p[2])
	if p[5] then
		draw_sprite(8,p[1]+0.25,p[2]+ty)
	end
	print(""..turn.."\n‰"..#enemies,11*8,4,7)
	
	if game == theend then
		print("lIGHT\nTHE\nCAMPFIRE\nFOR\nnEW gAME",11*8-2,4+3*8,7)
	end

end
