pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
-- til sophie
peace = false
function ghost()
	local a = rnd() 
	return {
		sx=5,
		sy=0,
		x=cos(a)*100+64,
		y=sin(a)*100+64,
		vx=0,
		vy=0,
		w=7,
		h=4,
		t=0,
		ox=4,
		oy=8,
		tp="ghost",
		flp=false,
		fr={5,6,7,6},
		dead=false,
		frdead={5,6,7}
	}
end 


function dst(x,y)
	return sqrt(x*x+y*y)
end

function init()
music(0)
score = 0
brktm = 0
state = "playing"
pl = {
combo=0,
mult=1,
t=0,
dash=false,
candash=false,
x=64-23,
y=64,
vx=0,
vy=0,
t=0,
w=4,
h=2,
ox=6,
oy=13,
sx=2,
sy=0,
fr={2,3},
flp=false}

pump={
smsx=0,
x=64-16,
y=64,
w=16,
h=8,
ox=0,
oy=8,
vx=0,
vy=0,
sx=0,
sy=0,
fr={0,1}
}
local g = ghost()
g.flp=true
g.x=64+16
g.y=64
o = {pump,pl,g}
end 

function _init()
cartdata("sop_data")
score = 0
brktm = 0
state = "menu"
debug = false
pl={}
pump={}
o= {}
t=0
--init()
end
brktime=0
shaketo = 0
function shake(d)
 shaketo = (t + d)
end


function insort(t,cmp)
    for n=2,#t do
        local i=n
        while i>1 and not cmp(t[i-1],t[i]) do
            t[i],t[i-1]=t[i-1],t[i]
            i-=1
        end
    end
end

function ascending_y(a,b) 
    return a.y<=b.y 
end

function particle(x,y,c)
a = rnd()
r = 0.2 + rnd() * 4
return {
x=x,
y=y,
tp="particle",
txt=nil,
vx=cos(a)*r,
vy=sin(a)*r,
t=rnd()*15+3,
c=c or 7,
}
end

function col(a,b)
local ax,ay=a.x+a.ox,a.y+a.oy
local bx,by=b.x+b.ox,b.y+b.oy
return not 
(ax>bx+b.w or
ax+a.w<bx or
ay>by+b.h or
ay+a.h<by)
end

function pumphit()
pump.sx=1
pump.smsx=t+1

end

txts = {
"hej! - tryk —",
"det er blevet d. 25 okt. igen!",
"du ved jo hvad det betyder...",
"at der er 6 dage til halloween!!",
"...oog det er i dag du blev til",
"...for 599184000 s. siden",
"ja...", 
"tillykke med det!",
"men...",
"vigtigst af alt er lige nu..",
"at der er uhyre over det hele.",
"oooohhh shit.",
"verden skal reddes.",
"og det er op til dig.",
"er du klar? - tryk —"
}
ln = 1

function menu_draw()
cls()
for j=1,ln do 
	local txt = txts[j]
	local to = #txt
	if(ln==j)to=min(t,#txt)
 for i=1,to do
 	local s = sub(txt, i,i)
 	local x,y=i*4,j*8
 	print(s,x,y+1,1)
 	print(s,x,y,(i+j)%2+9)
 	if (s != " " and ln==j and t <= #txt) then
 	sfx(9)
 	end
 end
end

if(btnp(5))then
	t=0
	ln+=1
	if ln == #txts + 1 then
		init()
	end
end
end



function menu()
	
end


function pl_move()

if t % 3 == 0 then
	pl.t += 1
	pl.t = pl.t % #pl.fr
end

if not pl.dash and (abs(pl.vx)+abs(pl.vy) > 0) then
	pl.sx = pl.fr[pl.t  + 1]
else
	pl.sx = pl.fr[1]
end

if pump.smsx < t then
	pump.sx = 0
end

if not pl.dash then
 pl.vx,pl.vy = 0,0
 if(btn(0))pl.vx=-1
 if(btn(1))pl.vx=1
 if(btn(2))pl.vy=-1
 if(btn(3))pl.vy=1
 if pl.vx != 0 or pl.vy != 0 then
  pl.flp = pl.vx == -1
 end
 if(btnp(4) and pl.candash) then
 	pl.dash=true
 	pl.candash=false
 	pl.sx=2
 	pl.sy=1
 	sfx(6)
 end
else
	local vx,vy=pump.vx,pump.vy
 local dv=dst(vx,vy)
	local dx=pump.x-pl.x
	local dy=pump.y-pl.y
	local d = dst(dx,dy)
	local ddx,ddy=(dx+dx/d*32),
	(dy+dy/d*32)
	
	pl.x += dx/4
	pl.y += dy/4
	if dst(dx,dy) < 8 then
		pl.dash=false
		pl.sy=0
	end
	
	for i=1,2 do
		local r = flr(rnd()*2)
		local p=
		particle(
		pl.x+rnd()*2,
		pl.y+rnd()*2+pl.oy/2,r+9)
		p.t = 8
		p.vx /= 5
		p.vy /= 5
		p.vx+=-dx/30
		p.vy+=-dy/30
		add(o,p)
	end
end

if(pl.x+pl.w > 128-8)pl.x=128-8-pl.w
if(pl.x-pl.w < 8)pl.x=pl.w+8
if(pl.y+pl.h+pl.oy/2 > 128-8)pl.y=128-pl.h-pl.oy/2-8
if(pl.y-pl.h < 2)pl.y=pl.h+2

local dx,dy=pump.x-pl.x,pump.y-pl.y
local l = dst(dx,dy)
if l < 12 and btnp(5) then
pump.vx = dx*8/l
pump.vy = dy*8/l
sfx(0)
shake(7)
for i=1,10 do
	local r = flr(rnd()*2)+9
	add(o,particle(pump.x,pump.y,r))
end
pumphit()
end

if btn(5) then
	pl.sx = pl.fr[2]
end
end

function pump_move()
local j = pump
j.vx *=0.9
j.vy *=0.9

if dst(pump.vx,pump.vy)>4 then
	local rx,ry=rnd()*8,rnd()*8
	local p=
	particle(j.x+rx/2,j.y-ry/2)
	p.c=8
	p.vx/=10
	p.vy/=10
	p.t=5
	add(o,p)
end

function gt(a,b)
	return a > b
end

function lt(a,b)
	return a < b
end

function bounce(d,to,cmp)
	if cmp(j[d],to) then
	j[d] = to
	j["v"..d] *= -1
	sfx(rnd()*3+3)
	pumphit()
	shake(5)
	end
end
bounce("x",16,lt)
bounce("x",120-8,gt)
bounce("y",9,lt)
bounce("y",128-16,gt)
end



function play()

if(btnp(0,1))peace=not peace

pl_move()
pump_move()

for j in all(o) do
	j.x += j.vx
	j.y += j.vy
	
	if j.tp=="particle" then
	j.t -= 1
	j.vx *= 0.9
	j.vy *= 0.9
	
	if j.t <0 then
		del(o,j)
	end
	end

	if j.tp == "ghost" then
			j.t += 1
			
			if not j.dead then
			local f = flr(j.t/10)%#j.fr
			j.sx = j.fr[f+1]
			
			if score > 0 then
			local dx = pl.x - j.x
			local dy = pl.y - j.y
			local l = dst(dx,dy)
			j.vx += dx/l/10
			j.vy += dy/l/10
			do
			local sx,sy=0,0
			local sum=0
			for g in all(o) do
 			if g.tp=="ghost" and g != j then
 				local dxx,dyy=j.x-g.x,j.y-g.y
 				local d = dst(dxx,dyy)
 				if d<4 then
 					sx+=dxx/d
 					sy+=dyy/d
 					sum+=1
 				end
 			end
			end
			if sum>0 then
 			sx /= sum
 			sy /= sum
 			local d = dst(sx,sy)
 			j.vx += sx/d/8
 			j.vy += sy/d/8
			end
			end
			
			if rnd()>0.8 then
				local a=rnd()
				j.vx += cos(a)/4
				j.vy += sin(a)/4
			end
			
			j.flp = j.vx < 0
			
			if (dst(64-j.x,64-j.y)>60) then
 			j.vx *= 0.75
 			j.vy *= 0.75
 			else
 			j.vx *= 0.95
 			j.vy *= 0.95
 			end
 			local d=dst(j.vx,j.vy)
 			if d > 8 then
 				j.vx = j.vx/d * 8
 				j.vy = j.vy/d * 8
 			end
 		end
			local pv=abs(pump.vx)+abs(pump.vy)
			if col(pump,j) and pv > 0.5 then
				--del(o,j)
				pl.candash=true
				j.dead = true
				shake(5)
				j.t = 0
				for i=1,30 do
				local dx,dy=rnd()*4,rnd()*8
				local p =particle(j.x+dx-2,j.y+dy-4)
				p.c = rnd()*3+5
				p.vx += pump.vx/2
				p.vy += pump.vy/2
				add(o,p)
				end
				--local point=j.combo*j.mul
				local point = 1
				score+=point
				pumphit()
				sfx(rnd()*2+1)
				if(state=="menu")state="playing"
				local p = particle(j.x,j.y)
				p.vx=0
				p.vy=-2
				p.txt="+"..point
				p.c=7
				p.t=16
				add(o,p)
			end
			
			if col(j,pl) and not peace then
				sfx(7)
				state="gameover"
				if score > dget(0) then
					dset(0,score)
				end
				dset(1,dget(1) + 1)
				music(-1)
				sfx(26)
				pl.sx=3
				pl.sy=1
			end
	else
		local f = flr(j.t)%#j.frdead
		j.sx = j.fr[f+1]
		j.sy = 1
		if(j.t > 5)del(o,j)
	end
	end
end


local total = 0
for _,v in pairs(o) do
	if(v.tp=="ghosts")total+=1
end
if score > 0 and (total < 10 and t % (70+50-min(50,score)) == 0) then
	add(o,ghost())
end
end

palt(0,false)
palt(12,true)

function _draw()

if(state=="gameover")then
gameover_draw()
return
end
insort(o,ascending_y)

if not peace then
cls()
map(0,0,0,0,32,32)
line(8,128-8,127-8,128-8,1)
else

for i=1,999 do
	local x,y = rnd()*128,rnd()*128
	local c = pget(x,y)
	circ(x,y,1,c%2 + 14)
end

end


if(state=="menu")menu_draw()

if (shaketo > t) then 
camera(cos(t/3)/10, cos(t/2)/10)
else
camera(0,0)
end

if (pl.candash) then
local c = 10
rect(8,8,127-8,127-8,c)
end

if state=="playing" then
	local s=""..score
	local c = 7
	if(peace)c = 0
	print(score,64-#s/2,2,c)
end

for j in all(o) do

if j.tp=="particle" then
if not j.txt then 
circ(j.x,j.y,rnd()*2,j.c)
else
print(j.txt,j.x,j.y+1,1)
print(j.txt,j.x,j.y,7)
end
else

local x,y=j.x-8,j.y-8
sspr(
j.sx*16,
j.sy*16,
16,
16,
x,
y,16,16,j.flp)
end



--debug

if debug then
rect(
x+j.ox,y+j.oy,
x+j.w+j.ox,y+j.h+j.oy, 7)
end

end
end

function printc(txt,x,y,c)
local l = #txt*4
print(txt,x-l/2,y+1,1)
print(txt,x-l/2,y,c or 7)
end

function gameover_draw()
	for i=1,999 do
		local x,y = rnd()*128,rnd()*128
		circ(x,y,1,0)
	end
	if t % 40 > 10 then
	local txt ="spil igen? - tryk —" 
	printc(txt,64,128-6)
	end
	
	local sctxt = "score: " .. score
	if score == dget(0) then
		sctxt = "ny highscore: " .. score
	end
	
	printc(sctxt,64,60,7)
	
	printc(
	"modige fashiongirls: " 
	..dget(1),64,67,7)
end

function gameover()
	if(btn(5))init()
end

function menu()
end

function _update()
t += 1

if state=="gameover" then
gameover()
return
end

if(state=="playing")play()
if(state=="menu")menu()
end
