pico-8 cartridge // http://www.pico-8.com
version 29
__lua__
-- woolcat 3d
-- by cubee

--[[ changes

- 15 new city areas (81 total)
- original: 66 areas

- a few changed levels since it's 3d now

- hd 3d rendering and new cat sprite

- fancy title screen

]]

debug=false

--[[ credits:

instant 3d:
 https://www.lexaloffle.com/bbs/?tid=37733

]]

-- instant 3d
-- (modded to upscale from 64px)
_={
 map=map,
 spr=spr,
 sspr=sspr,
 pset=pset,
 circ=circ,
 camera=camera,
 cx=0,
 cy=0,
 cyoff=32,
 ch=32,
 d=128,
 ymid=0,
 s2w=function(x,y)
  return (x-_.cx)-64,_.ch,64-(y-_.cy)
 end,
 proj=function(x,y,z)
  local scale=_.d/z
  return x*scale+64,y*scale+_.ymid,scale
 end
}

camera=function(x,y)
 _.cx=x or 0
 _.cy=(y or 0)+_.cyoff
end

camera(0,0)

pset=function(x,y,c)
 local wx,wy,wz=_.s2w(x,y)
 if(wz<1)return
 local px,py=_.proj(wx,wy,wz)
 _.pset(px,py,c)
end

circ=function(x,y,r,c)
 local wx,wy,wz=_.s2w(x,y)
 if(wz<1)return
 local px,py,scale=_.proj(wx,wy,wz)
 _.circ(px,py,r*scale,c)
end

sspr=function(sx,sy,sw,sh,x,y,w,h,fx,fy,sc)
 sc=sc or 1
 w=w or sw
 h=h or sh
 ow=w
 oh=w
 w*=sc
 h*=sc
 local wx,wy,wz=_.s2w(x+w/2,y+h)
 if(wz<1)return
 local px,py,scale=_.proj(wx,wy,wz)
 local pw,ph=w*scale,h*scale

 -- sub pixel stuff
 local x0,x1=flr(px-pw/2),flr(px+pw/2)
 local y0,y1=flr(py-ph),flr(py)

 _.sspr(sx,sy,sw,sh,x0,y0,(x1-x0),(y1-y0),fx,fy)
end

spr=function(n,x,y,w,h,fx,fy,sc)
 sc=sc or 1
 if(not n or not x or not y)return
 -- convert to equivalent sspr() call
 w=(w or 1)*8
 h=(h or 1)*8
 local sx,sy=flr(n%16)*8,flr(n/16)*8
 sspr(sx,sy,w,h,x,y,w,h,fx,fy,sc)
end

map=function(cx,cy,x,y,w,h,lyr)
 cx=cx or 0
 cy=cy or 0
 x=x or 0
 y=y or 0
 w=w or 8
 h=h or 8

 -- near/far corners
    local fx,fy,fz=_.s2w(x,y)
    local nx,ny,nz=_.s2w(x,y+h*8)

 -- clip
 nz=max(nz,0.5)
 if(fz<=nz)return

 -- project
 local npx,npy,nscale=_.proj(nx,ny,nz)
 local fpx,fpy,fscale=_.proj(fx,fy,fz)

 -- clamp
 npy=min(npy,128)
--[[
	palt(0,true)
	rectfill(0,0,127,fpy*0.7,12)
	for i=1,3 do
	 --spr(3,48*i-48,-34,6,1)
	end
	palt(0,false)
]]
 -- rasterise
 local py=flr(npy)
 while py>=fpy do

  -- floor plane intercept
        local g=(py-_.ymid)/_.d
        local z=_.ch/g      

        -- map coords
        local mx,my=cx,(fz-z)/8+cy

        -- project to get left/right
        local lpx,lpy,lscale=_.proj(nx,ny,z)
        local rpx,rpy,rscale=_.proj(nx+w*8,ny,z)

        -- delta x
        local dx=w/(rpx-lpx)

        -- sub-pixel correction
        local l,r=flr(lpx+0.5)+1,flr(rpx+0.5)
        mx+=(l-lpx)*dx

  -- render
        tline(l,py,r,py,mx,my,dx,0,lyr)

  py-=1
 end 
end

-- wool cat
-- by cubee ‚

-- orignally made for the
-- fantasy console game jam #5

-- started:   4/4/20
-- submitted: 11/4/20

function _init()
 seed=rnd(-1)
 srand(seed)
 area="hello!"
 t=0
 t2=0
 x=8
 y=8
	xv=0
	yv=0
 shake=0
 meow=0
 wool=0
 t_wool=0
 lev_x=0
 lev_y=0
 x2=0
 y2=0
 safetime=0

 wait=0
 happy=128
 mode="splash"
 cat=rnd(3)

 find_home()
 ax=x
	ay=y
 pbtn={}
 rhythm=false
 beat=0
 last=31

 lh=0
 fy=-8

end

function _update60()
 --menuitem(1,"rhythm mode",function()rhythm=not rhythm end)

 beat=stat(20)

 if mode=="splash" then

  if (t==300 or (btnp()~=0 and not btn(6))) st=true
  if st and abs(lh)<1 then
   fade("title")
   t=0
   sfx(-1)
   music(0)
  end
  if t==1 then
   sfx(44)
  end

 elseif mode=="title" then
  if btnp()~=0 then
   sfx(0)
   fade("game",true)
   music(8)
   t2=0
  end

 elseif mode=="game" then
	 px=x
	 py=y

	 -- move
	 sf=false
	 if rhythm then
		 if(btnp(0))xv=-1 yv=0 d=true
		 if(btnp(1))xv=1 yv=0 d=false
		 if(btnp(2))yv=-1 xv=0
		 if(btnp(3))yv=1 xv=0

		 if(btn(0))xv=-1
		 if(btn(1))xv=1
		 if(btn(2))yv=-1
		 if(btn(3))yv=1

		 if beat%2==0 and beat~=last then
		  x+=xv
		  y+=yv
		  last=beat

	   sfx(2)
	   if(t>20)t=5
	   wait=0
		 end

	 else
	  if btnp()~=0 then
	   safetime=8
	   wallhit=false
	  end
		 if btnp(0) then
		  if(btnp(2) or btnp(3))y2=0
		  x-=1
		  if(btn(2) or btn(3))y+=y2
		  d=0
		  sf=1
		  x2=-1
		  y2=0
		 elseif btnp(1) then
		  if(btnp(2) or btnp(3))y2=0
		  x+=1
		  if(btn(2) or btn(3))y+=y2
		  d=1
		  sf=1
		  x2=1
		  y2=0
		 end
		 if btnp(2) then
		  if(btnp(0) or btnp(1))x2=0
		  y-=1
		  if(btn(0) or btn(1))x+=x2
		  d=2
		  sf=1
		  y2=-1
		  x2=0
		 elseif btnp(3) then
		  if(btnp(0) or btnp(1))x2=0
		  y+=1
		  if(btn(0) or btn(1))x+=x2
		  d=3
		  sf=1
		  y2=1
		  x2=0
		 end
		end

  safetime=max(safetime-1)
  if safetime==0 then
   x2=0
   y2=0
  end

	 if btnp(4) or btnp(5) then
	  sfx(13+rnd(4))
	  shake=5
	  meow=10
	 end

	 -- move cat
	 ax+=(x-ax)/5
	 ay+=(y-ay)/5

  if wallhit and safetime==0 then
	  sfx(3)
	  shake=10
	  wallhit=false
	 end

	 -- hit wall
	 if fget(mget(x,y),0) then
	  x=px
	  y=py
	  wallhit=true
	 -- restart tile
	 elseif fget(mget(x,y),2) and fget(mget(ax+0.5,ay+0.5),2) then
	  sfx(17)
	  reload()
	  find_home()
	  done=false
	  happy-=5
	 else
	  -- step sound
	  if sf then
	   sfx(2)
	   if(t>20)t=5
	   wait=0
	  end
	 end

	 -- get wool
	 if fget(mget(x,y),1) and fget(mget(ax+0.5,ay+0.5),1) then
	  sfx(4)
	  if fget(mget(x,y),3) then
	   mset(x,y,86)
	  else
	   mset(x,y,17)
	  end
	  t_wool+=1
	  happy+=10
	  happy=min(happy,128)
	  done=true
	  t=0
	  -- check if any left
	  for ix=lev_x,lev_x+7 do
	   for iy=lev_y,lev_y+7 do
	    if fget(mget(ix,iy),1) then
	     done=false
	    end
	   end
	  end
	 end

	 -- next level
	 if done then
	  if t>20 then
    wool+=t_wool
    t_wool=0
		  sfx(1)
		  lev_x+=8
		  if lev_x>=128 then
		   lev_x=0
		   lev_y+=8
		  end
		  find_home()
		  ax=x
		  ay=y
		  done=false
		  -- win if none left
		  en=false
		  for ix=lev_x,lev_x+7 do
		   for iy=lev_y,lev_y+7 do
		    if mget(ix,iy)==63 then
		     en=true
		    end
		   end
		  end
	   if en or lev_y>=64 then
		   win()
		  else
	    fade("game",true)
	    t2=0
		  end
		 end
	 end

  -- cat sprites
	 rng=0.1
	 fl=false
	 if d==2 then
	  o=200
	 elseif d==3 then
	  o=232
	 else
	  if d==0 then
	   fl=true
	  end
	  o=192
	 end
	 if ax>x+rng or ax<x-rng or
	    ay>y+rng or ay<y-rng then
	  spt=o+2+flr(t%15/5)*2
	 elseif wait>500 then
	  spt=226
	 elseif wait>480 then
	  spt=224
	 elseif wait>120 then
	  spt=232
	 else
	  spt=o
	 end


	 -- game timers
	 wait=max(wait+1)
	 shake=max(shake-1)
	 happy=max(happy-0.08)
  meow=max(meow-1)

  if happy<=0 then
   fade("over")
  end

 elseif mode=="win" or mode=="over" then
  if btnp()~=0 then
   fade()
   run()
  end
 end
 
 for i=0,6 do
  pbtn[i]=btn(i)
 end

 -- timers
 t=max(t+1)
 t2=max(t2+1)
end

function _draw()
 pal()
	pal(1,1,1)
 if pmode==mode then
	 cls()
	 camera()
  if mode=="splash" then
	  -- reset colours
	  pal()
	  palt(10,true)
	  if st then
	   lh-=sgn(lh)
	   lw+=abs(lh/4)
	  else
	   lw=min(abs(sin(t/300)*16)+t/3,64)--96
	   lh=min(abs(cos(t/400)*16)+t/6-32,16)
	  end
	  _.sspr(64,80,64,16,64-lw/2,64-lh/2,lw,lh)

  elseif mode=="title" then
	  cls(1)
	  camera(-32,0)
	  map(0,0)
	  ay=8
   tiles(0)

	  camera()
	  pal()
	  palt(0,false)
	  palt(14,true)
	  if t<128 then
	   if t>32 then
 	   spr(228,72,min(-256+abs(t-32)*(t-32)/2,8),2,2)
    end
    spr(64,40,min(-256+t*t/2,8),4,3)
	  else
 	  spr(228,72,8,2,2)
	   spr(64,40,8,4,3)
	  end
	  if t>64 then
	   bcprint("press any button to start",64,88.5+sin(t/360)*4)
   end
	  if t>96 then
	   bcprint("2020 cubee games ‚",64,121)
   end

	 elseif mode=="game" then
	  if (tonum(area) or 0)>=57 then
		  cls(13)
	  else
		  cls(1)
		 end
		 palt()

		 camera(shake/4*(rnd(2)-1)-32+ax%8*8-28,shake/4*(rnd(2)-1)+ay%8*8-24)

   palt(0,false)

		 -- draw level
		 map(lev_x,lev_y)

   tiles()

		 -- draw cat
		 catpal()
		 if(debug)spr(230,(ax+x2-lev_x)*8,(ay+y2-lev_y)*8,2,2,fl,false,0.5)
		 spr(spt,ax*8-lev_x*8,ay*8-lev_y*8,2,2,fl,false,0.5)

		 --spr(spt,ax*8-lev_x*8,ay*8-lev_y*8,1,1,fl)

   tiles(true,ay)

		 -- draw hud
		 catpal()
		 camera()

   -- happy bar
		 rectfill(0,124,happy,127,7)

   -- blink offset time
   if t2%60==50 then
    rn=rnd(50)
   end

   cf_y=115

   -- draw cat face
   if meow>0 then
    _.spr(max(104,110-flr(happy/21)*2),-2,cf_y,2,1)
    _.spr(94,-2,cf_y+8,2,1)
   elseif t2%60+(rn or 0)<10 then
    _.spr(110,-2,cf_y,2,1)
    _.spr(mid(118,126-happy\21*2,120),-2,cf_y+8,2,1)
   else
    _.spr(max(104,110-happy\21*2),-2,cf_y,2,1)
    _.spr(mid(118,126-happy\21*2,120),-2,cf_y+8,2,1)
   end

   -- print current area
		 pal()
		 area=lev_x/8+1+lev_y*2
		 bprint("area "..area,2,2)

   if area%8==1 and t2<160 then
    bcprint(text[2][ceil(area/8)],64,t2-8)
   end

	 elseif mode=="win" or mode=="over" then
	  pal()
	  palt(0,false)
	  palt(1,true)
	  wool=128
	  srand(wool)
	  for i=1,wool do
	   xo=sin((t+rnd(64))/100)*(i%4+4)+32
	   yo=cos((t+rnd(64))/100)*(i%4+4)
	   spr(164+rnd(4),rnd(56)+xo,rnd(56)+yo)
	  end
	  if mode=="win" then
	   bcprint("yay!",64+sin(t/300)*6,16+tan(t/300))
	   bcprint("woolly got back home!",64+cos(t/300)*6,41+tan((t-8)/300))
   else
 	  bcprint("game over",64+sin(t/300)*6,16+tan(t/300))
 	  bcprint("woolly reached",64+cos(t/300)*6,41+tan((t-8)/300))
 	  bcprint("area "..area,64+cos(t/300)*6,48+tan((t-8)/300))
   end

	 end

 else
  cls(0)
	end

 pmode=mode

 palt(0,false)
 camera()
 fy+=(136-fy)/10
 rectfill(0,128,127,fy,0)

 if mode~="splash" then
	 pal(1,131,1)
  if mode=="title" then
	  pal(15,1,1)
  else
	  pal(15,133,1)
	 end
 end

end

-->8
-- functions

function find_home()
 srand(seed)
 for ix=lev_x,lev_x+7 do
  for iy=lev_y,lev_y+7 do
   if fget(mget(ix,iy),7) then
    x=ix
    y=iy
    if fget(mget(ix,iy),3) then
     mset(ix,iy,86)
    else
     mset(ix,iy,17)
    end
   elseif mget(ix,iy)==33 then
    mset(ix,iy,33+rnd(4))
   elseif mget(ix,iy)==18 then
    mset(ix,iy,21+rnd(4))
   elseif mget(ix,iy)==16 then
    mset(ix,iy,49+rnd(5))
   elseif mget(ix,iy)==73 then
    mset(ix,iy,74+rnd(4))
   end
  end
 end

end

function bprint(t,x,y,tc,bc)
 t=tostr(t)
 for ix=-1,1 do
  for iy=-1,1 do
   print(t,x+ix,y+iy,bc or 13)
  end
 end
 print(t,x,y,tc or 7)
end

function bcprint(t,x,y,tc,bc)
 xo=#t*4/2
 bprint(t,x-xo,y,tc,bc)
end

pbtnp=btnp

function btnp(i)
 if not i then
  return pbtnp()
 end
 if btn(i) and not pbtn[i] then
  return true
 end
 return false
end

function fade(m,pl)
 if not pl then
  music(-1,600)
 end
 dark={0,1,1,2,1,13,6,4,4,9,3,13,1,13,1}
 for i=1,30 do
  for pi=1,15 do
   col=pi
   for a=1,i-i/30 do
    col=dark[col]
   end
   pal(pi,dark[col],1)
  end
  flip()
  flip()
 end
 if m then
  mode=m
 end
 fy=-8
end

--[[
if stat(102)==0 or stat(102)=="www.lexaloffle.com" or stat(102)=="cubeegames.shshock.com" then
 real=true
else
 real=false
end
real=true
]]

function tan(a)
 return sin(a)/cos(a)
end

function win()
 fade("win")
 music(22)
 sfx(37)
end

function catpal()
	palt(0,false)
 palt(8,true)
 if cat<1 then
 elseif cat<2 then
  pal(6,4)
  pal(7,9)
  pal(13,2)
 elseif cat<3 then
  pal(6,15)
  pal(7,5)
  pal(13,0)
 else
  pal(6,2)
  pal(7,8)
  pal(13,1)
 end
end

function tiles(btm)
 pal()
 palt(0,false)
 palt(1,true)
 for ix=0,7 do
  for iy=0,7 do
   if (btm and iy>ay%8) or (not btm and iy<=ay%8) then
    til=mget(ix+lev_x,iy+lev_y)
	   if fget(til,6) then
	    spr(69,ix*8,iy*8-16,1,3)
	   elseif fget(til,1) then
	    if fget(til,3) then
	     spr(til+90,ix*8,iy*8)
	    else
	     spr(til+143,ix*8,iy*8)
	    end
	   elseif fget(til,4) then
	    if fget(til,5) then
	     spr(til+122,ix*8,iy*8)
	    else
	     spr(180,ix*8,iy*8)
	    end
	   elseif fget(til,5) then
	    spr(til+73,ix*8,iy*8)
	   end
	  end
  end
 end
end
--[[
function fade()
 palt(0,false)
 camera()
 fy=128
 while fy>-7 do
  fy+=(-8-fy)/10
  rectfill(0,128,127,fy,0)
  flip()
 end
 fy=-8
end
]]
