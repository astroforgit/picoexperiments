function _draw()
 cls()
 if(pstate=="logo") then
  logo()
 elseif(pstate=="intro" and
    instate=="text") then
  local name = levs[glev].name
  print(name,
    63-(#name*2),50,8)
  print(levs[glev].world,
    57,60,7)

  local t = tips[tipnum]
  print("tip:",0,80,6)

  print(t[1],0,88,6)
  print(t[2],0,96,6)

 elseif(pstate=="gameover") then
  anim_gameover()
 elseif(pstate=="win") then
  anim_win()
 elseif(pstate=="title") then
  -- t stuff
  anim_title()
 elseif(pstate=="pregame") then
  -- pg stuff
  anim_preamble()
 else
  camera(-b.x,-b.y)
  draw_backdrop() 
  draw_robots()
  draw_junk()
  if(p.alive) then
   local d = get_dir()
   if(d.dx!=0 or d.dy!=0) then
    draw_destination()
   end
  end
  draw_shield()
  draw_player()
  camera() 
  draw_ui()
 end
end

-- pick a random unoccupied
-- tile for the player to
-- teleport to, and move 'em
function teleport()
 -- compile list of open tiles
 local open = {}
 local npos = nil
 for x=1,b.w do
  for y=1,b.h do
   if(b.brd[x][y].occ == nil) then
    add(open,{x,y})
   end
  end
 end
 -- and pick one at random
 npos = open[flr(rnd(count(open)))+1]
 local dx = npos[1] - p.tx
 local dy = npos[2] - p.ty
 didtele = true
 move(dx,dy)
end

-- level exit anim
function do_outro()
 telestate = "out"
 teleframe = 1
 p.stx = -100
 p.sty = -100
 teledelay = 2
 music(16)
 pstate = "outro"
 outroc = 60
end

function do_intro()
 telestate = "in"
 teleframe = 1
 teledelay = 2
 instate = "text"
 introc = 60
 pstate = "intro"
 p.vis = false
end

-- try to move player, return
-- true if success, else false
function move(dx,dy)
 if(dx==0 and dy==0) then
  -- player is staying put
  return true
 end
 
 local nx = p.tx + dx
 local ny = p.ty + dy
 if(nx>0 and nx<b.w+1 and
    ny>0 and ny<b.h+1) then
  -- in basic bounds
  local nt = b.brd[nx][ny]
  if(nt.occ == nil) then
   -- moving to an legit tile
   b.brd[p.tx][p.ty].occ = nil
   p.tx = nx
   p.ty = ny
   p.stx = (nx-1)*sz
   p.sty = (ny-1)*sz
   b.brd[nx][ny].occ = p
   return true
  end
 end
 return false
end

function move_robots()
 for rob in all(rs) do
  local nx = rob.tx
  local ny = rob.ty
  if(nx>p.tx) then
   nx -= 1
  elseif(nx<p.tx) then
   nx += 1
  end
  if(ny>p.ty) then
   ny -= 1
  elseif(ny<p.ty) then
   ny += 1
  end
  b.brd[rob.tx][rob.ty].occ = nil
  rob.tx = nx
  rob.ty = ny
  rob.stx = (nx-1)*sz
  rob.sty = (ny-1)*sz
 end
end

-- adjudicate new rob/human pos
function collide() 
 local rkill = false
 for rob in all(rs) do
  -- for each robot we check
  -- 1. if moving into rob/junk
  --  space (kill and junkify)
  -- 2. if moving onto human
  --  (kill human)
  local nt = b.brd[rob.tx][rob.ty]
  if(nt.occ == nil) then
   -- moving to empty spot, ok
   nt.occ = rob
  elseif(nt.occ.type == robot) then
   -- add junk tile and
   -- kill this robot, and
   -- that other robot 
   local nj = new_junk(rob.tx,rob.ty)
   add(js,nj)
   del(rs,rob)
   del(rs,nt.occ)
   nt.occ = nj
   rkill = true
  elseif(nt.occ.type == junk) then
   -- kill this robot  
   del(rs,rob)
   rkill = true
  elseif(nt.occ.type == human) then
   -- kill human!
   nt.occ = rob
   p.alive = false
  end
 end
 if(rkill) sfx(3,3)
end

-- return a pair of dx/dy
-- coords based on current
-- arrows
function get_dir()
 local d = {}
 d.dx = 0
 d.dy = 0
 if(btn(0)) d.dx -= 1
 if(btn(1)) d.dx += 1
 if(btn(2)) d.dy -= 1
 if(btn(3)) d.dy += 1
 return d
end

function do_input()
 local moved = false
 -- handle 8-dir dpad input
 if(btnp(4)) then
  local d = get_dir()
  moved = move(d.dx,d.dy)
  didtele = false
  if(moved) then 
   if(d.dx!=0 or d.dy!=0) then
    -- only play if we're act.
    -- walking somewhere
    sfx(2,3)
    return "walk"
   else
    -- stay put sound
    sfx(5,3)
    return "stand"
   end
  end
 elseif(btnp(5)) then
  teleport()
  sfx(0,3)
  telestate = "out"
  moved = true
  didtele = true
  return "tele"
 end
 return "none"
end

function do_input_gameover()
 if(btnp(4)) then
  new_game()
 end
end

function do_input_title()
 if(btnp(4)) then
  pstate = "pregame"
 end
end

function do_input_pregame()
 if(btnp(4)) then
  new_game()
 end
end

function anim_shield() 
 if(shanim) then
  if(shframe==1) sfx(4,3)
   shframe += sz/8 * 0.75
  if(shframe > sz) then
   shanim = false
   for rob in all(doomedrs) do
    del(rs,rob)
   end
   return false
  end
  return true
 end
 return false 
end

function anim_player_move()
 if(telestate != "none") then
  return anim_teleport(p)
 else
  return anim_mob_move(p)
 end
end

function anim_robots_move()
 local done = true
 for r in all(rs) do
  if(anim_mob_move(r)) then
   done = false
  end  
 end
 return(not done)
end

function anim_mob_move(m)
 local dx = m.stx - m.sx
 local dy = m.sty - m.sy
 local sc = levs[glev].sz
 local delta = 2*sc/8 
 if(abs(dx) < delta) then
  dx = 0
 else
  if(dx>0) m.sx += delta
  if(dx<0) m.sx -= delta
 end
 
 if(abs(dy) < delta) then
  dy = 0
 else
  if(dy>0) m.sy += delta
  if(dy<0) m.sy -= delta
 end

 if(dx==0 and dy==0) then
  -- we've arrived
  return false
 end
 return true
end

telestate = "none"
teleframe = 1
telefrmax = 8
teledelay = 2
function anim_teleport(m)
 if(telestate == "out") then
  if(fcount%teledelay==0) then
   teleframe += 1
  end
  if(teleframe == 4) then
   m.vis = false
  elseif(teleframe>telefrmax) then
   telestate = "in"
   teleframe = 1
   m.sx = m.stx
   m.sy = m.sty  
   sfx(1,3)
  end
 elseif(telestate == "in") then
  if(fcount%teledelay==0) then
   teleframe += 1
  end
  if(teleframe == 4) then
   m.vis = true
  elseif(teleframe>telefrmax) then
   telestate = "none"
   teleframe = 1
   return false
  end
 end
 return true
end

outroc = 60
function anim_outro()
 anim_teleport(p)
 outroc -= 1
 if(outroc <= 0) return false
 return true
end

instate = "text"
introc = 60
function anim_intro()
 if(instate == "text") then
  introc -= 1
  if(introc <= 0) then
   instate = "tele"
   sfx(1,3)
  end
 elseif(instate == "tele") then
  return anim_teleport(p)
 end
 return true
end

function do_gameover()
 music(17)
 pstate = "gameover"
end

function do_win()
 music(13)
 pstate = "win"
end

-- see if robot moving to kill
-- and if so try to use shield
doomedrs = {}
function check_danger()
 local ds = {}
 doomedrs = {}
 for rob in all(rs) do
  if(rob.tx==p.tx and
     rob.ty==p.ty) then
   add(ds,rob)
  end   
 end
 if(count(ds) > 0) then
  -- at least one robot in
  -- fatal proximity
  if(shields > 0) then
   -- zap if we have any
   -- power left
   if(not didtele) then
    shields -= 1
   else
    -- shield after tele will
    -- drain more power
    shields -= 2
    if(shields<0) shields=0
   end
   do_shield_anim()
   for rob in all(ds) do
    add(doomedrs,rob)
   end
  end
 end
end

shanim = false
shframe = 1
function do_shield_anim()
 shanim = true
 shframe = 1
end

dyframe = 60
function do_dying_anim()
 pstate = "dying"
 dyframe = 60
 sfx(6,3)
end

function anim_dying()
 dyframe -= 1
 if(dyframe <= 0) then
  return false
 end
 return true
end

function _update()
 fcount += 1
 if(pstate == "title") then
  do_input_title() 
 elseif(pstate == "pregame") then
  do_input_pregame()
 elseif(pstate == "intro") then
  if(not anim_intro()) then
   pstate = "ready"
  end
 elseif(pstate == "ready") then
  local moving = do_input()
  if(moving != "none") then
   move_robots()
   if(moving == "stand" or
      moving == "tele") then
    -- shields don't work if
    -- player walked around
    check_danger()
   end
   pstate = "anim"  
  end
 elseif(pstate == "anim") then
  local a = false
  if(anim_player_move()) then
   a=true
  elseif(anim_shield()) then
   a=true
  elseif(anim_robots_move()) then
   a=true
  end
  if(not a) then
   pstate = "post"
  end
 elseif(pstate == "post") then
  collide()
  if(not p.alive) then
   do_dying_anim()
  elseif(count(rs) == 0) then
   do_outro()
  else
   pstate = "ready"
  end
 elseif(pstate == "dying") then
  if(not anim_dying()) then
   do_gameover()
  end
 elseif(pstate == "outro") then
  -- wait until outro stuff is
  -- done then set up next
  -- level
  if(not anim_outro()) then
   if(glev < count(levs)) then
    next_level()
    do_intro()
   else
    do_win()
   end
  end
 elseif(pstate == "gameover") then
  do_input_gameover()
 elseif(pstate == "win") then
  do_input_gameover()
 end
end


