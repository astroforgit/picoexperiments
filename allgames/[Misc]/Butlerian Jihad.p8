end

winanim = 0
function anim_win()
local text = {
"congratulations!",
"",
"jehanne has defeated the army", 
"of thinking machines who sought",
"to control humanity.",
"",
"",
"",
"",
"",
"",
"but the jihad has not been",
"without cost -- without",
"computers, interstellar",
"navigation has been crippled.",
"billions will starve as the",
"galaxy struggles to adapt to",
"this new dark age of freedom."
}

 local oy = -3
 winanim += 0.05
 for i=1,count(text) do
  local t = text[i]
  if(winanim > i) then
   print(t,63-(#t*2),oy+i*6,9)
