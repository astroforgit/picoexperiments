pico-8 cartridge // http://www.pico-8.com
version 5
__lua__
-- butlerian jihad
-- by josh millard

fcount = 1 -- frame counter

pstate = "logo" -- play loop
 -- game substate, for anim

glev = 1 -- game level

b = {} -- logical game board
p = {} -- player
rs = {} -- list of robots
js = {} -- list of junkpiles

numobj = 0 -- number of objects
         -- on the board so far

sz = 6 -- x/y dimension of a
       -- tile in pixels

-- tile occupant def constants
empty = 0
human = 1
robot = 2
junk  = 3

coords = {} -- shuffled each
-- board to pick unique tiles

shields = 3 -- player shields
didtele = false -- tele move?

artlevs = {} -- sz-based 
             -- sprite defs
artlevs[12]={sc=2,h=64,r=96,
 j=100,g=70,d=102,doff=4,t=72}
artlevs[8]={sc=1,h=32,r=48,
 j=50,g=35,d=51,doff=0,t=36}
artlevs[6]={sc=1,h=0,r=16,
 j=18,g=3,d=19,doff=2,t=4}
artlevs[4]={sc=1,h=8,r=24,
 j=26,g=11,d=27,doff=4,t=12}
artlevs[2]={sc=1,h=40,r=56,
 j=58,g=43,d=59,doff=6,t=44}

levs = {} -- level definitions
add(levs,{w=9,sz=12,
 name="komos",world="1-1",
 bots=3,mus=1})
add(levs,{w=9,sz=12,
 name="komos",world="1-2",
 bots=5,mus=2})
add(levs,{w=9,sz=12,
 name="komos",world="1-3",
 bots=7,mus=3})
 
add(levs,{w=14,sz=8,
 name="richese",world="2-1",
 bots=10,mus=7})
add(levs,{w=14,sz=8,
 name="richese",world="2-2",
 bots=15,mus=8})
add(levs,{w=14,sz=8,
 name="richese",world="2-3",
 bots=20,mus=9})

add(levs,{w=19,sz=6,
 name="centrans",world="3-1",
 bots=25,mus=10})
add(levs,{w=19,sz=6,
 name="centrans",world="3-2",
 bots=30,mus=11})
add(levs,{w=19,sz=6,
 name="centrans",world="3-3",
 bots=35,mus=12})

add(levs,{w=28,sz=4,
 name="carthagos",world="4-1",
 bots=30,mus=4})
add(levs,{w=28,sz=4,
 name="carthagos",world="4-2",
 bots=50,mus=5})
add(levs,{w=28,sz=4,
 name="carthagos",world="4-3",
 bots=80,mus=6})

tipnum = 1 -- random tips
tips = {
{"shield after using displacement",
"belt uses extra power"},
{"jehanne gains one shield power",
"after every level"},
{"robots move in predictable",
"ways. exploit their weakness."},
{"shield cannot function",
"while walking."},
{"carthagos is the ultimate",
"confrontation."},
{"often the wisest action",
"is inaction."},
{"displacement is a dangerous",
"gamble, if a necessary one."},
{"cluster the robots to reduce",
"their threat."},
{"a shepherd must sometimes",
"cull her flock."},
{"he who imitates the soul,",
"tarnishes the soul."},
{"do not suffer a machine-mind",
"to live."},
{"for sarah, and for",
"humanity."},
{"fear is the little-death that",
"brings total destruction."},
{"permit fear to pass over",
"and through you."},
}
 
-- stock logo stuff
logoanim=1
logostop=31
logofr=227
function logo()
 local cx = 55
 local cy = 45
 local frx=logofr%16*8
 local fry=flr(logofr/16)*8
 for s=0,logoanim do
  for x=0,15 do
   camera(rnd(30/fcount),
          rnd(30/fcount))
   for y=0,15 do
    if(x+y==s) then 
     pset(cx+x,cy+y,7)
    elseif(x+y == s-1) then
     pset(cx+x,cy+y,6)
    elseif(x+y<s-1) then
     pset(cx+x,cy+y,
      sget(frx+x,fry+y))
    end
   end
  end
 end
 if(logoanim<=logostop) logoanim+=1
 if(fcount > 35) then
  print("cortex",51,cy+20,9)
  print("carts",53,cy+26,8)
 end
 if(fcount > 65) then
  do_title()
 end
end

function new_game()
 glev = 1
 shields = 3
 shuffle(tips)
 tipnum = 0
 new_level(glev)
end

function next_level()
 glev += 1
 shields += 1
 new_level(glev)
end

function new_level(lev)
 sz = 0

 b = {} -- start fresh
 b.w = 11 -- tiles wide
 b.h = 11 -- tiles high

 sz = levs[lev].sz
 b.w = levs[lev].w
 b.h = b.w
 local numr = levs[lev].bots

 b.x = 63-(b.w*sz/2)
 b.y = 63-(b.h*sz/2)
 b.brd = {} -- actual tile list
 build_board(b.brd)

 numobj = 0
 shuffle_coords() -- once
 -- per level

 rs = {}
-- local numr = lev * 4
 create_robots(rs, numr)

 js = {}

 p = {}
 create_player()

 music(levs[lev].mus)
 fcount = 1

-- tipnum=flr(rnd(count(tips)))+1
 tipnum += 1
 do_intro()

end

-- rebuild the global coord
-- list used for level gen
function shuffle_coords()
 -- first build a list of 
 -- board coordinates
 coords = {}
 for x = 1,b.w do
  for y = 1,b.h do
   add(coords,{x,y})
  end
 end
 -- then shuffle them
 shuffle(coords)
end

-- create a list of robots
-- randomly distributed on
-- the board
function create_robots(robs,n)
 for i=1,n do
  local nx = coords[i+numobj][1]
  local ny = coords[i+numobj][2]
  local r = new_robot(nx,ny)
  add(robs,r)
  b.brd[nx][ny].occ = r
 end
 numobj += n
end

-- build and return a robot
function new_robot(tx,ty)
 local nr = {}
 nr.type = robot
 nr.tx = tx
 nr.ty = ty
 nr.sx = (tx-1)*sz
 nr.sy = (ty-1)*sz
 nr.stx = nr.sx
 nr.sty = nr.sy
 return nr
end

function create_junk(jnks,n)
 for i=1,n do
  local nx = coords[i+numobj][1]
  local ny = coords[i+numobj][2]
  local j = new_junk(nx,ny)
  add(jnks,j)
  b.brd[nx][ny].occ = j
 end
 numobj += n
end

-- build and return a junkpile
function new_junk(tx,ty)
 local nj = {}
 nj.type = junk
 nj.tx = tx
 nj.ty = ty
 return nj
end

-- build the player initially
function create_player()
 -- start fresh
 p = {}
 p.type = human
 p.alive = true
 p.vis = true -- for animation
 -- and find a non-robot pos
 place_player(p)
 b.brd[p.tx][p.ty].occ = p
 numobj += 1
 
end

-- find a level-initial spot
-- for the player to stand
function place_player(p)
 local c = coords[numobj+1]
 p.type = human
 p.tx = c[1] -- board tile pos
 p.ty = c[2]
 p.sx = (p.tx-1)*sz -- screen pos
 p.sy = (p.ty-1)*sz
 p.stx = p.sx -- target scr pos
 p.sty = p.sy
end

-- build a 2d array of tile
-- objects
function build_board(brd)
 for x = 1,b.w do
  local row = {}
  for y = 1,b.h do
   add(row, new_tile(x,y))
  end
  add(brd, row)
 end 
end

function new_tile(x,y)
 local t = {}
 t.tx = x
 t.ty = y
 t.occ = nil
 return t
end

function shuffle(a)
	local n = count(a)
	for i = 1, n do
		local k = -flr(-rnd(n))
		a[i], a[k] = a[k], a[i]
	end
	return a
end

function _init()
 pstate = "logo"
end

function do_title()
 pstate = "title"
 music(18)
end

function draw_backdrop()
 local bg = artlevs[sz].g
 local scale = artlevs[sz].sc
 for x=0,b.w-1 do
  for y=0,b.h-1 do
   spr(bg,x*sz,y*sz,
       scale,scale)
  end
 end
end

function draw_robots()
 local rf = artlevs[sz].r
 local scale = artlevs[sz].sc
 rf += (flr(fcount/16)%2)*scale
 for rob in all(rs) do
  spr(rf,rob.sx,rob.sy,scale,scale)
 end
end

function draw_junk()
 local jf = artlevs[sz].j
 local scale = artlevs[sz].sc 
 for junk in all(js) do
  spr(jf,(junk.tx-1)*sz,
         (junk.ty-1)*sz,
         scale,scale)
 end
end

function draw_player()
 local pf = artlevs[sz].h
 local tf = artlevs[sz].t
 local scale = artlevs[sz].sc
 if(p.alive) then
  pf+=(flr(fcount/16)%2)*scale
  if(p.vis) then
   spr(pf,p.sx,p.sy,scale,scale)
  end
  if(telestate != "none") then
   -- teleportin'
   local tfmod = teleframe - 1
   tf += (tfmod%4)*scale + flr(tfmod/4)*16*scale
   if(telestate == "out") then
    -- do a palette swap
    pal(12,9)
   end
   spr(tf,p.sx,p.sy,
       scale,scale)
   pal()
  else
   -- non-tele animation
   spr(pf,p.sx,p.sy,scale,scale)
  end
 else
  pf += 2 * scale
  spr(pf,p.sx,p.sy,scale,scale)
 end
end        

function draw_destination()
 -- animation
 local fr = artlevs[sz].d
 local mod = flr(fcount/4)%4
 local fliph = false
 local flipv = false 
 if(mod==1 or mod==2) flipv=true
 if(mod==2 or mod==3) fliph=true
 local scale = artlevs[sz].sc

 local d = get_dir()
 local nx = p.tx + d.dx
 local ny = p.ty + d.dy
 -- check for inbounds dest
 if(nx>b.w or nx<=0 or
    ny>b.h or ny<=0) then
  -- pal is fine
 elseif(b.brd[nx][ny].occ != nil) then
  -- pal is fine
 else
  pal(8,11)
 end
  
 local rx = (p.tx+d.dx-1)*sz
 local ry = (p.ty+d.dy-1)*sz
 if(fliph) rx -= artlevs[sz].doff
 if(flipv) ry -= artlevs[sz].doff
 spr(fr,rx,ry,
     scale,scale,fliph,flipv)
 pal()
end

function draw_shield()
 if(shanim) then
  for i=shframe,1,-1 do
   local c=rnd(3)+8
   circfill(p.sx+sz/2,
        p.sy+sz/2,
        i*1.5,c)
  end
 end
end

function draw_ui()
 print(levs[glev].name.." "..levs[glev].world,
  0,0,7)
 print("shields: "..shields,
  60,0,7)
end

tanim = 0
function anim_title()  
 camera(0,-10)
 local pals = {1,5,13,9,4,8}
 tanim += 1/30
 for i=6,tanim,-1 do
  pal(pals[i],0)
 end
 
 spr(128,19,30,12,2)
 spr(197,19,46,11,4)
 pal()
 
 print(
"thou shalt not make a machine",
6,0,8)
 print(
"in the likeness of a human mind.",
0,6,8)
 print("-- orange catholic bible",
20,12,7) 
 
 if(tanim > 7) then
  print("(z to start)",
   40,90,7)
 end
 camera()
end

pranim = 0
function anim_preamble()
local text= {
"it is the year 199 b.g.",
"",
"jehanne butler has discovered",
"treacherous intentions from",
"computerized administrators",
"on komos.",
"",
"armed only with a holtzman",
"shield/displacement belt, she",
"must destroy the robotic",
"menace that seeks to enslave",
"its human creators.",
"",
"",
"z: shield if threatened",
"z + arrows: move",
"x: displace",
}
 local oy = 0
 pranim += 0.05
 for i=1,count(text) do
  local t = text[i]
