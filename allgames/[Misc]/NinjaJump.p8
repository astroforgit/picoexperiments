pico-8 cartridge // http://www.pico-8.com
version 16
__lua__

gravity = 0.25
time = 0
player1 = {}
player2 = {}


game = {}


p2_is_ai = true
ai_pressed_time = 0
ai_wait_time = 0

spd = 2


function init_player(pl)
	if pl.i == 0 then
		pl.x = 16
		pl.right = false

	end
	if pl.i == 1 then
		pl.x = 104
		pl.right = true
	end
	pl.y = 32+flr(rnd(64))
	pl.frame = 16
	pl.step = 1
	pl.flying = false
	pl.vx = 0
	pl.vy = 0
	pl.wp = 0
	pl.wpn = 0
	pl.climbing = true
	pl.pressed = false
	pl.pressed_time = 0
	pl.dead = false
	pl.catched = false
	pl.catching = false
	pl.flip_y = false
end

function init_game()
	game.time = 0
	game.menu = 0
	game.title_ttl = 300
	player1.i = 0
	player1.time = 0
	player1.life = 5

	player2.i = 1
	player2.time = 0
	player2.life = 5

	init_player(player1)
	init_player(player2)

	game.start = false

end

function update_game()

	if game.start then
		game.time += 1
		if game.time > 300 then
			if game.time%600 == 0 then
				if rnd()>0.5 then
					add_item(rnd(32)+48,rnd(72)+8,1)
				else
					add_item(rnd(32)+48,rnd(72)+8,3)
				end
			end
		end
		if btn(4,0) then
			player_pressed(player1)
		else
			player_released(player1)	
		end

		if p2_is_ai then
			p2_ai()
		else
			if btn(2,0) then
				player_pressed(player2)
			else
				player_released(player2)	
			end
		end
	else
		if btnp(0,0) or btnp(1,0) or btnp(2,0) or btnp(3,0) then
			sfx(0)
			game.menu += 1
			if game.menu >= 2 then
				game.menu = 0
			end
		end
		if btn(4,0) then

			start_game()

		end
	end
end

function start_game()
	if game.menu == 0 then
		p2_is_ai = true
	else
		p2_is_ai = false
	end
	game.start = true
	player1.life = 5
	player2.life = 5
	game.time = 0
end

function draw_player(pl)
	if pl.climbing then
		if pl.step == 1 then
			if (flr((pl.time/6) % 2) == 0) then
				pl.frame = 16
			else
				pl.frame = 32
			end
		else
			pl.frame = 16+pl.step-1
		end
	end
	if pl.i == 1 then
		pal(8,12)
		pal(2,3)
	end
	spr(pl.frame,pl.x,pl.y,1,1,pl.right,pl.flip_y)
	pal()
end

function draw_info()
	for i=1,player1.life do
		spr(1,0,i*8+16)
	end
	pal(8,12)
	for i=1,player2.life do
		spr(1,119,i*8+16)
	end
	pal()

	local t = flr(game.time/10%5)

	if player1.wp == 1 then
		spr(34+t,0,8)
	end
	if player1.wp == 2 then
		spr(68+t,0,8)
	end
	if player1.wp == 3 then
		spr(50+t,0,8)
	end

	if player2.wp == 1 then
		spr(34+t,119,8)
	end
	if player2.wp == 2 then
		spr(68+t,119,8)
	end
	if player2.wp == 3 then
		spr(50+t,119,8)
	end
end

function _init()
	logs = {}
	gravity = gravity / spd
	init_game()

end

function _update60()
	time += 1
	update_game()
	player1.time = player1.time+1/spd
	player2.time = player2.time+1/spd
		
	player_update(player1)
	player_update(player2)

	foreach(smokes,update_smoke)
	foreach(sparks,update_spark)

end

function _update()
   _update60()
   _update60()
end


function _draw()
	cls(0)
	
	map(0,0,0,0,128,128)
	

	draw_info()
	draw_darts()
	draw_lava()

	draw_player(player1)
	draw_player(player2)

	foreach(smokes,draw_smoke)
	foreach(sparks,draw_spark)
	foreach(items,draw_item)

	if game.start == false then
		draw_title()
	end


	-- print(logs[0],2,20,7)
end

function draw_title()
	local t = flr(time/20%2)
	spr(128,25,16,10,2)
	print("hold",25,64,7)
	spr(66+t,46,61)
	print("(Z) to jump",55,64,7)

	print("2p",25,74,7)
	spr(80+t,46,71)
	print("to jump",55,74,7)

	if t == 0 then
		if game.menu == 0 then
			spr(82,20,90)
		else
			spr(82,82,90)
		end
	end
	print("computer",28,90,7)
	print("2p",90,90,7)
end

-- lava
--------------------------------------
function draw_lava()
	add_sparks(1,24+rnd(80),119)
	for x=2,13 do
		mset(x,15,6+flr((game.time/10+x)%3))		
	end
end
--------------------------------------

-- helper
--------------------------------------
function climb_point(pl)
	local p = {}
	if(pl.right) then
		p.x = pl.x + 8
		p.y = pl.y + 4
	else
		p.x = pl.x
		p.y = pl.y + 4
	end
	return p
end
function chk_collide(x1,y1,x2,y2,n)
	if abs(x1-x2) < n and abs(y1-y2) < n then
		return true
	else
		return false
	end
end
--------------------------------------
-- item
--------------------------------------
items = {}
function add_item(x,y,type)
	local i = {}
	i.x = x
	i.y = y
	i.type = type
	i.ttl = 300
	i.t = 0
	i.dt = 1/spd
	add(items,i)
	return i
end

function draw_item(i)
	if i.ttl <= 0 then
		del(items,i)
		return
	end
	i.t += 1
	i.ttl -= i.dt
	local t = flr(i.t/10%5)
	if i.type == 1 then
		spr(34+t,i.x,i.y)
	end
	if i.type == 2 then
		spr(68+t,i.x,i.y)
	end
	if i.type == 3 then
		spr(50+t,i.x,i.y)
	end
end
--------------------------------------

-- smoke
--------------------------------------
smokes = {}

function add_smoke(x,y)
	local s = {}
	s.x = x
	s.y = y
	s.vx = 0
	s.vy = -1
	s.ttl = 20
	s.dt = 1/spd
	s.col = 6
	add(smokes,s)
	return s
end

function draw_smoke(s)
	circfill(s.x, s.y, s.ttl * 0.2, s.col)
end

function update_smoke(s)
	if s.ttl <= 0 then
		del(smokes,s)
		return
	end
	s.x += s.vx/spd
	s.y += s.vy/spd
	s.ttl -= s.dt
end


function player_pressed(pl)
	pl.pressed = true

	if pl.wp == 1 and pl.flying and pl.dead == false then
		throw_darts(pl)
	end

	if pl.pressed_time < 60 then
		pl.pressed_time += 1/spd
	end

	if pl.step < 4 then
		pl.step = flr((pl.pressed_time/15) % 4 ) + 1

		if pl.i == 0 then
			sfx(0,1,pl.step-1,1)
		end

		if pl.i == 1 then
			sfx(1,2,pl.step-1,1)
		end
	end
end

function player_released(pl)
	if pl.pressed == true then
		pl.climbing = false
		pl.pressed = false

		if pl.i == 0 then
			sfx(-1,1)
		end

		if pl.i == 1 then
			sfx(-1,2)
		end

		if pl.flying == false then
			player_jump(pl)
		end
	end
end

function player_update(pl)
	if pl.climbing then
		if game.time > 1800 and game.start then
			pl.vy = 0.05
		else
			pl.vy = 0
		end
		if pl.vy > 0 then
			if rnd(1) > 0.8 then
				local p = climb_point(pl)
				local s = add_smoke(p.x+rnd(2),p.y+rnd(4))
				s.ttl = 10
				s.dt = 0.5
				s.col = rnd(1)>0.8 and 6 or 7
				-- s.vy = 
			end
		end
	end

	player_checkdeath(pl)

	if pl.flying then
		player_checkwall(pl)
		player_checkitem(pl)
		player_checkcatched()

		if pl.y + pl.vy <= 0 then
			pl.vy = 0
		end
	end
	
	player_checkrespawn(pl)

	pl.x = pl.x +pl.vx
	pl.y = pl.y +pl.vy
	pl.vy = pl.vy + gravity

end

function player_checkwall(pl)
	if pl.dead == false then
		if pl.right then
			if fget(mget(flr((pl.x + pl.vx)/8),flr((pl.y + pl.vy)/8)),0) then
				player_hitwall(pl)
			end
		else
			if fget(mget(flr((pl.x + pl.vx + 8)/8),flr((pl.y + pl.vy + 8)/8)),0) then
				player_hitwall(pl)
			end
		end
	end
end

function player_hitwall(pl)
	pl.vx = 0
	pl.vy = 0
	pl.climbing = true
	pl.flying = false
	if pl.x > 64 then
		pl.right = true
		pl.x = 104
	else
		pl.right = false
		pl.x = 16
	end
	pl.step = 1
end

function player_checkdeath(pl)
	if pl.dead == false then

		for dart in all(darts) do
			if dart.pi ~= pl.i then
				if abs(pl.x - dart.x) < 7 and abs(pl.y - dart.y) < 7 then
					if pl.i == 0 then
						player_catched(pl,player2)
					else
						player_catched(pl,player1)
					end
				end
			end
		end

		if pl.right then
			if fget(mget(flr((pl.x + pl.vx)/8),flr((pl.y + pl.vy)/8)),2) then
				player_touch_lava_dead(pl)
			end
		else
			if fget(mget(flr((pl.x + pl.vx + 8)/8),flr((pl.y + pl.vy + 8)/8)),2) then
				player_touch_lava_dead(pl)
			end
		end
	end
end

function player_checkcatched()

	if player1.catched == false and player2.catched == false and (player1.flying or player2.flying) and player1.dead == false and player2.dead == false then

		-- local p1nx = player_next_x(player1)
		-- local p1ny = player_next_y(player1)
		-- local p2nx = player_next_x(player2)
		-- local p2ny = player_next_y(player2)

		local p1nx = player1.x
		local p1ny = player1.y
		local p2nx = player2.x
		local p2ny = player2.y

		if abs(p1nx - p2nx) < 8 and abs(p1ny - p2ny) < 8 then

			if player1.flying and player2.flying == false and player1.right ~= player2.right then
				player_catched(player2,player1)
			elseif player2.flying and player1.flying == false and player1.right ~= player2.right then
				player_catched(player1,player2)
			elseif player1.flying == player2.flying then
				if p1ny < p2ny then
					player_catched(player2,player1)
					player1.vy = -3
				else
					player_catched(player1,player2)
					player2.vy = -3
				end
			end

		end
	end

end

function player_checkitem(pl)
	if pl.catched == false and player1.dead == false then
		foreach(items,function(i)
			if chk_collide(pl.x,pl.y,i.x,i.y,8) then
				pl.vy = -3
				if i.type == 3 then
					s = add_smoke(i.x+4,i.y)
					s.col = 8
					s.ttl = 10
					s.vy = 0
					if pl.life < 10 then
						pl.life += 1
					end
				else
					pl.wp = i.type
					pl.wpn = 3

					s = add_smoke(i.x+4,i.y)
					s.col = 12
					s.ttl = 10
					s.vy = 0
				end
				del(items,i)
			end
		end)
	end
end

function player_catched(pl,other)
	pl.catched = true
	pl.climbing = false
	other.catching = true
	pl.vx = 0
	pl.vy = 0
	pl.flying = true
	pl.frame = 33
	pl.flip_y = true
	-- pl.x = other.x
	-- pl.y = other.y
end

function player_next_x(pl)
	if pl.right then
		return pl.x + pl.vx

	else
		return pl.x + pl.vx + 8
	end
end

function player_next_y(pl)
	if pl.right then
		return pl.y + pl.vy
	else
		return pl.y + pl.vy + 8
	end
end

function player_jump(pl)
	pl.flying = true
	local mul = pl.pressed_time / 60
	pl.pressed_time = 0
	if pl.right then
		-- pl.vx = -(2*mul +3)
		pl.vx = -5/spd
	else
		-- pl.vx = (2*mul +3)
		pl.vx = 5/spd
	end
	pl.vy = -(9*mul -2)/spd

end


function player_touch_lava_dead(pl)
	pl.vx = 0
	pl.vy = -2
	pl.frame = 33
	pl.dead = true
	pl.climbing = false
	pl.flip_y = false
	pl.life -= 1

	for i=0,5 do
		s = add_smoke(pl.x+rnd(8),pl.y)
		s.vy = -0.3-rnd(0.3)
		s.ttl = 10+rnd(10)
		s.col = 8+flr(rnd(3))
	end

	sfx(2,3)

	if pl.life <= 0 then
		game.start = false
	end

end

function player_checkrespawn(pl)
	if pl.y > 160 or pl.x < -8 or pl.x > 128 or pl.y < -16 then
		init_player(pl)
	end
end



function p2_ai()
	if player2.pressed == false and player2.climbing then
		if ai_wait_time <= 0 then

			local dy = player2.y - player1.y

			if #items > 0 then
				dy = player2.y - items[1].y
			end

			if dy < 0 then
				dy += 25
			end

			ai_pressed_time = max(min(40+dy,60),10)

			-- if player2.y > 50 or player1.y > player2.y then
			-- 	ai_pressed_time = flr(rnd(11))+50
			-- else
			-- 	ai_pressed_time = flr(rnd(61))
			-- end
			player_pressed(player2)
			-- ai_wait_time = flr(rnd(61))
			ai_wait_time = flr(rnd(31))
		else
			ai_wait_time -= 1/spd
		end
	else
		ai_pressed_time -= 1/spd
		if ai_pressed_time > 0 then
			player_pressed(player2)
		else
			player_released(player2)
		end
	end

	if player2.flying == true and player2.climbing == false and player2.dead == false then
		if player2.wp == 1 then
			if abs(player1.y - player2.y) < 8 and abs(player1.x - player2.x) > 24 and player1.right ~= player2.right then
				throw_darts(player2)
			end
		end
	end

end

-- lava
--------------------------------------
sparks={}

function add_sparks(nb,nx,ny)
 while (nb>0) do
  s={}
  s.x=nx
  s.y=ny
  s.vx=(rnd(1)-0.5)/3/spd
  s.vy=(rnd(1)-1)/3/spd
  s.col=9
  s.f=0
  s.maxf=(rnd(16)+16)*spd
  add(sparks,s)
  nb-=1
 end
 
end

function update_spark(s)
  s.x+=s.vx
  s.y+=s.vy
  s.f+=1
end

function draw_spark(s)
  if(s.f>rnd(12)+6) s.col=8
  if(s.f>rnd(16)+8) s.col=2
  pset(s.x,s.y,s.col)
  if (s.f>s.maxf) then
   del(sparks,s)
  end
end
--------------------------------------

darts = {}

function throw_darts(pl)
	if pl.last_dart == nil or pl.time - pl.last_dart > 30 then
		pl.last_dart = pl.time
		dart = {}
		dart.x = pl.x
		dart.y = pl.y
		dart.pi = pl.i
		if pl.right then
			dart.vx = -8/spd
		else
			dart.vx = 8/spd
		end
		dart.f = 0
		add(darts,dart)
		pl.wpn -= 1
		if pl.wpn <= 0 then
			pl.wp = 0
		end
	end
end

function draw_darts()
	for dart in all(darts) do
		dart.x += dart.vx
		dart.f += 1
		if flr(dart.f/4%2) == 0 then
			dart.flipx = false
		else
			dart.flipx = true
		end
		spr(48,dart.x,dart.y,1,1,dart.flipx)
		if dart.x>128 or dart.x < -8 then
		   del(darts,dart)
		end
	end
end
