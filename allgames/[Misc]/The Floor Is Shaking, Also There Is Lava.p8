pico-8 cartridge // http://www.pico-8.com
version 11
__lua__
--the ground is shaking
--a 0h game by trasevol_dog
--also there is lava

function _init()
 px=68
 py=68
 
 pvx,pvy=0,0
 
 shkx,shky=0,0
 
 faceleft=false

 score=0

 gen_map()
 
 lost=false
 
 t=0
end

function _update()
 if lost then
  if btnp(4) then 
   _init()
  end
 
  return
 end

 t+=0.01
 
 if rnd(20)<score then
  sfx(3+rnd(3))
 end
 
 update_shake()
 
 add_shake(score*0.2)
 
 local v=score*0.5
 px+=rnd(v)-v/2
 
 local acc=0.6
 if btn(0) then pvx-=acc end
 if btn(1) then pvx+=acc end
 if btn(2) then pvy-=acc end
 if btn(3) then pvy+=acc end
 
 px+=pvx
 py+=pvy
 
 if abs(pvx)>0 then
  faceleft=pvx<0
 end
 
 pvx*=0.5
 pvy*=0.5
 
 local ti=mget(px/8,(py+4)/8)
 if ti==16 then
  -- yo lost
  lost=true
  sfx(2)
 elseif ti==24 then
  -- yo won
  cls(7)
  flip()
  flip()
  
  score+=1
  gen_map()
  
  add_shake(8)
 end
 
 
end

function _draw()
 if lost then
  for i=0,399 do
   circ(rnd(128),rnd(128),1,rnd(1.1))
   
   str="!! you lost !!"
   print(str,64-#str*2,48,7)
   str="press Ž/z to try again"
   print(str,64-#str*2,74,7)
  end
   
  return
 end


 local dt=(t/0.03)%8
 for x=0,16 do
 for y=0,16 do
  spr(16,x*8-dt,y*8-dt/3)
 end
 end

 camera(shkx+1,shky+1)

 for x=0,15 do
 for y=0,15 do
  local s=mget(x,y)
  if s~=16 then
   spr(s,x*8,y*8)
  end
 end
 end
 
 local step=(t/0.04)%4
 if flr(step)==0 and flr(((t-0.01)/0.04)%4)~=0 then
  sfx(1)
 end
 
 pal(7,0)
 spr(32+(t/0.04)%4,px-4-1,py-4,1,1,faceleft,false)
 spr(32+(t/0.04)%4,px-4+1,py-4,1,1,faceleft,false)
 spr(32+(t/0.04)%4,px-4,py-4-1,1,1,faceleft,false)
 spr(32+(t/0.04)%4,px-4,py-4+1,1,1,faceleft,false)
 pal(7,7)
 spr(32+(t/0.04)%4,px-4,py-4,1,1,faceleft,false)

 camera(0,0)
 
 local str="score: "..score
 print(str,64-#str*2-1,2,0)
 print(str,64-#str*2-1,3,0)
 print(str,64-#str*2-1,4,0)
 print(str,64-#str*2+1,2,0)
 print(str,64-#str*2+1,3,0)
 print(str,64-#str*2+1,4,0)
 print(str,64-#str*2,2-1,0)
 print(str,64-#str*2,2+1,0)
 print(str,64-#str*2,2+2,0)
 print(str,64-#str*2,2+3,0)
 print(str,64-#str*2,2,7)
end


function add_shake(p)
 local a=rnd(1)
 shkx+=p*cos(a)
 shky+=p*sin(a)
end

function update_shake()
 if abs(shkx)+abs(shky)<0.5 then
  shkx,shky=0,0
 end
 
 shkx*=-0.5-rnd(0.2)
 shky*=-0.5-rnd(0.2)
end


function gen_map()
 local mpx=flr(px/8)
 local mpy=flr(py/8)

 rectfill(0,0,15,15,8)
 
 pset(mpx,mpy,0)
 
 for i=0,99 do
  local x,y
  repeat
   x,y=rnd(16),rnd(16)
  until pget(x,y)==0
  
  local dx,dy
  if rnd(2)<1 then
   dx=0--rnd(1.4)-0.2
   dy=rnd(9)-4
  else
   dy=0--rnd(1.4)-0.2
   dx=rnd(9)-4
  end
  rectfill(x,y,x+flr(dx),y+flr(dy))
 end
 
 rectfill(16,0,16,16,8)
 rectfill(0,16,16,16,8)
 
 for x=0,15 do
 for y=0,15 do
  if pget(x,y)==8 then
   mset(x,y,16)
  else
   local k=0
   if pget(x-1,y)==0 and x>=1 then k+=1 end
   if pget(x+1,y)==0 then k+=2 end
   if pget(x,y-1)==0 and y>=1 then k+=4 end
   if pget(x,y+1)==0 then k+=8 end
   
   mset(x,y,k)
  end
 end
 end
 
 local x,y
 repeat
  x,y=rnd(16),rnd(16)
 until pget(x,y)==0 and (flr(x)~=mpx or flr(y)~=mpy)
 mset(x,y,24)
end
