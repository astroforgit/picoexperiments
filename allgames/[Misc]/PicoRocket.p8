pico-8 cartridge // http://www.pico-8.com
version 1
__lua__
--picorocket by arki
--burn enemies with your thrust!

width = 127
height = 127
score = 0
timer = 0
level = 0
enemies_killed = 0
enemies_spawned = 0
aitimer = 0
highscore = 0

camera = {}
camera.truespeed = 0.2
camera.speed = camera.truespeed
ship = {}
ship.truespeed = 2
ship.speed = ship.truespeed
ship.xdisplace = 0
ship.ydisplace = 64
	ship.x = 63+(ship.xdisplace)
	ship.y = 63+(ship.ydisplace)
ship.facing = 0
ship.thrust = 0

starcount = flr((width+height)/2)
sdh = 0
stars = {}
enemies = {}
bullets = {}
particles = {}


function _init()
	enemies_spawntime = rnd(100)
	cls()
	gamestate = 0
	
	for i=1,starcount do
		makestar()
	end
	ship.xv=0
	ship.yv=2
end
function cleanships(enemy) del(enemies,enemy) end
function cleanparts(part) del(particles,part) end
function restart()
	if score > highscore then highscore = score end
	ship.facing = 0
	ship.yv=0
	ship.xv=0
	score = 0
	timer = 0
	level = 0
	enemies_killed = 0
	aitimer = 0
	foreach(enemies,cleanships)
	foreach(particles,cleanparts)
	gamestate = 0
end

function _update()
	if (gamestate == 0) then
		if btn()!= 0 then titlecontrol = true end
		if ship.yv <= 5 and not titlecontrol then ship.yv+=0.2 end
		if (btn(4)) then gamestate = 1 titlecontrol = false end
	end
	if (gamestate == 1) then
		if (timer<60) then
			ship.xv-=(ship.xv/20)
			ship.yv-=(ship.yv/20)
			timer+=1
			score+=(0.25*level)
		else
			timer=0
			ship.xv=(ship.xv/2)
			ship.yv=(ship.yv/2)
			nextlevel()
		end
	end
	if aitimer < 1 then aitimer += 0.02 end
	updateplayer()
	foreach(stars,updatestar)
	foreach(enemies,updateenemy)
	foreach(particles,updateparticle)
	foreach(bullets,updatebullet)	
	if (gamestate >= 0) then

	end
	if (gamestate >= 2) then
		if enemies_killed >= level then endlevel() end
		if enemies_spawned < level then
			if enemies_spawntime < timer then
				makeenemy() enemies_spawntime = rnd(100)
			else
				timer += 1
			end
		end
	end
	
	if (gamestate==-1) then
		if (timer<90) then
			ship.xv-=(ship.xv*0.05)
			ship.yv-=(ship.yv*0.05)
			timer+=1
			if timer==90 then ship.ydisplace = 64 end
		else
			ship.ydisplace = 64
			restart()
		end
	end
end

function _draw()
	cls()
	foreach(stars,drawstar)
	foreach(enemies,drawenemy)
	foreach(particles,drawparticle)
	if (gamestate >= 0) then
		drawplayer()
	end
	if (gamestate == 0) then
		makeparticle(15+rnd(97),18+rnd(20),-ship.xv,-ship.yv,4)
		spr(64,10,20,14,3)
		coolprint("press [z] to start!",27,90)
		coolprint("high score:",3,3)
		coolprint(flr(highscore),47,3)
	else
		coolprint(flr(score),3,3)
	end
	if (gamestate == 1) then
		coolprint("level advance!",37,30)
		coolprint("enemies approaching:",26,90)
		coolprint(level+1,62,97)
		if ((0.25*level)>0) then coolprint(flr(timer*(0.25*level)),3,9) end
	end
	if (gamestate == -1) then coolprint("game over",46,30) end
	rect(1,1,width,height,2)
	rect(0,0,width-1,height-1,9)
	pset(0,height,2)
	pset(width,0,2)
end

function endlevel()
	timer=0
	gamestate=1
	enemies_killed=0
	enemies_spawned = 0
end

function nextlevel()
	gamestate=2
	level+=1
	for i=1,max(level/2,1) do
		makeenemy()
	end
	aitimer = 0.1
end
function coolprint(a,x,y)
	print(a,x+1,y+1,2)
	print(a,x,y,9)
end

function shipfart(xe,ye,xvd,yvd)
	local xvd = xvd
	local yvd = yvd
	local xe = xe
	local ye = ye
	makeparticle(ship.x+xe,ship.y+ye,(-ship.xv)+xvd+(rnd(1)-.5),(-ship.yv)+yvd+(rnd(1)-.5),0)
end

function mov(a)
	if btn()==a or btn()==a+16 then return true
	end
end

function sgo(x,y)
	ship.xv+=(camera.speed*-x)
	ship.xdisplace+=(ship.speed*x)
	ship.yv+=(camera.speed*-y)
	ship.ydisplace+=(ship.speed*y)
end
function updateplayer()
	if (ship.facing == 1 or ship.facing == 3 or ship.facing == 5 or ship.facing == 7) then
		ship.speed = ship.truespeed/1.414
		camera.speed = camera.truespeed/1.414
	else
		ship.speed = ship.truespeed
		camera.speed = camera.truespeed
	end
	ship.thrust = 0
	if abs(gamestate) != 1 then
		if mov(1) or mov(13) then
			ship.facing = 6
			sgo(-1,0)
			shipfart(2,0,1,0)
			shipfart(2,1,1,0)
			ship.thrust = 1
		end
		if mov(2) or mov(14) then
			ship.facing = 2
			sgo(1,0)
			shipfart(-1,0,-1,0)
			shipfart(-1,1,-1,0)
			ship.thrust = 1
		end
		if mov(4) or mov(7) then
			ship.facing = 0
			sgo(0,-1)
			shipfart(0,2,0,1)
			shipfart(1,2,0,1)
			ship.thrust = 1
		end
		if mov(5) then
			ship.facing = 7
			sgo(-1,-1)
			shipfart(2,1,0.707,0.707)
			shipfart(1,2,0.707,0.707)
			ship.thrust = 1
		end
		if mov(6) then
			ship.facing = 1
			sgo(1,-1)
			shipfart(-1,1,-0.707,0.707)
			shipfart(0,2,-0.707,0.707)
			ship.thrust = 1
		end
		
		if mov(8) or mov(11) then
			ship.facing = 4
			sgo(0,1)
			shipfart(0,-1,0,-1)
			shipfart(1,-1,0,-1)
			ship.thrust = 1
		end
		if mov(9) then
			ship.facing = 5
			sgo(-1,1)
			shipfart(1,-1,0.707,-0.707)
			shipfart(2,0,0.707,-0.707)
			ship.thrust = 1
		end
		if mov(10) then
			ship.facing = 3
			sgo(1,1)
			shipfart(-1,0,-0.707,-0.707)
			shipfart(0,-1,-0.707,-0.707)
			ship.thrust = 1
		end
	end
	ship.x = 63+(ship.xdisplace)
	ship.y = 63+(ship.ydisplace)
	if (ship.xdisplace < 0) then ship.xdisplace+=ship.xdisplace/-10 end
	if (ship.xdisplace > 0) then ship.xdisplace-=ship.xdisplace/10 end
	if (abs(ship.xdisplace) < .5) then ship.xdisplace = 0.5 end -- extremely hacky
	if (ship.ydisplace < 0) then ship.ydisplace+=ship.ydisplace/-10 end
	if (ship.ydisplace > 0) then ship.ydisplace-=ship.ydisplace/10 end
	if (abs(ship.ydisplace) < .5) then ship.ydisplace = 0.5 end

end

function drawplayer()
	if ship.thrust == 1 then
		if (ship.facing == 0) then
			rect(ship.x,ship.y,ship.x+1,ship.y+3,7)
		elseif (ship.facing == 1) then
			pset(ship.x-1,ship.y+2,7)
		elseif (ship.facing == 2) then
			rect(ship.x-1,ship.y,ship.x-2,ship.y+1,7)
		elseif (ship.facing == 3) then
			pset(ship.x-1,ship.y-1,7)
		elseif (ship.facing == 4) then
			rect(ship.x,ship.y,ship.x+1,ship.y-2,7)
		elseif (ship.facing == 5) then
			pset(ship.x+2,ship.y-1,7)
		elseif (ship.facing == 6) then
			rect(ship.x,ship.y,ship.x+3,ship.y+1,7)
		elseif (ship.facing == 7) then
			pset(ship.x+2,ship.y+2,7)
		end
	end
	spr(ship.facing,ship.x-3,ship.y-3)
end


function playerdeath()
	timer=0
	gamestate = -1
	explode(ship.x,ship.y,-ship.xv*0.5,-ship.yv*0.5)
end

function makeparticle(x,y,xv,yv,kind)
	local part = {}
	part.x = x
	part.y = y
	part.xv = xv
	part.yv = yv
	part.kind = kind
	part.life = 0
	if part.kind == 0 then part.c = 7 end
	if part.kind == 1 or part.kind == 3 then part.c = 7 part.life = 5 end
	if part.kind == 2 then part.c = 10 end
	if part.kind == 4 then part.c = 1 end
	add(particles, part)
	return part
end

function updateparticle(part)
	uppos(part)
	if part.kind != 4 then wrapcheck(part) end
	if part.kind != 1 then
		part.life += 1
		part.xv = part.xv/max(part.life/12,1)
		part.yv = part.yv/max(part.life/12,1)
	end

	if (part.kind == 0) then
		if part.life > 3 then part.c = 12 end
		if part.life > 10 then part.c = 13 end
		if part.life > 20 then part.c = 1 end
		if part.life == 25 then del(particles,part) end
	end
	
	if (part.kind == 1 or part.kind == 3) then
		part.life += (0.5+rnd(0.5))
		if part.life > 15+rnd(10) then part.c = 12 end
		if part.life >= 20 then part.c = 1 end
		if part.life >= 21+rnd(7) then del(particles,part) end
	end

	
	if (part.kind == 2) then
		if part.life > 2 then part.c = 9 end
		if part.life > 5 then part.c = 8 end
		if part.life > 15 then part.c = 2 end
		if part.life == 25 then del(particles,part) end
	end
	if part.kind == 4 and part.life == 30 then del(particles,part) end
end

function drawparticle(part)
	if part.kind == 1 then
		circfill(part.x,part.y,part.life,part.c)
	elseif part.kind == 3 then line(part.x,part.y,part.x+part.xv,part.y+part.yv,part.c)
	elseif part.kind == 4 then circfill(part.x,part.y,12.5-(abs(part.life-12.5)),part.c) pset(part.x,part.y,part.c)
	else
		pset(part.x,part.y,part.c)
	end
end

function makeenemy()
	local enemy = {}
	if rnd(1) >= 0.5 then -- messy
		enemy.x = rnd(width)
		enemy.y = -rnd(20)
	else
		enemy.x = -rnd(20)
		enemy.y = rnd(height)
	end
	enemy.xv = -ship.xv+(rnd(2)-1)
	enemy.yv = -ship.yv+(rnd(2)-1)
	enemy.spr = 0
	enemy.speed = (rnd(0.8)+0.7)
	add(enemies,enemy)
	enemies_spawned += 1
end

function checkcolour(enemy)
	for xi=-1,2 do
		for yi=-1,2 do
			if (pget(enemy.x+xi,enemy.y+yi) == 7) then
				return true
			end
		end
	end
end
function collide(enemy)
	if abs(enemy.x-ship.x) <= 2 then
		if abs(enemy.y-ship.y) <= 2 then
			return true
		end
	end
end

function updateenemy(enemy) -- i apologise in advance for the next line. i'm so sorry. please forgive me.
	makeparticle(enemy.x+flr(rnd(2))-(sgn(ship.x-enemy.x)*1),enemy.y+flr(rnd(2))-(sgn(ship.y-enemy.y)*1),(rnd(1)-.5)+enemy.xv-(sgn(ship.x-enemy.x)*((enemy.speed+0.5)*0.5)),(rnd(1)-.5)+enemy.yv-(sgn(ship.y-enemy.y)*((enemy.speed+0.5)*0.5)),2)
	if checkcolour(enemy) then
		explode(enemy.x,enemy.y,enemy.xv/2,enemy.yv/2)
		del(enemies,enemy)
		enemies_killed+=1
		if gamestate != -1 then	score += 50.9134 end
	end
	uppos(enemy)
	wrapcheck(enemy)
	
	enemy.xv += ((ship.x-enemy.x)/750)*min(enemy.speed,1.1)
	enemy.yv += ((ship.y-enemy.y)/750)*min(enemy.speed,1.1)
	
	enemy.xv += ((sgn(ship.x-enemy.x)*0.1)*enemy.speed)*aitimer
	enemy.yv += ((sgn(ship.y-enemy.y)*0.1)*enemy.speed)*aitimer
	
	enemy.spr=((sgn(ship.x-enemy.x))+(sgn(ship.y-enemy.y)*2))+35
	
	enemy.xv += (-ship.xv-enemy.xv)/100
	enemy.yv += (-ship.yv-enemy.yv)/100
	
	if gamestate==2 and collide(enemy) then playerdeath() end
end

function drawenemy(enemy)
	spr(enemy.spr,enemy.x-3,enemy.y-3)
end

function explode(x,y,xv,yv)
	makeparticle(x,y,xv,yv,1)
	sfx(0,1)
	for i=1,20 do
		makeparticle(x,y,xv+(rnd(10)-5),yv+(rnd(10)-5),3)
	end
	for i=1,flr(rnd(3)+2) do
		makeparticle(x+rnd(30)-15,y+rnd(30)-15,xv,yv,1)
	end
end

function makestar()
	local star = {}
	star.x = flr(rnd(width+20))
	star.y = flr(rnd(height+20))
	star.c = flr(rnd(7)+1)
	local sc = starcount/8
	if (sdh < sc) then star.d=9 --hack to get the order right
	elseif (sdh < sc*2) then star.d=8
	elseif (sdh < sc*3) then star.d=7
	elseif (sdh < sc*4) then star.d=6
	elseif (sdh < sc*5) then star.d=5
	elseif (sdh < sc*6) then star.d=4
	elseif (sdh < sc*7) then star.d=3
	elseif (sdh < sc*8) then star.d=2
	end
	sdh += 1
	if star.c == 7 then star.c = 6 end
	add(stars,star)
	return star
end

function updatestar(star)
	star.x += ship.xv/star.d
	star.y += ship.yv/star.d
	wrapcheck(star)
end
function round(n)
	if (n-flr(n)) < 0.5 then return flr(n) else return flr(n+1) end
end
function drawstar(star)
	pset(star.x,star.y,star.c)
end

function uppos(thing)
	thing.x += (thing.xv+ship.xv)
	thing.y += (thing.yv+ship.yv)
end

function wrapcheck(thing)
	if thing.x < -10 then thing.x += width+19
	elseif thing.x > width+10 then thing.x -= width+19 end
	if thing.y < -10 then thing.y += height+19
	elseif thing.y > height+10 then thing.y -= height+19 end
end




















