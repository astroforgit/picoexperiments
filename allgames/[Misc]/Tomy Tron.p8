pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
bugit=0
speed=10
surround=true

function _init()
 tcol=1
 t=speed
 p=0
 lives=4
 ecars=3
 emen=4
 score=0
 menuitem(1,"surround",stog)
 winit({linit,cinit}) 
end

function _update()
 if(p>0)then
 	p-=1
 elseif(lives==0)then
  winit({linit,_init})
 else
  input()
  if(t==0)then
   tcol+=1
   if(tcol>5)then
    tcol=1
   end
	  t=speed
	  update()
	 else
		 t-=1
	 end
	end
end

function _draw()
 cls()
 camera(-8,-40)
 if(p==0 or p%8!=0)then
 	dscrn()
  draw()
 end
 camera()
 if(surround)then
 map(0,0)
 sspr(40,72,69,16,28,24)
 print("tron",26,102,6)
 print("cycle",44,102,6)
 print("sark",68,102,6)
 print("mcp",86,102,6)
 print("tomytronic",0,10,12)
 end
--print(bugit,0,0)
end

function stog()
 surround=not surround
end
-->8
--sprites
say={}
say[12]={88,0}//corner
say[1]={8,0}//hor
say[2]={18,0}//ver
say[3]={28,0}//chor
say[4]={38,0}//cver
say[5]={48,0}//dhor
say[6]={58,0}//dverr
say[7]={68,0}//hero
say[8]={78,0}//enemy
say[9]={98,0}//2car
say[10]={108,0}//dverl

function dspr(s,x,y)
 if(x==4 and y==2)then
  pal(11,12)
  pal(8,12)
 end
	sspr(s[1],s[2],10,10,x*10,y*10)
 pal()
end

function dtower()
 for i = 1,5 do
  if(i!=tcol)then
   pal(i,8)
  else
   pal(i,0)
  end
 end
 sspr(38,25,20,40,92,10)
end


-->8
--screen
mx=0
my=0
sx=0
ex=0


function imp(w,h)
	mp={}
	for x=0,w do
	 mp[x]={}
	 for y=0,h do
   mp[x][y]=0
	 end
	end
end

function dscrn()
	for x=sx,ex do
	 for y=0,4 do
	 	if(mx+x>=0 and mx+x<128 and my+y>0 and my+y<127)then
	 	 s=mp[mx+x][my+y]
 	 	if(s!=0)then
	 			dspr(say[s],x,y)
		 	end
	  end
	 end
	end
end


-->8
//cycle game
function cinput()
	if(btn(0) and hc.dir !=0 and hc.dir !=1)then
		sfx(1)
		if(hc.dir==2)then
		 hc.trk=0
		elseif(hc.dir==3)then
			hc.trk=2
		else
			hc.trk=1
		end
		hc.dir=0
	elseif(btn(1) and hc.dir !=1 and hc.dir !=0)then
		sfx(1)
		if(hc.dir==3)then
			hc.trk=12
		else
			hc.trk=1
		end
	 hc.dir=1
	elseif(btn(2) and hc.dir !=3 and hc.dir !=2)then
		sfx(1)
		if(hc.dir==0)then
			hc.trk=12
		else
			hc.trk=2
		end
	 hc.dir=2
	elseif(btn(3) and hc.dir !=2 and hc.dir !=3)then
  sfx(1)
  if(hc.dir==1)then
		 hc.trk=0
	 elseif(hc.dir==0)then
		 hc.trk=1
		else
			hc.trk=2
		end
  hc.dir=3
 end
end

function cai()
 if(count==4)then
  mbool=true
 end
 if(e.dir==0 and mp[e.x-1][e.y]!=0)then
  emove()
 elseif(e.dir==1 and mp[e.x+1][e.y]!=0)then
  emove()
 elseif(e.dir==2 and mp[e.x][e.y-1]!=0)then
  emove()
 elseif(e.dir==3 and mp[e.x][e.y+1]!=0)then 
  emove()
 elseif(mbool and rnd(5)<1)then
  emove()
 end
end

function emove()
 if(hc.y<e.y and mp[e.x][e.y-1]==0 and e.dir !=3 and e.dir !=2)then
	 if(e.dir==0)then
	 	e.trk=12
	 else
		 e.trk=2
	 end
	 e.dir=2
 elseif(hc.y>e.y and mp[e.x][e.y+1]==0 and e.dir !=3 and e.dir !=2)then
  if(e.dir==1)then
	  e.trk=0
	 elseif(e.dir==0)then
	  e.trk=1
	 else
		 e.trk=2
	 end
	 e.dir=3
 elseif(hc.x<e.x and mp[e.x-1][e.y]==0 and e.dir !=0 and e.dir !=1)then
	 if(e.dir==2)then
	  e.trk=0
	 elseif(e.dir==3)then
		 e.trk=2
	 else
		 e.trk=1
	 end
	 e.dir=0
 elseif(hc.x>e.x and mp[e.x+1][e.y]==0 and e.dir !=1 and e.dir !=0)then
	 if(e.dir==3)then
		 e.trk=12
	 else
		 e.trk=1
	 end
	 e.dir=1
	end
end

function ucmp()
 mx=hc.x-4
 my=hc.y-2
end

function icycle(x,y)
 c={}
 c.x=x
 c.y=y
 c.dir=1
 c.trk=1
 c.dead=false
 c.dtune=5
 return c
end

function ucycle(c)
 if(c.dir==0)then
	 mp[c.x][c.y]=c.trk
	 if(c.trk!=1)c.trk=1
 	c.x-=1
 	if(mp[c.x][c.y]!=0)then
 	 c.dead=true
 	 p=48
 	 c.x+=1
 	end
	 mp[c.x][c.y]=3
 elseif(c.dir==1)then
  mp[c.x][c.y]=c.trk
  if(c.trk!=1)c.trk=1
 	c.x+=1
 	if(mp[c.x][c.y]!=0)then
 	 c.dead=true
 	 p=48
 	 c.x-=1
 	end
 	mp[c.x][c.y]=3
 elseif(c.dir==2)then
	 mp[c.x][c.y]=c.trk
	 if(c.trk!=2)c.trk=2
 	c.y-=1
 	if(mp[c.x][c.y]!=0)then
   c.dead=true
   p=48
   c.y+=1
		end
 	mp[c.x][c.y]=4
 elseif(c.dir==3)then
	 mp[c.x][c.y]=c.trk
	 if(c.trk!=2)c.trk=2
 	c.y+=1
 	if(mp[c.x][c.y]!=0)then
 	 c.dead=true
 	 p=48
 	 c.y-=1
 	end
 	mp[c.x][c.y]=4
 end
end

function cinit()
 update=cupdate
 draw=cdraw
 input=cinput
 imp(127,127)
 for i=0,127 do
  mp[i][0]=1
  mp[i][127]=1
  mp[0][i]=2
  mp[127][i]=2 
 end
 count=0
 sx=1
 ex=7
 mbool=false
	e=icycle(60,61)
	hc=icycle(60,60)
end

function cupdate()
	if(hc.dead)then
		lives-=1
		linit({cinit})
	elseif(e.dead)then
	 ecars-=1
	 linit({cinit})
	 if(ecars==0)then
	  winit({linit,dinit})
	 end
	else
	 if(stat(16)!=4)then
   sfx(4,0)
  end
	 if(count==5)then
	  score+=5
	  count=0
	 else
   count+=1
  end
  ucycle(hc)
  if(hc.dead)then
   sfx(-1,0)
   sfx(6)
  end
  cai()
  ucycle(e)
  if(e.dead)then
   sfx(-1,0)
   sfx(5)
  end
	 ucmp()
 end
end

function cdraw()
 dtower()
	rectfill(80,0,127,9,0)
 print(score,88,2,12)
end
-->8
//disc game
function idman(x,y,hsd,pic)
 m={}
 m.x=x
 m.y=y
 m.hsd=hsd
 m.pic=pic
 m.dir=0
 m.lives=4
 m.dead=false
 return m
end

function idisc()
 disc={}
 disc.x=0
 disc.y=0
 disc.vy=0
 disc.hsd=false
 disc.dir=0
 disc.count=0
end

function throw(x,y,dr)
 sfx(1)
 disc.x=x
 if(y>1)then
  disc.y=y-1
 else
  disc.y=y+1
 end
 disc.vy=5-y
 disc.hsd=true
 disc.dir=dr
 disc.count=0
end

function udisc()
 if(disc.count==3)then
  sfx(1)
 end
 mp[disc.x][disc.y]=0
 disc.x+=disc.dir
 if(disc.count>3)then
  if(disc.vy>disc.y)then
   disc.y+=1
  elseif(disc.vy<disc.y)then
   disc.y-=1
  elseif(disc.count<7)then
   disc.y+=1
  end
 elseif(disc.y>1)then
  disc.y-=1
 end
 disc.count+=1
 if(disc.x==0)then
  mp[disc.x][disc.y]=10
 elseif(disc.x==8)then
  mp[disc.x][disc.y]=6
 else
  mp[disc.x][disc.y]=5
 end
end

function dinit()
 update=dupdate
 draw=ddraw
 input=dinput
 imp(8,4)
 idisc()
 count=0
 mx=0
 my=0
 sx=0
 ex=8
 mp[0][4]=7
 mp[8][4]=8
 hero=idman(0,4,false,7)
 enemy=idman(8,4,true,8)
end

function dupdate()
 if(hero.dead)then
  hero.dead=false
  hero.lives-=1
  if(hero.lives==0)then
   lives-=1
   linit({dinit})
  else
   mp[disc.x][disc.y]=0
   disc.hsd=false
   hero.hsd=true
  end
 elseif(enemy.dead)then
  score+=10
  enemy.lives-=1
  enemy.dead=false 
  if(enemy.lives==0)then
   sfx(5)
   score+=50
   winit({linit,tinit})
  else
   mp[disc.x][disc.y]=0
   disc.hsd=false
   enemy.hsd=true
  end
 else
  count+=1
  if(count==5)then
   count=0
  end
  mp[enemy.x][enemy.y]=0
  if(enemy.y==1)then
   enemy.dir=1
  elseif(enemy.y==4)then
   enemy.dir=-1
  end
  enemy.y+=enemy.dir
  mp[enemy.x][enemy.y]=enemy.pic  
  if(enemy.hsd)then
   if(count>2 and rnd(2)<1)then
    throw(7,enemy.y,-1)
    enemy.hsd=false
   end 
  elseif(disc.hsd)then
   if(disc.x==0)then
    if(disc.y==hero.y)then
     disc.hsd=false
     hero.hsd=true
    else
     hero.dead=true
     p=24
    end
   elseif(disc.x==8)then
    if(disc.y==enemy.y)then
     disc.hsd=false
     enemy.hsd=true 
    else
     enemy.dead=true
     p=24
    end
   else
    udisc()
   end
  end
 end
end

function ddraw()
 sspr(38,25,20,40,92,10)
	dtower()
 print(score,88,2,12)
 if(enemy.hsd)then
  dspr(say[6],8,enemy.y)
 elseif(hero.hsd)then
  dspr(say[10],0,hero.y)
 end
 dlives(0,hero.lives-1,1)
 dlives(8,1-enemy.lives,-1)
end

function dinput()
 mp[hero.x][hero.y]=0
 if(btnp(2) and hero.y>1)then
  hero.y-=1
 elseif(btnp(3) and hero.y<4)then
  hero.y+=1
 end
 if(btn(4) and hero.hsd)then
  throw(1,hero.y,1)
  hero.hsd=false
 end
 mp[hero.x][hero.y]=hero.pic
end

function dlives(x,l,fr)
 for i=x,x+l,fr do
 	dspr(say[1],i,4)
 end
end
-->8
//tower game
function thero()
	th={}
	th.lives=8
	th.hsd=true
	return th
end

function itower()
 tw={}
 tw.def=0
end

function tinit()
 update=tupdate
 draw=tdraw
 input=tinput
 imp(8,4)
	mp[0][3]=7
 hero=thero()
 itower()
 count=0
 dx=0
end

function tupdate()
 if(dx==9)then
  speed-=2
  score+=1000
  winit({linit,cinit})
 else
  count+=1
  if(count==10)then
   count=0
   hero.lives-=1
  end
  if(tw.def>0)then
   tw.def-=1
  end
  if(not hero.hsd)then
   dx+=1
   if(dx==8)then
    if(tw.def==0)then
     sfx(7)
     tw.def=12
     hero.hsd=true
    elseif(tw.def%2!=0)then
     hero.hsd=true 
    end
   elseif(dx==9)then
    sfx(8)
    p=32 
   end
  end
 end
end

function tdraw()
 if(tw.def>0 and tw.def%2==0)then
  pal(12,0)
  tcol=-1
 end
 dtower()
 pal()
 for i = 1,5 do
  if(i!=tcol)then
   pal(i,8)
  else
   pal(i,0)
  end
 end
 sspr(40,46,15,20,94,31)
 pal()
	rectfill(80,0,127,9,0)
 print(score,88,2,12)
 dlives(0,hero.lives,1)
 if(hero.hsd)then
  dspr(say[10],0,3)
 elseif(dx==8)then
  dspr(say[6],dx,3)  
 else
  dspr(say[5],dx,3)
 end
end

function tinput()
 if(btn(4) and hero.hsd)then
  sfx(1)
  dx=1
  hero.hsd=false
 end
end
-->8
//screen wipe
function iwmp()
	if(not mp)then
	 imp(8,4)
	end
	for x=0,8 do
  mp[x][0]=2
 end
end

function winit(n)
 update=wupdate
 draw=wdraw
 input=winput
 nxt=n
 iwmp()
 mx=0
 my=0
 sx=1
 ex=7
 wp=0
 wt=false
end

function wupdate()
 sfx(1)
	for x=0,8 do
	 mp[x][wp]=0
	end
	if(wt)then
 	wp+=1
 	wt=false
 else
  wt=true
	end
 for x=0,8 do
	 if(wt)then
	  mp[x][wp]=1
	 else
   mp[x][wp]=2
	 end
	end
	if(wp>4)then
	 nxt[1]({nxt[2]})
	 sfx(2)
	end
end

function wdraw()
 dtower()
 print(score,88,2,12)
end

function winput()
end
-->8
//lives screen
function linit(n)
	update=lupdate
	draw=ldraw
	input=linput
	imp(8,4)
	timer=6
	nxt=n
	mx=0
	my=0
	sx=0
 ex=8
 for y=1,4 do
 	if(y<=lives)then
 	 mp[0][5-y]=7
 	end
 	if(y<=emen)then
 	 mp[8][5-y]=8
 	end
 end
 for x=1,3 do
 	if(x<=ecars)then
 	 mp[8-x][4]=3
 	end
 end
end

function lupdate()
 if(timer==4)then
  sfx(3)
 end
 if(timer==0)then
  nxt[1]({nxt[2]})
 else
  timer-=1
 end
end

function ldraw()
 dtower()
	rectfill(80,0,127,9,0)
 print(score,88,2,12)
end

function linput()
end
