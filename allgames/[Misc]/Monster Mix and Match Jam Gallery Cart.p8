pico-8 cartridge // http://www.pico-8.com
version 16
__lua__
--horror_os
--@enargy mmamjam gallery
cartdata("enargy_endofcivilization")

poke(0x5f2d, 1) -- enable devkit input mode

--simple dt
--icon for each mmamjam cart

--my date with the sphinx
--@enargy
--pico8 port for #mmamjam
--does the code look odd..er
--than usual?
--that's because it's a conversion
--of a pygame game
--submitted for gbjam a couple
--years back..
function def()end
function _init()
	dct=0
	_draw=_dtdraw
	abc="abcdefghijklmnopqrstuvwxyz 0123456789_-!@#$%^&*(){}[]+=/\n?."
	lc="\65\66\67\68\69\70\71\72\73\74\75\76\77\78\79\80\81\82\83\84\85\86\87\88\89\90 0123456789_-!@#$%^&*(){}[]+=/\n?."

	carts={'red//black',"#57933",
        'bghouled',"#57921",
        'emonstery',"#57515",
        '    wizard\n     duels',"#57948",
        '    3d picoh\n      mummy',"#58327",
        'got-ya!',"#57210"
                }
 authors={'@matthias//@mtths_flk','@mccolgst','@grumpydev','@dollarone','@robuttley/@weareroad'}
        
	icons={}
	for k=1,#carts/2 do
		author=authors[k]
		k-=1
		
		local x=12+(k%2)*48
		local y=12+flr(k/2)*32
		local s=192+k*2
		k*=2
		k+=1
		local txt=lower(carts[k])
		icons[k]={id=carts[k+1],s=s,x=x,y=y,txt=txt,author=author}
	end
	if band(peek(0x5ebf),4)==4 then
		add(icons,{s=224,x=90,y=32,txt=lower(" mdwas"),id=-1})
		add(icons,{s=206,x=84,y=102,txt=lower("who did dis???"),id=-2,author="?????"})
	else
		add(icons,{s=204,x=123,y=126,txt="treats?",author="..or tricks?"})
	end
	
end
function _update60()
--	_mdwasinit()
	dct-=1
	if dct<=0 then dct=0 end
	mousex,mousey=stat(32),stat(33)
 olmb=lmb
 ormb=rmb
 lmb=band(stat(34),1)==1
 rmb=band(stat(34),2)==2
 if not olmb and lmb then
  lclick=true
  if mousex>=119 and mousex<=128
  	and mousey>=0 and mousey<=6 then
  	_draw=_dtdraw
  	memeflag=nil
  	sfx(19)
  end
 else
  lclick=false
 end
 if not ormb and rmb then
  rclick=true
 else
  rclick=false
 end
 if lclick then
 	tip=false
	 for k,v in pairs(icons) do
 	 if mousex>=v.x and mousex<=v.x+16
 	 	and mousey>=v.y and mousey<=v.y+20 then
 	 	tip=true
 	 	if sel==icons[k] and not memeflag then
 	 		if dct>0 then
 	 			if sel.id then
 	 				if sel.id==-1 then
 	 					_mdwasinit()
 	 					
 	 				elseif sel.id==-2 then
 	 					_draw=drawmeme
 	 					memeflag=true
 	 					sfx(19)
 	 				else
		 	 			load(sel.id,">mmamjam gallery")
		 	 		end
	 	 		else
		 	 		sfx(20)
		 	 		poke(0x5ebf,bor(peek(0x5ebf),4))
	 	 			sel.s=224
	 	 			sel.id=-1
	 	 			sel.txt=lower(" mdwas")
	 	 			dct=0
	 	 			sel=nil
	 	 		end
 	 		end
 	 	end
 	 	sel=icons[k]
 	 	sel.invert=true
  		mxo,myo=mousex-sel.x,mousey-sel.y
  	else
  		v.invert=false
  	end
		end
	end
	if not tip then
		sel=nil
	else
		dct=90
	end
	
	if sel then
 	if lmb then
 		sel.x=mousex-mxo
 		sel.y=mousey-myo
 	end
 end
end
function _dtdraw()
	fillp(0b1111100110011111)
	rectfill(0,0,127,127,0xd9)
	fillp()

	palt(0,false)
	palt(11,true)
	
	for k,v in pairs(icons) do
		spr(v.s,v.x,v.y,2,2)
		pprint(v.txt,v.x-(#v.txt*4)/4,v.y+18,7,0)
		if v.invert then
			pspr(v.s,v.x,v.y,9,1,2,2)
			pprint(v.txt,v.x-(#v.txt*4)/4,v.y+18,9,1)
			local at=v.author or '@enargy'
			rectfill(0,115,#at*5,127,13)
			rect(0,115,#at*5,127,1)
			pprint(at,4,119,9,7)
		end
	end
	
	timestr=''
 h=stat(93)
 if (h<10) h='0'..h
 m=stat(94)
 if (m<10) m='0'..m
 timestr=h..':'..m
 if fuzziness==0 then
  s=stat(95)
  if (s<10) s='0'..s
 
	 timestr=timestr..':'..s
 end
  
 
 
 rectfill(0,0,127,10,9)
 rect(0,0,127,10,1)
 
 pprint("monster mix-n-match jam",4,3,7,1)
 
 pprint(timestr,104,3,1,7)
	
	spr(255,mousex,mousey)
	
end
function _mdwasinit()
	
	music(0)
	
	normal,happy,sad,mad=1,2,3,4
	
	mood=normal
	
	_update60=_mdwasupdate
	_draw=_mdwasdraw
 --constants
 black = 0
 white = 7

 title = 0
 drawing_question = 1
 waiting_for_answer = 2
 showing_fail = 3
 showing_correct = 4
 game_over = 5
 win = 6

 flash_answer_correct = 7
 flash_answer_wrong = 8
 -- ( query, a1, a2, answer )
 questions = {{' "my date with the sphinx"\n   ~ a silly quiz game ~','story','game','*'},
 													{"what is the third month?", 'mars', 'march', 'march'},
              {"what is the third planet?", 'threepiter', 'earth', 'earth'},
              {"what is the sum of 1 and 3?", '3', '4', '4'},
              {"having fun?", 'yes', 'no', 'yes'},
              {"4+5=", '9', 'blue', '9'},
              {"------- the cat", 'virtute', 'pookie', 'virtute'},
              {"your heart is a..?", 'river', 'dam', 'river'},
              {"is it hot in here?", 'sure', 'yep', '*'},
              {"hrrrk!", '[assist]', '[ignore]', '[assist]'},
              {"going dutch?", 'ja', 'iie', 'iie'},
              --  winning text
              {"you win, clever human! ‡‡‡\n"..lower("(..guess i can delete that\n emonstery account now..)"), 'good', 'job', ''},
              {"stop pressing your luck!!!", 'go!', 'away!', ''},
              {"time to eat you t_t", 'game', 'over', ''}}
 asked = {}

 question_offset = 1


 --# images
 bgs = {talk00=0,
        talk01=2,
        talk02=4,
        talk03=4,
        talk04=2,
        talk05=0,
        rest00=6,
        rest01=8,
        rest02=10,
        happy=12,
        mad=14}
           
 bg_rect = {16,16}
        
 health = 3
--# 5, 102 --> 150, 39

 question_box_image = {w=150, h=39}
 question_box_rect = {w=120, h=34}
 question_box_rect.x,question_box_rect.y = 2, 90
 

 title_text = "placeholder"

 question_text = ""
 question_answer1 = ""
 question_answer2 = ""

 question_text_offset = #question_text
 question_image = sub(question_text,1,question_text_offset)
 question_rect = {w=#question_image*4,h=6}
 question_rect.x, question_rect.y = 6 , 105
 question_answer1_image = "Ž: "..question_answer1
 question_answer1_rect = {x=0,y=0,w=128,h=6}
 question_answer1_rect.x, question_answer1_rect.y =  6 , 105+(question_rect.y+question_rect.h+2)

 question_answer2_image = "—: "..question_answer2
 question_answer2_rect = {x=0,y=0,w=128,h=6}
 question_answer2_rect.x, question_answer2_rect.y = 6 , 105+(question_answer1_rect.y+question_answer1_rect.h*2)+2
 --# def update_question( drawtimer, question_text, question_text_offset ):
     

 default_drawtimer = 3 --# 1/10 sec per character
 drawtimer = 3 --# 1/10 sec per character

 question_answer1 = questions[question_offset][1]
 question_answer2 = questions[question_offset][2]
 question_correct_answer = questions[question_offset][3]

 talk_counter = 60
 talk_frame = 0
 blink_counter = 60
 blink_frame = 0


 state = title
 window_width = 128
 window_height = 128
       
 bg_image, bg_rect = title_image, title_rect

 flash_timer = 90
 default_flash_timer = 90

 show_a1 = true
 show_a2 = true
         
 fullscreen = false
          
 flash = false
 
 tts=1
    
end
function _mdwasupdate()
  
 if state == title then
  state = drawing_question
  question_text_offset = 0
  question_text = questions[question_offset][1]
  question_answer1 =  questions[question_offset][2]
  question_answer2 = questions[question_offset][3]
  question_correct_answer = questions[question_offset][4]
  --# set up first question..
 end
     
 if (state==drawing_question or state==waiting_for_answer) and question_offset < #questions then
  flash_timer = default_flash_timer
  if btnp(—) then
   if question_answer2 == question_correct_answer or question_correct_answer=='*' then
    state = flash_answer_correct
    question_correct_answer=question_answer2
    sfx(12)
    if question_offset==1 then
    	music(-1)
					music(3)
				else
					mood=happy
    end	
   else
   	
   	mood=mad
    state = flash_answer_wrong
    health -= 1
    sfx(11)
    
    
    if health <= 0 then
        
     state = drawing_question
     question_offset = #questions
     question_text_offset = 0
     question_text = questions[question_offset][1]
     question_answer1 =  questions[question_offset][2]
     question_answer2 = questions[question_offset][3]
     question_correct_answer = questions[question_offset][4]
    end
   end
  elseif btnp(Ž) then
  
   if question_answer1 == question_correct_answer or question_correct_answer=='*' then
    state = flash_answer_correct
    question_correct_answer=question_answer1
    sfx(12)
    if question_offset==1 then
    	--show story..
    	state = drawing_question
     question_offset = 0
     question_text_offset = 0
     question_text = "your cute blind date turned\nout to be a man-eating quiz-\nmaster... literally! !_!"
     question_answer1 = 'good'
     question_answer2 = 'luck!'
     question_correct_answer = '*'
				else
					mood=happy
    end
   else
   	mood=mad
    state = flash_answer_wrong
    health -= 1
   	sfx(11)
    
    if health <= 0 then
     mood=mad
     state = drawing_question
     question_offset = #questions
     question_text_offset = 0
     question_text = questions[question_offset][1]
     question_answer1 =  questions[question_offset][2]
     question_answer2 = questions[question_offset][3]
     question_correct_answer = questions[question_offset][4]
    end
   end
  end
             
 end
                
end
function _mdwasdraw()
 palt(11,true)
 palt(0,false)
 
 fillp(0b0110001110011100)
 rectfill(0,0,127,127,0x1e)
 fillp()
 question_box_rect=draw_box(question_box_rect,13,1)
 if state == title then
  -- # display the title
  pprint("title",32,64,1)
 end
 if state == drawing_question then
  -- # update draw timer
  drawtimer -= tts
  if drawtimer <= 0 then
   drawtimer += default_drawtimer
   -- # draw question based on timer
   question_text_offset += 1
   if question_text_offset > #question_text then
    state = waiting_for_answer
   else
    show_a1 = true
    show_a2 = true
    question_image = sub(question_text,1,question_text_offset)
    question_rect = {}
    question_rect.x,question_rect.y = 6, 94
    
    question_answer1_image = "Ž: "..question_answer1
    question_answer1_rect = {}
    
    question_answer1_rect.x,question_answer1_rect.y = 6 , 117

    question_answer2_image = "—: "..question_answer2
    question_answer2_rect = {}
    question_answer2_rect.x,question_answer2_rect.y = 100-#question_answer2*4 , 117
   end
  end
 end  
     
 if state == drawing_question then
  talk_counter -= tts
  if talk_counter <= 0 then
   talk_counter += 100
   talk_frame += 1
  end
  if talk_frame == 7 then
   talk_frame = 1
  end
  bg_image = bgs['talk0'..talk_frame]
 end
 if state == waiting_for_answer then
  blink_counter -= tts
  if blink_counter <= 0 then
   blink_counter += 60
   blink_frame += 1
  end
  if blink_frame == 3 then
   blink_frame = 1
   blink_counter = 600
  end
  bg_image = bgs['rest0'..blink_frame]
 end
 
 if state == flash_answer_correct or state == flash_answer_wrong then
  flash_timer -= 1
  if flash_timer <= 0 then
   state = drawing_question
   -- set up statearu..
   question_offset += 1
   mood=normal
	  
   if question_offset==#questions-1 then
   	sfx(20)
   	poke(0x5ebf,bor(peek(0x5ebf),2))
   end
   
   
   question_text_offset = 1
   question_text = questions[question_offset][1]
   question_answer1 =  questions[question_offset][2]
   question_answer2 = questions[question_offset][3]
   question_correct_answer = questions[question_offset][4]
   show_a1 = true
   show_a2 = true
  end
  if state == flash_answer_correct then
   bg_image = bgs['happy']
  elseif state == flash_answer_wrong then
   bg_image = bgs['mad']
  end
      
  if flash then
   flash = false
   show_a1 = false
   show_a2 = false
  else
   flash = true
   if question_correct_answer == question_answer1 then
    show_a1 = true
   end
   if question_correct_answer == question_answer2 then
    show_a2 = true
   end
  end
                
 end              
 --# blit bg
 //spr(bg_image, 80,0,2,2)
 
 rectfill(50,14,121,85,1)
 rectfill(53,17,118,82,7)
 
 // portrait
 sspr(0,64,32,32,54,18,64,64)
 
 //happy
 if mood==happy or question_offset==#questions-2 then
 		--68-->88
 		--76-->94
 	sspr(68,76,20,18,54+8,18+24,40,36)
 elseif mood==mad then
 	sspr(48,32,32,32,54,18,64,64)
 end
 --# blit health
 health_image={x=0,y=16}
 sspr(health_image.x,health_image.y,health*15,14,2,2)
 
 --# blit text box
 --spr( question_box_image, 0,0)
 pprint(question_image,question_rect.x,question_rect.y,1,7)
  
 if show_a1 then
  pprint(question_answer1_image, question_answer1_rect.x,question_answer1_rect.y,1,7)
 end
 if show_a2 then
  pprint(question_answer2_image, question_answer2_rect.x,question_answer2_rect.y,1,7)
 end
end

function format_txt(desctxtcpy,cclim)
 desctxt=""
 word=""
 ccount=0
 spaceoff=1
 theight=0
 cclim=cclim or 30
 for i=1,#desctxtcpy do
  char=sub(desctxtcpy,i,i)
  ccount+=1
  
  if char==' ' or i==#desctxtcpy or char=='\n' then
   
   if ccount>=cclim then
    theight+=6

    desctxt=desctxt..'\n'..sub(desctxtcpy,spaceoff,i)

    ccount=#sub(desctxtcpy,spaceoff,i)
   else
    desctxt=desctxt..sub(desctxtcpy,spaceoff,i)
   end
   spaceoff=i+1
  end
  
 end
 return desctxt
end

function draw_box(b,c,o)
 local x1,y1,x2,y2=b.x,b.y,b.x+b.w,b.y+b.h
 rectfill(x1,y1,x2,y2,c)
 if o then
  rect(x1,y1,x2,y2,o)
 end
 return b
end
function pprint(txt,x,y,b,c)
 for ix=-1,1 do for iy=-1,1 do
  print(txt,x+ix,y+iy,b)
 end end
 print(txt,x,y,c)
end
function drawmeme()
	palt(11,true)
	palt(0,false)
	rectfill(0,0,63,127,15)
	rectfill(63,0,127,127,7)
 sspr(0,64,32,32,1,0,64,64)
 sspr(32,64,32,32,1,64,64,64)
 
 rect(0,0,127,127,1)
 rect(0,0,64,64,1)
 rect(0,64,64,127,1)
 rect(0,64,127,64,1)
 
 pprint("—",120,1,8,1)
 
 ?'> splitting\n  code into\n  ordered\n  tabs',66,16,0
 ?'> ctrl + f',66,80,0
 
 spr(255,mousex,mousey)
end
function pprint(txt,x,y,tc,oc)
	for ix=-1,1 do for iy=-1,1 do
		print(txt,x+ix,y+iy,oc)
	end end
	print(txt,x,y,tc)
end
function lower(chars,case)
	str=""
	start=1
	if case then
		str=sub(chars,1,1)
		start=2
	end
	for i=start or 1,#chars do
		char=sub(chars,i,i)
 	for i=1,#abc do
 		if sub(abc,i,i)==char then
 			str=str..sub(lc,i,i)
 		end
 	end
 end
 return str
end
function pspr(s,x,y,oc1,oc2,w,h)
	w=w or 1
	h=h or 1
	for i=0,15 do pal(i,oc2) end
	for ix=-2,2,2 do for iy=-2,2,2 do
		spr(s,x+ix,y+iy,w,h)
	end end
	for i=0,15 do pal(i,oc1) end
	for ix=-1,1 do for iy=-1,1 do
		spr(s,x+ix,y+iy,w,h)
	end end
	for i=0,15 do pal(i,i) end
	spr(s,x,y,w,h)
end
