function doshake ()
 local shakex=16-rnd(32)
 local shakey=16-rnd(32)
 
 shakex=shakex*shake
 shakey=shakey*shake
 
 camera(shakex,shakey)
 
 shake=shake*0.3
 if shake<0.05 then
  shake=0
 end
 
end

function play_song(track)
if not playsong then
           music(track)
           playsong=true
       end
   end
   
   function stop_song(timeout)
       if playsong then
           music(-1,timeout)
           playsong=false
       end
end
