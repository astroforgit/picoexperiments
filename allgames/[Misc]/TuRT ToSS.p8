--car1

function make_car()
carchange=70+abs(rnd(30))
cardinit=60
carinit=127
carspeed=2
car={
x=carinit,
y=carchange,
delay=cardinit,
delay=cardinit}
end

function move_car()
car.delay-=1

if(car.delay<0) then
go=true
else
go=false
end

if car.delay<-cardinit and car.x<-60 then
car.delay=cardinit end

if car.x<-60 then

car.delay=cardinit
car.x=carinit
car.y=carchange end


end

function cargo()
     if car.x<-50 or car.x>127 then 
     carchange=70+abs(rnd(30)) end
car.x=car.x-carspeed
car.y=carchange
end

function drawcar()

if scoree<2 then 
			print("watch out!",car.x+6,car.y-1,0)
   print("watch out!",car.x+5,car.y-2,7)
   end

carshad=car.y+21

spr(97,car.x+10,carshad,5,2.5,true,false)
spr(72,car.x,car.y,8,4)
--rect(chbx,chby,chbx+chbw,chby+chbh,7)
end

function chb()

chbx=car.x+10
chby=car.y+20
chbw=45
chbh=8
end

function hit()
 if j2==false then
     if
       (turthb.x > chbx+chbw) or
       (turthb.w < chbx) or
       (turthb.y > chby+chbh) or
       (turthb.h < chby)
     then
       
       h=false
        else
       h=true
       
       end
  end
 if h==true and col==false then
  col=true
  box.dx-=.5
  sfx(12)
  shake+=.1
 end
end
