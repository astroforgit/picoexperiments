function collision()
if woo==false then
  if
  (turthb.x > box.x+box.w) or
  (turthb.w < box.x) or
  (turthb.y > box.y+box.h) or
  (turthb.h < box.y)
  
  then
  
  col=true
  else
  col=false
   end
  end
end

