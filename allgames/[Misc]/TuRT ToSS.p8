-->8
--hurdle

hurdle={}
ot=180

function make_hurdle(ox,oy)
o={}
o.sprite=222
o.x=ox
o.y=oy
o.w=2
o.h=90

   o.draw = function(this)
    spr(this.sprite,this.x+1,this.y,2,2)
    spr(this.sprite,this.x+2,this.y+8,2,2)
    spr(this.sprite,this.x+3,this.y+16,2,2)
    spr(this.sprite,this.x+4,this.y+24,2,2)  
    spr(this.sprite,this.x+5,this.y+32,2,2) 
    spr(this.sprite,this.x+6,this.y+40,2,2)
    spr(this.sprite,this.x+7,this.y+48,2,2)  
      end
   
   o.move = function(this)
   ot=180
   if not game_over then
    this.x-=1.8
       if this.x<0  then
       this.y=55 
       this.x =227 end 
    end
   end
    
--pickup


add (hurdle,o)
end

function update_hurdle()

		foreach(hurdle,function(o)
		  
	
		  if j2==false then
    		 
    		--if cone collision
    		if
     abs(box.x - o.x) <8 and box.y>55 and col==false 
    		then
    		
    		--then cone collision
     
      ht-=1
      
     end
      
      
     if ht<2 then
      sfx(20)
      turt.dx=-10
						turt.s=8
      turt.dy=0
      box.dx-=.5
      woo=true
      shake+=.1
      ht=5
      end
    end
    
    
    
   
			end)
		end
		
function move_hurdle()
foreach(hurdle, function(o) o:move() end)
end

function hurdle_timer()
ot-=1
if ot <0 then ot = 180  end
end

