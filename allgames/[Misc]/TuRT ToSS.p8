function make_picu(hx,hy)
h={}
h.sprite=206
h.x=hx
h.y=hy

   h.draw = function(this)
    spr(this.sprite,this.x,this.y)
   end
   
   h.move = function(this)
   pt=100
   if not game_over then
    this.x-=1
       if this.x<0 then
       this.y=45+rnd(40) 
       this.x =127 end 
    end
   end
    
--pickup


add (pickup,h)
end

function update_picu()

		foreach(pickup,function(h)
		  
		
		  
		  if not game_over then
    		  h.sprite+=1 
    		  if h.sprite>207 then 
    		  h.sprite = 206 end
    		 end
    		  
    
    	
		  
    if abs(box.x-h.x)<8 and abs(box.y-h.y)<8 then 
    scoree3+=1
    sfx(19)
    del(pickup,h)
    end
    
    
    
   
			end)
		end
		
function move_picu()
foreach(pickup, function(h) h:move() end)
end

function picu_timer()
pt-=1
if pt <0 then pt = 100  end
end


