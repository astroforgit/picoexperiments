pico-8 cartridge // http://www.pico-8.com
version 5
__lua__
--rain culture
--by nusan

char_x = 64
char_y = 64
char_vx = 0
char_vy = 0

char_intool = false
char_curtool = nil

max_seed = 0

time = 0
win = false
winref = -0.01
finish = false

levelrefs = {}
levelrefs[1] = 0.6
levelrefs[2] = 0.6
levelrefs[3] = 0.75
levelrefs[4] = 0.6
levelrefs[5] = 0.75
levelrefs[6] = 0.75
levelrefs[7] = 0.75
levelrefs[8] = 0.85
levelrefs[9] = 0.75
levelrefs[10] = 0.75
levelrefs[11] = 0.75

maxlevel = 11

cheat = false
inmenu = true
needinit = true

level = 0
level_x = 0
level_y = 0

rotspeed = 0

function setlevel(lvl)
	level = lvl
	level_x = (level%8) * 16
	level_y = flr(level/8) * 16
	if(#levelrefs>=level) then
		winref = levelrefs[level+1]
	else
		winref = -0.01
	end
end

function newtool(x,y,angle,type)
	local set = {}
	set.x = x
	set.y = y
	set.angle = angle
	set.ca = cos(angle)
	set.sa = sin(angle)
	set.type = type
	set.refangle = angle
	return set
end

type_cannon = 1
type_mirror = 2
type_mirrorrot1 = 3
type_mirrorrot2 = 4
type_mirrorflip = 5
type_mirrorflipoff = 6

cannons={}
mirrors={}
rain={}
ground={}
maintrees={}
mainfire={}

function newrain(x,y,vx,vy)
	local set={}
	set.x=x
	set.y=y
	set.vx = vx
	set.vy = vy
	set.c = 12+flr(rnd(3))
	if(set.c == 13) set.c = 1
	if(set.c == 14) set.c = 5
	set.life = -1
	return set
end


function newground(x,y,spr,cangrow)
	local set = {}
	set.x = x
	set.y = y
	set.full = true
	set.cangrow = cangrow
	set.spr = spr
	set.wet = 0
	set.tree = nil
	return set
end

function newair()
	local set = {}
	set.vx = 0
	set.vy = 0
	set.sum = 0
	set.full = false
	return set
end

function newchild(x,y,spr)
	local set = {}
	set.x = x
	set.y = y
	set.spr = spr
	return set
end

function newtree(x,y,ground,childs,lenchilds)
	local set = {}
	set.x = x
	set.y = y
	set.ground = ground
	set.health = 0.0
	set.spr = rnd(5)
	set.rot = 1
	if(rnd(10)>5) set.rot = -1
	set.childs = {}
	for i=1,childs do
		local newlist = {}		
		for j=1,lenchilds do
			add(newlist, newchild(rnd(1)-0.5,rnd(1)-0.5,flr(rnd(5))))
		end
		add(set.childs, newlist)
	end
	return set
end

local tmpcount = 0

function tryaddtree(i,j,vx,vy,offx,offy)
	if((i+offx)<1 or (i+offx)>16 or (j+offy)<1 or (j+offy)>16) return
	local t = mget(i-1+offx+level_x,j-1+offy+level_y)
	local c = fget(t,2)
	local rground = ground[i+offx][j+offy]
	if(c and rground.tree==nil) then
		local cur = newtree(vx+4+offx*8,vy+4+offy*8,rground,3,3)
		rground.tree = cur
		add(maintrees, cur)
		tmpcount += 1
	end
end

function initzone(x,y,sx,sy)

	reload(0, 0, 0x4300)

	char_x = 64
	char_y = 0
	char_vx = 0
	char_vy = 8

	char_intool = false
	char_curtool = nil

	max_seed = 0

	time = 0
	win = false

	cannons={}
	mirrors={}
	rain={}
	ground={}
	maintrees={}
	mainfire={}

	menutree={}

	for i=1,sx do
		ground[i] = {}
		for j=1,sy do
			ground[i][j] = newair()
		end
	end

	for i=1,sx do
		for j=1,sy do
			local vx = (i-1)*8
			local vy = (j-1)*8

			local t = mget(x+i-1,y+j-1)
			local c = fget(t,1)

			if(c) then
				ground[i][j] = newground(vx,vy,t, fget(t,2))
				if(fget(t,2)) max_seed += 1
			end
		end
	end

	for i=1,sx do
		for j=1,sy do
			local vx = (i-1)*8
			local vy = (j-1)*8

			local t = mget(x+i-1,y+j-1)
			local c = fget(t,2)

			if(not c) then
				if(t >= 48 and t<=51) then
					add(cannons, newtool(vx+4,vy+4,(t-48)/4,type_cannon))
					t=106
				end
				if(t >= 52 and t<=57) then
					local typ = type_mirror
					local ang = 0
					if(t == 55 or t == 57) ang = 0.25
					if(t==52) typ = type_mirrorflip
					if(t==54 or t==55) typ = type_mirrorrot1
					if(t==56 or t==57) typ = type_mirrorrot2
					add(mirrors, newtool(vx+4,vy+4,ang,typ))
					t=106
				end
				if(t == 32) then
					tryaddtree(i,j,vx,vy,-1,0)
					tryaddtree(i,j,vx,vy,1,0)
					tryaddtree(i,j,vx,vy,0,-1)
					tryaddtree(i,j,vx,vy,0,1)
					t=0
				end
			end

			if(t == 10) t=10+flr(rnd(6))
			if(t == 26) t=26+flr(rnd(6))
			if(t == 106) t=106+flr(rnd(5))

			mset(x+i-1,y+j-1,t)

		end
	end

end

function _init()
	music(0,1000)
	setlevel(level)
end

function findneartool(x,y)

	local mindist2 = 10000
	local tool = nil
	for cur in all(mirrors) do
		local dx = (x-cur.x)*0.1
		local dy = (y-cur.y)*0.1
		local dist2 = dx*dx+dy*dy
		if(dist2<mindist2) then
			mindist2 = dist2
			tool = cur
		end
	end
	for cur in all(cannons) do
		local dx = (x-cur.x)*0.1
		local dy = (y-cur.y)*0.1
		local dist2 = dx*dx+dy*dy
		if(dist2<mindist2) then
			mindist2 = dist2
			tool = cur
		end
	end

	return tool
end

function _update()

	time += 1/30

	if(inmenu) then
		if(btnp(4) or btnp(5)) then
			inmenu = false
			sfx(9,3)
			setlevel(level)
		end

		if(btnp(0)) then
			level -= 1
			sfx(0,3)
		end
		if(btnp(1)) then
			level += 1
			sfx(0,3)
		end

		level = level % maxlevel

		return
	end

	if(needinit) then
		needinit = false
		initzone(level_x,level_y,16,16)
	end

	for curcan in all(mirrors) do
		local flipflop = (time*0.5)%1 > 0.5
		if(flipflop) then
			if(curcan.type == type_mirrorflip) then
				curcan.type = type_mirrorflipoff
			end
		else
			if(curcan.type == type_mirrorflipoff) then
				curcan.type = type_mirrorflip
			end
		end

		local newangle = curcan.angle		
		if(curcan.type == type_mirrorrot1 or curcan.type == type_mirrorrot2) then
			local off = 0.0
			if(curcan.type == type_mirrorrot2) off = 0.5
			newangle = curcan.refangle + sin(time*0.3+off)*0.125
			
		end
		curcan.angle = newangle
	end

	if(char_intool) then
		local curcan = char_curtool
		if(curcan) then

			local prevx = char_x
			local prevy = char_y

			local rotacc = 0.002
			if(curcan.type == type_cannon) then
				rotacc = -rotacc
			end

			char_x = lerp(char_x, curcan.x, 0.3)
			char_y = lerp(char_y, curcan.y, 0.3)

			char_vx = (char_x-prevx)
			char_vy = (char_y-prevy)

			local indirect = curcan.type == type_mirrorrot1 or curcan.type == type_mirrorrot2

			local newangle = curcan.angle
			if(indirect) then
				newangle = curcan.refangle
			end

			local needdec = true
			local newacc = 0
			if(btn(0)) then
				newacc += rotacc
				needdec = false
			end
			if(btn(1)) then
				newacc -= rotacc
				needdec = false
			end
			if(btn(2)) then
				newacc += rotacc
				needdec = false
			end
			if(btn(3)) then
				newacc -= rotacc
				needdec = false
			end

			if(needdec) then
				rotspeed = 0.0
			end
			rotspeed += newacc
			
			newangle += rotspeed

			if(curcan.type == type_cannon) then
				local diff = abs(newangle-curcan.refangle)%1
				if(diff>0.3) then
					newangle = curcan.angle
				end
			end

			if(indirect) then
				curcan.refangle = newangle
			else
				curcan.angle = newangle
			end
			
			curcan.ca = cos(curcan.angle)
			curcan.sa = sin(curcan.angle)
		end
	else
		char_curtool = findneartool(char_x,char_y)

		local acc = 0.45

		if(btn(0)) char_vx -= acc
		if(btn(1)) char_vx += acc
		if(btn(2)) char_vy -= acc
		if(btn(3)) char_vy += acc

		char_x += char_vx
		char_y += char_vy

		char_x = max(8,min(120,char_x))
		char_y = max(8,min(120,char_y))

		char_vx *= 0.85
		char_vy *= 0.85
	end

	for cur in all(mirrors) do
		--cur.angle += 0.01
		cur.ca = cos(cur.angle)
		cur.sa = sin(cur.angle)
	end

	if(btnp(4)) then
		char_intool = not char_intool
		if(char_intool) then
			if(not win) sfx(0,3)
		else
			if(not win) sfx(10,3)
		end
	end

	if(not win and #maintrees/max(1,max_seed) >= winref) then
		sfx(9,3)
		win = true
	end

	if((win or cheat) and btnp(5)) then
		needinit = true
		sfx(9,3)
		setlevel(level + 1)
		if(level>=maxlevel) then
			setlevel(0)
			inmenu = true
			finish = true
		end		
	end
end

function iscol(x,y)
	local t = mget(x/8+level_x,y/8+level_y)
	local c = fget(t,1)
	return c
end

function setwet(x,y)
	local fx = flr(x/8)+1
	local fy = flr(y/8)+1
	if(fx<1 or fx>16 or fy<1 or fy>16) return
	local cur = ground[fx][fy]
	if(cur and cur.full) then
		if(cur.wet<60) cur.wet += 20
	end
end

function addair(x,y,vx,vy)
	local fx = flr(x/8)+1
	local fy = flr(y/8)+1
	if(fx<1 or fx>16 or fy<1 or fy>16) return
	local cur = ground[fx][fy]
	if(cur and not cur.full) then
		cur.vx += vx
		cur.vy += vy
		cur.sum += 1
	end
end


function sign(x)
	if(x>0) return 1
	if(x<0) return -1
	return 0
end

function lerp(a,b,alpha)
	return a*(1.0-alpha)+b*alpha
end

function drawtree(cur)
	
	if(cur.ground) then
		cur.health = lerp(cur.health, cur.ground.wet/60.0,0.1)
	end
	local health = cur.health

	spr(113+cur.spr,cur.x-4,cur.y-4)

	for chil in all(cur.childs) do

		local prevx = cur.x
		local prevy = cur.y
		local nc = #chil
		for i=1,nc do
			local seg = chil[i]
			local nx = seg.x
			local ny = seg.y
			nx += rnd(2)-1
			ny += rnd(2)-1
			if(i<health*6) then
				nx += (prevx-cur.x)*0.02
				ny += (prevy-cur.y)*0.02

				local len = 10/sqrt(nx*nx+ny*ny+0.001)
				nx *= len
				ny *= len

				local fx = prevx+nx * health
				local fy = prevy+ny * health

				local tfx = flr(fx/8)
				local tfy = flr(fy/8)

				local t = mget(tfx+level_x,tfy+level_y)
				local c = fget(t,1)
				if(tfx>=0 and tfx<16 and tfy>=0 and tfy<16) then
					if(c) then
						-- ground
						local curcol = ground[tfx+1][tfy+1]
						if(curcol and curcol.full) then
							if(curcol.wet>5 and curcol.cangrow and (curcol.tree==nil)) then
								curcol.tree = newtree(curcol.x+4,curcol.y+4,curcol,3,3)
								add(maintrees, curcol.tree)
								if(not win) sfx(8,3)
							end
						end

						local nrotx = (prevy-cur.y)
						local nroty = -(prevx-cur.x)
						local lenrot = 1.0/sqrt(nrotx*nrotx + nroty*nroty + 0.001)
						nx += cur.rot * nrotx * lenrot
						ny += cur.rot * nroty * lenrot
					else
						-- air
						local row = ground[tfx+1]
						if(row) then
							local curcol = row[tfy+1]
							if(curcol and not curcol.full) then
								if(curcol.sum>0) then
									local stren = 0.25*0.3--/curcol.sum
									nx += curcol.vx*stren 
									ny += curcol.vy*stren
								end
							end
						end
						--seg.x = nx
						--seg.y = ny
					end
				end
				seg.x = nx
				seg.y = ny

				line(prevx,prevy,fx,fy,11)
				spr(113+seg.spr,fx-4,fy-4)

				prevx = fx
				prevy = fy
			else
				seg.x = nx
				seg.y = ny
			end
		end
	end
end

function drawpart(sprnum, x, y, off)

	local curnum = sprnum + (time*3+off)%4
	spr(curnum, x-4,y-4)

end

function borderline(x0,y0,x1,y1,c0,c1)
	line(x0+1,y0,x1+1,y1,c1)
	line(x0-1,y0,x1-1,y1,c1)
	line(x0,y0+1,x1,y1+1,c1)
	line(x0,y0-1,x1,y1-1,c1)
	line(x0,y0,x1,y1,c0)
end

function draw_char()

	if(char_intool) pal(5,6)

	drawpart(65, char_x-3, char_y+5,0)
	drawpart(65, char_x+3, char_y+6,1.3)
	drawpart(65, char_x+0, char_y+7,2.6)
	
	local charspr = abs(flr(time*5)%4-1)
	if(char_intool) charspr = 0
	spr(42+charspr*2, char_x-8, char_y-9,2,2)

	pal()
end

function draw_gauge()

	local maxval = max(1,max_seed)

	local val = #maintrees/max_seed

	local y = 10
	local sy = 107

	rectfill(120,y,128,y+sy,5)

	rectfill(120,127-y-sy*val,128,y+sy,11)

	local tref = 127-y-sy*winref
	rectfill(120,tref-1,128,tref+1,10)


	spr(79,120,8)
	for i=2,13 do
		spr(95,120,i*8)
	end
	spr(111,120,112)

	if(win) then
		local c = 5+flr((time*3)%2)
		if(c==6) c=10
		rectfill(64-17,110,64+16,120,1)
		rectfill(64-40,118,64+39,126,1)
		centertext("victory", 64, 112,c)
		centertext("press v to continue", 64, 120,c)
	end

end

function newmenutree(x,y, val)
	local set={}
	set.x = x
	set.y = y
	set.val = val
	return set
end
menutree={}

function centertext(text,posx,posy,col)

	local sposx = posx - #text * 2
	local sposy = posy
	print(text, sposx+1,sposy,1)
	print(text, sposx-1,sposy,1)
	print(text, sposx,sposy+1,1)
	print(text, sposx,sposy-1,1)
	print(text, sposx,sposy,col)
end

function menuscreen()

	local offy = 10

	if(#menutree == 0) then
		for i=1,32 do
			for j=1,32 do
				local c = sget(i+95,j+95)
				if(c == 3) then
					add(menutree, newmenutree(16+i*3 + rnd(5) -4,offy+j*3 + rnd(5) -4, rnd(5)))
				end
			end
		end
	end

	palt(13,0)
	sspr(95,95,32,16,16,offy,96,48)

	for cur in all(menutree) do
		--circfill(cur.x,cur.y,2,8)
		spr(113+cur.val, cur.x, cur.y)
	end
	
	sspr(95,95+16,32,16,15,48+offy,96,48)
	sspr(95,95+16,32,16,17,48+offy,96,48)
	sspr(95,95+16,32,16,16,47+offy,96,48)
	sspr(95,95+16,32,16,16,49+offy,96,48)

	pal(3,11)
	sspr(95,95+16,32,16,16,48+offy,96,48)
	pal()

	for i=1,10 do
		add(rain, newrain(rnd(96)+16, 16+offy,rnd(0.5)-0.25,rnd(4)))
	end

	for cur in all(rain) do
		if(not (cur==nil)) then
			local px = cur.x
			local py = cur.y

			cur.vy += 0.08			
			cur.x += cur.vx
			cur.y += cur.vy

			local cx = cur.x
			local cy = cur.y

			line(px,py,cx,cy,13)

			if(cy<0 or cy>offy+44 or cx<0 or cx>128) then
				del(rain,cur)
			end
		end
	end

	centertext("p8jam1",64,18,13)
	centertext("nusan present",64,9,13)

	local ypos = 92
	local ypos2 = 108
	local text = "start"
	if(finish) then

		centertext("thank for playing ", 64, ypos-2,10)

		text = "restart"
		ypos = 102
		ypos2 = 114
	end

	centertext("press c or v to "..text, 64, ypos,5+flr((time*3)%2))

	centertext("starting level : < "..(level+1).." >", 64, ypos2,6)

	if(cheat) then

		color(8)
		print("cpu:"..flr(stat(1)*100),96,0)
		print("ram:"..flr(stat(0)),96,8)

		print(#rain,96,16)

	end
end

function _draw()

	cls()

	rectfill(0,0,128,128,13)

	if(inmenu) then
		menuscreen()
		return
	end

	if(needinit) then
		needinit = false
		initzone(level_x,level_y,16,16)
	end

	pal(8,4)
	for i=9,14 do
		if(i%2 == 1) then
			pal(i,4)
		else
			pal(i,15)
		end
	end
	--pal(1,5)
	map(level_x,level_y,0,0,16,16)
	pal()

	local nground = #ground
	for i=1,nground do
		local ng2 = #ground[i]
		for j=1,ng2 do

			local cur = ground[i][j]
			if(cur.full) then
				-- ground
				if(cur.cangrow and cur.wet>0) then
					for i=8,14 do
						local ref = 60-(i-8)*10 
						if(cur.wet<ref) then
							if(i==8 or i%2 == 1) then
								pal(i,4)
							else
								pal(i,15)
							end
						else
							pal(i,12)
						end
					end
					pal(15,12)
					spr(cur.spr,cur.x,cur.y)
					cur.wet -= 1
				end
			else
				-- air
				cur.vx = 0
				cur.vy = 0
				cur.sum = 0
			end

		end
	end
	pal()

	if(char_intool) draw_char()

	for cur in all(mirrors) do
		local si = 8
		--circ(cur.x,cur.y,si,8)
		local ca = cur.ca
		local sa = cur.sa

		local c1x = (cur.x + sa * si)
		local c1y = (cur.y - ca * si)
		local c2x = (cur.x - sa * si)
		local c2y = (cur.y + ca * si)

		local c = 5
		if(char_curtool == cur) then
			if((time*2-0.15)%1>0.75) c = 8

			if(char_intool) then
				local lenarrow = ((time)%1)*15
					
				if(cur.type == type_mirrorrot1 or cur.type == type_mirrorrot2) then
					local c1 = cos(cur.refangle+0.125)*lenarrow
					local s1 = sin(cur.refangle+0.125)*lenarrow
					local c2 = cos(cur.refangle-0.125)*lenarrow
					local s2 = sin(cur.refangle-0.125)*lenarrow

					line(cur.x-c1,cur.y-s1,cur.x+c1,cur.y+s1,10)
					line(cur.x-c2,cur.y-s2,cur.x+c2,cur.y+s2,10)
				else
					local ncx = ca * lenarrow
					local ncy = sa * lenarrow

					line(cur.x-ncx,cur.y-ncy,cur.x+ncx,cur.y+ncy,10)
				end
			end
		end

		local cd = 6
		if(cur.type == type_mirrorflipoff) c = 6
		borderline(c1x,c1y,c2x,c2y,c,6)

		

	end

	for cur in all(cannons) do

		--circ(cur.x,cur.y,15,12)		

		spr(48,cur.x-4,cur.y-6)

		for i=1,2 do
			local rspeed = 3--2 + rnd(2)-1.0
			local range = 3
			add(rain, newrain(cur.x + rnd(range*2)-range, cur.y + rnd(range*2)-range,cur.ca*rspeed,cur.sa*rspeed))
		end

	end

	for cur in all(rain) do
		if(not (cur==nil)) then
			local px = cur.x
			local py = cur.y

			--cur.vy += 0.08
			cur.vy += 0.02
			
			if(cur.life<0) then
				cur.x += cur.vx
				cur.y += cur.vy

				local cx = cur.x
				local cy = cur.y

				for mir in all(mirrors) do
					if(not (mir.type == type_mirrorflipoff)) then
					--if(true) then
						local dx = (cx-mir.x)/8
						local dy = (cy-mir.y)/8
						local sqrdist = dx*dx+dy*dy
						if(sqrdist<1) then
							local predot = (px-mir.x)*mir.ca + (py-mir.y)*mir.sa
							local curdot = (cx-mir.x)*mir.ca + (cy-mir.y)*mir.sa
							if(not (sign(predot) == sign(curdot))) then

								local dot = cur.vx*mir.sa-cur.vy*mir.ca
								cur.vx = dot*mir.sa*2.0 - cur.vx
								cur.vy = -dot*mir.ca*2.0 - cur.vy

								cur.x = px+cur.vx
								cur.y = py+cur.vy
							end
						end
					end
				end
			end

			local cx = cur.x
			local cy = cur.y

			if(cur.life>=0) then

				circfill(cx,cy,1.5-sin(cur.life/12)*1.5,cur.c)

				cur.life -= 1
				if(cur.life<0) then
					del(rain,cur)
				end
			else

				local bc = iscol(cx,cy)
				if(bc) then

					setwet(cx,cy)

					cur.life = 6
				else

					--pset(cur.x,cur.y,12)
					line(px,py,cx,cy,cur.c)

					if(cy<0 or cy>128 or cx<0 or cx>128) then
						del(rain,cur)
					else
						addair(cx,cy, cur.vx,cur.vy)
					end					
				end
			end

		end
	end

	for cur in all(cannons) do

		local ca = cur.ca
		local sa = cur.sa

		local c1x = (cur.x + ca * 10)
		local c1y = (cur.y + sa * 10)
		local c2x = (cur.x - ca * 2)
		local c2y = (cur.y - sa * 2)

		local ofx = sa * 2
		local ofy = -ca * 2

		local c = 5
		if(char_curtool == cur) c = 8

		borderline(c1x+ofx,c1y+ofy,c2x+ofx,c2y+ofy,c,1)
		borderline(c1x-ofx,c1y-ofy,c2x-ofx,c2y-ofy,c,1)
	end

	for cur in all(maintrees) do
		drawtree(cur)
	end

	
	if(not char_intool) then
		if(char_curtool) then
			local vt = (time*2)%1
			local cl1x = lerp(char_x, char_curtool.x, max(0,vt-0.1))
			local cl1y = lerp(char_y, char_curtool.y, max(0,vt-0.1))
			local cl2x = lerp(char_x, char_curtool.x, min(1,vt+0.1))
			local cl2y = lerp(char_y, char_curtool.y, min(1,vt+0.1))
			line(cl1x,cl1y,cl2x,cl2y,8)
		end
		draw_char()
	end

	if(not win) then
		if(level == 0) then
			rectfill(0,100,128,128,1)
			if((time*0.15)%1>0.5) then
				centertext("goal is to spread leaves",60,103,6)
				centertext("by pouring water on ground",60,111,6)
				centertext("right gauge measures spreading",60,119,6)
			else
				centertext("move with arrow keys",60,103,6)
				centertext("use c or z to enter/exit tool",60,111,6)
				centertext("then arrow keys rotate tool",60,119,6)
			end
		end
		if(level == 1) then
			rectfill(0,100,128,128,1)
			centertext("you can exit a tool",60,103,6)
			centertext("anytime with c or z",60,111,6)
			centertext("and move around",60,119,6)
		end
		if(level == 2) then
			rectfill(0,116,128,128,1)
			centertext("mirror also are tools",60,119,6)
		end
	end

	draw_gauge()


	if(cheat) then

		color(8)
		print("cpu:"..flr(stat(1)*100),96,0)
		print("ram:"..flr(stat(0)),96,8)

		print(#rain,96,16)
		print(tmpcount.." "..#maintrees.."/"..max_seed,96,24)
	end

end
