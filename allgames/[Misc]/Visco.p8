-- menu gamestates

function menu_init()
 actors={}

 --cursor position
 cy=1
 
 high=dget(1)
 
 --format options as a string
 --for the title, then a
 --function for what to do upon
 --being pressed
 mbutts={
  "start", function() game_init() end,
  "instructions", function() ins=true end,
  "change palette", function() 
   sfx(2) 
   palnum=palnum%#pals+1
   curpal=pals[palnum] 
   dset(2,palnum)
  end,
  "high score: "..tostr(high), function() end
 }
 
 ins=false
 
 update=menu_update
 draw=menu_draw
end

function menu_update()

 for i in all(actors) do
  i:update()
 end

 --for i=1,2 do
 if(rnd()>.65)aact(rnd(147)-10,-20,0,3,1,{5+rnd(10),rnd(curpal),0.985})
 --end

 if ins then
  if(btnp(0)) ins=false
 else

 --move and clamp cursor
 if(btnp(2)) cy-=1
 if(btnp(3)) cy+=1
 cy=mid(1,cy,3)
 
 --if Ž pressed, activate button
 if(btnp(4)) mbutts[cy*2]()
 
 end
 
 for i in all(actors) do
  if(i.delq) i:delete()
 end
end

function menu_draw()
 --cls()
 
 --draw your background here
 for i in all(actors) do
  i:draw()
 end
 
 --a title isn't really 
 --nessecary but i think it 
 --adds some much-needed flair
 
 if ins then
  local tt=[[
  
    
    move the cursor with the
    arrow keys, and your
    mass will follow it
    
    capture other robots to
    grow your mass
    
    your energy constantly
    decreases, press — to
    digest yourself and
    replenish it
    
    hold Ž to guide your
    mass slower and more 
    carefully

    press ‹ to return

]]
  cprint(tt,0,0,curpal[4],curpal[1])
 else
 
 --spr(32,47,10,5,2)
 for i=0,3 do
  ovalfill(24+i*8,10+i,102-i*8,30-i,curpal[i+1])
 end
 
 print("visco",54,18,curpal[1])
 
 --for every menu item...
 for i,p in pairs(mbutts) do
  if i%2==1 then
   --change what h equals to
   --change the text and
   --highlight colours
   local h=curpal[2]
   if(cy*2-1==i) h=curpal[4]
   --print the label, adjusting
   --for text length to be
   --exactly centered
   
   local jx,jy=(t()+i)/3.7,(t()+i)/2.7
   camera(sin(jx)*2.9,cos(jy)*2.9)
   
   ovalfill(57-#p*2,37+i*8,69+#p*2,47+i*8,curpal[1])
   print(p,64-#p*2,40+i*8,h)
  end
 end
 
 camera()
 
 end
 
 --print(stat(1),1,1,0)
end
