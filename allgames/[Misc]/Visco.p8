-- actor logic

function aact(x,y,w,h,id,s)
 local a={}
 local b=objs[id]
 a.x=x a.y=y a.w=w a.h=h a.id=id 
 a.init=b.init
 a.update=b.update
 a.draw=b.draw
 a.delq=false
 a.delete=b.delete or function(s) del(actors,s) end
 a:init(s)
 add(actors,a)
end

objs={
 { --1: particle
  init=function(s,l)
   s.r=l[1] s.col=l[2] s.d=l[3]
  end,
  
  update=function(s)
   s.x+=s.w
   s.y+=s.h
   s.w*=s.d
   s.h*=s.d
   s.r*=s.d
   if s.r<0.5 then
    s.delq=true
   end
  end,
  
  draw=function(s)
   circfill(s.x,s.y,s.r,s.col)
  end
 },
 
 { --2: spritething
  init=function(s,l)
   s.spr=l[1]
   s.dx=rnd(.25)-.125 s.dy=rnd(.25)-.125
   s.hp=l[2]
  end,
  
  update=function(s)
  
   if s.hp==0 then
    local drag=0.95
    if(btn(4)) drag=0.85
    s.dx*=drag
    s.dy*=drag
    
    local ratio=0.5
    if(btn(4)) ratio=1
    local gx,gy=l(ax,ratio,cx1),l(ay,ratio,cy1)
   
    local g=atan2(gx-s.x,gy-s.y)
    s.dx+=cos(g)/8*(.5+hg)/1.5
    s.dy+=sin(g)/8*(.5+hg)/1.5
   
    if(rnd()>0.8) aact(s.x+rnd(s.w),s.y+rnd(s.h),0,0,1,{1+rnd(2),rnd({curpal[2],curpal[3]}),0.982+rnd(.015)})
   
    if btnp(5) or hg<=0 then
     if pnum>1 then 
      if not dg then
       dg=true 
       s.delq=true 
       hg=min(hg+0x0.2,0x0.ffff) 
       --[[sfx(2) 
       rspawn() 
       score+=1 
       pnum-=1 
       for i=0,10 do 
        aact(s.x+4,s.y+4,rnd(.2)-.1,rnd(.2)-.1,1,{3+rnd(2),curpal[3],0.97})
       end]]
      end
     elseif not btnp(5) then
      alive=false
      s.delq=true
     end
    end
   else
   
   end


   --map collision
   for i=0,0.75,0.25 do
    local x,y=cos(i)*4,sin(i)*4
    if fget(mget((s.x+x+4)/8,(s.y+y+4)/8),0) then
      s.dx=s.dx-(x)/6
      s.dy=s.dy-(y)/6
    end
   end
  
   --intra-object collision
   local buck=buckets[gb(s.x,s.y)]
   for n,i in pairs(buck) do
    local ob=actors[i]
    if ob!=s and ob.id==2 then
     --line(s.x+4,s.y+4,ob.x+4,ob.y+4,8)
     local ox,oy=ob.x-s.x,ob.y-s.y
     if ox<=s.w and
        oy<=s.h and
        ox>=-ob.w and
        oy>=-ob.h then
      local m=atan2(ox,oy)
      ob.dx+=cos(m)/20
      ob.dy+=sin(m)/20
      s.dx-=cos(m)/20
      s.dy-=sin(m)/20
      if s.hp==0 and ob.hp>0 then
       ob.hp=max(ob.hp-0x0.04,0)
       if(ob.hp==0) sfx(1) pnum+=1 --for i=0,10 do aact(ob.x+4,ob.y+4,rnd(.2)-.1,rnd(.2)-.1,1,{3+rnd(2),curpal[3],0.97}) end
       if(ob.hp%0x0.2==0) sfx(0)
      end
     end
    end
   end
  
   s.dx=mid(-1,s.dx,1)
   s.dy=mid(-1,s.dy,1)
   s.x+=s.dx
   s.y+=s.dy
  end,
  
  draw=function(s)
   local opal={curpal[3],3,2,0}
   
   local out=opal[ceil(s.hp*4)+1]
   --if(s.type==0) out=11
   --rect(s.x,s.y,s.x+7,s.y+7,out)
   local flp=((s.x+s.y)/8)%2>1
  
   for i=0,15 do
    pal(i,out)
   end
   for i=0,.75,.25 do
    spr(s.spr,s.x+cos(i),s.y+sin(i),1,1,flp)
   end
   pal()
   
   --[[local mpal={
    0, 1, 2, 3,
    2, 3,11,10,
    8, 9,10,11,
   12, 3,14,15
   }]]
   
   --[[local mpal={
    1, 1, 1, 3,
    1, 1, 3,12,
   12,11,11,11,
   11, 3,12,12
   }]]
   
   --if(s.hp==0) for i=1,16 do pal(i,mpal[i+1]) end
   if(s.hp==0) ppal()
   
   spr(s.spr,s.x,s.y,1,1,flp)
   --line(s.x+4,s.y+4,s.x+s.dx*8+4,s.y+s.dy*8+4,12)
   
   pal()
   
   --pset(s.x,s.y,12)
  end,
  
  delete=function(s)
   sfx(2) 
   rspawn() 
   score+=1
   pnum-=1 
   for i=0,10 do 
    aact(s.x+4,s.y+4,rnd(.2)-.1,rnd(.2)-.1,1,{3+rnd(2),curpal[3],0.97})
   end
   --[[for i=0,10 do 
    aact(hx+64,hy+6,rnd(.8)-.4,rnd(.8)-.4,1,{4+rnd(2),curpal[2],0.97})
   end]]
   del(actors,s)
  end
 },
 
 { --3: danger box
  init=function(s,l)
   s.count=0 s.j=false
  end,
  
  update=function(s)
   if btnp(0) or btnp(1) or btnp(2) or btnp(3) then
    s.count+=1 
    s.j=true
    sfx(0)
   end
   if s.count>12 then
    s.delq=true
   end
  end,
  
  draw=function(s)
   local offx,offy=0,0
   if(s.j) s.j=false offx,offy=rnd(4)-2,rnd(4)-2
   spr(125,s.x+offx,s.y+offy)
  end,
  
  delete=function(s)
   pnum=5
   for i=1,5 do
    local ys=33
    if(i==1) ys=125
    aact(s.x+rnd(16)-8,s.y+rnd(16)-8,8,8,2,{ys,0})
   end
   sfx(3)
   
   for i=1,30 do
     aact(s.x+rnd(16)-4,s.y+rnd(16)-4,rnd(4)-2,rnd(4)-2,1,{6+rnd(4),rnd(curpal),.95+rnd(.02)})
   end
   
   del(actors,s)
  end
 }
}
