-- gameplay state

function game_init()
 update=game_update
 draw=game_draw
 
 actors={}
 
 sprs={29,34,40,42,49,58,85,109,110,118}
 
 lw=1024
 lh=256
 bw=16
 bh=16
 
 cx1,cy1=448,36
 --cx2,cy2=cx1,cy1
 cheld=false
 
 ax,ay=cx1,cy1
 hx,hy=ax,ay
 
 alive=true
 dtimer=0
 hg=1
 dg=false
 p=2
 score=0
 pnum=0
 
 --aact(64,64,8,8,2,{1})
 --[[for i=1,5 do
  aact(cx1+rnd(16)-8,cy1+rnd(16)-8,8,8,2,{33,0})
 end]]
 
 aact(508,100,0,0,3)
 
 for i=1,50 do
  rspawn()
 end
end

function game_update()
 bk()

 hg-=0x0.0004*pnum+score*0x0.0001+0x0.002

 calca()

 --[[if t()%1==0 then
  rspawn()
 end]]

 for i in all(actors) do
  i:update()
 end
 
 curs()
 
 --if(btnp(5))aact(cx1+rnd(16)-8,cy1+rnd(16)-8,8,8,2,{flr(rnd(128))})
 
 for i in all(actors) do
  if(i.delq) i:delete()
 end
 
 dg=false
 
 if not alive then
  dtimer+=1
  if dtimer>90 then
   if(score>high) dset(1,score)
   menu_init()
  end
 end
end

function game_draw()
 cls()
 
 calca()
 
 if(pnum!=0) hx,hy=mid(0,ax-64,896),mid(0,ay-64,128)
 
 camera(hx,hy)
 
 for x=hx-hx%8,hx+128-hx%8,8 do
  for y=hy-hy%8,hy+128-hy%8,8 do
   if(mget(x/8,y/8)==0) rectfill(x,y,x+6,y+6,1)
  end
 end
 
 map()
 
 --[[for i,p in pairs(buckets) do
  local vx,vy=i*16%lw,flr(i/(lw/bw))
  rect(vx,vy,vx+15,vy+15,1)
 end]]
 
 for i in all(actors) do
  if(i.id==1) i:draw()
 end
 
 for i in all(actors) do
  if(i.id!=1) i:draw()
 end
 
 fillp(0b1100110000110011.1)
 if(cheld)rect(cx1,cy1,cx2,cy2,7)
 fillp()
 
 pal(1,0)
 if(pnum>0)spr(187,cx1,cy1)
 pal(1,1)
 
 camera()
 
 local q=l(1,hg,126)
 if(pnum>0)p=l(p,0.15,q)
 --rectfill(1,117,p+1,126,0)
 
 ppal()
 
 local fx=2
 for fx=2,p do
  local brr=fx/47.3+t()+sin(fx/10)*5
  local jrr=2+sin(brr)*2
  local rd=sin((fx-2)/(244))*7.9
  sspr(56+jrr,40,1,8,fx,118-rd/2+sin(t()+fx/40),1,rd)
 end
 
 pal()
 
 local tf=#tostr(score)*2
 --rectfill(63-tf,3,63+tf,10,curpal[2])
 --print(score,64-tf,4,curpal[4])
 
 cprint(tostr(score),64-tf,4,curpal[4],curpal[1])
 
 if not alive then
  
 end
 
 --print("energy",3,111,0)
 
 --rectfill(0,0,30,7,0)
 --print(cx1,1,1,7)
 --print(t(),1,1,7)
 
 --[[for i1,p1 in pairs(buckets) do
  for i2,p2 in pairs(i) do
   for i3,p3 in pairs(i) do
    local uno,dos=actors[i2],actors[i3]
    if uno!=dos then
     line(uno.x,uno.y,dos.x,dos.y,7)
     sfx(0)
    end
   end
  end
 end]]
end

--cursor movement
function curs()
 --local dist=sqrt((ax-cx1)^2+(ay-cy1)^2)
 --local spd=60/dist
 local spd=3

 if(btn(0)) cx1-=spd
 if(btn(1)) cx1+=spd
 if(btn(2)) cy1-=spd
 if(btn(3)) cy1+=spd

 local lx,ly=ax,ay
 if(pnum==0) lx,ly=hx+64,hy+64

 cx1=l(lx,0.95,cx1)
 cy1=l(ly,0.95,cy1)

 --cx1=mid(ax-64,cx1,ax+56)

 --[[if btn(4) then
  if not cheld then
   cheld=true
   cx2=cx1
   cy2=cy1
  end
 elseif cheld then
  cheld=false
 end]]
end

--place all actors into buckets
--array
function bk()
 buckets={}
 for n,i in pairs(actors) do
  for x=i.x,i.x+i.w,i.w do
   for y=i.y,i.y+i.h,i.h do
    local index=gb(x,y)
    local bucket=buckets[index] or {}
    add(bucket,n)
    buckets[index]=bucket
   end
  end
 end
end

--get bucket
function gb(x,y)
 return flr(x/16)+lw*flr(y/16)
end

function l(a,x,b)
 return a+(b-a)*x
end

function rspawn()
 local sc=true
 while sc do
  local rx,ry=flr(rnd(128)),flr(rnd(32))
  if (not fget(mget(rx,ry),0)) and 
     abs(rx-cx1)>128 then
   aact(rx*8,ry*8,8,8,2,{rnd(sprs),1}) sc=false
  end
 end
end

function calca()
 local anum=0
 ax,ay=0,0
 for i in all(actors) do
  if(i.hp==0) ax+=i.x ay+=i.y anum+=1
 end
 ax,ay=ax/anum,ay/anum
end
