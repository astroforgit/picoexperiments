pico-8 cartridge // http://www.pico-8.com
version 18
__lua__
-- castlebots
-- by @kevinthompson

-- globals
clouds={}
mountains={}
show_prompt=false
prompt="by @kevinthompson"
prompt_timer=0
prompt_y=40
prompt_color=0

-- palette
poke(0x5f2e,1)
pal(0,129	,1)
pal(2,132,1)
pal(5,133,1)
pal(6,134,1)
pal(7,6,1)
pal(9,136,1)
pal(11,138,1)
pal(14,7,1)

function _init()
 frame=0

 music(0)
 state=title
 state:init()
 
 spawn_clouds()
 spawn_mountains()
end

function _update()
 frame+=1
 update_all(clouds)
 state:update()
end

function _draw()
	cls(12)
	
	draw_all(clouds)
 
 rectfill(0,86,128,128,6)
 draw_all(mountains)
 spr(21,16,70,2,2)
	
	map(0,0,0,0,16,16)
 state:draw()
 
 if show_prompt then
  draw_prompt(prompt)
 end
end
-->8
-- title

title={
 init=function(self)
  show_prompt=true
 end,

 update=function(self)
  if btnp() > 0 then
   state=game
   state:init()
  end
 end,
 
 draw=function(self)
  draw_castle()
		draw_title()
		draw_start_game()
 end
}
-->8
-- game

castle_x=24
cannon_x=27
cannon_y=95

shot_x=16
shot_y=80

enemy_count=0
charge_shot=false
shot_power=0
shot_delay=0
prev_shot_power=0

balls={}
enemies={}
wave_delay=0
wave_num=1
waves={
 {2,180,-0.25},
 {4,180,-0.50},
 {2,180,-0.75},
 {4,90,-0.50}
}

game={
 init=function(self)
  debris={}
  enemies={}
  explosions={}
  enemy_count=0
  wave_num=0
  prompt_color=0
 end,

 update=function(self)
  if enemy_count<=0 then
   wave_num+=1
   wave_delay=0
   
   if wave_num>#waves then
    state=win
    state:init()
   else
		  shot_delay=60
		  show_prompt=true
		  prompt_timer=60
		  enemy_count=waves[wave_num][1]
   end
  end
  
  if wave_num<=#waves then
	  prompt="wave "..wave_num  
	  wave=waves[wave_num]
	  
	  update_all(balls)
	  update_all(enemies)
	  update_all(explosions)
	
	  self:update_prompt()
	  self:update_shot()
	  
	  self:spawn_enemies()
	 end
 end,
 
 draw=function(self)
  draw_castle()
  draw_all(debris)
  draw_all(enemies)
  draw_all(explosions)
  draw_all(balls)
  self:draw_shot()
  self:draw_interface()
 end,
 
 update_shot=function(self)
  if shot_delay<=0 and btn()>0 then
   charge_shot=true
  else
   if shot_power>0 then
    self:fire_cannon()
    prev_shot_power=shot_power
    shot_power=0
    shot_delay=15
   end
   
   charge_shot=false
  end
  
  if shot_delay>0 then
   shot_delay-=1
  end
  
  if charge_shot then
   shot_power=min(shot_power+2,100)
  end
 end,
 
 spawn_enemies=function(self)
  if #enemies<wave[1] then 
   if prompt_timer<=0 then
	   if wave_delay==0 then
	    spawn_enemy(wave[3])
	    wave_delay=wave[2]
	   else
	    wave_delay-=1
	   end
	  end
  end
 end,
 
 update_prompt=function(self)
  if prompt_timer>0 then
   prompt_timer-=1
  else
   show_prompt=false
  end
 end,
 
 draw_shot=function(self)
  if shot_power>0 then
   rect(shot_x,shot_y,shot_x+16,shot_y+3,14)
   rectfill(shot_x+1,shot_y+1,shot_x+1+(shot_power/100*14),shot_y+2,9)
   
   if prev_shot_power>0 then
    local line_x=shot_x+1+(prev_shot_power/100*14)
    line(line_x,shot_y+1,line_x,shot_y+2,10)
   end
  end
 end,
 
 draw_interface=function(self)
  local count=tostr(enemy_count)
  circfill(106,7,5,1)
  rectfill(106-#count,2,128,12,1)
  print("x",114,5,7)
  print(count,109-#count,5,14)
  spr(5,118,3)
 end,
 
 fire_cannon=function(self)
  local percent_speed=shot_power/100
  local speed=2+(8*percent_speed)
  spawn_ball(cannon_x, cannon_y, speed)
  sfx(2)
 end,
}
-->8
-- win

win={
 init=function(self)
  explosion_delay=0
  explosion_count=5
  prompt="you defended the castle!"
  prompt_color=3
 end,
 
 update=function(self)
  show_prompt=true
  
  if explosion_delay > 0 then
  	explosion_delay-=1
  end
  
  if explosion_count==0 and btnp()>0 then
   state=game
   state:init()
  end
  
  if explosion_delay<=0 and explosion_count>0 then
   spawn_explosion(flr(rnd(32))+9, flr(rnd(16))+64)
   explosion_delay=15
   explosion_count-=1
  end
  
  update_all(explosions)
 end,
 
 draw=function(self)
  draw_all(explosions)
  draw_win_castle()
  draw_title()
  draw_play_again()
 end
}
-->8
-- game over

game_over={
 init=function(self)
  explosion_delay=0
  explosion_count=5
  prompt="your castle was destroyed"
  prompt_color=9
 end,
 
 update=function(self)
  show_prompt=true
  
  if explosion_delay > 0 then
  	explosion_delay-=1
  end
  
  if explosion_count==0 and btnp()>0 then
   state=game
   state:init()
  end
  
  if explosion_delay<=0 and explosion_count>0 then
   spawn_explosion(flr(rnd(16))+9, flr(rnd(16))+96)
   explosion_delay=15
   explosion_count-=1
  end
  
  update_all(explosions)
 end,
 
 draw=function(self)
  if explosion_count>0 then
  	draw_castle() 
  else
   draw_destroyed_castle()
  end
 
  draw_title()
  draw_play_again()
  
  draw_all(explosions)
 end
}
-->8
-- utilities

function spawn_ball(x,y,speed)
 add(balls, {
  x=x,
  y=y,
  vx=speed,
  vy=0,
  
  update=function(self)
  	if self.x>128 or self.y>=120 then
    self:destroy()
   else
    self.y+=self.vy
	   self.x+=self.vx
   
	   if self.vx>0 then
	  	 self.vx=max(self.vx-0.25,0)
	   end
   
   	self.vy+=0.25
   	
   	for enemy in all(enemies) do
   	 if enemy.x<=self.x
   	 and enemy.x+7>=self.x
   	 and enemy.y<=self.y
   	 and enemy.y+7>=self.y then
	  			enemy_count-=1
	     self:destroy()
   	  enemy:destroy()
   	 end
   	end
   end
  end,
  
  draw=function(self)
   circfill(self.x,self.y,0,1)
  end,
  
  destroy=function(self)
   sfx(3)
   del(balls, self)
  end
 })
end

function spawn_enemy(speed)
 add(enemies, {
  x=128,
  y=112,
  vx=speed,
  frame=1,
  frames={5,6},
  
  update=function(self)
   self.x+=self.vx
   
   if frame%5==0 then
    self.frame+=1
   end
   
   if self.frame>#self.frames then
    self.frame=1
   end
  
	  if self.x<=castle_x then
	   state=game_over
	   state:init()
	  end
  end,
  
  draw=function(self)
   spr(self.frames[self.frame],self.x,self.y)
  end,
  
  destroy=function(self)
	  del(enemies,self)
	  spawn_debris(self.x,self.y)
	  spawn_explosion(self.x,self.y+2)
  end
 })
end

function spawn_debris(x,y)
 add(debris,{
  x=x,
  y=y,
  
  draw=function(self)
   spr(7,self.x,self.y)
  end
 })
end

function spawn_explosion(x,y)
 add(explosions, {
  x=x,
  y=y,
  
  frames={8,9,10,11,12},
  frame_num=0,
  
  update=function(self)
   self.frame_num+=1
   
   if self.frame_num>#self.frames then
    del(explosions,self)
   end
  end,
  
  draw=function(self)
   spr(self.frames[self.frame_num],self.x,self.y)
  end
 })
 
 sfx(4)
end

function spawn_clouds()
 for ox=-64,64,16 do
  x=ox+(rnd(8)-4)
  y=(x*-.005)+32+(rnd(16)-8)
  c=flr(rnd(5))
  speed=rnd(0.2)
  
  for i=-c,c do
	  r=rnd(16)-8
	  
	  add(clouds, {
	   x=x+64+i*2,
	   y=y,
	   r=r,
	   vx=speed,
	   
	   update=function(self)
	    self.x+=self.vx
	    
	    if self.x-self.r>=128 then
	     self.x=0-self.r*2
	    end
	   end,
	   
	   draw=function(self)
			  circfill(self.x,self.y,self.r,7)
			  circfill(self.x,self.y-1,self.r,14)
	   end
	  })
  end
 end
end

function draw_castle()
	palt(0,false)
	palt(11,true)
	spr(17,8,88,4,4)
	palt()
end

function draw_win_castle()
	palt(0,false)
	palt(11,true)
	spr(17,8,88,4,4)
	spr(53,11,80)
	spr(53,33,80)
	palt()
end

function draw_destroyed_castle()
	palt(0,false)
	palt(11,true)
	spr(28,8,88,4,4)
	palt()
end

function spawn_mountains()
 local tiles={21,23,25}
 
 for x=0,112,16 do
  add(mountains,{
   x=x,
   y=70,
   s=tiles[flr(rnd(#tiles))+1],
   f=rnd()>0.5,
   
   draw=function(self)
    spr(self.s,self.x,self.y,2,2,self.f)
   end
  })
 end
end

function draw_prompt(text)
	rectfill(0,prompt_y,128,prompt_y+12,prompt_color)
	print(text,64-(#text/2)*4,prompt_y+4,14)
end

function draw_title()
	palt(0,false)
	palt(12,true)
	spr(80,0,12,16,3)
	palt()
end

function draw_play_again()
 local text="press any key to play again"
 print(text,64-(#text/2)*4,58,1)
end

function draw_start_game()
 local text="press any key to start game"
 print(text,64-(#text/2)*4,58,1)
end

function update_all(collection)
 for obj in all(collection) do
  obj:update()
 end
end

function draw_all(collection)
 for obj in all(collection) do
  obj:draw()
 end
end
