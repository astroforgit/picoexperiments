  "windows": {
    "ml_intro": [
      "^w rowie, pod leśnym okiem,",
      "gdzie mchy się zielenią,",
      "^dusiołek lazł, potwora",
      "podszyty bezdenią.",
      "^wtem widzi: nad strumykiem, w",
      "porannym rozkwicie,",
      "^dziewczyna cudna stoi, bujna",
      "niespożycie!",
      "^gors ma tak okazały, falujący",
      "w słońcu,",
      "^że aż potworny ślimak zapiał",
      "w swym ogońcu.",
      "^nie myśląc ani chwili (bo żądz",
      "krew mu mąci),",
      "^skoczył ^dusiołek z rowu,",
      "bezwstydnik palący!",
      "^obłapia ją łapskami, w krąg",
      "piersi gnieść bierze,",
      "^i poddusza niebogę, jak żaba ,",
      "jak zwierzę!",
      "^śmiechem parska ropuchy,",
      "rechocze bezwstydnie,",
      "^myśli, że bezkarnie mu ta",
      "swawola wyjdzie.",
      "^lecz niedoczekanie! ^dziewka ta",
      "nieboga",
      "^była żoną maga, groźnego",
      "jak trwoga!",
      "^wpadł czarnoksiężnik z lasu,",
      "rzucił gromy w słońcu,",
      "^i poraził piorunem potwora w",
      "podogońcu!",
      "^aż ^dusiołkowi dupsko",
      "rozbłysło od ognia,",
      "^skurczył się bezradnie, to",
      "rzecz aż niegodna.",
      "^czarownik go za ogon capnął",
      "bez litości,",
      "^i cisnął w loch głęboki, gdzie",
      "ciemność się mości.",
      "^zatrzasnął rdzawą kratę i",
      "rzekł wściwym głosem:",
      "\"^gnij tam, ty bezwstydniku,",
      "tuż pod naszym nosem!",
      "^jak ci tam, w tej bezdeni,",
      "kuśka całkiem uschnie,",
      "^to nauczysz się, chamie,",
      "kultury posłusznie!"
    ],
    "ml_anvil": [
      "^potężne kowadło...",
      "",
      "^poświęć turę, by nadać",
      "broni niezwykłą moc.",
      "^potrzebujesz zwykłej broni",
      "i przeklętego jedzenia."
    ],
    "ml_well": [
      "^płytka sadzawka...",
      "",
      "^ta niezwykle czysta woda",
      "zdejmuje klątwę z broni.",
      "^wystarczy jedna tura."
    ],
    "ml_altar": [
      "^święty ołtarz...",
      "",
      "^księga kryje odpowiedzi.",
      "^poświęć turę, by rozpoznać",
      "nieznany przedmiot."
    ],
    "ml_win": [
      "^licz wydaje ostatni krzyk.",
      "^czujesz, jak znika ciężar",
      "spoczywający na świecie.",
      "",
      "^raq'zul został pokonany.",
      "^wracasz na powierzchnię.",
      "^świat jest znów bezpieczny."
    ],
    "ml_story": [
      "  ^pragnąc nieśmiertelności,",
      "  król licz ^raq'zul rzuca",
      "     potężne zaklęcie.",
      "  ^świat traci życie i radość.",
      "",
      "  ^śmiałkowie schodzą do lochu,",
      "    lecz żaden nie wraca.",
      "",
      "   ^teraz twoja kolej.",
      " ^pokonaj ^raq'zula, złam klątwę",
      "      i zakończ cierpienie!"
    ],
    "ml_submenu": [
      "użyj",
      "wyrzuć"
    ]
  },
